// ====

// Relaxed extrema discard NaN classification and signed-zero normalization.
// The F64 clamp is the highest-pressure form because each 512-bit packet
// consumes the complete eight-lane predicate carrier.
func.def @relaxed_clamp_f64(%value: vector<8xf64>, %lower: vector<8xf64>, %upper: vector<8xf64>) -> (vector<8xf64>) {
  %result = vector.clampf<ieee, nnan|nsz> %value, %lower, %upper : vector<8xf64>
  func.return %result : vector<8xf64>
}

// ----
func.def @relaxed_clamp_f64(%value: vector<8xf64>, %lower: vector<8xf64>, %upper: vector<8xf64>) -> (vector<8xf64>) {
  %5 = vector.splati 0 : vector<8xi64>
  %6 = vector.splati -9223372036854775808 : vector<8xi64>
  %7 = vector.splati -1 : vector<8xi64>
  %8 = vector.bitcast %value : vector<8xf64> to vector<8xi64>
  %9 = vector.cmpi slt, %8, %5 : vector<8xi64> -> vector<8xi1>
  %10 = vector.select %9, %7, %6 : vector<8xi64>
  %11 = vector.xori %8, %10 : vector<8xi64>
  %12 = vector.bitcast %lower : vector<8xf64> to vector<8xi64>
  %13 = vector.cmpi slt, %12, %5 : vector<8xi64> -> vector<8xi1>
  %14 = vector.select %13, %7, %6 : vector<8xi64>
  %15 = vector.xori %12, %14 : vector<8xi64>
  %16 = vector.bitcast %upper : vector<8xf64> to vector<8xi64>
  %17 = vector.cmpi slt, %16, %5 : vector<8xi64> -> vector<8xi1>
  %18 = vector.select %17, %7, %6 : vector<8xi64>
  %19 = vector.xori %16, %18 : vector<8xi64>
  %20 = vector.cmpi ugt, %11, %15 : vector<8xi64> -> vector<8xi1>
  %21 = vector.select %20, %8, %12 : vector<8xi64>
  %22 = vector.select %20, %11, %15 : vector<8xi64>
  %23 = vector.cmpi ult, %22, %19 : vector<8xi64> -> vector<8xi1>
  %24 = vector.select %23, %21, %16 : vector<8xi64>
  %result = vector.bitcast %24 : vector<8xi64> to vector<8xf64>
  func.return %result : vector<8xf64>
}

// ====

// The shaped F64 case crosses one 512-bit integer and predicate packet.
func.def @wide_shaped_maximum_f64(%lhs: vector<3x3xf64>, %rhs: vector<3x3xf64>) -> (vector<3x3xf64>) {
  %result = vector.maximumf %lhs, %rhs : vector<3x3xf64>
  func.return %result : vector<3x3xf64>
}

// ----
func.def @wide_shaped_maximum_f64(%lhs: vector<3x3xf64>, %rhs: vector<3x3xf64>) -> (vector<3x3xf64>) {
  %4 = vector.bitcast %lhs : vector<3x3xf64> to vector<9xf64>
  %5 = vector.bitcast %rhs : vector<3x3xf64> to vector<9xf64>
  %6 = vector.slice %4[0] : vector<9xf64> -> vector<8xf64>
  %7 = vector.slice %5[0] : vector<9xf64> -> vector<8xf64>
  %8 = vector.splati 0 : vector<8xi64>
  %9 = vector.splati 9223372036854775807 : vector<8xi64>
  %10 = vector.splati 9218868437227405312 : vector<8xi64>
  %11 = vector.splati 2251799813685248 : vector<8xi64>
  %12 = vector.splati -9223372036854775808 : vector<8xi64>
  %13 = vector.splati -1 : vector<8xi64>
  %14 = vector.bitcast %6 : vector<8xf64> to vector<8xi64>
  %15 = vector.andi %14, %9 : vector<8xi64>
  %16 = vector.cmpi ugt, %15, %10 : vector<8xi64> -> vector<8xi1>
  %17 = vector.cmpi slt, %14, %8 : vector<8xi64> -> vector<8xi1>
  %18 = vector.select %17, %13, %12 : vector<8xi64>
  %19 = vector.xori %14, %18 : vector<8xi64>
  %20 = vector.bitcast %7 : vector<8xf64> to vector<8xi64>
  %21 = vector.andi %20, %9 : vector<8xi64>
  %22 = vector.cmpi ugt, %21, %10 : vector<8xi64> -> vector<8xi1>
  %23 = vector.cmpi slt, %20, %8 : vector<8xi64> -> vector<8xi1>
  %24 = vector.select %23, %13, %12 : vector<8xi64>
  %25 = vector.xori %20, %24 : vector<8xi64>
  %26 = vector.cmpi ugt, %19, %25 : vector<8xi64> -> vector<8xi1>
  %27 = vector.select %26, %14, %20 : vector<8xi64>
  %28 = vector.ori %16, %22 : vector<8xi1>
  %29 = vector.select %22, %20, %27 : vector<8xi64>
  %30 = vector.select %16, %14, %29 : vector<8xi64>
  %31 = vector.ori %30, %11 : vector<8xi64>
  %32 = vector.select %28, %31, %30 : vector<8xi64>
  %33 = vector.bitcast %32 : vector<8xi64> to vector<8xf64>
  %34 = vector.slice %4[8] : vector<9xf64> -> vector<1xf64>
  %35 = vector.slice %5[8] : vector<9xf64> -> vector<1xf64>
  %36 = vector.splati 0 : vector<1xi64>
  %37 = vector.splati 9223372036854775807 : vector<1xi64>
  %38 = vector.splati 9218868437227405312 : vector<1xi64>
  %39 = vector.splati 2251799813685248 : vector<1xi64>
  %40 = vector.splati -9223372036854775808 : vector<1xi64>
  %41 = vector.splati -1 : vector<1xi64>
  %42 = vector.bitcast %34 : vector<1xf64> to vector<1xi64>
  %43 = vector.andi %42, %37 : vector<1xi64>
  %44 = vector.cmpi ugt, %43, %38 : vector<1xi64> -> vector<1xi1>
  %45 = vector.cmpi slt, %42, %36 : vector<1xi64> -> vector<1xi1>
  %46 = vector.select %45, %41, %40 : vector<1xi64>
  %47 = vector.xori %42, %46 : vector<1xi64>
  %48 = vector.bitcast %35 : vector<1xf64> to vector<1xi64>
  %49 = vector.andi %48, %37 : vector<1xi64>
  %50 = vector.cmpi ugt, %49, %38 : vector<1xi64> -> vector<1xi1>
  %51 = vector.cmpi slt, %48, %36 : vector<1xi64> -> vector<1xi1>
  %52 = vector.select %51, %41, %40 : vector<1xi64>
  %53 = vector.xori %48, %52 : vector<1xi64>
  %54 = vector.cmpi ugt, %47, %53 : vector<1xi64> -> vector<1xi1>
  %55 = vector.select %54, %42, %48 : vector<1xi64>
  %56 = vector.ori %44, %50 : vector<1xi1>
  %57 = vector.select %50, %48, %55 : vector<1xi64>
  %58 = vector.select %44, %42, %57 : vector<1xi64>
  %59 = vector.ori %58, %39 : vector<1xi64>
  %60 = vector.select %56, %59, %58 : vector<1xi64>
  %61 = vector.bitcast %60 : vector<1xi64> to vector<1xf64>
  %62 = vector.concat<0> %33, %61 : vector<8xf64>, vector<1xf64> -> vector<9xf64>
  %result = vector.bitcast %62 : vector<9xf64> to vector<3x3xf64>
  func.return %result : vector<3x3xf64>
}
