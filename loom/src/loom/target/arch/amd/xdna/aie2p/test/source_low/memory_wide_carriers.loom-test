func.def @exchange_signed_coordinate(%buffer: buffer, %base_input: offset, %position_input: i32, %value: i32) -> (i32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %base = index.assume %base_input [range(%base_input, 64, 128), multiple_of(%base_input, 8)] : offset
  %signed_position = scalar.assume %position_input [range(%position_input, -8, -1)] : i32
  %coordinate = index.cast %signed_position : i32 to index
  %bias = index.constant 8 : index
  %position = index.add %coordinate, %bias : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  func.return %previous : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @exchange_signed_coordinate(%base: reg<aie2p.er>, %signed_position: reg<aie2p.er>, %value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %20 = mov.i32 2
  %21 = lshl %signed_position, %20
  %22 = add.rr %base, %21
  %23 = add.address-index.immediate %22, 48
  %previous = lda.i32.index %view, %23
  st.i32.index %value, %view, %23
  return %previous
}
