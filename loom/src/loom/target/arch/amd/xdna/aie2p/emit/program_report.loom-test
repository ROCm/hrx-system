// RUN: with-checks emit aie2p-xdna output=compile-report

// Two logical helpers share one physical body. Three calls still execute;
// sharing code must not remove either helper from the dynamic instruction mix.
aie2p.target<configuration> @configuration_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

aie2p.target<core> @configuration_core_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration_target) abi(array_program) @configured_helper() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @initialize() asm {
  %column = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 2 : reg<aie2p.config.scalar : i64>
  program.load %column, %row, @configured_worker
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.core>(@configuration_core_target) abi(object_function) @configured_worker() asm {
  %output = mov.local-address 458752
  %lhs = mov.i32 11
  %rhs = mov.i32 13
  %sum = low.func.call @configured_add_pair(%lhs, %rhs) : (reg<aie2p.er>, reg<aie2p.er>) -> (reg<aie2p.er>)
  %sum2 = low.func.call @duplicate_add_pair(%sum, %rhs) : (reg<aie2p.er>, reg<aie2p.er>) -> (reg<aie2p.er>)
  %sum3 = low.func.call @configured_add_pair(%sum2, %lhs) : (reg<aie2p.er>, reg<aie2p.er>) -> (reg<aie2p.er>)
  st %sum3, %output, 0
  return
}

low.func.def target<amd.xdna.aie2p.core>(@configuration_core_target) @configured_add_pair(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %sum = add.rr %lhs, %rhs
  return %sum
}

low.func.def target<amd.xdna.aie2p.core>(@configuration_core_target) @duplicate_add_pair(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %sum = add.rr %lhs, %rhs
  return %sum
}

// ----
CHECK: COMPILE-REPORT: emission instructions=40 code_bytes=152 storage_bytes=162 body_instructions=40 entry_instructions=0 coissued_instructions=0 coissued_components=0
CHECK: COMPILE-REPORT: dynamic_instruction_mix descriptors=7 unknown=0 scalar_alu=6 * branch=4 *
