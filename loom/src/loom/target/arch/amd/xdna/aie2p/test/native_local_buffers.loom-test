// RUN: emit source-low output=low

aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

// One core reaches self, south, west, and north allocations through distinct
// load windows while each physical owner retains its storage reservation.
pipeline.def<kernel> public retain target(@device) @local_capture() run() {
  %self_memory = pipeline.memory<workgroup>[1, 3] : pool
  %south_memory = pipeline.memory<workgroup>[1, 2] : pool
  %west_memory = pipeline.memory<workgroup>[0, 3] : pool
  %north_memory = pipeline.memory<workgroup>[1, 4] : pool
  %bytes = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %self_storage = buffer.alloca<workgroup> pool(%self_memory) align(64) %bytes : buffer
  %south_storage = buffer.alloca<workgroup> pool(%south_memory) align(64) %bytes : buffer
  %west_storage = buffer.alloca<workgroup> pool(%west_memory) align(64) %bytes : buffer
  %north_storage = buffer.alloca<workgroup> pool(%north_memory) align(64) %bytes : buffer
  pipeline.strand workers([1, 3], [1, 1], [1, 1]) {
    %self_view = buffer.view %self_storage[%origin] : buffer -> view<16xi32>
    %south_view = buffer.view %south_storage[%origin] : buffer -> view<16xi32>
    %west_view = buffer.view %west_storage[%origin] : buffer -> view<16xi32>
    %north_view = buffer.view %north_storage[%origin] : buffer -> view<16xi32>
    %value_scalar = scalar.constant 42 : i32
    %value = vector.splat %value_scalar : vector<16xi32>
    vector.store %value, %self_view[0] : vector<16xi32>, view<16xi32>
    vector.store %value, %south_view[0] : vector<16xi32>, view<16xi32>
    vector.store %value, %west_view[0] : vector<16xi32>, view<16xi32>
    vector.store %value, %north_view[0] : vector<16xi32>, view<16xi32>
  }
}

// ----
low.func.def inline target<amd.xdna.aie2p.core> @__pipeline_worker_0() asm {
  %35 = mov.local-address 458752
  %39 = mov.local-address 393216
  %43 = mov.local-address 262144
  %47 = mov.local-address 327680
  %value_scalar = mov.short 42
  %value = vbcst.32 %value_scalar
  vst.512.i32x16 %value, %35, 0
  vst.512.i32x16 %value, %43, 0
  vst.512.i32x16 %value, %47, 0
  vst.512.i32x16 %value, %39, 0
  %32 = mov.short 1
  rel %32, 48
  low.br ^_bb1
^_bb1:
  %33 = mov.ss
  low.br ^_bb1
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_5) @__aie2p_worker_helper_6() asm {
  %52 = constant 36904960 : reg<aie2p.config.scalar : i64>
  %53 = constant 3 : reg<aie2p.config.scalar : i64>
  %54 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %52, %53, %54
  %55 = constant 1 : reg<aie2p.config.scalar : i64>
  program.load %55, %53, @__pipeline_worker_0
  %56 = constant 0 : reg<aie2p.config.scalar : i64>
  %57 = constant 64 : reg<aie2p.config.scalar : i64>
  data.reserve %56, %53, %56, %57
  data.reserve %55, %54, %56, %57
  data.reserve %55, %53, %56, %57
  %58 = constant 4 : reg<aie2p.config.scalar : i64>
  data.reserve %55, %58, %56, %57
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_5) @__aie2p_worker_helper_7() asm {
  %59 = constant 36827136 : reg<aie2p.config.scalar : i64>
  %60 = constant 0 : reg<aie2p.config.scalar : i64>
  write32 %59, %60
  measure.begin
  %61 = constant 36904960 : reg<aie2p.config.scalar : i64>
  %62 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %61, %62, %60
  %63 = constant 1 : reg<aie2p.config.scalar : i64>
  write.mask32 %61, %63, %63
  %64 = constant 63 : reg<aie2p.config.scalar : i64>
  wait.mask32 %59, %64, %63
  measure.end
  %65 = constant 3 : reg<aie2p.config.scalar : i64>
  write.mask32 %61, %65, %62
  return
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_5) abi(array_program) @local_capture() asm {
  %66 = constant 2 : reg<aie2p.config.scalar : i64>
  entry %66, @__aie2p_worker_helper_6, @__aie2p_worker_helper_7
  return
}
