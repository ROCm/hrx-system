// RUN: emit source-low output=low

aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

// One core reaches self, south, west, and north allocations through distinct
// load windows while each physical owner retains its storage reservation.
pipeline.def<kernel> public retain target(@device) @local_capture() run() {
  %self_memory = pipeline.memory<workgroup>[1, 3] : pool
  %south_memory = pipeline.memory<workgroup>[1, 2] : pool
  %west_memory = pipeline.memory<workgroup>[0, 3] : pool
  %north_memory = pipeline.memory<workgroup>[1, 4] : pool
  %bytes = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %self_storage = buffer.alloca<workgroup> pool(%self_memory) align(64) %bytes : buffer
  %south_storage = buffer.alloca<workgroup> pool(%south_memory) align(64) %bytes : buffer
  %west_storage = buffer.alloca<workgroup> pool(%west_memory) align(64) %bytes : buffer
  %north_storage = buffer.alloca<workgroup> pool(%north_memory) align(64) %bytes : buffer
  pipeline.strand workers([1, 3], [1, 1], [1, 1]) {
    %self_view = buffer.view %self_storage[%origin] : buffer -> view<16xi32>
    %south_view = buffer.view %south_storage[%origin] : buffer -> view<16xi32>
    %west_view = buffer.view %west_storage[%origin] : buffer -> view<16xi32>
    %north_view = buffer.view %north_storage[%origin] : buffer -> view<16xi32>
    %value = vector.splati 42 : vector<16xi32>
    vector.store %value, %self_view[0] : vector<16xi32>, view<16xi32>
    vector.store %value, %south_view[0] : vector<16xi32>, view<16xi32>
    vector.store %value, %west_view[0] : vector<16xi32>, view<16xi32>
    vector.store %value, %north_view[0] : vector<16xi32>, view<16xi32>
  }
}

// ----
low.func.def target<amd.xdna.aie2p.core> @__aie2p_worker_helper_5() asm {
  %43 = mov.local-address 327680
  %47 = mov.local-address 458752
  %51 = mov.local-address 393216
  %55 = mov.local-address 262144
  %92 = mov.short 42
  %value = vbcst.32 %92
  vst.512.i32x16 %value, %47, 0
  vst.512.i32x16 %value, %55, 0
  vst.512.i32x16 %value, %43, 0
  vst.512.i32x16 %value, %51, 0
  %71 = mov.short 1
  rel %71, 48
  low.br ^_bb1
^_bb1:
  %72 = mov.ss
  low.br ^_bb1
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_6) @__aie2p_worker_helper_7() asm {
  %73 = constant 36904960 : reg<aie2p.config.scalar : i64>
  %74 = constant 3 : reg<aie2p.config.scalar : i64>
  %75 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %73, %74, %75
  %76 = constant 1 : reg<aie2p.config.scalar : i64>
  program.load %76, %74, @__aie2p_worker_helper_5
  %77 = constant 0 : reg<aie2p.config.scalar : i64>
  %78 = constant 64 : reg<aie2p.config.scalar : i64>
  data.reserve %77, %74, %77, %78
  data.reserve %76, %75, %77, %78
  data.reserve %76, %74, %77, %78
  %79 = constant 4 : reg<aie2p.config.scalar : i64>
  data.reserve %76, %79, %77, %78
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_6) @__aie2p_worker_helper_8() asm {
  %80 = constant 36827136 : reg<aie2p.config.scalar : i64>
  %81 = constant 0 : reg<aie2p.config.scalar : i64>
  write32 %80, %81
  measure.begin
  %82 = constant 36904960 : reg<aie2p.config.scalar : i64>
  %83 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %82, %83, %81
  %84 = constant 1 : reg<aie2p.config.scalar : i64>
  write.mask32 %82, %84, %84
  %85 = constant 63 : reg<aie2p.config.scalar : i64>
  wait.mask32 %80, %85, %84
  measure.end
  %86 = constant 3 : reg<aie2p.config.scalar : i64>
  write.mask32 %82, %86, %83
  return
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_6) abi(array_program) @local_capture() asm {
  %87 = constant 2 : reg<aie2p.config.scalar : i64>
  entry %87, @__aie2p_worker_helper_7, @__aie2p_worker_helper_8
