  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs, %rhs, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<64xf32>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<64xf32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<64xf32>
  %lhs_value = vector.load %lhs_view[0] : view<64xf32> -> vector<64xf32>
  %rhs_value = vector.load %rhs_view[0] : view<64xf32> -> vector<64xf32>
  %sum = vector.addf %lhs_value, %rhs_value : vector<64xf32>
  vector.store %sum, %output_view[0] : vector<64xf32>, view<64xf32>
  func.return
}

