  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %first = vlda.512.i8x64.volatile %source_view, 0
  %second = vlda.512.i8x64.volatile %source_view, 0
  vst.512.i8x64.volatile %second, %output_view, 0
  return
}

