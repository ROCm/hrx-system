func.def target(@target) @copy_float_vectors(%source: buffer, %output: buffer) {
  %source_aligned, %output_aligned = buffer.assume.alignment %source, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %source_bf16x8_view = buffer.view %source_aligned[%base] : buffer -> view<16xbf16>
  %output_bf16x8_view = buffer.view %output_aligned[%base] : buffer -> view<16xbf16>
  %bf16x8 = vector.load %source_bf16x8_view[8] : view<16xbf16> -> vector<8xbf16>
  vector.store %bf16x8, %output_bf16x8_view[8] : vector<8xbf16>, view<16xbf16>
  %source_f32x4_view = buffer.view %source_aligned[%base] : buffer -> view<8xf32>
  %output_f32x4_view = buffer.view %output_aligned[%base] : buffer -> view<8xf32>
  %f32x4 = vector.load %source_f32x4_view[4] : view<8xf32> -> vector<4xf32>
  vector.store %f32x4, %output_f32x4_view[4] : vector<4xf32>, view<8xf32>
  %source_bf16x16_view = buffer.view %source_aligned[%base] : buffer -> view<32xbf16>
  %output_bf16x16_view = buffer.view %output_aligned[%base] : buffer -> view<32xbf16>
  %bf16x16 = vector.load %source_bf16x16_view[16] : view<32xbf16> -> vector<16xbf16>
  vector.store %bf16x16, %output_bf16x16_view[16] : vector<16xbf16>, view<32xbf16>
  %source_f32x8_view = buffer.view %source_aligned[%base] : buffer -> view<16xf32>
  %output_f32x8_view = buffer.view %output_aligned[%base] : buffer -> view<16xf32>
  %f32x8 = vector.load %source_f32x8_view[8] : view<16xf32> -> vector<8xf32>
  vector.store %f32x8, %output_f32x8_view[8] : vector<8xf32>, view<16xf32>
  %source_bf16x32_view = buffer.view %source_aligned[%base] : buffer -> view<64xbf16>
  %output_bf16x32_view = buffer.view %output_aligned[%base] : buffer -> view<64xbf16>
  %bf16x32 = vector.load %source_bf16x32_view[32] : view<64xbf16> -> vector<32xbf16>
  vector.store %bf16x32, %output_bf16x32_view[32] : vector<32xbf16>, view<64xbf16>
  %source_f32x16_view = buffer.view %source_aligned[%base] : buffer -> view<32xf32>
  %output_f32x16_view = buffer.view %output_aligned[%base] : buffer -> view<32xf32>
  %f32x16 = vector.load %source_f32x16_view[16] : view<32xf32> -> vector<16xf32>
  vector.store %f32x16, %output_f32x16_view[16] : vector<16xf32>, view<32xf32>
  func.return
}

func.def target(@target) @float_vector_bitcasts(
    %f32_values: vector<2xf32>,
    %bf16_values: vector<4xbf16>
) -> (vector<2xi32>, vector<4xi16>) {
  %f32_bits = vector.bitcast %f32_values : vector<2xf32> to vector<2xi32>
  %bf16_bits = vector.bitcast %bf16_values : vector<4xbf16> to vector<4xi16>
  func.return %f32_bits, %bf16_bits : vector<2xi32>, vector<4xi16>
}

