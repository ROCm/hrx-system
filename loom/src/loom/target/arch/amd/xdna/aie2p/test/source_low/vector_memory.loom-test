  vst.128.bf16x8 %bf16x8, %output_f32x16_view, 16
  %f32x4 = vlda.128.f32x4 %source_f32x16_view, 16
  vst.128.f32x4 %f32x4, %output_f32x16_view, 16
  %bf16x16 = vlda.256.bf16x16 %source_f32x16_view, 32
  vst.256.bf16x16 %bf16x16, %output_f32x16_view, 32
  %f32x8 = vlda.256.f32x8 %source_f32x16_view, 32
  vst.256.f32x8 %f32x8, %output_f32x16_view, 32
  %bf16x32 = vlda.512.bf16x32 %source_f32x16_view, 64
  vst.512.bf16x32 %bf16x32, %output_f32x16_view, 64
  %f32x16 = vlda.512.f32x16 %source_f32x16_view, 64
  vst.512.f32x16 %f32x16, %output_f32x16_view, 64
  return
}

