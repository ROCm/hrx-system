  %lhs_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %rhs_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %acc_view = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 3, source_type = buffer} : reg<aie2p.ep>
  %lhs_value = vlda.512.bf16x32 %lhs_view, 0
  %rhs_value = vlda.512.bf16x32 %rhs_view, 0
  %acc_value = vlda.512.f32x16 %acc_view, 0
  %24 = mova.i32 2
  %25 = vshuffle %lhs_value, %lhs_value, %24
  %26 = vshuffle %rhs_value, %rhs_value, %24
  %27 = mova.i32 3
  %28 = vshuffle %lhs_value, %lhs_value, %27
  %29 = vshuffle %rhs_value, %rhs_value, %27
  %30 = vmov.vector512.to.accumulator512.low %acc_value
  %31 = mova.i32 60
  %32 = vmac.bf16x16 %30, %25, %26, %31
  %33 = vmac.bf16x32 %32, %28, %29, %31
  %34 = slice %33[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %result = vmov.accumulator512.to.vector512 %34
  vst.512.f32x16 %result, %output_view, 0
  return
}

