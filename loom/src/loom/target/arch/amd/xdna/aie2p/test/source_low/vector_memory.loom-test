  %20 = slice %19[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  set.rounding 12
  %product = vconv.bf16.fp32 %20
  vst.512.bf16x32 %product, %output_view, 0
  return
}

