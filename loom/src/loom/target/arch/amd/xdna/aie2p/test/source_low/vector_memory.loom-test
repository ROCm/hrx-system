// RUN: emit source-low output=low

aie2p.target<core> @target
func.def target(@target) @volatile_copy_i8x64(
    %source: buffer,
    %output: buffer
) {
  %source_aligned, %output_aligned = buffer.assume.alignment %source, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<64xi8>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<64xi8>
  %first = vector.load<volatile> %source_view[0] : view<64xi8> -> vector<64xi8>
  %second = vector.load<volatile> %source_view[0] : view<64xi8> -> vector<64xi8>
  vector.store<volatile> %second, %output_view[0] : vector<64xi8>, view<64xi8>
  func.return
}

func.def target(@target) @copy_i8x64(%source: buffer, %output: buffer) {
  %source_aligned, %output_aligned = buffer.assume.alignment %source, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<128xi8>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<128xi8>
  %value = vector.load %source_view[64] : view<128xi8> -> vector<64xi8>
  vector.store %value, %output_view[64] : vector<64xi8>, view<128xi8>
  func.return
}

func.def target(@target) @add_i16x32(
    %lhs: buffer,
    %rhs: buffer,
    %output: buffer
) {
  %lhs_generic = buffer.assume.memory_space<generic> %lhs : buffer
  %rhs_generic = buffer.assume.memory_space<generic> %rhs : buffer
  %output_generic = buffer.assume.memory_space<generic> %output : buffer
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs_generic, %rhs_generic, %output_generic {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<64xi16>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<64xi16>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<64xi16>
  %lhs_value = vector.load %lhs_view[32] : view<64xi16> -> vector<32xi16>
  %rhs_value = vector.load %rhs_view[32] : view<64xi16> -> vector<32xi16>
  %sum = vector.addi %lhs_value, %rhs_value : vector<32xi16>
  vector.store %sum, %output_view[32] : vector<32xi16>, view<64xi16>
  func.return
}

func.def target(@target) @add_i32x16(
    %lhs: buffer,
    %rhs: buffer,
    %output: buffer
) {
  %lhs_local = buffer.assume.memory_space<workgroup> %lhs : buffer
  %rhs_local = buffer.assume.memory_space<workgroup> %rhs : buffer
  %output_local = buffer.assume.memory_space<workgroup> %output : buffer
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs_local, %rhs_local, %output_local {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 64 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<16xi32>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16xi32>
  %lhs_value = vector.load %lhs_view[0] : view<16xi32> -> vector<16xi32>
  %rhs_value = vector.load %rhs_view[0] : view<16xi32> -> vector<16xi32>
  %sum = vector.addi %lhs_value, %rhs_value : vector<16xi32>
  vector.store %sum, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

func.def target(@target) @copy_i32x16_materialized_static(
    %source: buffer,
    %output: buffer
) {
  %source_aligned, %output_aligned = buffer.assume.alignment %source, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<512xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<512xi32>
  %value = vector.load %source_view[256] : view<512xi32> -> vector<16xi32>
  vector.store %value, %output_view[256] : vector<16xi32>, view<512xi32>
  func.return
}

func.def target(@target) @copy_i32x16_dynamic(
    %source: buffer,
    %output: buffer,
    %element0: index
) {
  %source_aligned, %output_aligned = buffer.assume.alignment %source, %output {minimum_alignment = 64} : buffer, buffer
  %element = index.assume %element0 [range(%element0, 0, 48), mul(%element0, 16)] : index
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<64xi32>
  %value = vector.load %source_view[%element] : view<64xi32> -> vector<16xi32>
  vector.store %value, %output_view[%element] : vector<16xi32>, view<64xi32>
  func.return
}

func.def target(@target) @copy_i32x16_dynamic_static(
    %source: buffer,
    %output: buffer,
    %element0: index
) {
  %source_aligned, %output_aligned = buffer.assume.alignment %source, %output {minimum_alignment = 64} : buffer, buffer
  %element = index.assume %element0 [range(%element0, 0, 48), mul(%element0, 16)] : index
  %base = index.constant 64 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<64xi32>
  %value = vector.load %source_view[%element] : view<64xi32> -> vector<16xi32>
  vector.store %value, %output_view[%element] : vector<16xi32>, view<64xi32>
  func.return
}

func.def target(@target) @copy_float_vectors(%source: buffer, %output: buffer) {
  %source_aligned, %output_aligned = buffer.assume.alignment %source, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %source_bf16x8_view = buffer.view %source_aligned[%base] : buffer -> view<16xbf16>
  %output_bf16x8_view = buffer.view %output_aligned[%base] : buffer -> view<16xbf16>
  %bf16x8 = vector.load %source_bf16x8_view[8] : view<16xbf16> -> vector<8xbf16>
  vector.store %bf16x8, %output_bf16x8_view[8] : vector<8xbf16>, view<16xbf16>
  %source_f32x4_view = buffer.view %source_aligned[%base] : buffer -> view<8xf32>
  %output_f32x4_view = buffer.view %output_aligned[%base] : buffer -> view<8xf32>
  %f32x4 = vector.load %source_f32x4_view[4] : view<8xf32> -> vector<4xf32>
  vector.store %f32x4, %output_f32x4_view[4] : vector<4xf32>, view<8xf32>
  %source_bf16x16_view = buffer.view %source_aligned[%base] : buffer -> view<32xbf16>
  %output_bf16x16_view = buffer.view %output_aligned[%base] : buffer -> view<32xbf16>
  %bf16x16 = vector.load %source_bf16x16_view[16] : view<32xbf16> -> vector<16xbf16>
  vector.store %bf16x16, %output_bf16x16_view[16] : vector<16xbf16>, view<32xbf16>
  %source_f32x8_view = buffer.view %source_aligned[%base] : buffer -> view<16xf32>
  %output_f32x8_view = buffer.view %output_aligned[%base] : buffer -> view<16xf32>
  %f32x8 = vector.load %source_f32x8_view[8] : view<16xf32> -> vector<8xf32>
  vector.store %f32x8, %output_f32x8_view[8] : vector<8xf32>, view<16xf32>
  %source_bf16x32_view = buffer.view %source_aligned[%base] : buffer -> view<64xbf16>
  %output_bf16x32_view = buffer.view %output_aligned[%base] : buffer -> view<64xbf16>
  %bf16x32 = vector.load %source_bf16x32_view[32] : view<64xbf16> -> vector<32xbf16>
  vector.store %bf16x32, %output_bf16x32_view[32] : vector<32xbf16>, view<64xbf16>
  %source_f32x16_view = buffer.view %source_aligned[%base] : buffer -> view<32xf32>
  %output_f32x16_view = buffer.view %output_aligned[%base] : buffer -> view<32xf32>
  %f32x16 = vector.load %source_f32x16_view[16] : view<32xf32> -> vector<16xf32>
  vector.store %f32x16, %output_f32x16_view[16] : vector<16xf32>, view<32xf32>
  func.return
}

func.def target(@target) @float_vector_bitcasts(
    %f32_values: vector<2xf32>,
    %bf16_values: vector<4xbf16>
) -> (vector<2xi32>, vector<4xi16>) {
  %f32_bits = vector.bitcast %f32_values : vector<2xf32> to vector<2xi32>
  %bf16_bits = vector.bitcast %bf16_values : vector<4xbf16> to vector<4xi16>
  func.return %f32_bits, %bf16_bits : vector<2xi32>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @volatile_copy_i8x64() asm {
  %source_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %first = vlda.512.i8x64.volatile %source_view, 0
  %second = vlda.512.i8x64.volatile %source_view, 0
  vst.512.i8x64.volatile %second, %output_view, 0
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @copy_i8x64() asm {
  %source_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %value = vlda.512.i8x64 %source_view, 64
  vst.512.i8x64 %value, %output_view, 64
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @add_i16x32() asm {
  %lhs_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %rhs_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %lhs_value = vlda.512.i16x32 %lhs_view, 64
  %rhs_value = vlda.512.i16x32 %rhs_view, 64
  %sum = vadd.16 %lhs_value, %rhs_value
  vst.512.i16x32 %sum, %output_view, 64
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @add_i32x16() asm {
  %lhs_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %rhs_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %lhs_value = vlda.512.i32x16 %lhs_view, 64
  %rhs_value = vlda.512.i32x16 %rhs_view, 64
  %sum = vadd.32 %lhs_value, %rhs_value
  vst.512.i32x16 %sum, %output_view, 64
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @copy_i32x16_materialized_static() asm {
  %source_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %127 = mov.static-byte-offset 1024
  %128 = mov.address-index %127
  %value = vlda.512.i32x16.index %source_view, %128
  vst.512.i32x16.index %value, %output_view, %128
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @copy_i32x16_dynamic(%element: reg<aie2p.er>) asm {
  %source_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %135 = mov.i32 2
  %136 = lshl %element, %135
  %137 = mov.address-index %136
  %value = vlda.512.i32x16.index %source_view, %137
  vst.512.i32x16.index %value, %output_view, %137
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @copy_i32x16_dynamic_static(%element: reg<aie2p.er>) asm {
  %source_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %145 = mov.static-byte-offset 64
  %146 = mov.i32 2
  %147 = lshl %element, %146
  %148 = add.rr %147, %145
  %149 = mov.address-index %148
  %value = vlda.512.i32x16.index %source_view, %149
  %154 = add.rr %147, %145
  %155 = mov.address-index %154
  vst.512.i32x16.index %value, %output_view, %155
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @copy_float_vectors() asm {
  %source_f32x16_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_f32x16_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %bf16x8 = vlda.128.bf16x8 %source_f32x16_view, 16
  vst.128.bf16x8 %bf16x8, %output_f32x16_view, 16
  %f32x4 = vlda.128.f32x4 %source_f32x16_view, 16
  vst.128.f32x4 %f32x4, %output_f32x16_view, 16
  %bf16x16 = vlda.256.bf16x16 %source_f32x16_view, 32
  vst.256.bf16x16 %bf16x16, %output_f32x16_view, 32
  %f32x8 = vlda.256.f32x8 %source_f32x16_view, 32
  vst.256.f32x8 %f32x8, %output_f32x16_view, 32
  %bf16x32 = vlda.512.bf16x32 %source_f32x16_view, 64
  vst.512.bf16x32 %bf16x32, %output_f32x16_view, 64
  %f32x16 = vlda.512.f32x16 %source_f32x16_view, 64
  vst.512.f32x16 %f32x16, %output_f32x16_view, 64
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @float_vector_bitcasts(%f32_bits: reg<aie2p.vec256 x2>, %bf16_bits: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  return %f32_bits, %bf16_bits
}

// ====

aie2p.target<core> @target
func.def target(@target) @multiply_bf16x32(
    %lhs: buffer,
    %rhs: buffer,
    %output: buffer
) {
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs, %rhs, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<32xbf16>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<32xbf16>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<32xbf16>
  %lhs_value = vector.load %lhs_view[0] : view<32xbf16> -> vector<32xbf16>
  %rhs_value = vector.load %rhs_view[0] : view<32xbf16> -> vector<32xbf16>
  %product = vector.mulf %lhs_value, %rhs_value : vector<32xbf16>
  vector.store %product, %output_view[0] : vector<32xbf16>, view<32xbf16>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @multiply_bf16x32() asm {
  %lhs_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %rhs_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %lhs_value = vlda.512.bf16x32 %lhs_view, 0
  %rhs_value = vlda.512.bf16x32 %rhs_view, 0
  %18 = mova.i32 60
  %19 = vmul.bf16x32 %lhs_value, %rhs_value, %18
  %20 = slice %19[0] : reg<aie2p.mcms x2> -> reg<aie2p.mcms>
  set.rounding 12
  %product = vconv.bf16.fp32 %20
  vst.512.bf16x32 %product, %output_view, 0
  return
}
