func.def target(@target) @multiply_bf16x32(
    %lhs: buffer,
    %rhs: buffer,
    %output: buffer
) {
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs, %rhs, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<32xbf16>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<32xbf16>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<32xbf16>
  %lhs_value = vector.load %lhs_view[0] : view<32xbf16> -> vector<32xbf16>
  %rhs_value = vector.load %rhs_view[0] : view<32xbf16> -> vector<32xbf16>
  %product = vector.mulf %lhs_value, %rhs_value : vector<32xbf16>
  vector.store %product, %output_view[0] : vector<32xbf16>, view<32xbf16>
  func.return
}

