// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @overlapping_vector_copy(%buffer: buffer) -> (vector<3xf16>) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %buffer {minimum_alignment = 2} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<4xf16>
  %value = vector.load %view[0] : view<4xf16> -> vector<3xf16>
  vector.store %value, %view[1] : vector<3xf16>, view<4xf16>
  func.return %value : vector<3xf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @overlapping_vector_copy() -> (reg<aie2p.vec256 x2>) asm {
  %view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %21 = lda.u16 %view, 0
  %22 = lda.u16 %view, 2
  %23 = lda.u16 %view, 4
  %24 = vbcst.16 %21
  %25 = mov.short 1
  %26 = copy %25 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %27 = vinsert.16.reg %24, %26, %22
  %28 = mov.short 2
  %29 = copy %28 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %value = vinsert.16.reg %27, %29, %23
  st.s16 %21, %view, 2
  st.s16 %22, %view, 4
  st.s16 %23, %view, 6
  return %value
}

