aie2p.target<core> @target

func.def target(@target) @gather_scatter_i16x4(%input: buffer, %output: buffer) -> (vector<4xi16>) {
  %base = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 2} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 2} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<16xi16>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16xi16>
  %c0 = scalar.constant 0 : i32
  %c3 = scalar.constant 3 : i32
  %c7 = scalar.constant 7 : i32
  %c12 = scalar.constant 12 : i32
  %offsets = vector.from_elements %c0, %c3, %c7, %c12 : vector<4xi32>
  %value = vector.gather %input_view[0][%offsets] : view<16xi16>, vector<4xi32> -> vector<4xi16>
  vector.scatter %value, %output_view[0][%offsets] : vector<4xi16>, view<16xi16>, vector<4xi32>
  func.return %value : vector<4xi16>
}

// ----
CHECK: * = lda.u16 %input_view, 0
CHECK: * = lda.u16 %input_view, 6
CHECK: * = lda.u16 %input_view, 14
CHECK: * = mov.static-byte-offset 24
CHECK: * = mov.address-index *
CHECK: * = lda.i16.index %input_view, *
CHECK: %value = vinsert.16.reg *
CHECK: st.s16 *, %output_view, 0
CHECK: st.s16 *, %output_view, 6
CHECK: st.s16 *, %output_view, 14
CHECK: st.i16.index *, %output_view, *
CHECK: return %value

