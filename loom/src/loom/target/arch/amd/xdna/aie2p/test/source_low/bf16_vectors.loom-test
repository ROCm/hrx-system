func.def @bf16x8_result(%table: vector<16xbf16>, %indices: vector<8xi16>) -> (vector<8xbf16>) {
  %values = vector.table.lookup %table[%indices] : vector<16xbf16>, vector<8xi16> -> vector<8xbf16>
  func.return %values : vector<8xbf16>
}

