// ====

func.def @bf16x8_bitcast_select(%bits: vector<8xi16>, %other: vector<8xbf16>, %mask: vector<8xi1>) -> (vector<8xi16>) {
  %values = vector.bitcast %bits : vector<8xi16> to vector<8xbf16>
  %selected = vector.select %mask, %values, %other : vector<8xbf16>
  %result = vector.bitcast %selected : vector<8xbf16> to vector<8xi16>
  func.return %result : vector<8xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bf16x8_bitcast_select(%values: reg<aie2p.vec256 x2>, %other: reg<aie2p.vec256 x2>, %mask: reg<aie2p.elpredicate>) -> (reg<aie2p.vec256 x2>) asm {
  %result = vsel.16.mask64 %other, %values, %mask
  return %result
}

// ====

func.def @bf16x8_dynamic_extract_insert(%values: vector<8xbf16>, %position: index) -> (vector<8xbf16>) {
  %value = vector.extract %values[%position] : vector<8xbf16> -> bf16
  %result = vector.insert %value into %values[0] : bf16, vector<8xbf16>
  func.return %result : vector<8xbf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bf16x8_dynamic_extract_insert(%values: reg<aie2p.vec256 x2>, %position: reg<aie2p.er>) -> (reg<aie2p.vec256 x2>) asm {
  %value = vextract.16.reg %values, %position
  %result = vinsert.16.zero %values, %value
  return %result
}
