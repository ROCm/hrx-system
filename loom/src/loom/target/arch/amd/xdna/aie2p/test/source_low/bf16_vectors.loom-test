low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bf16x8_result(%table: reg<aie2p.vec256 x2>, %indices: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %40 = vextract.16.imm %indices, 0
