// TEMPLATE: loom/src/loom/test/corpus/source_low/bf16_vectors.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @bf16x8_lookup(%table: vector<8xbf16>, %indices: vector<8xi16>) -> (vector<8xbf16>) {
  %values = vector.table.lookup %table[%indices] : vector<8xbf16>, vector<8xi16> -> vector<8xbf16>
  func.return %values : vector<8xbf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bf16x8_lookup(%table: reg<aie2p.vec256 x2>, %indices: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %40 = mov.short 0
  %41 = vbcst.16 %40
  %42 = mov.short 1
  %43 = vbcst.16 %42
  %44 = vband %indices, %43
  %45 = vlt.u16x32.el.low32 %41, %44
  %46 = predicate.complete.zero.high32 %45, 0
  %47 = mov.short 2
  %48 = vbcst.16 %47
  %49 = vband %indices, %48
  %50 = vlt.u16x32.el.low32 %41, %49
  %51 = predicate.complete.zero.high32 %50, 0
  %52 = mov.short 4
  %53 = vbcst.16 %52
  %54 = vband %indices, %53
  %55 = vlt.u16x32.el.low32 %41, %54
  %56 = predicate.complete.zero.high32 %55, 0
  %57 = vextbcst.16 %table, 0
  %58 = vextbcst.16 %table, 1
  %59 = vsel.16.mask64 %57, %58, %46
  %60 = vextbcst.16 %table, 2
  %61 = vextbcst.16 %table, 3
  %62 = vsel.16.mask64 %60, %61, %46
  %63 = vsel.16.mask64 %59, %62, %51
  %64 = vextbcst.16 %table, 4
  %65 = vextbcst.16 %table, 5
  %66 = vsel.16.mask64 %64, %65, %46
  %67 = vextbcst.16 %table, 6
  %68 = vextbcst.16 %table, 7
  %69 = vsel.16.mask64 %67, %68, %46
  %70 = vsel.16.mask64 %66, %69, %51
  %values = vsel.16.mask64 %63, %70, %56
  return %values
}

