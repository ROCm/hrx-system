// RUN: emit aie2p-array-plan @coprime_ring_array

// Coprime ring capacities advance and wrap independently in the resident loop.

aie2p.target<array> @coprime_array_target

aie2p.target<core> @coprime_core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@coprime_array_target) abi(array_program) @coprime_ring_array() asm {
  %worker_lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lane0 = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity2 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %capacity3 = constant.u32 3 : reg<aie2p.array.scalar : index>
  %record_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>

  %workers = group %worker_lanes
  %worker = worker %workers, %lane0, @consume_coprime

  %input0 = binding 0, "read"
  %input1 = binding 1, "read"
  %input0_sender = sender %input0, 0 : reg<aie2p.array.sender : tile<4xi8>>
  %input1_sender = sender %input1, 0 : reg<aie2p.array.sender : tile<4xi8>>
  %worker_input0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<4xi8>>
  %worker_input1 = receiver %worker, 1 : reg<aie2p.array.receiver : tile<4xi8>>
  %input0_channel = channel %input0_sender, %worker_input0, %capacity2, %record_count : reg<aie2p.array.channel : tile<4xi8>>
  %input1_channel = channel %input1_sender, %worker_input1, %capacity3, %record_count : reg<aie2p.array.channel : tile<4xi8>>

  constrain.location %worker, %lane0, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@coprime_core_target) abi(object_function) @consume_coprime() asm {
  %input0 = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %input1 = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %lhs = lda.u8 %input0, 0
  %rhs = lda.u8 %input1, 0
  %sum = add.rr %lhs, %rhs
  st.s8 %sum, %input0, 0
  return
}

