binding index=1 ordinal=1 access=read
worker index=0 group=0 lane=0 entry=@consume_coprime tile=(0,2) resources=2 storage-domains=0
channel index=0 transport=external-dma record-bytes=4 capacity=2 records=1 sender=binding[0]:0 receiver=worker[0]:0
channel index=1 transport=external-dma record-bytes=4 capacity=3 records=1 sender=binding[1]:0 receiver=worker[0]:1
worker-port worker=0 port=0 direction=receive channel=0 first-slot=0
worker-port worker=0 port=1 direction=receive channel=1 first-slot=2
slot channel=0 index=0 owner=(0,2) offset=0x00000 bytes=4 sender=external receiver=0x70000
slot channel=0 index=1 owner=(0,2) offset=0x04000 bytes=4 sender=external receiver=0x74000
slot channel=1 index=0 owner=(0,2) offset=0x08000 bytes=4 sender=external receiver=0x78000
slot channel=1 index=1 owner=(0,2) offset=0x0c000 bytes=4 sender=external receiver=0x7c000
