low.func.def retain target<amd.xdna.aie2p.core>(@coprime_core_target) @coprime_ring_array$worker$0() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %47 = mov.local-address 458752
  %48 = mov.local-address 491520
  %ring_slot_zero = mov.short 0
  low.br ^_bb1(%47: reg<aie2p.ep>, %48: reg<aie2p.ep>, %ring_slot_zero: reg<aie2p.er>)
^_bb1(%input0: reg<aie2p.ep>, %input1: reg<aie2p.ep>, %30: reg<aie2p.er>):
  acq %acquire_delta, 49
  acq %acquire_delta, 51
  low.br ^_bb2
^_bb2:
  %lhs = lda.u8 %input0, 0
  %rhs = lda.u8 %input1, 0
  %sum = add.rr %lhs, %rhs
  st.s8 %sum, %input0, 0
  low.br ^_bb3
^_bb3:
  rel %release_delta, 48
  rel %release_delta, 50
  %31 = mov.address-to-scalar %input0
  %32 = mov.i32 16384
  %33 = xor %31, %32
  %34 = mov.scalar-to-address %33
  %37 = mov.short 0
  %38 = eq %30, %37
  low.cond_br %38, ^_bb6, ^_bb4 : reg<aie2p.er>
^_bb4:
  %39 = mov.short 1
  %40 = eq %30, %39
  low.cond_br %40, ^_bb7, ^_bb5 : reg<aie2p.er>
^_bb5:
  %41 = mov.local-address 491520
  %42 = mov.short 0
  low.br ^_bb8(%41: reg<aie2p.ep>, %42: reg<aie2p.er>)
^_bb6:
  %43 = mov.local-address 507904
  %44 = mov.short 1
  low.br ^_bb8(%43: reg<aie2p.ep>, %44: reg<aie2p.er>)
^_bb7:
  %45 = mov.local-address 458816
  %46 = mov.short 2
  low.br ^_bb8(%45: reg<aie2p.ep>, %46: reg<aie2p.er>)
^_bb8(%35: reg<aie2p.ep>, %36: reg<aie2p.er>):
  low.br ^_bb1(%34: reg<aie2p.ep>, %35: reg<aie2p.ep>, %36: reg<aie2p.er>)
}
