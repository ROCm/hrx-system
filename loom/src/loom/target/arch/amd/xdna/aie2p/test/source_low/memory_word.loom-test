// ====

// Packed records can place complete word vectors at odd byte origins.
func.def @copy_word_unaligned(%input: buffer, %output: buffer) {
  %first = index.constant 1 : offset
  %second = index.constant 17 : offset
  %third = index.constant 33 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<8xf16, align(1)>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<8xbf16, align(1)>
  %source_integer = buffer.view %input[%third] : buffer -> view<8xi16, align(1)>
  %target_half = buffer.view %output[%first] : buffer -> view<8xf16, align(1)>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<8xbf16, align(1)>
  %target_integer = buffer.view %output[%third] : buffer -> view<8xi16, align(1)>
  %half = vector.load %source_half[0] : view<8xf16, align(1)> -> vector<8xf16>
  %bfloat = vector.load %source_bfloat[0] : view<8xbf16, align(1)> -> vector<8xbf16>
  %integer = vector.load %source_integer[0] : view<8xi16, align(1)> -> vector<8xi16>
  vector.store %half, %target_half[0] : vector<8xf16>, view<8xf16, align(1)>
  vector.store %bfloat, %target_bfloat[0] : vector<8xbf16>, view<8xbf16, align(1)>
  vector.store %integer, %target_integer[0] : vector<8xi16>, view<8xi16, align(1)>
  func.return
}

