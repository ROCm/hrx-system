// Three-word tails must not read or write a fourth word.
func.def @copy_word_tail(%input: buffer, %output: buffer) {
  %first = index.constant 1 : offset
  %second = index.constant 7 : offset
  %third = index.constant 13 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<3xf16, align(1)>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<3xbf16, align(1)>
  %source_integer = buffer.view %input[%third] : buffer -> view<3xi16, align(1)>
  %target_half = buffer.view %output[%first] : buffer -> view<3xf16, align(1)>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<3xbf16, align(1)>
  %target_integer = buffer.view %output[%third] : buffer -> view<3xi16, align(1)>
  %half = vector.load %source_half[0] : view<3xf16, align(1)> -> vector<3xf16>
  %bfloat = vector.load %source_bfloat[0] : view<3xbf16, align(1)> -> vector<3xbf16>
  %integer = vector.load %source_integer[0] : view<3xi16, align(1)> -> vector<3xi16>
  vector.store %half, %target_half[0] : vector<3xf16>, view<3xf16, align(1)>
  vector.store %bfloat, %target_bfloat[0] : vector<3xbf16>, view<3xbf16, align(1)>
  vector.store %integer, %target_integer[0] : vector<3xi16>, view<3xi16, align(1)>
  func.return
}

