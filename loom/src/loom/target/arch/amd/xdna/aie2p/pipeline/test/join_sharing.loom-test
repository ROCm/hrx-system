// RUN: with-checks emit source-low output=low
// Only the three-edge participant has enough repeated lock work to amortize
// a call boundary. The other three participants keep their short joins inline.
aie2p.target<array> @device {device_profile = "amd.xdna.strix_halo.17f0_11"}

pipeline.def @write() run(%storage: buffer, %value: i32) {
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %origin = index.constant 0 : offset
    %destination = buffer.view %storage[%origin] : buffer -> view<4xi32>
    view.store %value, %destination[0] : i32, view<4xi32>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %origin = index.constant 0 : offset
    %destination = buffer.view %storage[%origin] : buffer -> view<4xi32>
    view.store %value, %destination[1] : i32, view<4xi32>
  }
  pipeline.strand workers([0, 4], [1, 1], [1, 1]) {
    %origin = index.constant 0 : offset
    %destination = buffer.view %storage[%origin] : buffer -> view<4xi32>
    view.store %value, %destination[2] : i32, view<4xi32>
  }
  pipeline.strand workers([1, 3], [1, 1], [1, 1]) {
    %origin = index.constant 0 : offset
    %destination = buffer.view %storage[%origin] : buffer -> view<4xi32>
    view.store %value, %destination[3] : i32, view<4xi32>
  }
}

pipeline.def<kernel> public retain target(@device) @joined() run() {
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %bytes = index.constant 16 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  pipeline.serial {
    %value0 = scalar.constant 0 : i32
    pipeline.compose @write(%storage, %value0) : (buffer, i32)
    %value1 = scalar.constant 1 : i32
    pipeline.compose @write(%storage, %value1) : (buffer, i32)
    %value2 = scalar.constant 2 : i32
    pipeline.compose @write(%storage, %value2) : (buffer, i32)
    %value3 = scalar.constant 3 : i32
    pipeline.compose @write(%storage, %value3) : (buffer, i32)
    %value4 = scalar.constant 4 : i32
    pipeline.compose @write(%storage, %value4) : (buffer, i32)
    %value5 = scalar.constant 5 : i32
    pipeline.compose @write(%storage, %value5) : (buffer, i32)
  }
}
// ----
CHECK-COUNT-1: low.func.def noinline target<amd.xdna.aie2p.core> *
CHECK-COUNT-6: low.func.call @__aie2p_worker_helper_*
// ====
// RUN: with-checks emit source-low output=low
// Five copies of the same three-edge join tie its estimated sharing cost.
// The source remains entirely inline at this boundary.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @write() run(%storage: buffer, %value: i32) {
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %origin = index.constant 0 : offset
    %destination = buffer.view %storage[%origin] : buffer -> view<4xi32>
    view.store %value, %destination[0] : i32, view<4xi32>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %origin = index.constant 0 : offset
    %destination = buffer.view %storage[%origin] : buffer -> view<4xi32>
    view.store %value, %destination[1] : i32, view<4xi32>
  }
  pipeline.strand workers([0, 4], [1, 1], [1, 1]) {
    %origin = index.constant 0 : offset
    %destination = buffer.view %storage[%origin] : buffer -> view<4xi32>
    view.store %value, %destination[2] : i32, view<4xi32>
  }
  pipeline.strand workers([1, 3], [1, 1], [1, 1]) {
    %origin = index.constant 0 : offset
    %destination = buffer.view %storage[%origin] : buffer -> view<4xi32>
    view.store %value, %destination[3] : i32, view<4xi32>
  }
}

pipeline.def<kernel> public retain target(@device) @joined() run() {
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %bytes = index.constant 16 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  pipeline.serial {
    %value0 = scalar.constant 0 : i32
    pipeline.compose @write(%storage, %value0) : (buffer, i32)
    %value1 = scalar.constant 1 : i32
    pipeline.compose @write(%storage, %value1) : (buffer, i32)
    %value2 = scalar.constant 2 : i32
    pipeline.compose @write(%storage, %value2) : (buffer, i32)
    %value3 = scalar.constant 3 : i32
    pipeline.compose @write(%storage, %value3) : (buffer, i32)
    %value4 = scalar.constant 4 : i32
    pipeline.compose @write(%storage, %value4) : (buffer, i32)
  }
}
// ----
CHECK-COUNT-4: low.func.def target<amd.xdna.aie2p.core> *
CHECK-NOT: low.func.def noinline *
CHECK-NOT: low.func.call *
