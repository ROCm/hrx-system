// ====

// RUN: with-checks compile-report target=amd.xdna.aie2p:core target-legalize{mode=final}

// Unsupported i64 arithmetic and extrema retain their scalar reference path,
// while the target-native bitwise operations require no legalization row.
func.def @i64_combining_reference_fallback(%lhs: vector<4xi64>, %rhs: vector<4xi64>) -> (vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>) {
  %sum = vector.addi %lhs, %rhs : vector<4xi64>
  %product = vector.muli %lhs, %rhs : vector<4xi64>
  %signed_minimum = vector.minsi %lhs, %rhs : vector<4xi64>
  %signed_maximum = vector.maxsi %lhs, %rhs : vector<4xi64>
  %unsigned_minimum = vector.minui %lhs, %rhs : vector<4xi64>
  %unsigned_maximum = vector.maxui %lhs, %rhs : vector<4xi64>
  %bitwise_and = vector.andi %lhs, %rhs : vector<4xi64>
  %bitwise_or = vector.ori %lhs, %rhs : vector<4xi64>
  %bitwise_xor = vector.xori %lhs, %rhs : vector<4xi64>
  func.return %sum, %product, %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum, %bitwise_and, %bitwise_or, %bitwise_xor : vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>, vector<4xi64>
}

