// Unaligned packet fallback is attributed to the authored store for each
// physical element width instead of hiding scalarization in generated stores.
func.def @unaligned_store_i8x64(%value: vector<64xi8>, %output: buffer) {
  %origin = index.constant 0 : offset
  %output_view = buffer.view %output[%origin] : buffer -> view<64xi8>
  vector.store %value, %output_view[0] : vector<64xi8>, view<64xi8>
  func.return
}

