// RUN: with-checks compile-report target=amd.xdna.aie2p:core target-legalize{mode=final}

func.def @vector_f64_extrema(%value: vector<2xf64>, %lhs: vector<2xf64>, %rhs: vector<2xf64>) -> (vector<2xf64>, vector<2xf64>) {
  %minimum = vector.minimumf %lhs, %rhs : vector<2xf64>
  %ieee = vector.clampf<ieee> %value, %lhs, %rhs : vector<2xf64>
  func.return %minimum, %ieee : vector<2xf64>, vector<2xf64>
}

// ----
