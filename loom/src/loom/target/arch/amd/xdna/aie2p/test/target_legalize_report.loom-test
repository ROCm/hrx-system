// RUN: with-checks compile-report target=amd.xdna.aie2p:core target-legalize{mode=eager}

// Operation selection and element representation are independent dimensions:
// the cases above cover every combining kind, while this matrix proves the
// structural rewrite preserves every numeric source element type.
func.def @partial_reduction_element_types(%i1_values: vector<2x2xi1>, %i1_init: vector<2xi1>, %i8_values: vector<2x2xi8>, %i8_init: vector<2xi8>, %i16_values: vector<2x2xi16>, %i16_init: vector<2xi16>, %i32_values: vector<2x2xi32>, %i32_init: vector<2xi32>, %i64_values: vector<2x2xi64>, %i64_init: vector<2xi64>, %f8e4m3_values: vector<2x2xf8E4M3>, %f8e4m3_init: vector<2xf8E4M3>, %f8e5m2_values: vector<2x2xf8E5M2>, %f8e5m2_init: vector<2xf8E5M2>, %f16_values: vector<2x2xf16>, %f16_init: vector<2xf16>, %bf16_values: vector<2x2xbf16>, %bf16_init: vector<2xbf16>, %f32_values: vector<2x2xf32>, %f32_init: vector<2xf32>, %f64_values: vector<2x2xf64>, %f64_init: vector<2xf64>) -> (vector<2xi1>, vector<2xi8>, vector<2xi16>, vector<2xi32>, vector<2xi64>, vector<2xf8E4M3>, vector<2xf8E5M2>, vector<2xf16>, vector<2xbf16>, vector<2xf32>, vector<2xf64>) {
  %i1 = vector.reduce.axes<ori> %i1_values, %i1_init axes [0] : vector<2x2xi1>, vector<2xi1>
  %i8 = vector.reduce.axes<ori> %i8_values, %i8_init axes [0] : vector<2x2xi8>, vector<2xi8>
  %i16 = vector.reduce.axes<ori> %i16_values, %i16_init axes [0] : vector<2x2xi16>, vector<2xi16>
  %i32 = vector.reduce.axes<ori> %i32_values, %i32_init axes [0] : vector<2x2xi32>, vector<2xi32>
  %i64 = vector.reduce.axes<ori> %i64_values, %i64_init axes [0] : vector<2x2xi64>, vector<2xi64>
  %f8e4m3 = vector.reduce.axes<maxnumf, nnan|nsz> %f8e4m3_values, %f8e4m3_init axes [0] : vector<2x2xf8E4M3>, vector<2xf8E4M3>
  %f8e5m2 = vector.reduce.axes<maxnumf, nnan|nsz> %f8e5m2_values, %f8e5m2_init axes [0] : vector<2x2xf8E5M2>, vector<2xf8E5M2>
  %f16 = vector.reduce.axes<maxnumf, nnan|nsz> %f16_values, %f16_init axes [0] : vector<2x2xf16>, vector<2xf16>
  %bf16 = vector.reduce.axes<maxnumf, nnan|nsz> %bf16_values, %bf16_init axes [0] : vector<2x2xbf16>, vector<2xbf16>
  %f32 = vector.reduce.axes<maxnumf, nnan|nsz> %f32_values, %f32_init axes [0] : vector<2x2xf32>, vector<2xf32>
  %f64 = vector.reduce.axes<maxnumf, nnan|nsz> %f64_values, %f64_init axes [0] : vector<2x2xf64>, vector<2xf64>
  func.return %i1, %i8, %i16, %i32, %i64, %f8e4m3, %f8e5m2, %f16, %bf16, %f32, %f64 : vector<2xi1>, vector<2xi8>, vector<2xi16>, vector<2xi32>, vector<2xi64>, vector<2xf8E4M3>, vector<2xf8E5M2>, vector<2xf16>, vector<2xbf16>, vector<2xf32>, vector<2xf64>
}

