// RUN: with-checks compile-report target=amd.xdna.aie2p:core target-legalize{mode=final}

// Static partial reduction first builds result-shaped vector combines. The
// unsupported i64 combine is scalarized on a later greedy visit, but remains
// owned by the authored reduction report row.
func.def @attributes_descendant_scalarization_to_source_reduction(%values: vector<2x3xi64>, %init: vector<3xi64>) -> (vector<3xi64>) {
  %result = vector.reduce.axes<addi> %values, %init axes [0] : vector<2x3xi64>, vector<3xi64>
  func.return %result : vector<3xi64>
}

