// ====

// RUN: with-checks compile-report target=amd.xdna.aie2p:core target-legalize{mode=eager}

// Static partial reductions use one structural path for the complete combining
// vocabulary. Individual target contracts still select how each generated
// lanewise combine is lowered.
func.def @integer_partial_reduction_family(%values: vector<2x2xi32>, %init: vector<2xi32>) -> (vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>) {
  %sum = vector.reduce.axes<addi> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %product = vector.reduce.axes<muli> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %signed_minimum = vector.reduce.axes<minsi> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %signed_maximum = vector.reduce.axes<maxsi> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %unsigned_minimum = vector.reduce.axes<minui> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %unsigned_maximum = vector.reduce.axes<maxui> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %bitwise_and = vector.reduce.axes<andi> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %bitwise_or = vector.reduce.axes<ori> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %bitwise_xor = vector.reduce.axes<xori> %values, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  func.return %sum, %product, %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum, %bitwise_and, %bitwise_or, %bitwise_xor : vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>, vector<2xi32>
}

