// ====

// A destructive partial predicate update reuses its dying input even when the
// other seven physical predicate registers remain live through the return.
// RUN: with-checks emit low-allocation @partial_predicate_update diagnostics=copy-decisions

low.func.def schedule(locked) target<amd.xdna.aie2p.core> @partial_predicate_update(%a: reg<aie2p.elpredicate>, %b: reg<aie2p.elpredicate>, %c: reg<aie2p.elpredicate>, %d: reg<aie2p.elpredicate>, %e: reg<aie2p.elpredicate>, %f: reg<aie2p.elpredicate>, %g: reg<aie2p.elpredicate>, %h: reg<aie2p.elpredicate>) -> (reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>) asm {
  // REMARK@+1: BACKEND/006 {value_name="b", partner_value_name="b_copy", decision="accepted", coalescing_constraint="assigned-locations-match"}
  %b_copy = copy %b : reg<aie2p.elpredicate> -> reg<aie2p.elpredicate>
  %low = predicate.and.low32.rhs_tied %a, %b_copy
  %result = predicate.and.high32.rhs_tied %a, %low
  return %result, %c, %d, %e, %f, %g, %h
}

