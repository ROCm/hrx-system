// ====

// A fill and loop-carried pops retain one FIFO tuple without edge copies.
// RUN: with-checks emit low-allocation @fifo_scan diagnostics=placement-decisions

low.func.def target<amd.xdna.aie2p.core> @fifo_scan(%count: reg<aie2p.er>, %initial_pointer: reg<aie2p.eps>, %initial_fifo: reg<aie2p.eldfiforeg>, %initial_position: reg<aie2p.erf2>, %output: reg<aie2p.ep>) asm {
  %one = mova.i32 1
  // REMARK@+6: BACKEND/043 {source_value_name="initial_fifo", result_value_name="initial_pointer", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+5: BACKEND/043 {source_value_name="initial_position", result_value_name="initial_pointer", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+4: BACKEND/043 {source_value_name="initial_position", result_value_name="initial_fifo", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+3: BACKEND/043 {source_value_name="initial_pointer", result_value_name="filled_pointer", relation_kind="same-storage", decision="accepted"}
  // REMARK@+2: BACKEND/043 {source_value_name="initial_fifo", result_value_name="filled_fifo", relation_kind="same-storage", decision="accepted"}
  // REMARK@+1: BACKEND/043 {source_value_name="initial_position", result_value_name="filled_position", relation_kind="same-storage", decision="accepted"}
  %filled_pointer, %filled_fifo, %filled_position = vldb.fill.512 %initial_pointer, %initial_fifo, %initial_position
  // REMARK@+4: BACKEND/043 {source_value_name="count", result_value_name="remaining", relation_kind="same-storage", decision="accepted"}
  // REMARK@+3: BACKEND/043 {source_value_name="filled_pointer", result_value_name="pointer", relation_kind="same-storage", decision="accepted"}
  // REMARK@+2: BACKEND/043 {source_value_name="filled_fifo", result_value_name="fifo", relation_kind="same-storage", decision="accepted"}
  // REMARK@+1: BACKEND/043 {source_value_name="filled_position", result_value_name="position", relation_kind="same-storage", decision="accepted"}
  low.br ^loop(%count: reg<aie2p.er>, %filled_pointer: reg<aie2p.eps>, %filled_fifo: reg<aie2p.eldfiforeg>, %filled_position: reg<aie2p.erf2>)
^loop(%remaining: reg<aie2p.er>, %pointer: reg<aie2p.eps>, %fifo: reg<aie2p.eldfiforeg>, %position: reg<aie2p.erf2>):
  low.cond_br %remaining, ^body, ^exit : reg<aie2p.er>
^body:
  // REMARK@+6: BACKEND/043 {source_value_name="fifo", result_value_name="pointer", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+5: BACKEND/043 {source_value_name="position", result_value_name="pointer", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+4: BACKEND/043 {source_value_name="position", result_value_name="fifo", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+3: BACKEND/043 {source_value_name="pointer", result_value_name="next_pointer", relation_kind="same-storage", decision="accepted"}
  // REMARK@+2: BACKEND/043 {source_value_name="fifo", result_value_name="next_fifo", relation_kind="same-storage", decision="accepted"}
  // REMARK@+1: BACKEND/043 {source_value_name="position", result_value_name="next_position", relation_kind="same-storage", decision="accepted"}
  %data, %next_pointer, %next_fifo, %next_position = vldb.pop.512.i32x16 %pointer, %fifo, %position
  vst.512.i32x16 %data, %output, 0
  %next_remaining = sub %remaining, %one
  // REMARK@+4: BACKEND/043 {source_value_name="next_remaining", result_value_name="remaining", relation_kind="same-storage", decision="accepted"}
  // REMARK@+3: BACKEND/043 {source_value_name="next_pointer", result_value_name="pointer", relation_kind="same-storage", decision="accepted"}
  // REMARK@+2: BACKEND/043 {source_value_name="next_fifo", result_value_name="fifo", relation_kind="same-storage", decision="accepted"}
  // REMARK@+1: BACKEND/043 {source_value_name="next_position", result_value_name="position", relation_kind="same-storage", decision="accepted"}
  low.br ^loop(%next_remaining: reg<aie2p.er>, %next_pointer: reg<aie2p.eps>, %next_fifo: reg<aie2p.eldfiforeg>, %next_position: reg<aie2p.erf2>)
^exit:
  return
}

