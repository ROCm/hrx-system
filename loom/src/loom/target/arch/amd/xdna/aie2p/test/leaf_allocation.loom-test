// wait for other prerequisites, instead of inheriting the entire setup chain.
// RUN: emit aie2p-leaf @static_offset_loop diagnostics=predicted-spills

// REMARK@+1: BACKEND/045 {function_name="static_offset_loop", trigger_kind="allocation-failure", repaired_value_count="24", cloned_packet_count="24", rewritten_operand_count="24", retained_placement_count="0"}
low.func.def target<amd.xdna.aie2p.core> @static_offset_loop(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %count: reg<aie2p.er>) asm {
  %zero = mov.short 0
  %one = mov.short 1
  %offset0 = mov.static-byte-offset 64
  %offset1 = mov.static-byte-offset 128
  %offset2 = mov.static-byte-offset 192
  %offset3 = mov.static-byte-offset 256
  %offset4 = mov.static-byte-offset 320
  %offset5 = mov.static-byte-offset 384
  %offset6 = mov.static-byte-offset 448
  %offset7 = mov.static-byte-offset 512
  %offset8 = mov.static-byte-offset 576
  %offset9 = mov.static-byte-offset 640
  %offset10 = mov.static-byte-offset 704
  %offset11 = mov.static-byte-offset 768
  %offset12 = mov.static-byte-offset 832
  %offset13 = mov.static-byte-offset 896
  %offset14 = mov.static-byte-offset 960
  %offset15 = mov.static-byte-offset 1024
  %offset16 = mov.static-byte-offset 1088
  %offset17 = mov.static-byte-offset 1152
  %offset18 = mov.static-byte-offset 1216
  %offset19 = mov.static-byte-offset 1280
  %offset20 = mov.static-byte-offset 1344
  %offset21 = mov.static-byte-offset 1408
  low.br ^loop(%count: reg<aie2p.er>)
^loop(%remaining: reg<aie2p.er>):
  %index0 = mov.address-index %offset0
  %value0 = lda.i32.index %input, %index0
  %sum0 = add.rr %zero, %value0
  %index1 = mov.address-index %offset1
  %value1 = lda.i32.index %input, %index1
  %sum1 = add.rr %sum0, %value1
  %index2 = mov.address-index %offset2
  %value2 = lda.i32.index %input, %index2
  %sum2 = add.rr %sum1, %value2
  %index3 = mov.address-index %offset3
  %value3 = lda.i32.index %input, %index3
  %sum3 = add.rr %sum2, %value3
  %index4 = mov.address-index %offset4
  %value4 = lda.i32.index %input, %index4
  %sum4 = add.rr %sum3, %value4
  %index5 = mov.address-index %offset5
  %value5 = lda.i32.index %input, %index5
  %sum5 = add.rr %sum4, %value5
  %index6 = mov.address-index %offset6
  %value6 = lda.i32.index %input, %index6
  %sum6 = add.rr %sum5, %value6
  %index7 = mov.address-index %offset7
  %value7 = lda.i32.index %input, %index7
  %sum7 = add.rr %sum6, %value7
  %index8 = mov.address-index %offset8
  %value8 = lda.i32.index %input, %index8
  %sum8 = add.rr %sum7, %value8
  %index9 = mov.address-index %offset9
  %value9 = lda.i32.index %input, %index9
  %sum9 = add.rr %sum8, %value9
  %index10 = mov.address-index %offset10
  %value10 = lda.i32.index %input, %index10
  %sum10 = add.rr %sum9, %value10
  %index11 = mov.address-index %offset11
  %value11 = lda.i32.index %input, %index11
  %sum11 = add.rr %sum10, %value11
  %index12 = mov.address-index %offset12
  %value12 = lda.i32.index %input, %index12
  %sum12 = add.rr %sum11, %value12
  %index13 = mov.address-index %offset13
  %value13 = lda.i32.index %input, %index13
  %sum13 = add.rr %sum12, %value13
  %index14 = mov.address-index %offset14
  %value14 = lda.i32.index %input, %index14
  %sum14 = add.rr %sum13, %value14
  %index15 = mov.address-index %offset15
  %value15 = lda.i32.index %input, %index15
  %sum15 = add.rr %sum14, %value15
  %index16 = mov.address-index %offset16
  %value16 = lda.i32.index %input, %index16
  %sum16 = add.rr %sum15, %value16
  %index17 = mov.address-index %offset17
  %value17 = lda.i32.index %input, %index17
  %sum17 = add.rr %sum16, %value17
  %index18 = mov.address-index %offset18
  %value18 = lda.i32.index %input, %index18
  %sum18 = add.rr %sum17, %value18
