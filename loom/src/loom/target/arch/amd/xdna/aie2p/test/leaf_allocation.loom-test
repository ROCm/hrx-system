// ====

// Reversed parameter order must preserve two independent FIFO tuples.
// RUN: with-checks emit low-allocation @fifo_pair diagnostics=placement-decisions

low.func.def target<amd.xdna.aie2p.core> @fifo_pair(%pointer0: reg<aie2p.eps>, %pointer1: reg<aie2p.eps>, %fifo1: reg<aie2p.eldfiforeg>, %fifo0: reg<aie2p.eldfiforeg>, %position1: reg<aie2p.erf2>, %position0: reg<aie2p.erf2>) -> (reg<aie2p.vec256 x2>) asm {
  // REMARK@+6: BACKEND/043 {source_value_name="fifo0", result_value_name="pointer0", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+5: BACKEND/043 {source_value_name="position0", result_value_name="pointer0", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+4: BACKEND/043 {source_value_name="position0", result_value_name="fifo0", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+3: BACKEND/043 {source_value_name="pointer0", result_value_name="next_pointer0", relation_kind="same-storage", decision="accepted"}
  // REMARK@+2: BACKEND/043 {source_value_name="fifo0", result_value_name="next_fifo0", relation_kind="same-storage", decision="accepted"}
  // REMARK@+1: BACKEND/043 {source_value_name="position0", result_value_name="next_position0", relation_kind="same-storage", decision="accepted"}
  %lhs, %next_pointer0, %next_fifo0, %next_position0 = vlda.pop.512.i32x16 %pointer0, %fifo0, %position0
  // REMARK@+6: BACKEND/043 {source_value_name="fifo1", result_value_name="pointer1", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+5: BACKEND/043 {source_value_name="position1", result_value_name="pointer1", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+4: BACKEND/043 {source_value_name="position1", result_value_name="fifo1", relation_kind="same-register-ordinal", decision="accepted"}
  // REMARK@+3: BACKEND/043 {source_value_name="pointer1", result_value_name="next_pointer1", relation_kind="same-storage", decision="accepted"}
  // REMARK@+2: BACKEND/043 {source_value_name="fifo1", result_value_name="next_fifo1", relation_kind="same-storage", decision="accepted"}
  // REMARK@+1: BACKEND/043 {source_value_name="position1", result_value_name="next_position1", relation_kind="same-storage", decision="accepted"}
  %rhs, %next_pointer1, %next_fifo1, %next_position1 = vldb.pop.512.i32x16 %pointer1, %fifo1, %position1
  %sum = vadd.32 %lhs, %rhs
  return %sum
}

