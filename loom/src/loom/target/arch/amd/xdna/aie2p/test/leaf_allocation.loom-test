// RUN: emit low-allocation-json @insert_lane

low.func.def target<amd.xdna.aie2p.core> @insert_lane(%vector: reg<aie2p.vec256 x2>, %index: reg<aie2p.er>, %value: reg<aie2p.er>) -> (reg<aie2p.vec256 x2>) asm {
  %fixed_index = copy %index {detached = true} : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %result = vinsert.8.reg %vector, %fixed_index, %value
  return %result
}

