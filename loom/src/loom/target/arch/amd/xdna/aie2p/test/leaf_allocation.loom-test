// ====

// A push and flush retain the fixed store FIFO, pointer and position registers.
// RUN: with-checks emit low-allocation @fifo_store diagnostics=placement-decisions

low.func.def target<amd.xdna.aie2p.core> @fifo_store(%data: reg<aie2p.vec256 x2>, %pointer: reg<aie2p.mpfs>, %initial_fifo: reg<aie2p.mstfifo>) asm {
  %position = mova.fifo.store.position 0
  // REMARK@+3: BACKEND/043 {source_value_name="initial_fifo", result_value_name="fifo1", relation_kind="same-storage", decision="accepted"}
  // REMARK@+2: BACKEND/043 {source_value_name="pointer", result_value_name="pointer1", relation_kind="same-storage", decision="accepted"}
  // REMARK@+1: BACKEND/043 {source_value_name="position", result_value_name="position1", relation_kind="same-storage", decision="accepted"}
  %fifo1, %pointer1, %position1 = vst.push.512.i32x16 %initial_fifo, %data, %pointer, %position
  // REMARK@+3: BACKEND/043 {source_value_name="fifo1", result_value_name="fifo2", relation_kind="same-storage", decision="accepted"}
  // REMARK@+2: BACKEND/043 {source_value_name="pointer1", result_value_name="pointer2", relation_kind="same-storage", decision="accepted"}
  // REMARK@+1: BACKEND/043 {source_value_name="position1", result_value_name="position2", relation_kind="same-storage", decision="accepted"}
  %fifo2, %pointer2, %position2 = vst.flush.512 %fifo1, %pointer1, %position1
  return
}

