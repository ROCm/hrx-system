// ====

// Four loaded-C fragments leave one DM register for conversion scratch. The
// upper half is produced before the lower half's address prerequisites, so the
// concat sources are not a compact cluster. Reserving their declared physical
// view places the first source in the upper half; ordinary first-fit would
// require a swap with no scratch register when the lower half arrives.
// RUN: with-checks emit low-allocation @noncompact_upper_half_first diagnostics=placement-decisions

low.func.def target<amd.xdna.aie2p.core> @noncompact_upper_half_first(%source: reg<aie2p.ep>, %reduction_cell: reg<aie2p.er>, %first_upper_bf16: reg<aie2p.vec256 x2>, %second_lower_bf16: reg<aie2p.vec256 x2>, %second_upper_bf16: reg<aie2p.vec256 x2>, %accumulator00: reg<aie2p.mbms x4>, %accumulator01: reg<aie2p.mbms x4>, %accumulator10: reg<aie2p.mbms x4>, %accumulator11: reg<aie2p.mbms x4>, %other_lhs: reg<aie2p.mexa>, %other_rhs: reg<aie2p.mexa>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  %first_upper = vconv.fp32.bf16 %first_upper_bf16
  %lower_half_offset = mov.static-byte-offset 1024
  %row_stride_bytes = mov.i32 128
  // REMARK@+1: BACKEND/043 {source_value_name="lower_half_offset", result_value_name="lower_half_position", placement_cause="tied-result", relation_kind="same-storage", relation_weight="hard", decision="accepted"}
  %lower_half_position = mac %lower_half_offset, %reduction_cell, %row_stride_bytes
  %lower_half_address = mov.address-index %lower_half_position
  %first_lower_bf16 = vlda.512.bf16x32.index %source, %lower_half_address
  %first_lower = vconv.fp32.bf16 %first_lower_bf16
  // REMARK@+2: BACKEND/043 {source_value_name="first_lower", result_value_name="first_float", placement_cause="low.concat", relation_kind="contiguous-part", decision="accepted", result_unit_offset="0", source_unit_offset="0", unit_count="2"}
  // REMARK@+1: BACKEND/043 {source_value_name="first_upper", result_value_name="first_float", placement_cause="low.concat", relation_kind="contiguous-part", decision="accepted", result_unit_offset="2", source_unit_offset="0", unit_count="2"}
  %first_float = concat(%first_lower, %first_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  set.rounding 12
  %lhs = vconv.bfp16ebs8.fp32 %first_float
  %second_lower = vconv.fp32.bf16 %second_lower_bf16
  %second_upper = vconv.fp32.bf16 %second_upper_bf16
  // REMARK@+2: BACKEND/043 {source_value_name="second_lower", result_value_name="second_float", placement_cause="low.concat", relation_kind="contiguous-part", decision="accepted", result_unit_offset="0", source_unit_offset="0", unit_count="2"}
  // REMARK@+1: BACKEND/043 {source_value_name="second_upper", result_value_name="second_float", placement_cause="low.concat", relation_kind="contiguous-part", decision="accepted", result_unit_offset="2", source_unit_offset="0", unit_count="2"}
  %second_float = concat(%second_lower, %second_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  set.rounding 12
  %rhs = vconv.bfp16ebs8.fp32 %second_float
  %matrix_control = mova.i32 780
  %next00 = mma.bfp16ebs8.m8n8k8 %accumulator00, %other_lhs, %rhs, %matrix_control
  %next01 = mma.bfp16ebs8.m8n8k8 %accumulator01, %other_lhs, %other_rhs, %matrix_control
  %next10 = mma.bfp16ebs8.m8n8k8 %accumulator10, %lhs, %rhs, %matrix_control
  %next11 = mma.bfp16ebs8.m8n8k8 %accumulator11, %lhs, %other_rhs, %matrix_control
  return %next00, %next01, %next10, %next11
}

