CHECK: spills: 0
CHECK: copies: coalesced=1 materialized=0

// ====

// A detached index copy materializes into the fixed insertion register.
// RUN: with-checks emit low-allocation @insert_lane diagnostics=copy-decisions

low.func.def target<amd.xdna.aie2p.core> @insert_lane(%vector: reg<aie2p.vec256 x2>, %index: reg<aie2p.er>, %value: reg<aie2p.er>) -> (reg<aie2p.vec256 x2>) asm {
  // REMARK@+1: BACKEND/006 {value_name="index", partner_value_name="fixed_index", decision="rejected", coalescing_constraint="assigned-locations-differ"}
  %fixed_index = copy %index {detached = true} : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %result = vinsert.8.reg %vector, %fixed_index, %value
  return %result
}

