// Pending stores retain their sf/p2/r26 tuple until the final flush.
// RUN: emit low-allocation-json @fifo_store

low.func.def target<amd.xdna.aie2p.core> @fifo_store(%first: reg<aie2p.vec256 x2>, %second: reg<aie2p.vec256 x2>, %pointer: reg<aie2p.mpfs>, %initial_fifo: reg<aie2p.mstfifo>) asm {
