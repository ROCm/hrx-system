// ====

// A broadcast retains its table until the final use. Opening every leaf before
// preparing the predicates exceeds vector capacity even though the selection
// tree fits when its live branches can retire incrementally.
// RUN: emit aie2p-leaf @selection_tree report=emission

low.func.def target<amd.xdna.aie2p.core> @selection_tree(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %table = vlda.512.i8x64 %input, 0
  %codes = vlda.512.i8x64 %input, 64
