  %index6 = mov.address-index %offset
  %index7 = mov.address-index %offset
  %index8 = mov.address-index %offset
  low.br ^loop(%count: reg<aie2p.er>)
^loop(%remaining: reg<aie2p.er>):
  st.i32.index %value, %output, %index0
  st.i32.index %value, %output, %index1
  st.i32.index %value, %output, %index2
  st.i32.index %value, %output, %index3
  st.i32.index %value, %output, %index4
  st.i32.index %value, %output, %index5
  st.i32.index %value, %output, %index6
  st.i32.index %value, %output, %index7
  st.i32.index %value, %output, %index8
  %next = sub %remaining, %value
  %more = nez %next
  low.cond_br %more, ^again, ^done : reg<aie2p.er>
^again:
