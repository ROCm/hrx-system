  %predicate1 = vlt.u8x64 %zeros, %masked1
  %bit2 = mov.short 4
  %mask2 = vbcst.8 %bit2
  %masked2 = vband %codes, %mask2
  %predicate2 = vlt.u8x64 %zeros, %masked2
  %bit3 = mov.short 8
  %mask3 = vbcst.8 %bit3
  %masked3 = vband %codes, %mask3
  %predicate3 = vlt.u8x64 %zeros, %masked3
  %entry0 = vextbcst.8 %table, 0
