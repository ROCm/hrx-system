// RUN: emit aie2p-array-plan @neighbor_egress

// The third outgoing channel exceeds the worker's two MM2S engines. Its
// ring belongs to the north tile, so stores and locks use the north window.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @neighbor_egress() asm {
  %lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %lanes
  %worker = worker %group, %lane, @write_three_outputs

  %output0 = binding 0, "write"
  %output1 = binding 1, "write"
  %output2 = binding 2, "write"
  %worker_output0 = sender %worker, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %worker_output1 = sender %worker, 1 : reg<aie2p.array.sender : tile<1xi32>>
  %worker_output2 = sender %worker, 2 : reg<aie2p.array.sender : tile<1xi32>>
  %output0_receiver = receiver %output0, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %output1_receiver = receiver %output1, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %output2_receiver = receiver %output2, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %channel0 = channel %worker_output0, %output0_receiver, %capacity, %records : reg<aie2p.array.channel : tile<1xi32>>
  %channel1 = channel %worker_output1, %output1_receiver, %capacity, %records : reg<aie2p.array.channel : tile<1xi32>>
  %channel2 = channel %worker_output2, %output2_receiver, %capacity, %records : reg<aie2p.array.channel : tile<1xi32>>

  constrain.location %worker, %column, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @write_three_outputs() asm {
  %output0 = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output1 = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output2 = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %value0 = mov.short 11
  %value1 = mov.short 22
  %value2 = mov.short 33
  st %value0, %output0, 0
  st %value1, %output1, 0
  st %value2, %output2, 0
  return
}

