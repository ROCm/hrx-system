low.func.def retain target<amd.xdna.aie2p.core>(@core_target) @neighbor_egress$worker$0() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %47 = mov.local-address 458752
  %48 = mov.local-address 491520
  %49 = mov.local-address 393216
  low.br ^_bb1(%47: reg<aie2p.ep>, %48: reg<aie2p.ep>, %49: reg<aie2p.ep>)
^_bb1(%output0: reg<aie2p.ep>, %output1: reg<aie2p.ep>, %output2: reg<aie2p.ep>):
  acq %acquire_delta, 48
  acq %acquire_delta, 50
  acq %acquire_delta, 32
  low.br ^_bb2
^_bb2:
  %value0 = mov.short 11
  %value1 = mov.short 22
  %value2 = mov.short 33
  st %value0, %output0, 0
  st %value1, %output1, 0
  st %value2, %output2, 0
  low.br ^_bb3
^_bb3:
  rel %release_delta, 49
  rel %release_delta, 51
  rel %release_delta, 33
  %37 = mov.address-to-scalar %output0
  %38 = mov.i32 16384
  %39 = xor %37, %38
  %40 = mov.scalar-to-address %39
  %41 = mov.address-to-scalar %output1
  %42 = xor %41, %38
  %43 = mov.scalar-to-address %42
  %44 = mov.address-to-scalar %output2
  %45 = xor %44, %38
  %46 = mov.scalar-to-address %45
  low.br ^_bb1(%40: reg<aie2p.ep>, %43: reg<aie2p.ep>, %46: reg<aie2p.ep>)
}
