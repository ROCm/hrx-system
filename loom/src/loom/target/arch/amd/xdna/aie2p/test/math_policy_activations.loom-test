// The policy rows define a Cartesian family: five semantic operations, five
// source element types, and both scalar and vector domains. This report drives
// every cell through the public legalization path without repeating lowered IR.
// RUN: compile-report target=amd.xdna.aie2p:core legalize-math

func.def @activation_family(%scalar_f8e4m3: f8E4M3, %vector_f8e4m3: vector<2x8xf8E4M3>, %scalar_f8e5m2: f8E5M2, %vector_f8e5m2: vector<2x8xf8E5M2>, %scalar_f16: f16, %vector_f16: vector<2x8xf16>, %scalar_bf16: bf16, %vector_bf16: vector<2x8xbf16>, %scalar_f32: f32, %vector_f32: vector<2x8xf32>) {
  %scalar_f8e4m3_erf = scalar.geluf<erf, afn> %scalar_f8e4m3 : f8E4M3
  %scalar_f8e4m3_tanh = scalar.geluf<tanh, afn> %scalar_f8e4m3 : f8E4M3
  %scalar_f8e4m3_gelu_logistic = scalar.geluf<logistic, afn> %scalar_f8e4m3 {scale = 1.702} : f8E4M3
  %scalar_f8e4m3_logistic = scalar.logisticf<afn> %scalar_f8e4m3 : f8E4M3
  %scalar_f8e4m3_silu = scalar.siluf<afn> %scalar_f8e4m3 : f8E4M3
  %vector_f8e4m3_erf = vector.geluf<erf, afn> %vector_f8e4m3 : vector<2x8xf8E4M3>
  %vector_f8e4m3_tanh = vector.geluf<tanh, afn> %vector_f8e4m3 : vector<2x8xf8E4M3>
  %vector_f8e4m3_gelu_logistic = vector.geluf<logistic, afn> %vector_f8e4m3 {scale = 1.702} : vector<2x8xf8E4M3>
  %vector_f8e4m3_logistic = vector.logisticf<afn> %vector_f8e4m3 : vector<2x8xf8E4M3>
  %vector_f8e4m3_silu = vector.siluf<afn> %vector_f8e4m3 : vector<2x8xf8E4M3>
  %scalar_f8e5m2_erf = scalar.geluf<erf, afn> %scalar_f8e5m2 : f8E5M2
  %scalar_f8e5m2_tanh = scalar.geluf<tanh, afn> %scalar_f8e5m2 : f8E5M2
  %scalar_f8e5m2_gelu_logistic = scalar.geluf<logistic, afn> %scalar_f8e5m2 {scale = 1.702} : f8E5M2
  %scalar_f8e5m2_logistic = scalar.logisticf<afn> %scalar_f8e5m2 : f8E5M2
  %scalar_f8e5m2_silu = scalar.siluf<afn> %scalar_f8e5m2 : f8E5M2
  %vector_f8e5m2_erf = vector.geluf<erf, afn> %vector_f8e5m2 : vector<2x8xf8E5M2>
  %vector_f8e5m2_tanh = vector.geluf<tanh, afn> %vector_f8e5m2 : vector<2x8xf8E5M2>
  %vector_f8e5m2_gelu_logistic = vector.geluf<logistic, afn> %vector_f8e5m2 {scale = 1.702} : vector<2x8xf8E5M2>
  %vector_f8e5m2_logistic = vector.logisticf<afn> %vector_f8e5m2 : vector<2x8xf8E5M2>
  %vector_f8e5m2_silu = vector.siluf<afn> %vector_f8e5m2 : vector<2x8xf8E5M2>
  %scalar_f16_erf = scalar.geluf<erf, afn> %scalar_f16 : f16
  %scalar_f16_tanh = scalar.geluf<tanh, afn> %scalar_f16 : f16
  %scalar_f16_gelu_logistic = scalar.geluf<logistic, afn> %scalar_f16 {scale = 1.702} : f16
  %scalar_f16_logistic = scalar.logisticf<afn> %scalar_f16 : f16
  %scalar_f16_silu = scalar.siluf<afn> %scalar_f16 : f16
  %vector_f16_erf = vector.geluf<erf, afn> %vector_f16 : vector<2x8xf16>
  %vector_f16_tanh = vector.geluf<tanh, afn> %vector_f16 : vector<2x8xf16>
  %vector_f16_gelu_logistic = vector.geluf<logistic, afn> %vector_f16 {scale = 1.702} : vector<2x8xf16>
  %vector_f16_logistic = vector.logisticf<afn> %vector_f16 : vector<2x8xf16>
  %vector_f16_silu = vector.siluf<afn> %vector_f16 : vector<2x8xf16>
  %scalar_bf16_erf = scalar.geluf<erf, afn> %scalar_bf16 : bf16
  %scalar_bf16_tanh = scalar.geluf<tanh, afn> %scalar_bf16 : bf16
  %scalar_bf16_gelu_logistic = scalar.geluf<logistic, afn> %scalar_bf16 {scale = 1.702} : bf16
  %scalar_bf16_logistic = scalar.logisticf<afn> %scalar_bf16 : bf16
  %scalar_bf16_silu = scalar.siluf<afn> %scalar_bf16 : bf16
  %vector_bf16_erf = vector.geluf<erf, afn> %vector_bf16 : vector<2x8xbf16>
  %vector_bf16_tanh = vector.geluf<tanh, afn> %vector_bf16 : vector<2x8xbf16>
  %vector_bf16_gelu_logistic = vector.geluf<logistic, afn> %vector_bf16 {scale = 1.702} : vector<2x8xbf16>
  %vector_bf16_logistic = vector.logisticf<afn> %vector_bf16 : vector<2x8xbf16>
  %vector_bf16_silu = vector.siluf<afn> %vector_bf16 : vector<2x8xbf16>
  %scalar_f32_erf = scalar.geluf<erf, afn> %scalar_f32 : f32
