// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=none

// This orthogonal basis carries every source representation and semantic
// recipe through complete source lowering. The single-lane vector also covers
// the lower packet boundary; the policy matrix above covers the full Cartesian
// selection family without duplicating lowered IR.
func.def @activation_lowering_basis(%f8e4m3: vector<16xf8E4M3>, %f8e5m2: vector<16xf8E5M2>, %f16: vector<16xf16>, %bf16: vector<16xbf16>, %f32: vector<16xf32>, %minimum: vector<1xf32>) -> (vector<16xf8E4M3>, vector<16xf8E5M2>, vector<16xf16>, vector<16xbf16>, vector<16xf32>, vector<1xf32>) {
  %erf = vector.geluf<erf, afn> %f8e4m3 : vector<16xf8E4M3>
  %tanh = vector.geluf<tanh, afn> %f8e5m2 : vector<16xf8E5M2>
  %gelu_logistic = vector.geluf<logistic, afn> %f16 {scale = 1.702} : vector<16xf16>
  %logistic = vector.logisticf<afn> %bf16 : vector<16xbf16>
  %silu = vector.siluf<afn> %f32 : vector<16xf32>
  %minimum_silu = vector.siluf<afn> %minimum : vector<1xf32>
  func.return %erf, %tanh, %gelu_logistic, %logistic, %silu, %minimum_silu : vector<16xf8E4M3>, vector<16xf8E5M2>, vector<16xf16>, vector<16xbf16>, vector<16xf32>, vector<1xf32>
}

