// RUN: pass target=amd.xdna.aie2p:core legalize-math

func.def @gelu_tanh_f64(%input: f64) {
  // ERROR@+1: LOWERING/036 {op_name="scalar.geluf", phase_name="legalize-math", policy_name="aie2p-math", math_op="geluf.tanh", lane_domain="scalar", element_type="f64", constraint_key="math.element.aie2p_approximate_activation"}
  %result = scalar.geluf<tanh, afn> %input : f64
  func.return
}

