  %scalar_f32_gelu_logistic = scalar.geluf<logistic, afn> %scalar_f32 {scale = 1.702} : f32
  %scalar_f32_logistic = scalar.logisticf<afn> %scalar_f32 : f32
  %scalar_f32_silu = scalar.siluf<afn> %scalar_f32 : f32
