// ====

// An actual write retires the reader list. Later fences and writes describe
// the new state version without adding edges from an already consumed reader.
// RUN: emit low-schedule-query @state_write_retires_readers strategy=source order=* issue=* kind=state consumer=* edge=state:1:3,state:4:5,state:1:5

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @state_write_retires_readers(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %value: reg<aie2p.mbms>, %shift: reg<aie2p.es>) -> (reg<aie2p.mbms>) asm {
  set.saturation 0
  %loaded = vlda.ups.2x.w-to-b.unsigned %shift, %input, 0
  vst.srs.2x.b-to-w.unsigned.volatile %value, %shift, %output, 0
  set.saturation 1
  vst.srs.2x.b-to-w.unsigned.volatile %value, %shift, %output, 32
  set.saturation 0
  return %loaded
}

