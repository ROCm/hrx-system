node 0 issue-cycle: 0
node 1 issue-cycle: 1
node 2 issue-cycle: 2
node 3 issue-cycle: 7
node 4 issue-cycle: 10
node 1 <- 0
node 2 <- 0
node 3 <- 0, 1, 2
edge order 1 -> 2: separation=0 source=structural quality=unknown producer-event=amd.xdna.aie2p.operand.read.c7.none consumer-event=amd.xdna.aie2p.operand.read.c1.none
edge state 1 -> 3: separation=6 source=event-pair quality=exact producer-event=amd.xdna.aie2p.operand.read.c7.none consumer-event=amd.xdna.aie2p.operand.write.c1.none

// ====

// A state value need not have a same-block writer for its readers to retain
// their timing across a fence. The first write still follows every live read.
// RUN: emit low-schedule-query @live_in_state_read_fence strategy=source order=* issue=* kind=state consumer=* edge=state:0:2

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @live_in_state_read_fence(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %value: reg<aie2p.mbms>, %shift: reg<aie2p.es>) -> (reg<aie2p.mbms>) asm {
  %loaded = vlda.ups.2x.w-to-b.unsigned %shift, %input, 0
  vst.srs.2x.b-to-w.unsigned.volatile %value, %shift, %output, 0
  set.saturation 1
  return %loaded
}

