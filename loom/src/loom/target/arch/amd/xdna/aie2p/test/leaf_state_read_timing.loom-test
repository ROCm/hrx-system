block 0 order: 0, 1, 2, 3
node 0 issue-cycle: 0
node 1 issue-cycle: 1
node 2 issue-cycle: 6
node 3 issue-cycle: 9
node 2 <- 0, 1
edge state 0 -> 2: separation=6 source=event-pair quality=exact producer-event=amd.xdna.aie2p.operand.read.c7.none consumer-event=amd.xdna.aie2p.operand.write.c1.none

// ====

// Each fence orders only readers since the previous fence. Earlier readers
// retain timing edges to the writer, not all-to-all order edges to fences.
// RUN: emit low-schedule-query @successive_state_read_fences strategy=source order=* issue=* kind=state consumer=* edge=state:1:6,order:3:4,order:4:5,order:1:4,order:1:5,order:2:5,order:3:5

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @successive_state_read_fences(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %value: reg<aie2p.mbms>, %shift: reg<aie2p.es>) -> (reg<aie2p.mbms>, reg<aie2p.vec256>) asm {
  set.saturation 0
  %loaded = vlda.ups.2x.w-to-b.unsigned %shift, %input, 0
  vst.srs.2x.b-to-w.unsigned.volatile %value, %shift, %output, 0
  %narrowed = vsrs.2x.b-to-w.unsigned %value, %shift
  vst.srs.2x.b-to-w.unsigned.volatile %value, %shift, %output, 32
  vst.srs.2x.b-to-w.unsigned.volatile %value, %shift, %output, 64
  set.saturation 1
  return %loaded, %narrowed
}

