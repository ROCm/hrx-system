// RUN: with-checks emit aie2p-array-plan @read_table

global.rodata.def @table = align(32) conflicts([@other]) bytes("1122334455667788")

global.rodata.def @other = align(32) conflicts([@table]) bytes("99aabbccddeeff00")

global.rodata.def @second_table = align(32) conflicts([@second_other]) bytes("0123456789abcdef")

global.rodata.def @second_other = align(32) conflicts([@second_table]) bytes("fedcba9876543210")

// A resident function retaining only one side omits the relation.
global.rodata.def @single_table = align(32) conflicts([@unused_peer]) bytes("0102030405060708")

global.rodata.def @unused_peer = align(32) conflicts([@single_table]) bytes("1020304050607080")

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @read_table() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @read_table_worker
  %binding = binding 0, "write"
  %sender = sender %worker, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %receiver = receiver %binding, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %channel = channel %sender, %receiver, %one, %one : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %zero, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @read_table_worker() asm {
  %output = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %other = mov.local-address @other
  %table = mov.local-address @table
  %table_again = mov.local-address @table
  %second_other = mov.local-address @second_other
  %second_table = mov.local-address @second_table
  %single_table = mov.local-address @single_table
  %other_value = lda %other, 0
  %table_value = lda %table, 4
  %table_again_value = lda %table_again, 0
  %second_other_value = lda %second_other, 0
  %second_table_value = lda %second_table, 0
  %single_table_value = lda %single_table, 0
  st %other_value, %output, 0
  st %table_value, %output, 0
  st %table_again_value, %output, 0
  st %second_other_value, %output, 0
  st %second_table_value, %output, 0
  st %single_table_value, %output, 0
  return
}

// ----
CHECK: worker-rodata worker=0 requirement=0 offset=0x0c000 load-address=0x7c000 bytes=8
CHECK: worker-rodata worker=0 requirement=1 offset=0x08000 load-address=0x78000 bytes=8
CHECK: worker-rodata worker=0 requirement=2 offset=0x0c020 load-address=0x7c020 bytes=8
CHECK: worker-rodata worker=0 requirement=3 offset=0x08020 load-address=0x78020 bytes=8
CHECK: worker-rodata worker=0 requirement=4 offset=0x0c040 load-address=0x7c040 bytes=8
CHECK-NOT: worker-rodata worker=0 requirement=5
CHECK: resident-program index=0 representative-worker=0 instances=1 entry=@read_table$worker$0 tile=(0,2) * fixups=6
CHECK:   %other = mov.local-address @other
CHECK:   %table = mov.local-address @table
CHECK:   %table_again_value = lda %table, 0
