// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bitwise_wide_constant_boundaries(%input: reg<aie2p.er x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %14 = mov.i32 -1
  %15 = mov.i32 0
  %17 = mov.i32 -2147483648
  %20 = mov.i32 2147483647
  %23 = slice %input[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %24 = slice %input[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %27 = and %23, %14
  %28 = and %24, %15
  %masked = concat(%27, %28) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %34 = or %17, %23
  %35 = or %15, %24
  %tagged = concat(%34, %35) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %41 = xor %23, %20
  %42 = xor %24, %14
  %toggled = concat(%41, %42) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %masked, %tagged, %toggled
}

// ====

func.def @bitwise_index_constant_boundaries(%input: index) -> (index, index, index) {
  %mask = index.constant 4294967295 : index
  // ERROR@+1: TARGET/005 {op_name="index.constant", subject_name="value", constraint_key="i64_attr_range"}
  %tag = index.constant 2147483648 : index
  // ERROR@+1: TARGET/005 {op_name="index.constant", subject_name="value", constraint_key="i64_attr_range"}
  %toggle = index.constant 4294967294 : index
  %masked = index.andi %input, %mask : index
  %tagged = index.ori %tag, %input : index
  %toggled = index.xori %input, %toggle : index
  func.return %masked, %tagged, %toggled : index, index, index
}

// ====

func.def @vector_i32x16_uniform_shift_left(%input_arg: buffer, %output_arg: buffer) {
  %input_buffer = buffer.assume.alignment %input_arg {minimum_alignment = 64} : buffer
  %output_buffer = buffer.assume.alignment %output_arg {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<16xi32>
  %input = vector.load %input_view[0] : view<16xi32> -> vector<16xi32>
  %distance = vector.splati 23 : vector<16xi32>
  %shifted = vector.shli %input, %distance : vector<16xi32>
  vector.store %shifted, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @vector_i32x16_uniform_shift_left() asm {
  %input_buffer = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_buffer = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %input = vlda.512.i32x16 %input_buffer, 0
  %13 = mov.shift 23
  %14 = mov.shift 0
  set.saturation 0
  set.ups-mode 1
  set.srs-mode 1
  set.rounding 0
  %15 = vups.2x.x-to-c.unsigned %input, %13
  %shifted = vsrs.2x.c-to-x.unsigned %15, %14
  vst.512.i32x16 %shifted, %output_buffer, 0
  return
}

