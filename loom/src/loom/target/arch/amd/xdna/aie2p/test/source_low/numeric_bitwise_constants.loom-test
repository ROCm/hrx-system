// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @bitwise_word_constants(%input: i32, %mask_input: i32) -> (i32, i32, i32) {
  %mask = scalar.assume %mask_input [range(%mask_input, 255, 255)] : i32
  %tag = scalar.constant -2147483648 : i32
  %toggle = scalar.constant 2147483647 : i32
  %masked = scalar.andi %input, %mask : i32
  %tagged = scalar.ori %tag, %input : i32
  %toggled = scalar.xori %input, %toggle : i32
  func.return %masked, %tagged, %toggled : i32, i32, i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bitwise_word_constants(%input: reg<aie2p.er>, %mask_input: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %mask = mov.short 255
  %tag = mov.i32 -2147483648
  %toggle = mov.i32 2147483647
  %masked = and %input, %mask
  %tagged = or %tag, %input
  %toggled = xor %input, %toggle
  return %masked, %tagged, %toggled
}

// ====

func.def @bitwise_wide_signed_constants(%input: i64) -> (i64, i64, i64) {
  %mask = scalar.constant -2147483648 : i64
  %tag = scalar.constant 2147483647 : i64
  %toggle = scalar.constant -1 : i64
  %masked = scalar.andi %mask, %input : i64
  %tagged = scalar.ori %input, %tag : i64
  %toggled = scalar.xori %toggle, %input : i64
  func.return %masked, %tagged, %toggled : i64, i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bitwise_wide_signed_constants(%input: reg<aie2p.er x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %14 = mov.i32 -2147483648
  %15 = mov.i32 -1
  %17 = mov.i32 2147483647
  %18 = mov.i32 0
  %25 = slice %input[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %26 = slice %input[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %27 = and %14, %25
  %28 = and %15, %26
  %masked = concat(%27, %28) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %34 = or %25, %17
  %35 = or %26, %18
  %tagged = concat(%34, %35) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %41 = xor %15, %25
  %42 = xor %15, %26
  %toggled = concat(%41, %42) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %masked, %tagged, %toggled
}

