// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_index_operands.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @uniform_lhs_index_operands(%input: buffer, %uniform: index) -> (index, index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %value = index.cast %word : i32 to index
  %multiply = index.mul %uniform, %value : index
  %and = index.andi %uniform, %value : index
  %or = index.ori %uniform, %value : index
  %xor = index.xori %uniform, %value : index
  %subtract = index.sub %uniform, %value : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @uniform_lhs_index_operands(%uniform: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %value = lda %input_view, 0
  %multiply = mul %uniform, %value
  %and = and %uniform, %value
  %or = or %uniform, %value
  %xor = xor %uniform, %value
  %subtract = sub %uniform, %value
  return %multiply, %and, %or, %xor, %subtract
}

