// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @uniform_rhs_index_operands(%uniform: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
