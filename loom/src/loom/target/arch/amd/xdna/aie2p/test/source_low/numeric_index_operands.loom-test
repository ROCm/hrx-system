// ====

func.def @constant_index_operands(%input: buffer) -> (index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %value = index.cast %word : i32 to index
  %inline = index.constant 64 : index
  %literal = index.constant 128 : index
  %negative = index.constant -16 : index
  %factor = index.constant 65 : index
  %masked = index.andi %value, %inline : index
  %tagged = index.ori %literal, %value : index
  %toggled = index.xori %value, %negative : index
  %scaled = index.mul %factor, %value : index
  func.return %masked, %tagged, %toggled, %scaled : index, index, index, index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @constant_index_operands() -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %value = lda %input_view, 0
  %inline = mov.short 64
  %literal = mov.short 128
  %negative = mov.short -16
  %factor = mov.short 65
  %masked = and %value, %inline
  %tagged = or %literal, %value
  %toggled = xor %value, %negative
  %scaled = mul %factor, %value
  return %masked, %tagged, %toggled, %scaled
}

// ====

func.def @uniform_index_operands(%lhs: index, %rhs: index) -> (index, index, index, index, index) {
  %multiply = index.mul %lhs, %rhs : index
  %and = index.andi %lhs, %rhs : index
  %or = index.ori %lhs, %rhs : index
  %xor = index.xori %lhs, %rhs : index
  %subtract = index.sub %lhs, %rhs : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @uniform_index_operands(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %multiply = mul %lhs, %rhs
  %and = and %lhs, %rhs
  %or = or %lhs, %rhs
  %xor = xor %lhs, %rhs
  %subtract = sub %lhs, %rhs
  return %multiply, %and, %or, %xor, %subtract
}

// ====

func.def @varying_index_operands(%input: buffer) -> (index, index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<2xi32>
  %lhs_word = view.load %input_view[0] : view<2xi32> -> i32
  %rhs_word = view.load %input_view[1] : view<2xi32> -> i32
  %lhs = index.cast %lhs_word : i32 to index
  %rhs = index.cast %rhs_word : i32 to index
  %multiply = index.mul %lhs, %rhs : index
  %and = index.andi %lhs, %rhs : index
  %or = index.ori %lhs, %rhs : index
  %xor = index.xori %lhs, %rhs : index
  %subtract = index.sub %lhs, %rhs : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @varying_index_operands() -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %lhs = lda %input_view, 0
  %rhs = lda %input_view, 4
  %multiply = mul %lhs, %rhs
  %and = and %lhs, %rhs
  %or = or %lhs, %rhs
  %xor = xor %lhs, %rhs
  %subtract = sub %lhs, %rhs
  return %multiply, %and, %or, %xor, %subtract
}

// ====

func.def @bounded_offset_difference(%input: buffer, %wide_limit: offset) -> (offset) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %bounded_word = scalar.assume %word [range(%word, 0, 1023)] : i32
  %position = index.cast %bounded_word : i32 to offset
  %limit = index.assume %wide_limit [range(%wide_limit, 1024, 2047)] : offset
  %remaining = index.sub %limit, %position : offset
  func.return %remaining : offset
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bounded_offset_difference(%limit: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %position = lda %input_view, 0
  %remaining = sub %limit, %position
  return %remaining
}

// ====

func.def @address_constant_boundaries() -> (index, index, offset, offset, offset, offset) {
  %minimum_index = index.constant -2147483648 : index
  %maximum_index = index.constant 2147483647 : index
  %compact_offset = index.constant 1023 : offset
  %wide_offset = index.constant 1024 : offset
  %high_bit_offset = index.constant 2147483648 : offset
  %maximum_offset = index.constant 4294967295 : offset
  func.return %minimum_index, %maximum_index, %compact_offset, %wide_offset, %high_bit_offset, %maximum_offset : index, index, offset, offset, offset, offset
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @address_constant_boundaries() -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %minimum_index = mov.i32 -2147483648
  %maximum_index = mov.i32 2147483647
  %compact_offset = mov.short 1023
  %wide_offset = mov.i32 1024
  %maximum_offset = mov.i32 -1
  return %minimum_index, %maximum_index, %compact_offset, %wide_offset, %minimum_index, %maximum_offset
}

// ====

func.def @offset_from_constant_payloads() -> (offset, offset) {
  %high_bit = scalar.constant -2147483648 : i32
  %all_bits = scalar.constant -1 : i32
  %high_bit_offset = index.cast %high_bit : i32 to offset
  %maximum_offset = index.cast %all_bits : i32 to offset
  func.return %high_bit_offset, %maximum_offset : offset, offset
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @offset_from_constant_payloads() -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %high_bit_offset = mov.i32 -2147483648
  %maximum_offset = mov.i32 -1
  return %high_bit_offset, %maximum_offset
}

// ====

func.def @high_bit_offset_add(%input: offset) -> (i64) {
  %bounded = index.assume %input [range(%input, 0, 1023)] : offset
  %base = index.constant 2147483648 : offset
  %sum = index.add %base, %bounded : offset
  %wide = index.cast %sum : offset to i64
  func.return %wide : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @high_bit_offset_add(%bounded: reg<aie2p.er>) -> (reg<aie2p.er x2>) asm {
  %base = mov.i32 -2147483648
  %sum = add.rr %base, %bounded
  %10 = mov.short 0
  %wide = concat(%sum, %10) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %wide
}

// ====

// Every result keeps its matching input, including mixed address domains.
func.def @bounded_addresses(%row: index, %column: index, %byte_offset: offset) -> (index, index, offset) {
  %bounded_row, %bounded_column, %aligned_offset = index.assume %row, %column, %byte_offset [range(%row, 0, 31), range(%column, 0, 63), mul(%byte_offset, 16)] : index, index, offset
  func.return %bounded_row, %bounded_column, %aligned_offset : index, index, offset
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @bounded_addresses(%bounded_row: reg<aie2p.er>, %bounded_column: reg<aie2p.er>, %aligned_offset: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  return %bounded_row, %bounded_column, %aligned_offset
}
