load("//loom/build_tools/bazel:build_defs.bzl", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_generated_cc_library(
    name = "ops",
    srcs = [
        "registry.c",
        "target.c",
    ],
    hdrs = [
        "registry.h",
        "target.h",
    ],
    args = ["--dialect=aie2p"],
    generated_hdr_flags = ["--ops-header"],
    generated_hdrs = ["ops.h"],
    generated_src_flags = [
        "--builders",
        "--tables",
    ],
    generated_srcs = [
        "builders.c",
        "tables.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_aie2p_generator",
    visibility = ["//loom/src/loom/target/arch/amd/xdna/aie2p:__pkg__"],
    deps = [
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/target:resolved_target",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/amd/xdna:device_profile",
        "//loom/src/loom/target/arch/amd/xdna/aie2p:target_facts",
        "//loom/src/loom/target/arch/amd/xdna/aie2p:target_records",
        "//runtime/src/iree/base",
    ],
)
