load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "op_defs",
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/ops:headers",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/amd/xdna/aie2p:record_defs",
    ],
)

loom_cc_library(
    name = "builders",
    srcs = ["builders.c"],
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/ir:builders",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/amd/xdna/aie2p:record_defs",
    ],
)

loom_generated_cc_library(
    name = "ops",
    srcs = [
        "fifo.c",
        "registry.c",
        "target.c",
    ],
    hdrs = [
        "fifo.h",
        "registry.h",
        "target.h",
    ],
    args = ["--dialect=aie2p"],
    extra_output_flags = [
        "--ops-include",
        "--builders",
    ],
    extra_outputs = [
        "ops.inc",
        "builders.c",
    ],
    generated_hdr_flags = [
        "--ops-header",
        "--types-header",
    ],
    generated_hdrs = [
        "ops.h",
        "types.h",
    ],
    generated_src_flags = [
        "--tables",
        "--types",
    ],
    generated_srcs = [
        "tables.c",
        "types.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_aie2p_generator",
    textual_hdrs = ["ops.inc"],
    visibility = ["//loom/src/loom/target/arch/amd/xdna/aie2p:__pkg__"],
    deps = [
        ":builders",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:type_registry",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/target:resolved_target",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/amd/xdna:device_profile",
        "//loom/src/loom/target/arch/amd/xdna/aie2p:target_facts",
        "//loom/src/loom/target/arch/amd/xdna/aie2p:target_records",
        "//runtime/src/iree/base",
    ],
)
