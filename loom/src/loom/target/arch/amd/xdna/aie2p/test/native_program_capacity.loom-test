// RUN: emit aie2p-xdna input=source-low

aie2p.target<array> @device {device_profile = "amd.xdna.strix_halo.17f0_11"}

// Each helper fits independently. Their aligned composition with the entry
// exceeds the tile capacity and must use the same authored-program diagnostic.
func.def noinline @fill_a(%storage: buffer) {
  %origin = index.constant 0 : offset
  %values = buffer.view %storage[%origin] : buffer -> view<600xi32>
  %begin = index.constant 0 : index
  %end = index.constant 600 : index
  %step = index.constant 1 : index
  %value = scalar.constant 1 : i32
  scf.for %i = [%begin to %end step %step] unroll {
    view.store %value, %values[%i] : i32, view<600xi32>
  }
  func.return
}

func.def noinline @fill_b(%storage: buffer) {
  %origin = index.constant 0 : offset
  %values = buffer.view %storage[%origin] : buffer -> view<600xi32>
  %begin = index.constant 0 : index
  %end = index.constant 600 : index
  %step = index.constant 1 : index
  %value = scalar.constant 2 : i32
  scf.for %i = [%begin to %end step %step] unroll {
    view.store %value, %values[%i] : i32, view<600xi32>
  }
  func.return
}

pipeline.def<kernel> public retain target(@device) @combined_program() run() {
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %bytes = index.constant 2400 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  // ERROR@+1: XDNA/058 {function_name="__pipeline_worker_0", required="16780", capacity="16384"}
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    func.call @fill_a(%storage) : (buffer)
    func.call @fill_b(%storage) : (buffer)
  }
}
