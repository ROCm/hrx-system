CHECK: * = view.load %view[*] : view<8xi32> -> i32
CHECK: %result = vector.from_elements * : vector<16xi32>

// ====

// A partial 32-byte block cannot use the duplicated native table layout.
// RUN: with-checks pass target-legalize{mode=eager},dce,canonicalize

global.rodata.def @table = align(4) bytes("000000000100000002000000030000000400000005000000060000000700000008000000")

aie2p.target<core> @target

func.def target(@target) @partial_block(%packed: vector<16xi8>) -> (vector<16xi32>) {
  %table = global.load @table : buffer
  %origin = index.constant 0 : offset
  %view = buffer.view %table[%origin] : buffer -> view<9xi32>
  %mask = vector.splati 7 : vector<16xi8>
  %bounded = vector.andi %packed, %mask : vector<16xi8>
  %indices = vector.extui %bounded : vector<16xi8> to vector<16xi32>
  %result = vector.gather %view[0][%indices] : view<9xi32>, vector<16xi32> -> vector<16xi32>
  func.return %result : vector<16xi32>
}

// ----
CHECK-NOT: vector.gather
CHECK: * = view.load %view[*] : view<9xi32> -> i32
CHECK: %result = vector.from_elements * : vector<16xi32>

// ====

