  %origin = index.constant 0 : offset
  %view_bf16 = buffer.view %table[%origin] : buffer -> view<32xbf16>
  %view_f32 = buffer.view %table[%origin] : buffer -> view<16xf32>
  %view_f64 = buffer.view %table[%origin] : buffer -> view<8xf64>
  %mask_bf16 = vector.splati 31 : vector<32xi8>
  %mask_f32 = vector.splati 15 : vector<16xi8>
  %mask_f64 = vector.splati 7 : vector<8xi8>
  %bounded_bf16 = vector.andi %packed_bf16, %mask_bf16 : vector<32xi8>
  %bounded_f32 = vector.andi %packed_f32, %mask_f32 : vector<16xi8>
  %bounded_f64 = vector.andi %packed_f64, %mask_f64 : vector<8xi8>
  %indices_bf16 = vector.extui %bounded_bf16 : vector<32xi8> to vector<32xi32>
  %indices_f32 = vector.extui %bounded_f32 : vector<16xi8> to vector<16xi32>
  %indices_f64 = vector.extui %bounded_f64 : vector<8xi8> to vector<8xi32>
  %result_bf16 = vector.gather %view_bf16[0][%indices_bf16] : view<32xbf16>, vector<32xi32> -> vector<32xbf16>
  %result_f32 = vector.gather %view_f32[0][%indices_f32] : view<16xf32>, vector<16xi32> -> vector<16xf32>
  %result_f64 = vector.gather %view_f64[0][%indices_f64] : view<8xf64>, vector<8xi32> -> vector<8xf64>
  func.return %result_bf16, %result_f32, %result_f64 : vector<32xbf16>, vector<16xf32>, vector<8xf64>
}

