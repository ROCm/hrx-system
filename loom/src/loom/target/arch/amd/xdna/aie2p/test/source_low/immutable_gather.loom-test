CHECK-NOT: vector.gather
CHECK: %result_i8 = vector.from_elements * : vector<8xi8>
CHECK: %result_index = vector.from_elements * : vector<8xi64>
CHECK: %result_bf16 = vector.from_elements * : vector<8xbf16>

