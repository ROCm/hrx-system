// RUN: emit source-low target=amd.xdna.aie2p:core output=module

func.def @immutable_widths(%packed_bf16: vector<32xi8>, %packed_f32: vector<16xi8>, %packed_f64: vector<8xi8>) -> (vector<32xbf16>, vector<16xf32>, vector<8xf64>) {
