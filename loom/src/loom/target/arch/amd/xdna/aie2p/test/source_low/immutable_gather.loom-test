// ====

// Integer and floating aliases of each width share bit-preserving recipes.
// RUN: with-checks pass target-legalize{mode=eager},dce,canonicalize

global.rodata.def @table = align(8) bytes("00000100020003000400050006000700080009000a000b000c000d000e000f0010001100120013001400150016001700180019001a001b001c001d001e001f00")

aie2p.target<core> @target

func.def target(@target) @immutable_type_aliases(%packed_i16: vector<32xi8>, %packed_f16: vector<32xi8>, %packed_i64: vector<8xi8>) -> (vector<32xi16>, vector<32xf16>, vector<8xi64>) {
  %table = global.load @table : buffer
  %origin = index.constant 0 : offset
  %view_i16 = buffer.view %table[%origin] : buffer -> view<32xi16>
  %view_f16 = buffer.view %table[%origin] : buffer -> view<32xf16>
  %view_i64 = buffer.view %table[%origin] : buffer -> view<8xi64>
  %mask_16 = vector.splati 31 : vector<32xi8>
  %mask_64 = vector.splati 7 : vector<8xi8>
  %bounded_i16 = vector.andi %packed_i16, %mask_16 : vector<32xi8>
  %bounded_f16 = vector.andi %packed_f16, %mask_16 : vector<32xi8>
  %bounded_i64 = vector.andi %packed_i64, %mask_64 : vector<8xi8>
  %indices_i16 = vector.extui %bounded_i16 : vector<32xi8> to vector<32xi32>
  %indices_f16 = vector.extui %bounded_f16 : vector<32xi8> to vector<32xi32>
  %indices_i64 = vector.extui %bounded_i64 : vector<8xi8> to vector<8xi32>
  %result_i16 = vector.gather %view_i16[0][%indices_i16] : view<32xi16>, vector<32xi32> -> vector<32xi16>
  %result_f16 = vector.gather %view_f16[0][%indices_f16] : view<32xf16>, vector<32xi32> -> vector<32xf16>
  %result_i64 = vector.gather %view_i64[0][%indices_i64] : view<8xi64>, vector<8xi32> -> vector<8xi64>
  func.return %result_i16, %result_f16, %result_i64 : vector<32xi16>, vector<32xf16>, vector<8xi64>
}

// ----
CHECK: %result_i16 = vector.gather * : view<32xi16>, vector<32xi32> -> vector<32xi16>
CHECK: %result_f16 = vector.gather * : view<32xf16>, vector<32xi32> -> vector<32xf16>
CHECK: %result_i64 = vector.gather * : view<8xi64>, vector<8xi32> -> vector<8xi64>

