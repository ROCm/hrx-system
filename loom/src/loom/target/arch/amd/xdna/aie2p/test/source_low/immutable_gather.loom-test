func.def target(@target) @nonnative_lane_count() -> (vector<8xbf16>) {
  %table = global.load @table : buffer
  %origin = index.constant 0 : offset
  %view = buffer.view %table[%origin] : buffer -> view<32xbf16>
  %indices = vector.splati 0 : vector<8xi32>
  %result_bf16 = vector.gather %view[0][%indices] : view<32xbf16>, vector<8xi32> -> vector<8xbf16>
