// ====
// RUN: with-checks emit aie2p-xdna input=source-low output=pipeline-report

// Distinct caller arguments can alias. Without a noalias contract, the output
// may update a future input record and autonomous read-ahead is not admitted.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @unscoped_input() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
