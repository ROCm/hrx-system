  %236 = mov.short 256
  %237 = mov.short 1
  %width = mov.short 2
  low.br ^_bb1(%235: reg<aie2p.er>)
^_bb1(%record: reg<aie2p.er>):
  %239 = lt %record, %236
  low.cond_br %239, ^_bb2, ^_bb9 : reg<aie2p.er>
^_bb2:
