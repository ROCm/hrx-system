// RUN: with-checks emit aie2p-xdna input=source-low output=pipeline-report

// Coalesced external geometry crosses the descriptor iterator limit while
// local record credits retain bounded storage and exact consumer completion.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

