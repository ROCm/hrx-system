  %records = channel.bind<fifo> %slots, %capacity : view<2x2x2xi32>, index -> channel<tile<2x2xi32>>
  %begin = index.constant 0 : index
  %count = index.constant 65 : index
  %consume_count = index.constant 65 : index
  %step = index.constant 1 : index
  %record_bytes = index.constant 32 : index
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %count step %step] {
      %byte_index = index.mul %record, %record_bytes : index
      %offset = index.cast %byte_index : index to offset
      %external = buffer.view %input[%offset] : buffer -> view<2x2xi32, #encoding.layout.strided<strides=[4, 1]>>
      %write, %destination = channel.reserve %records : channel<tile<2x2xi32>> -> (write<tile<2x2xi32>>, view<2x2xi32>)
      %copy = kernel.async.copy %external to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2x2xi32, #encoding.layout.strided<strides=[4, 1]>> to view<2x2xi32> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.publish %write : write<tile<2x2xi32>>
    }
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %width = index.constant 2 : index
    %factor = scalar.constant 2 : i32
    scf.for %record = [%begin to %consume_count step %step] {
      %read, %payload = channel.acquire<mutable> %records : channel<tile<2x2xi32>> -> (read<tile<2x2xi32>, mutable>, view<2x2xi32>)
      scf.for %row = [%begin to %width step %step] {
        scf.for %column = [%begin to %width step %step] {
          %value = view.load %payload[%row, %column] : view<2x2xi32> -> i32
          %scaled = scalar.muli %value, %factor : i32
          view.store %scaled, %payload[%row, %column] : i32, view<2x2xi32>
        }
      }
      %output_record = index.add %record, %begin : index
      %byte_index = index.mul %output_record, %record_bytes : index
      %offset = index.cast %byte_index : index to offset
      %external = buffer.view %output[%offset] : buffer -> view<2x2xi32, #encoding.layout.strided<strides=[4, 1]>>
      %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<2x2xi32> to view<2x2xi32, #encoding.layout.strided<strides=[4, 1]>> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<2x2xi32>, mutable>
    }
  }
}

