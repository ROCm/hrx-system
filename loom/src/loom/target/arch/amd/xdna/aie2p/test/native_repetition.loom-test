// ====
// RUN: with-checks emit aie2p-xdna input=source-low output=pipeline-report

// A regular egress loop retains an instruction worker for its authored wait.
// Local MM2S completion cannot replace global-write completion before release.
// The producer can reclaim the capacity-one slot while the invocation continues.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @repeated_egress() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 4} : buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 16 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %storage_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x4xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x4xi32>, index -> channel<tile<4xi32>>
  %begin = index.constant 0 : index
  %count = index.constant 2 : index
  %step = index.constant 1 : index
  %record_bytes = index.constant 16 : index
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %value = scalar.constant 7 : i32
    %values = vector.splat %value : vector<4xi32>
    scf.for %record = [%begin to %count step %step] {
      %write, %payload = channel.reserve %records : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
      vector.store %values, %payload[0] : vector<4xi32>, view<4xi32>
      channel.publish %write : write<tile<4xi32>>
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %count step %step] {
      %read, %payload = channel.acquire %records : channel<tile<4xi32>> -> (read<tile<4xi32>>, view<4xi32>)
      %byte_index = index.mul %record, %record_bytes : index
      %offset = index.cast %byte_index : index to offset
      %external = buffer.view %output[%offset] : buffer -> view<4xi32>
      %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4xi32> to view<4xi32> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<4xi32>>
    }
  }
}

// ----
CHECK: COMPILE-REPORT: pipeline root=repeated_egress realization=resident-configuration workers=2 *

// ====
// RUN: with-checks emit aie2p-xdna input=source-low output=pipeline-report

// A Low leaf reads core storage and an immutable artifact while changing
// rounding state. Neither reference can invalidate the distinct external input,
// so repeated SRAM ingress remains DMA-owned.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

global.rodata.def @identity = align(4) bytes("07000000")

low.func.def inline target<amd.xdna.aie2p.core> @read_local(%storage: reg<aie2p.ep>, %identity: reg<aie2p.ep>) -> (reg<aie2p.er>) asm {
  set.rounding 12
  %local_value = lda %storage, 0
  %identity_value = lda %identity, 0
  %value = add.rr %local_value, %identity_value
  return %value
}

func.def inline @read_local_identity(%storage: buffer) -> (i32) {
  %identity = global.load @identity : buffer
  %value = low.invoke @read_local(%storage, %identity) : (buffer, buffer) -> (i32)
  func.return %value : i32
}

pipeline.def<kernel> public retain target(@device) @readonly_call_ingress() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 4} : buffer, buffer
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %core = pipeline.memory<workgroup>[0, 3] : pool
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 8 : index
  %record_bytes = index.constant 4 : index
  %sram_storage = buffer.alloca<workgroup> pool(%sram) align(4) %bytes : buffer
  %sram_slots = buffer.view %sram_storage[%origin] : buffer -> view<1x1xi32>
  %incoming = channel.bind<fifo> %sram_slots, %c1 : view<1x1xi32>, index -> channel<tile<1xi32>>
  %core_storage = buffer.alloca<workgroup> pool(%core) align(4) %bytes : buffer
  %core_slots = buffer.view %core_storage[%origin] : buffer -> view<1x1xi32>
  %local = channel.bind<fifo> %core_slots, %c1 : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %count step %c1] {
      %byte_index = index.mul %record, %record_bytes : index
      %offset = index.cast %byte_index : index to offset
      %external = buffer.view %input[%offset] : buffer -> view<1xi32>
      %write, %payload = channel.reserve %incoming : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
      %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.publish %write : write<tile<1xi32>>
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %count step %c1] {
      %read, %source = channel.acquire %incoming : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
      %write, %destination = channel.reserve %local : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
      channel.copy %read -> %write : read<tile<1xi32>>, write<tile<1xi32>>
    }
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %count step %c1] {
      %read, %payload = channel.acquire<mutable> %local : channel<tile<1xi32>> -> (read<tile<1xi32>, mutable>, view<1xi32>)
      %value = func.call @read_local_identity(%core_storage) : (buffer) -> (i32)
      %factor = scalar.constant 2 : i32
      %scaled = scalar.muli %value, %factor : i32
      view.store %scaled, %payload[0] : i32, view<1xi32>
      %byte_index = index.mul %record, %record_bytes : index
      %offset = index.cast %byte_index : index to offset
      %external = buffer.view %output[%offset] : buffer -> view<1xi32>
      %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<1xi32>, mutable>
    }
  }
}

// ----
CHECK: COMPILE-REPORT: pipeline root=readonly_call_ingress realization=resident-configuration workers=1 *

// ====
// RUN: emit aie2p-xdna input=source-low

// The finite stream exceeds the available descriptor and task-queue product.
// Admission fails instead of queuing a blocking host refill or truncating it.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @finite_ingress_capacity() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 4} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 16 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %storage_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x2x2xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x2x2xi32>, index -> channel<tile<2x2xi32>>
  %begin = index.constant 0 : index
  %count = index.constant 20000 : index
  %consume_count = index.constant 20000 : index
  %step = index.constant 1 : index
  %record_bytes = index.constant 32 : index
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %count step %step] {
      %byte_index = index.mul %record, %record_bytes : index
      %offset = index.cast %byte_index : index to offset
