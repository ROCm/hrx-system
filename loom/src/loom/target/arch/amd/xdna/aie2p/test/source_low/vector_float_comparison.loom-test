// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final}

// The finite-only E4M3 encoding reserves its maximum magnitude for NaN.
func.def @finite_nan_f8e4m3_ueq(%lhs: vector<4xf8E4M3>, %rhs: vector<4xf8E4M3>) -> (vector<4xi1>) {
  %result = vector.cmpf ueq, %lhs, %rhs : vector<4xf8E4M3> -> vector<4xi1>
  func.return %result : vector<4xi1>
}

// ----
func.def @finite_nan_f8e4m3_ueq(%lhs: vector<4xf8E4M3>, %rhs: vector<4xf8E4M3>) -> (vector<4xi1>) {
  %4 = vector.splati 127 : vector<4xi8>
  %5 = vector.bitcast %lhs : vector<4xf8E4M3> to vector<4xi8>
  %6 = vector.andi %5, %4 : vector<4xi8>
  %7 = vector.bitcast %rhs : vector<4xf8E4M3> to vector<4xi8>
  %8 = vector.andi %7, %4 : vector<4xi8>
  %9 = vector.splati 127 : vector<4xi8>
  %10 = vector.cmpi eq, %6, %9 : vector<4xi8> -> vector<4xi1>
  %11 = vector.cmpi eq, %8, %9 : vector<4xi8> -> vector<4xi1>
  %12 = vector.ori %10, %11 : vector<4xi1>
  %13 = vector.splati 0 : vector<4xi8>
  %14 = vector.splati -128 : vector<4xi8>
  %15 = vector.splati -1 : vector<4xi8>
  %16 = vector.cmpi eq, %6, %13 : vector<4xi8> -> vector<4xi1>
  %17 = vector.select %16, %13, %5 : vector<4xi8>
  %18 = vector.cmpi slt, %17, %13 : vector<4xi8> -> vector<4xi1>
  %19 = vector.addi %17, %14 : vector<4xi8>
  %20 = vector.subi %15, %17 : vector<4xi8>
  %21 = vector.select %18, %20, %19 : vector<4xi8>
  %22 = vector.cmpi eq, %8, %13 : vector<4xi8> -> vector<4xi1>
  %23 = vector.select %22, %13, %7 : vector<4xi8>
  %24 = vector.cmpi slt, %23, %13 : vector<4xi8> -> vector<4xi1>
  %25 = vector.addi %23, %14 : vector<4xi8>
  %26 = vector.subi %15, %23 : vector<4xi8>
  %27 = vector.select %24, %26, %25 : vector<4xi8>
  %28 = vector.cmpi eq, %21, %27 : vector<4xi8> -> vector<4xi1>
  %result = vector.ori %28, %12 : vector<4xi1>
  func.return %result : vector<4xi1>
}

// ====

// The E5M2 encoding uses the IEEE infinity boundary and larger NaN magnitudes.
func.def @ieee_f8e5m2_uno(%lhs: vector<8xf8E5M2>, %rhs: vector<8xf8E5M2>) -> (vector<8xi1>) {
  %result = vector.cmpf uno, %lhs, %rhs : vector<8xf8E5M2> -> vector<8xi1>
  func.return %result : vector<8xi1>
}

// ----
func.def @ieee_f8e5m2_uno(%lhs: vector<8xf8E5M2>, %rhs: vector<8xf8E5M2>) -> (vector<8xi1>) {
  %4 = vector.splati 127 : vector<8xi8>
  %5 = vector.bitcast %lhs : vector<8xf8E5M2> to vector<8xi8>
  %6 = vector.andi %5, %4 : vector<8xi8>
  %7 = vector.bitcast %rhs : vector<8xf8E5M2> to vector<8xi8>
  %8 = vector.andi %7, %4 : vector<8xi8>
  %9 = vector.splati 124 : vector<8xi8>
  %10 = vector.cmpi ugt, %6, %9 : vector<8xi8> -> vector<8xi1>
  %11 = vector.cmpi ugt, %8, %9 : vector<8xi8> -> vector<8xi1>
  %result = vector.ori %10, %11 : vector<8xi1>
  func.return %result : vector<8xi1>
}

// ====

// Ordered classification complements the combined IEEE NaN predicate.
func.def @ieee_f16_ord(%lhs: vector<5xf16>, %rhs: vector<5xf16>) -> (vector<5xi1>) {
  %result = vector.cmpf ord, %lhs, %rhs : vector<5xf16> -> vector<5xi1>
  func.return %result : vector<5xi1>
}

// ----
func.def @ieee_f16_ord(%lhs: vector<5xf16>, %rhs: vector<5xf16>) -> (vector<5xi1>) {
  %4 = vector.splati 32767 : vector<5xi16>
  %5 = vector.bitcast %lhs : vector<5xf16> to vector<5xi16>
  %6 = vector.andi %5, %4 : vector<5xi16>
  %7 = vector.bitcast %rhs : vector<5xf16> to vector<5xi16>
  %8 = vector.andi %7, %4 : vector<5xi16>
  %9 = vector.splati 31744 : vector<5xi16>
  %10 = vector.cmpi ugt, %6, %9 : vector<5xi16> -> vector<5xi1>
  %11 = vector.cmpi ugt, %8, %9 : vector<5xi16> -> vector<5xi1>
  %12 = vector.ori %10, %11 : vector<5xi1>
  %13 = vector.splati 0 : vector<5xi16>
  %14 = vector.cmpi eq, %13, %13 : vector<5xi16> -> vector<5xi1>
  %result = vector.xori %14, %12 : vector<5xi1>
  func.return %result : vector<5xi1>
}

