// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final}

// The finite-only E4M3 encoding reserves its maximum magnitude for NaN.
func.def @finite_nan_f8e4m3_ueq(%lhs: vector<4xf8E4M3>, %rhs: vector<4xf8E4M3>) -> (vector<4xi1>) {
  %result = vector.cmpf ueq, %lhs, %rhs : vector<4xf8E4M3> -> vector<4xi1>
  func.return %result : vector<4xi1>
}

// ----
func.def @finite_nan_f8e4m3_ueq(%lhs: vector<4xf8E4M3>, %rhs: vector<4xf8E4M3>) -> (vector<4xi1>) {
  %4 = scalar.constant 127 : i8
  %5 = vector.splat %4 : vector<4xi8>
  %6 = vector.bitcast %lhs : vector<4xf8E4M3> to vector<4xi8>
  %7 = vector.andi %6, %5 : vector<4xi8>
  %8 = vector.bitcast %rhs : vector<4xf8E4M3> to vector<4xi8>
  %9 = vector.andi %8, %5 : vector<4xi8>
  %10 = scalar.constant 127 : i8
  %11 = vector.splat %10 : vector<4xi8>
  %12 = vector.cmpi eq, %7, %11 : vector<4xi8> -> vector<4xi1>
  %13 = vector.cmpi eq, %9, %11 : vector<4xi8> -> vector<4xi1>
  %14 = vector.ori %12, %13 : vector<4xi1>
  %15 = scalar.constant 0 : i8
  %16 = vector.splat %15 : vector<4xi8>
  %17 = scalar.constant -128 : i8
  %18 = vector.splat %17 : vector<4xi8>
  %19 = scalar.constant -1 : i8
  %20 = vector.splat %19 : vector<4xi8>
  %21 = vector.cmpi eq, %7, %16 : vector<4xi8> -> vector<4xi1>
  %22 = vector.select %21, %16, %6 : vector<4xi8>
  %23 = vector.cmpi slt, %22, %16 : vector<4xi8> -> vector<4xi1>
  %24 = vector.addi %22, %18 : vector<4xi8>
  %25 = vector.subi %20, %22 : vector<4xi8>
  %26 = vector.select %23, %25, %24 : vector<4xi8>
  %27 = vector.cmpi eq, %9, %16 : vector<4xi8> -> vector<4xi1>
  %28 = vector.select %27, %16, %8 : vector<4xi8>
  %29 = vector.cmpi slt, %28, %16 : vector<4xi8> -> vector<4xi1>
  %30 = vector.addi %28, %18 : vector<4xi8>
  %31 = vector.subi %20, %28 : vector<4xi8>
  %32 = vector.select %29, %31, %30 : vector<4xi8>
  %33 = vector.cmpi eq, %26, %32 : vector<4xi8> -> vector<4xi1>
  %result = vector.ori %33, %14 : vector<4xi1>
  func.return %result : vector<4xi1>
}

// ====

// The E5M2 encoding uses the IEEE infinity boundary and larger NaN magnitudes.
func.def @ieee_f8e5m2_uno(%lhs: vector<8xf8E5M2>, %rhs: vector<8xf8E5M2>) -> (vector<8xi1>) {
  %result = vector.cmpf uno, %lhs, %rhs : vector<8xf8E5M2> -> vector<8xi1>
  func.return %result : vector<8xi1>
}

// ----
func.def @ieee_f8e5m2_uno(%lhs: vector<8xf8E5M2>, %rhs: vector<8xf8E5M2>) -> (vector<8xi1>) {
  %4 = scalar.constant 127 : i8
  %5 = vector.splat %4 : vector<8xi8>
  %6 = vector.bitcast %lhs : vector<8xf8E5M2> to vector<8xi8>
  %7 = vector.andi %6, %5 : vector<8xi8>
  %8 = vector.bitcast %rhs : vector<8xf8E5M2> to vector<8xi8>
  %9 = vector.andi %8, %5 : vector<8xi8>
  %10 = scalar.constant 124 : i8
  %11 = vector.splat %10 : vector<8xi8>
  %12 = vector.cmpi ugt, %7, %11 : vector<8xi8> -> vector<8xi1>
  %13 = vector.cmpi ugt, %9, %11 : vector<8xi8> -> vector<8xi1>
  %result = vector.ori %12, %13 : vector<8xi1>
  func.return %result : vector<8xi1>
}

// ====

// Ordered classification complements the combined IEEE NaN predicate.
func.def @ieee_f16_ord(%lhs: vector<5xf16>, %rhs: vector<5xf16>) -> (vector<5xi1>) {
  %result = vector.cmpf ord, %lhs, %rhs : vector<5xf16> -> vector<5xi1>
  func.return %result : vector<5xi1>
}

// ----
func.def @ieee_f16_ord(%lhs: vector<5xf16>, %rhs: vector<5xf16>) -> (vector<5xi1>) {
  %4 = scalar.constant 32767 : i16
  %5 = vector.splat %4 : vector<5xi16>
  %6 = vector.bitcast %lhs : vector<5xf16> to vector<5xi16>
  %7 = vector.andi %6, %5 : vector<5xi16>
  %8 = vector.bitcast %rhs : vector<5xf16> to vector<5xi16>
  %9 = vector.andi %8, %5 : vector<5xi16>
  %10 = scalar.constant 31744 : i16
  %11 = vector.splat %10 : vector<5xi16>
  %12 = vector.cmpi ugt, %7, %11 : vector<5xi16> -> vector<5xi1>
  %13 = vector.cmpi ugt, %9, %11 : vector<5xi16> -> vector<5xi1>
  %14 = vector.ori %12, %13 : vector<5xi1>
  %15 = scalar.constant 0 : i16
  %16 = vector.splat %15 : vector<5xi16>
  %17 = vector.cmpi eq, %16, %16 : vector<5xi16> -> vector<5xi1>
  %result = vector.xori %17, %14 : vector<5xi1>
  func.return %result : vector<5xi1>
}

