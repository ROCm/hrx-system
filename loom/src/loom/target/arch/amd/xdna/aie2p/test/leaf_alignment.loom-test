// ====

// RUN: emit aie2p-leaf @targeted_empty_chain report=code

// The taken destination and its adjacent successor have no edge arguments or
// descriptor work. Their labels must alias the eventual store address.
low.func.def target<amd.xdna.aie2p.core> @targeted_empty_chain(%condition: reg<aie2p.er>, %value: reg<aie2p.er>, %output: reg<aie2p.ep>) asm {
  low.cond_br %condition, ^target, ^exit : reg<aie2p.er>
^exit:
  return
^target:
  low.br ^empty
^empty:
  low.br ^work
^work:
  st %value, %output, 0
  low.br ^exit
}

