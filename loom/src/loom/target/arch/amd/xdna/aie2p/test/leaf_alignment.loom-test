// ====

// The conditional branch shares the store packet and retains five delay
// cycles before the fallthrough backedge jump. The exit shares its NOP tail.
// RUN: emit aie2p-leaf @countdown_store report=code

low.func.def target<amd.xdna.aie2p.core> @countdown_store(%output: reg<aie2p.ep>, %count: reg<aie2p.er>) asm {
  low.br ^loop(%count: reg<aie2p.er>)
^loop(%remaining: reg<aie2p.er>):
  %next = add %remaining, -1
  st %next, %output, 0
  low.cond_br %next, ^backedge, ^exit : reg<aie2p.er>
^backedge:
  low.br ^loop(%next: reg<aie2p.er>)
^exit:
  return
}

