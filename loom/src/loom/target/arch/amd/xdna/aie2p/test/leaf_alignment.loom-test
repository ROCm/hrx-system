// ====

// RUN: emit aie2p-leaf @neither_next report=code

// Both distinct store arms follow the shared return in physical source order.
low.func.def target<amd.xdna.aie2p.core> @neither_next(%condition: reg<aie2p.er>, %left_value: reg<aie2p.er>, %right_value: reg<aie2p.er>, %output: reg<aie2p.ep>) asm {
  low.cond_br %condition, ^left, ^right : reg<aie2p.er>
^join:
  return
^left:
  st %left_value, %output, 0
  low.br ^join
^right:
  st %right_value, %output, 0
  low.br ^join
}

