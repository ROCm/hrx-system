// Native jump destinations retain aligned entry points, including shared NOP
// tails. Fallthrough labels add no padding. Bytes precede target relocation.
// RUN: emit aie2p-leaf @identical_next report=code

// Both dynamic outcomes reach the adjacent block after an observable store.
low.func.def target<amd.xdna.aie2p.core> @identical_next(%condition: reg<aie2p.er>, %value: reg<aie2p.er>, %output: reg<aie2p.ep>) asm {
  %before = add %value, 1
  st %before, %output, 0
  low.cond_br %condition, ^next, ^next : reg<aie2p.er>
^next:
  %after = add %before, 1
  st %after, %output, 4
  return
}

