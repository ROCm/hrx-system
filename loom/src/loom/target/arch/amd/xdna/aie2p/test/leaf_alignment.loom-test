// ====

// RUN: emit aie2p-leaf @identical_nonnext report=code

// Both outcomes return to the current resident worker, not a following block.
low.func.def target<amd.xdna.aie2p.core> @identical_nonnext(%condition: reg<aie2p.er>, %value: reg<aie2p.er>, %output: reg<aie2p.ep>) asm {
  low.br ^worker
^worker:
  st %value, %output, 0
  low.cond_br %condition, ^worker, ^worker : reg<aie2p.er>
}

