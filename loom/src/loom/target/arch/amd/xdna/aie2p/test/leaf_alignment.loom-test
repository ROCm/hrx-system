fixup: section=0 offset=24 kind=1 symbol=0 addend=0

// ====

// The independent condition allows the branch to share useful tail work.
// Both paths observe the preceding vector store after its effects retire.
// RUN: emit aie2p-leaf @shared_tail report=code

low.func.def target<amd.xdna.aie2p.core> @shared_tail(%condition: reg<aie2p.er>, %input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %loaded = vlda.512.i32x16 %input, 0
  %doubled = vadd.32 %loaded, %loaded
  vst.512.i32x16 %doubled, %output, 0
  low.cond_br %condition, ^taken, ^fallthrough : reg<aie2p.er>
^fallthrough:
  %one = mov.i32 1
  st %one, %output, 16
  return
^taken:
  %two = mov.i32 2
  st %two, %output, 16
  return
}

