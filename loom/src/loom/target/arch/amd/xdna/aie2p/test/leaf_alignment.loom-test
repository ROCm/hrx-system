// ====

// The entry load leaves an implicit timing gap containing an aligned address.
// The loop backedge retains a direct entry instead of repeating that NOP prefix.
// The forward exit can share the explicit delay tail of the backedge branch.
// RUN: emit aie2p-leaf @loop_entry_prefix report=code

low.func.def target<amd.xdna.aie2p.core> @loop_entry_prefix(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %count: reg<aie2p.er>) asm {
  st %count, %output, 4
  %loaded = vlda.512.i32x16 %input, 0
  low.br ^loop(%count: reg<aie2p.er>)
^loop(%remaining: reg<aie2p.er>):
  %next = add %remaining, -1
  vst.512.i32x16 %loaded, %output, 0
  low.cond_br %next, ^backedge, ^exit : reg<aie2p.er>
^backedge:
  low.br ^loop(%next: reg<aie2p.er>)
^exit:
  return
}

