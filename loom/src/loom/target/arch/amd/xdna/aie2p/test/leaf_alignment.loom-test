// ====

// A forward join may share the implicit store-retirement gap. The taken edge
// skips the vector store, while fallthrough still waits for it to retire.
// RUN: emit aie2p-leaf @forward_store_prefix report=code

low.func.def target<amd.xdna.aie2p.core> @forward_store_prefix(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %condition: reg<aie2p.er>) asm {
  st %condition, %output, 4
  st %condition, %output, 8
  st %condition, %output, 12
  st %condition, %output, 16
  low.cond_br %condition, ^join, ^copy : reg<aie2p.er>
^copy:
  %loaded = vlda.512.i32x16 %input, 0
  vst.512.i32x16 %loaded, %output, 0
  low.br ^join
^join:
  return
}

