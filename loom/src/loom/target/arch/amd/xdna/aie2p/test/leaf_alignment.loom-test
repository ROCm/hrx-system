// ====

// A load-produced condition retains its read latency even when tail slots
// are otherwise free. The condition register remains part of the bundle.
// RUN: emit aie2p-leaf @loaded_condition report=code

low.func.def target<amd.xdna.aie2p.core> @loaded_condition(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %zero = mov.i32 0
  %index = mov.address-index %zero
  %condition = lda.i32.index %input, %index
  st %zero, %output, 0
  low.cond_br %condition, ^fallthrough, ^taken : reg<aie2p.er>
^fallthrough:
  %one = mov.i32 1
  st %one, %output, 4
  return
^taken:
  %two = mov.i32 2
  st %two, %output, 4
  return
}

