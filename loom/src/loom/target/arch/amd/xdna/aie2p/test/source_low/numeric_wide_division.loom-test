// ====
// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize,cse,dce
func.def @bounded_chain(%word: i32, %first: i64, %second: i64) -> (i64, i64, i64) {
  %dividend = scalar.extui %word : i32 to i64
  %quotient, %remainder = scalar.divremui %dividend, %first : i64
  %next = scalar.divui %quotient, %second : i64
  func.return %next, %quotient, %remainder : i64, i64, i64
}

// ----
func.def @bounded_chain(%word: i32, %first: i64, %second: i64) -> (i64, i64, i64) {
  %52 = scalar.constant 4294967295 : i64
  %53 = scalar.andi %first, %52 : i64
  %54 = scalar.trunci %53 : i64 to i32
  %49 = scalar.constant 32 : i64
  %50 = scalar.shrui %first, %49 : i64
  %51 = scalar.trunci %50 : i64 to i32
  %13 = scalar.constant 0 : i32
  %14 = scalar.constant 1 : i32
  %15 = scalar.cmpi ne, %51, %13 : i32
  %16 = scf.select %15, %14, %54 : i32
  %46 = scalar.divui %word, %16 : i32
  %47 = scalar.muli %46, %16 : i32
  %48 = scalar.subi %word, %47 : i32
  %19 = scf.select %15, %13, %46 : i32
  %quotient = scalar.extui %19 : i32 to i64
  %21 = scf.select %15, %word, %48 : i32
  %remainder = scalar.extui %21 : i32 to i64
  %41 = scalar.andi %second, %52 : i64
  %42 = scalar.trunci %41 : i64 to i32
  %38 = scalar.shrui %second, %49 : i64
  %39 = scalar.trunci %38 : i64 to i32
  %28 = scalar.cmpi ne, %39, %13 : i32
  %29 = scf.select %28, %14, %42 : i32
  %34 = scalar.divui %19, %29 : i32
  %32 = scf.select %28, %13, %34 : i32
  %next = scalar.extui %32 : i32 to i64
  func.return %next, %quotient, %remainder : i64, i64, i64
}

// ====
// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize,cse,dce
func.def @bounded_signed(%input: i64, %divisor: i64) -> (i64, i64) {
  %dividend = scalar.assume %input [range(%input, -4294967295, 4294967295)] : i64
  %quotient = scalar.divsi %dividend, %divisor : i64
  %remainder = scalar.remsi %dividend, %divisor : i64
  func.return %quotient, %remainder : i64, i64
}

// ----
func.def @bounded_signed(%input: i64, %divisor: i64) -> (i64, i64) {
  %dividend = scalar.assume %input [range(%input, -4294967295, 4294967295)] : i64
  %40 = scalar.constant 63 : i64
  %41 = scalar.shrsi %dividend, %40 : i64
  %42 = scalar.xori %dividend, %41 : i64
  %43 = scalar.subi %42, %41 : i64
  %45 = scalar.shrsi %divisor, %40 : i64
  %46 = scalar.xori %divisor, %45 : i64
  %47 = scalar.subi %46, %45 : i64
  %71 = scalar.constant 4294967295 : i64
  %72 = scalar.andi %43, %71 : i64
  %73 = scalar.trunci %72 : i64 to i32
  %69 = scalar.andi %47, %71 : i64
  %70 = scalar.trunci %69 : i64 to i32
  %65 = scalar.constant 32 : i64
  %66 = scalar.shrui %47, %65 : i64
  %67 = scalar.trunci %66 : i64 to i32
  %51 = scalar.constant 0 : i32
  %52 = scalar.constant 1 : i32
  %53 = scalar.cmpi ne, %67, %51 : i32
  %54 = scf.select %53, %52, %70 : i32
  %62 = scalar.divui %73, %54 : i32
  %57 = scf.select %53, %51, %62 : i32
  %58 = scalar.extui %57 : i32 to i64
  %59 = scalar.xori %41, %45 : i64
  %60 = scalar.xori %58, %59 : i64
  %quotient = scalar.subi %60, %59 : i64
  %29 = scalar.muli %62, %54 : i32
  %30 = scalar.subi %73, %29 : i32
  %24 = scf.select %53, %73, %30 : i32
  %25 = scalar.extui %24 : i32 to i64
  %26 = scalar.xori %25, %41 : i64
  %remainder = scalar.subi %26, %41 : i64
  func.return %quotient, %remainder : i64, i64
}

// ====
// RUN: emit source-low @unrolled_division target=amd.xdna.aie2p:core output=low
func.def @unrolled_division(%word: i32, %divisor: i64) -> (i64) {
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %initial = scalar.extui %word : i32 to i64
  %result = scf.for %position = [%begin to %end step %step](%value = %initial : i64) -> (i64) unroll(%end) {
    %next = scalar.divui %value, %divisor : i64
    scf.yield %next : i64
  }
  func.return %result : i64
}

