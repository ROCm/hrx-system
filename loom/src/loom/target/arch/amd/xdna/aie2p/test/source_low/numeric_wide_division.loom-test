  %76 = scalar.constant 4294967295 : i64
  %77 = scalar.andi %46, %76 : i64
  %78 = scalar.trunci %77 : i64 to i32
  %74 = scalar.andi %50, %76 : i64
  %75 = scalar.trunci %74 : i64 to i32
  %70 = scalar.constant 32 : i64
  %71 = scalar.shrui %50, %70 : i64
  %72 = scalar.trunci %71 : i64 to i32
  %54 = scalar.constant 0 : i32
  %55 = scalar.constant 1 : i32
  %56 = scalar.cmpi ne, %72, %54 : i32
  %57 = scf.select %56, %55, %75 : i32
  %66 = scalar.divui %78, %57 : i32
  %60 = scf.select %56, %54, %66 : i32
  %61 = scalar.extui %60 : i32 to i64
  %62 = scalar.assume %61 [ule(%61, %46)] : i64
  %63 = scalar.xori %44, %48 : i64
  %64 = scalar.xori %62, %63 : i64
  %quotient = scalar.subi %64, %63 : i64
  %31 = scalar.muli %66, %57 : i32
  %32 = scalar.subi %78, %31 : i32
  %33 = scalar.assume %32 [ult(%32, %57)] : i32
  %24 = scf.select %56, %78, %33 : i32
  %25 = scalar.extui %24 : i32 to i64
  %26 = scalar.assume %25 [ult(%25, %50), ge(%25, 0)] : i64
  %27 = scalar.xori %26, %44 : i64
  %28 = scalar.subi %27, %44 : i64
  %remainder = scalar.assume %28 [le(%28, %26)] : i64
  func.return %quotient, %remainder : i64, i64
}

// ====
// RUN: emit source-low @unrolled_division target=amd.xdna.aie2p:core output=low
func.def @unrolled_division(%word: i32, %divisor: i64) -> (i64) {
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %initial = scalar.extui %word : i32 to i64
  %result = scf.for %position = [%begin to %end step %step](%value = %initial : i64) -> (i64) unroll(%end) {
    %next = scalar.divui %value, %divisor : i64
    scf.yield %next : i64
  }
  func.return %result : i64
}

