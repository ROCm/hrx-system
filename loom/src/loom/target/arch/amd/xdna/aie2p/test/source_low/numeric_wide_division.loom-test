// ====
// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize,cse,dce
func.def @bounded_chain(%word: i32, %first: i64, %second: i64) -> (i64, i64, i64) {
  %dividend = scalar.extui %word : i32 to i64
  %quotient, %remainder = scalar.divremui %dividend, %first : i64
  %next = scalar.divui %quotient, %second : i64
  func.return %next, %quotient, %remainder : i64, i64, i64
}

// ----
func.def @bounded_chain(%word: i32, %first: i64, %second: i64) -> (i64, i64, i64) {
  %dividend = scalar.extui %word : i32 to i64
  %57 = scalar.constant 4294967295 : i64
  %58 = scalar.andi %first, %57 : i64
  %59 = scalar.trunci %58 : i64 to i32
  %54 = scalar.constant 32 : i64
  %55 = scalar.shrui %first, %54 : i64
  %56 = scalar.trunci %55 : i64 to i32
  %13 = scalar.constant 0 : i32
  %14 = scalar.constant 1 : i32
  %15 = scalar.cmpi ne, %56, %13 : i32
  %16 = scf.select %15, %14, %59 : i32
  %50 = scalar.divui %word, %16 : i32
  %51 = scalar.muli %50, %16 : i32
  %52 = scalar.subi %word, %51 : i32
  %53 = scalar.assume %52 [ult(%52, %16)] : i32
  %19 = scf.select %15, %13, %50 : i32
  %20 = scalar.extui %19 : i32 to i64
  %21 = scf.select %15, %word, %53 : i32
  %22 = scalar.extui %21 : i32 to i64
  %quotient, %remainder = scalar.assume %20, %22 [ule(%20, %dividend), ult(%22, %first)] : i64, i64
  %49 = scalar.trunci %quotient : i64 to i32
  %45 = scalar.andi %second, %57 : i64
  %46 = scalar.trunci %45 : i64 to i32
  %42 = scalar.shrui %second, %54 : i64
  %43 = scalar.trunci %42 : i64 to i32
  %30 = scalar.cmpi ne, %43, %13 : i32
  %31 = scf.select %30, %14, %46 : i32
  %37 = scalar.divui %49, %31 : i32
  %34 = scf.select %30, %13, %37 : i32
  %35 = scalar.extui %34 : i32 to i64
  %next = scalar.assume %35 [ule(%35, %quotient)] : i64
  func.return %next, %quotient, %remainder : i64, i64, i64
}

// ====
// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize,cse,dce
func.def @bounded_signed(%input: i64, %divisor: i64) -> (i64, i64) {
  %dividend = scalar.assume %input [range(%input, -4294967295, 4294967295)] : i64
  %quotient = scalar.divsi %dividend, %divisor : i64
  %remainder = scalar.remsi %dividend, %divisor : i64
  func.return %quotient, %remainder : i64, i64
}

// ----
func.def @bounded_signed(%input: i64, %divisor: i64) -> (i64, i64) {
  %dividend = scalar.assume %input [range(%input, -4294967295, 4294967295)] : i64
  %43 = scalar.constant 63 : i64
  %44 = scalar.shrsi %dividend, %43 : i64
  %45 = scalar.xori %dividend, %44 : i64
  %46 = scalar.subi %45, %44 : i64
  %48 = scalar.shrsi %divisor, %43 : i64
  %49 = scalar.xori %divisor, %48 : i64
