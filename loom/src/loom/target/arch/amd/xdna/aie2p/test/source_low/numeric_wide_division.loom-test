// RUN: emit source-low @unsigned_pair target=amd.xdna.aie2p:core output=low
func.def @unsigned_pair(%dividend: i64, %divisor: i64) -> (i64, i64) {
  %quotient, %remainder = scalar.divremui %dividend, %divisor : i64
  func.return %quotient, %remainder : i64, i64
}

