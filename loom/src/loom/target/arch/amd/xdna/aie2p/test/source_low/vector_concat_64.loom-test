func.def @concat_i64_1_7(%left: vector<1xi64>, %right: vector<7xi64>) -> (vector<8xi64>) {
  %result = vector.concat<0> %left, %right : vector<1xi64>, vector<7xi64> -> vector<8xi64>
  func.return %result : vector<8xi64>
}

// ----
CHECK: * = mova.i32 8
CHECK: * = vshift *
CHECK: * = mova.i32 56
CHECK: * = vshift *
CHECK-NOT: vextract
CHECK-NOT: vinsert

// ====

