low.func.def target<amd.xdna.aie2p.core>(@wide_target) abi(object_function) @packetized_product_chain() asm {
  %input_aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %100 = mov.static-address-index 128
  %101 = lda.i16.index %input_aligned, %100
  %102 = vbcst.16 %101
  %103 = mov.static-address-index 384
  %104 = lda.i16.index %input_aligned, %103
  %105 = vbcst.16 %104
  %106 = mov.static-address-index 640
  %107 = lda.i16.index %input_aligned, %106
  %108 = vbcst.16 %107
  %109 = vlda.512.bf16x32 %input_aligned, 0
  %110 = vlda.512.bf16x32 %input_aligned, 256
  %111 = mov.static-address-index 512
  %112 = vlda.512.bf16x32.index %input_aligned, %111
  %113 = mova.i32 60
  %114 = vmul.bf16x32 %109, %110, %113
  %115 = slice %114[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %116 = copy %115 : reg<aie2p.mbms x2> -> reg<aie2p.mbms x2>
  %117 = concat(%116, %116) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %119 = vmac.bf16x32 %117, %109, %112, %113
  %120 = slice %119[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %121 = copy %120 : reg<aie2p.mbms x2> -> reg<aie2p.mbms x2>
  %122 = vlda.512.bf16x32 %input_aligned, 64
  %123 = vlda.512.bf16x32 %input_aligned, 320
  %124 = mov.static-address-index 576
  %125 = vlda.512.bf16x32.index %input_aligned, %124
  %127 = vmul.bf16x32 %122, %123, %113
  %128 = slice %127[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %129 = copy %128 : reg<aie2p.mbms x2> -> reg<aie2p.mbms x2>
  %130 = concat(%129, %129) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %132 = vmac.bf16x32 %130, %122, %125, %113
  %133 = slice %132[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %134 = copy %133 : reg<aie2p.mbms x2> -> reg<aie2p.mbms x2>
  %136 = vmul.bf16x32 %102, %105, %113
  %137 = slice %136[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %138 = vmov.accumulator512.to.vector512 %137
  %139 = concat(%138) : (reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x2>
  %140 = vmov.vector512.to.accumulator512 %139
  %141 = concat(%140, %140, %140, %140) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %143 = vmac.bf16x32 %141, %102, %108, %113
  %144 = slice %143[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %145 = vmov.accumulator512.to.vector512 %144
  %146 = concat(%145) : (reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x2>
  %147 = slice %121[0] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %148 = vmov.accumulator512.to.vector512 %147
  vst.512.f32x16 %148, %output_aligned, 0
  %149 = slice %121[1] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %150 = vmov.accumulator512.to.vector512 %149
  vst.512.f32x16 %150, %output_aligned, 64
  %151 = slice %134[0] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %152 = vmov.accumulator512.to.vector512 %151
  vst.512.f32x16 %152, %output_aligned, 128
  %153 = slice %134[1] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %154 = vmov.accumulator512.to.vector512 %153
  vst.512.f32x16 %154, %output_aligned, 192
  %155 = vextract.32.imm %146, 0
  %156 = mov.static-address-index 256
  st.i32.index %155, %output_aligned, %156
  return
}

