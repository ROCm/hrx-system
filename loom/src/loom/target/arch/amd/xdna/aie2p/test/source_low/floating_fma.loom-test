low.func.def target<amd.xdna.aie2p.core> abi(object_function) @rounded_product(%left: reg<aie2p.vec256 x4>, %right: reg<aie2p.vec256 x4>) -> (reg<aie2p.mbms x4>) asm {
  %14 = mova.i32 60
  %first = vmul.bf16x64 %left, %right, %14
  set.rounding 12
  %16 = slice %first[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %17 = vconv.bf16.fp32 %16
  %18 = slice %first[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %19 = vconv.bf16.fp32 %18
  %narrow = concat(%17, %19) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %21 = mov.i32 1056964608
  %22 = vbcst.32 %21
  %23 = vmov.vector512.to.accumulator512 %22
  %half = concat(%23, %23, %23, %23) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %25 = slice %half[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %26 = vconv.bf16.fp32 %25
  %27 = slice %half[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %28 = vconv.bf16.fp32 %27
  %29 = concat(%26, %28) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %result = vmac.bf16x64 %first, %narrow, %29, %14
  return %result
}

// ====

// Numeric format facts permit native FMA after flushing, without substituting
// the unconverted source operands as exact lane origins.
func.def @flushed_widening_product(%left: vector<64xbf16>, %right: vector<64xbf16>, %seed: vector<64xf32>) -> (vector<64xf32>) {
  %a = vector.extf<daz> %left : vector<64xbf16> to vector<64xf32>
  %b = vector.extf<daz|ftz> %right : vector<64xbf16> to vector<64xf32>
  %result = vector.fmaf<nnan|ninf|nsz|afn> %a, %b, %seed : vector<64xf32>
  func.return %result : vector<64xf32>
}

