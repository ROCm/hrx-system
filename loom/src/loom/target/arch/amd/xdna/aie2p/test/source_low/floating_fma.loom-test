// RUN: emit source-low target=amd.xdna.aie2p:core output=low

aie2p.target<core> @wide_target

func.def target(@wide_target) @packetized_product_chain(%input_buffer: buffer, %output_buffer: buffer) {
  %base_offset = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input_buffer {minimum_alignment = 64} : buffer
  %output_aligned = buffer.assume.alignment %output_buffer {minimum_alignment = 64} : buffer
  %input = buffer.view %input_aligned[%base_offset] : buffer -> view<3x128xbf16>
  %output = buffer.view %output_aligned[%base_offset] : buffer -> view<128xf32>
  %left = vector.load %input[0, 0] : view<3x128xbf16> -> vector<65xbf16>
  %right = vector.load %input[1, 0] : view<3x128xbf16> -> vector<65xbf16>
  %other = vector.load %input[2, 0] : view<3x128xbf16> -> vector<65xbf16>
  %left_wide = vector.extf %left : vector<65xbf16> to vector<65xf32>
  %right_wide = vector.extf %right : vector<65xbf16> to vector<65xf32>
  %other_wide = vector.extf %other : vector<65xbf16> to vector<65xf32>
  %origin = vector.splatf 0.0 : vector<65xf32>
  %product = vector.fmaf<nnan|ninf|nsz|afn> %left_wide, %right_wide, %origin : vector<65xf32>
  %result = vector.fmaf<nnan|ninf|nsz|afn> %left_wide, %other_wide, %product : vector<65xf32>
  vector.store %result, %output[0] : vector<65xf32>, view<128xf32>
  func.return
}

