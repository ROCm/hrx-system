  %95 = lda.i16.index %input_aligned, %94
  %96 = vbcst.16 %95
  %97 = concat(%91, %93) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %98 = mova.i32 60
  %99 = vmul.bf16x64 %83, %89, %98
  %101 = vmac.bf16x64 %99, %83, %97, %98
  %103 = vmul.bf16x32 %82, %88, %98
  %104 = slice %103[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
