  %24 = vconv.bf16.fp32 %14
  %25 = concat(%22, %24) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %27 = vconv.bf16.fp32 %17
  %29 = vconv.bf16.fp32 %19
  %30 = concat(%27, %29) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %31 = mova.i32 60
  %result = vmac.bf16x64 %seed, %25, %30, %31
  return %result
}
