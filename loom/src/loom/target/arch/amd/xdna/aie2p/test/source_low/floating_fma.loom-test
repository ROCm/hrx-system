// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @widened_product_chain(%left: vector<64xbf16>, %right: vector<64xbf16>, %other: vector<64xbf16>) -> (vector<64xf32>) {
  %left_wide = vector.extf %left : vector<64xbf16> to vector<64xf32>
  %right_wide = vector.extf %right : vector<64xbf16> to vector<64xf32>
  %other_wide = vector.extf %other : vector<64xbf16> to vector<64xf32>
  %origin = vector.splatf 0.0 : vector<64xf32>
  %product = vector.fmaf<nnan|ninf|nsz|afn> %left_wide, %right_wide, %origin : vector<64xf32>
  %result = vector.fmaf<nnan|ninf|nsz|afn> %left_wide, %other_wide, %product : vector<64xf32>
  func.return %result : vector<64xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widened_product_chain(%left: reg<aie2p.vec256 x4>, %right: reg<aie2p.vec256 x4>, %other: reg<aie2p.vec256 x4>) -> (reg<aie2p.mbms x4>) asm {
  %29 = mova.i32 60
  %product = vmul.bf16x64 %left, %right, %29
  %result = vmac.bf16x64 %product, %left, %other, %29
  return %result
}

