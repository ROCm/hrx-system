func.def @rounded_product(%left: vector<64xbf16>, %right: vector<64xbf16>) -> (vector<64xf32>) {
  %a = vector.extf %left : vector<64xbf16> to vector<64xf32>
  %b = vector.extf %right : vector<64xbf16> to vector<64xf32>
  %identity = vector.splatf 0.0 : vector<64xf32>
  %first = vector.fmaf<nnan|ninf|nsz|afn> %a, %b, %identity : vector<64xf32>
  %narrow = vector.fptrunc<daz> %first : vector<64xf32> to vector<64xbf16>
  %wide = vector.extf %narrow : vector<64xbf16> to vector<64xf32>
  %half = vector.splatf 0.5 : vector<64xf32>
  %result = vector.fmaf<nnan|ninf|nsz|afn> %wide, %half, %first : vector<64xf32>
  func.return %result : vector<64xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @rounded_product(%left: reg<aie2p.vec256 x4>, %right: reg<aie2p.vec256 x4>) -> (reg<aie2p.mbms x4>) asm {
  %29 = mova.i32 60
  %first = vmul.bf16x64 %left, %right, %29
  set.rounding 12
  %31 = slice %first[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %32 = vconv.bf16.fp32 %31
  %33 = slice %first[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %34 = vconv.bf16.fp32 %33
  %narrow = concat(%32, %34) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %36 = mov.i32 1056964608
  %37 = vbcst.32 %36
  %38 = vmov.vector512.to.accumulator512 %37
  %half = concat(%38, %38, %38, %38) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %40 = slice %half[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %41 = vconv.bf16.fp32 %40
  %42 = slice %half[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %43 = vconv.bf16.fp32 %42
  %44 = concat(%41, %43) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %result = vmac.bf16x64 %first, %narrow, %44, %29
  return %result
}
