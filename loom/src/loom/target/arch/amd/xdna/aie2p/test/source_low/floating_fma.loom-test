// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// The comparison first needs a semantic rewrite. Eager scalar fallback must
// preserve the selection and widenings until packet planning can use it.
func.def @comparison_before_widened_fma(%left: vector<64xbf16>, %right: vector<64xbf16>, %seed: vector<64xf32>) -> (vector<64xf32>) {
  %condition = vector.cmpf olt, %left, %right : vector<64xbf16> -> vector<64xi1>
  %selected = vector.select %condition, %left, %right : vector<64xbf16>
  %left_wide = vector.extf %selected : vector<64xbf16> to vector<64xf32>
  %right_wide = vector.extf %right : vector<64xbf16> to vector<64xf32>
  %result = vector.fmaf<nnan|ninf|nsz|afn> %left_wide, %right_wide, %seed : vector<64xf32>
  func.return %result : vector<64xf32>
}

