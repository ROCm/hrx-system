low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @subview_nested_dynamic(%origin: reg<aie2p.er>, %row_bounded: reg<aie2p.er>, %column_bounded: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %source_refined = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %destination_inner = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %26 = mov.static-byte-offset 76
  %27 = mov.i32 5
  %28 = lshl %row_bounded, %27
  %29 = add.rr %origin, %28
  %30 = mov.i32 2
  %31 = lshl %column_bounded, %30
  %32 = add.rr %29, %31
  %33 = add.rr %32, %26
  %34 = mov.address-index %33
  %value = lda.i32.index %source_refined, %34
  %36 = mov.static-byte-offset 68
  %39 = add.rr %origin, %28
  %42 = add.rr %39, %31
  %43 = add.rr %42, %36
  %44 = mov.address-index %43
  st.i32.index %value, %destination_inner, %44
  return %value
}

