  %destination_crop = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %17 = mov.static-byte-offset 256
  %18 = mov.address-index %17
  %19 = vlda.256.i32x8.index %source_crop, %18
