low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @subview_dense_rows() -> (reg<aie2p.er>) asm {
  %source_crop = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %destination_crop = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %14 = mov.static-byte-offset 80
  %15 = mov.address-index %14
  %value = lda.i32.index %source_crop, %15
  %17 = mov.static-byte-offset 84
  %18 = mov.address-index %17
