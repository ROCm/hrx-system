  %position = index.assume %position0 [range(%position0, 0, 96), multiple_of(%position0, 32)] : index
  %origin = index.constant 0 : offset
  %output_view = buffer.view %output_aligned[%origin] : buffer -> view<128xbf16>
  %wide_scale = scalar.extf %scale : bf16 to f32
  %scales = vector.splat %wide_scale : vector<32xf32>
  %wide_values = vector.extf %values : vector<32xbf16> to vector<32xf32>
  %wide_product = vector.mulf<nnan|ninf|nsz|contract> %wide_values, %scales : vector<32xf32>
  %product = vector.fptrunc %wide_product : vector<32xf32> to vector<32xbf16>
  vector.store %product, %output_view[%position] : vector<32xbf16>, view<128xbf16>
  func.return
}

