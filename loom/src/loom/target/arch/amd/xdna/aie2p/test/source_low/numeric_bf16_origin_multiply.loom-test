func.def @bf16_vector_scalar_product(%values: vector<16xbf16>, %scale: bf16) -> (vector<16xbf16>) {
  %wide_scale = scalar.extf %scale : bf16 to f32
  %scales = vector.splat %wide_scale : vector<16xf32>
  %wide_values = vector.extf %values : vector<16xbf16> to vector<16xf32>
  %wide_product = vector.mulf<nnan|ninf> %wide_values, %scales : vector<16xf32>
  %product = vector.fptrunc %wide_product : vector<16xf32> to vector<16xbf16>
  func.return %product : vector<16xbf16>
}

