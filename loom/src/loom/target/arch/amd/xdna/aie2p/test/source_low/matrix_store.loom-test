// RUN: emit source-low output=none

aie2p.target<core> @target

func.def target(@target) @requires_numeric_conversion(%value: vector<64xi32>, %output: buffer) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<8x8xf32>
  %extent = index.constant 8 : index
  // ERROR@+1: TARGET/002
  vector.fragment.store<result> %value, %view[0, 0] shape [%extent, %extent] : vector<64xi32>, view<8x8xf32>
  func.return
}
