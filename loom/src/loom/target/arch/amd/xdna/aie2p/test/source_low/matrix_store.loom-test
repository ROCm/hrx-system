// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @store_immediate(%value: vector<64xi32>, %output: buffer) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.constant 256 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<8x8xi32>
  %extent = index.constant 8 : index
  vector.fragment.store<result> %value, %view[0, 0] shape [%extent, %extent] : vector<64xi32>, view<8x8xi32>
  func.return
}

func.def target(@target) @store_materialized(%value: vector<64xi32>, %output: buffer) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.constant 512 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<8x8xi32>
  %extent = index.constant 8 : index
  vector.fragment.store<result> %value, %view[0, 0] shape [%extent, %extent] : vector<64xi32>, view<8x8xi32>
  func.return
}

func.def target(@target) @store_dynamic(%value: vector<64xi32>, %output: buffer, %base_argument: offset) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.assume %base_argument [range(%base_argument, 0, 768), multiple_of(%base_argument, 64)] : offset
  %view = buffer.view %aligned[%base] : buffer -> view<8x8xi32>
  %extent = index.constant 8 : index
  vector.fragment.store<result> %value, %view[0, 0] shape [%extent, %extent] : vector<64xi32>, view<8x8xi32>
  func.return
}

func.def target(@target) @store_nested(%value: vector<64xi32>, %output: buffer, %base_argument: offset) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.assume %base_argument [range(%base_argument, 0, 768), multiple_of(%base_argument, 64)] : offset
  %parent = buffer.view %aligned[%base] : buffer -> view<16x8xi32>
  %view = view.subview %parent[8, 0] : view<16x8xi32> -> view<8x8xi32>
  %extent = index.constant 8 : index
  vector.fragment.store<result> %value, %view[0, 0] shape [%extent, %extent] : vector<64xi32>, view<8x8xi32>
  func.return
}

func.def target(@target) @store_private_f32(%value: vector<64xf32>) -> (f32) {
  %bytes = index.constant 512 : offset
  %output = buffer.alloca<private> align(64) %bytes : buffer
  %base = index.constant 256 : offset
  %view = buffer.view %output[%base] : buffer -> view<8x8xf32>
  %extent = index.constant 8 : index
  vector.fragment.store<result> %value, %view[0, 0] shape [%extent, %extent] : vector<64xf32>, view<8x8xf32>
  %first = view.load %view[0, 0] : view<8x8xf32> -> f32
  func.return %first : f32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @store_immediate(%value: reg<aie2p.mbms x4>) asm {
  %aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %39 = slice %value[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %39, %aligned, 256
  %40 = slice %value[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %40, %aligned, 320
  %41 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %41, %aligned, 384
  %42 = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %42, %aligned, 448
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @store_materialized(%value: reg<aie2p.mbms x4>) asm {
  %aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %45 = copy %aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %46 = mov.modifier.immediate 512
  %47 = paddb.modifier %45, %46
  %48 = slice %value[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %48, %47, 0
  %49 = slice %value[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %49, %47, 64
  %50 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %50, %47, 128
  %51 = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %51, %47, 192
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @store_dynamic(%value: reg<aie2p.mbms x4>, %base: reg<aie2p.er>) asm {
  %aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %55 = copy %aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %56 = mov.modifier %base
  %57 = paddb.modifier %55, %56
  %58 = slice %value[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %58, %57, 0
  %59 = slice %value[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %59, %57, 64
  %60 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %60, %57, 128
  %61 = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %61, %57, 192
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @store_nested(%value: reg<aie2p.mbms x4>, %base: reg<aie2p.er>) asm {
  %aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %65 = copy %aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %66 = mov.static-byte-offset 256
  %67 = add.nc %base, %66
  %68 = mov.modifier %67
  %69 = paddb.modifier %65, %68
  %70 = slice %value[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %70, %69, 0
  %71 = slice %value[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %71, %69, 64
  %72 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %72, %69, 128
  %73 = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %73, %69, 192
  return
}

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @store_private_f32(%value: reg<aie2p.mbms x4>) -> (reg<aie2p.er>) asm {
  %76 = storage {byte_alignment = 64, byte_length = 512} : low.storage<private>
  %output = storage_address %76 : low.storage<private> -> reg<aie2p.ep>
  %78 = slice %value[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %78, %output, 256
  %79 = slice %value[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %79, %output, 320
  %80 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %80, %output, 384
  %81 = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %81, %output, 448
  %82 = mov.static-address-index 256
  %first = lda.i32.index %output, %82
  return %first
}

// ====
// RUN: emit source-low output=none

aie2p.target<core> @target

func.def target(@target) @unaligned_store(%value: vector<64xi32>, %output: buffer) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.constant 4 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<8x8xi32>
  %extent = index.constant 8 : index
  // ERROR@+1: TARGET/003 {constraint_key="source_memory.minimum_alignment"}
  vector.fragment.store<result> %value, %view[0, 0] shape [%extent, %extent] : vector<64xi32>, view<8x8xi32>
  func.return
}

// ====
// RUN: emit source-low output=none

aie2p.target<core> @target

func.def target(@target) @strided_store(%value: vector<64xi32>, %output: buffer) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<8x8xi32, #encoding.layout.strided<strides=[16, 1]>>
  %extent = index.constant 8 : index
  // ERROR@+1: TARGET/003 {constraint_key="source_memory.address_layout"}
  vector.fragment.store<result> %value, %view[0, 0] shape [%extent, %extent] : vector<64xi32>, view<8x8xi32, #encoding.layout.strided<strides=[16, 1]>>
  func.return
}

