// Indexed vector elements preserve byte codes through integer promotion.
func.def @uniform_table(%input: buffer, %codebook: buffer, %position: index) -> (vector<4xi8>) {
  %aligned = buffer.assume.alignment %codebook {minimum_alignment = 64} : buffer
  %source, %table_source = buffer.assume.noalias %input, %aligned : buffer, buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<32x4xi8>
  %input_values = vector.load %source_view[%position, 0] : view<32x4xi8> -> vector<4xi8>
  %mask = vector.constant 15 : vector<4xi8>
  %indices = vector.andi %input_values, %mask : vector<4xi8>
  %table_view = buffer.view %table_source[%c0] : buffer -> view<16xi8>
  %table = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %values = vector.table.lookup %table[%indices] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  func.return %values : vector<4xi8>
}

