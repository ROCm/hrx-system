func.def @uniform_i8(%input: buffer) -> (vector<8xi8>) {
  %source = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<8xi8>
  %value = vector.load %source_view[0] : view<8xi8> -> vector<8xi8>
  %result = vector.addi %value, %value : vector<8xi8>
  func.return %result : vector<8xi8>
}

