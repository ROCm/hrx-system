// ====
// RUN: pass source-to-low,low-dce

// The encode is adjacent, but the raw store still needs the loaded BF16 value.
aie2p.target<core> @target

func.def target(@target) @shared_bfp_load_does_not_fuse(%source: buffer, %raw_output: buffer) -> (vector<72xi8>) {
  %source_aligned, %output_aligned = buffer.assume.alignment %source, %raw_output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<64xbf16>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<64xbf16>
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %loaded = vector.load %source_view[0] : view<64xbf16> -> vector<64xbf16>
  %encoded = vector.encode %loaded using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
  vector.store %loaded, %output_view[0] : vector<64xbf16>, view<64xbf16>
  func.return %encoded : vector<72xi8>
}

// ----
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @shared_bfp_load_does_not_fuse() -> (reg<aie2p.mexa>) asm {
  %source_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %14 = vlda.512.bf16x32 %source_view, 0
  %15 = vlda.512.bf16x32 %source_view, 64
  %loaded = concat(%14, %15) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %17 = slice %loaded[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %18 = vconv.fp32.bf16 %17
  %19 = slice %loaded[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %20 = vconv.fp32.bf16 %19
  %21 = concat(%18, %20) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  set.rounding 12
  %encoded = vconv.bfp16ebs8.fp32 %21
  %23 = slice %loaded[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  vst.512.bf16x32 %23, %output_view, 0
  %24 = slice %loaded[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  vst.512.bf16x32 %24, %output_view, 64
  return %encoded
}

