  %loaded = vector.load %source_view[0] : view<64xbf16> -> vector<64xbf16>
  vector.store %replacement, %source_view[0] : vector<32xbf16>, view<64xbf16>
  %encoded = vector.encode %loaded using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
