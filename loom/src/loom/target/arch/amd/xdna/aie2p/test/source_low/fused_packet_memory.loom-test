// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @load_extf_bf16x16(%source: buffer) -> (vector<16xf32>) {
  %source_aligned = buffer.assume.alignment %source {minimum_alignment = 32} : buffer
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<16xbf16>
  %loaded = vector.load %source_view[0] : view<16xbf16> -> vector<16xbf16>
  %converted = vector.extf %loaded : vector<16xbf16> to vector<16xf32>
  func.return %converted : vector<16xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @load_extf_bf16x16() -> (reg<aie2p.vec256 x2>) asm {
  %source_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %9 = vlda.convert.bf16x16.to.f32x16 %source_view, 0
  %converted = vmov.accumulator512.to.vector512 %9
  return %converted
}

