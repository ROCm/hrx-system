func.def target(@target) @load_encode_bfp(%source: buffer) -> (vector<72xi8>) {
  %source_aligned = buffer.assume.alignment %source {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<64xbf16>
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %loaded = vector.load %source_view[0] : view<64xbf16> -> vector<64xbf16>
  %encoded = vector.encode %loaded using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
  func.return %encoded : vector<72xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @load_encode_bfp() -> (reg<aie2p.mexa>) asm {
  %source_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %10 = vlda.convert.bf16x32.to.f32x32 %source_view, 0
  %11 = vlda.convert.bf16x32.to.f32x32 %source_view, 64
  %12 = concat(%10, %11) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  set.rounding 12
  %encoded = vconv.bfp16ebs8.fp32 %12
  return %encoded
}

