  %source_e5m2 = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %target_e5m2 = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %55 = lda.u8 %source_e5m2, 1
  %56 = lda.u8 %source_e5m2, 2
  %57 = lda.u8 %source_e5m2, 3
  st.s8 %55, %target_e5m2, 1
  st.s8 %56, %target_e5m2, 2
  st.s8 %57, %target_e5m2, 3
  %58 = lda.u8 %source_e5m2, 4
  %59 = lda.u8 %source_e5m2, 5
  %60 = lda.u8 %source_e5m2, 6
  st.s8 %58, %target_e5m2, 4
  st.s8 %59, %target_e5m2, 5
  st.s8 %60, %target_e5m2, 6
  %61 = lda.u8 %source_e5m2, 7
  %62 = mov.static-byte-offset 8
  %63 = mov.address-index %62
  %64 = lda.i8.index %source_e5m2, %63
  %65 = mov.static-byte-offset 9
  %66 = mov.address-index %65
  %67 = lda.i8.index %source_e5m2, %66
  st.s8 %61, %target_e5m2, 7
  st.i8.index %64, %target_e5m2, %63
  st.i8.index %67, %target_e5m2, %66
  return
}

