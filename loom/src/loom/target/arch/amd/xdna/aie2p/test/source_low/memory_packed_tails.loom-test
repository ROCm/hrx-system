// ====

// Captured bytes survive an aliasing write and a second volatile observation.
func.def @capture_byte_tail(%input: buffer, %output: buffer, %replacement_input: buffer) {
  %base = index.constant 0 : offset
  %next = index.constant 3 : offset
  %source = buffer.view %input[%base] : buffer -> view<3xi8>
  %before = buffer.view %output[%base] : buffer -> view<3xi8>
  %after = buffer.view %output[%next] : buffer -> view<3xi8>
  %captured = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  %replacement_view = buffer.view %replacement_input[%base] : buffer -> view<3xi8>
  %replacement = vector.load %replacement_view[0] : view<3xi8> -> vector<3xi8>
  vector.store<volatile> %replacement, %source[0] : vector<3xi8>, view<3xi8>
  %reloaded = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  vector.store %captured, %before[0] : vector<3xi8>, view<3xi8>
  vector.store %reloaded, %after[0] : vector<3xi8>, view<3xi8>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @capture_byte_tail() asm {
  %source = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %after = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %replacement_view = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %54 = lda.u8.volatile<volatile> %source, 0
  %55 = lda.u8.volatile<volatile> %source, 1
  %56 = lda.u8.volatile<volatile> %source, 2
  %57 = lda.u8 %replacement_view, 0
  %58 = lda.u8 %replacement_view, 1
  %59 = lda.u8 %replacement_view, 2
  st.s8.volatile<volatile> %57, %source, 0
  st.s8.volatile<volatile> %58, %source, 1
  st.s8.volatile<volatile> %59, %source, 2
  %60 = lda.u8.volatile<volatile> %source, 0
  %61 = lda.u8.volatile<volatile> %source, 1
  %62 = lda.u8.volatile<volatile> %source, 2
  st.s8 %54, %after, 0
  st.s8 %55, %after, 1
  st.s8 %56, %after, 2
  st.s8 %60, %after, 3
  st.s8 %61, %after, 4
  st.s8 %62, %after, 5
  return
}
