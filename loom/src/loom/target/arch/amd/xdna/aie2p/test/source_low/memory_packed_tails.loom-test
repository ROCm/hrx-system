  %value_integer = vector.load %source_integer[0] : view<7xi16> -> vector<7xi16>
  vector.store %value_integer, %target_integer[0] : vector<7xi16>, view<7xi16>
  %origin_half = index.constant 16 : offset
  %source_half = buffer.view %input[%origin_half] : buffer -> view<7xf16>
  %target_half = buffer.view %output[%origin_half] : buffer -> view<7xf16>
  %value_half = vector.load %source_half[0] : view<7xf16> -> vector<7xf16>
