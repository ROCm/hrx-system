// TEMPLATE: loom/src/loom/test/corpus/source_low/callable_returns.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Return representation depends on all paths, regardless of block layout.
func.def @return_loaded_or_argument(%input: buffer, %load: i1, %fallback: i32) -> (i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.cond_br %load, ^loaded, ^argument
^loaded:
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
^argument:
  func.return %fallback : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @return_loaded_or_argument(%load: reg<aie2p.er>, %fallback: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  low.cond_br %load, ^loaded, ^argument : reg<aie2p.er>
^loaded:
  %value = lda %view, 0
  return %value
^argument:
  return %fallback
}

