// A non-square rank-three result uses the same row-major full and partial
// packets as its flat carrier instead of falling back to scalar assembly.
func.def @shaped_partial_carrier(%table: vector<4xi16>, %indices: vector<2x2x10xi16>) -> (vector<2x2x10xi16>) {
  %result = vector.table.lookup %table[%indices] : vector<4xi16>, vector<2x2x10xi16> -> vector<2x2x10xi16>
