// ====

// A uniform double-word lookup is one native indexed broadcast.
func.def @i64_uniform_table(%table: vector<8xi64>) -> (vector<8xi64>) {
  %indices = vector.constant 7 : vector<8xi8>
  %result = vector.table.lookup %table[%indices] : vector<8xi64>, vector<8xi8> -> vector<8xi64>
  func.return %result : vector<8xi64>
}

// ----
