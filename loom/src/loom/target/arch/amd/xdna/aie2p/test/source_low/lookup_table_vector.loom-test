CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Five double-word result lanes remain in one packed selector even when scalar
// assembly would use fewer estimated instructions.
func.def @i64_five_lane_selection(%table: vector<2xi64>, %indices: vector<5xi8>) -> (vector<5xi64>) {
  %result = vector.table.lookup %table[%indices] : vector<2xi64>, vector<5xi8> -> vector<5xi64>
  func.return %result : vector<5xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64_five_lane_selection(%table: reg<aie2p.vec256 x2>, %indices: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %16 = mov.short 0
  %17 = vbcst.8 %16
  %18 = mov.short 1
  %19 = vbcst.8 %18
  %20 = vband %indices, %19
  %21 = vlt.u8x64 %17, %20
  %22 = vextbcst.64 %table, 0
  %23 = vextbcst.64 %table, 1
  %24 = mov.short 255
  %25 = predicate.mask.low32 %21, %24
  %26 = mov.short 4
  %27 = lshl %25, %26
  %28 = or %25, %27
  %29 = mov.i32 3855
  %30 = and %28, %29
  %31 = mov.short 2
  %32 = lshl %30, %31
  %33 = or %30, %32
  %34 = mov.i32 13107
  %35 = and %33, %34
  %37 = lshl %35, %18
  %38 = or %35, %37
  %39 = mov.i32 21845
  %40 = and %38, %39
  %41 = lshl %40, %18
  %42 = or %40, %41
  %43 = copy %42 : reg<aie2p.er> -> reg<aie2p.ers16>
  %result = vsel.32 %22, %23, %43
  return %result
}

// ====

// Floating-point payload bits and a multidimensional logical shape use the
// same pair selector without conversion or scalar assembly.
func.def @shaped_f64_table(%table: vector<2xf64>, %indices: vector<2x4xi16>) -> (vector<2x4xf64>) {
  %result = vector.table.lookup %table[%indices] : vector<2xf64>, vector<2x4xi16> -> vector<2x4xf64>
  func.return %result : vector<2x4xf64>
}

// ----
CHECK: * = vextbcst.64 %table, 0
CHECK: * = vextbcst.64 %table, 1
CHECK: %result = vsel.32 *
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

// A 1024-bit result is split into two native pair-selection packets and then
// restored through the ordinary four-unit vector carrier.
func.def @wide_i64_table(%table: vector<2xi64>, %indices: vector<16xi8>) -> (vector<16xi64>) {
  %result = vector.table.lookup %table[%indices] : vector<2xi64>, vector<16xi8> -> vector<16xi64>
  func.return %result : vector<16xi64>
}

// ----
CHECK: * = vsel.32 *
CHECK: %result = concat(*
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

// Halfword indices use packed predicates for every table level.
func.def @i16_narrow_index_selection(%table: vector<9xi16>, %indices: vector<8xi16>) -> (vector<8xi16>) {
  %result = vector.table.lookup %table[%indices] : vector<9xi16>, vector<8xi16> -> vector<8xi16>
