CHECK: * = vlt.u8x64*
CHECK: * = vsel.32*
CHECK: %result = concat(*
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

// Uniform specialization survives packetization and shares one native table
// broadcast across both result carriers.
func.def @uniform_wide(%table: vector<4xi8>) -> (vector<128xi8>) {
  %indices = vector.constant 3 : vector<128xi8>
  %result = vector.table.lookup %table[%indices] : vector<4xi8>, vector<128xi8> -> vector<128xi8>
  func.return %result : vector<128xi8>
}

// ----
CHECK: * = vextbcst.8 %table, 3
CHECK: %result = concat(*
CHECK-NOT: * = vsel.*
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

// A write between the source read and lookup keeps both index packets at the
// authored observation point instead of replaying the load after the write.
func.def @preserved_index_snapshot(%source: buffer, %table: vector<4xi8>, %replacement: i16) -> (vector<64xi8>) {
  %source_local = buffer.assume.memory_space<workgroup> %source : buffer
  %source_aligned = buffer.assume.alignment %source_local {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<64xi16>
  %indices = vector.load %source_view[0] : view<64xi16> -> vector<64xi16>
  view.store %replacement, %source_view[0] : i16, view<64xi16>
  %result = vector.table.lookup %table[%indices] : vector<4xi8>, vector<64xi16> -> vector<64xi8>
  func.return %result : vector<64xi8>
}

// ----
CHECK: * = vlda.512.i16x32 %source_view, 0
CHECK: * = vlda.512.i16x32 %source_view, 64
CHECK: st.s16 %replacement, %source_view, 0
CHECK: * = vlt.u16x32.*
CHECK: %result = concat(*
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

// A widening producer consumes captured halfwords packet by packet, so its
// full 1024-bit word result never needs a physical carrier.
func.def @converted_i32_indices(%table: vector<4xi16>, %packed: vector<32xi16>) -> (vector<32xi16>) {
  %indices = vector.extui %packed : vector<32xi16> to vector<32xi32>
  %result = vector.table.lookup %table[%indices] : vector<4xi16>, vector<32xi32> -> vector<32xi16>
  func.return %result : vector<32xi16>
}

// ----
CHECK: * = slice %packed[0] *
CHECK: * = vups.2x.w-to-b.unsigned *
CHECK: * = vlt.u32x16.*
CHECK: * = vshift %packed, %packed, *
CHECK: * = vups.2x.w-to-b.unsigned *
CHECK: * = vlt.u32x16.*
CHECK: %result = concat(*
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*
