// ----
CHECK: * = vextbcst.16 %table, 0
CHECK: %result = vsel.16*
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

// Word indices retain predicate completion without switching the payload to
// scalar extraction and insertion.
func.def @i16_word_index_selection(%table: vector<9xi16>, %indices: vector<8xi32>) -> (vector<8xi16>) {
  %result = vector.table.lookup %table[%indices] : vector<9xi16>, vector<8xi32> -> vector<8xi16>
  func.return %result : vector<8xi16>
}

// ----
CHECK: * = vlt.u32x16.el.low32 *
CHECK: * = predicate.complete.zero.high32 *
CHECK: * = vextbcst.16 %table, 0
CHECK: * = vextbcst.16 %table, 8
CHECK: %result = vsel.16.mask64 *
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Double-word indices narrow once to the native word comparison carrier. The
// table extent makes every defined index exactly representable after narrowing.
func.def @i64_index_selection(%table: vector<3xf32>, %indices: vector<2xi64>) -> (vector<2xf32>) {
  %result = vector.table.lookup %table[%indices] : vector<3xf32>, vector<2xi64> -> vector<2xf32>
  func.return %result : vector<2xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64_index_selection(%table: reg<aie2p.vec256 x2>, %indices: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %23 = mova.i32 4
  %24 = vshuffle %indices, %indices, %23
  %25 = mov.short 0
  %26 = vbcst.32 %25
  %27 = mov.short 1
  %28 = vbcst.32 %27
  %29 = vband %24, %28
  %30 = vlt.u32x16.el.low32 %26, %29
  %31 = predicate.complete.zero.high32 %30, 0
  %32 = mov.short 2
  %33 = vbcst.32 %32
  %34 = vband %24, %33
  %35 = vlt.u32x16.el.low32 %26, %34
  %36 = predicate.complete.zero.high32 %35, 0
  %37 = vextbcst.32 %table, 0
  %38 = vextbcst.32 %table, 1
  %39 = vsel.32.mask64 %37, %38, %31
  %40 = vextbcst.32 %table, 2
  %result = vsel.32.mask64 %39, %40, %36
  return %result
}

// ====

// The largest double-word index and result carriers split into native packets,
// narrow each index packet, and retain the accumulator result carrier.
