// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

// A full byte table stays in one vector carrier and selects all result lanes
// through packed index-bit predicates.
func.def @i8_full_table(%table: vector<64xi8>, %indices: vector<64xi8>) -> (vector<64xi8>) {
  %result = vector.table.lookup %table[%indices] : vector<64xi8>, vector<64xi8> -> vector<64xi8>
  func.return %result : vector<64xi8>
}

// ----
CHECK: * = vband %indices, *
CHECK: * = vlt.u8x64 *, *
CHECK: * = vextbcst.8 %table, 0
CHECK: * = vextbcst.8 %table, 63
CHECK: %result = vsel.8 *
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*
CHECK-NOT: * = vextbcst.8 %table, 64

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Predicate table bits widen once to byte lanes so native indexed broadcasts
// can feed the ordinary bit-selection tree.
func.def @predicate_table(%table: vector<2xi1>, %indices: vector<4xi8>) -> (vector<4xi1>) {
  %result = vector.table.lookup %table[%indices] : vector<2xi1>, vector<4xi8> -> vector<4xi1>
  func.return %result : vector<4xi1>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @predicate_table(%table: reg<aie2p.elpredicate>, %indices: reg<aie2p.vec256 x2>) -> (reg<aie2p.elpredicate>) asm {
  %22 = mov.short 1
  %23 = vbcst.8 %22
  %24 = mov.short 0
  %25 = vbcst.8 %24
  %26 = vsel.8 %25, %23, %table
  %31 = vband %indices, %23
  %32 = vlt.u8x64 %25, %31
  %33 = vextbcst.8 %26, 0
  %34 = vextbcst.8 %26, 1
  %35 = vsel.8 %33, %34, %32
  %result = vlt.u8x64 %25, %35
  return %result
}

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// The first bit in the second predicate packet remains a single native
// broadcast after the packet widens to bytes.
func.def @predicate_table_high_uniform(%table: vector<65xi1>) -> (vector<64xi1>) {
  %indices = vector.constant 64 : vector<64xi8>
  %result = vector.table.lookup %table[%indices] : vector<65xi1>, vector<64xi8> -> vector<64xi1>
  func.return %result : vector<64xi1>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @predicate_table_high_uniform(%table: reg<aie2p.elpredicate x2>) -> (reg<aie2p.elpredicate>) asm {
  %17 = slice %table[1] : reg<aie2p.elpredicate x2> -> reg<aie2p.elpredicate>
  %18 = mov.short 1
  %19 = vbcst.8 %18
  %20 = mov.short 0
  %21 = vbcst.8 %20
  %22 = vsel.8 %21, %19, %17
  %25 = vextbcst.8 %22, 0
  %result = vlt.u8x64 %21, %25
  return %result
}

// ====

// A two-packet predicate result keeps both the indices and selected bits in
// packed carriers.
func.def @predicate_table_wide_result(%table: vector<2xi1>, %indices: vector<128xi8>) -> (vector<128xi1>) {
  %result = vector.table.lookup %table[%indices] : vector<2xi1>, vector<128xi8> -> vector<128xi1>
  func.return %result : vector<128xi1>
}

// ----
CHECK: * = slice %indices[0] *
CHECK: * = slice %indices[2] *
CHECK: %result = concat(*
CHECK-NOT: * = vinsert.*

