// Independent load ports coissue; the add and store wait for their operands.
// RUN: emit low-schedule-json @vector_add strategy=resource-stall

low.func.def target<amd.xdna.aie2p.core> @vector_add(%lhs_ptr: reg<aie2p.ep>, %rhs_ptr: reg<aie2p.ep>, %out_ptr: reg<aie2p.ep>) asm {
  %lhs = vlda.512.i32x16 %lhs_ptr, 0
  %rhs = vldb.512.i32x16 %rhs_ptr, 0
  %sum = vadd.32 %rhs, %lhs
  vst.512.i32x16 %sum, %out_ptr, 0
  return
}

