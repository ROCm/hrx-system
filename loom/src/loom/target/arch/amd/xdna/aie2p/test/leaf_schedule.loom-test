// ====

// A release retains load/store and lock timing while independent scalar work
// crosses it to fill the load's latency.
// RUN: with-checks emit low-schedule-json @release_exposes_independent_work strategy=resource-stall

low.func.def target<amd.xdna.aie2p.core> @release_exposes_independent_work(%lock_value: reg<aie2p.er>, %source: reg<aie2p.ep>, %output: reg<aie2p.ep>, %seed: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %value = vlda.512.i32x16 %source, 0
  rel %lock_value, 5
  %next = add %seed, 1
  vst.512.i32x16 %value, %output, 0
  return %next
}

