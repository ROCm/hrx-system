// ====

// A load drains before the successor lock operation.
// RUN: emit low-schedule-json @load_then_lock_edge strategy=source

low.func.def target<amd.xdna.aie2p.core> @load_then_lock_edge(%lock_value: reg<aie2p.er>, %source: reg<aie2p.ep>) asm {
  %value = vlda.acc %source, 0
  low.br ^consume
^consume:
  acq %lock_value, 5
  return
}

