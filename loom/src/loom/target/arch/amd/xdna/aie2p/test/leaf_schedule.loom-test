// ====

// Five rematerializable shifts share four es registers. Independent SRS
// packets retain their configuration reads but have no ordering through
// unread sticky overflow status. Later shifts can issue beside earlier
// consumers without opening all five shift live ranges.
// RUN: emit low-schedule-query @interleaved_shift_consumers strategy=resource-stall order=1,2,3,4,5,7,8,9,10,11 kind=state consumer=7,8,9,10,11 timing=0:7

low.func.def target<amd.xdna.aie2p.core> @interleaved_shift_consumers(%padding: reg<aie2p.vec256>, %value: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256>, reg<aie2p.vec256>, reg<aie2p.vec256>, reg<aie2p.vec256>, reg<aie2p.vec256>, reg<aie2p.vec256>) asm {
  set.srs-mode 0
  %shift0 = mov.shift 24
  %shift1 = mov.shift 20
  %shift2 = mov.shift 23
  %shift3 = mov.shift 22
  %shift4 = mov.shift 21
  %accumulator = vmov.vector512.to.accumulator512 %value
  %result0 = vsrs.2x.b-to-w.unsigned %accumulator, %shift0
  %result1 = vsrs.2x.b-to-w.signed %accumulator, %shift1
  %result2 = vsrs.2x.b-to-w.unsigned %accumulator, %shift2
  %result3 = vsrs.2x.b-to-w.unsigned %accumulator, %shift3
  %result4 = vsrs.2x.b-to-w.unsigned %accumulator, %shift4
  return %padding, %result0, %result1, %result2, %result3, %result4
}

