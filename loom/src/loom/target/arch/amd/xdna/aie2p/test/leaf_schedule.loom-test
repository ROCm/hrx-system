  %later_column0_transposed_upper = vshuffle %later_column0_lower, %later_column0_upper, %transpose_upper_mode
  %later_column1_transposed_lower = vshuffle %later_column1_lower, %later_column1_upper, %transpose_lower_mode
  %later_column1_transposed_upper = vshuffle %later_column1_lower, %later_column1_upper, %transpose_upper_mode
  %later_row0_lower = vlda.convert.bf16x32.to.f32x32 %first_row_cursor, 128
  %later_row0_upper = vlda.convert.bf16x32.to.f32x32 %first_row_cursor, 192
  %later_row0_float = concat(%later_row0_lower, %later_row0_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %later_lhs0 = vconv.bfp16ebs8.fp32 %later_row0_float
  %later_row1_lower = vlda.convert.bf16x32.to.f32x32 %second_row_cursor, 128
  %later_row1_upper = vlda.convert.bf16x32.to.f32x32 %second_row_cursor, 192
  %later_row1_float = concat(%later_row1_lower, %later_row1_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %later_lhs1 = vconv.bfp16ebs8.fp32 %later_row1_float
  %later_column0_float_lower = vconv.fp32.bf16 %later_column0_transposed_lower
  %later_column0_float_upper = vconv.fp32.bf16 %later_column0_transposed_upper
  %later_column0_float = concat(%later_column0_float_lower, %later_column0_float_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %later_rhs0 = vconv.bfp16ebs8.fp32 %later_column0_float
  %later_column1_float_lower = vconv.fp32.bf16 %later_column1_transposed_lower
  %later_column1_float_upper = vconv.fp32.bf16 %later_column1_transposed_upper
  %later_column1_float = concat(%later_column1_float_lower, %later_column1_float_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %later_rhs1 = vconv.bfp16ebs8.fp32 %later_column1_float
  %later_next00 = mma.bfp16ebs8.m8n8k8 %next00, %later_lhs0, %later_rhs0, %matrix_control
  %later_next01 = mma.bfp16ebs8.m8n8k8 %next01, %later_lhs0, %later_rhs1, %matrix_control
  %later_next10 = mma.bfp16ebs8.m8n8k8 %next10, %later_lhs1, %later_rhs0, %matrix_control
  %later_next11 = mma.bfp16ebs8.m8n8k8 %next11, %later_lhs1, %later_rhs1, %matrix_control
  %next_reduction_cell = add.rr %reduction_cell, %cells_per_iteration
  %next_first_row = padda %first_row_cursor, 256
  %next_second_row = padda %second_row_cursor, 256
  %next_column_cell = padda %column_cursor, 256
  %next_column_pair = padda %next_column_cell, 256
  low.br ^loop(%next_reduction_cell: reg<aie2p.er>, %later_next00: reg<aie2p.mbms x4>, %later_next01: reg<aie2p.mbms x4>, %later_next10: reg<aie2p.mbms x4>, %later_next11: reg<aie2p.mbms x4>, %next_first_row: reg<aie2p.ep>, %next_second_row: reg<aie2p.ep>, %next_column_pair: reg<aie2p.ep>)
^finish:
  return %carried00, %carried01, %carried10, %carried11
}

