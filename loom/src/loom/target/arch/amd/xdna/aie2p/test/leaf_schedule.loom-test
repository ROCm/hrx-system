// ====

// Four loaded-C fragments leave one DM register for encoding scratch. Ready
// BF16 inputs can encode before the shuffle-dependent inputs: unread sticky
// conversion flags do not force their scratch exits into source order.
// Both encoded operands remain live for the four loaded-C matrix updates.
// RUN: emit aie2p-leaf @bfp_encode_read_ahead_four_accumulators report=emission

low.func.def target<amd.xdna.aie2p.core> @bfp_encode_read_ahead_four_accumulators(%first_row: reg<aie2p.vec256 x2>, %second_row: reg<aie2p.vec256 x2>, %ready_lower_bf16: reg<aie2p.vec256 x2>, %ready_upper_bf16: reg<aie2p.vec256 x2>, %accumulator00: reg<aie2p.mbms x4>, %accumulator01: reg<aie2p.mbms x4>, %accumulator10: reg<aie2p.mbms x4>, %accumulator11: reg<aie2p.mbms x4>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  %transpose_lower_mode = mova.i32 52
  %shuffled_lower_bf16 = vshuffle %first_row, %second_row, %transpose_lower_mode
  %transpose_upper_mode = mova.i32 53
  %shuffled_upper_bf16 = vshuffle %first_row, %second_row, %transpose_upper_mode
  %shuffled_lower = vconv.fp32.bf16 %shuffled_lower_bf16
  %shuffled_upper = vconv.fp32.bf16 %shuffled_upper_bf16
  %shuffled_float = concat(%shuffled_lower, %shuffled_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  set.rounding 12
  %shuffled_operand = vconv.bfp16ebs8.fp32 %shuffled_float
  %ready_lower = vconv.fp32.bf16 %ready_lower_bf16
  %ready_upper = vconv.fp32.bf16 %ready_upper_bf16
  %ready_float = concat(%ready_lower, %ready_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %ready_operand = vconv.bfp16ebs8.fp32 %ready_float
  %matrix_control = mova.i32 780
  %updated_accumulator00 = mma.bfp16ebs8.m8n8k8 %accumulator00, %shuffled_operand, %ready_operand, %matrix_control
  %updated_accumulator01 = mma.bfp16ebs8.m8n8k8 %accumulator01, %shuffled_operand, %ready_operand, %matrix_control
  %updated_accumulator10 = mma.bfp16ebs8.m8n8k8 %accumulator10, %shuffled_operand, %ready_operand, %matrix_control
  %updated_accumulator11 = mma.bfp16ebs8.m8n8k8 %accumulator11, %shuffled_operand, %ready_operand, %matrix_control
  return %updated_accumulator00, %updated_accumulator01, %updated_accumulator10, %updated_accumulator11
}

