// ====

// Six X-sized BF16 inputs and six EX/BFP inputs occupy the twelve shared X
// slots. Each transpose needs a new X while both source halves remain live.
// The independent matrix products release EX storage before the transposes
// can open their results. Complete products and encodings remain observable
// through the native Low function results.
// RUN: emit aie2p-leaf @shared_x_packing report=code

low.func.def target<amd.xdna.aie2p.core> @shared_x_packing(%first_lower_bf16: reg<aie2p.vec256 x2>, %first_upper_bf16: reg<aie2p.vec256 x2>, %second_lower_bf16: reg<aie2p.vec256 x2>, %second_upper_bf16: reg<aie2p.vec256 x2>, %third_lower_bf16: reg<aie2p.vec256 x2>, %third_upper_bf16: reg<aie2p.vec256 x2>, %first_lhs: reg<aie2p.mexa>, %first_rhs: reg<aie2p.mexa>, %second_lhs: reg<aie2p.mexa>, %second_rhs: reg<aie2p.mexa>, %third_lhs: reg<aie2p.mexa>, %third_rhs: reg<aie2p.mexa>) -> (reg<aie2p.mexa>, reg<aie2p.mexa>, reg<aie2p.mexa>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  %transpose_lower_mode = mova.i32 52
  %transpose_upper_mode = mova.i32 53
  set.rounding 12
  %first_transposed_lower = vshuffle %first_lower_bf16, %first_upper_bf16, %transpose_lower_mode
  %first_transposed_upper = vshuffle %first_lower_bf16, %first_upper_bf16, %transpose_upper_mode
  %first_float_lower = vconv.fp32.bf16 %first_transposed_lower
  %first_float_upper = vconv.fp32.bf16 %first_transposed_upper
  %first_float = concat(%first_float_lower, %first_float_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %first_encoded = vconv.bfp16ebs8.fp32 %first_float
  %second_transposed_lower = vshuffle %second_lower_bf16, %second_upper_bf16, %transpose_lower_mode
  %second_transposed_upper = vshuffle %second_lower_bf16, %second_upper_bf16, %transpose_upper_mode
  %second_float_lower = vconv.fp32.bf16 %second_transposed_lower
  %second_float_upper = vconv.fp32.bf16 %second_transposed_upper
  %second_float = concat(%second_float_lower, %second_float_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %second_encoded = vconv.bfp16ebs8.fp32 %second_float
  %third_transposed_lower = vshuffle %third_lower_bf16, %third_upper_bf16, %transpose_lower_mode
  %third_transposed_upper = vshuffle %third_lower_bf16, %third_upper_bf16, %transpose_upper_mode
  %third_float_lower = vconv.fp32.bf16 %third_transposed_lower
  %third_float_upper = vconv.fp32.bf16 %third_transposed_upper
  %third_float = concat(%third_float_lower, %third_float_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %third_encoded = vconv.bfp16ebs8.fp32 %third_float
  %matrix_control = mova.i32 780
  %first_product = mmul.bfp16ebs8.m8n8k8 %first_lhs, %first_rhs, %matrix_control
  %second_product = mmul.bfp16ebs8.m8n8k8 %second_lhs, %second_rhs, %matrix_control
  %third_product = mmul.bfp16ebs8.m8n8k8 %third_lhs, %third_rhs, %matrix_control
  return %first_encoded, %second_encoded, %third_encoded, %first_product, %second_product, %third_product
}

