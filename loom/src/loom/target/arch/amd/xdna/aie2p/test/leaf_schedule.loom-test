// Scheduling selects independent load ports; the add and store wait for their
// operands. Both loads initially name port A.
// RUN: with-checks emit low-schedule-json @vector_add strategy=resource-stall

low.func.def target<amd.xdna.aie2p.core> @vector_add(%lhs_ptr: reg<aie2p.ep>, %rhs_ptr: reg<aie2p.ep>, %out_ptr: reg<aie2p.ep>) asm {
  %lhs = vlda.512.i32x16 %lhs_ptr, 0
  %rhs = vlda.512.i32x16 %rhs_ptr, 0
  %sum = vadd.32 %rhs, %lhs
  vst.512.i32x16 %sum, %out_ptr, 0
  return
}

// ----
CHECK: *"index":0,"block":0,"source_ordinal":0,"scheduled_ordinal":0,"issue_cycle":0,*
CHECK: *"index":1,"block":0,"source_ordinal":1,"scheduled_ordinal":1,"issue_cycle":0,*
CHECK: *"index":2,"block":0,"source_ordinal":2,"scheduled_ordinal":2,"issue_cycle":7,*
CHECK: *"index":3,"block":0,"source_ordinal":3,"scheduled_ordinal":3,"issue_cycle":9,*

// ====

// Lock acquires and the following load observe four-cycle memory separation.
// RUN: with-checks emit low-schedule-json @lock_then_load strategy=source

low.func.def target<amd.xdna.aie2p.core> @lock_then_load(%lock_value: reg<aie2p.er>, %source: reg<aie2p.ep>) asm {
  acq %lock_value, 5
  acq %lock_value, 37
  %value = vlda.acc %source, 0
  return
}

// ----
CHECK: *"index":0,"block":0,"source_ordinal":0,"scheduled_ordinal":0,"issue_cycle":0,*
CHECK: *"index":1,"block":0,"source_ordinal":1,"scheduled_ordinal":1,"issue_cycle":4,*
CHECK: *"index":2,"block":0,"source_ordinal":2,"scheduled_ordinal":2,"issue_cycle":8,*

// ====

// An acquire drains before the successor memory operation.
// RUN: with-checks emit low-schedule-json @lock_then_load_edge strategy=source

low.func.def target<amd.xdna.aie2p.core> @lock_then_load_edge(%lock_value: reg<aie2p.er>, %source: reg<aie2p.ep>) asm {
  acq %lock_value, 5
  low.br ^consume
^consume:
  %value = vlda.acc %source, 0
  return
}

// ----
CHECK: *"index":1,"block":0,"source_ordinal":1,"scheduled_ordinal":1,"issue_cycle":4,*
CHECK: *"index":2,"block":1,"source_ordinal":2,"scheduled_ordinal":0,"issue_cycle":0,*

// ====

// A load drains before the successor lock operation.
// RUN: with-checks emit low-schedule-json @load_then_lock_edge strategy=source

low.func.def target<amd.xdna.aie2p.core> @load_then_lock_edge(%lock_value: reg<aie2p.er>, %source: reg<aie2p.ep>) asm {
  %value = vlda.acc %source, 0
  low.br ^consume
^consume:
  acq %lock_value, 5
  return
}

// ----
CHECK: *"index":1,"block":0,"source_ordinal":1,"scheduled_ordinal":1,"issue_cycle":4,*
CHECK: *"index":2,"block":1,"source_ordinal":2,"scheduled_ordinal":0,"issue_cycle":0,*

// ====

// Lock timing is preserved across the control-flow boundary.
// RUN: with-checks emit low-schedule-json @lock_then_lock_edge strategy=source

low.func.def target<amd.xdna.aie2p.core> @lock_then_lock_edge(%lock_value: reg<aie2p.er>) asm {
  acq %lock_value, 5
  low.br ^consume
^consume:
  rel %lock_value, 37
  return
}

// ----
CHECK: *"index":1,"block":0,"source_ordinal":1,"scheduled_ordinal":1,"issue_cycle":4,*
CHECK: *"index":2,"block":1,"source_ordinal":2,"scheduled_ordinal":0,"issue_cycle":0,*

// ====

// A release retains load/store and lock timing while independent scalar work
// crosses it to fill the load's latency.
// RUN: with-checks emit low-schedule-json @release_exposes_independent_work strategy=resource-stall

low.func.def target<amd.xdna.aie2p.core> @release_exposes_independent_work(%lock_value: reg<aie2p.er>, %source: reg<aie2p.ep>, %output: reg<aie2p.ep>, %seed: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %value = vlda.512.i32x16 %source, 0
  rel %lock_value, 5
  %next = add %seed, 1
  vst.512.i32x16 %value, %output, 0
  return %next
}

