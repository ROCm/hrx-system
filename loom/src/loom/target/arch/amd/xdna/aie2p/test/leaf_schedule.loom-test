// ====

// Lock acquires and the following load observe four-cycle memory separation.
// RUN: emit low-schedule-json @lock_then_load strategy=source

low.func.def target<amd.xdna.aie2p.core> @lock_then_load(%lock_value: reg<aie2p.er>, %source: reg<aie2p.ep>) asm {
  acq %lock_value, 5
  acq %lock_value, 37
  acq %lock_value, 49
  acq %lock_value, 50
  %value = vlda.acc %source, 0
  return
