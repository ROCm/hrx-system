  %later_row0_upper = vlda.convert.bf16x32.to.f32x32 %first_row_cursor, 192
  %later_row0_float = concat(%later_row0_lower, %later_row0_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %later_lhs0 = vconv.bfp16ebs8.fp32 %later_row0_float
  %later_row1_lower = vlda.convert.bf16x32.to.f32x32 %second_row_cursor, 128
  %later_row1_upper = vlda.convert.bf16x32.to.f32x32 %second_row_cursor, 192
