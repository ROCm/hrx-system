// RUN: emit aie2p-array-plan @retained_x_record_array

// Select the last retained record: 16 rows of 128 bytes, 1536 bytes apart.
// Its logical payload is 2048 bytes and its footprint is 23168 bytes.
// The 256-byte prefix plus 1408-byte slot displacement gives origin 1664.

aie2p.target<array> @retained_x_record_array_target

aie2p.target<core> @retained_x_record_core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@retained_x_record_array_target) abi(array_program) @retained_x_record_array() asm {
  %lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %binding_offset = constant.u64 1664 : reg<aie2p.array.offset : offset>

  %group = group %lanes
  %worker = worker %group, %lane, @observe_record_edges
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x1x16x64xbf16, #encoding.layout.strided<strides=[0, 0, 768, 1]>>>
  %input_lane = partition.sender %input_sender, %binding_offset, %lane, %lanes : reg<aie2p.array.sender : tile<16x64xbf16>>
  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<16x64xbf16>>
  %worker_output = sender %worker, 1 : reg<aie2p.array.sender : tile<1xi32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %input_channel = channel %input_lane, %worker_input, %capacity, %records : reg<aie2p.array.channel : tile<16x64xbf16>>
  %output_channel = channel %worker_output, %output_receiver, %capacity, %records : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %column, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@retained_x_record_core_target) abi(object_function) @observe_record_edges() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %first = lda %input, 0
  %last_offset = mov.i32 2044
  %last_index = mov.address-index %last_offset
  %last = lda.i32.index %input, %last_index
  %sum = add.rr %first, %last
  st %sum, %output, 0
  return
}

