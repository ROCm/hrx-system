// ====
// RUN: emit aie2p-array-plan @padded_record_output_array

// Input and output bindings choose independent layouts: input records start
// 128 bytes apart with strided rows; output words start 32 bytes apart.
// Neither stream copies the unused padding between addressed elements.

aie2p.target<array> @padded_record_output_array_target

aie2p.target<core> @padded_record_output_core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@padded_record_output_array_target) abi(array_program) @padded_record_output_array() asm {
  %lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 12 : reg<aie2p.array.scalar : index>
  %column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %binding_offset = constant.u64 256 : reg<aie2p.array.offset : offset>

  %group = group %lanes
  %worker = worker %group, %lane, @observe_record_edges
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x12x16x64xbf16, #encoding.layout.strided<strides=[0, 64, 768, 1]>>>
  %input_lane = partition.sender %input_sender, %binding_offset, %lane, %lanes : reg<aie2p.array.sender : tile<16x64xbf16>>
  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<16x64xbf16>>
  %worker_output = sender %worker, 1 : reg<aie2p.array.sender : tile<1xi32>>
  %output_offset = constant.u64 128 : reg<aie2p.array.offset : offset>
  %output_storage = receiver %output, 0 : reg<aie2p.array.receiver : tile<1x12x1xi32, #encoding.layout.strided<strides=[0, 8, 1]>>>
  %output_receiver = partition.receiver %output_storage, %output_offset, %lane, %lanes : reg<aie2p.array.receiver : tile<1xi32>>
  %input_channel = channel %input_lane, %worker_input, %capacity, %records : reg<aie2p.array.channel : tile<16x64xbf16>>
  %output_channel = channel %worker_output, %output_receiver, %capacity, %records : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %column, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@padded_record_output_core_target) abi(object_function) @observe_record_edges() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %first = lda %input, 0
  %last_offset = mov.i32 2044
  %last_index = mov.address-index %last_offset
  %last = lda.i32.index %input, %last_index
  %sum = add.rr %first, %last
  st %sum, %output, 0
  return
}

