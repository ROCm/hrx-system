// RUN: emit aie2p-array-plan @retained_x_stream_array

// Twelve retained records share a row-major allocation. The logical slot
// axis remains outermost in the DMA walk; each worker receives a dense record.

aie2p.target<array> @retained_x_stream_array_target

aie2p.target<core> @retained_x_stream_core_target

