// RUN: with-checks compile-report target=amd.xdna.aie2p:core legalize-math,dce,canonicalize,source-to-low,low-dce

// A BF16-authored approximate recipe admits the native AIE subnormal policy at
// its input, product, and result representation boundaries.
func.def @vector_bf16_logistic(%input: vector<16xbf16>) -> (vector<16xbf16>) {
  %result = vector.logisticf<afn> %input : vector<16xbf16>
  func.return %result : vector<16xbf16>
}

