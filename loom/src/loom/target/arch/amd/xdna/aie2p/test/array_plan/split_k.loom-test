// RUN: emit aie2p-array-plan @split_k_array

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @split_k_array() asm {
  %product_lanes = constant.u32 2 : reg<aie2p.array.scalar : index>
  %reducer_lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %product0_lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %product1_lane = constant.u32 1 : reg<aie2p.array.scalar : index>
  %partition_lanes = constant.u32 2 : reg<aie2p.array.scalar : index>
  %ring_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %record_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %array_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %product0_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %reducer_row = constant.u32 3 : reg<aie2p.array.scalar : index>
  %product1_row = constant.u32 4 : reg<aie2p.array.scalar : index>
  %binding_offset = constant.u64 0 : reg<aie2p.array.offset : offset>

  %products = group %product_lanes
  %reducers = group %reducer_lanes
  %product0 = worker %products, %product0_lane, @product_branch_bf16
  %product1 = worker %products, %product1_lane, @product_branch_bf16
  %reducer = worker %reducers, %product0_lane, @reduce_bias_f32

  %lhs = binding 0, "read"
  %rhs = binding 1, "read"
  %bias = binding 2, "read"
  %output = binding 3, "write"

  %lhs_tiles = sender %lhs, 0 : reg<aie2p.array.sender : tile<2x8xbf16>>
  %rhs_tiles = sender %rhs, 0 : reg<aie2p.array.sender : tile<2x8xbf16>>
  %bias_sender = sender %bias, 0 : reg<aie2p.array.sender : tile<8x8xf32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<8x8xf32>>

  %lhs0 = partition.sender %lhs_tiles, %binding_offset, %product0_lane, %partition_lanes : reg<aie2p.array.sender : tile<8xbf16>>
  %lhs1 = partition.sender %lhs_tiles, %binding_offset, %product1_lane, %partition_lanes : reg<aie2p.array.sender : tile<8xbf16>>
  %rhs0 = partition.sender %rhs_tiles, %binding_offset, %product0_lane, %partition_lanes : reg<aie2p.array.sender : tile<8xbf16>>
  %rhs1 = partition.sender %rhs_tiles, %binding_offset, %product1_lane, %partition_lanes : reg<aie2p.array.sender : tile<8xbf16>>

  %product0_lhs = receiver %product0, 0 : reg<aie2p.array.receiver : tile<8xbf16>>
  %product0_rhs = receiver %product0, 1 : reg<aie2p.array.receiver : tile<8xbf16>>
  %partial0 = sender %product0, 2 : reg<aie2p.array.sender : tile<8x8xf32>>
  %product1_lhs = receiver %product1, 0 : reg<aie2p.array.receiver : tile<8xbf16>>
  %product1_rhs = receiver %product1, 1 : reg<aie2p.array.receiver : tile<8xbf16>>
  %partial1 = sender %product1, 2 : reg<aie2p.array.sender : tile<8x8xf32>>
  %reduce_partial0 = receiver %reducer, 0 : reg<aie2p.array.receiver : tile<8x8xf32>>
  %reduce_partial1 = receiver %reducer, 1 : reg<aie2p.array.receiver : tile<8x8xf32>>
  %reduce_bias = receiver %reducer, 2 : reg<aie2p.array.receiver : tile<8x8xf32>>
  %reduce_output = sender %reducer, 3 : reg<aie2p.array.sender : tile<8x8xf32>>

  %lhs0_channel = channel %lhs0, %product0_lhs, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<8xbf16>>
  %rhs0_channel = channel %rhs0, %product0_rhs, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<8xbf16>>
  %lhs1_channel = channel %lhs1, %product1_lhs, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<8xbf16>>
  %rhs1_channel = channel %rhs1, %product1_rhs, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<8xbf16>>
  %bias_channel = channel %bias_sender, %reduce_bias, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<8x8xf32>>
  %output_channel = channel %reduce_output, %output_receiver, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<8x8xf32>>
  %partial0_channel = channel %partial0, %reduce_partial0, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<8x8xf32>>
  %partial1_channel = channel %partial1, %reduce_partial1, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<8x8xf32>>

  constrain.location %product0, %array_column, %product0_row
  constrain.location %reducer, %array_column, %reducer_row
  constrain.location %product1, %product1_lane, %product1_row
  return
}

func.def target(@core_target) @product_branch_bf16(%lhs: buffer, %rhs: buffer, %partial: buffer) {
  %lhs_aligned, %rhs_aligned, %partial_aligned = buffer.assume.alignment %lhs, %rhs, %partial {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<8xbf16>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<8xbf16>
  %partial_view = buffer.view %partial_aligned[%base] : buffer -> view<64xf32>
  %m = index.constant 8 : index
  %n = index.constant 8 : index
  %k = index.constant 1 : index
  %lhs_value = vector.load %lhs_view[0] : view<8xbf16> -> vector<8xbf16>
  %rhs_value = vector.load %rhs_view[0] : view<8xbf16> -> vector<8xbf16>
  %lhs_fragment = vector.fragment<lhs> %lhs_value shape [%m, %k] : vector<8xbf16>
  %rhs_fragment = vector.fragment<rhs> %rhs_value shape [%k, %n] : vector<8xbf16>
  %accumulator_init = vector.constant 0.0 : vector<64xf32>
  %accumulator_fragment = vector.fragment<init> %accumulator_init shape [%m, %n] : vector<64xf32>
  %product = vector.mma %lhs_fragment, %rhs_fragment, %accumulator_fragment : vector<8xbf16>, vector<8xbf16>, vector<64xf32>
  vector.store %product, %partial_view[0] : vector<64xf32>, view<64xf32>
  func.return
}

func.def target(@core_target) @reduce_bias_f32(%partial0: buffer, %partial1: buffer, %bias: buffer, %output: buffer) {
  %partial0_aligned, %partial1_aligned, %bias_aligned, %output_aligned = buffer.assume.alignment %partial0, %partial1, %bias, %output {minimum_alignment = 64} : buffer, buffer, buffer, buffer
  %base = index.constant 0 : offset
  %partial0_view = buffer.view %partial0_aligned[%base] : buffer -> view<64xf32>
  %partial1_view = buffer.view %partial1_aligned[%base] : buffer -> view<64xf32>
  %bias_view = buffer.view %bias_aligned[%base] : buffer -> view<64xf32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<64xf32>
  %partial0_value = vector.load %partial0_view[0] : view<64xf32> -> vector<64xf32>
  %partial1_value = vector.load %partial1_view[0] : view<64xf32> -> vector<64xf32>
  %bias_value = vector.load %bias_view[0] : view<64xf32> -> vector<64xf32>
  %sum = vector.addf %partial0_value, %partial1_value : vector<64xf32>
  %biased = vector.addf %sum, %bias_value : vector<64xf32>
  vector.store %biased, %output_view[0] : vector<64xf32>, view<64xf32>
  func.return
}

