low.func.def public retain target<amd.xdna.aie2p.array>(@multicast_array_target) abi(array_program) @multicast_array() asm {
  %worker_lanes = constant.u32 2 : reg<aie2p.array.scalar : index>
  %lane0 = constant.u32 0 : reg<aie2p.array.scalar : index>
  %lane1 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %partition_lanes = constant.u32 2 : reg<aie2p.array.scalar : index>
  %ring_capacity = constant.u32 1 : reg<aie2p.array.scalar : index>
  %record_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %binding_offset = constant.u64 0 : reg<aie2p.array.offset : offset>

  %workers = group %worker_lanes
  %worker0 = worker %workers, %lane0, @consume_two
  %worker1 = worker %workers, %lane1, @consume_two

  %input = binding 0, "read"
  %input_tiles = sender %input, 0 : reg<aie2p.array.sender : tile<2x4xi8>>
  %input0 = partition.sender %input_tiles, %binding_offset, %lane0, %partition_lanes : reg<aie2p.array.sender : tile<4xi8>>
  %input1 = partition.sender %input_tiles, %binding_offset, %lane1, %partition_lanes : reg<aie2p.array.sender : tile<4xi8>>

  %worker0_input0 = receiver %worker0, 0 : reg<aie2p.array.receiver : tile<4xi8>>
  %worker0_input1 = receiver %worker0, 1 : reg<aie2p.array.receiver : tile<4xi8>>
  %worker1_input0 = receiver %worker1, 0 : reg<aie2p.array.receiver : tile<4xi8>>
  %worker1_input1 = receiver %worker1, 1 : reg<aie2p.array.receiver : tile<4xi8>>

  %worker0_input0_channel = channel %input0, %worker0_input0, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<4xi8>>
  %worker0_input1_channel = channel %input1, %worker0_input1, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<4xi8>>
  %worker1_input0_channel = channel %input0, %worker1_input0, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<4xi8>>
  %worker1_input1_channel = channel %input1, %worker1_input1, %ring_capacity, %record_count : reg<aie2p.array.channel : tile<4xi8>>

  constrain.location %worker0, %lane0, %row
  constrain.location %worker1, %lane1, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@multicast_core_target) abi(object_function) @consume_two() asm {
  %input0 = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %input1 = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %lhs = lda.u8 %input0, 0
  %rhs = lda.u8 %input1, 0
  %sum = add.rr %lhs, %rhs
  st.s8 %sum, %input0, 0
  return
}

