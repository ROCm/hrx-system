// RUN: emit source-low @main target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11 output=low

// The first phase selects the physical entry context. The second phase calls a
// retained vector helper from its own outlined context. Its call must move to
// the entry context, retaining the aligned operand facts and native vector loads.
aie2p.target<array> @device {device_profile = "amd.xdna.strix_halo.17f0_11"}

func.def noinline @copy(%input: view<32xbf16>, %output: view<32xbf16>) {
  %value = vector.load %input[0] : view<32xbf16> -> vector<32xbf16>
  vector.store %value, %output[0] : vector<32xbf16>, view<32xbf16>
  func.return
}

pipeline.def @prefix() run(%storage: buffer) {
  %origin = index.constant 0 : offset
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %local = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %seed = scalar.constant 1 : i32
    view.store %seed, %local[0] : i32, view<1xi32>
  }
}

pipeline.def @compute() run(%storage: buffer) {
  %origin = index.constant 0 : offset
  %output_offset = index.constant 128 : offset
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %aligned = buffer.assume.alignment %storage {minimum_alignment = 64} : buffer
    %input = buffer.view %aligned[%origin] : buffer -> view<32xbf16>
    %output = buffer.view %aligned[%output_offset] : buffer -> view<32xbf16>
    func.call @copy(%input, %output) : (view<32xbf16>, view<32xbf16>)
  }
}

pipeline.def<kernel> public retain target(@device) @main() run() {
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 256 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  pipeline.serial {
    pipeline.compose @prefix(%storage) : (buffer)
    pipeline.compose @compute(%storage) : (buffer)
  }
}

// ----
low.func.def noinline target<amd.xdna.aie2p.core> @copy_spec0_spec0(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %value = vlda.512.bf16x32 %input, 0
  vst.512.bf16x32 %value, %output, 0
  return
}

low.func.def target<amd.xdna.aie2p.core> @__aie2p_worker_helper_3() asm {
  %35 = mov.local-address 458752
  %seed = mov.short 1
  st %seed, %35, 0
  %input = copy %35 : reg<aie2p.ep> -> reg<aie2p.ep>
  %84 = copy %35 : reg<aie2p.ep> -> reg<aie2p.ep>
  %output = paddb %84, 128
  low.func.call @copy_spec0_spec0(%input, %output) : (reg<aie2p.ep>, reg<aie2p.ep>)
  rel %seed, 48
  low.br ^_bb1
^_bb1:
  %61 = mov.ss
  low.br ^_bb1
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_4) @__aie2p_worker_helper_5() asm {
  %62 = constant 2301952 : reg<aie2p.config.scalar : i64>
  %63 = constant 3 : reg<aie2p.config.scalar : i64>
  %64 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %62, %63, %64
  %65 = constant 0 : reg<aie2p.config.scalar : i64>
  program.load %65, %64, @__aie2p_worker_helper_3
  %66 = constant 256 : reg<aie2p.config.scalar : i64>
  data.reserve %65, %64, %65, %66
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_4) @__aie2p_worker_helper_6() asm {
  %67 = constant 2224128 : reg<aie2p.config.scalar : i64>
  %68 = constant 0 : reg<aie2p.config.scalar : i64>
  write32 %67, %68
  measure.begin
  %69 = constant 2301952 : reg<aie2p.config.scalar : i64>
  %70 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %69, %70, %68
  %71 = constant 1 : reg<aie2p.config.scalar : i64>
  write.mask32 %69, %71, %71
  %72 = constant 63 : reg<aie2p.config.scalar : i64>
  wait.mask32 %67, %72, %71
  measure.end
  %73 = constant 3 : reg<aie2p.config.scalar : i64>
  write.mask32 %69, %73, %70
  return
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_4) abi(array_program) @main() asm {
  %74 = constant 1 : reg<aie2p.config.scalar : i64>
  entry %74, @__aie2p_worker_helper_5, @__aie2p_worker_helper_6
  return
}
