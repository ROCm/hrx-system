// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize

func.def @load_shaped_view_argument(%source: view<2x4x8x8xf32>, %row: index, %column: index) -> (vector<8x8xf32>) where [range(%row, 0, 1), range(%column, 0, 3)] {
  %value = vector.load %source[%row, %column, 0, 0] : view<2x4x8x8xf32> -> vector<8x8xf32>
  func.return %value : vector<8x8xf32>
}

// ----
func.def @load_shaped_view_argument(%source: view<2x4x8x8xf32>, %row: index, %column: index) -> (vector<8x8xf32>) where [range(%row, 0, 1), range(%column, 0, 3)] {
  %12 = index.constant 6 : index
  %13 = index.shli %column, %12 : index
  %7 = index.constant 256 : index
  %8 = index.madd %row, %7, %13 : index
  %9 = view.bitcast %source : view<2x4x8x8xf32> -> view<512xf32>
  %10 = vector.load %9[%8] : view<512xf32> -> vector<64xf32>
  %value = vector.bitcast %10 : vector<64xf32> to vector<8x8xf32>
  func.return %value : vector<8x8xf32>
}
