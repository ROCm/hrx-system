func.def @broadcast_i8_singleton_axis(%source: vector<2x1xi8>) -> (vector<2x4xi8>) {
  %result = vector.broadcast %source : vector<2x1xi8> -> vector<2x4xi8>
  func.return %result : vector<2x4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @broadcast_i8_singleton_axis(%source: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %12 = vextract.8.imm %source, 0
  %13 = vbcst.8 %12
  %14 = vextract.8.imm %source, 1
  %15 = vbcst.8 %14
  %16 = mova.i32 4
  %17 = vshift %13, %13, %16
  %18 = mova.i32 60
  %result = vshift %17, %15, %18
  return %result
}

