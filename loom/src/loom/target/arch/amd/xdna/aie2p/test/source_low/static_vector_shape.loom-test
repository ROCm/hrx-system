}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @insert_f64_row(%row: reg<aie2p.vec256 x2>, %dest: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %14 = mova.i32 32
  %15 = vshift %dest, %dest, %14
  %16 = mova.i32 16
  %17 = vshift %dest, %dest, %16
  %18 = mova.i32 48
  %19 = vshift %17, %row, %18
  %20 = slice %19[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %21 = slice %15[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %result = concat(%20, %21) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %result
}

