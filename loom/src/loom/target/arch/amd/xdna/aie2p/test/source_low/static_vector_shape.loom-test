low.func.def target<amd.xdna.aie2p.core> abi(object_function) @contiguous_f32_rows(%source: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %8 = mova.i32 16
  %result = vshift %source, %source, %8
  return %result
}

