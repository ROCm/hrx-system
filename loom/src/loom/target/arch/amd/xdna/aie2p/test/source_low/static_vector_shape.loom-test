  %12 = vextract.8.imm %source, 0
  %13 = vbcst.8 %12
  %14 = vextract.8.imm %source, 1
  %15 = vbcst.8 %14
  %16 = mova.i32 4
  %17 = vshift %13, %13, %16
  %18 = mova.i32 60
  %result = vshift %17, %15, %18
  return %result
}

