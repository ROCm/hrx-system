low.func.def target<amd.xdna.aie2p.core> abi(object_function) @broadcast_f32_accumulator_rows(%source: reg<aie2p.vec256 x2>) -> (reg<aie2p.mbms x4>) asm {
  %14 = slice %source[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %16 = concat(%14, %14) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %17 = vmov.vector512.to.accumulator512 %16
  %19 = concat(%17, %17) : (reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x2>
  %result = concat(%19, %19) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
