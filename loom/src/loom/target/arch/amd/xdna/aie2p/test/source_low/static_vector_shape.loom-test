  %12 = vsub.8 %11, %11
  %13 = vsel.8 %12, %11, %source
  %14 = vextract.8.imm %13, 0
  %15 = vbcst.8 %14
  %16 = vsub.8 %15, %15
  %17 = vlt.u8x64 %16, %15
