// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @contiguous_f32_rows(%source: vector<3x4xf32>) -> (vector<2x4xf32>) {
  %result = vector.slice %source[1, 0] : vector<3x4xf32> -> vector<2x4xf32>
  func.return %result : vector<2x4xf32>
}

