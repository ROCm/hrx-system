low.func.def target<amd.xdna.aie2p.core> abi(object_function) @select_i8_1(%mask: reg<aie2p.elpredicate>, %true_value: reg<aie2p.vec256 x2>, %false_value: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %selected = vsel.8 %false_value, %true_value, %mask
  return %selected
}

