func.def @select_i8_1(%mask: vector<1xi1>, %true_value: vector<1xi8>, %false_value: vector<1xi8>) -> (vector<1xi8>) {
  %selected = vector.select %mask, %true_value, %false_value : vector<1xi8>
  func.return %selected : vector<1xi8>
}

