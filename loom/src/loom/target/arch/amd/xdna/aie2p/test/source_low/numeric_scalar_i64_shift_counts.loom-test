  %75 = copy %30 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %76 = sel.nez %70, %64, %75
  %77 = copy %30 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %78 = sel.nez %64, %72, %77
  %84 = xor %53, %76
  %85 = xor %55, %78
  %90 = slice %left_count[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %91, %92 = add.carry %84, %17
  %93, %94 = adc %85, %90, %92
  %99 = slice %right_count[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %100, %101 = add.carry %91, %38
  %102, %103 = adc %93, %99, %101
  %109 = xor %100, %15
  %110 = xor %102, %16
  %result = concat(%109, %110) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result
}

// ====

func.def @wide_shift_value_is_count(%input: i64) -> (i64) {
  %mask = scalar.constant 63 : i64
  %value = scalar.andi %input, %mask : i64
  %result = scalar.shli %value, %value : i64
  func.return %result : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_shift_value_is_count(%input: reg<aie2p.er x2>) -> (reg<aie2p.er x2>) asm {
  %7 = mov.i32 63
  %8 = mov.i32 0
  %10 = slice %input[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %11 = slice %input[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %14 = and %10, %7
  %15 = and %11, %8
  %20 = mov.short 0
  %21 = mov.short 31
  %22 = mov.short 32
  %23 = and %14, %21
  %24 = mov.short -1
  %25 = lshl %14, %24
  %26 = add.nc.immediate %23, -31
  %27 = lshl %14, %23
  %28 = lshl %15, %23
  %29 = lshl %25, %26
  %30 = or %28, %29
  %32 = ltu %14, %22
  %33 = copy %32 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %34 = sel.nez %27, %20, %33
  %35 = copy %32 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %36 = sel.nez %30, %27, %35
  %result = concat(%34, %36) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result
}

// ====

// A retained exact count selects word transport even without a constant op.
func.def @wide_word_shift_known_count(%value: i64, %count_input: i64) -> (i64, i64, i64) {
  %count = scalar.assume %count_input [range(%count_input, 32, 32)] : i64
  %left = scalar.shli %value, %count : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %left, %logical, %signed : i64, i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_word_shift_known_count(%value: reg<aie2p.er x2>, %count_input: reg<aie2p.er x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %15 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %16 = mov.short 0
  %left = concat(%16, %15) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %18 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %logical = concat(%18, %16) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %22 = mov.short -31
  %23 = ashl %18, %22
  %signed = concat(%18, %23) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %left, %logical, %signed
}
