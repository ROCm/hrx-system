// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @wide_shift_constant(%values: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = scalar.constant 31 : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_shift_constant(%values: reg<aie2p.vec256 x2>) -> (reg<aie2p.er x2>) asm {
  %value = vextract.64.imm %values, 0
  %8 = mov.i32 31
  %11 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %12 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %14 = add.nc.immediate %8, -32
  %15 = lshl %11, %8
  %16 = lshl %12, %8
  %17 = lshl %11, %14
  %18 = or %16, %17
  %shifted = concat(%15, %18) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %shifted
}

// ====

func.def @wide_shift_varying(%values: vector<2xi64>, %counts: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = vector.extract %counts[0] : vector<2xi64> -> i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_shift_varying(%values: reg<aie2p.vec256 x2>, %counts: reg<aie2p.vec256 x2>) -> (reg<aie2p.er x2>) asm {
  %value = vextract.64.imm %values, 0
  %count = vextract.64.imm %counts, 0
  %11 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %12 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %13 = slice %count[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %14 = mov.short 0
  %15 = mov.short 31
  %16 = mov.short 32
  %17 = and %13, %15
  %18 = mov.short -1
  %19 = lshl %11, %18
  %20 = add.nc.immediate %17, -31
  %21 = lshl %11, %17
  %22 = lshl %12, %17
  %23 = lshl %19, %20
  %24 = or %22, %23
  %26 = ltu %13, %16
  %27 = copy %26 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %28 = sel.nez %21, %14, %27
  %29 = copy %26 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %30 = sel.nez %24, %21, %29
  %shifted = concat(%28, %30) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %shifted
}

// ====

func.def @wide_shift_word_boundaries(%value: i64) -> (i64, i64, i64, i64) {
  %identity_count = scalar.constant 0 : i64
  %last_low = scalar.constant 31 : i64
  %first_high = scalar.constant 32 : i64
  %last_high = scalar.constant 63 : i64
  %unchanged = scalar.shli %value, %identity_count : i64
  %low_edge = scalar.shli %value, %last_low : i64
  %high_edge = scalar.shli %value, %first_high : i64
  %top_bit = scalar.shli %value, %last_high : i64
  func.return %unchanged, %low_edge, %high_edge, %top_bit : i64, i64, i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_shift_word_boundaries(%value: reg<aie2p.er x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %18 = mov.i32 31
  %21 = mov.i32 63
  %24 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %25 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %27 = add.nc.immediate %18, -32
  %28 = lshl %24, %18
  %29 = lshl %25, %18
  %30 = lshl %24, %27
  %31 = or %29, %30
  %low_edge = concat(%28, %31) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %34 = mov.short 0
  %high_edge = concat(%34, %24) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %39 = add.nc.immediate %21, -32
  %41 = lshl %24, %39
  %top_bit = concat(%34, %41) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %value, %low_edge, %high_edge, %top_bit
}

// ====

func.def @wide_shift_low_word(%value: i64) -> (i32) {
  %count = scalar.constant 6 : i64
  %shifted = scalar.shli %value, %count : i64
  %result = scalar.trunci %shifted : i64 to i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_shift_low_word(%value: reg<aie2p.er x2>) -> (reg<aie2p.er>) asm {
  %9 = mov.short 6
  %10 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %result = lshl %10, %9
  return %result
}

// ====

func.def @wide_shift_bounded_high(%value: i64, %count_input: i64) -> (i64) {
  %count = scalar.assume %count_input [range(%count_input, 32, 63)] : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_shift_bounded_high(%value: reg<aie2p.er x2>, %count: reg<aie2p.er x2>) -> (reg<aie2p.er x2>) asm {
  %8 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %10 = slice %count[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %11 = add.nc.immediate %10, -32
  %12 = mov.short 0
  %13 = lshl %8, %11
  %shifted = concat(%12, %13) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %shifted
}

// ====

func.def @wide_shift_bounded_nonzero_low(%value: i64, %count_input: i64) -> (i64) {
  %count = scalar.assume %count_input [range(%count_input, 1, 31)] : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_shift_bounded_nonzero_low(%value: reg<aie2p.er x2>, %count: reg<aie2p.er x2>) -> (reg<aie2p.er x2>) asm {
  %8 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %9 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %10 = slice %count[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %11 = add.nc.immediate %10, -32
  %12 = lshl %8, %10
  %13 = lshl %9, %10
  %14 = lshl %8, %11
  %15 = or %13, %14
  %shifted = concat(%12, %15) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %shifted
}

