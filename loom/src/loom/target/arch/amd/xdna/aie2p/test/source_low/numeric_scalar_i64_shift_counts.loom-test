aie2p.target<core> @target

func.def target(@target) @wide_shift_constant(%values: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = scalar.constant 31 : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @wide_shift_constant(%values: reg<aie2p.vec256 x2>) -> (reg<aie2p.er x2>) asm {
  %value = vextract.64.imm %values, 0
  %8 = mov.i32 31
  %11 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %12 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %14 = add %8, -32
  %15 = lshl %11, %8
  %16 = lshl %12, %8
  %17 = lshl %11, %14
  %18 = or %16, %17
  %shifted = concat(%15, %18) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %shifted
}

