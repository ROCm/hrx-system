// ====

aie2p.target<core> @target
func.def target(@target) @i8x4_addi_chain(%packed: vector<1xi32>, %bias: vector<4xi8>, %delta: vector<4xi8>) -> (vector<4xi8>) {
  %bytes = vector.bitcast %packed : vector<1xi32> to vector<4xi8>
  %biased = vector.addi %bytes, %bias : vector<4xi8>
  %result = vector.addi %biased, %delta : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i8x4_addi_chain(%bytes: reg<aie2p.vec512>, %bias: reg<aie2p.vec512>, %delta: reg<aie2p.vec512>) -> (reg<aie2p.vec512>) asm {
  %biased = vadd.8 %bytes, %bias
  %result = vadd.8 %biased, %delta
  return %result
}

// ====

aie2p.target<core> @target
func.def target(@target) @i8x4_select_addi(%lhs: i32, %rhs: i32, %true_value: vector<4xi8>, %false_value: vector<4xi8>, %bias: vector<4xi8>) -> (vector<4xi8>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  %mask = vector.splat %condition : vector<4xi1>
  %selected = vector.select %mask, %true_value, %false_value : vector<4xi8>
  %result = vector.addi %selected, %bias : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i8x4_select_addi(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %true_value: reg<aie2p.vec512>, %false_value: reg<aie2p.vec512>, %bias: reg<aie2p.vec512>) -> (reg<aie2p.vec512>) asm {
  %condition = lt %lhs, %rhs
  %18 = select.mask %condition, -1
  %selected = vsel.32 %true_value, %false_value, %18
  %result = vadd.8 %selected, %bias
  return %result
}

