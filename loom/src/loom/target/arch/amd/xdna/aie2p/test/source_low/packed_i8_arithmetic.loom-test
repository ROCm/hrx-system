func.def @i8x4_shrui_4(%values: vector<4xi8>) -> (vector<4xi8>) {
  %amount_scalar = scalar.constant 4 : i8
  %amount = vector.splat %amount_scalar : vector<4xi8>
  %result = vector.shrui %values, %amount : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x4_shrui_4(%values: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %7 = mov.shift 0
  %8 = mov.shift 4
  set.saturation 0
  set.ups-mode 0
  set.srs-mode 0
  set.rounding 0
  %9 = vups.4x.x-to-d.unsigned %values, %7
  %result = vsrs.4x.d-to-x.unsigned %9, %8
  return %result
}

