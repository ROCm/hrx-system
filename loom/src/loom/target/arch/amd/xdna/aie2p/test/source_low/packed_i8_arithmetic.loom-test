// ====

func.def @i8x4_bounded_varying_shifts(%values: vector<4xi8>, %amounts: vector<4xi8>) -> (vector<4xi8>) {
  %mask_scalar = scalar.constant 7 : i8
  %mask = vector.splat %mask_scalar : vector<4xi8>
  %bounded = vector.andi %amounts, %mask : vector<4xi8>
  %result = vector.shrui %values, %bounded : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x4_bounded_varying_shifts(%values: reg<aie2p.vec256 x2>, %amounts: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %mask_scalar = mov.short 7
  %mask = vbcst.8 %mask_scalar
  %bounded = vband %amounts, %mask
  %13 = mov.short 1
  %14 = vbcst.8 %13
  set.saturation 0
  set.ups-mode 0
  set.srs-mode 0
  set.rounding 0
  %15 = mov.shift 0
  %16 = vups.4x.x-to-d.unsigned %values, %15
  %17 = mov.shift 1
  %18 = vsrs.4x.d-to-x.unsigned %16, %17
  %19 = vband %bounded, %14
  %20 = veqz.8 %19
  %21 = vsel.8 %18, %values, %20
  %22 = vadd.8 %14, %14
  %23 = vups.4x.x-to-d.unsigned %21, %15
  %24 = mov.shift 2
  %25 = vsrs.4x.d-to-x.unsigned %23, %24
  %26 = vband %bounded, %22
  %27 = veqz.8 %26
  %28 = vsel.8 %25, %21, %27
  %29 = vadd.8 %22, %22
  %30 = vups.4x.x-to-d.unsigned %28, %15
  %31 = mov.shift 4
  %32 = vsrs.4x.d-to-x.unsigned %30, %31
  %33 = vband %bounded, %29
  %34 = veqz.8 %33
  %result = vsel.8 %32, %28, %34
  return %result
}
