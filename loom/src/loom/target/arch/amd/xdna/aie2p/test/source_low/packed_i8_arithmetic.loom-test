// ====

func.def @i8x4_scf_if_addi(%lhs: i32, %rhs: i32, %true_value: vector<4xi8>, %false_value: vector<4xi8>, %bias: vector<4xi8>) -> (vector<4xi8>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  %selected = scf.if %condition -> (vector<4xi8>) {
    scf.yield %true_value : vector<4xi8>
  } else {
    scf.yield %false_value : vector<4xi8>
  }
  %result = vector.addi %selected, %bias : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x4_scf_if_addi(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %true_value: reg<aie2p.vec256 x2>, %false_value: reg<aie2p.vec256 x2>, %bias: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %condition = lt %lhs, %rhs
  %17 = select.mask %condition, -1
  %selected = vsel.32 %true_value, %false_value, %17
  %result = vadd.8 %selected, %bias
  return %result
}

// ====

func.def @i8x4_cfg_arg_addi(%lhs: i32, %rhs: i32, %true_value: vector<4xi8>, %false_value: vector<4xi8>, %bias: vector<4xi8>) -> (vector<4xi8>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  cfg.cond_br %condition, ^then, ^else
^then:
  cfg.br ^join(%true_value: vector<4xi8>)
^else:
  cfg.br ^join(%false_value: vector<4xi8>)
^join(%selected: vector<4xi8>):
  %result = vector.addi %selected, %bias : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x4_cfg_arg_addi(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %true_value: reg<aie2p.vec256 x2>, %false_value: reg<aie2p.vec256 x2>, %bias: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %condition = lt %lhs, %rhs
  low.cond_br %condition, ^then, ^else : reg<aie2p.er>
^then:
  low.br ^join(%true_value: reg<aie2p.vec256 x2>)
^else:
  low.br ^join(%false_value: reg<aie2p.vec256 x2>)
^join(%selected: reg<aie2p.vec256 x2>):
  %result = vadd.8 %selected, %bias
  return %result
}

