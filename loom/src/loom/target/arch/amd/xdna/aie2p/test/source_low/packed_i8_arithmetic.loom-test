// ====

func.def @i8x4_bounded_varying_shifts(%values: vector<4xi8>, %amounts: vector<4xi8>) -> (vector<4xi8>) {
  %mask = vector.splati 7 : vector<4xi8>
  %bounded = vector.andi %amounts, %mask : vector<4xi8>
  %result = vector.shrui %values, %bounded : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x4_bounded_varying_shifts(%values: reg<aie2p.vec256 x2>, %amounts: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %9 = mov.short 7
  %mask = vbcst.8 %9
  %bounded = vband %amounts, %mask
  %12 = mov.short 1
  %13 = vbcst.8 %12
  set.saturation 0
  set.ups-mode 0
  set.srs-mode 0
  set.rounding 0
  %14 = mov.shift 0
  %15 = vups.4x.x-to-d.unsigned %values, %14
  %16 = mov.shift 1
  %17 = vsrs.4x.d-to-x.unsigned %15, %16
  %18 = vband %bounded, %13
  %19 = veqz.8 %18
  %20 = vsel.8 %17, %values, %19
  %21 = vadd.8 %13, %13
  %22 = vups.4x.x-to-d.unsigned %20, %14
  %23 = mov.shift 2
  %24 = vsrs.4x.d-to-x.unsigned %22, %23
  %25 = vband %bounded, %21
  %26 = veqz.8 %25
  %27 = vsel.8 %24, %20, %26
  %28 = vadd.8 %21, %21
  %29 = vups.4x.x-to-d.unsigned %27, %14
  %30 = mov.shift 4
  %31 = vsrs.4x.d-to-x.unsigned %29, %30
  %32 = vband %bounded, %28
  %33 = veqz.8 %32
  %result = vsel.8 %31, %27, %33
  return %result
}
