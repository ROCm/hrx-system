aie2p.target<core> @target
func.def target(@target) @i8x4_addi_arguments(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (vector<4xi8>) {
  %sum = vector.addi %lhs, %rhs : vector<4xi8>
  func.return %sum : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i8x4_addi_arguments(%lhs: reg<aie2p.vec512>, %rhs: reg<aie2p.vec512>) -> (reg<aie2p.vec512>) asm {
  %sum = vadd.8 %lhs, %rhs
  return %sum
}

