// Native issue-cycle counts include return delay slots. Independent load ports
// coissue and retain their full latency when no generated moves fill the gap.
// RUN: emit aie2p-leaf @vector_add report=emission

low.func.def target<amd.xdna.aie2p.core> @vector_add(%left_pointer: reg<aie2p.ep>, %right_pointer: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %left = vlda.512.i32x16 %left_pointer, 0
  %right = vldb.512.i32x16 %right_pointer, 0
  %sum = vadd.32 %right, %left
  vst.512.i32x16 %sum, %output, 0
  return
}

