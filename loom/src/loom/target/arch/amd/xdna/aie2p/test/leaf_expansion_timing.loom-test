// ====

// Repeating the low half requires a generated register move. Its wait for the
// loaded value and its own issue cycle consume the pending logical load gap.
// RUN: emit aie2p-leaf @repeat_loaded_half report=emission

low.func.def target<amd.xdna.aie2p.core> @repeat_loaded_half(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %loaded = vlda.512.i32x16 %input, 0
  %half = slice %loaded[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %repeated = concat(%half, %half) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %sum = vadd.32 %repeated, %repeated
  vst.512.i32x16 %sum, %output, 0
  return
}

