// ====

// The byte store reads r0 at cycle 7, so reusing r0 for the add's cycle-1 write
// waits until cycle 6. That independent stall does not move the store-to-release
// deadline from cycle 10. RET and its delay window end at cycle 14.
// RUN: emit aie2p-leaf @independent_deadline fixed=%old:physical_register:253:1 fixed=%next:physical_register:253:1 report=emission

low.func.def schedule(locked) target<amd.xdna.aie2p.core> @independent_deadline(%old: reg<aie2p.er>, %seed: reg<aie2p.er>, %output: reg<aie2p.ep>) asm {
