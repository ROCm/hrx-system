// ====

// Each padded accumulator is realized with multiple native moves. Early storage
// slices forward the clear's payload deadline; the final move extends readiness.
// RUN: emit aie2p-leaf @padded_accumulators report=emission

low.func.def target<amd.xdna.aie2p.core> @padded_accumulators(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>, %output: reg<aie2p.ep>) asm {
  %zeros = acc.clear.f32x64
  %padding = slice %zeros[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %left_quarter = vmov.vector512.to.accumulator512 %left
  %left_padded = concat(%left_quarter, %padding, %padding, %padding) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %right_quarter = vmov.vector512.to.accumulator512 %right
  %right_padded = concat(%right_quarter, %padding, %padding, %padding) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %mode = mova.i32 60
  %sum = vadd.f32x64 %left_padded, %right_padded, %mode
  %quarter = slice %sum[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %result = vmov.accumulator512.to.vector512 %quarter
  vst.512.f32x16 %result, %output, 0
  return
}

