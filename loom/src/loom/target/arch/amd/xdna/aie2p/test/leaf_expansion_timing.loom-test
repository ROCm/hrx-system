// ====

// A second store consumes the delayed add at cycle 7. This time release must
// follow that actual producer at cycle 17, including the full memory separation.
// RUN: emit aie2p-leaf @dependent_deadline fixed=%old:physical_register:253:1 fixed=%next:physical_register:253:1 report=emission

low.func.def schedule(locked) target<amd.xdna.aie2p.core> @dependent_deadline(%old: reg<aie2p.er>, %seed: reg<aie2p.er>, %output: reg<aie2p.ep>) asm {
  st.s8 %old, %output, 0
  %next = add %seed, 1
  st.s8 %next, %output, 4
  rel %next, 0
  return
}

