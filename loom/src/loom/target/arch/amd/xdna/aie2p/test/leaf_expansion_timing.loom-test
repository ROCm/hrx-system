// ====

// The volatile store is a read-only state fence. Its newer stage-1 saturation
// read cannot retire the load's stage-7 read before the final state write.
// RET may cover useful work in its delay window while preserving that fence.
// RUN: emit aie2p-leaf @state_fence report=emission

low.func.def target<amd.xdna.aie2p.core> @state_fence(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %value: reg<aie2p.mbms>, %shift: reg<aie2p.es>) -> (reg<aie2p.mbms>) asm {
  set.saturation 0
  %loaded = vlda.ups.2x.w-to-b.unsigned %shift, %input, 0
  vst.srs.2x.b-to-w.unsigned.volatile %value, %shift, %output, 0
  set.saturation 1
  return %loaded
}

