// ====

// A taken backedge retains its architectural delay window after generated
// moves. The following block starts a fresh logical-to-physical mapping.
// RUN: emit aie2p-leaf @repeat_loop report=emission

low.func.def target<amd.xdna.aie2p.core> @repeat_loop(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %count: reg<aie2p.er>) asm {
  low.br ^loop(%count: reg<aie2p.er>)
^loop(%remaining: reg<aie2p.er>):
  %loaded = vlda.512.i32x16 %input, 0
  %half = slice %loaded[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %repeated = concat(%half, %half) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %sum = vadd.32 %repeated, %repeated
  vst.512.i32x16 %sum, %output, 0
  %next = add %remaining, -1
  low.cond_br %next, ^backedge, ^exit : reg<aie2p.er>
^backedge:
  low.br ^loop(%next: reg<aie2p.er>)
^exit:
  %one = mov.i32 1
  st %one, %output, 4
  return
}

