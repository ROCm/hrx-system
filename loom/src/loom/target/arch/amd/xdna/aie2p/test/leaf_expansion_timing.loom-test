// delayed writes ahead of the old read without another accumulator allocation.
// The complete bytes bind both load pairs, both conversions and return timing.
// RUN: emit aie2p-leaf @delayed_accumulator_reuse report=code

low.func.def target<amd.xdna.aie2p.core> @delayed_accumulator_reuse(%first: reg<aie2p.ep>, %second: reg<aie2p.ep>, %c00: reg<aie2p.mbms x4>, %c01: reg<aie2p.mbms x4>, %c10: reg<aie2p.mbms x4>, %c11: reg<aie2p.mbms x4>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mexa>, reg<aie2p.mexa>) asm {
  %first_lower = vlda.convert.bf16x32.to.f32x32 %first, 0
  %first_upper = vlda.convert.bf16x32.to.f32x32 %first, 64
  %first_float = concat(%first_lower, %first_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  set.rounding 12
  %first_encoded = vconv.bfp16ebs8.fp32 %first_float
  %second_lower = vlda.convert.bf16x32.to.f32x32 %second, 0
  %second_upper = vlda.convert.bf16x32.to.f32x32 %second, 64
  %second_float = concat(%second_lower, %second_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %second_encoded = vconv.bfp16ebs8.fp32 %second_float
  return %c00, %c01, %c10, %c11, %first_encoded, %second_encoded
}

