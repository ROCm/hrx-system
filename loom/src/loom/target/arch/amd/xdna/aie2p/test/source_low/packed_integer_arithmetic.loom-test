aie2p.target<core> @target
func.def target(@target) @i16x4_shift_storage_tuple(%value: vector<4xi16>, %shift: vector<4xi16>) -> (vector<4xi16>, vector<4xi16>, vector<4xi16>) {
  %left = vector.shli %value, %shift : vector<4xi16>
  %signed_right = vector.shrsi %value, %shift : vector<4xi16>
  %unsigned_right = vector.shrui %value, %shift : vector<4xi16>
  func.return %left, %signed_right, %unsigned_right : vector<4xi16>, vector<4xi16>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i16x4_shift_storage_tuple(%value: reg<aie2p.vec512>, %shift: reg<aie2p.vec512>) -> (reg<aie2p.vec512>, reg<aie2p.vec512>, reg<aie2p.vec512>) asm {
  %64 = vextract.16.imm %value, 0
  %65 = vextract.16.imm %shift, 0
  %66 = extend.u16 %65
  %67 = lshl %64, %66
  %68 = vextract.16.imm %value, 1
  %69 = vextract.16.imm %shift, 1
  %70 = extend.u16 %69
  %71 = lshl %68, %70
  %72 = vextract.16.imm %value, 2
  %73 = vextract.16.imm %shift, 2
  %74 = extend.u16 %73
  %75 = lshl %72, %74
  %76 = vextract.16.imm %value, 3
  %77 = vextract.16.imm %shift, 3
  %78 = extend.u16 %77
  %79 = lshl %76, %78
  %80 = vbcst.16 %67
  %81 = mov.short 1
  %82 = copy %81 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %83 = vinsert.16.reg %80, %82, %71
  %84 = mov.short 2
  %85 = copy %84 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %86 = vinsert.16.reg %83, %85, %75
  %87 = mov.short 3
  %88 = copy %87 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %left = vinsert.16.reg %86, %88, %79
  %90 = extend.s16 %64
  %92 = mov.short 0
  %93 = sub %92, %66
  %94 = ashl %90, %93
  %95 = extend.s16 %68
  %98 = sub %92, %70
  %99 = ashl %95, %98
  %100 = extend.s16 %72
  %103 = sub %92, %74
  %104 = ashl %100, %103
  %105 = extend.s16 %76
  %108 = sub %92, %78
  %109 = ashl %105, %108
  %110 = vbcst.16 %94
  %112 = copy %81 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %113 = vinsert.16.reg %110, %112, %99
  %115 = copy %84 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %116 = vinsert.16.reg %113, %115, %104
  %118 = copy %87 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %signed_right = vinsert.16.reg %116, %118, %109
  %120 = extend.u16 %64
  %123 = sub %92, %66
  %124 = lshl %120, %123
  %125 = extend.u16 %68
  %128 = sub %92, %70
  %129 = lshl %125, %128
  %130 = extend.u16 %72
  %133 = sub %92, %74
  %134 = lshl %130, %133
  %135 = extend.u16 %76
  %138 = sub %92, %78
  %139 = lshl %135, %138
  %140 = vbcst.16 %124
  %142 = copy %81 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %143 = vinsert.16.reg %140, %142, %129
  %145 = copy %84 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %146 = vinsert.16.reg %143, %145, %134
  %148 = copy %87 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %unsigned_right = vinsert.16.reg %146, %148, %139
  return %left, %signed_right, %unsigned_right
}

