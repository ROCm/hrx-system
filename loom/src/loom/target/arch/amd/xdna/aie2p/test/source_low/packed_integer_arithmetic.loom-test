aie2p.target<core> @target
func.def target(@target) @i16x4_add_sub_storage_tuple(%lhs: vector<4xi16>, %rhs: vector<4xi16>) -> (vector<4xi16>, vector<4xi16>) {
  %sum = vector.addi %lhs, %rhs : vector<4xi16>
  %diff = vector.subi %lhs, %rhs : vector<4xi16>
  func.return %sum, %diff : vector<4xi16>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i16x4_add_sub_storage_tuple(%lhs: reg<aie2p.vec512>, %rhs: reg<aie2p.vec512>) -> (reg<aie2p.vec512>, reg<aie2p.vec512>) asm {
  %sum = vadd.16 %lhs, %rhs
  %diff = vsub.16 %lhs, %rhs
  return %sum, %diff
}

