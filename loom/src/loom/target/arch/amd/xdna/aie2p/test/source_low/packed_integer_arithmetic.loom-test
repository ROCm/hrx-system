aie2p.target<core> @target
func.def target(@target) @i8x8_bitwise_storage_tuple(%lhs: vector<8xi8>, %rhs: vector<8xi8>) -> (vector<8xi8>, vector<8xi8>, vector<8xi8>) {
  %and = vector.andi %lhs, %rhs : vector<8xi8>
  %or = vector.ori %lhs, %rhs : vector<8xi8>
  %xor = vector.xori %lhs, %rhs : vector<8xi8>
  func.return %and, %or, %xor : vector<8xi8>, vector<8xi8>, vector<8xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i8x8_bitwise_storage_tuple(%lhs: reg<aie2p.vec512>, %rhs: reg<aie2p.vec512>) -> (reg<aie2p.vec512>, reg<aie2p.vec512>, reg<aie2p.vec512>) asm {
  %and = vband %lhs, %rhs
  %or = vbor %lhs, %rhs
  %xor = vsub.8 %or, %and
  return %and, %or, %xor
}

