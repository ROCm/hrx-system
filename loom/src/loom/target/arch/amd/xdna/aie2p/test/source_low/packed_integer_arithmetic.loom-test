aie2p.target<core> @target
func.def target(@target) @i16x4_shift_storage_tuple(%value: vector<4xi16>, %shift: vector<4xi16>) -> (vector<4xi16>, vector<4xi16>, vector<4xi16>) {
  %left = vector.shli %value, %shift : vector<4xi16>
  %signed_right = vector.shrsi %value, %shift : vector<4xi16>
  %unsigned_right = vector.shrui %value, %shift : vector<4xi16>
  func.return %left, %signed_right, %unsigned_right : vector<4xi16>, vector<4xi16>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i16x4_shift_storage_tuple(%value: reg<aie2p.vec512>, %shift: reg<aie2p.vec512>) -> (reg<aie2p.vec512>, reg<aie2p.vec512>, reg<aie2p.vec512>) asm {
  %64 = vextract.16.imm %value, 0
  %65 = vextract.16.imm %shift, 0
  %66 = lshl %64, %65
  %67 = vextract.16.imm %value, 1
  %68 = vextract.16.imm %shift, 1
  %69 = lshl %67, %68
  %70 = vextract.16.imm %value, 2
  %71 = vextract.16.imm %shift, 2
  %72 = lshl %70, %71
  %73 = vextract.16.imm %value, 3
  %74 = vextract.16.imm %shift, 3
  %75 = lshl %73, %74
  %76 = vbcst.16 %66
  %77 = mov.short 1
  %78 = copy %77 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %79 = vinsert.16.reg %76, %78, %69
  %80 = mov.short 2
  %81 = copy %80 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %82 = vinsert.16.reg %79, %81, %72
  %83 = mov.short 3
  %84 = copy %83 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %left = vinsert.16.reg %82, %84, %75
  %86 = extend.s16 %64
  %87 = mov.short 0
  %88 = sub %87, %65
  %89 = ashl %86, %88
  %90 = extend.s16 %67
  %92 = sub %87, %68
  %93 = ashl %90, %92
  %94 = extend.s16 %70
  %96 = sub %87, %71
  %97 = ashl %94, %96
  %98 = extend.s16 %73
  %100 = sub %87, %74
  %101 = ashl %98, %100
  %102 = vbcst.16 %89
  %104 = copy %77 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %105 = vinsert.16.reg %102, %104, %93
  %107 = copy %80 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %108 = vinsert.16.reg %105, %107, %97
  %110 = copy %83 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %signed_right = vinsert.16.reg %108, %110, %101
  %113 = sub %87, %65
  %114 = lshl %64, %113
  %116 = sub %87, %68
  %117 = lshl %67, %116
  %119 = sub %87, %71
  %120 = lshl %70, %119
  %122 = sub %87, %74
  %123 = lshl %73, %122
  %124 = vbcst.16 %114
  %126 = copy %77 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %127 = vinsert.16.reg %124, %126, %117
  %129 = copy %80 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %130 = vinsert.16.reg %127, %129, %120
  %132 = copy %83 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %unsigned_right = vinsert.16.reg %130, %132, %123
  return %left, %signed_right, %unsigned_right
}

