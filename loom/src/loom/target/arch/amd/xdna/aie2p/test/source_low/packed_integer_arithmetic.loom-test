aie2p.target<core> @target
func.def target(@target) @i16x4_bitcast_mul_maxui_chain(%packed: vector<2xi32>, %scale: vector<4xi16>, %limit: vector<4xi16>) -> (vector<4xi16>) {
  %lanes = vector.bitcast %packed : vector<2xi32> to vector<4xi16>
  %product = vector.muli %lanes, %scale : vector<4xi16>
  %result = vector.maxui %product, %limit : vector<4xi16>
  func.return %result : vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i16x4_bitcast_mul_maxui_chain(%lanes: reg<aie2p.vec512>, %scale: reg<aie2p.vec512>, %limit: reg<aie2p.vec512>) -> (reg<aie2p.vec512>) asm {
  %11 = mova.i32 858
  %12 = mov.shift 0
  %13 = vmul.i16x32 %lanes, %scale, %11
  set.rounding 0
  set.srs-mode 1
  set.saturation 0
  %product = vsrs.trunc.s16x32 %13, %12
  %result = max.u16x32 %product, %limit
  return %result
}

// ====

aie2p.target<core> @target
func.def target(@target) @i16x4_select_xori(%lhs: i32, %rhs: i32, %true_value: vector<4xi16>, %false_value: vector<4xi16>, %mask: vector<4xi16>) -> (vector<4xi16>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  %predicate = vector.splat %condition : vector<4xi1>
  %selected = vector.select %predicate, %true_value, %false_value : vector<4xi16>
  %result = vector.xori %selected, %mask : vector<4xi16>
  func.return %result : vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i16x4_select_xori(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %true_value: reg<aie2p.vec512>, %false_value: reg<aie2p.vec512>, %mask: reg<aie2p.vec512>) -> (reg<aie2p.vec512>) asm {
  %condition = lt %lhs, %rhs
  %18 = select.mask %condition, -1
  %selected = vsel.32 %true_value, %false_value, %18
  %20 = vbor %selected, %mask
  %21 = vband %selected, %mask
  %result = vsub.16 %20, %21
  return %result
}

// ====

aie2p.target<core> @target
func.def target(@target) @i16x4_cfg_arg_andi(%lhs: i32, %rhs: i32, %true_value: vector<4xi16>, %false_value: vector<4xi16>, %mask: vector<4xi16>) -> (vector<4xi16>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  cfg.cond_br %condition, ^then, ^else
^then:
  cfg.br ^join(%true_value: vector<4xi16>)
^else:
  cfg.br ^join(%false_value: vector<4xi16>)
^join(%selected: vector<4xi16>):
  %result = vector.andi %selected, %mask : vector<4xi16>
  func.return %result : vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i16x4_cfg_arg_andi(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %true_value: reg<aie2p.vec512>, %false_value: reg<aie2p.vec512>, %mask: reg<aie2p.vec512>) -> (reg<aie2p.vec512>) asm {
  %condition = lt %lhs, %rhs
  low.cond_br %condition, ^then, ^else : reg<aie2p.er>
^then:
  low.br ^join(%true_value: reg<aie2p.vec512>)
^else:
  low.br ^join(%false_value: reg<aie2p.vec512>)
^join(%selected: reg<aie2p.vec512>):
  %result = vband %selected, %mask
  return %result
}
