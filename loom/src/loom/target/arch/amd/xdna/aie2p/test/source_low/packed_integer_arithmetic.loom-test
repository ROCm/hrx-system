func.def target(@target) @i16x4_bitwise_storage_tuple(%lhs: vector<4xi16>, %rhs: vector<4xi16>) -> (vector<4xi16>, vector<4xi16>, vector<4xi16>) {
  %and = vector.andi %lhs, %rhs : vector<4xi16>
  %or = vector.ori %lhs, %rhs : vector<4xi16>
  %xor = vector.xori %lhs, %rhs : vector<4xi16>
  func.return %and, %or, %xor : vector<4xi16>, vector<4xi16>, vector<4xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i16x4_bitwise_storage_tuple(%lhs: reg<aie2p.vec512>, %rhs: reg<aie2p.vec512>) -> (reg<aie2p.vec512>, reg<aie2p.vec512>, reg<aie2p.vec512>) asm {
  %and = vband %lhs, %rhs
  %or = vbor %lhs, %rhs
  %xor = vsub.16 %or, %and
  return %and, %or, %xor
}

