// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i64x8_uniform_shift_boundaries(%input: vector<8xi64>) -> (vector<8xi64>, vector<8xi64>, vector<8xi64>) {
  %left_count_scalar = scalar.constant 32 : i64
  %left_count = vector.splat %left_count_scalar : vector<8xi64>
  %logical_count_scalar = scalar.constant 31 : i64
  %logical_count = vector.splat %logical_count_scalar : vector<8xi64>
  %signed_count_scalar = scalar.constant 63 : i64
  %signed_count = vector.splat %signed_count_scalar : vector<8xi64>
  %left = vector.shli %input, %left_count : vector<8xi64>
  %logical = vector.shrui %input, %logical_count : vector<8xi64>
  %signed = vector.shrsi %input, %signed_count : vector<8xi64>
  func.return %left, %logical, %signed : vector<8xi64>, vector<8xi64>, vector<8xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64x8_uniform_shift_boundaries(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %17 = mova.i32 4
  %19 = vshuffle %input, %input, %17
  %21 = mov.short 32
  %22 = add.shift %21, -32
  %23 = mov.shift 0
  %24 = vsub.32 %19, %19
  set.saturation 0
  set.ups-mode 1
  set.srs-mode 1
  set.rounding 0
  %25 = vups.2x.x-to-c.unsigned %19, %22
  %26 = vsrs.2x.c-to-x.unsigned %25, %23
  %27 = mova.i32 16
  %left = vshuffle %24, %26, %27
  %30 = mova.i32 5
  %32 = vshuffle %input, %input, %30
  %33 = mov.short -31
  %34 = add.shift %33, 32
  %36 = mov.shift 32
  %37 = vups.2x.x-to-c.unsigned %19, %34
  %38 = vsrs.2x.c-to-x.unsigned %37, %36
  %39 = vups.2x.x-to-c.unsigned %32, %34
  %40 = vsrs.2x.c-to-x.unsigned %39, %23
  %41 = vbor %38, %40
  %42 = vsrs.2x.c-to-x.unsigned %39, %36
  %logical = vshuffle %41, %42, %27
  %49 = mov.short 63
  %50 = add.shift %49, -32
  %53 = vups.2x.x-to-c.signed %32, %23
  %54 = vsrs.2x.c-to-x.signed %53, %50
  %56 = mov.shift 31
  %57 = vsrs.2x.c-to-x.signed %53, %56
  %signed = vshuffle %54, %57, %27
  return %left, %logical, %signed
}

// ====

func.def @i64x2x3_varying_signed_shift(%input: vector<2x3xi64>, %raw_counts: vector<2x3xi64>) -> (vector<2x3xi64>) {
  %mask_scalar = scalar.constant 63 : i64
  %mask = vector.splat %mask_scalar : vector<2x3xi64>
  %counts = vector.andi %raw_counts, %mask : vector<2x3xi64>
  %result = vector.shrsi %input, %counts : vector<2x3xi64>
  func.return %result : vector<2x3xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64x2x3_varying_signed_shift(%input: reg<aie2p.vec256 x2>, %raw_counts: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %10 = mov.i32 63
  %11 = mov.i32 0
  %mask_scalar = concat(%10, %11) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %mask = vbcst.64 %mask_scalar
  %counts = vband %raw_counts, %mask
  %15 = mova.i32 4
  %16 = mova.i32 5
  %17 = vshuffle %input, %input, %15
