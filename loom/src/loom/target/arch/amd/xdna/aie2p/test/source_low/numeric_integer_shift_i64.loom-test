  %44 = vband %19, %36
  %45 = veqz.32.el.low32 %44
  %46 = predicate.complete.zero.high32 %45, 0
  %47 = vsel.32.mask64 %42, %34, %46
  %48 = vsel.32.mask64 %43, %35, %46
  %49 = vadd.32 %36, %36
  %50 = mov.shift 28
  %51 = vups.2x.x-to-c.unsigned %47, %50
  %52 = vsrs.2x.c-to-x.unsigned %51, %24
  %53 = vups.2x.x-to-c.signed %48, %50
  %54 = vsrs.2x.c-to-x.signed %53, %23
  %55 = vbor %52, %54
  %56 = vsrs.2x.c-to-x.signed %53, %24
  %57 = vband %19, %49
  %58 = veqz.32.el.low32 %57
  %59 = predicate.complete.zero.high32 %58, 0
  %60 = vsel.32.mask64 %55, %47, %59
  %61 = vsel.32.mask64 %56, %48, %59
  %62 = vadd.32 %49, %49
  %63 = mov.shift 24
  %64 = vups.2x.x-to-c.unsigned %60, %63
  %65 = vsrs.2x.c-to-x.unsigned %64, %24
  %66 = vups.2x.x-to-c.signed %61, %63
  %67 = vsrs.2x.c-to-x.signed %66, %23
  %68 = vbor %65, %67
  %69 = vsrs.2x.c-to-x.signed %66, %24
  %70 = vband %19, %62
  %71 = veqz.32.el.low32 %70
  %72 = predicate.complete.zero.high32 %71, 0
  %73 = vsel.32.mask64 %68, %60, %72
  %74 = vsel.32.mask64 %69, %61, %72
  %75 = vadd.32 %62, %62
  %76 = mov.shift 16
  %77 = vups.2x.x-to-c.unsigned %73, %76
  %78 = vsrs.2x.c-to-x.unsigned %77, %24
  %79 = vups.2x.x-to-c.signed %74, %76
  %80 = vsrs.2x.c-to-x.signed %79, %23
  %81 = vbor %78, %80
  %82 = vsrs.2x.c-to-x.signed %79, %24
  %83 = vband %19, %75
  %84 = veqz.32.el.low32 %83
  %85 = predicate.complete.zero.high32 %84, 0
  %86 = vsel.32.mask64 %81, %73, %85
  %87 = vsel.32.mask64 %82, %74, %85
  %88 = vadd.32 %75, %75
  %90 = vups.2x.x-to-c.signed %87, %23
  %91 = vsrs.2x.c-to-x.signed %90, %22
  %92 = vband %19, %88
