  %28 = vbor %25, %27
  %29 = vsrs.2x.c-to-x.signed %26, %23
  %30 = vband %18, %20
  %31 = veqz.32.el.low32 %30
  %32 = predicate.complete.zero.high32 %31, 0
  %33 = vsel.32.mask64 %28, %16, %32
  %34 = vsel.32.mask64 %29, %17, %32
  %35 = vadd.32 %20, %20
  %36 = mov.shift 30
  %37 = vups.2x.x-to-c.unsigned %33, %36
  %38 = vsrs.2x.c-to-x.unsigned %37, %23
  %39 = vups.2x.x-to-c.signed %34, %36
  %40 = vsrs.2x.c-to-x.signed %39, %22
  %41 = vbor %38, %40
  %42 = vsrs.2x.c-to-x.signed %39, %23
  %43 = vband %18, %35
  %44 = veqz.32.el.low32 %43
  %45 = predicate.complete.zero.high32 %44, 0
  %46 = vsel.32.mask64 %41, %33, %45
  %47 = vsel.32.mask64 %42, %34, %45
  %48 = vadd.32 %35, %35
  %49 = mov.shift 28
  %50 = vups.2x.x-to-c.unsigned %46, %49
  %51 = vsrs.2x.c-to-x.unsigned %50, %23
  %52 = vups.2x.x-to-c.signed %47, %49
  %53 = vsrs.2x.c-to-x.signed %52, %22
  %54 = vbor %51, %53
  %55 = vsrs.2x.c-to-x.signed %52, %23
  %56 = vband %18, %48
  %57 = veqz.32.el.low32 %56
  %58 = predicate.complete.zero.high32 %57, 0
  %59 = vsel.32.mask64 %54, %46, %58
  %60 = vsel.32.mask64 %55, %47, %58
  %61 = vadd.32 %48, %48
  %62 = mov.shift 24
  %63 = vups.2x.x-to-c.unsigned %59, %62
  %64 = vsrs.2x.c-to-x.unsigned %63, %23
  %65 = vups.2x.x-to-c.signed %60, %62
  %66 = vsrs.2x.c-to-x.signed %65, %22
  %67 = vbor %64, %66
  %68 = vsrs.2x.c-to-x.signed %65, %23
  %69 = vband %18, %61
  %70 = veqz.32.el.low32 %69
  %71 = predicate.complete.zero.high32 %70, 0
  %72 = vsel.32.mask64 %67, %59, %71
  %73 = vsel.32.mask64 %68, %60, %71
  %74 = vadd.32 %61, %61
  %75 = mov.shift 16
  %76 = vups.2x.x-to-c.unsigned %72, %75
  %77 = vsrs.2x.c-to-x.unsigned %76, %23
  %78 = vups.2x.x-to-c.signed %73, %75
  %79 = vsrs.2x.c-to-x.signed %78, %22
  %80 = vbor %77, %79
  %81 = vsrs.2x.c-to-x.signed %78, %23
  %82 = vband %18, %74
  %83 = veqz.32.el.low32 %82
  %84 = predicate.complete.zero.high32 %83, 0
  %85 = vsel.32.mask64 %80, %72, %84
  %86 = vsel.32.mask64 %81, %73, %84
  %87 = vadd.32 %74, %74
  %89 = vups.2x.x-to-c.signed %86, %22
  %90 = vsrs.2x.c-to-x.signed %89, %21
  %91 = vband %18, %87
  %92 = veqz.32.el.low32 %91
  %93 = predicate.complete.zero.high32 %92, 0
  %94 = vsel.32.mask64 %86, %85, %93
  %95 = vsel.32.mask64 %90, %86, %93
  %96 = mova.i32 16
  %result = vshuffle %94, %95, %96
  return %result
}
