// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i64x8_uniform_shift_boundaries(%input: vector<8xi64>) -> (vector<8xi64>, vector<8xi64>, vector<8xi64>) {
  %left_count = vector.splati 32 : vector<8xi64>
  %logical_count = vector.splati 31 : vector<8xi64>
  %signed_count = vector.splati 63 : vector<8xi64>
  %left = vector.shli %input, %left_count : vector<8xi64>
  %logical = vector.shrui %input, %logical_count : vector<8xi64>
  %signed = vector.shrsi %input, %signed_count : vector<8xi64>
  func.return %left, %logical, %signed : vector<8xi64>, vector<8xi64>, vector<8xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64x8_uniform_shift_boundaries(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %14 = mova.i32 4
  %16 = vshuffle %input, %input, %14
  %18 = mov.short 32
  %19 = add.shift %18, -32
  %20 = mov.shift 0
  %21 = vsub.32 %16, %16
  set.saturation 0
  set.ups-mode 1
  set.srs-mode 1
  set.rounding 0
  %22 = vups.2x.x-to-c.unsigned %16, %19
  %23 = vsrs.2x.c-to-x.unsigned %22, %20
  %24 = mova.i32 16
  %left = vshuffle %21, %23, %24
  %27 = mova.i32 5
  %29 = vshuffle %input, %input, %27
  %30 = mov.short -31
  %31 = add.shift %30, 32
  %33 = mov.shift 32
  %34 = vups.2x.x-to-c.unsigned %16, %31
  %35 = vsrs.2x.c-to-x.unsigned %34, %33
  %36 = vups.2x.x-to-c.unsigned %29, %31
  %37 = vsrs.2x.c-to-x.unsigned %36, %20
  %38 = vbor %35, %37
  %39 = vsrs.2x.c-to-x.unsigned %36, %33
  %logical = vshuffle %38, %39, %24
  %46 = mov.short 63
  %47 = add.shift %46, -32
  %50 = vups.2x.x-to-c.signed %29, %20
  %51 = vsrs.2x.c-to-x.signed %50, %47
  %53 = mov.shift 31
  %54 = vsrs.2x.c-to-x.signed %50, %53
  %signed = vshuffle %51, %54, %24
  return %left, %logical, %signed
}

// ====

func.def @i64x2x3_varying_signed_shift(%input: vector<2x3xi64>, %raw_counts: vector<2x3xi64>) -> (vector<2x3xi64>) {
  %mask = vector.splati 63 : vector<2x3xi64>
  %counts = vector.andi %raw_counts, %mask : vector<2x3xi64>
  %result = vector.shrsi %input, %counts : vector<2x3xi64>
  func.return %result : vector<2x3xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64x2x3_varying_signed_shift(%input: reg<aie2p.vec256 x2>, %raw_counts: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %9 = mov.i32 63
  %10 = mov.i32 0
  %11 = concat(%9, %10) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %mask = vbcst.64 %11
  %counts = vband %raw_counts, %mask
  %14 = mova.i32 4
  %15 = mova.i32 5
  %16 = vshuffle %input, %input, %14
  %17 = vshuffle %input, %input, %15
  %18 = vshuffle %counts, %counts, %14
  %19 = mov.short 1
  %20 = vbcst.32 %19
  %21 = mov.shift 31
  %22 = mov.shift 0
  %23 = mov.shift 32
  set.saturation 0
  set.ups-mode 1
  %24 = vups.2x.x-to-c.unsigned %16, %21
  set.srs-mode 1
