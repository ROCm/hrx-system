func.def @predicate_to_index(%input: vector<16xi1>) -> (vector<16xindex>) {
  %result = vector.index_cast %input : vector<16xi1> to vector<16xindex>
  func.return %result : vector<16xindex>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @predicate_to_index(%input: reg<aie2p.elpredicate>) -> (reg<aie2p.vec256 x2>) asm {
  %5 = mov.short 1
  %6 = vbcst.8 %5
  %7 = vsub.8 %6, %6
  %8 = vsel.8 %7, %6, %input
  %9 = slice %8[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %10 = mov.shift 0
  set.saturation 0
  set.ups-mode 0
  %11 = vups.4x.w-to-c.signed %9, %10
  %12 = slice %11[0] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %result = vmov.accumulator512.to.vector512 %12
  return %result
}

