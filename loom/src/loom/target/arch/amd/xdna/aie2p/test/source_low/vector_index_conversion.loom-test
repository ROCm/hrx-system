  %13 = vmov.accumulator512.to.vector512 %12
  %14 = slice %11[1] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %15 = vmov.accumulator512.to.vector512 %14
  %signed = concat(%13, %15) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %18 = vups.2x.x-to-c.unsigned %offsets, %10
  %19 = slice %18[0] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %20 = vmov.accumulator512.to.vector512 %19
  %21 = slice %18[1] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %22 = vmov.accumulator512.to.vector512 %21
  %unsigned = concat(%20, %22) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  return %signed, %unsigned
}

