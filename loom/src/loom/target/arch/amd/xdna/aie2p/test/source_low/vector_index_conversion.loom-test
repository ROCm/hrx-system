func.def @i64_to_addresses(%index: index, %offset: offset) -> (vector<9xindex>, vector<9xoffset>) {
  %bounded_index, %bounded_offset = index.assume %index, %offset [range(%index, -2147483648, 2147483647), range(%offset, 0, 4294967295)] : index, offset
  %wide_index = index.cast %bounded_index : index to i64
  %wide_offset = index.cast %bounded_offset : offset to i64
  %signed = vector.splat %wide_index : vector<9xi64>
  %unsigned = vector.splat %wide_offset : vector<9xi64>
  %indices = vector.index_cast %signed : vector<9xi64> to vector<9xindex>
  %offsets = vector.index_cast %unsigned : vector<9xi64> to vector<9xoffset>
  func.return %indices, %offsets : vector<9xindex>, vector<9xoffset>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i64_to_addresses(%bounded_index: reg<aie2p.er>, %bounded_offset: reg<aie2p.er>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %22 = mov.short -31
  %23 = ashl %bounded_index, %22
  %wide_index = concat(%bounded_index, %23) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %25 = mov.short 0
  %wide_offset = concat(%bounded_offset, %25) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %27 = vbcst.64 %wide_index
  %30 = vbcst.64 %wide_offset
  %35 = mova.i32 4
  %indices = vshuffle %27, %27, %35
  %offsets = vshuffle %30, %30, %35
  return %indices, %offsets
}

