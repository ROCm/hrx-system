low.func.def target<amd.xdna.aie2p.core> abi(object_function) @offset_compare_select(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %eq = eq %lhs, %rhs
  %ne = ne %lhs, %rhs
  %slt = lt %lhs, %rhs
  %sle = ge %rhs, %lhs
  %sgt = lt %rhs, %lhs
  %sge = ge %lhs, %rhs
  %ult = ltu %lhs, %rhs
  %ule = geu %rhs, %lhs
  %ugt = ltu %rhs, %lhs
  %uge = geu %lhs, %rhs
  %47 = copy %ult : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %selected = sel.nez %lhs, %rhs, %47
  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge, %selected
}

// ====

func.def @computed_index_must_fit_physical_carrier(%lhs: index, %rhs: index) -> (index) where [range(%lhs, 65536, 65537), range(%rhs, 65536, 65537)] {
  // ERROR@+1: TARGET/005 {op_name="index.mul", subject_role="result", subject_name="product", constraint_key="index.maximum_carrier", minimum="-2147483648", maximum="4294967295"}
  %product = index.mul %lhs, %rhs : index
  func.return %product : index
}
