// RUN: emit source-low output=low

aie2p.target<core> @target
func.def target(@target) @index_arithmetic(%lhs0: index, %rhs0: index, %stride: offset) -> (index, index, index, index, index, index, index, index, offset) {
  %lhs, %rhs = index.assume %lhs0, %rhs0 [range(%lhs0, 0, 2147483647), range(%rhs0, 1, 1024)] : index, index
  %add = index.add %lhs, %rhs : index
  %sub = index.sub %lhs, %rhs : index
  %mul = index.mul %lhs, %rhs : index
  %div = index.div %lhs, %rhs : index
  %rem = index.rem %lhs, %rhs : index
  %min = index.min %lhs, %rhs : index
  %max = index.max %lhs, %rhs : index
  %madd = index.madd %lhs, %rhs, %sub : index
  %scaled = index.scale %lhs, %stride : index, offset -> offset
  func.return %add, %sub, %mul, %div, %rem, %min, %max, %madd, %scaled : index, index, index, index, index, index, index, index, offset
}

