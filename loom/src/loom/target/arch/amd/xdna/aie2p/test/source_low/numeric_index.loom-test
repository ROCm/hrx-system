  %86, %87 = divs %85, %84, %rhs
  %88, %89 = divs %87, %86, %rhs
  %90, %91 = divs %89, %88, %rhs
  %92, %93 = divs %91, %90, %rhs
  %94, %95 = divs %93, %92, %rhs
  %96, %97 = divs %95, %94, %rhs
  %98, %99 = divs %97, %96, %rhs
  %100, %101 = divs %99, %98, %rhs
  %102, %103 = divs %101, %100, %rhs
  %div = mov.quotient %103
  %105 = mov.dividend %lhs
  %107, %108 = divs %105, %39, %rhs
  %109, %110 = divs %108, %107, %rhs
  %111, %112 = divs %110, %109, %rhs
