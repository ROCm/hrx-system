aie2p.target<core> @target
func.def target(@target) @offset_arithmetic(%lhs: offset, %rhs: offset) -> (offset, offset) {
  %add = index.add %lhs, %rhs : offset
  %sub = index.sub %lhs, %rhs : offset
  func.return %add, %sub : offset, offset
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @offset_arithmetic(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %add = add.rr %lhs, %rhs
  %sub = sub %lhs, %rhs
  return %add, %sub
}

