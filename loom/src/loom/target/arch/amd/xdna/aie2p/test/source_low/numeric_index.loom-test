// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @index_arithmetic(%lhs0: index, %rhs0: index, %stride: offset) -> (index, index, index, index, index, index, index, index, offset) {
  // Division and remainder require nonnegative coordinates and a positive divisor.
  %lhs, %rhs = index.assume %lhs0, %rhs0 [range(%lhs0, 0, 2000000), range(%rhs0, 1, 1024)] : index, index
  %add = index.add %lhs, %rhs : index
  %sub = index.sub %lhs, %rhs : index
  %mul = index.mul %lhs, %rhs : index
  %div = index.div %lhs, %rhs : index
  %rem = index.rem %lhs, %rhs : index
  %min = index.min %lhs, %rhs : index
  %max = index.max %lhs, %rhs : index
  %madd = index.madd %lhs, %rhs, %sub : index
  %scaled = index.scale %lhs, %stride : index, offset -> offset
  func.return %add, %sub, %mul, %div, %rem, %min, %max, %madd, %scaled : index, index, index, index, index, index, index, index, offset
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @index_arithmetic(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %stride: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %add = add.nc %lhs, %rhs
  %sub = sub %lhs, %rhs
  %mul = mul %lhs, %rhs
  %44 = mov.dividend %lhs
  %45 = mov.short 0
  %46, %47 = divs %44, %45, %rhs
  %48, %49 = divs %47, %46, %rhs
  %50, %51 = divs %49, %48, %rhs
  %52, %53 = divs %51, %50, %rhs
  %54, %55 = divs %53, %52, %rhs
  %56, %57 = divs %55, %54, %rhs
  %58, %59 = divs %57, %56, %rhs
  %60, %61 = divs %59, %58, %rhs
  %62, %63 = divs %61, %60, %rhs
  %64, %65 = divs %63, %62, %rhs
  %66, %67 = divs %65, %64, %rhs
  %68, %69 = divs %67, %66, %rhs
  %70, %71 = divs %69, %68, %rhs
  %72, %73 = divs %71, %70, %rhs
  %74, %75 = divs %73, %72, %rhs
  %76, %77 = divs %75, %74, %rhs
  %78, %79 = divs %77, %76, %rhs
  %80, %81 = divs %79, %78, %rhs
  %82, %83 = divs %81, %80, %rhs
  %84, %85 = divs %83, %82, %rhs
  %86, %87 = divs %85, %84, %rhs
  %88, %89 = divs %87, %86, %rhs
  %90, %91 = divs %89, %88, %rhs
  %92, %93 = divs %91, %90, %rhs
  %94, %95 = divs %93, %92, %rhs
  %96, %97 = divs %95, %94, %rhs
  %98, %99 = divs %97, %96, %rhs
  %100, %101 = divs %99, %98, %rhs
  %102, %103 = divs %101, %100, %rhs
  %104, %105 = divs %103, %102, %rhs
  %106, %107 = divs %105, %104, %rhs
  %108, %109 = divs %107, %106, %rhs
  %div = mov.quotient %109
  %111 = mul %div, %rhs
  %rem = sub %lhs, %111
  %113 = lt.select %lhs, %rhs
  %min = sel.nez %lhs, %rhs, %113
  %115 = lt.select %rhs, %lhs
  %max = sel.nez %lhs, %rhs, %115
  %117 = copy %sub : reg<aie2p.er> -> reg<aie2p.er>
  %madd = mac %117, %lhs, %rhs
  %scaled = mul %lhs, %stride
  return %add, %sub, %mul, %div, %rem, %min, %max, %madd, %scaled
}

// ====

func.def @offset_arithmetic(%lhs: offset, %rhs: offset) -> (offset, offset) {
  %add = index.add %lhs, %rhs : offset
  %sub = index.sub %lhs, %rhs : offset
  func.return %add, %sub : offset, offset
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @offset_arithmetic(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %add = add.nc %lhs, %rhs
  %sub = sub %lhs, %rhs
  return %add, %sub
}

// ====

func.def @index_bitwise(%input0: index, %other: index, %amount0: index) -> (index, index, index, index, index, index, index, index, index, index, index) {
  %input, %amount = index.assume %input0, %amount0 [range(%input0, -65536, 65535), range(%amount0, 1, 15)] : index, index
  %and = index.andi %input, %other : index
  %or = index.ori %input, %other : index
  %xor = index.xori %input, %other : index
  %shl = index.shli %input, %amount : index
  %shrs = index.shrsi %input, %amount : index
  %shru = index.shrui %input, %amount : index
  %rotl = index.rotli %input, %amount : index
  %rotr = index.rotri %input, %amount : index
  %clz = index.ctlzi %input : index
  %ctz = index.cttzi %input : index
  %pop = index.ctpopi %input : index
  func.return %and, %or, %xor, %shl, %shrs, %shru, %rotl, %rotr, %clz, %ctz, %pop : index, index, index, index, index, index, index, index, index, index, index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @index_bitwise(%input: reg<aie2p.er>, %other: reg<aie2p.er>, %amount: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %and = and %input, %other
  %or = or %input, %other
  %xor = xor %input, %other
  %shl = lshl %input, %amount
  %45 = mov.short 0
  %46 = sub %45, %amount
  %shrs = ashl %input, %46
  %49 = sub %45, %amount
  %shru = lshl %input, %49
  %52 = mov.short 31
  %53 = sub %45, %amount
  %54 = and %amount, %52
  %55 = and %53, %52
  %56 = lshl %input, %54
  %57 = sub %45, %55
  %58 = lshl %input, %57
  %rotl = or %56, %58
  %62 = sub %45, %amount
  %64 = and %62, %52
  %65 = sub %45, %54
  %66 = lshl %input, %65
  %67 = lshl %input, %64
  %rotr = or %67, %66
  %clz = clz %input
  %70 = mov.short -1
  %71 = xor %input, %70
  %72 = add.nc.immediate %input, -1
  %73 = and %71, %72
  %74 = popcount %73
  %75 = mov.short 32
  %76 = copy %input : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %ctz = sel.eqz %75, %74, %76
  %pop = popcount %input
  return %and, %or, %xor, %shl, %shrs, %shru, %rotl, %rotr, %clz, %ctz, %pop
}

