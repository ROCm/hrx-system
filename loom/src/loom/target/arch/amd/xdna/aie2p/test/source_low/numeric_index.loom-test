func.def @index_compare_select(%lhs: index, %rhs: index) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, index) {
  %eq = index.cmp eq, %lhs, %rhs : index
  %ne = index.cmp ne, %lhs, %rhs : index
  %slt = index.cmp slt, %lhs, %rhs : index
  %sle = index.cmp sle, %lhs, %rhs : index
  %sgt = index.cmp sgt, %lhs, %rhs : index
  %sge = index.cmp sge, %lhs, %rhs : index
  %ult = index.cmp ult, %lhs, %rhs : index
  %ule = index.cmp ule, %lhs, %rhs : index
  %ugt = index.cmp ugt, %lhs, %rhs : index
  %uge = index.cmp uge, %lhs, %rhs : index
  %selected = scf.select %ult, %lhs, %rhs : index
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge, %selected : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @index_compare_select(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %eq = eq %lhs, %rhs
  %ne = ne %lhs, %rhs
  %slt = lt %lhs, %rhs
  %sle = ge %rhs, %lhs
  %sgt = lt %rhs, %lhs
  %sge = ge %lhs, %rhs
  %ult = ltu %lhs, %rhs
  %ule = geu %rhs, %lhs
  %ugt = ltu %rhs, %lhs
  %uge = geu %lhs, %rhs
  %47 = copy %ult : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %selected = sel.nez %lhs, %rhs, %47
  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge, %selected
}

