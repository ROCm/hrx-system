  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge, %selected
}

// ====

// Arithmetic may overflow for some inputs; native instructions remain valid
// for the non-overflowing executions without a static range promise.
func.def @native_index_arithmetic(%input: i32) -> (index, index, index, index, index) {
  %position = index.cast %input : i32 to index
  %factor = index.constant 4 : index
  %shift = index.constant 1 : index
  %scaled = index.mul %position, %factor : index
  %added = index.add %scaled, %position : index
  %subtracted = index.sub %scaled, %position : index
  %combined = index.madd %position, %factor, %position : index
  %shifted = index.shli %position, %shift : index
  func.return %scaled, %added, %subtracted, %combined, %shifted : index, index, index, index, index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @native_index_arithmetic(%position: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %factor = mov.short 4
  %shift = mov.short 1
  %24 = mov.short 2
  %scaled = lshl %position, %24
  %added = add.nc %scaled, %position
  %subtracted = sub %scaled, %position
  %28 = copy %position : reg<aie2p.er> -> reg<aie2p.er>
  %combined = mac %28, %position, %factor
  %shifted = lshl %position, %shift
  return %scaled, %added, %subtracted, %combined, %shifted
}
