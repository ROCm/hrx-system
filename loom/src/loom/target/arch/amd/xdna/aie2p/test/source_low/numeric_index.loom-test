  %slt = lt %lhs, %rhs
  %sle = ge %rhs, %lhs
  %sgt = lt %rhs, %lhs
  %sge = ge %lhs, %rhs
  %ult = ltu %lhs, %rhs
  %ule = geu %rhs, %lhs
  %ugt = ltu %rhs, %lhs
  %uge = geu %lhs, %rhs
  %47 = copy %ult : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %selected = sel.nez %lhs, %rhs, %47
  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge, %selected
}
