  %ult = ltu %lhs, %rhs
  %ule = geu %rhs, %lhs
  %ugt = ltu %rhs, %lhs
  %uge = geu %lhs, %rhs
  %47 = copy %ult : reg<aie2p.er> -> reg<aie2p.mr27_select>
