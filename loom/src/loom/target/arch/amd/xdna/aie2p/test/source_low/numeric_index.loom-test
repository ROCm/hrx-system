  %171 = lt.select %lhs, %rhs
  %min = sel.nez %lhs, %rhs, %171
  %173 = lt.select %rhs, %lhs
  %max = sel.nez %lhs, %rhs, %173
  %175 = copy %sub : reg<aie2p.er> -> reg<aie2p.er>
  %madd = mac %175, %lhs, %rhs
