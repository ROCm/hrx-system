low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @index_bitwise(%input: reg<aie2p.er>, %other: reg<aie2p.er>, %amount: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %and = and %input, %other
  %or = or %input, %other
  %xor = xor %input, %other
  %shl = lshl %input, %amount
  %44 = mov.short 0
  %45 = sub %44, %amount
  %shrs = ashl %input, %45
  %48 = sub %44, %amount
  %shru = lshl %input, %48
  %51 = mov.short 31
  %52 = sub %44, %amount
  %53 = and %amount, %51
  %54 = and %52, %51
  %55 = lshl %input, %53
  %56 = sub %44, %54
  %57 = lshl %input, %56
  %rotl = or %55, %57
  %61 = sub %44, %amount
  %63 = and %61, %51
  %64 = sub %44, %53
  %65 = lshl %input, %64
  %66 = lshl %input, %63
  %rotr = or %66, %65
  %clz = clz %input
  %69 = mov.short -1
  %70 = xor %input, %69
  %71 = add %input, -1
  %72 = and %70, %71
  %73 = popcount %72
  %74 = mov.short 32
  %75 = copy %input : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %ctz = sel.eqz %74, %73, %75
  %pop = popcount %input
  return %and, %or, %xor, %shl, %shrs, %shru, %rotl, %rotr, %clz, %ctz, %pop
}

