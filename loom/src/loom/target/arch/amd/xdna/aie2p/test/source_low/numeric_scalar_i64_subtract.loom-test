// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_i64_subtract.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @uniform_subtract(%lhs: i64, %rhs: i64) -> (i64) {
  %difference = scalar.subi %lhs, %rhs : i64
  func.return %difference : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @uniform_subtract(%lhs: reg<aie2p.er x2>, %rhs: reg<aie2p.er x2>) -> (reg<aie2p.er x2>) asm {
  %7 = slice %lhs[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %8 = slice %lhs[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %9 = slice %rhs[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %10 = slice %rhs[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %11, %12 = sub.borrow %7, %9
  %13, %14 = sbc %8, %10, %12
  %difference = concat(%11, %13) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %difference
}

// ====

func.def @constant_subtract(%value: i64) -> (i64, i64, i64) {
  %c0 = scalar.constant 0 : i64
  %wide = scalar.constant 4294967297 : i64
  %negated = scalar.subi %c0, %value : i64
  %constant_left = scalar.subi %wide, %value : i64
  %constant_right = scalar.subi %value, %wide : i64
  func.return %negated, %constant_left, %constant_right : i64, i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @constant_subtract(%value: reg<aie2p.er x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %15 = mov.i32 0
  %18 = mov.i32 1
  %23 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %24 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %25, %26 = sub.borrow %15, %23
  %27, %28 = sbc %15, %24, %26
  %negated = concat(%25, %27) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %34, %35 = sub.borrow %18, %23
  %36, %37 = sbc %18, %24, %35
  %constant_left = concat(%34, %36) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %39 = mov.i32 -1
  %40 = mov.i32 -2
  %46, %47 = add.carry %23, %39
  %48, %49 = adc %24, %40, %47
  %constant_right = concat(%46, %48) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %negated, %constant_left, %constant_right
}

// ====

func.def @mixed_subtract(%uniform: i64, %values: vector<2xi64>) -> (i64, i64) {
  %varying = vector.extract %values[0] : vector<2xi64> -> i64
  %uniform_left = scalar.subi %uniform, %varying : i64
  %uniform_right = scalar.subi %varying, %uniform : i64
  func.return %uniform_left, %uniform_right : i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @mixed_subtract(%uniform: reg<aie2p.er x2>, %values: reg<aie2p.vec256 x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %varying = vextract.64.imm %values, 0
  %12 = slice %uniform[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %13 = slice %uniform[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %14 = slice %varying[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %15 = slice %varying[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %16, %17 = sub.borrow %12, %14
  %18, %19 = sbc %13, %15, %17
  %uniform_left = concat(%16, %18) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %25, %26 = sub.borrow %14, %12
  %27, %28 = sbc %15, %13, %26
  %uniform_right = concat(%25, %27) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %uniform_left, %uniform_right
}
