low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @matrix_multiply_packed_u5s8_m8n8k8() asm {
  %packed_lhs_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %high_lhs_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %rhs_view = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 3, source_type = buffer} : reg<aie2p.ep>
  %38 = vlda.256.i8x32 %packed_lhs_view, 0
  set.unpack-size 0
  %low_lhs_value = vunpack.u4.to.u8x64 %38
  %42 = mov.short 0
  %43 = vbcst.8 %42
  %44 = slice %43[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %45 = slice %43[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %46 = copy %44 : reg<aie2p.vec256> -> reg<aie2p.vec256>
  %47 = vlda.128.i8x16 %high_lhs_view, %46, 0
  %high_lhs_bits = concat(%47, %45) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %high_lhs_mask = vextract.predicate64 %high_lhs_bits, 0
  %50 = mov.short 16
  %high_bit_value = vbcst.8 %50
  %high_lhs_candidates = vadd.8 %low_lhs_value, %high_bit_value
  %lhs_fragment = vsel.8 %low_lhs_value, %high_lhs_candidates, %high_lhs_mask
  %rhs_fragment = vlda.512.i8x64 %rhs_view, 0
