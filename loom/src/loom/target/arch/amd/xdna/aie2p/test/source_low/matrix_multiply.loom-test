// TEMPLATE: loom/src/loom/test/corpus/source_low/matrix_multiply.loom-test
// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @matrix_multiply_s8s8_m8n8k8(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs, %rhs, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<64xi8>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<64xi8>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<8x8xi32>
  %m = index.constant 8 : index
  %n = index.constant 8 : index
  %k = index.constant 8 : index
  %lhs_value = vector.load %lhs_view[0] : view<64xi8> -> vector<64xi8>
  %rhs_value = vector.load %rhs_view[0] : view<64xi8> -> vector<64xi8>
  %lhs_fragment = vector.fragment<lhs> %lhs_value shape [%m, %k] : vector<64xi8>
  %rhs_fragment = vector.fragment<rhs> %rhs_value shape [%k, %n] : vector<64xi8>
  %accumulator_init = vector.constant 0 : vector<64xi32>
  %accumulator_fragment = vector.fragment<init> %accumulator_init shape [%m, %n] : vector<64xi32>
  %product = vector.mma %lhs_fragment, %rhs_fragment, %accumulator_fragment : vector<64xi8>, vector<64xi8>, vector<64xi32>
  vector.fragment.store<result> %product, %output_view[0, 0] shape [%m, %n] : vector<64xi32>, view<8x8xi32>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @matrix_multiply_s8s8_m8n8k8() asm {
  %lhs_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %rhs_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %lhs_fragment = vlda.512.i8x64 %lhs_view, 0
  %rhs_fragment = vlda.512.i8x64 %rhs_view, 0
  %26 = mov.short 8
  %product = mmul.s8s8.m8n8k8 %lhs_fragment, %rhs_fragment, %26
  %28 = slice %product[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc.i32x16 %28, %output_view, 0
  %29 = slice %product[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc.i32x16 %29, %output_view, 64
  %30 = slice %product[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc.i32x16 %30, %output_view, 128
  %31 = slice %product[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc.i32x16 %31, %output_view, 192
  return
}
