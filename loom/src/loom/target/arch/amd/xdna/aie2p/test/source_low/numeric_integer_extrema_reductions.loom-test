// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @maximum_unsigned_i16x16(%values: vector<16xi16>, %initial: i16) -> (i16) {
  %result = vector.reduce<maxui> %values, %initial : vector<16xi16>, i16
  func.return %result : i16
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @maximum_unsigned_i16x16(%values: reg<aie2p.vec256 x2>, %initial: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %7 = vbcst.16 %initial
  %8 = max.u16x32 %values, %7
  %9 = mova.i32 16
  %10 = vshift %8, %8, %9
  %11 = max.u16x32 %8, %10
  %12 = mova.i32 8
  %13 = vshift %11, %11, %12
  %14 = max.u16x32 %11, %13
  %15 = mova.i32 4
  %16 = vshift %14, %14, %15
  %17 = max.u16x32 %14, %16
  %18 = mova.i32 2
  %19 = vshift %17, %17, %18
  %20 = max.u16x32 %17, %19
  %result = vextract.16.imm %20, 0
  return %result
}

