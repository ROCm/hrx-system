low.func.def target<amd.xdna.aie2p.core> abi(object_function) @minimum_signed_i8x33(%values: reg<aie2p.vec256 x2>, %initial: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %7 = vbcst.8 %initial
  %8 = predicate.constant.low32 -1
  %9 = predicate.complete.constant.high32 %8, 1
  %10 = vsel.8 %7, %values, %9
  %11 = mova.i32 32
  %12 = vshift %10, %10, %11
  %13 = min.s8x64 %10, %12
  %14 = mova.i32 16
  %15 = vshift %13, %13, %14
  %16 = min.s8x64 %13, %15
  %17 = mova.i32 8
  %18 = vshift %16, %16, %17
  %19 = min.s8x64 %16, %18
  %20 = mova.i32 4
  %21 = vshift %19, %19, %20
  %22 = min.s8x64 %19, %21
  %23 = mova.i32 2
  %24 = vshift %22, %22, %23
  %25 = min.s8x64 %22, %24
  %26 = mova.i32 1
  %27 = vshift %25, %25, %26
  %28 = min.s8x64 %25, %27
  %result = vextract.8.imm %28, 0
  return %result
}

