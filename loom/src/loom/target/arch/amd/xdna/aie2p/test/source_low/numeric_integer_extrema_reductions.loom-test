low.func.def target<amd.xdna.aie2p.core> abi(object_function) @maximum_signed_i64x2(%values: reg<aie2p.vec256 x2>, %initial: reg<aie2p.er x2>) -> (reg<aie2p.er x2>) asm {
  %7 = mova.i32 4
  %8 = mova.i32 5
  %9 = vshuffle %values, %values, %7
  %10 = vshuffle %values, %values, %8
  %11 = slice %initial[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %12 = vbcst.32 %11
  %13 = slice %initial[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %14 = vbcst.32 %13
  %15 = max.s32x16 %10, %14
  %16 = max.u32x16 %9, %12
  %17 = vlt.s32x16.el.low32 %14, %10
  %18 = vlt.s32x16.el.low32 %10, %14
  %19 = vsel.32.mask64 %16, %9, %17
  %20 = vsel.32.mask64 %19, %12, %18
  %22 = vshift %20, %20, %7
  %23 = vshift %15, %15, %7
  %24 = max.s32x16 %15, %23
  %25 = max.u32x16 %20, %22
  %26 = vlt.s32x16.el.low32 %23, %15
  %27 = vlt.s32x16.el.low32 %15, %23
  %28 = vsel.32.mask64 %25, %20, %26
  %29 = vsel.32.mask64 %28, %22, %27
  %30 = vextract.32.imm %29, 0
  %31 = vextract.32.imm %24, 0
  %result = concat(%30, %31) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result
}

