low.func.def target<amd.xdna.aie2p.core> abi(object_function) @minimum_unsigned_i16x33(%values: reg<aie2p.vec256 x4>, %initial: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %11 = slice %values[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %12 = slice %values[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %13 = vbcst.16 %initial
  %14 = min.u16x32 %11, %13
  %15 = mova.i32 32
  %16 = vshift %14, %14, %15
  %17 = min.u16x32 %14, %16
  %18 = mova.i32 16
  %19 = vshift %17, %17, %18
  %20 = min.u16x32 %17, %19
  %21 = mova.i32 8
  %22 = vshift %20, %20, %21
  %23 = min.u16x32 %20, %22
  %24 = mova.i32 4
  %25 = vshift %23, %23, %24
  %26 = min.u16x32 %23, %25
  %27 = mova.i32 2
  %28 = vshift %26, %26, %27
  %29 = min.u16x32 %26, %28
  %30 = vextract.16.imm %29, 0
  %31 = vbcst.16 %30
  %32 = min.u16x32 %12, %31
  %result = vextract.16.imm %32, 0
  return %result
