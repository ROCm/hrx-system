// A request ring has collective readers only. Its producer either participates
// in the serial scope or runs concurrently outside it. Both downstream workers
// must observe the same record, including ring wraparound and a stop record.
aie2p.target<array> @device

pipeline.def @publish() run(%records: channel<tile<1xi32>>, %value: i32) {
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %write, %payload = channel.reserve %records : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    view.store %value, %payload[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
}

pipeline.def @produce() run(%records: channel<tile<1xi32>>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %count = index.constant 6 : index
  %last = index.constant 5 : index
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %count step %step] {
      %remaining = index.sub %last, %record : index
      %value = index.cast %remaining : index to i32
      %write, %payload = channel.reserve %records : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
      view.store %value, %payload[0] : i32, view<1xi32>
      channel.publish %write : write<tile<1xi32>>
    }
  }
}

pipeline.def @emit_value() run(%output: buffer, %value: i32, %phase: index, %row: index, %lane: index) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %capacity = index.constant 1 : index
  %lanes = index.constant 2 : index
  %memory = pipeline.memory<workgroup>[0, %row] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x16xi32>
  %results = channel.bind<fifo> %slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, %row], [1, 1], [1, 1]) {
    %write, %payload = channel.reserve %results : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %values = vector.splat %value : vector<16xi32>
    vector.store %values, %payload[0] : vector<16xi32>, view<16xi32>
    channel.publish %write : write<tile<16xi32>>
    %read, %ready = channel.acquire %results : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %record = index.madd %phase, %lanes, %lane : index
    %offset = index.scale %record, %bytes : index, offset -> offset
    %destination = buffer.view %output[%offset] : buffer -> view<16xi32>
    %copy = kernel.async.copy %ready to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<16xi32>>
  }
}

pipeline.def @collect() run(%output: buffer, %local: i1) {
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %origin = index.constant 0 : offset
  %bytes = index.constant 12 : offset
  %capacity = index.constant 3 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<3x1xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<3x1xi32>, index -> channel<tile<1xi32>>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %count = index.constant 6 : index
  %last = index.constant 5 : index
  %row3 = index.constant 3 : index
  %row4 = index.constant 4 : index
  %stop_value = scalar.constant 0 : i32
  scf.if %local {
  } else {
    pipeline.compose @produce(%records) : (channel<tile<1xi32>>)
  }
  pipeline.serial {
    scf.for %phase = [%begin to %count step %step] {
      scf.if %local {
        %remaining = index.sub %last, %phase : index
        %value = index.cast %remaining : index to i32
        pipeline.compose @publish(%records, %value) : (channel<tile<1xi32>>, i32)
      }
      %read, %payload = channel.acquire %records : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
      %value = view.load %payload[0] : view<1xi32> -> i32
      %work = scalar.cmpi ne, %value, %stop_value : i32
      channel.release %read : read<tile<1xi32>>
      scf.if %work {
        pipeline.compose @emit_value(%output, %value, %phase, %row3, %begin) : (buffer, i32, index, index, index)
        pipeline.compose @emit_value(%output, %value, %phase, %row4, %step) : (buffer, i32, index, index, index)
      }
    }
  }
}

pipeline.def<kernel> public retain target(@device) @local_reader() run(%output_argument: buffer) {
  %output = buffer.assume.alignment %output_argument {minimum_alignment = 64} : buffer
  %local = scalar.constant true : i1
  pipeline.compose @collect(%output, %local) : (buffer, i1)
}

pipeline.def<kernel> public retain target(@device) @neighbor_reader() run(%output_argument: buffer) {
  %output = buffer.assume.alignment %output_argument {minimum_alignment = 64} : buffer
  %local = scalar.constant false : i1
  pipeline.compose @collect(%output, %local) : (buffer, i1)
}

func.def @reference(%output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %count = index.constant 5 : index
  %lanes = index.constant 32 : index
  %values = buffer.view %output[%origin] : buffer -> view<5x32xi32>
  scf.for %phase = [%begin to %count step %step] {
    %remaining = index.sub %count, %phase : index
    %value = index.cast %remaining : index to i32
    scf.for %lane = [%begin to %lanes step %step] {
      view.store %value, %values[%phase, %lane] : i32, view<5x32xi32>
    }
  }
  func.return
}

check.scenario public @collective_local_reader {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-7777) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@local_reader, @reference>(%output) : (tensor<192xi32>) -> () {
      check.expect.equal actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.return
}

check.scenario public @collective_neighbor_reader {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-7777) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@neighbor_reader, @reference>(%output) : (tensor<192xi32>) -> () {
      check.expect.equal actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.return
}
