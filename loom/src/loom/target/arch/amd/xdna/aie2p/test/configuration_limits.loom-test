  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %memory_row = constant 1 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/046 {column="0", row="1", columns="1"}
  program.load %zero, %memory_row, @worker
  return
}

