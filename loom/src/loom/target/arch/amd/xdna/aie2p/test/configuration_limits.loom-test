  %status = constant 2224128 : reg<aie2p.config.scalar : i64>
  %mask = constant 5 : reg<aie2p.config.scalar : i64>
  %value = constant 2 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/052 {mask="5", value="2"}
  wait.mask32 %status, %mask, %value
  return
}

