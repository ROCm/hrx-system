  %unaligned = constant 2588609 : reg<aie2p.config.scalar : i64>
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/042 {operand_name="address", value="2588609", alignment="4"}
  write32 %unaligned, %zero
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @invoke() asm {
  return
}

