// ====
// RUN: emit aie2p-xdna

// Unused declarations obey the same dense ABI order as used bindings.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @with_unused_arguments() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  %skipped_ordinal = constant 1 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/043 {actual="1", expected="0"}
  binding.unused %skipped_ordinal
  return
}

// ====
// Address-only updates preserve packet flags without supplying address bits.
// RUN: emit aie2p-xdna

aie2p.target<configuration> @configuration_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration_target) abi(array_program) @stream() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @initialize() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @invoke() asm {
  %origin = constant 0 : reg<aie2p.config.scalar : i64>
  %address_bits = constant 1 : reg<aie2p.config.scalar : i64>
  %extent = constant 64 : reg<aie2p.config.scalar : i64>
  %read_access = constant 1 : reg<aie2p.config.scalar : i64>
  %binding = binding %origin, %read_access, %extent, %extent
  %range = range %binding, %origin, %extent
  %address = constant 118788 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/047 {flags="1"}
  write.address %address, %range, %address_bits
  return
}

