aie2p.target<array> @array_target

aie2p.target<core> @core_target

func.def target(@core_target) @add(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs[%base] : buffer -> view<1xi32>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %left = view.load %lhs_view[0] : view<1xi32> -> i32
  %right = view.load %rhs_view[0] : view<1xi32> -> i32
  %sum = scalar.addi %left, %right : i32
  view.store %sum, %output_view[0] : i32, view<1xi32>
  func.return
}

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 3}) @single_stage_aliases() asm {
  %22 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %23 = group %22
  %24 = constant.u32 0 : reg<aie2p.array.scalar : index>
  %25 = worker %23, %24, @add
  %26 = binding 0, "read"
  %27 = binding 1, "write"
  %28 = binding 2, "write"
  %29 = sender %26, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %30 = receiver %25, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %31 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %32 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %33 = channel %29, %30, %31, %32 : reg<aie2p.array.channel : tile<1xi32>>
  %34 = receiver %25, 1 : reg<aie2p.array.receiver : tile<1xi32>>
  %35 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %36 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %37 = channel %29, %34, %35, %36 : reg<aie2p.array.channel : tile<1xi32>>
  %38 = sender %25, 2 : reg<aie2p.array.sender : tile<1xi32>>
  %39 = receiver %27, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %40 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %41 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %42 = channel %38, %39, %40, %41 : reg<aie2p.array.channel : tile<1xi32>>
  %43 = sender %25, 2 : reg<aie2p.array.sender : tile<1xi32>>
  %44 = receiver %28, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %45 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %46 = constant.u32 1 : reg<aie2p.array.scalar : index>
  %47 = channel %43, %44, %45, %46 : reg<aie2p.array.channel : tile<1xi32>>
  %48 = constant.u32 0 : reg<aie2p.array.scalar : index>
  %49 = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %25, %48, %49
  return
}
