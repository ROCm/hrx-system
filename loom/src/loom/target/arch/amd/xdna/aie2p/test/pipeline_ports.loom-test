func.def target(@core_target) @interleaved_aliases$group$0(%34: buffer, %35: buffer, %36: buffer) {
  %base$37 = index.constant 0 : offset
  %input_view$38 = buffer.view %34[%base$37] : buffer -> view<1xi32>
  %output_view$39 = buffer.view %35[%base$37] : buffer -> view<1xi32>
  %value$40 = view.load %input_view$38[0] : view<1xi32> -> i32
  view.store %value$40, %output_view$39[0] : i32, view<1xi32>
  %base$41 = index.constant 0 : offset
  %input_view$42 = buffer.view %35[%base$41] : buffer -> view<1xi32>
  %output_view$43 = buffer.view %36[%base$41] : buffer -> view<1xi32>
  %value$44 = view.load %input_view$42[0] : view<1xi32> -> i32
  view.store %value$44, %output_view$43[0] : i32, view<1xi32>
  func.return
}

func.def target(@core_target) @interleaved_aliases$group$1(%45: buffer, %46: buffer, %47: buffer) {
  %48 = index.constant 4 : offset
  %49 = buffer.alloca<private> align(64) %48 : buffer
  %base$50 = index.constant 0 : offset
  %lhs_view$51 = buffer.view %45[%base$50] : buffer -> view<1xi32>
  %rhs_view$52 = buffer.view %45[%base$50] : buffer -> view<1xi32>
  %output_view$53 = buffer.view %49[%base$50] : buffer -> view<1xi32>
  %left$54 = view.load %lhs_view$51[0] : view<1xi32> -> i32
  %right$55 = view.load %rhs_view$52[0] : view<1xi32> -> i32
  %sum$56 = scalar.addi %left$54, %right$55 : i32
  view.store %sum$56, %output_view$53[0] : i32, view<1xi32>
  %base$57 = index.constant 0 : offset
  %lhs_view$58 = buffer.view %46[%base$57] : buffer -> view<1xi32>
  %rhs_view$59 = buffer.view %49[%base$57] : buffer -> view<1xi32>
  %output_view$60 = buffer.view %47[%base$57] : buffer -> view<1xi32>
  %left$61 = view.load %lhs_view$58[0] : view<1xi32> -> i32
  %right$62 = view.load %rhs_view$59[0] : view<1xi32> -> i32
  %sum$63 = scalar.addi %left$61, %right$62 : i32
  view.store %sum$63, %output_view$60[0] : i32, view<1xi32>
  func.return
}

