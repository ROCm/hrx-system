  %101 = receiver %75, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %102 = constant.u32 2 : reg<aie2p.array.scalar : index>
  %103 = constant.u32 1 : reg<aie2p.array.scalar : index>
