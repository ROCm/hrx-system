// RUN: pass aie2p-lower-pipeline

// Interleaved groups retain first-demand port order. Repeated uses of %partial
// share a receive, while %buffered has its own receive contract. Both versions
// use one producer send. The later producer stage reads that exported storage;
// the consumer stages share a private intermediate.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

func.def target(@core_target) @copy(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  view.store %value, %output_view[0] : i32, view<1xi32>
  func.return
}

func.def target(@core_target) @add(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs[%base] : buffer -> view<1xi32>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %left = view.load %lhs_view[0] : view<1xi32> -> i32
  %right = view.load %rhs_view[0] : view<1xi32> -> i32
  %sum = scalar.addi %left, %right : i32
  view.store %sum, %output_view[0] : i32, view<1xi32>
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @interleaved_aliases() launch(%input: buffer, %copy_output: buffer, %sum_output: buffer, %alias_output: buffer) {
  %c1 = index.constant 1 : index
  %base = index.constant 0 : offset
  %producer = group.create %c1 : index -> group
  %consumer = group.create %c1 : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %copy_view = buffer.view %copy_output[%base] : buffer -> view<1xi32>
  %sum_view = buffer.view %sum_output[%base] : buffer -> view<1xi32>
  %alias_view = buffer.view %alias_output[%base] : buffer -> view<1xi32>
  %source = pipeline.read %input_view on %producer : view<1xi32>, group -> pipeline.flow<tile<1xi32>>
  %partial = pipeline.stage @copy on %producer(%source) : (group, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  %buffered = pipeline.buffer %partial capacity %c1 : (pipeline.flow<tile<1xi32>>, index) -> pipeline.flow<tile<1xi32>>
  %doubled = pipeline.stage @add on %consumer(%partial, %partial) : (group, pipeline.flow<tile<1xi32>>, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  %copied = pipeline.stage @copy on %producer(%partial) : (group, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  %sum = pipeline.stage @add on %consumer(%buffered, %doubled) : (group, pipeline.flow<tile<1xi32>>, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  pipeline.write %copied to %copy_view : pipeline.flow<tile<1xi32>>, view<1xi32>
  pipeline.write %sum to %sum_view : pipeline.flow<tile<1xi32>>, view<1xi32>
  pipeline.write %buffered to %alias_view : pipeline.flow<tile<1xi32>>, view<1xi32>
  pipeline.return
}

