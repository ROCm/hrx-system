// ====
// RUN: pass aie2p-lower-pipeline

// A single-stage callable retains both input arguments even when they carry
// the same flow. Writes of the result and its buffer alias share output port 2
// and remain separate edges to the two launch bindings.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

func.def target(@core_target) @add(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs[%base] : buffer -> view<1xi32>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %left = view.load %lhs_view[0] : view<1xi32> -> i32
  %right = view.load %rhs_view[0] : view<1xi32> -> i32
  %sum = scalar.addi %left, %right : i32
  view.store %sum, %output_view[0] : i32, view<1xi32>
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @single_stage_aliases() launch(%input: buffer, %output: buffer, %alias_output: buffer) {
  %c1 = index.constant 1 : index
  %base = index.constant 0 : offset
  %worker = group.create %c1 : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %alias_view = buffer.view %alias_output[%base] : buffer -> view<1xi32>
  %source = pipeline.read %input_view on %worker : view<1xi32>, group -> pipeline.flow<tile<1xi32>>
  %result = pipeline.stage @add on %worker(%source, %source) : (group, pipeline.flow<tile<1xi32>>, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  %buffered = pipeline.buffer %result capacity %c1 : (pipeline.flow<tile<1xi32>>, index) -> pipeline.flow<tile<1xi32>>
  pipeline.write %result to %output_view : pipeline.flow<tile<1xi32>>, view<1xi32>
  pipeline.write %buffered to %alias_view : pipeline.flow<tile<1xi32>>, view<1xi32>
  pipeline.return
}

