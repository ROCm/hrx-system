load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_TARGET_RECORDS_VISIBILITY = [
    "//loom/binding/c/target/amdgpu:__pkg__",
    "//loom/src/loom/target/arch/amdgpu:__pkg__",
    "//loom/src/loom/target/arch/amdgpu/lower:__pkg__",
    "//loom/src/loom/target/arch/amdgpu/ops:__pkg__",
    "//loom/src/loom/target/emit/native/amdgpu:__pkg__",
    "//loom/src/loom/tooling/target/amdgpu:__pkg__",
]

_AMDGPU_TARGET_RECORDS_TABLES_VISIBILITY = _AMDGPU_TARGET_RECORDS_VISIBILITY + [
    "//loom/src/loom/target/arch/amdgpu/lower:__pkg__",
]

loom_cc_library(
    name = "target_records_tables",
    textual_hdrs = ["//loom/src/loom/target/arch/amdgpu:target_records_tables.inl"],
    visibility = _AMDGPU_TARGET_RECORDS_TABLES_VISIBILITY,
)

loom_cc_library(
    name = "target_records",
    srcs = ["target_records.c"],
    hdrs = ["target_records.h"],
    visibility = _AMDGPU_TARGET_RECORDS_VISIBILITY,
    deps = [
        ":target_records_tables",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//runtime/src/iree/base",
    ],
)
