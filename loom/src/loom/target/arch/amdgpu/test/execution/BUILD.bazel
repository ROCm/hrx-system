load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files([
    "divergent_loop_carry.loom",
    "fragment_repack_bf16.loom",
    "fp8_encode.loom",
    "fp8_finite_storage_decode.loom",
    "global_atomic_add_f32.loom",
    "gfx11_wmma_families.loom",
    "gfx9_4_mfma_families.loom",
    "loop_carried_lane_liveness.loom",
    "mxfp4_decode_bf16.loom",
    "target_specialized_launch_config.loom",
    "workgroup_scan_wave64.loom",
])

_BEHAVIOR_QUALIFICATION_CASES = [
    {
        "config_args": [],
        "name": "fragment_repack_bf16",
        "source": "fragment_repack_bf16.loom",
    },
    {
        "config_args": [
            "--config=finite_storage_decode.row_capacity=65",
            "--config=finite_storage_decode.input_capacity=4608",
            "--config=finite_storage_decode.output_capacity=16",
        ],
        "name": "fp8_finite_storage_decode",
        "source": "fp8_finite_storage_decode.loom",
    },
    {
        "config_args": [],
        "name": "gfx11_wmma_families",
        "source": "gfx11_wmma_families.loom",
    },
    {
        "config_args": [],
        "name": "gfx9_4_mfma_families",
        "source": "gfx9_4_mfma_families.loom",
    },
    {
        "config_args": [],
        "name": "loop_carried_lane_liveness",
        "source": "loop_carried_lane_liveness.loom",
    },
]

_AMDGPU_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
])

_AMDGPU_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

_AMDGPU_EXECUTION_TEST_TAGS = [
    "iree-run-requirement=runtime.resource.amd_gpu",
    "requires-gpu-amd",
    "runtime-resource=amd-gpu",
]

[
    iree_executable_test(
        name = _case["name"] + "_plan_test",
        src = "//loom/src/loom/tools/iree-benchmark-loom",
        args = [
            "$(location %s)" % _case["source"],
            "--dry-run",
        ] + _case["config_args"],
        data = [
            _case["source"],
        ],
        tags = ["hostonly"],
        target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    )
    for _case in _BEHAVIOR_QUALIFICATION_CASES
]

[
    iree_executable_test(
        name = _case["name"] + "_amdgpu_test",
        src = "//loom/src/loom/tools/iree-benchmark-loom",
        args = [
            "$(location %s)" % _case["source"],
            "--device=amdgpu",
            "--measure=dispatch_complete",
            "--iterations=1",
            "--warmup-iterations=0",
            "--batch-size=1",
            "--min-time-ms=0",
            "--max-batches=1",
            "--input-ring-count=1",
        ] + _case["config_args"],
        data = [
            _case["source"],
        ],
        tags = _AMDGPU_EXECUTION_TEST_TAGS + ["manual"],
        target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    )
    for _case in _BEHAVIOR_QUALIFICATION_CASES
]

iree_execution_test_suite(
    name = "divergent_loop_carry_execution_test",
    data = [
        "divergent_loop_carry.loom",
    ],
    manifests = ["divergent_loop_carry.test.json"],
    tags = _AMDGPU_EXECUTION_TEST_TAGS + ["manual"],
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    tools = {
        "iree-test-loom": "//loom/src/loom/tools/iree-test-loom",
    },
)

iree_execution_test_suite(
    name = "numeric_conversion_execution_test",
