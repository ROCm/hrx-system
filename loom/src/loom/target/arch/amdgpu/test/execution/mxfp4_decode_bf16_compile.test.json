{
  "version": 1,
  "cases": [
    {
      "name": "compiles group-scaled FP4 decode for gfx942",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/mxfp4_decode_bf16.loom",
          "--root=@decode_mxfp4_second_group_bits",
          "--backend=amdgpu-hal",
          "--target=gfx942",
          "--output={tmp}/gfx942.vmfb",
          "--emit-target-artifact={tmp}/gfx942.hsaco"
        ]
      },
      "files": [
        {
          "path": "{tmp}/gfx942.vmfb",
          "non_empty": true
        },
        {
          "path": "{tmp}/gfx942.hsaco",
          "non_empty": true
        }
      ]
    },
