check.case public @f32_to_bf8_subnormal_case {
  %row_count = check.literal value(257) : index
  %seed = check.param.seed base(0x4633324246385355) count(1) : i64
  %input = check.generate.random.uniform seed(%seed) range(-0.0001 to 0.0001) : tensor<[%row_count]x4xf32>
