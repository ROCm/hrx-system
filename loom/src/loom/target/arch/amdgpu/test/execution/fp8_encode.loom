  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%row_count]x4xf8E5M2, #dense>
  scf.if %in_bounds {
    %source = vector.load %input_view[%row, %zero] : view<[%row_count]x4xf32, #dense> -> vector<4xf32>
    %encoded = vector.fptrunc %source : vector<4xf32> to vector<4xf8E5M2>
    vector.store %encoded, %output_view[%row, %zero] : vector<4xf8E5M2>, view<[%row_count]x4xf8E5M2, #dense>
  }
