  %row_count = check.literal value(257) : index
  %seed = check.param.seed base(0x463332424638) count(1) : i64
  %input = check.generate.random.uniform seed(%seed) range(-100000.0 to 100000.0) : tensor<[%row_count]x4xf32>
  %output = check.generate.fill value(0.0) : tensor<[%row_count]x4xf8E5M2>
  %expected = check.generate.random.uniform seed(%seed) range(-100000.0 to 100000.0) : tensor<[%row_count]x4xf8E5M2>
