// RUN: pass specialize-target-callgraph,inline-callables{policy=target,budget=0,hot-budget=0}

amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @full_banks(%value0: reg<amdgpu.sgpr x26>, %value1: reg<amdgpu.vgpr x32>) -> (reg<amdgpu.sgpr x26>, reg<amdgpu.vgpr x32>) asm {
  return %value0, %value1
}

low.func.def public target<amdgpu.gfx11.generic.core>(@target) @entry(%value0: reg<amdgpu.sgpr x26>, %value1: reg<amdgpu.vgpr x32>) -> (reg<amdgpu.sgpr x26>, reg<amdgpu.vgpr x32>) asm {
  %result0, %result1 = low.func.call @full_banks(%value0, %value1) : (reg<amdgpu.sgpr x26>, reg<amdgpu.vgpr x32>) -> (reg<amdgpu.sgpr x26>, reg<amdgpu.vgpr x32>)
  return %result0, %result1
}

