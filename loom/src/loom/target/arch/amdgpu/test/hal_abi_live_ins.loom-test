// RUN: pass amdgpu-materialize-hal-kernel-abi

amdgpu.target<gfx90a> @target

low.kernel.def target<amdgpu.cdna2.core>(@target) workgroup_size(64, 1, 1) @unsupported_live_in() asm {
  // ERROR@+1: AMDGPU/060 {source_name="amdgpu.workitem_id.y", workitem_layout="packed"}
  %coordinate = live_in<amdgpu.workitem_id.y> : reg<amdgpu.vgpr>
  return
}

