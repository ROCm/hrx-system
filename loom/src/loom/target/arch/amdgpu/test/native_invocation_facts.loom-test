// RUN: pass source-to-low,low-dce

amdgpu.target<gfx1201> @target {subgroup_size = 32}

low.func.def target<amdgpu.rdna4.core>(@target) @lane_value(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  return %value
}

// The native result's distribution reaches the integer merge through a
// forwarding arm. Placement does not depend on an immediate diamond shape.
func.def target(@target) @forwarded_native_selection(%input: f32) -> (i32) {
  %value = low.invoke @lane_value(%input) : (f32) -> (f32)
  %threshold = scalar.constant 0.0 : f32
  %positive_result = scalar.constant 1 : i32
  %negative_result = scalar.constant 2 : i32
  %positive = scalar.cmpf ogt, %value, %threshold : f32
  cfg.cond_br %positive, ^positive, ^negative
^positive:
  cfg.br ^forward
^forward:
  cfg.br ^join(%positive_result: i32)
^negative:
  cfg.br ^join(%negative_result: i32)
^join(%selected: i32):
  func.return %selected : i32
}

// ----
amdgpu.target<gfx1201> @target {subgroup_size = 32}

low.func.def target<amdgpu.rdna4.core>(@target) @lane_value(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  return %value
}

low.func.def target<amdgpu.rdna4.core>(@target) abi(hal_kernel) @forwarded_native_selection(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %value = low.func.call @lane_value(%input) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %positive = v_cmp_gt_f32_src1_inline %value {rhs = "f32_0_0"}
  %18, %19 = s_and_saveexec_b64 %positive
  low.cond_br %19, ^positive, ^_bb3 : reg<amdgpu.scc>
^positive:
  low.br ^forward
^forward:
  %23 = v_mov_b32 1
  low.br ^_bb5(%23: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %18
  %20 = v_mov_b32 2
  low.br ^join(%20: reg<amdgpu.vgpr>)
^_bb5(%selected$13: reg<amdgpu.vgpr>):
  s_mov_b64_exec %18
  %21 = v_mov_b32 2
  %22 = v_cndmask_b32 %21, %selected$13, %positive
  low.br ^join(%22: reg<amdgpu.vgpr>)
^join(%selected$12: reg<amdgpu.vgpr>):
  return %selected$12
^negative:
  %24 = v_mov_b32 2
  low.br ^join(%24: reg<amdgpu.vgpr>)
}

// ====
// RUN: emit source-low output=low

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def noinline target<amdgpu.rdna3_5.core>(@target) @scalar_words(%word: reg<amdgpu.sgpr>, %pair: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  return %word, %pair, %pair
}

// The same two-word carrier represents a uniform integer or a lane predicate
// according to the source signature. Numeric consumers stay scalar; selection
// by the predicate preserves each lane's result.
kernel.def target(@target) @numeric_words_and_lane_bits() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: i32, %wide: i64, %words: buffer, %pairs: buffer) {
  %word, %pair, %mask = low.invoke @scalar_words(%input, %wide) : (i32, i64) -> (i32, i64, i1)
  %increment = scalar.constant 1 : i32
  %wide_increment = scalar.constant 1 : i64
  %incremented = scalar.addi %word, %increment : i32
  %wide_incremented = scalar.addi %pair, %wide_increment : i64
  %selected = scf.select %mask, %word, %increment : i32
  %origin = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %word_results = buffer.view %words[%origin] : buffer -> view<64x2xi32>
  %pair_results = buffer.view %pairs[%origin] : buffer -> view<64xi64>
  view.store %incremented, %word_results[%lane, 0] : i32, view<64x2xi32>
  view.store %selected, %word_results[%lane, 1] : i32, view<64x2xi32>
  view.store %wide_incremented, %pair_results[%lane] : i64, view<64xi64>
  kernel.return
}

// ----
low.func.def noinline target<amdgpu.rdna3_5.core>(@target) @scalar_words(%word: reg<amdgpu.sgpr>, %pair: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  return %word, %pair, %pair
}

low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 3, direct_arg_count = 2, direct_arg_names = {arg0 = "input", arg1 = "wide"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 8], parameter_count = 4, resource_count = 2, resource_offsets = [16, 24], resource_parameter_indices = [2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @numeric_words_and_lane_bits(%input: reg<amdgpu.sgpr>, %wide: reg<amdgpu.sgpr x2>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %word_results = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %pair_results = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %word, %pair, %mask = low.func.call pure @scalar_words(%input, %wide) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>)
  %increment = s_mov_b32 1
  %37 = s_mov_b32 0
  %incremented = s_add_u32 %word, %increment
  %40 = slice %pair[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %41 = slice %pair[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %44, %45 = s_add_co_u32 %40, %increment
  %46, %47 = s_addc_u32 %41, %37, %45
  %49 = v_mov_b32_copy %word
  %selected = v_cndmask_b32_src0_inline %49, %mask {false_value = 1}
  %51 = v_mov_b32_copy %incremented
  %52 = v_lshlrev_b32_src0_inline %lane, 3
  global_store_b32_saddr %52, %51, %word_results
  global_store_b32_saddr %52, %selected, %word_results {offset = 4}
  %55 = v_mov_b32_copy %44
  %57 = v_mov_b32_copy %46
  %58 = concat(%55, %57) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %52, %58, %pair_results
  return
}

// ====
// The native signature remains scalar. Durable numeric results are copied at
// the call, before the divergent exit can retire lanes with different values.
amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

low.func.def target<amdgpu.gfx11.generic.core>(@target) @observe_pair(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %first = v_readfirstlane_b32 %value
  %pair = concat(%first, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %pair
}

func.def target(@target) @header_observation(%value: i32, %limit: index) -> (i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  cfg.br ^header(%begin: index)
^header(%counter: index):
  %observed = low.invoke @observe_pair(%value) : (i32) -> (i64)
  %more = index.cmp ult, %counter, %limit : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %step : index
  cfg.br ^header(%next: index)
^exit:
  func.return %observed : i64
}

// ----
amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

low.func.def target<amdgpu.gfx11.generic.core>(@target) @observe_pair(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %first = v_readfirstlane_b32 %value
  %pair = concat(%first, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %pair
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @header_observation(%value: reg<amdgpu.vgpr>, %limit: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %20 = v_mov_b32_copy %begin
  low.br ^_bb4(%20: reg<amdgpu.vgpr>)
^_bb4(%counter$17: reg<amdgpu.vgpr>):
  %28 = s_mov_b64_exec_read
  low.br ^header(%counter$17: reg<amdgpu.vgpr>)
^header(%counter$16: reg<amdgpu.vgpr>):
  %21 = low.func.call @observe_pair(%value) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>)
  %22 = slice %21[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %24 = slice %21[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = v_mov_b32_copy %24
  %observed = concat(%23, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %more = v_cmp_lt_u32 %counter$16, %limit
  %29, %30 = s_and_saveexec_b64 %more
  low.cond_br %30, ^body, ^_bb5 : reg<amdgpu.scc>
^body:
  %next = v_add_u32 %step, %counter$16
  low.br ^header(%next: reg<amdgpu.vgpr>)
^_bb5:
  s_mov_b64_exec %28
  low.br ^exit
^exit:
  return %observed
}
