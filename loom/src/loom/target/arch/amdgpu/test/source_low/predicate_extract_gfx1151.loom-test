// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A singleton predicate vector and its only element share the same mask.
func.def @single_predicate(%input: vector<1xi1>) -> (i1) {
  %result = vector.extract %input[0] : vector<1xi1> -> i1
  func.return %result : i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @single_predicate(%result: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  return %result
}

// ====

func.def @predicate_lanes(%input: vector<4xi1>) -> (i1, i1) {
  %first = vector.extract %input[0] : vector<4xi1> -> i1
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  func.return %first, %last : i1, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_lanes(%input: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %first = slice %input[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %last = slice %input[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  return %first, %last
}

// ====

// Both consumers use the original comparison results.
func.def @comparison_lane(%lhs: vector<4xi32>, %rhs: vector<4xi32>) -> (vector<4xi1>, i1) {
  %mask = vector.cmpi slt, %lhs, %rhs : vector<4xi32> -> vector<4xi1>
  %last = vector.extract %mask[3] : vector<4xi1> -> i1
  func.return %mask, %last : vector<4xi1>, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @comparison_lane(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.sgpr x8>, reg<amdgpu.sgpr x2>) asm {
  %10 = slice %lhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = slice %rhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %12 = v_cmp_lt_i32 %10, %11
  %13 = slice %lhs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %14 = slice %rhs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = v_cmp_lt_i32 %13, %14
  %16 = slice %lhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = slice %rhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = v_cmp_lt_i32 %16, %17
  %19 = slice %lhs[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %20 = slice %rhs[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = v_cmp_lt_i32 %19, %20
  %mask = concat(%12, %15, %18, %21) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x8>
  return %mask, %21
}

// ====

func.def @select_lane(%input: vector<4xi1>, %lhs: i32, %rhs: i32) -> (i32) {
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  %selected = scf.select %last, %lhs, %rhs : i32
  func.return %selected : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @select_lane(%input: reg<amdgpu.sgpr x8>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %last = slice %input[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32 %rhs, %lhs, %last
  return %selected
}

// ====

// A CFG merge preserves every work item's predicate before the final select.
func.def @merged_predicate(%input: vector<4xi1>, %choose_first: i1, %lhs: i32, %rhs: i32) -> (i32) {
  cfg.cond_br %choose_first, ^first, ^last
^first:
  %first = vector.extract %input[0] : vector<4xi1> -> i1
  cfg.br ^merge(%first: i1)
^last:
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  cfg.br ^merge(%last: i1)
^merge(%condition: i1):
  %selected = scf.select %condition, %lhs, %rhs : i32
  func.return %selected : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @merged_predicate(%input: reg<amdgpu.sgpr x8>, %choose_first: reg<amdgpu.sgpr x2>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %17, %18 = s_and_saveexec_b64 %choose_first
  low.cond_br %18, ^first, ^_bb5 : reg<amdgpu.scc>
^first:
  %first = slice %input[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  low.br ^_bb4(%first: reg<amdgpu.sgpr x2>)
^_bb4(%condition$15: reg<amdgpu.sgpr x2>):
  %26 = s_andn2_b64_exec %17, %choose_first
  low.cond_br %26, ^last, ^_bb6 : reg<amdgpu.scc>
^last:
  %last = slice %input[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  s_mov_b64_exec %17
  %21 = s_and_b64 %17, %choose_first
  %22 = s_and_b64 %21, %condition$15
  %23 = s_xor_b64 %21, %17
  %24 = s_and_b64 %23, %last
  %25 = s_or_b64 %22, %24
  low.br ^merge(%25: reg<amdgpu.sgpr x2>)
^merge(%condition$14: reg<amdgpu.sgpr x2>):
  %selected = v_cndmask_b32 %rhs, %lhs, %condition$14
  return %selected
^_bb5:
  s_mov_b64_exec %17
  %19 = s_mov_b32 0
  %20 = concat(%19, %19) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^_bb4(%20: reg<amdgpu.sgpr x2>)
^_bb6:
  s_mov_b64_exec %17
  low.br ^merge(%condition$15: reg<amdgpu.sgpr x2>)
}

// ====

func.def @extracted_predicate_integer(%mask: vector<4xi1>) -> (i32, i32) {
  %condition = vector.extract %mask[1] : vector<4xi1> -> i1
  %unsigned = scalar.extui %condition : i1 to i32
  %signed = scalar.extsi %condition : i1 to i32
  func.return %unsigned, %signed : i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @extracted_predicate_integer(%mask: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %condition = slice %mask[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %unsigned = v_cndmask_b32_src0_lit_src1_inline %condition {imm32 = 0, true_value = 1}
  %signed = v_cndmask_b32_src1_lit_src0_inline %condition {imm32 = 4294967295, false_value = 0}
  return %unsigned, %signed
}

// ====

func.def @dynamic_predicate_element(%mask: vector<4xi1>, %position: index) -> (i1) {
  %lane = index.assume %position [range(%position, 0, 3)] : index
  %selected = vector.extract %mask[%lane] : vector<4xi1> -> i1
  func.return %selected : i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @dynamic_predicate_element(%mask: reg<amdgpu.sgpr x8>, %lane: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %8 = slice %mask[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %9 = v_mov_b32 1
  %10 = v_cmp_eq_i32 %lane, %9
  %11 = slice %mask[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %12 = s_xor_b64 %8, %11
  %13 = s_and_b64 %12, %10
  %14 = s_xor_b64 %8, %13
  %15 = v_mov_b32 2
  %16 = v_cmp_eq_i32 %lane, %15
  %17 = slice %mask[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %18 = s_xor_b64 %14, %17
  %19 = s_and_b64 %18, %16
  %20 = s_xor_b64 %14, %19
  %21 = v_mov_b32 3
  %22 = v_cmp_eq_i32 %lane, %21
  %23 = slice %mask[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %24 = s_xor_b64 %20, %23
  %25 = s_and_b64 %24, %22
  %selected = s_xor_b64 %20, %25
  return %selected
}

// ====

func.def @predicate_tail_slice(%mask: vector<2x2xi1>) -> (vector<2xi1>) {
  %tail = vector.extract %mask[1] : vector<2x2xi1> -> vector<2xi1>
  func.return %tail : vector<2xi1>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_tail_slice(%mask: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x4>) asm {
  %tail = slice %mask[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x4>
  return %tail
}

// ====

func.def @multidimensional_predicate_element(%mask: vector<2x2xi1>) -> (i1) {
  %selected = vector.extract %mask[1, 0] : vector<2x2xi1> -> i1
  func.return %selected : i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @multidimensional_predicate_element(%mask: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x2>) asm {
  %selected = slice %mask[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  return %selected
}
