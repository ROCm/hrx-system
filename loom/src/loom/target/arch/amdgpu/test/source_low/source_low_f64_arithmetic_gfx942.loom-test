// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @native_f64(%lhs: f64, %rhs: f64, %addend: f64) -> (f64, f64, f64, f64) {
  %sum = scalar.addf %lhs, %rhs : f64
  %product = scalar.mulf %lhs, %rhs : f64
  %fused = scalar.fmaf %lhs, %rhs, %addend : f64
  %root = scalar.sqrtf %lhs : f64
  func.return %sum, %product, %fused, %root : f64, f64, f64, f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @native_f64(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>, %addend: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %sum = v_add_f64 %lhs, %rhs
  %product = v_mul_f64 %lhs, %rhs
  %fused = v_fma_f64 %lhs, %rhs, %addend
  %21 = v_mov_b32 0
  %22 = v_mov_b32 268435456
  %23 = v_mov_b32 1071644672
  %24 = concat(%21, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %25 = concat(%21, %23) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %26 = v_cmp_lt_f64 %lhs, %24
  %27 = v_mov_b32 256
  %28 = v_cndmask_b32 %21, %27, %26
  %29 = v_ldexp_f64 %lhs, %28
  %30 = v_rsq_f64 %29
  %31 = v_mul_f64 %29, %30
  %32 = v_mul_f64 %30, %25
  %33 = v_fma_f64_neg_a %32, %31, %25
  %34 = v_fma_f64 %32, %33, %32
  %35 = v_fma_f64 %31, %33, %31
  %36 = v_fma_f64_neg_a %35, %35, %29
  %37 = v_fma_f64 %36, %34, %35
  %38 = v_fma_f64_neg_a %37, %37, %29
  %39 = v_fma_f64 %38, %34, %37
  %40 = v_mov_b32 4294967168
  %41 = v_cndmask_b32 %21, %40, %26
  %42 = v_ldexp_f64 %39, %41
  %43 = s_mov_b32 608
  %44 = v_cmp_class_f64 %29, %43
  %45 = slice %42[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %46 = slice %29[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %47 = v_cndmask_b32 %45, %46, %44
  %48 = slice %42[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %49 = slice %29[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %50 = v_cndmask_b32 %48, %49, %44
  %root = concat(%47, %50) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %sum, %product, %fused, %root
}

// ====

func.def @compare_f64(%lhs: f64, %rhs: f64) -> (i1, i1) {
  %ordered = scalar.cmpf olt, %lhs, %rhs : f64
  %unordered = scalar.cmpf uno, %lhs, %rhs : f64
  func.return %ordered, %unordered : i1, i1
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @compare_f64(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %ordered = v_cmp_lt_f64 %lhs, %rhs
  %unordered = v_cmp_u_f64 %lhs, %rhs
  return %ordered, %unordered
}

// ====

func.def @convert_f64(%signed: i32, %unsigned: i32) -> (f64, f64) {
  %s = scalar.sitofp %signed : i32 to f64
  %u = scalar.uitofp %unsigned : i32 to f64
  func.return %s, %u : f64, f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @convert_f64(%signed: reg<amdgpu.vgpr>, %unsigned: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %s = v_cvt_f64_i32 %signed
  %u = v_cvt_f64_u32 %unsigned
  return %s, %u
}

// ====

func.def @compare_constant_f64(%lhs: f64) -> (i1) {
  %threshold = scalar.constant 1.0 : f64
  %result = scalar.cmpf olt, %lhs, %threshold : f64
  func.return %result : i1
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @compare_constant_f64(%lhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %6 = v_mov_b32 0
  %7 = v_mov_b32 1072693248
  %threshold = concat(%6, %7) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %result = v_cmp_lt_f64 %lhs, %threshold
  return %result
}

// ====

func.def @compare_to_f64(%lhs: f64, %rhs: f64) -> (f64) {
  %less = scalar.cmpf olt, %lhs, %rhs : f64
  %result = scalar.uitofp %less : i1 to f64
  func.return %result : f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @compare_to_f64(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %less = v_cmp_lt_f64 %lhs, %rhs
  %15 = s_mov_b32 0
  %16 = v_mov_b32_copy %15
  %17 = v_cndmask_b32_src1_inline %16, %less {true_value = 1}
  %result = v_cvt_f64_u32 %17
  return %result
}

// ====

func.def @unsigned_i64_to_f64(%bits: i64) -> (f64) {
  %result = scalar.uitofp %bits : i64 to f64
  func.return %result : f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @unsigned_i64_to_f64(%bits: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %5 = slice %bits[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %6 = slice %bits[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %7 = v_cvt_f64_u32 %5
  %8 = v_cvt_f64_u32 %6
  %9 = v_mov_b32 0
  %10 = v_mov_b32 1106247680
  %11 = concat(%9, %10) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %12 = v_mul_f64 %8, %11
  %result = v_add_f64 %12, %7
  return %result
}

// ====

func.def @signed_i64_to_f64(%bits: i64) -> (f64) {
  %result = scalar.sitofp %bits : i64 to f64
  func.return %result : f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @signed_i64_to_f64(%bits: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %5 = slice %bits[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %6 = slice %bits[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %7 = v_cvt_f64_u32 %5
  %8 = v_cvt_f64_i32 %6
  %9 = v_mov_b32 0
  %10 = v_mov_b32 1106247680
  %11 = concat(%9, %10) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %12 = v_mul_f64 %8, %11
  %result = v_add_f64 %12, %7
  return %result
}

// ====

func.def @subtract_f64(%lhs: f64, %rhs: f64) -> (f64) {
  %result = scalar.subf %lhs, %rhs : f64
  func.return %result : f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @subtract_f64(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %result = v_sub_f64 %lhs, %rhs
  return %result
}

// ====

func.def @change_f64_sign(%value: f64, %sign: f64) -> (f64, f64, f64) {
  %negative = scalar.negf %value : f64
  %absolute = scalar.absf %value : f64
  %copied = scalar.copysignf %value, %sign : f64
  func.return %negative, %absolute, %copied : f64, f64, f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @change_f64_sign(%value: reg<amdgpu.vgpr x2>, %sign: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %13 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = v_xor_b32_lit %14, 2147483648
  %negative = concat(%13, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %19 = v_and_b32_lit %14, 2147483647
  %absolute = concat(%13, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %23 = slice %sign[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %24 = s_mov_b32 2147483647
  %25 = v_bfi_b32 %24, %14, %23
  %copied = concat(%13, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %negative, %absolute, %copied
}

// ====

func.def @divide_f64(%numerator: f64, %denominator: f64) -> (f64) {
  %quotient = scalar.divf %numerator, %denominator : f64
  func.return %quotient : f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @divide_f64(%numerator: reg<amdgpu.vgpr x2>, %denominator: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %7, %8 = v_div_scale_f64 %denominator, %denominator, %numerator
  %9 = v_rcp_f64 %7
  %10 = v_fma_f64_neg_a_one %7, %9
  %11 = v_fma_f64 %9, %10, %9
  %12 = v_fma_f64_neg_a_one %7, %11
  %13, %14 = v_div_scale_f64 %numerator, %denominator, %numerator
  %15 = v_fma_f64 %11, %12, %11
  %16 = v_mul_f64 %13, %15
  %17 = v_fma_f64_neg_a %7, %16, %13
  %18 = v_div_fmas_f64 %17, %15, %16, %14
  %quotient = v_div_fixup_f64 %18, %denominator, %numerator
  return %quotient
}

// ====

func.def @approximate_sqrt_f64(%input: f64) -> (f64) {
  %root = scalar.sqrtf<afn> %input : f64
  func.return %root : f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @approximate_sqrt_f64(%input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %root = v_sqrt_f64 %input
  return %root
}

// ====

func.def @rsqrt_precision_f64(%input: f64) -> (f64, f64) {
  %exact = scalar.rsqrtf %input : f64
  %approximate = scalar.rsqrtf<afn> %input : f64
  func.return %exact, %approximate : f64, f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @rsqrt_precision_f64(%input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %11 = v_mov_b32 0
  %12 = v_mov_b32 1072693248
  %13 = concat(%11, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %15 = v_mov_b32 268435456
  %16 = v_mov_b32 1071644672
  %17 = concat(%11, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %18 = concat(%11, %16) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %19 = v_cmp_lt_f64 %input, %17
  %20 = v_mov_b32 256
  %21 = v_cndmask_b32 %11, %20, %19
  %22 = v_ldexp_f64 %input, %21
  %23 = v_rsq_f64 %22
  %24 = v_mul_f64 %22, %23
  %25 = v_mul_f64 %23, %18
  %26 = v_fma_f64_neg_a %25, %24, %18
  %27 = v_fma_f64 %25, %26, %25
  %28 = v_fma_f64 %24, %26, %24
  %29 = v_fma_f64_neg_a %28, %28, %22
  %30 = v_fma_f64 %29, %27, %28
  %31 = v_fma_f64_neg_a %30, %30, %22
  %32 = v_fma_f64 %31, %27, %30
  %33 = v_mov_b32 4294967168
  %34 = v_cndmask_b32 %11, %33, %19
  %35 = v_ldexp_f64 %32, %34
  %36 = s_mov_b32 608
  %37 = v_cmp_class_f64 %22, %36
  %38 = slice %35[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %39 = slice %22[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %40 = v_cndmask_b32 %38, %39, %37
  %41 = slice %35[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %42 = slice %22[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %43 = v_cndmask_b32 %41, %42, %37
  %44 = concat(%40, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %45, %46 = v_div_scale_f64 %44, %44, %13
  %47 = v_rcp_f64 %45
  %48 = v_fma_f64_neg_a_one %45, %47
  %49 = v_fma_f64 %47, %48, %47
  %50 = v_fma_f64_neg_a_one %45, %49
  %51, %52 = v_div_scale_f64 %13, %44, %13
  %53 = v_fma_f64 %49, %50, %49
  %54 = v_mul_f64 %51, %53
  %55 = v_fma_f64_neg_a %45, %54, %51
  %56 = v_div_fmas_f64 %55, %53, %54, %52
  %exact = v_div_fixup_f64 %56, %44, %13
  %approximate = v_rsq_f64 %input
  return %exact, %approximate
}
