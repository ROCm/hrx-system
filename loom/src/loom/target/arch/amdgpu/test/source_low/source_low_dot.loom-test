func.def @f32_exact_product_reduce(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %acc: f32) -> (f32) {
  %product = vector.mulf %lhs, %rhs : vector<4xf32>
  %dot = vector.reduce<addf> %product, %acc : vector<4xf32>, f32
  func.return %dot : f32
}

