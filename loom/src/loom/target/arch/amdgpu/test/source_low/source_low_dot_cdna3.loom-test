kernel.def target(@target) @f32_uniform_smem_vector_operands() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_buffer: buffer, %weights: buffer, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %lhs_view = buffer.view %lhs_buffer[%fixture_base] : buffer -> view<64x4xf32>
  %lhs = vector.load %lhs_view[%fixture_lane, 0] : view<64x4xf32> -> vector<4xf32>
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xf32>
  %base = index.constant 0 : offset
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  %weights_noalias = buffer.assume.noalias %weights_global : buffer
  %weights_view = buffer.view %weights_noalias[%base] : buffer -> view<2x4xf32>
  %rhs = vector.load %weights_view[0, 0] : view<2x4xf32> -> vector<4xf32>
  %bias_vector = vector.load %weights_view[1, 0] : view<2x4xf32> -> vector<4xf32>
  %bias = vector.extract %bias_vector[0] : vector<4xf32> -> f32
  %scaled = vector.mulf %lhs, %rhs : vector<4xf32>
  %dot = vector.dotf %scaled, %rhs, %bias : vector<4xf32>, vector<4xf32>, f32
  view.store %dot, %result_view_0[%fixture_lane] : f32, view<64xf32>
  kernel.return
}

