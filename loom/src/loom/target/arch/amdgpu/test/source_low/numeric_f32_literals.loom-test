// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @f32_inline_rounded_literal(%input: f32) -> (f32) {
  %scale = scalar.constant 0.15915493999999999 : f32
  %result = scalar.mulf %input, %scale : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @f32_inline_rounded_literal(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_mul_f32_src0_inline %input, "f32_inv_2pi"
  return %result
}
