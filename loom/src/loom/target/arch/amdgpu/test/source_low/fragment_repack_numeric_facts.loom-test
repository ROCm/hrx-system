amdgpu.target<gfx1100> @target

// Callable fragment transforms have no launch geometry or workitem live-ins.
func.def target(@target) @rdna_wave32_callable(%values: vector<8xf32>) -> (vector<16xbf16>) {
  %extent = index.constant 16 : index
  %result = vector.fragment<result> %values shape [%extent, %extent] : vector<8xf32>
  %lhs = vector.fragment.repack<lhs> %result shape [%extent, %extent] : vector<8xf32> -> vector<16xbf16>
  func.return %lhs : vector<16xbf16>
}

