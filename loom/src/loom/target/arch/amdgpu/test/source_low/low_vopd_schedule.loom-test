// RUN: emit amdgpu-vopd-plan-json @vopd_pairs_across_coalesced_copy strategy=source fixed=%a0:physical_register:0:1 fixed=%b0:physical_register:1:1 fixed=%a1:physical_register:2:1 fixed=%b1:physical_register:3:1 fixed=%product:physical_register:4:1 fixed=%product_copy:physical_register:4:1 fixed=%sum:physical_register:5:1

amdgpu.target<gfx1100> @target
low.func.def target(@target) @vopd_pairs_across_coalesced_copy(%a0: reg<amdgpu.vgpr>, %b0: reg<amdgpu.vgpr>, %a1: reg<amdgpu.vgpr>, %b1: reg<amdgpu.vgpr>) asm<amdgpu.rdna3.core> {
  %product = v_mul_f32 %a0, %b0
  %product_copy = copy %product : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %sum = v_add_f32 %a1, %b1
  return
}

