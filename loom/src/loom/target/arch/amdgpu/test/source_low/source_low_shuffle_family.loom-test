// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @i1_complete_mask_groups(%values: vector<3xi1>) -> (vector<3xi1>) {
  %result = vector.shuffle<[2, 0, 1]> %values : vector<3xi1>
  func.return %result : vector<3xi1>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @i1_complete_mask_groups(%values: reg<amdgpu.sgpr x6>) -> (reg<amdgpu.sgpr x6>) asm {
  %5 = slice %values[4] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr>
  %6 = slice %values[5] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr>
  %7 = slice %values[0] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr>
  %8 = slice %values[1] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr>
  %9 = slice %values[2] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr>
  %10 = slice %values[3] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr>
  %result = concat(%5, %6, %7, %8, %9, %10) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x6>
  return %result
}

