  %input_view = buffer.view %input[%base] : buffer -> view<2xf8E4M3, %layout>
  %payload = vector.load %input_view[0] : view<2xf8E4M3, %layout> -> vector<2xf8E4M3>
  %schema = encoding.define #matrix_operand<element_format=f8e4m3fnuz, payload_elements=2, payload_packing=dense_lanes, payload_registers=0> : encoding<schema>
  %wide = vector.decode %payload using %schema : vector<2xf8E4M3>, encoding<schema> -> vector<2xf32>
  %scale_vector = vector.splat %scale : vector<2xf32>
  %scaled = vector.mulf %wide, %scale_vector : vector<2xf32>
  %rounded = vector.fptrunc %scaled : vector<2xf32> to vector<2xbf16>
  func.return %rounded : vector<2xbf16>
}

