// RUN: verify

amdgpu.target<gfx1100> @gfx11_target

low.kernel.def target<amdgpu.rdna3.core>(@gfx11_target) workgroup_size(64, 1, 1) @gfx11_wmma_zero_hal_kernel() asm {
  %output = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %zero = v_mov_b32 0
  %a = concat(%zero, %zero, %zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %b = concat(%zero, %zero, %zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %acc_low = concat(%zero, %zero, %zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %acc = concat(%acc_low, %acc_low) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %wmma = v_wmma_i32_16x16x16_iu8 %a, %b, %acc
  %stored = slice %wmma[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %zero, %stored, %output
  return
}
