// RUN: pass source-to-low,low-dce

// The inner mask restores at the shared block before the uniform bypass joins.
amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

kernel.def target(@target) @uniform_outer_bypass() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%mode: i32, %value_buffer: buffer, %output: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %value_view = buffer.view %value_buffer[%fixture_base] : buffer -> view<64xf32>
  %value = view.load %value_view[%fixture_lane] : view<64xf32> -> f32
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<64xf32>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %mode, %c0 : i32
  cfg.cond_br %enabled, ^guard, ^shared
^guard:
  %threshold = scalar.constant 0.0 : f32
  %positive = scalar.cmpf ogt, %value, %threshold : f32
  cfg.cond_br %positive, ^store, ^shared
^store:
  view.store %value, %view[%fixture_lane] : f32, view<64xf32>
  cfg.br ^shared
^shared:
  cfg.br ^exit
^exit:
  kernel.return
}

// ----
amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "mode"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_outer_bypass(%mode: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %value_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  %value = global_load_b32_saddr %19, %value_view
  %c0 = s_mov_b32 0
  %enabled = s_cmp_lg_i32 %mode, %c0
  low.cond_br %enabled, ^guard, ^shared : reg<amdgpu.scc>
^guard:
  %positive = v_cmp_gt_f32_src1_inline %value {rhs = "f32_0_0"}
  %24, %25 = s_and_saveexec_b64 %positive
  low.cond_br %25, ^store, ^_bb3 : reg<amdgpu.scc>
^store:
  %26 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %26, %value, %view
  low.br ^_bb3
^_bb3:
  s_mov_b64_exec %24
  low.br ^shared
^shared:
  low.br ^exit
^exit:
  return
}

// ====

// Both masks keep their own restoration edge when the outer choice varies too.
amdgpu.target<gfx1201> @target {subgroup_size = 32}

func.def target(@target) @varying_outer_bypass(%mode: f32, %value: f32, %output: buffer) {
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<1xf32>
  %c0 = scalar.constant 0.0 : f32
  %enabled = scalar.cmpf une, %mode, %c0 : f32
  cfg.cond_br %enabled, ^guard, ^shared
^guard:
  %positive = scalar.cmpf ogt, %value, %c0 : f32
  cfg.cond_br %positive, ^store, ^shared
^store:
  view.store %value, %view[0] : f32, view<1xf32>
  cfg.br ^shared
^shared:
  cfg.br ^exit
^exit:
  func.return
}

// ----
amdgpu.target<gfx1201> @target {subgroup_size = 32}

low.func.def target<amdgpu.rdna4.core>(@target) abi(hal_kernel) @varying_outer_bypass(%mode: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %enabled = v_cmp_neq_f32_src1_inline %mode {rhs = "f32_0_0"}
  %12, %13 = s_and_saveexec_b64 %enabled
  low.cond_br %13, ^guard, ^_bb3 : reg<amdgpu.scc>
^guard:
  %positive = v_cmp_gt_f32_src1_inline %value {rhs = "f32_0_0"}
  %15, %16 = s_and_saveexec_b64 %positive
  low.cond_br %16, ^store, ^_bb4 : reg<amdgpu.scc>
^store:
  %17 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %17
  %20 = v_mov_b32_copy %18
  %21 = concat(%19, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %21, %value
  low.br ^_bb4
^_bb3:
  s_mov_b64_exec %12
  low.br ^exit
^_bb4:
  s_mov_b64_exec %15
  low.br ^shared
^shared:
  low.br ^_bb6
^_bb6:
  s_mov_b64_exec %12
  low.br ^exit
^exit:
  return
}
