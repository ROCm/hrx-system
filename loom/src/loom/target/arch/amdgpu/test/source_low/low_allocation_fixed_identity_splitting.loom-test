// A hard storage identity carries its fixed binding onto a detached repair
// result. Further cuts before that identity cannot shorten the fixed interval.
// RUN: emit amdgpu-assembly @fixed_identity amdgpu.sgpr=6

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @fixed_identity(%value: reg<amdgpu.vgpr>, %incoming_mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>) asm {
  %mask = low.assume %incoming_mask [] : reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %copy = copy %source : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^join(%copy: reg<amdgpu.sgpr>)
^join(%joined: reg<amdgpu.sgpr>):
  %result = s_or_b32 %joined, %source
  return %selected, %result
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_mov_b32 s3, s2
.Lbb1:
  s_or_b32 s2, s3, s2
  s_endpgm
