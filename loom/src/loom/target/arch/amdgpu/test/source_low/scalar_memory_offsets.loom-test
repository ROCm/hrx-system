// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(8, 1, 1) @uniform_offsets() asm {
  %group = live_in<amdgpu.cluster_id_x> : reg<amdgpu.sgpr>
  %tail_view = resource<hal_binding> {extent = 16777248, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %17 = s_mov_b32 0
  %packet = s_load_b96 %tail_view, %17 {offset = 8388604}
  %19 = s_lshl_b32_rhs_inline %group, 2
  %20 = s_mov_b32 8388612
  %21 = s_add_u32 %19, %20
  %tail = s_load_dword %tail_view, %21 {offset = 8388604}
  %23 = slice %packet[0] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %24 = v_mov_b32_copy %23
  %25 = slice %packet[1] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %26 = v_mov_b32_copy %25
  %27 = slice %packet[2] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %28 = v_mov_b32_copy %27
  %29 = concat(%24, %26, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %30 = v_mov_b32 0
  global_store_b96_saddr %30, %29, %result
  %31 = v_mov_b32_copy %tail
  global_store_b32_saddr %30, %31, %result {offset = 12}
  return
}
