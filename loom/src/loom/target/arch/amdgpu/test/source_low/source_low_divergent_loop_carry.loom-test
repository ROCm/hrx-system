// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

kernel.def target(@target) @divergent_loop_carry() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%upper_bounds: buffer, %values: buffer, %output: buffer) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %initial_count = scalar.constant 0 : i32
  %buffer_base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %upper_bound_view = buffer.view %upper_bounds[%buffer_base] : buffer -> view<64xi32>
  %value_view = buffer.view %values[%buffer_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %upper_bound_i32 = view.load %upper_bound_view[%lane] : view<64xi32> -> i32
  %upper_bound0 = index.cast %upper_bound_i32 : i32 to index
  %upper_bound = index.assume %upper_bound0 [range(%upper_bound0, 0, 64)] : index
  %count = scf.for %position = [%loop_begin to %upper_bound step %loop_step](%running_count = %initial_count : i32) -> (i32) {
    %bounded_position = index.assume %position [range(%position, 0, 63)] : index
    %value = view.load %value_view[%bounded_position] : view<64xi32> -> i32
    %next_count = scalar.addi %running_count, %value : i32
    scf.yield %next_count : i32
  }
  view.store %count, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @divergent_loop_carry() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %upper_bound_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %value_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %loop_begin = s_mov_b32 0
  %loop_step = s_mov_b32 1
  %39 = v_lshlrev_b32_src0_inline %lane, 2
  %upper_bound = global_load_b32_saddr %39, %upper_bound_view
  %41 = v_mov_b32 0
  low.br ^_bb4
^_bb1(%bounded_position: reg<amdgpu.sgpr>, %running_count: reg<amdgpu.vgpr>):
  %42 = v_mov_b32_copy %bounded_position
  %43 = v_cmp_lt_i32 %42, %upper_bound
  %45, %46 = s_and_saveexec_b64 %43
  low.cond_br %46, ^_bb2, ^_bb5 : reg<amdgpu.scc>
^_bb2:
  %47 = v_mov_b32 0
  %48 = s_lshl_b32_rhs_inline %bounded_position, 2
  %49 = slice %value_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %50 = slice %value_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %51 = s_mov_b32 0
  %52 = s_add_u32 %49, %48
  %53 = s_addc_u32 %50, %51
  %54 = concat(%52, %53) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_b32_saddr %47, %54
  %next_count = v_add_u32 %running_count, %value
  %57 = s_add_u32 %bounded_position, %loop_step
  low.br ^_bb1(%57: reg<amdgpu.sgpr>, %next_count: reg<amdgpu.vgpr>)
^_bb3:
  %58 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %58, %running_count, %output_view
  return
^_bb4:
  %44 = s_mov_b64_exec_read
  low.br ^_bb1(%loop_begin: reg<amdgpu.sgpr>, %41: reg<amdgpu.vgpr>)
^_bb5:
  s_mov_b64_exec %44
  low.br ^_bb3
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @while_carries_bitcast_vgpr(%pattern: f64, %mask: i64, %iteration_count: i32) -> (i64) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %bits = scalar.bitcast %pattern : f64 to i64
  %final_i, %final_bits = scf.while(%i = %c0 : i32, %state = %bits : i64) -> (i32, i64) {
    %keep_going = scalar.cmpi slt, %i, %iteration_count : i32
    scf.condition %keep_going, %i, %state : i1, i32, i64
  } do(%i: i32, %state: i64) {
    %next_state = scalar.xori %state, %mask : i64
    %next_i = scalar.addi %i, %c1 : i32
    scf.yield %next_i, %next_state : i32, i64
  }
  func.return %final_bits : i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @while_carries_bitcast_vgpr(%bits: reg<amdgpu.vgpr x2>, %mask: reg<amdgpu.sgpr x2>, %iteration_count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %c0 = s_mov_b32 0
  %c1 = s_mov_b32 1
  low.br ^_bb1(%c0: reg<amdgpu.sgpr>, %bits: reg<amdgpu.vgpr x2>)
^_bb1(%i: reg<amdgpu.sgpr>, %state: reg<amdgpu.vgpr x2>):
  %keep_going = s_cmp_lt_i32 %i, %iteration_count
  low.cond_br %keep_going, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %29 = slice %mask[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30 = v_mov_b32_copy %29
  %31 = slice %mask[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = v_mov_b32_copy %31
  %34 = slice %state[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %36 = v_xor_b32 %34, %30
  %37 = slice %state[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %39 = v_xor_b32 %37, %32
  %next_state = concat(%36, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %next_i = s_add_u32 %i, %c1
  low.br ^_bb1(%next_i: reg<amdgpu.sgpr>, %next_state: reg<amdgpu.vgpr x2>)
^_bb3:
  return %state
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @while_carries_nested_divergent_select(%values: vector<2xi32>, %iteration_count: i32, %limit: i32) -> (i32) {
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %final_i, %final_order = scf.while(%i = %c0 : i32, %order = %c0 : i32) -> (i32, i32) {
    %keep_going = scalar.cmpi slt, %i, %iteration_count : i32
    scf.condition %keep_going, %i, %order : i1, i32, i32
  } do(%i: i32, %order: i32) {
    %less = scalar.cmpi slt, %lane, %limit : i32
    %selected = scf.select %less, %c1, %c0 : i32
    %next_order = scalar.subi %c1, %selected : i32
    %next_i = scalar.addi %i, %c1 : i32
    scf.yield %next_i, %next_order : i32, i32
  }
  func.return %final_order : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @while_carries_nested_divergent_select(%values: reg<amdgpu.vgpr x2>, %iteration_count: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %lane = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %c0 = s_mov_b32 0
  %c1 = s_mov_b32 1
  %31 = v_mov_b32 0
  low.br ^_bb1(%c0: reg<amdgpu.sgpr>, %31: reg<amdgpu.vgpr>)
^_bb1(%i: reg<amdgpu.sgpr>, %order: reg<amdgpu.vgpr>):
  %keep_going = s_cmp_lt_i32 %i, %iteration_count
  low.cond_br %keep_going, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %33 = v_mov_b32_copy %limit
  %less = v_cmp_lt_i32 %lane, %33
  %selected = v_cndmask_b32_src0_lit_src1_inline %less {imm32 = 0, true_value = 1}
  %36 = v_mov_b32 1
  %next_order = v_sub_nc_u32 %36, %selected
  %next_i = s_add_u32 %i, %c1
  low.br ^_bb1(%next_i: reg<amdgpu.sgpr>, %next_order: reg<amdgpu.vgpr>)
^_bb3:
  return %order
}
