  %younger61 = global_load_b32_saddr %address, %base {offset = 248}
  %younger62 = global_load_b32_saddr %address, %base {offset = 252}
  %younger63 = global_load_b32_saddr %address, %base {offset = 256}
  low.br ^consume
^consume:
  %result = v_add_u32 %old, %address
  return %result
}
// ----
CHECK: s_waitcnt vmcnt(62)*
CHECK-NOT: s_waitcnt vmcnt(63) lgkmcnt(63)

// ====
// RUN: with-checks emit amdgpu-assembly @local_count_limit strategy=source

// The LDS counter has a smaller range on this family. Its reserved all-ones
// field must also remain distinct from the largest useful partial bound.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @local_count_limit(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %old = ds_read_b32 %address
  %younger0 = ds_read_b32 %address {offset = 4}
  %younger1 = ds_read_b32 %address {offset = 8}
  %younger2 = ds_read_b32 %address {offset = 12}
  %younger3 = ds_read_b32 %address {offset = 16}
  %younger4 = ds_read_b32 %address {offset = 20}
  %younger5 = ds_read_b32 %address {offset = 24}
  %younger6 = ds_read_b32 %address {offset = 28}
  %younger7 = ds_read_b32 %address {offset = 32}
  %younger8 = ds_read_b32 %address {offset = 36}
  %younger9 = ds_read_b32 %address {offset = 40}
  %younger10 = ds_read_b32 %address {offset = 44}
  %younger11 = ds_read_b32 %address {offset = 48}
  %younger12 = ds_read_b32 %address {offset = 52}
  %younger13 = ds_read_b32 %address {offset = 56}
  %younger14 = ds_read_b32 %address {offset = 60}
  %younger15 = ds_read_b32 %address {offset = 64}
  %sum0 = v_add_u32 %old, %younger0
  %sum1 = v_add_u32 %sum0, %younger1
  %sum2 = v_add_u32 %sum1, %younger2
  %sum3 = v_add_u32 %sum2, %younger3
  %sum4 = v_add_u32 %sum3, %younger4
  %sum5 = v_add_u32 %sum4, %younger5
  %sum6 = v_add_u32 %sum5, %younger6
  %sum7 = v_add_u32 %sum6, %younger7
  %sum8 = v_add_u32 %sum7, %younger8
  %sum9 = v_add_u32 %sum8, %younger9
  %sum10 = v_add_u32 %sum9, %younger10
  %sum11 = v_add_u32 %sum10, %younger11
  %sum12 = v_add_u32 %sum11, %younger12
  %sum13 = v_add_u32 %sum12, %younger13
  %sum14 = v_add_u32 %sum13, %younger14
  %sum15 = v_add_u32 %sum14, %younger15
  return %sum15
}

// ----
CHECK: s_waitcnt vmcnt(63) lgkmcnt(14)
CHECK-NOT: s_waitcnt vmcnt(63) lgkmcnt(15)
