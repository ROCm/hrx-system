  %younger4 = global_load_b32_saddr %address, %base {offset = 20}
  %younger5 = global_load_b32_saddr %address, %base {offset = 24}
  %younger6 = global_load_b32_saddr %address, %base {offset = 28}
  %younger7 = global_load_b32_saddr %address, %base {offset = 32}
  %younger8 = global_load_b32_saddr %address, %base {offset = 36}
  %younger9 = global_load_b32_saddr %address, %base {offset = 40}
  %younger10 = global_load_b32_saddr %address, %base {offset = 44}
  %younger11 = global_load_b32_saddr %address, %base {offset = 48}
  %younger12 = global_load_b32_saddr %address, %base {offset = 52}
  %younger13 = global_load_b32_saddr %address, %base {offset = 56}
  %younger14 = global_load_b32_saddr %address, %base {offset = 60}
  %younger15 = global_load_b32_saddr %address, %base {offset = 64}
  %younger16 = global_load_b32_saddr %address, %base {offset = 68}
  %younger17 = global_load_b32_saddr %address, %base {offset = 72}
  %younger18 = global_load_b32_saddr %address, %base {offset = 76}
