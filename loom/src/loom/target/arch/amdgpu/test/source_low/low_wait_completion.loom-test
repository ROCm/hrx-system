// RUN: emit amdgpu-assembly @copied_backedge_completes_result

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @copied_backedge_completes_result(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr>) asm {
  %increment = s_mov_b32 16
  %base_low = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %zero = s_mov_b32 0
  %base_high = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^loop(%seed: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>):
  %low, %low_carry = s_add_co_u32 %base_low, %increment
  %high, %high_carry = s_addc_u32 %base_high, %zero, %low_carry
  %address = concat(%low, %high) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %future = global_load_b32_saddr %offset, %address
  %used = v_add_u32 %carried, %offset
  low.br ^loop(%future: reg<amdgpu.vgpr>)
}

// The edge copy waits for the new result. Captured scalar address storage is
// independently reusable on the next iteration.
// ----
  s_mov_b32 s2, 16
  s_mov_b32 s3, 0
.Lbb1:
  s_add_u32 s4, s0, s2
  s_addc_u32 s5, s1, s3
  global_load_b32 v2, v1, s[4:5] offset:0
  v_add_u32 v0, v0, v1
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_mov_b32 v0, v2
  s_branch .Lbb1

// ====
// RUN: emit amdgpu-assembly @younger_backedge_result_does_not_retain_address

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @younger_backedge_result_does_not_retain_address(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr>, %initial_pending: reg<amdgpu.vgpr>) asm {
  %increment = s_mov_b32 16
  %base_low = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %zero = s_mov_b32 0
  %base_high = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^loop(%seed: reg<amdgpu.vgpr>, %initial_pending: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>, %pending: reg<amdgpu.vgpr>):
  %low, %low_carry = s_add_co_u32 %base_low, %increment
  %high, %high_carry = s_addc_u32 %base_high, %zero, %low_carry
  %address = concat(%low, %high) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %used = v_add_u32 %carried, %pending
  %future = global_load_b32_saddr %offset, %address
  %younger = global_load_b32_saddr %offset, %address {offset = 4}
  low.br ^loop(%future: reg<amdgpu.vgpr>, %younger: reg<amdgpu.vgpr>)
}

// Only the older result is copied. The younger result remains pending, but
// scalar address arithmetic can proceed before its consumer waits.
// ----
  s_mov_b32 s2, 16
  s_mov_b32 s3, 0
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v0, v1
  s_add_u32 s4, s0, s2
  s_addc_u32 s5, s1, s3
  global_load_b32 v0, v2, s[4:5] offset:0
  global_load_b32 v1, v2, s[4:5] offset:4
  s_branch .Lbb1

// ====
// RUN: emit amdgpu-assembly @both_paths_complete_result amdgpu.sgpr=2

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @both_paths_complete_result(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %condition: reg<amdgpu.scc>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = global_load_b32_saddr %offset, %base
  low.cond_br %condition, ^left, ^right : reg<amdgpu.scc>
^left:
  %left_use = v_add_u32 %loaded, %offset
  low.br ^join
^right:
  %right_use = v_add_u32 %loaded, %offset
  low.br ^join
^join:
  %replacement = s_mov_b32 16
  return %replacement
}

// Each predecessor consumes the load and waits independently. Captured scalar
// address storage is reusable at the join without another completion wait.
// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v1, v0
  s_branch .Lbb3
.Lbb2:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v1, v0
.Lbb3:
  s_mov_b32 s0, 16
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @bypass_reuses_captured_base amdgpu.sgpr=2

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @bypass_reuses_captured_base(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %condition: reg<amdgpu.scc>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = global_load_b32_saddr %offset, %base
  low.cond_br %condition, ^consume, ^join : reg<amdgpu.scc>
^consume:
  %used = v_add_u32 %loaded, %offset
  low.br ^join
^join:
  %replacement = s_mov_b32 16
  return %replacement
}

// The bypass need not consume the result. Neither path retains the captured
// scalar base, so the join overwrites it without a completion wait.
// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v1, v0
.Lbb2:
  s_mov_b32 s0, 16
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @new_producer_captures_base_before_edge amdgpu.sgpr=2

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @new_producer_captures_base_before_edge(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>) asm {
  %first = global_load_b32_saddr %offset, %base
  %used = v_add_u32 %first, %offset
  %second = global_load_b32_saddr %offset, %base {offset = 4}
  low.br ^join
^join:
  %replacement = s_mov_b32 16
  return %replacement
}

// The second result remains pending across the edge, but its scalar address
// was captured. Reusing the base does not require result completion.
// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  global_load_b32 v2, v0, s[0:1] offset:4
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v0, v1, v0
.Lbb1:
  s_mov_b32 s0, 16
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @translation_and_result_complete_before_backedge

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @translation_and_result_complete_before_backedge(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr>) asm {
  %increment = s_mov_b32 16
  %base_low = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %zero = s_mov_b32 0
  %base_high = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^loop(%seed: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>):
  %low, %low_carry = s_add_co_u32 %base_low, %increment
  %high, %high_carry = s_addc_u32 %base_high, %zero, %low_carry
  %address = concat(%low, %high) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %future = global_load_b32_saddr %offset, %address
  %used = v_add_u32 %carried, %offset
  low.br ^loop(%future: reg<amdgpu.vgpr>)
}

// The edge copy reads the new result and completes its address use. The next
// iteration can overwrite the address without waiting again.
// ----
  s_mov_b32 s2, 16
  s_mov_b32 s3, 0
.Lbb1:
  s_add_u32 s4, s0, s2
  s_addc_u32 s5, s1, s3
  global_load_b32 v2, v1, s[4:5] offset:0
  v_add_u32 v0, v0, v1
  s_wait_loadcnt loadcnt(0)
  v_mov_b32 v0, v2
  s_branch .Lbb1

// ====
// RUN: emit amdgpu-assembly @translation_release_keeps_younger_result_pending

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @translation_release_keeps_younger_result_pending(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr>, %initial_pending: reg<amdgpu.vgpr>) asm {
  %increment = s_mov_b32 16
  %base_low = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %zero = s_mov_b32 0
  %base_high = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^loop(%seed: reg<amdgpu.vgpr>, %initial_pending: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>, %pending: reg<amdgpu.vgpr>):
  %low, %low_carry = s_add_co_u32 %base_low, %increment
  %high, %high_carry = s_addc_u32 %base_high, %zero, %low_carry
  %address = concat(%low, %high) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %used = v_add_u32 %carried, %pending
  %future = global_load_b32_saddr %offset, %address
  %younger = global_load_b32_saddr %offset, %address {offset = 4}
  low.br ^loop(%future: reg<amdgpu.vgpr>, %younger: reg<amdgpu.vgpr>)
}

// The branch completes address translation without completing the younger
// result. The next iteration still waits before consuming that payload.
// ----
  s_mov_b32 s2, 16
  s_mov_b32 s3, 0
.Lbb1:
  s_wait_loadcnt loadcnt(0)
  v_add_u32 v0, v0, v1
  s_add_u32 s4, s0, s2
  s_addc_u32 s5, s1, s3
  global_load_b32 v0, v2, s[4:5] offset:0
  global_load_b32 v1, v2, s[4:5] offset:4
  s_branch .Lbb1
