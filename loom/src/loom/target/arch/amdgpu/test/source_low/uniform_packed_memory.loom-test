// RUN: with-checks emit source-low target=amdgpu:gfx1151 output=low

// Every workitem reads the same codebook with independently selected indices.
kernel.def @uniform_table() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %codebook: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %codebook {minimum_alignment = 64} : buffer
  %source, %table_source, %destination = buffer.assume.noalias %input, %aligned, %output : buffer, buffer, buffer
  %c0 = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %source_view = buffer.view %source[%c0] : buffer -> view<32x4xi8>
  %input_values = vector.load %source_view[%lane, 0] : view<32x4xi8> -> vector<4xi8>
  %mask = vector.constant 15 : vector<4xi8>
  %indices = vector.andi %input_values, %mask : vector<4xi8>
  %table_view = buffer.view %table_source[%c0] : buffer -> view<16xi8>
  %table = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %values = vector.table.lookup %table[%indices] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  %output_view = buffer.view %destination[%c0] : buffer -> view<32x4xi8>
  vector.store %values, %output_view[%lane, 0] : vector<4xi8>, view<32x4xi8>
  kernel.return
}

// ----
CHECK: %table = s_load_dwordx4 *, *
CHECK: * = slice %table[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
CHECK: * = v_perm_b32 *, *, *
CHECK-NOT: * = v_mov_b32_copy *

// ====

kernel.def @uniform_i8() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<8xi8>
  %value = vector.load %source_view[0] : view<8xi8> -> vector<8xi8>
  %result = vector.addi %value, %value : vector<8xi8>
  %output_view = buffer.view %destination[%c0] : buffer -> view<8xi8>
  vector.store %result, %output_view[0] : vector<8xi8>, view<8xi8>
  kernel.return
}

// ----
CHECK: %value = s_load_dwordx2 *, *
CHECK-NOT: * = global_load_*

