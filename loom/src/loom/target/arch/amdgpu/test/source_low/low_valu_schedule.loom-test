// Independent chains can issue while earlier VALU results are pending. Each
// family uses its own timing model and shared wave issue capacity. These
// operations cannot form VOPD pairs.

// RUN: emit amdgpu-assembly @independent_chains strategy=resource-stall

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @independent_chains(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %d: reg<amdgpu.vgpr>, %e: reg<amdgpu.vgpr>, %bias: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %a_sum = v_add3_u32 %a, %bias, %bias
  %a_next = v_add3_u32 %a_sum, %bias, %bias
  %b_sum = v_add3_u32 %b, %bias, %bias
  %b_next = v_add3_u32 %b_sum, %bias, %bias
  %c_sum = v_add3_u32 %c, %bias, %bias
  %c_next = v_add3_u32 %c_sum, %bias, %bias
  %d_sum = v_add3_u32 %d, %bias, %bias
  %d_next = v_add3_u32 %d_sum, %bias, %bias
  %e_sum = v_add3_u32 %e, %bias, %bias
  %e_next = v_add3_u32 %e_sum, %bias, %bias
  return %a_next, %b_next, %c_next, %d_next, %e_next
}

// ----
  v_add3_u32 v0, v0, v5, v5
  v_add3_u32 v1, v1, v5, v5
  v_add3_u32 v2, v2, v5, v5
  v_add3_u32 v3, v3, v5, v5
  v_add3_u32 v4, v4, v5, v5
  v_add3_u32 v0, v0, v5, v5
  v_add3_u32 v1, v1, v5, v5
  v_add3_u32 v2, v2, v5, v5
  v_add3_u32 v3, v3, v5, v5
  v_add3_u32 v4, v4, v5, v5
  s_endpgm

