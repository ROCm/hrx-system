// ====

amdgpu.target<gfx1100> @target

kernel.def target(@target) @dynamic_workgroup_count(%workgroups_x: index, %workgroups_y: index, %workgroups_z: index) {
  %c4 = index.constant 4 : index
  %c64 = index.constant 64 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroups_x, %workgroups_y, %workgroups_z) workgroup_size(%c64, %c4, %c1) : index
} launch(%output: buffer) {
  %count_x = kernel.workgroup.count<x> : index
  %count_x_again = kernel.workgroup.count<x> : index
  %count_y = kernel.workgroup.count<y> : index
  %count_z = kernel.workgroup.count<z> : index
  %count_xy = index.add %count_x, %count_y : index
  %count_xyz = index.add %count_xy, %count_z : index
  %count = index.add %count_xyz, %count_x_again : index
  %count_i32 = index.cast %count : index to i32
  %result = vector.from_elements %count_i32 : vector<1xi32>
  %zero = index.constant 0 : offset
  %output_view = buffer.view %output[%zero] : buffer -> view<1xi32, #dense>
  vector.store %result, %output_view[0] : vector<1xi32>, view<1xi32, #dense>
  kernel.return
}

// ----
low.kernel.def target(@target) workgroup_size(64, 4, 1) @dynamic_workgroup_count() asm<amdgpu.rdna3.core> {
  %19 = live_in<amdgpu.dispatch_ptr> : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %21 = s_load_dword_offset_only %19 {offset = 12}
  %22 = s_mov_b32 6
  %count_x = s_lshr_b32 %21, %22
  %24 = s_load_dword_offset_only %19 {offset = 16}
  %25 = s_mov_b32 2
  %count_y = s_lshr_b32 %24, %25
  %count_z = s_load_dword_offset_only %19 {offset = 20}
  %count_xy = s_add_u32 %count_x, %count_y
  %count_xyz = s_add_u32 %count_xy, %count_z
  %count_i32 = s_add_u32 %count_xyz, %count_x
  %result = v_mov_b32_copy %count_i32
  %32 = v_mov_b32 0
  global_store_b32_saddr %32, %result, %output_view
  return
}

// ====

amdgpu.target<gfx1100> @target {subgroup_size = 64}

kernel.def target(@target) @target_subgroup_queries_use_wavefront_size() {
  %c1 = index.constant 1 : index
  %c128 = index.constant 128 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%output: buffer) {
  %subgroup_size = kernel.subgroup.size : index
  %subgroup_count = kernel.subgroup.count : index
  %sum = index.add %subgroup_size, %subgroup_count : index
  %sum_i32 = index.cast %sum : index to i32
  %value = vector.splat %sum_i32 : vector<1xi32>
  %zero = index.constant 0 : offset
  %output_view = buffer.view %output[%zero] : buffer -> view<1xi32, #dense>
  vector.store %value, %output_view[0] : vector<1xi32>, view<1xi32, #dense>
  kernel.return
}

// ----
low.kernel.def target(@target) workgroup_size(128, 1, 1) workgroup_count(1, 1, 1) @target_subgroup_queries_use_wavefront_size() asm<amdgpu.rdna3.core> {
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %subgroup_size = s_mov_b32 64
  %subgroup_count = s_mov_b32 2
  %sum_i32 = s_add_u32 %subgroup_size, %subgroup_count
  %value = v_mov_b32_copy %sum_i32
  %15 = v_mov_b32 0
  global_store_b32_saddr %15, %value, %output_view
  return
}

