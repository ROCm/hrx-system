// RUN: emit source-low output=low

// Two independent two-tile motifs retain local issue order while overlapping
// their global reads. Distinct expected sums expose dropped or repeated tiles.

amdgpu.target<gfx11-generic> @paired_scope_target {subgroup_size = 32}

low.func.def schedule(phased) target<amdgpu.gfx11.generic.core>(@paired_scope_target) @paired_scope_tile(%workitem_id: reg<amdgpu.vgpr>, %lhs_view: reg<amdgpu.sgpr x2>, %rhs_view: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x8>) asm {
  %lane = v_and_b32_src0_inline %workitem_id, 15
  %byte_offset = v_lshlrev_b32_src0_inline %lane, 6
  %lhs0_low = global_load_b128_saddr %byte_offset, %lhs_view
  %lhs0_high = global_load_b128_saddr %byte_offset, %lhs_view {offset = 16}
  %lhs0 = concat(%lhs0_low, %lhs0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs0_low = global_load_b128_saddr %byte_offset, %rhs_view
  %rhs0_high = global_load_b128_saddr %byte_offset, %rhs_view {offset = 16}
  %rhs0 = concat(%rhs0_low, %rhs0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %zero = v_mov_b32 0
  %zero_acc = concat(%zero, %zero, %zero, %zero, %zero, %zero, %zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %zero_acc_copy = copy %zero_acc : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  low.schedule.phase
  %partial = v_wmma_f32_16x16x16_bf16 %lhs0, %rhs0, %zero_acc_copy
  low.schedule.phase
  %lhs1_low = global_load_b128_saddr %byte_offset, %lhs_view {offset = 32}
  %lhs1_high = global_load_b128_saddr %byte_offset, %lhs_view {offset = 48}
  %lhs1 = concat(%lhs1_low, %lhs1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs1_low = global_load_b128_saddr %byte_offset, %rhs_view {offset = 32}
  %rhs1_high = global_load_b128_saddr %byte_offset, %rhs_view {offset = 48}
  %rhs1 = concat(%rhs1_low, %rhs1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %partial_copy = copy %partial : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %result = v_wmma_f32_16x16x16_bf16 %lhs1, %rhs1, %partial_copy
  return %result
}

kernel.def target(@paired_scope_target) @paired_scope() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%a_lhs: buffer, %a_rhs: buffer, %b_lhs: buffer, %b_rhs: buffer, %a_output: buffer, %b_output: buffer) {
  %workitem = kernel.workitem.id<x> : index
  %workitem_i32 = index.cast %workitem : index to i32
  %lane = vector.splat %workitem_i32 : vector<1xi32>
  %a_result = low.invoke @paired_scope_tile(%lane, %a_lhs, %a_rhs) : (vector<1xi32>, buffer, buffer) -> (vector<8xf32>)
  %b_result = low.invoke @paired_scope_tile(%lane, %b_lhs, %b_rhs) : (vector<1xi32>, buffer, buffer) -> (vector<8xf32>)
  %base_offset = index.constant 0 : offset
  %width = index.constant 8 : index
  %position = index.mul %workitem, %width : index
  %a_aligned = buffer.assume.alignment %a_output {minimum_alignment = 16} : buffer
  %b_aligned = buffer.assume.alignment %b_output {minimum_alignment = 16} : buffer
  %a_view = buffer.view %a_aligned[%base_offset] : buffer -> view<256xf32>
  %b_view = buffer.view %b_aligned[%base_offset] : buffer -> view<256xf32>
  vector.store %a_result, %a_view[%position] : vector<8xf32>, view<256xf32>
  vector.store %b_result, %b_view[%position] : vector<8xf32>, view<256xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@paired_scope_target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 6, resource_count = 6, resource_offsets = [0, 8, 16, 24, 32, 40], resource_parameter_indices = [0, 1, 2, 3, 4, 5], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @paired_scope() asm {
  %lane$46 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %a_lhs = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %a_rhs = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %b_lhs = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %b_rhs = resource<hal_binding> {index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %a_view = resource<hal_binding> {extent = 1024, index = 4, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %b_view = resource<hal_binding> {extent = 1024, index = 5, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  low.schedule.begin
  %lane$61 = v_and_b32_src0_inline %lane$46, 15
  %byte_offset = v_lshlrev_b32_src0_inline %lane$61, 6
  %lhs0_low$63 = global_load_b128_saddr %byte_offset, %a_lhs
  %lhs0_high$64 = global_load_b128_saddr %byte_offset, %a_lhs {offset = 16}
  %lhs0$65 = concat(%lhs0_low$63, %lhs0_high$64) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs0_low$66 = global_load_b128_saddr %byte_offset, %a_rhs
  %rhs0_high$67 = global_load_b128_saddr %byte_offset, %a_rhs {offset = 16}
  %rhs0$68 = concat(%rhs0_low$66, %rhs0_high$67) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %zero = v_mov_b32 0
  %zero_acc$70 = concat(%zero, %zero, %zero, %zero, %zero, %zero, %zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %zero_acc_copy$71 = copy %zero_acc$70 : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  low.schedule.phase
  %partial$72 = v_wmma_f32_16x16x16_bf16 %lhs0$65, %rhs0$68, %zero_acc_copy$71
  low.schedule.phase
  %lhs1_low$73 = global_load_b128_saddr %byte_offset, %a_lhs {offset = 32}
  %lhs1_high$74 = global_load_b128_saddr %byte_offset, %a_lhs {offset = 48}
  %lhs1$75 = concat(%lhs1_low$73, %lhs1_high$74) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs1_low$76 = global_load_b128_saddr %byte_offset, %a_rhs {offset = 32}
  %rhs1_high$77 = global_load_b128_saddr %byte_offset, %a_rhs {offset = 48}
  %rhs1$78 = concat(%rhs1_low$76, %rhs1_high$77) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %partial_copy$79 = copy %partial$72 : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %result$80 = v_wmma_f32_16x16x16_bf16 %lhs1$75, %rhs1$78, %partial_copy$79
  low.schedule.end
  low.schedule.begin
  %lhs0_low$6 = global_load_b128_saddr %byte_offset, %b_lhs
  %lhs0_high$7 = global_load_b128_saddr %byte_offset, %b_lhs {offset = 16}
  %lhs0$8 = concat(%lhs0_low$6, %lhs0_high$7) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs0_low$9 = global_load_b128_saddr %byte_offset, %b_rhs
  %rhs0_high$10 = global_load_b128_saddr %byte_offset, %b_rhs {offset = 16}
  %rhs0$11 = concat(%rhs0_low$9, %rhs0_high$10) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %zero_acc$13 = concat(%zero, %zero, %zero, %zero, %zero, %zero, %zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %zero_acc_copy$14 = copy %zero_acc$13 : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  low.schedule.phase
  %partial$15 = v_wmma_f32_16x16x16_bf16 %lhs0$8, %rhs0$11, %zero_acc_copy$14
  low.schedule.phase
  %lhs1_low$16 = global_load_b128_saddr %byte_offset, %b_lhs {offset = 32}
  %lhs1_high$17 = global_load_b128_saddr %byte_offset, %b_lhs {offset = 48}
  %lhs1$18 = concat(%lhs1_low$16, %lhs1_high$17) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs1_low$19 = global_load_b128_saddr %byte_offset, %b_rhs {offset = 32}
  %rhs1_high$20 = global_load_b128_saddr %byte_offset, %b_rhs {offset = 48}
  %rhs1$21 = concat(%rhs1_low$19, %rhs1_high$20) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %partial_copy$22 = copy %partial$15 : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %result$23 = v_wmma_f32_16x16x16_bf16 %lhs1$18, %rhs1$21, %partial_copy$22
  low.schedule.end
  %55 = slice %result$80[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  %56 = v_lshlrev_b32_src0_inline %lane$46, 5
  global_store_b128_saddr %56, %55, %a_view
  %57 = slice %result$80[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %56, %57, %a_view {offset = 16}
  %58 = slice %result$23[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %56, %58, %b_view
  %60 = slice %result$23[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %56, %60, %b_view {offset = 16}
  return
}

// ====

// RUN: emit amdgpu-assembly @overlapping_scopes

// Independent scopes can overlap their reads. Consuming an earlier read must
// leave a later read in flight instead of draining the entire load counter.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @overlapping_scopes(%offset: reg<amdgpu.vgpr>, %first: reg<amdgpu.sgpr x2>, %second: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  low.schedule.begin
  %first_old = global_load_b32_saddr %offset, %first
  low.schedule.phase
  %first_sum = v_add_u32 %first_old, %offset
  low.schedule.phase
  %first_new = global_load_b32_saddr %offset, %first {offset = 4}
  %first_total = v_add_u32 %first_new, %first_sum
  low.schedule.end
  low.schedule.begin
  %second_old = global_load_b32_saddr %offset, %second
  low.schedule.phase
  %second_sum = v_add_u32 %second_old, %offset
  low.schedule.phase
  %second_new = global_load_b32_saddr %offset, %second {offset = 4}
  %second_total = v_add_u32 %second_new, %second_sum
  low.schedule.end
  return %first_total, %second_total
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  global_load_b32 v2, v0, s[2:3] offset:0
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v1, v1, v0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v2, v2, v0
  global_load_b32 v3, v0, s[0:1] offset:4
  global_load_b32 v0, v0, s[2:3] offset:4
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v1, v3, v1
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v0, v2
  s_endpgm
