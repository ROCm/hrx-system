// RUN: with-checks compile-report target-legalize{mode=final},source-to-low

// Keep every AMDGPU vector storage family native through target legalization
// and selected by source-to-Low lowering. Exact lowering cases separately cover
// both literal-selector and register-selector byte-permutation packet forms.

amdgpu.target<gfx11-generic> @target

// Exercise the minimum admitted extent for each physical storage contract.
func.def target(@target) @i1_min(%even: vector<1xi1>, %odd: vector<1xi1>) -> (vector<2xi1>, vector<1xi1>, vector<1xi1>) {
  %interleaved = vector.interleave<0> %even, %odd : vector<1xi1>, vector<1xi1> -> vector<2xi1>
  %roundtrip_even, %roundtrip_odd = vector.deinterleave<0> %interleaved : vector<2xi1> -> vector<1xi1>, vector<1xi1>
  func.return %interleaved, %roundtrip_even, %roundtrip_odd : vector<2xi1>, vector<1xi1>, vector<1xi1>
}

