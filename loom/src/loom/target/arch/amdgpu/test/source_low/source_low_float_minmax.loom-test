  %305 = v_cmp_u_f32 %277, %69
  %309 = v_cndmask_b32_src1_lit %295, %302, 2143289344
  %312 = v_cndmask_b32_src1_lit %298, %305, 2143289344
  %ieee = concat(%309, %312) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %ordered, %relaxed_number, %number, %ieee
}
