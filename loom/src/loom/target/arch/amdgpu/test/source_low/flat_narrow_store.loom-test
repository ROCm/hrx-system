// RUN: emit source-low output=low

amdgpu.target<gfx950> @target

func.def target(@target) @flat_fptrunc_store(%output: buffer, %input: f32) {
  %generic = buffer.assume.memory_space<generic> %output : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %generic[%base] : buffer -> view<1xf8E4M3>
  %packed = scalar.fptrunc %input : f32 to f8E4M3
  view.store %packed, %view[0] : f8E4M3, view<1xf8E4M3>
  func.return
}

// ----
low.func.def target<amdgpu.cdna4.core>(@target) abi(hal_kernel) @flat_fptrunc_store(%input: reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 1, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %8 = v_mov_b32 1138753536
  %9 = v_mov_b32 3286237184
  %10 = v_med3_f32 %input, %8, %9
  %11 = v_cmp_u_f32 %input, %input
  %12 = v_cndmask_b32 %10, %input, %11
  %packed = v_cvt_pk_fp8_f32_low %12, %12
  %17 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %17
  %20 = v_mov_b32_copy %18
  %21 = concat(%19, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  flat_store_byte %21, %packed
  return
}

// ====

amdgpu.target<gfx1100> @target

func.def target(@target) @flat_half_store(%output: buffer, %input: f32) {
  %generic = buffer.assume.memory_space<generic> %output : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %generic[%base] : buffer -> view<1xf16>
  %half = scalar.fptrunc %input : f32 to f16
  view.store %half, %view[0] : f16, view<1xf16>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @flat_half_store(%input: reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 2, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %half = v_cvt_f16_f32 %input
  %9 = v_bfe_u32_offset_0_width_inline_low16 %half
  %10 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = v_mov_b32_copy %10
  %13 = v_mov_b32_copy %11
  %14 = concat(%12, %13) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  flat_store_b16 %14, %9
  return
}
