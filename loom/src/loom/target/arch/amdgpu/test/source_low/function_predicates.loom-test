// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// Function contracts follow direct arguments through target ABI lowering. The
// buffer argument becomes a resource while the surrounding scalar arguments
// remain in the low signature, and the contract supplies the vector footprint
// proof without an identity index.assume in the body.
kernel.def target(@target) @function_predicates_follow_direct_abi() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%token_count: index, %storage: buffer, %capacity: index) where [range(%token_count, 4, 2048), le(%token_count, %capacity), range(%capacity, 4, 4096)] {
  %c0 = index.constant 0 : index
  %base = index.constant 0 : offset
  %storage_view = buffer.view %storage[%base] : buffer -> view<[%token_count]xi32>
  %value = vector.load %storage_view[%c0] : view<[%token_count]xi32> -> vector<4xi32>
  vector.store %value, %storage_view[%c0] : vector<4xi32>, view<[%token_count]xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "token_count", arg1 = "capacity"}, direct_arg_offsets = [0, 16], direct_arg_parameter_indices = [0, 2], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @function_predicates_follow_direct_abi(%token_count: reg<amdgpu.sgpr>, %capacity: reg<amdgpu.sgpr>) where [range(%token_count, 4, 2048), le(%token_count, %capacity), range(%capacity, 4, 4096)] asm {
  %storage_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = s_mov_b32 0
  %value = s_load_dwordx4 %storage_view, %11
  %13 = slice %value[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %14 = v_mov_b32_copy %13
  %15 = slice %value[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %15
  %17 = slice %value[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %17
  %19 = slice %value[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %20 = v_mov_b32_copy %19
  %21 = concat(%14, %16, %18, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %22 = v_mov_b32 0
  global_store_b128_saddr %22, %21, %storage_view
  return
}
