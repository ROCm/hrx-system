// RUN: with-checks emit source-low target=amdgpu:gfx11-generic output=low

func.def @f16_input_packets(%values: vector<33xf16>, %thresholds: vector<8xf16>) -> (vector<33xi8>) {
  %codes = vector.table.quantize %values, %thresholds {nan = max, tie = upper} : vector<33xf16>, vector<8xf16> -> vector<33xi8>
  func.return %codes : vector<33xi8>
}

// ----
CHECK: * = v_cvt_f32_f16 *
CHECK: * = v_cmp_ngt_f32 *, *
CHECK: %codes = concat(*)*
CHECK-NOT: * = v_bfe_u32 *
CHECK-NOT: * = v_cmp_eq_i32 *

// ====

func.def @bf16_wide_ordinals(%values: vector<8xbf16>, %thresholds: vector<3xbf16>) -> (vector<8xi16>) {
  %codes = vector.table.quantize %values, %thresholds {nan = max, tie = lower} : vector<8xbf16>, vector<3xbf16> -> vector<8xi16>
  func.return %codes : vector<8xi16>
}

// ----
CHECK: * = v_cmp_nge_f32 *, *
CHECK: %codes = concat(*)*
CHECK-NOT: * = v_bfe_u32 *
CHECK-NOT: * = v_cmp_eq_i32 *

// ====

func.def @f32_wide_ordinals(%values: vector<4xf32>, %thresholds: vector<2xf32>) -> (vector<4xi32>) {
  %codes = vector.table.quantize %values, %thresholds {nan = zero, tie = lower} : vector<4xf32>, vector<2xf32> -> vector<4xi32>
  func.return %codes : vector<4xi32>
}

// ----
CHECK: * = v_cmp_lt_f32 *, *
CHECK: %codes = concat(*)*
CHECK-NOT: * = v_bfe_u32 *
CHECK-NOT: * = v_cmp_eq_i32 *

// ====

func.def @f32_i64_ordinals(%values: vector<16xf32>, %thresholds: vector<3xf32>) -> (vector<16xi64>) {
  %codes = vector.table.quantize %values, %thresholds {nan = zero, tie = lower} : vector<16xf32>, vector<3xf32> -> vector<16xi64>
  func.return %codes : vector<16xi64>
}

// ----
CHECK: low.func.def * @f32_i64_ordinals(*) -> (reg<amdgpu.vgpr x32>) asm {
CHECK: * = v_cmp_lt_f32 *, *
CHECK: %codes = concat(*)* -> reg<amdgpu.vgpr x32>
CHECK-NOT: * = v_bfe_u32 *

// ====

// The boundary projection keeps the table result in an admitted 16-lane
// packet plus its one-lane tail instead of reconstructing a 34-register value.
// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @f32_i64_partial_packet(%values: vector<17xf32>, %thresholds: vector<3xf32>) -> (vector<17xi64>) {
  %codes = vector.table.quantize %values, %thresholds {nan = zero, tie = lower} : vector<17xf32>, vector<3xf32> -> vector<17xi64>
  func.return %codes : vector<17xi64>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @f32_i64_partial_packet(%values: vector<17xf32>, %thresholds: vector<3xf32>) -> (vector<16xi64>, vector<1xi64>) {
  %10 = vector.slice %values[0] : vector<17xf32> -> vector<16xf32>
  %11 = scalar.constant 0 : i32
  %12 = vector.splat %11 : vector<16xi32>
  %13 = scalar.constant 1 : i32
  %14 = vector.splat %13 : vector<16xi32>
  %15 = scalar.constant 0 : i8
  %16 = vector.splat %15 : vector<16xi8>
  %17 = vector.table.lookup %thresholds[%16] : vector<3xf32>, vector<16xi8> -> vector<16xf32>
  %18 = vector.cmpf olt, %17, %10 : vector<16xf32> -> vector<16xi1>
  %61 = scalar.constant 1 : i32
  %62 = vector.splat %61 : vector<16xi32>
  %20 = vector.select %18, %62, %12 : vector<16xi32>
  %21 = scalar.constant 1 : i8
  %22 = vector.splat %21 : vector<16xi8>
  %23 = vector.table.lookup %thresholds[%22] : vector<3xf32>, vector<16xi8> -> vector<16xf32>
  %24 = vector.cmpf olt, %23, %10 : vector<16xf32> -> vector<16xi1>
  %25 = vector.addi %20, %14 : vector<16xi32>
  %26 = vector.select %24, %25, %20 : vector<16xi32>
  %27 = scalar.constant 2 : i8
  %28 = vector.splat %27 : vector<16xi8>
  %29 = vector.table.lookup %thresholds[%28] : vector<3xf32>, vector<16xi8> -> vector<16xf32>
  %30 = vector.cmpf olt, %29, %10 : vector<16xf32> -> vector<16xi1>
  %31 = vector.addi %26, %14 : vector<16xi32>
  %32 = vector.select %30, %31, %26 : vector<16xi32>
  %33 = vector.extui %32 : vector<16xi32> to vector<16xi64>
  %34 = vector.slice %values[16] : vector<17xf32> -> vector<1xf32>
  %35 = scalar.constant 0 : i32
  %36 = vector.splat %35 : vector<1xi32>
  %37 = scalar.constant 1 : i32
  %38 = vector.splat %37 : vector<1xi32>
  %39 = scalar.constant 0 : i8
  %40 = vector.splat %39 : vector<1xi8>
  %41 = vector.table.lookup %thresholds[%40] : vector<3xf32>, vector<1xi8> -> vector<1xf32>
  %42 = vector.cmpf olt, %41, %34 : vector<1xf32> -> vector<1xi1>
  %59 = scalar.constant 1 : i32
  %60 = vector.splat %59 : vector<1xi32>
  %44 = vector.select %42, %60, %36 : vector<1xi32>
  %45 = scalar.constant 1 : i8
  %46 = vector.splat %45 : vector<1xi8>
  %47 = vector.table.lookup %thresholds[%46] : vector<3xf32>, vector<1xi8> -> vector<1xf32>
  %48 = vector.cmpf olt, %47, %34 : vector<1xf32> -> vector<1xi1>
  %49 = vector.addi %44, %38 : vector<1xi32>
  %50 = vector.select %48, %49, %44 : vector<1xi32>
  %51 = scalar.constant 2 : i8
  %52 = vector.splat %51 : vector<1xi8>
  %53 = vector.table.lookup %thresholds[%52] : vector<3xf32>, vector<1xi8> -> vector<1xf32>
  %54 = vector.cmpf olt, %53, %34 : vector<1xf32> -> vector<1xi1>
  %55 = vector.addi %50, %38 : vector<1xi32>
  %56 = vector.select %54, %55, %50 : vector<1xi32>
  %57 = vector.extui %56 : vector<1xi32> to vector<1xi64>
  func.return %33, %57 : vector<16xi64>, vector<1xi64>
}

// ====

func.def @f16_predicate(%values: vector<9xf16>, %thresholds: vector<1xf16>) -> (vector<9xi1>) {
  %codes = vector.table.quantize %values, %thresholds {nan = zero, tie = upper} : vector<9xf16>, vector<1xf16> -> vector<9xi1>
  func.return %codes : vector<9xi1>
}

// ----
CHECK: * = v_cmp_le_f32 *, *
CHECK: %codes = concat(*)*
CHECK-NOT: * = v_cndmask*
CHECK-NOT: * = v_bfe_u32 *

// ====

func.def @f16_threshold_packets(%values: vector<2xf16>, %thresholds: vector<33xf16>) -> (vector<2xi8>) {
  %codes = vector.table.quantize %values, %thresholds {nan = max, tie = lower} : vector<2xf16>, vector<33xf16> -> vector<2xi8>
  func.return %codes : vector<2xi8>
}

// ----
CHECK: * = slice %thresholds[0] *
CHECK: * = slice %thresholds[16] *
CHECK: * = v_cmp_nge_f32 *, *
CHECK-NOT: * = v_bfe_u32 *
CHECK-NOT: * = v_cmp_eq_i32 *

// ====

func.def @empty_thresholds(%values: vector<4xf32>) -> (vector<4xi8>) {
  %thresholds = vector.empty : vector<0xf32>
  %codes = vector.table.quantize %values, %thresholds {nan = zero, tie = lower} : vector<4xf32>, vector<0xf32> -> vector<4xi8>
  func.return %codes : vector<4xi8>
}

// ----
CHECK: * = v_mov_b32 0
CHECK: %codes = v_perm_b32*
CHECK-NOT: * = v_cmp_*

// ====

func.def @multidimensional_input(%values: vector<2x3xf32>, %thresholds: vector<2xf32>) -> (vector<2x3xi32>) {
  %codes = vector.table.quantize %values, %thresholds {nan = zero, tie = lower} : vector<2x3xf32>, vector<2xf32> -> vector<2x3xi32>
  func.return %codes : vector<2x3xi32>
}

// ----
CHECK: low.func.def * @multidimensional_input(*) *
CHECK: * = v_cmp_lt_f32 *, *
CHECK: return %codes
CHECK-NOT: * = v_bfe_u32 *
