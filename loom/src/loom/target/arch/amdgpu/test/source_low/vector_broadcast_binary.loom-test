// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @broadcast_positions(%scalar: f32, %values: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %lanes = vector.splat %scalar : vector<4xf32>
  %sum = vector.addf %lanes, %values : vector<4xf32>
  %product = vector.mulf %values, %lanes : vector<4xf32>
  func.return %sum, %product : vector<4xf32>, vector<4xf32>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @broadcast_positions(%scalar: reg<amdgpu.vgpr>, %values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %11 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %12 = v_pk_add_f32.broadcast_lhs %scalar, %11
  %13 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %14 = v_pk_add_f32.broadcast_lhs %scalar, %13
  %sum = concat(%12, %14) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %17 = v_pk_mul_f32.broadcast_rhs %11, %scalar
  %19 = v_pk_mul_f32.broadcast_rhs %13, %scalar
  %product = concat(%17, %19) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  return %sum, %product
}

// ====

// Both inputs have one register; the result determines packet repetition.
func.def @broadcast_both(%offset: f32, %scale: f32) -> (vector<4xf32>) {
  %offsets = vector.splat %offset : vector<4xf32>
  %scales = vector.splat %scale : vector<4xf32>
  %result = vector.mulf %offsets, %scales : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @broadcast_both(%offset: reg<amdgpu.vgpr>, %scale: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %9 = v_pk_mul_f32.broadcast_lhs_rhs %offset, %scale
  %result = concat(%9, %9) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

// Two uniform loads require a single scalar-to-vector copy before repetition.
kernel.def @uniform_binary() {
  %c1 = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%parameters: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %parameters {minimum_alignment = 64} : buffer
  %scalars, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %offset = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %source = buffer.view %scalars[%offset] : buffer -> view<2xf32>
  %left = view.load %source[0] : view<2xf32> -> f32
  %right = view.load %source[1] : view<2xf32> -> f32
  %left_lanes = vector.splat %left : vector<8xf32>
  %right_lanes = vector.splat %right : vector<8xf32>
  %result = vector.addf %left_lanes, %right_lanes : vector<8xf32>
  %output_view = buffer.view %destination[%offset] : buffer -> view<64x8xf32>
  vector.store %result, %output_view[%lane, 0] : vector<8xf32>, view<64x8xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_binary() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 2048, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %22 = s_mov_b32 0
  %left = s_load_dword %source, %22
  %right = s_load_dword %source, %22 {offset = 4}
  %26 = v_mov_b32_copy %right
  %27 = v_pk_add_f32.broadcast_lhs_rhs %left, %26
  %36 = concat(%27, %27) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %33 = v_lshlrev_b32_src0_inline %lane, 5
  global_store_dwordx4_saddr %33, %36, %output_view
  %35 = concat(%27, %27) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  global_store_dwordx4_saddr %33, %35, %output_view {offset = 16}
  return
}

// ====

// Independent uniform vectors retain one scalar source and materialize the
// other before the packed VOP3P operation.
kernel.def @uniform_vector_binary() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64x4xf32>
  %base = index.constant 0 : offset
  %lhs_global = buffer.assume.memory_space<global> %lhs_buffer : buffer
  %rhs_global = buffer.assume.memory_space<global> %rhs_buffer : buffer
  %lhs_noalias, %rhs_noalias = buffer.assume.noalias %lhs_global, %rhs_global : buffer, buffer
  %lhs_view = buffer.view %lhs_noalias[%base] : buffer -> view<4xf32>
  %rhs_view = buffer.view %rhs_noalias[%base] : buffer -> view<4xf32>
  %lhs = vector.load %lhs_view[0] : view<4xf32> -> vector<4xf32>
  %rhs = vector.load %rhs_view[0] : view<4xf32> -> vector<4xf32>
  %result = vector.addf %lhs, %rhs : vector<4xf32>
  vector.store %result, %result_view_0[%fixture_lane, 0] : vector<4xf32>, view<64x4xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_vector_binary() asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs_view = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %rhs_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 1024, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %25 = s_mov_b32 0
  %lhs = s_load_dwordx4 %lhs_view, %25
  %rhs = s_load_dwordx4 %rhs_view, %25
  %29 = slice %lhs[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %50 = slice %rhs[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %32 = v_mov_b32_copy %50
  %49 = slice %rhs[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %34 = v_mov_b32_copy %49
  %35 = concat(%32, %34) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %36 = v_pk_add_f32 %29, %35
  %37 = slice %lhs[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %48 = slice %rhs[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %40 = v_mov_b32_copy %48
  %47 = slice %rhs[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %42 = v_mov_b32_copy %47
  %43 = concat(%40, %42) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %44 = v_pk_add_f32 %37, %43
  %result = concat(%36, %44) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %46 = v_lshlrev_b32_src0_inline %fixture_lane, 4
  global_store_dwordx4_saddr %46, %result, %result_view_0
  return
}
