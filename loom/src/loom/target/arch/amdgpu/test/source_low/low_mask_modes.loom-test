// The read-retention rule follows processor capability and execution width,
// not an architecture-name prefix or the width of the predicate value.

// RUN: emit amdgpu-assembly @retained_mask_mode

amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @retained_mask_mode(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>) asm {
  %mask = v_cmp_eq_i32 %value, %value
  %selected = v_cndmask_b32 %value, %value, %mask
  %result = s_mov_b32 1
  return %selected, %result
}

// ----
  v_cmp_eq_i32 s[0:1], v0, v0
  s_mov_b32 s2, 1
  s_delay_alu instid0(VALU_DEP_1)
  v_cndmask_b32 v0, v0, v0, s[0:1]
  s_endpgm

// ====

