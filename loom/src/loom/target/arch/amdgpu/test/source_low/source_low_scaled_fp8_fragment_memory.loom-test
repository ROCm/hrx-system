  %input_view = buffer.view %input[%base] : buffer -> view<16x16xbf16>
  %weight_view = buffer.view %weight[%base] : buffer -> view<16x16xf8E4M3, %weight_storage>
  %scale_view = buffer.view %scale[%base] : buffer -> view<1xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xf32>
  %lhs = vector.fragment.load<lhs> %input_view[0, 0] shape [%m, %k] : view<16x16xbf16> -> vector<8xbf16>
  %scale_scalar = view.load %scale_view[0] : view<1xf32> -> f32
  %scale_vector = vector.splat %scale_scalar : vector<1xf32>
