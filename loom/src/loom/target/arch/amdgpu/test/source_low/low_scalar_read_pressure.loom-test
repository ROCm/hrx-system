block 0 order: 0, 1, 2, 3

// ====

// Repeated late operands consume one storage lifetime, not two.
// RUN: emit low-schedule-query @repeated_late_read strategy=resource-stall diagnostics=candidates amdgpu.sgpr=3 order=0,1,2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @repeated_late_read(%uniform: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %result, %carry = v_add_co_u32 %uniform, %uniform
  // REMARK@+1: BACKEND/015 {rejected_pressure_cliff_source="amdgpu.sgpr", rejected_pressure_cliff_units="3", rejected_pressure_cliff_penalty="3"}
  %scratch = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  return %result, %carry
}

