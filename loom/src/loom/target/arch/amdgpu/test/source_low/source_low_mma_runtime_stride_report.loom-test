// RUN: with-checks compile-report source-to-low,low-dce

amdgpu.target<gfx1151> @target {subgroup_size = 64}

kernel.def target(@target) @report_dynamic_result_row_stride() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%row_size0: index, %output: buffer) {
  %row_size = index.assume %row_size0 [range(%row_size0, 64, 32768), mul(%row_size0, 64)] : index
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %output_view = buffer.view %output[%base] : buffer -> view<32x[%row_size]xf32>
  %values = vector.constant 0.0 : vector<4xf32>
  %result = vector.fragment<result> %values shape [%m, %n] : vector<4xf32>
  vector.fragment.store<result> %result, %output_view[0, 0] shape [%m, %n] : vector<4xf32>, view<32x[%row_size]xf32>
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: source_low_memory * packets=4 loads=0 stores=4 *
// Distinct symbolic row intervals retain the runtime stride and packet membership.
CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.fragment.store memory_space=global operation=store packet=amdgpu.global_store_b32_saddr source_root=output * source_interval={begin_min_bytes:0,begin_max_bytes:0,end_min_bytes:4,end_max_bytes:4,exact_length_bytes:4} address_form=global_saddr dynamic_term_kind=vaddr fallback_reason=fragment_noncontiguous_registers static_offset_bytes=0 element_bytes=4 vector_lanes=1 issued_read_bytes=0 issued_write_bytes=4 issued_read_unknown_widths=0 issued_write_unknown_widths=0 dynamic_stride_bytes=0 vector_lane_stride_bytes=4
CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.fragment.store memory_space=global operation=store packet=amdgpu.global_store_b32_saddr source_root=output * source_interval={begin_min_bytes:1024,begin_max_bytes:524288,end_min_bytes:1028,end_max_bytes:524292,exact_length_bytes:4} address_form=global_saddr dynamic_term_kind=vaddr fallback_reason=fragment_noncontiguous_registers static_offset_bytes=0 element_bytes=4 vector_lanes=1 issued_read_bytes=0 issued_write_bytes=4 issued_read_unknown_widths=0 issued_write_unknown_widths=0 dynamic_stride_bytes=0 vector_lane_stride_bytes=4
CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.fragment.store memory_space=global operation=store packet=amdgpu.global_store_b32_saddr source_root=output * source_interval={begin_min_bytes:2048,begin_max_bytes:1048576,end_min_bytes:2052,end_max_bytes:1048580,exact_length_bytes:4} address_form=global_saddr dynamic_term_kind=vaddr fallback_reason=fragment_noncontiguous_registers static_offset_bytes=0 element_bytes=4 vector_lanes=1 issued_read_bytes=0 issued_write_bytes=4 issued_read_unknown_widths=0 issued_write_unknown_widths=0 dynamic_stride_bytes=0 vector_lane_stride_bytes=4
CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.fragment.store memory_space=global operation=store packet=amdgpu.global_store_b32_saddr source_root=output * source_interval={begin_min_bytes:3072,begin_max_bytes:1572864,end_min_bytes:3076,end_max_bytes:1572868,exact_length_bytes:4} address_form=global_saddr dynamic_term_kind=vaddr fallback_reason=- static_offset_bytes=0 element_bytes=4 vector_lanes=1 issued_read_bytes=0 issued_write_bytes=4 issued_read_unknown_widths=0 issued_write_unknown_widths=0 dynamic_stride_bytes=0 vector_lane_stride_bytes=4
CHECK: COMPILE-REPORT: source_low_memory_argument[*] * source_root=output * memory_space=global packets=4 loads=0 stores=4 * source_lanes=4 source_bytes=16 * issued_read_bytes=0 issued_write_bytes=16 issued_read_unknown_widths=0 issued_write_unknown_widths=0 * interval_envelope={packets:4,begin_min_bytes:0,end_max_bytes:1572868,byte_count:1572868,exact_static_packet_count:1} *
CHECK: COMPILE-REPORT: source_low_subgroup_access[*] * source_op=vector.fragment.store * source_root=output * memory_space=global operation=store packet=amdgpu.global_store_b32_saddr * subgroup_access={proof:unknown,lane_address_proof:unproven,active_lane_proof:subgroup-uniform-control-full-wave,lane_mapping:runtime-axis-terms,subgroup_size:64,active_lane_count:64,per_lane_packet_bytes:4,linear_lane_stride_bytes:0,lane_terms:[{divisor:1,modulus:16,byte_stride:4}],unknown_reason:address-runtime-fragment-stride} modeled_packets=4 exact_packets=0 unknown_packets=4 *
