// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Explicit wide sources keep both result words even when their range is unknown.
func.def @wide_bitwise(%left_bits: i64, %right_bits: i64) -> (index, index, index) {
  %left = index.cast %left_bits : i64 to index
  %right = index.cast %right_bits : i64 to index
  %and = index.andi %left, %right : index
  %or = index.ori %left, %right : index
  %xor = index.xori %left, %right : index
  func.return %and, %or, %xor : index, index, index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @wide_bitwise(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %15 = slice %left[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %16 = slice %right[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %17 = v_and_b32 %15, %16
  %18 = slice %left[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = slice %right[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20 = v_and_b32 %18, %19
  %and = concat(%17, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %24 = v_or_b32 %15, %16
  %27 = v_or_b32 %18, %19
  %or = concat(%24, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %31 = v_xor_b32 %15, %16
  %34 = v_xor_b32 %18, %19
  %xor = concat(%31, %34) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %and, %or, %xor
}

// ====

// Signed and unsigned words extend differently; the byte mask narrows again.
func.def @mixed_width_bitwise(%wide_bits: i64, %word: i32) -> (index, index, index) {
  %wide = index.cast %wide_bits : i64 to index
  %signed = index.cast %word : i32 to index
  %unsigned_bits = scalar.extui %word : i32 to i64
  %unsigned = index.cast %unsigned_bits : i64 to index
  %mask = index.constant 255 : index
  %signed_result = index.xori %wide, %signed : index
  %unsigned_result = index.ori %wide, %unsigned : index
  %byte = index.andi %wide, %mask : index
  func.return %signed_result, %unsigned_result, %byte : index, index, index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @mixed_width_bitwise(%wide: reg<amdgpu.vgpr x2>, %signed: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>) asm {
  %mask = s_mov_b32 255
  %22 = v_ashrrev_i32_src0_inline %signed, 31
  %24 = slice %wide[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %26 = v_xor_b32 %24, %signed
  %27 = slice %wide[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %29 = v_xor_b32 %27, %22
  %signed_result = concat(%26, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %31 = v_mov_b32 0
  %35 = v_or_b32 %24, %signed
  %38 = v_or_b32 %27, %31
  %unsigned_result = concat(%35, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %byte = v_and_b32 %mask, %24
  return %signed_result, %unsigned_result, %byte
}

// ====

// Uniform operands stay in scalar registers, including either source position
// of a vector instruction. Only the final store requires vector copies.
kernel.def @uniform_bitwise() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%uniform_bits: i64, %word: i32, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %inputs = buffer.view %input[%origin] : buffer -> view<64xi64>
  %results = buffer.view %output[%origin] : buffer -> view<3x64xi64>
  %varying_bits = view.load %inputs[%lane] : view<64xi64> -> i64
  %uniform = index.cast %uniform_bits : i64 to index
  %signed = index.cast %word : i32 to index
  %varying = index.cast %varying_bits : i64 to index
  %scalar = index.andi %uniform, %signed : index
  %left = index.ori %uniform, %varying : index
  %right = index.xori %varying, %signed : index
  %scalar_bits = index.cast %scalar : index to i64
  %left_bits = index.cast %left : index to i64
  %right_bits = index.cast %right : index to i64
  view.store %scalar_bits, %results[0, %lane] : i64, view<3x64xi64>
  view.store %left_bits, %results[1, %lane] : i64, view<3x64xi64>
  view.store %right_bits, %results[2, %lane] : i64, view<3x64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 3, direct_arg_count = 2, direct_arg_names = {arg0 = "uniform_bits", arg1 = "word"}, direct_arg_offsets = [0, 8], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [8, 4], parameter_count = 4, resource_count = 2, resource_offsets = [16, 24], resource_parameter_indices = [2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_bitwise(%uniform: reg<amdgpu.sgpr x2>, %signed: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %inputs = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 1536, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %30 = v_lshlrev_b32_src0_inline %lane, 3
  %varying = global_load_b64_saddr %30, %inputs
  %32 = s_ashr_i32_rhs_inline %signed, 31
  %33 = concat(%signed, %32) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %scalar_bits = s_and_b64 %uniform, %33
  %35 = slice %uniform[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = slice %varying[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %37 = v_or_b32 %35, %36
  %38 = slice %uniform[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %39 = slice %varying[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %40 = v_or_b32 %38, %39
  %left_bits = concat(%37, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %46 = v_xor_b32 %signed, %36
  %49 = v_xor_b32 %32, %39
  %right_bits = concat(%46, %49) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %51 = slice %scalar_bits[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %52 = v_mov_b32_copy %51
  %53 = slice %scalar_bits[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = v_mov_b32_copy %53
  %55 = concat(%52, %54) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %30, %55, %results
  global_store_b64_saddr %30, %left_bits, %results {offset = 512}
  global_store_b64_saddr %30, %right_bits, %results {offset = 1024}
  return
}

// ====

// Native index operands remain one word without a wide producer.
func.def @native_bitwise(%left: index, %right: index) -> (index, index, index) {
  %and = index.andi %left, %right : index
  %or = index.ori %left, %right : index
  %xor = index.xori %left, %right : index
  func.return %and, %or, %xor : index, index, index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @native_bitwise(%left: reg<amdgpu.vgpr>, %right: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %and = v_and_b32 %left, %right
  %or = v_or_b32 %left, %right
  %xor = v_xor_b32 %left, %right
  return %and, %or, %xor
}
