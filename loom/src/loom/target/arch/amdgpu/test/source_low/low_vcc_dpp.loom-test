// RUN: emit amdgpu-assembly @gfx1250_vcc_compact_forms

amdgpu.target<gfx1250> @target
low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @gfx1250_vcc_compact_forms(%lane: reg<amdgpu.vgpr>, %true_value: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %mask = v_cmp_eq_i32_src1_inline_vcc %lane {rhs = 0}
  %inline = v_cndmask_b32_src0_inline_vcc %true_value, %mask {false_value = 0}
  %literal = v_cndmask_b32_src0_lit_vcc %inline, %mask, 305419896
  global_store_b32_saddr %lane, %literal, %output
  return
}

