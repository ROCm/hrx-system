// RUN: emit amdgpu-bank-service

amdgpu.target<gfx1151> @target

// Halfword addresses retain an unknown common two-byte residue. Both possible
// placements combine disjoint pairs into conflict-free bank requests.
kernel.def target(@target) @narrow_packets() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 4096 : offset
  %scratch = buffer.alloca<workgroup> align(2) %bytes : buffer
  %halves = buffer.view %scratch[%base] : buffer -> view<32xi16>
  %half = vector.constant 1 : vector<1xi16>
  vector.store %half, %halves[%lane] : vector<1xi16>, view<32xi16>
  %layout = encoding.layout.strided [32] : encoding<layout>
  %words = buffer.view %scratch[%base] : buffer -> view<32xi32, %layout>
  %word = vector.constant 1 : vector<1xi32>
  vector.store %word, %words[%lane] : vector<1xi32>, view<32xi32, %layout>
  kernel.return
}

// ----
bank-service function=narrow_packets source-op=vector.store root=scratch packet=amdgpu.ds_write_b16 model=amdgpu.lds.gfx1151.wave32.b16.write.combine-disjoint-writes proof=exact lane-address=canonical-topology-coordinates-all-waves active-lanes=subgroup-uniform-control-full-wave base-residue=all-compatible-byte-residues-common-translation classification=conflict-free required-rounds=1 uncontended-rounds=1 extra-rounds=0 maximum-multiplicity=1
bank-service function=narrow_packets source-op=vector.store root=scratch packet=amdgpu.ds_write_b32 model=amdgpu.lds.gfx1151.wave32.b32.write.count-each proof=exact lane-address=canonical-topology-coordinates-all-waves active-lanes=subgroup-uniform-control-full-wave base-residue=subgroup-uniform-common-translation-all-bank-word-residues classification=conflicted required-rounds=32 uncontended-rounds=1 extra-rounds=31 maximum-multiplicity=32

// ====

amdgpu.target<gfx1151> @target

// A 48-element BF16 row pitch is clean at a word-aligned base but conflicted
// two bytes later. A dynamic two-byte offset must stay unknown.
kernel.def target(@target) @fragment_base_residues() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%offset0: offset) {
  %offset = index.assume %offset0 [range(%offset0, 0, 2), mul(%offset0, 2)] : offset
  %base0 = index.constant 0 : offset
  %base2 = index.constant 2 : offset
  %origin = index.constant 0 : index
  %size = index.constant 16 : index
  %bytes = index.constant 2048 : offset
  %aligned = buffer.alloca<workgroup> align(16) %bytes : buffer
  %view0 = buffer.view %aligned[%base0] : buffer -> view<16x48xbf16>
  %view2 = buffer.view %aligned[%base2] : buffer -> view<16x48xbf16>
  %view_unknown = buffer.view %aligned[%offset] : buffer -> view<16x48xbf16>
  %initial_values = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %initial_values shape [%size, %size] : vector<8xf32>
  %halves = vector.fptrunc %init : vector<8xf32> to vector<8xbf16>
  vector.fragment.store<result> %halves, %view0[%origin, %origin] shape [%size, %size] : vector<8xbf16>, view<16x48xbf16>
  vector.fragment.store<result> %halves, %view2[%origin, %origin] shape [%size, %size] : vector<8xbf16>, view<16x48xbf16>
  vector.fragment.store<result> %halves, %view_unknown[%origin, %origin] shape [%size, %size] : vector<8xbf16>, view<16x48xbf16>
  kernel.return
}

