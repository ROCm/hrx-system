amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @p10_f16_f32(%p10: reg<amdgpu.vgpr>, %i: reg<amdgpu.vgpr>, %p0: reg<amdgpu.vgpr>, %m0: reg<amdgpu.m0>) asm {
  %result = v_interp_p10_f16_f32_p10_lo_p0_hi %p10, %i, %p0, %m0
  return
}

// ----
  v_interp_p10_f16_f32 v0, v0.l, v1, v2.h wait_exp:7
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @p2_f16_f32

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @p2_f16_f32(%p20: reg<amdgpu.vgpr>, %j: reg<amdgpu.vgpr>, %p10: reg<amdgpu.vgpr>, %m0: reg<amdgpu.m0>) asm {
  %result = v_interp_p2_f16_f32_p20_hi_result_lo %p20, %j, %p10, %m0
  return
}

// ----
  v_interp_p2_f16_f32 v0.l, v0.h, v1, v2 wait_exp:7
  s_endpgm

// ====

