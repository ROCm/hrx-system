// RUN: with-checks compile-report source-to-low,low-dce
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @report_bf16_result_fragment_packets() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<16x16xbf16>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<16x16xbf16>
  %packed = vector.fragment.load<result> %input_view[0, 0] shape [%m, %n] : view<16x16xbf16> -> vector<8xbf16>
  %wide = vector.extf %packed : vector<8xbf16> to vector<8xf32>
  vector.fragment.store<result> %wide, %output_view[0, 0] shape [%m, %n] : vector<8xf32>, view<16x16xbf16>
  kernel.return
}

