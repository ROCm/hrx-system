// ====

// RUN: emit amdgpu-occupancy-json @gfx11_concat_reuses_releasable_memory_lease strategy=source fixed=%state:physical_register:0:184

amdgpu.target<gfx1100> @gfx11_target
low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_concat_reuses_releasable_memory_lease(%state: reg<amdgpu.vgpr x184>) -> (reg<amdgpu.vgpr x184>, reg<amdgpu.vgpr x8>) asm {
  %address = slice %state[0] : reg<amdgpu.vgpr x184> -> reg<amdgpu.vgpr>
  %dead = ds_read_b128 %address
  %lhs0 = ds_read_b128 %address {offset = 16}
  %lhs1 = ds_read_b128 %address {offset = 32}
  %lhs = concat(%lhs0, %lhs1) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  return %state, %lhs
}

