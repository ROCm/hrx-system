// The exact RDNA3 targets share an ISA descriptor set but own different
// physical VGPR pools.
// RUN: emit amdgpu-occupancy-json @rdna3_large_pool_pressure diagnostics=summary fixed=%value:physical_register:96:1

amdgpu.target<gfx1100> @gfx11_target
// REMARK@+2: BACKEND/010 "uses 0 of 800 amdgpu.sgpr" "75%" "limited by 'amdgpu.vgpr'"
// REMARK@+1: BACKEND/010 "uses 97 of 1536 amdgpu.vgpr" "75%" "limited by 'amdgpu.vgpr'"
low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @rdna3_large_pool_pressure(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) {
  low.return %value : reg<amdgpu.vgpr>
}

