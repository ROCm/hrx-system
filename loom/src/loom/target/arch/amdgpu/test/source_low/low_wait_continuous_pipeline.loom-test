// RUN: emit amdgpu-assembly @continuous_global_gfx1151 strategy=source fixed=%seed0:physical_register:4:1 fixed=%seed1:physical_register:5:1 fixed=%carried0:physical_register:4:1 fixed=%carried1:physical_register:5:1 fixed=%third:physical_register:4:1 fixed=%fourth:physical_register:5:1 fixed=%first:physical_register:6:1 fixed=%second:physical_register:7:1

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @continuous_global_gfx1151(%base: reg<amdgpu.sgpr x2>, %address: reg<amdgpu.vgpr>, %seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  low.br ^loop(%seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>)
^loop(%carried0: reg<amdgpu.vgpr>, %carried1: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>):
  %first = global_load_b32_saddr %address, %base
  %second = global_load_b32_saddr %address, %base {offset = 4}
  %used0 = v_add_u32 %acc, %carried0
  %third = global_load_b32_saddr %address, %base {offset = 8}
  %used1 = v_add_u32 %used0, %carried1
  %fourth = global_load_b32_saddr %address, %base {offset = 12}
  %used2 = v_add_u32 %used1, %first
  %used3 = v_add_u32 %used2, %second
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%third: reg<amdgpu.vgpr>, %fourth: reg<amdgpu.vgpr>, %used3: reg<amdgpu.vgpr>)
^exit:
  %remaining = v_add_u32 %third, %fourth
  %result = v_add_u32 %used3, %remaining
  return %result
}

// Consuming the first two current loads retires the incoming epoch while
// leaving the last two current loads pending across the copy-free backedge.
// Each old carried value is consumed before its register receives a new load.
// ----
.Lbb1:
  global_load_b32 v6, v1, s[0:1] offset:0
  global_load_b32 v7, v1, s[0:1] offset:4
  s_waitcnt vmcnt(3) lgkmcnt(63)
  v_add_u32 v0, v0, v4
  global_load_b32 v4, v1, s[0:1] offset:8
  s_waitcnt vmcnt(3) lgkmcnt(63)
  v_add_u32 v0, v0, v5
  global_load_b32 v5, v1, s[0:1] offset:12
  s_waitcnt vmcnt(3) lgkmcnt(63)
  v_add_u32 v0, v0, v6
  s_waitcnt vmcnt(2) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v7
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_branch .Lbb1
.Lbb3:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v1, v4, v5
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @continuous_global_gfx1250 strategy=source fixed=%seed0:physical_register:4:1 fixed=%seed1:physical_register:5:1 fixed=%carried0:physical_register:4:1 fixed=%carried1:physical_register:5:1 fixed=%third:physical_register:4:1 fixed=%fourth:physical_register:5:1 fixed=%first:physical_register:6:1 fixed=%second:physical_register:7:1

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @continuous_global_gfx1250(%base: reg<amdgpu.sgpr x2>, %address: reg<amdgpu.vgpr>, %seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  low.br ^loop(%seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>)
^loop(%carried0: reg<amdgpu.vgpr>, %carried1: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>):
  %first = global_load_b32_saddr %address, %base
  %second = global_load_b32_saddr %address, %base {offset = 4}
  %used0 = v_add_u32 %acc, %carried0
  %third = global_load_b32_saddr %address, %base {offset = 8}
  %used1 = v_add_u32 %used0, %carried1
  %fourth = global_load_b32_saddr %address, %base {offset = 12}
  %used2 = v_add_u32 %used1, %first
  %used3 = v_add_u32 %used2, %second
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%third: reg<amdgpu.vgpr>, %fourth: reg<amdgpu.vgpr>, %used3: reg<amdgpu.vgpr>)
^exit:
  %remaining = v_add_u32 %third, %fourth
  %result = v_add_u32 %used3, %remaining
  return %result
}

// Consuming the first two current loads retires the incoming epoch while
// leaving the last two current loads pending across the copy-free backedge.
// Each old carried value is consumed before its register receives a new load.
// ----
.Lbb1:
  global_load_b32 v6, v1, s[0:1] offset:0
  global_load_b32 v7, v1, s[0:1] offset:4
  s_wait_loadcnt loadcnt(3)
  v_add_u32 v0, v0, v4
  global_load_b32 v4, v1, s[0:1] offset:8
  s_wait_loadcnt loadcnt(3)
  v_add_u32 v0, v0, v5
  global_load_b32 v5, v1, s[0:1] offset:12
  s_wait_loadcnt loadcnt(3)
  v_add_u32 v0, v0, v6
  s_wait_loadcnt loadcnt(2)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v7
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_branch .Lbb1
.Lbb3:
  s_wait_loadcnt loadcnt(0)
  v_add_u32 v1, v4, v5
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @continuous_lds_gfx1100 strategy=source fixed=%seed0:physical_register:4:1 fixed=%seed1:physical_register:5:1 fixed=%carried0:physical_register:4:1 fixed=%carried1:physical_register:5:1 fixed=%third:physical_register:4:1 fixed=%fourth:physical_register:5:1 fixed=%first:physical_register:6:1 fixed=%second:physical_register:7:1

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @continuous_lds_gfx1100(%address: reg<amdgpu.vgpr>, %seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  low.br ^loop(%seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>)
^loop(%carried0: reg<amdgpu.vgpr>, %carried1: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>):
  %first = ds_read_b32 %address
  %second = ds_read_b32 %address {offset = 4}
  %used0 = v_add_u32 %acc, %carried0
  %third = ds_read_b32 %address {offset = 8}
  %used1 = v_add_u32 %used0, %carried1
  %fourth = ds_read_b32 %address {offset = 12}
  %used2 = v_add_u32 %used1, %first
  %used3 = v_add_u32 %used2, %second
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%third: reg<amdgpu.vgpr>, %fourth: reg<amdgpu.vgpr>, %used3: reg<amdgpu.vgpr>)
^exit:
  %remaining = v_add_u32 %third, %fourth
  %result = v_add_u32 %used3, %remaining
  return %result
}

// Consuming the first two current loads retires the incoming epoch while
// leaving the last two current loads pending across the copy-free backedge.
// Each old carried value is consumed before its register receives a new load.
// ----
.Lbb1:
  ds_read_b32 v6, v1 offset:0
  ds_read_b32 v7, v1 offset:4
  s_waitcnt vmcnt(63) lgkmcnt(3)
  v_add_u32 v0, v0, v4
  ds_read_b32 v4, v1 offset:8
  s_waitcnt vmcnt(63) lgkmcnt(3)
  s_delay_alu instid0(VALU_DEP_1) | instskip(SKIP_2) | instid1(VALU_DEP_1)
  v_add_u32 v0, v0, v5
  ds_read_b32 v5, v1 offset:12
  s_waitcnt vmcnt(63) lgkmcnt(3)
  v_add_u32 v0, v0, v6
  s_waitcnt vmcnt(63) lgkmcnt(2)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v7
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_branch .Lbb1
.Lbb3:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v1, v4, v5
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @partial_completion_keeps_both_bases_reusable strategy=source amdgpu.sgpr=4

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @partial_completion_keeps_both_bases_reusable(%older_base: reg<amdgpu.sgpr x2>, %younger_base: reg<amdgpu.sgpr x2>, %address: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %older = global_load_b32_saddr %address, %older_base
  %younger = global_load_b32_saddr %address, %younger_base
  %used = v_add_u32 %older, %address
  low.br ^next
^next:
  %replacement0 = s_mov_b32 1
  %replacement1 = s_mov_b32 2
  %replacement2 = s_mov_b32 3
  %replacement3 = s_mov_b32 4
  return %replacement0, %replacement1, %replacement2, %replacement3
}

// The partial wait completes only the consumed result. Both captured scalar
// bases can be reused without completing the younger load.
// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  global_load_b32 v2, v0, s[2:3] offset:0
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v0, v1, v0
.Lbb1:
  s_mov_b32 s0, 1
  s_mov_b32 s1, 2
  s_mov_b32 s2, 3
  s_mov_b32 s3, 4
  s_endpgm
