// RUN: compile-report target-legalize{mode=final},dce,canonicalize

amdgpu.target<gfx11-generic> @target

func.def target(@target) @pack_wide_field(%codes: vector<2xi32>) -> (vector<4xi8>) {
  %packed = vector.bitpack<16> %codes : vector<2xi32> -> vector<4xi8>
  func.return %packed : vector<4xi8>
}

func.def target(@target) @pack_byte_lanes(%codes: vector<4xi8>) -> (vector<4xi8>) {
  %packed = vector.bitpack<8> %codes : vector<4xi8> -> vector<4xi8>
  func.return %packed : vector<4xi8>
}

func.def target(@target) @pack_halfword_storage(%codes: vector<4xi32>) -> (vector<2xi16>) {
  %packed = vector.bitpack<8> %codes : vector<4xi32> -> vector<2xi16>
  func.return %packed : vector<2xi16>
}

func.def target(@target) @unpack_odd_signed_fields(%packed: vector<3xi8>) -> (vector<8xi32>) {
  %unpacked = vector.bitunpacks<3> %packed : vector<3xi8> -> vector<8xi32>
  func.return %unpacked : vector<8xi32>
}

func.def target(@target) @unpack_halfword_results(%packed: vector<1xi32>) -> (vector<4xi16>) {
  %unpacked = vector.bitunpacku<8> %packed : vector<1xi32> -> vector<4xi16>
  func.return %unpacked : vector<4xi16>
}

