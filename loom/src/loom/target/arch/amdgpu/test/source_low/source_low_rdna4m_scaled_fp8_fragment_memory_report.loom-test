// RUN: with-checks compile-report source-to-low,low-dce

amdgpu.target<gfx1170> @target

kernel.def target(@target) @report_scaled_fp8_rhs_fragment_memory() {
  %c1 = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%weight: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %k = index.constant 16 : index
  %n = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, 16] : encoding<layout>
  %weight_schema = encoding.define #encoding.f8e4m3<affine=scale_only, payload_elements=8, rounding=finite_only, scale_format=f32, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %weight_storage = encoding.define #encoding.storage {layout = %weight_layout : encoding<layout>, schema = %weight_schema : encoding<schema>} : encoding<storage>
  %weight_view = buffer.view %weight[%base] : buffer -> view<16x16xf8E4M3, %weight_storage>
  %scale_view = buffer.view %scale[%base] : buffer -> view<1xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<8xbf16>
  %scale_scalar = view.load %scale_view[0] : view<1xf32> -> f32
  %scale_vector = vector.splat %scale_scalar : vector<1xf32>
  %rhs = vector.fragment.load<rhs> %weight_view[0, 0] shape [%k, %n] using {scale = %scale_vector : vector<1xf32>} : view<16x16xf8E4M3, %weight_storage> -> vector<8xbf16>
  vector.store %rhs, %output_view[0] : vector<8xbf16>, view<8xbf16>
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: source_low[*] * source_op=vector.fragment.load selection=plan plan_key=fp8_scalef32_native_f32_pair_manual_bf16_pack *
CHECK: COMPILE-REPORT: source_low_memory * packets=3 loads=2 stores=1 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=scale * memory_space=global operation=load packet=amdgpu.global_load_b32_saddr storage={element_format:f32}* packets=1 * source_lanes=1 source_bytes=4 * issued_read_bytes=4 issued_write_bytes=0 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=weight * memory_space=global operation=load packet=amdgpu.global_load_b64_saddr strategy=fp8_scalef32_native_f32_pair_manual_bf16_pack storage={element_format:f8e4m3,scale_format:f32,payload_packing:dense_lanes,scale_topology:block_1d,affine_policy:scale_only,rounding_policy:finite_only}* packets=1 * source_lanes=8 source_bytes=8 * issued_read_bytes=8 issued_write_bytes=0 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=output * memory_space=global operation=store packet=amdgpu.global_store_b128_saddr storage={element_format:bf16}* packets=1 * source_lanes=8 source_bytes=16 * issued_read_bytes=0 issued_write_bytes=16 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
CHECK: COMPILE-REPORT: source_low_subgroup_access[*] * source_op=vector.fragment.load * source_root=weight * memory_space=global operation=load packet=amdgpu.global_load_b64_saddr * subgroup_access={proof:exact,lane_address_proof:compiled-fragment-lane-register-layout,active_lane_proof:subgroup-uniform-control-full-wave,lane_mapping:digit-terms,subgroup_size:32,active_lane_count:32,per_lane_packet_bytes:8,linear_lane_stride_bytes:0,lane_terms:[{divisor:1,modulus:16,byte_stride:16},{divisor:16,modulus:0,byte_stride:8}],interval_coverage:dense,subgroup_requested_bytes:256,subgroup_unique_bytes:256,subgroup_span_bytes:256,maximum_adjacent_lane_delta_bytes:232,maximum_uncovered_gap_bytes:0,distinct_lane_addresses:32,contiguous_regions:1} modeled_packets=1 exact_packets=1 unknown_packets=0 *
