// RUN: emit source-low target=amdgpu:gfx942 output=low

// A logical Boolean enters the wave64 kernel ABI as one zero/one SGPR word.
// Predicate consumers perform their own target representation conversion.
kernel.def @predicate_argument_wave64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%enabled: i1, %output: buffer) {
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<1xi32>
  %yes = scalar.constant 17 : i32
  %no = scalar.constant -23 : i32
  %value = scf.select %enabled, %yes, %no : i32
  view.store %value, %view[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "enabled"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_payload_sizes = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @predicate_argument_wave64(%enabled: reg<amdgpu.sgpr>) asm {
  %view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %yes = s_mov_b32 17
  %no = s_mov_b32 4294967273
  %12 = s_cmp_lg_i32_src1_inline %enabled {rhs = 0}
  %value = s_cselect_b32 %yes, %no, %12
  %14 = v_mov_b32_copy %value
  %15 = v_mov_b32 0
  global_store_dword_saddr %15, %14, %view
  return
}
