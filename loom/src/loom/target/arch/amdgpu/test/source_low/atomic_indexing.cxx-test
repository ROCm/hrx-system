// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @increment() asm {
  %workitem_id_x = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %indices = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %counts = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %37 = v_lshlrev_b32_src0_inline %workitem_id_x, 3
  %index = global_load_b64_saddr %37, %indices
  %42 = v_mov_b32 2
  %43 = v_lshlrev_b64 %42, %index
  %44 = slice %43[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %45 = slice %43[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %46 = slice %counts[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47 = slice %counts[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %48, %49 = v_add_co_u32 %46, %44
  %50 = v_mov_b32_copy %47
  %51, %52 = v_add_co_ci_u32 %50, %45, %49
  %53 = concat(%48, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %54 = v_mov_b32 1
  %55 = global_atomic_add_u32_rtn_vaddr %53, %54 {scope = 3}
  return
}

