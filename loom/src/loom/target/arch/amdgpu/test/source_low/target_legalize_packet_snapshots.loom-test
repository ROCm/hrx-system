amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @two_observations() {
  %count = index.constant 1 : index
  kernel.launch.config workgroups(%count, %count, %count) workgroup_size(%count, %count, %count) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<128xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<128xf16>
  %loaded = vector.load %input_view[0] : view<128xf32> -> vector<128xf32>
  %replacement = scalar.constant 99.0 : f32
  view.store %replacement, %input_view[0] : f32, view<128xf32>
  %reloaded = vector.load %input_view[0] : view<128xf32> -> vector<128xf32>
  %sum = vector.addf %loaded, %reloaded : vector<128xf32>
  %converted = vector.fptrunc %sum : vector<128xf32> to vector<128xf16>
  vector.store %converted, %output_view[0] : vector<128xf16>, view<128xf16>
  kernel.return
}

