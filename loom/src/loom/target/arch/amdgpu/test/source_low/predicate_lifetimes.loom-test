  global_store_b32_saddr %156, %tail_word, %outputs {offset = 8}
  global_store_b32_saddr %156, %begin_word, %outputs {offset = 12}
  global_store_b64_saddr %156, %predicate_words, %outputs {offset = 16}
  return
}

// ====

// RUN: emit source-low output=low

amdgpu.target<gfx1151> @target {subgroup_size = 32}

// The bound is launch-uniform, so every lane observes each comparison in the
// final iteration. The predicate can remain a native mask across the exit.
kernel.def target(@target) @uniform_predicate_lifetime() {
  %unit = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%output: buffer, %limit: i32) {
  %lane = kernel.workitem.id<x> : index
  %lane_word = index.cast %lane : index to i32
  %base = index.constant 0 : offset
  %outputs = buffer.view %output[%base] : buffer -> view<64xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  cfg.br ^loop(%c0: i32)
^loop(%iteration: i32):
  %predicate = scalar.cmpi slt, %lane_word, %iteration : i32
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %c1 : i32
  cfg.br ^loop(%next: i32)
^exit:
  %word = scf.select %predicate, %c1, %c0 : i32
  view.store %word, %outputs[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "limit"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_predicate_lifetime(%limit: reg<amdgpu.sgpr>) asm {
  %lane_word = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %outputs = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c0 = s_mov_b32 0
  %c1 = s_mov_b32 1
  low.br ^loop(%c0: reg<amdgpu.sgpr>)
^loop(%iteration: reg<amdgpu.sgpr>):
  %predicate = v_cmp_lt_i32 %lane_word, %iteration
  %again = s_cmp_lt_i32 %iteration, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %next = s_add_u32 %iteration, %c1
  low.br ^loop(%next: reg<amdgpu.sgpr>)
^exit:
  %word = v_cndmask_b32_src0_lit_src1_inline %predicate {imm32 = 0, true_value = 1}
  %25 = v_lshlrev_b32_src0_inline %lane_word, 2
  global_store_b32_saddr %25, %word, %outputs
  return
}
