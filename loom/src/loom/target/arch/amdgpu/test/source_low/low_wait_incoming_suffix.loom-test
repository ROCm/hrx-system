// RUN: emit amdgpu-assembly @guarded_suffix_gfx1151

// The issue path preserves its younger load at the old-only add. Both
// the final add and the skip path still require completion.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @guarded_suffix_gfx1151(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  %old = global_load_b32_saddr %address, %base
  low.cond_br %condition, ^issue, ^skip : reg<amdgpu.scc>
^issue:
  %younger = global_load_b32_saddr %address, %base {offset = 4}
  %used = v_add_u32 %old, %address
  %result = v_add_u32 %used, %younger
  return %result
^skip:
  %skipped = v_add_u32 %old, %address
  return %skipped
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  global_load_b32 v2, v0, s[0:1] offset:4
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v0, v1, v0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v2
  s_endpgm
.Lbb2:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v1, v0
  s_endpgm

// ====
// RUN: with-checks emit amdgpu-assembly @guarded_suffix_gfx942

// The issue path preserves its younger load at the old-only add. Both
// the final add and the skip path still require completion.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @guarded_suffix_gfx942(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  %old = global_load_dword_saddr %address, %base : reg<amdgpu.vgpr>
  low.cond_br %condition, ^issue, ^skip : reg<amdgpu.scc>
^issue:
  %younger = global_load_dword_saddr %address, %base {offset = 4} : reg<amdgpu.vgpr>
  %used = v_add_u32 %old, %address
  %result = v_add_u32 %used, %younger
  return %result
^skip:
  %skipped = v_add_u32 %old, %address
  return %skipped
}

// ----
CHECK: s_waitcnt vmcnt(1)*
CHECK: s_waitcnt vmcnt(0)*

