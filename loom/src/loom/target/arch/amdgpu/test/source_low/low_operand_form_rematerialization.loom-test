// RUN: pass low-cse,low-select-operand-forms,low-dce

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vop3_literal_rematerializes_remaining_constant(%factor: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %addend = v_mov_b32 127
  %kept = v_mov_b32_copy %addend
  %literal = v_mov_b32 128
  %result = v_mad_u32_u24 %factor, %literal, %addend
  return %kept, %result
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vop3_literal_rematerializes_remaining_constant(%factor: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %kept = v_mov_b32 127
  %addend_remat = v_mov_b32 127
  %result = v_mad_u32_u24_src1_lit %factor, %addend_remat, 128
  return %kept, %result
}

// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vop3_literal_preserves_remaining_constant_with_later_use(%factor: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %addend = v_mov_b32 127
  %literal = v_mov_b32 128
  %result = v_mad_u32_u24 %factor, %literal, %addend
  %later = v_mov_b32_copy %addend
  return %result, %later
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vop3_literal_preserves_remaining_constant_with_later_use(%factor: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %addend = v_mov_b32 127
  %result = v_mad_u32_u24_src1_lit %factor, %addend, 128
  %later = v_mov_b32 127
  return %result, %later
}

// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vop3_literal_reuses_duplicate_rematerialized_operand(%factor: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %addend = v_mov_b32 127
  %kept = v_mov_b32_copy %addend
  %literal = v_mov_b32 128
  %result = v_mad_u32_u24 %literal, %addend, %addend
  return %kept, %result
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vop3_literal_reuses_duplicate_rematerialized_operand(%factor: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %kept = v_mov_b32 127
  %addend_remat = v_mov_b32 127
  %result = v_mad_u32_u24_src0_lit %addend_remat, %addend_remat, 128
  return %kept, %result
}
