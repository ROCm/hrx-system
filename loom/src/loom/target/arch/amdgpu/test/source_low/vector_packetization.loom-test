// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @vector_extf_f16_slice_origin(%input: vector<4xf16>) -> (vector<1xf32>) {
  %slice = vector.slice %input[1] : vector<4xf16> -> vector<1xf16>
  %result = vector.extf %slice : vector<1xf16> to vector<1xf32>
  func.return %result : vector<1xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @vector_extf_f16_slice_origin(%input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %6 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_cvt_f32_f16_input_high %6
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @vector_extf_f16_deinterleaved_odd(%input: vector<4xf16>) -> (vector<2xf32>) {
  %even, %odd = vector.deinterleave<0> %input : vector<4xf16> -> vector<2xf16>, vector<2xf16>
  %result = vector.extf %odd : vector<2xf16> to vector<2xf32>
  func.return %result : vector<2xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @vector_extf_f16_deinterleaved_odd(%input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %7 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %8 = v_cvt_f32_f16_input_high %7
  %9 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %10 = v_cvt_f32_f16_input_high %9
  %result = concat(%8, %10) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

