amdgpu.target<gfx942> @target

func.def target(@target) @vector_extf_f16_cdna_fallback(%input: vector<2xf16>) -> (vector<2xf32>) {
  %result = vector.extf %input : vector<2xf16> to vector<2xf32>
  func.return %result : vector<2xf32>
}

// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @vector_extf_f16_cdna_fallback(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %5 = v_cvt_f32_f16 %input
  %6 = v_lshrrev_b32_src0_inline %input, 16
  %7 = v_cvt_f32_f16 %6
  %result = concat(%5, %7) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}
