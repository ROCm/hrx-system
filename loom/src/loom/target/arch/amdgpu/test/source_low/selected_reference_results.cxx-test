// RUN: emit source-low target=amdgpu:gfx90a output=none
// A private running value and a global byte can feed either level of the
// comparison without producing a mixed-address-space pointer for the target.
#include <hip/hip_runtime.h>

#define KERNEL                                                               \
  __global__ [[loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]

namespace selected_reference {
template <class T>
const T& maximum(const T& left, const T& right) {
  return left < right ? right : left;
}

KERNEL void running_maximum(const char* tags, char* output) {
  char maximum_tag = 0;
  for (int i = 0; i < 8; ++i) {
    maximum_tag = maximum(maximum(maximum_tag, tags[i]), tags[i + 1]);
  }
  output[0] = maximum_tag;
}
}  // namespace selected_reference

// ----
