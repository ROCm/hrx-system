// RUN: emit source-low target=amdgpu:gfx11-generic output=low
// Narrow and wide uniform callers share one retained address signature.
func.def noinline @advance(%value: offset) -> (offset) {
  %increment = index.constant 8 : offset
  %next = index.add %value, %increment : offset
  func.return %next : offset
}

kernel.def @uniform_offsets() {
  %groups = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %groups, %groups) workgroup_size(%threads, %groups, %groups) : index
} launch(%output: buffer, %wide: offset) where [range(%wide, 0, 8589934591)] {
  %small = index.constant 16 : offset
  %first = func.call @advance(%small) : (offset) -> (offset)
  %second = func.call @advance(%wide) : (offset) -> (offset)
  %first_bits = index.cast %first : offset to i64
  %second_bits = index.cast %second : offset to i64
  %origin = index.constant 0 : offset
  %output_view = buffer.view %output[%origin] : buffer -> view<64x2xi64>
  %row = kernel.workitem.id<x> : index
  view.store %first_bits, %output_view[%row, 0] : i64, view<64x2xi64>
  view.store %second_bits, %output_view[%row, 1] : i64, view<64x2xi64>
  kernel.return
}

// ----
low.func.def noinline target<amdgpu.gfx11.generic.core> @advance(%value: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %increment = s_mov_b32 8
  %23 = s_mov_b32 0
  %25 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29, %30 = s_add_co_u32 %25, %increment
  %31, %32 = s_addc_u32 %26, %23, %30
  %next = concat(%29, %31) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %next
}

low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "wide"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [8], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_offsets(%wide: reg<amdgpu.sgpr x2>) where [range(%wide, 0, 8589934591)] asm {
  %row = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %output_view = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %small = s_mov_b32 16
  %38 = s_mov_b32 0
  %39 = concat(%small, %38) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %first_bits = low.func.call pure @advance(%39) : (reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>)
  %second_bits = low.func.call pure @advance(%wide) : (reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>)
  %42 = slice %first_bits[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %43 = v_mov_b32_copy %42
  %44 = slice %first_bits[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = v_mov_b32_copy %44
  %46 = concat(%43, %45) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %47 = v_lshlrev_b32_src0_inline %row, 4
  global_store_b64_saddr %47, %46, %output_view
  %48 = slice %second_bits[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %49 = v_mov_b32_copy %48
  %50 = slice %second_bits[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %51 = v_mov_b32_copy %50
  %52 = concat(%49, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %47, %52, %output_view {offset = 8}
  return
}

