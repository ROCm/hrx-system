low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "raw_base"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 4, resource_count = 3, resource_offsets = [8, 16, 24], resource_parameter_indices = [1, 2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @record_fields(%base: reg<amdgpu.sgpr>) asm {
  %state = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %captured_0 = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %captured_1 = resource<hal_binding> {extent = 8, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %38 = v_mov_b32 42
  %39 = v_mov_b32 0
  %40 = slice %state[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %41 = slice %state[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %42 = s_mov_b32 0
  %43, %44 = s_add_co_u32 %40, %base
  %45, %46 = s_addc_u32 %41, %42, %44
  %47 = concat(%43, %45) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %39, %38, %47
  %49 = s_mov_b32 4
  %50 = s_add_u32 %base, %49
  %51 = s_add_u32_rhs_inline %50, 20
  %76 = s_mov_b32 65535
  %77 = s_and_b32 %41, %76
  %78 = concat(%40, %77) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %79 = s_mov_b32 822173696
  %80 = concat(%78, %51, %79) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %53 = v_mov_b32 1
  %old_count = buffer_atomic_add_u32_rtn %53, %80, %39, %base {offset = 20}
  %59, %60 = s_add_co_u32 %40, %base
  %61, %62 = s_addc_u32 %41, %42, %60
  %63 = concat(%59, %61) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %66 = concat(%39, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %67 = v_mov_b32 1
  %69 = concat(%67, %67) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %70 = concat(%69, %66) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %old_state = global_atomic_cmpswap_b64_rtn_saddr %39, %70, %63 {offset = 24}
  global_store_b32_saddr %39, %old_count, %captured_0
  global_store_b64_saddr %39, %old_state, %captured_1
  return
}
