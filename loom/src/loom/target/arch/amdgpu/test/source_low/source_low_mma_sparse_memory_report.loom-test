// RUN: with-checks compile-report source-to-low,low-dce

amdgpu.target<gfx1200> @target

kernel.def target(@target) @report_sparse_fragment_payload_and_metadata() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %metadata_buffer: buffer, %output_buffer: buffer) {
  %tid = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 32 : index
  %lhs_schema = encoding.define #encoding.operand<element_format=f8e4m3, payload_elements=8, payload_registers=2, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %rhs_schema = encoding.define #encoding.operand<element_format=f8e5m2, payload_elements=16, payload_registers=4> : encoding<schema>
  %lhs_layout = encoding.layout.dense : encoding<layout>
  %rhs_layout = encoding.layout.strided [1, 32] : encoding<layout>
  %lhs_storage = encoding.define #encoding.storage {layout = %lhs_layout : encoding<layout>, schema = %lhs_schema : encoding<schema>} : encoding<storage>
  %rhs_storage = encoding.define #encoding.storage {layout = %rhs_layout : encoding<layout>, schema = %rhs_schema : encoding<schema>} : encoding<storage>
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<16x16xf8E4M3, %lhs_storage>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<32x16xf8E5M2, %rhs_storage>
  %metadata_view = buffer.view %metadata_buffer[%base] : buffer -> view<32xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<32xf32>
  %metadata = vector.load %metadata_view[%tid] : view<32xi32> -> vector<1xi32>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] using {sparsity = %metadata : vector<1xi32>} : view<16x16xf8E4M3, %lhs_storage> -> vector<2xi32>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<32x16xf8E5M2, %rhs_storage> -> vector<4xi32>
  %initial_values = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %initial_values shape [%m, %n] : vector<8xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<2xi32>, vector<4xi32>, vector<8xf32>
  %lane0 = vector.extract %result[0] : vector<8xf32> -> f32
  view.store %lane0, %output_view[%tid] : f32, view<32xf32>
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: source_low[*] * source_op=vector.mma selection=plan descriptor_key=amdgpu.v_swmmac_f32_16x16x32_fp8_bf8 descriptor_semantic_tag=matrix.swmmac.f32.16x16x32.fp8.bf8 *
CHECK: COMPILE-REPORT: source_low_native[*] * source_op=vector.mma native_contraction={tile:1x16x16x32,participants:32,lhs:{evidence:metadata-dependent,bits:8,registers:2,payload:8,positions:256,coordinates:512},rhs:{evidence:exact,bits:8,registers:4,payload:16,positions:512,coordinates:512,owners:1},accumulator:{evidence:exact,bits:32,registers:8,payload:8,positions:256,coordinates:256,owners:1},result:{evidence:exact,bits:32,registers:8,payload:8,positions:256,coordinates:256,owners:1}}
CHECK: COMPILE-REPORT: source_low_memory * packets=4 loads=3 stores=1 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=metadata_buffer * memory_space=global operation=load packet=amdgpu.global_load_b32_saddr storage={element_format:i32}* packets=1 * source_lanes=1 source_bytes=4 * issued_read_bytes=4 issued_write_bytes=0 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=lhs_buffer * memory_space=global operation=load packet=amdgpu.global_load_b64_saddr storage={element_format:f8e4m3,payload_packing:target_fragment,sparsity_policy:n_m_structured}* packets=1 * source_lanes=8 source_bytes=8 * issued_read_bytes=8 issued_write_bytes=0 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=rhs_buffer * memory_space=global operation=load packet=amdgpu.global_load_b128_saddr storage={element_format:f8e5m2,payload_packing:target_fragment}* packets=1 * source_lanes=16 source_bytes=16 * issued_read_bytes=16 issued_write_bytes=0 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=output_buffer * memory_space=global operation=store packet=amdgpu.global_store_b32_saddr storage={element_format:f32}* packets=1 * source_lanes=1 source_bytes=4 * issued_read_bytes=0 issued_write_bytes=4 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.load * source_root=metadata_buffer * dynamic_stride_bytes=4 vector_lane_stride_bytes=4
CHECK: COMPILE-REPORT: source_low_subgroup_access[*] * source_op=vector.fragment.load * source_root=lhs_buffer * memory_space=global operation=load packet=amdgpu.global_load_b64_saddr * subgroup_access={proof:exact,lane_address_proof:compiled-fragment-lane-register-layout,active_lane_proof:subgroup-uniform-control-full-wave,lane_mapping:digit-terms,subgroup_size:32,active_lane_count:32,per_lane_packet_bytes:8,linear_lane_stride_bytes:0,lane_terms:[{divisor:1,modulus:16,byte_stride:16},{divisor:16,modulus:0,byte_stride:8}],interval_coverage:dense,subgroup_requested_bytes:256,subgroup_unique_bytes:256,subgroup_span_bytes:256,maximum_adjacent_lane_delta_bytes:232,maximum_uncovered_gap_bytes:0,distinct_lane_addresses:32,contiguous_regions:1} modeled_packets=1 exact_packets=1 unknown_packets=0 *
CHECK: COMPILE-REPORT: source_low_subgroup_access[*] * source_op=vector.fragment.load * source_root=rhs_buffer * memory_space=global operation=load packet=amdgpu.global_load_b128_saddr * subgroup_access={proof:exact,lane_address_proof:compiled-fragment-lane-register-layout,active_lane_proof:subgroup-uniform-control-full-wave,lane_mapping:digit-terms,subgroup_size:32,active_lane_count:32,per_lane_packet_bytes:16,linear_lane_stride_bytes:0,lane_terms:[{divisor:1,modulus:16,byte_stride:32},{divisor:16,modulus:0,byte_stride:16}],interval_coverage:dense,subgroup_requested_bytes:512,subgroup_unique_bytes:512,subgroup_span_bytes:512,maximum_adjacent_lane_delta_bytes:464,maximum_uncovered_gap_bytes:0,distinct_lane_addresses:32,contiguous_regions:1} modeled_packets=1 exact_packets=1 unknown_packets=0 *
