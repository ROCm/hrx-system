// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Three uniform FMA sources exceed the native scalar source-port budget.
// Scalar and vector legalization each adapt exactly the addend to VGPRs.

kernel.def @f32_uniform_scalar_fma() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%a_buffer: buffer, %b_buffer: buffer, %c_buffer: buffer, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xf32>
  %base = index.constant 0 : offset
  %a_global = buffer.assume.memory_space<global> %a_buffer : buffer
  %b_global = buffer.assume.memory_space<global> %b_buffer : buffer
  %c_global = buffer.assume.memory_space<global> %c_buffer : buffer
  %a_noalias, %b_noalias, %c_noalias = buffer.assume.noalias %a_global, %b_global, %c_global : buffer, buffer, buffer
  %a_view = buffer.view %a_noalias[%base] : buffer -> view<1xf32>
  %b_view = buffer.view %b_noalias[%base] : buffer -> view<1xf32>
  %c_view = buffer.view %c_noalias[%base] : buffer -> view<1xf32>
  %a = view.load %a_view[0] : view<1xf32> -> f32
  %b = view.load %b_view[0] : view<1xf32> -> f32
  %c = view.load %c_view[0] : view<1xf32> -> f32
  %result = scalar.fmaf %a, %b, %c : f32
  view.store %result, %result_view_0[%fixture_lane] : f32, view<64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 4, resource_count = 4, resource_offsets = [0, 8, 16, 24], resource_parameter_indices = [0, 1, 2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @f32_uniform_scalar_fma() asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %a_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %b_view = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c_view = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 256, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %28 = s_mov_b32 0
  %a = s_load_dword %a_view, %28
  %b = s_load_dword %b_view, %28
  %c = s_load_dword %c_view, %28
  %34 = v_mov_b32_copy %c
  %result = v_fma_f32 %a, %b, %34
  %36 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %36, %result, %result_view_0
  return
}

// ====

kernel.def @f32_uniform_vector_fma() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%a_buffer: buffer, %b_buffer: buffer, %c_buffer: buffer, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64x4xf32>
  %base = index.constant 0 : offset
  %a_global = buffer.assume.memory_space<global> %a_buffer : buffer
  %b_global = buffer.assume.memory_space<global> %b_buffer : buffer
  %c_global = buffer.assume.memory_space<global> %c_buffer : buffer
  %a_noalias, %b_noalias, %c_noalias = buffer.assume.noalias %a_global, %b_global, %c_global : buffer, buffer, buffer
  %a_view = buffer.view %a_noalias[%base] : buffer -> view<4xf32>
  %b_view = buffer.view %b_noalias[%base] : buffer -> view<4xf32>
  %c_view = buffer.view %c_noalias[%base] : buffer -> view<4xf32>
  %a = vector.load %a_view[0] : view<4xf32> -> vector<4xf32>
  %b = vector.load %b_view[0] : view<4xf32> -> vector<4xf32>
  %c = vector.load %c_view[0] : view<4xf32> -> vector<4xf32>
  %result = vector.fmaf %a, %b, %c : vector<4xf32>
  vector.store %result, %result_view_0[%fixture_lane, 0] : vector<4xf32>, view<64x4xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 4, resource_count = 4, resource_offsets = [0, 8, 16, 24], resource_parameter_indices = [0, 1, 2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @f32_uniform_vector_fma() asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %a_view = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %b_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c_view = resource<hal_binding> {extent = 16, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 1024, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %31 = s_mov_b32 0
  %a = s_load_dwordx4 %a_view, %31
  %b = s_load_dwordx4 %b_view, %31
  %c = s_load_dwordx4 %c_view, %31
  %37 = slice %a[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %38 = slice %b[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %39 = slice %c[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %40 = v_mov_b32_copy %39
  %41 = v_fma_f32 %37, %38, %40
  %42 = slice %a[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %43 = slice %b[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %44 = slice %c[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %45 = v_mov_b32_copy %44
  %46 = v_fma_f32 %42, %43, %45
  %47 = slice %a[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %48 = slice %b[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %49 = slice %c[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %50 = v_mov_b32_copy %49
  %51 = v_fma_f32 %47, %48, %50
  %52 = slice %a[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %53 = slice %b[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %54 = slice %c[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %55 = v_mov_b32_copy %54
  %56 = v_fma_f32 %52, %53, %55
  %result = concat(%41, %46, %51, %56) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %58 = v_lshlrev_b32_src0_inline %fixture_lane, 4
  global_store_b128_saddr %58, %result, %result_view_0
  return
}
