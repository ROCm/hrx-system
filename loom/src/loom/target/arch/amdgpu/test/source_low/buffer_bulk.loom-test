// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @copy() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %byte_length
  kernel.return
}

