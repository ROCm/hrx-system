// RUN: emit source-low target=amdgpu:gfx942 output=low

// Full vector addresses retain the native floating-point atomic policy.
func.def @wide_f32(%storage: buffer, %offsets: buffer, %value: f32) -> (f32) {
  %c0 = index.constant 0 : offset
  %indices = buffer.view %offsets[%c0] : buffer -> view<1xi64>
  %bits = view.load %indices[0] : view<1xi64> -> i64
  %nonnegative = scalar.assume %bits [range(%bits, 0, 9223372036854775807)] : i64
  %base = index.cast %nonnegative : i64 to offset
  %global = buffer.assume.memory_space<global> %storage : buffer
  %cells = buffer.view %global[%base] : buffer -> view<1xf32>
  view.atomic.reduce<addf, noftz> %value, %cells[0] {ordering = relaxed, scope = device} : f32, view<1xf32>
  %old = view.atomic.rmw<addf, noftz> %value, %cells[0] {ordering = relaxed, scope = device} : f32, view<1xf32> -> f32
  func.return %old : f32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @wide_f32(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %cells = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %indices = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_mov_b32 0
  %base = global_load_dwordx2_saddr %16, %indices : reg<amdgpu.vgpr x2>
  %18 = slice %base[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = slice %base[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20 = slice %cells[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = slice %cells[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22, %23 = v_add_co_u32 %20, %18
  %24 = v_mov_b32_copy %21
  %25, %26 = v_addc_co_u32 %24, %19, %23
  %27 = concat(%22, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_atomic_add_f32_vaddr %27, %value
  %37 = concat(%22, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old = global_atomic_add_f32_rtn_vaddr %37, %value : reg<amdgpu.vgpr>
  return %old
}

