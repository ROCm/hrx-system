// RUN: emit source-low target=amdgpu:gfx942 output=low

// Exact contracts cover one- and two-register tables, partial results, a
// recursive table selection, and composed nibble decode.

func.def @byte_table_4_lanes_1(%table: vector<4xi8>, %input: vector<1xi8>) -> (vector<1xi8>) {
  %mask = vector.constant 3 : vector<1xi8>
  %indices = vector.andi %input, %mask : vector<1xi8>
  %values = vector.table.lookup %table[%indices] : vector<4xi8>, vector<1xi8> -> vector<1xi8>
  func.return %values : vector<1xi8>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @byte_table_4_lanes_1(%table: reg<amdgpu.vgpr>, %input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %mask = v_mov_b32 50529027
  %indices = v_and_b32 %input, %mask
  %values = v_perm_b32 %table, %table, %indices
  return %values
}

// ====

func.def @byte_table_8_lanes_5(%table: vector<8xi8>, %input: vector<5xi8>) -> (vector<5xi8>) {
  %mask = vector.constant 7 : vector<5xi8>
  %indices = vector.andi %input, %mask : vector<5xi8>
  %values = vector.table.lookup %table[%indices] : vector<8xi8>, vector<5xi8> -> vector<5xi8>
  func.return %values : vector<5xi8>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @byte_table_8_lanes_5(%table: reg<amdgpu.vgpr x2>, %input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = v_mov_b32 117901063
  %12 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_and_b32 %12, %9
  %15 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %17 = v_and_b32 %15, %9
  %19 = slice %table[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20 = slice %table[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %23 = v_perm_b32 %20, %19, %14
  %24 = v_perm_b32 %20, %19, %17
  %values = concat(%23, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %values
}

// ====

func.def @byte_table_16_lanes_5(%table: vector<16xi8>, %input: vector<5xi8>) -> (vector<5xi8>) {
  %mask = vector.constant 15 : vector<5xi8>
  %indices = vector.andi %input, %mask : vector<5xi8>
  %values = vector.table.lookup %table[%indices] : vector<16xi8>, vector<5xi8> -> vector<5xi8>
  func.return %values : vector<5xi8>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @byte_table_16_lanes_5(%table: reg<amdgpu.vgpr x4>, %input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = v_mov_b32 252645135
  %12 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_and_b32 %12, %9
  %15 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %17 = v_and_b32 %15, %9
  %19 = slice %table[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %20 = slice %table[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = slice %table[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22 = slice %table[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %25 = v_and_b32_lit %14, 117901063
  %26 = v_perm_b32 %20, %19, %25
  %27 = v_perm_b32 %22, %21, %25
  %28 = v_and_b32_lit %14, 134744072
  %29 = v_lshrrev_b32_src0_inline %28, 1
  %30 = v_or_b32_lit %29, 50462976
  %31 = v_perm_b32 %27, %26, %30
  %32 = v_and_b32_lit %17, 117901063
  %33 = v_perm_b32 %20, %19, %32
  %34 = v_perm_b32 %22, %21, %32
  %35 = v_and_b32_lit %17, 134744072
  %36 = v_lshrrev_b32_src0_inline %35, 1
  %37 = v_or_b32_lit %36, 50462976
  %38 = v_perm_b32 %34, %33, %37
  %values = concat(%31, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %values
}

// ====

func.def @nibble_lookup_to_float_8(%table: vector<16xi8>, %packed: vector<4xi8>) -> (vector<8xf32>) {
  %indices = vector.bitunpacku<4> %packed : vector<4xi8> -> vector<8xi8>
  %values = vector.table.lookup %table[%indices] : vector<16xi8>, vector<8xi8> -> vector<8xi8>
  %converted = vector.sitofp %values : vector<8xi8> to vector<8xf32>
  func.return %converted : vector<8xf32>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @nibble_lookup_to_float_8(%table: reg<amdgpu.vgpr x4>, %packed: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x8>) asm {
  %9 = v_and_b32_lit %packed, 252645135
  %10 = v_lshrrev_b32_src0_inline %packed, 4
  %11 = v_and_b32_lit %10, 252645135
  %12 = s_mov_b32 83952640
  %13 = v_perm_b32 %11, %9, %12
  %14 = s_mov_b32 117638658
  %15 = v_perm_b32 %11, %9, %14
  %17 = slice %table[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = slice %table[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %19 = slice %table[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %20 = slice %table[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %23 = v_and_b32_lit %13, 117901063
  %24 = v_perm_b32 %18, %17, %23
  %25 = v_perm_b32 %20, %19, %23
  %26 = v_and_b32_lit %13, 134744072
  %27 = v_lshrrev_b32_src0_inline %26, 1
  %28 = v_or_b32_lit %27, 50462976
  %29 = v_perm_b32 %25, %24, %28
  %30 = v_and_b32_lit %15, 117901063
  %31 = v_perm_b32 %18, %17, %30
  %32 = v_perm_b32 %20, %19, %30
  %33 = v_and_b32_lit %15, 134744072
  %34 = v_lshrrev_b32_src0_inline %33, 1
  %35 = v_or_b32_lit %34, 50462976
  %36 = v_perm_b32 %32, %31, %35
  %39 = v_mov_b32_sdwa %29 {dst_sel = 6, dst_unused = 0, src0_sel = 0, src0_sext = 1}
  %40 = v_cvt_f32_i32 %39
  %42 = v_mov_b32_sdwa %29 {dst_sel = 6, dst_unused = 0, src0_sel = 1, src0_sext = 1}
  %43 = v_cvt_f32_i32 %42
  %45 = v_mov_b32_sdwa %29 {dst_sel = 6, dst_unused = 0, src0_sel = 2, src0_sext = 1}
  %46 = v_cvt_f32_i32 %45
  %48 = v_mov_b32_sdwa %29 {dst_sel = 6, dst_unused = 0, src0_sel = 3, src0_sext = 1}
  %49 = v_cvt_f32_i32 %48
  %51 = v_mov_b32_sdwa %36 {dst_sel = 6, dst_unused = 0, src0_sel = 0, src0_sext = 1}
  %52 = v_cvt_f32_i32 %51
  %54 = v_mov_b32_sdwa %36 {dst_sel = 6, dst_unused = 0, src0_sel = 1, src0_sext = 1}
  %55 = v_cvt_f32_i32 %54
  %57 = v_mov_b32_sdwa %36 {dst_sel = 6, dst_unused = 0, src0_sel = 2, src0_sext = 1}
  %58 = v_cvt_f32_i32 %57
  %60 = v_mov_b32_sdwa %36 {dst_sel = 6, dst_unused = 0, src0_sel = 3, src0_sext = 1}
  %61 = v_cvt_f32_i32 %60
  %converted = concat(%40, %43, %46, %49, %52, %55, %58, %61) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  return %converted
}
