amdgpu.target<gfx11-generic> @target
kernel.def target(@target) @multidim_workgroup_memory_workitem_xy_b32() {
  %unit = index.constant 1 : index
  %tile = index.constant 8 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%tile, %tile, %unit) : index
} launch() {
  %column = kernel.workitem.id<x> : index
  %row = kernel.workitem.id<y> : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<8x8xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[%row, %column] : vector<1xi32>, view<8x8xi32>
  %loaded = vector.load %scratch_view[%column, %row] : view<8x8xi32> -> vector<1xi32>
  vector.store %loaded, %scratch_view[%row, %column] : vector<1xi32>, view<8x8xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(8, 8, 1) workgroup_count(1, 1, 1) @multidim_workgroup_memory_workitem_xy_b32() asm {
  %packed_tid = live_in<amdgpu.workitem_id.packed.xy> : reg<amdgpu.vgpr>
  %19 = storage {byte_alignment = 16, byte_length = 256} : low.storage<workgroup>
  %column = v_and_b32_lit %packed_tid, 1023
  %21 = v_lshrrev_b32_src0_inline %packed_tid, 10
  %row = v_and_b32_lit %21, 1023
  %stored_value = v_mov_b32 1
  %25 = v_lshl_add_u32_shift_imm %row, %column, 3
  %26 = v_lshlrev_b32_src0_inline %25, 2
  low.op<amdgpu.ds_write_b32>(%26, %stored_value) {offset = 0} memory_access([0, 3, 6, -1, 43, 4, 0, 4, 3, 0, 252, 4, 256]) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>)
  %27 = v_lshl_add_u32_shift_imm %column, %row, 3
  %28 = v_lshlrev_b32_src0_inline %27, 2
  %loaded = low.op<amdgpu.ds_read_b32>(%28) {offset = 0} memory_access([0, 3, 6, -1, 43, 4, 0, 4, 3, 0, 252, 4, 256]) : (reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr>
  low.op<amdgpu.ds_write_b32>(%26, %loaded) {offset = 0} memory_access([0, 3, 6, -1, 43, 4, 0, 4, 3, 0, 252, 4, 256]) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>)
  return
}
