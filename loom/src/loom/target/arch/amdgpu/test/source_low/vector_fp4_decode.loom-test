// RDNA keeps both lookup words scalar and uses the zero-source literal
// byte-permute form.
amdgpu.target<gfx1100> @target

func.def target(@target) @decode_packed_e2m1_rdna(%payload: vector<1xi32>) -> (vector<8xf16>) {
