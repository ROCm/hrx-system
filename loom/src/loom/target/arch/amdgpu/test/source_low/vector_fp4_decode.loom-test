// CDNA materializes one lookup word in a VGPR to satisfy its VOP3
// constant-bus restriction.
amdgpu.target<gfx942> @target

func.def target(@target) @decode_packed_e2m1_cdna(%payload: vector<1xi32>) -> (vector<8xf16>) {
  %schema = encoding.define #encoding.f4e2m1<payload_elements=8, payload_packing=little_endian_nibbles, payload_registers=1> : encoding<schema>
  %decoded = vector.decode %payload using %schema : vector<1xi32>, encoding<schema> -> vector<8xf16>
  func.return %decoded : vector<8xf16>
}

