  %global = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = storage {byte_alignment = 16, byte_length = 256} : low.storage<workgroup>
  %predicate = v_cmp_lt_u32 %lane, %limit
  %21 = v_lshlrev_b32_src0_inline %lane, 2
  %22 = s_mov_b32_m0_imm 0
  %23, %24 = s_and_saveexec_b64 %predicate
