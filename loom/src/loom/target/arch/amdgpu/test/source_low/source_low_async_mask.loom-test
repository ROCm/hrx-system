// RUN: emit source-low output=low

amdgpu.target<gfx942> @target

kernel.def target(@target) @masked_gather_gfx942_4_bytes() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %limit: index) {
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %predicate = index.cmp ult, %lane, %limit : index
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source_base = buffer.view %global[%base] : buffer -> view<64x2xbf16>
  %source = view.subview %source_base[%lane, 0] : view<64x2xbf16> -> view<1x2xbf16>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dest = buffer.view %scratch[%base] : buffer -> view<64x1x2xbf16>
  %copy = kernel.async.gather.mask %source to %dest, %predicate {cache_scope = device, cache_temporal = regular} : view<1x2xbf16> to view<64x1x2xbf16>, i1 -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.return
}

