// RUN: emit source-low output=low

amdgpu.target<gfx950> @target

func.def target(@target) @i32_to_u8x4_bitunpack(%packed: vector<1xi32>) -> (vector<4xi32>) {
  %unpacked = vector.bitunpacku<8> %packed : vector<1xi32> -> vector<4xi32>
  func.return %unpacked : vector<4xi32>
}

// ----
low.func.def target<amdgpu.cdna4.core>(@target) abi(hal_kernel) @i32_to_u8x4_bitunpack(%packed: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %5 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 0, src0_sext = 0}
  %6 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 1, src0_sext = 0}
  %7 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 2, src0_sext = 0}
  %8 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 3, src0_sext = 0}
  %unpacked = concat(%5, %6, %7, %8) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %unpacked
}

// ====

amdgpu.target<gfx950> @target

func.def target(@target) @i32_to_s8x4_bitunpack(%packed: vector<1xi32>) -> (vector<4xi32>) {
  %unpacked = vector.bitunpacks<8> %packed : vector<1xi32> -> vector<4xi32>
  func.return %unpacked : vector<4xi32>
}

// ----
low.func.def target<amdgpu.cdna4.core>(@target) abi(hal_kernel) @i32_to_s8x4_bitunpack(%packed: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %5 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 0, src0_sext = 1}
  %6 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 1, src0_sext = 1}
  %7 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 2, src0_sext = 1}
  %8 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 3, src0_sext = 1}
  %unpacked = concat(%5, %6, %7, %8) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %unpacked
}

// ====

amdgpu.target<gfx950> @target

func.def target(@target) @i32_to_u16x2_bitunpack(%packed: vector<1xi32>) -> (vector<2xi32>) {
  %unpacked = vector.bitunpacku<16> %packed : vector<1xi32> -> vector<2xi32>
  func.return %unpacked : vector<2xi32>
}

// ----
low.func.def target<amdgpu.cdna4.core>(@target) abi(hal_kernel) @i32_to_u16x2_bitunpack(%packed: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %5 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 4, src0_sext = 0}
  %6 = v_mov_b32_sdwa %packed {dst_sel = 6, dst_unused = 0, src0_sel = 5, src0_sext = 0}
  %unpacked = concat(%5, %6) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %unpacked
}

// ====

amdgpu.target<gfx950> @target

// Register selectors are materialized once and reused across source words.
func.def target(@target) @i8x8_to_u4x16_bitunpack_i8_result(%packed: vector<8xi8>) -> (vector<16xi8>) {
  %unpacked = vector.bitunpacku<4> %packed : vector<8xi8> -> vector<16xi8>
  func.return %unpacked : vector<16xi8>
}

// ----
low.func.def target<amdgpu.cdna4.core>(@target) abi(hal_kernel) @i8x8_to_u4x16_bitunpack_i8_result(%packed: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>) asm {
  %5 = slice %packed[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %6 = v_and_b32_lit %5, 252645135
  %7 = v_lshrrev_b32_src0_inline %5, 4
  %8 = v_and_b32_lit %7, 252645135
  %9 = s_mov_b32 83952640
  %10 = v_perm_b32 %8, %6, %9
  %11 = s_mov_b32 117638658
  %12 = v_perm_b32 %8, %6, %11
  %13 = slice %packed[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_and_b32_lit %13, 252645135
  %15 = v_lshrrev_b32_src0_inline %13, 4
  %16 = v_and_b32_lit %15, 252645135
  %17 = v_perm_b32 %16, %14, %9
  %18 = v_perm_b32 %16, %14, %11
  %unpacked = concat(%10, %12, %17, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %unpacked
}
