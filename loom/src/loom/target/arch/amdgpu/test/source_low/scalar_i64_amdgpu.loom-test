low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @varying_product_widths(%values: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %67 = slice %values[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %66 = slice %values[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %26 = v_mul_lo_u32 %67, %66
  %27 = v_mul_hi_u32 %67, %66
  %narrow = concat(%26, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %64 = slice %values[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %63 = slice %values[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %32 = v_mul_lo_u32 %67, %64
  %33 = v_mul_hi_u32 %67, %64
  %34 = v_mul_lo_u32 %67, %63
  %35 = v_add_u32 %33, %34
  %left_narrow = concat(%32, %35) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %61 = slice %values[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %60 = slice %values[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %40 = v_mul_lo_u32 %61, %66
  %41 = v_mul_hi_u32 %61, %66
  %42 = v_mul_lo_u32 %60, %66
  %43 = v_add_u32 %41, %42
  %right_narrow = concat(%40, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %49 = v_mul_lo_u32 %61, %64
  %50 = v_mul_hi_u32 %61, %64
  %51 = v_mul_lo_u32 %61, %63
  %52 = v_mul_lo_u32 %60, %64
  %53 = v_add_u32 %50, %51
  %54 = v_add_u32 %53, %52
  %wide = concat(%49, %54) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %narrow, %left_narrow, %right_narrow, %wide
