low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 8, direct_arg_count = 4, direct_arg_names = {arg0 = "lhs_input", arg1 = "rhs_input", arg2 = "wide_lhs", arg3 = "wide_rhs"}, direct_arg_offsets = [0, 8, 16, 24], direct_arg_parameter_indices = [0, 1, 2, 3], direct_arg_sizes = [8, 8, 8, 8], parameter_count = 8, resource_count = 4, resource_offsets = [32, 40, 48, 56], resource_parameter_indices = [4, 5, 6, 7], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_product_widths(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>, %wide_lhs: reg<amdgpu.sgpr x2>, %wide_rhs: reg<amdgpu.sgpr x2>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_2 = resource<hal_binding> {extent = 512, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_3 = resource<hal_binding> {extent = 512, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %31 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = s_mul_i32 %31, %32
  %34 = s_mul_hi_u32 %31, %32
  %37 = slice %wide_rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = slice %wide_rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %39 = s_mul_i32 %31, %37
  %40 = s_mul_hi_u32 %31, %37
  %41 = s_mul_i32 %31, %38
  %42 = s_add_u32 %40, %41
  %45 = slice %wide_lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46 = slice %wide_lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47 = s_mul_i32 %45, %32
  %48 = s_mul_hi_u32 %45, %32
  %49 = s_mul_i32 %46, %32
  %50 = s_add_u32 %48, %49
  %56 = s_mul_i32 %45, %37
  %57 = s_mul_hi_u32 %45, %37
  %58 = s_mul_i32 %45, %38
  %59 = s_mul_i32 %46, %37
  %60 = s_add_u32 %57, %58
  %61 = s_add_u32 %60, %59
  %64 = v_mov_b32_copy %33
  %66 = v_mov_b32_copy %34
  %67 = concat(%64, %66) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %68 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %68, %67, %result_view_0
  %70 = v_mov_b32_copy %39
  %72 = v_mov_b32_copy %42
  %73 = concat(%70, %72) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %68, %73, %result_view_1
  %76 = v_mov_b32_copy %47
  %78 = v_mov_b32_copy %50
  %79 = concat(%76, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %68, %79, %result_view_2
  %82 = v_mov_b32_copy %56
  %84 = v_mov_b32_copy %61
  %85 = concat(%82, %84) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %68, %85, %result_view_3
  return
}

