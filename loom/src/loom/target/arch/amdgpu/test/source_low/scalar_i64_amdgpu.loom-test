low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @literal_logical_right_shifts(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %value = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %28 = s_mov_b32 8
  %31 = s_mov_b32 31
  %s8 = v_lshrrev_b64 %28, %value
  %s31 = v_lshrrev_b64 %31, %value
  %51 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %39 = v_mov_b32 0
  %s32 = concat(%51, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %43 = v_lshrrev_b32_src0_inline %51, 33
  %s33 = concat(%43, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %47 = v_lshrrev_b32_src0_inline %51, 63
  %s63 = concat(%47, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %value, %s8, %s31, %s32, %s33, %s63
}

// ====

amdgpu.target<gfx11-generic> @target

// Bounded inputs omit only their zero upper-word products, not the upper word
// of the result. The full-width control retains both cross products.
kernel.def target(@target) @uniform_product_widths() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_input: i64, %rhs_input: i64, %wide_lhs: i64, %wide_rhs: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<4x64xi64>
  %lhs = scalar.assume %lhs_input [range(%lhs_input, 0, 4294967295)] : i64
  %rhs = scalar.assume %rhs_input [range(%rhs_input, 0, 4294967295)] : i64
  %narrow = scalar.muli %lhs, %rhs : i64
  %left_narrow = scalar.muli %lhs, %wide_rhs : i64
  %right_narrow = scalar.muli %wide_lhs, %rhs : i64
  %wide = scalar.muli %wide_lhs, %wide_rhs : i64
  view.store %narrow, %result_view_0[0, %fixture_lane] : i64, view<4x64xi64>
  view.store %left_narrow, %result_view_0[1, %fixture_lane] : i64, view<4x64xi64>
  view.store %right_narrow, %result_view_0[2, %fixture_lane] : i64, view<4x64xi64>
  view.store %wide, %result_view_0[3, %fixture_lane] : i64, view<4x64xi64>
  kernel.return
}

