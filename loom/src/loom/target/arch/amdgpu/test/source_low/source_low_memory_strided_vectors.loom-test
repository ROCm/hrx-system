amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @strided_i64x3() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %layout = encoding.layout.strided [1, 3] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %input_view = buffer.view %input[%base] : buffer -> view<3xi64>
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1x3xi64, %layout>
  %output_view = buffer.view %output[%base] : buffer -> view<3xi64>
  %value = vector.load %input_view[0] : view<3xi64> -> vector<3xi64>
  vector.store %value, %scratch_view[0, 0] : vector<3xi64>, view<1x3xi64, %layout>
  %staged = vector.load %scratch_view[0, 0] : view<1x3xi64, %layout> -> vector<3xi64>
  vector.store %staged, %output_view[0] : vector<3xi64>, view<3xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @strided_i64x3() asm {
  %input_view = resource<hal_binding> {extent = 24, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 24, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = storage {byte_alignment = 8, byte_length = 64} : low.storage<workgroup>
  %16 = v_mov_b32 0
  %17 = global_load_b128_saddr %16, %input_view
  %18 = global_load_b64_saddr %16, %input_view {offset = 16}
  %37 = slice %17[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %35 = slice %17[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  ds_write2_b64 %16, %37, %35 {offset1 = 3}
  ds_write_b64 %16, %18 {offset = 48}
  %27 = ds_read2_b64 %16 {offset1 = 3}
  %29 = ds_read_b64 %16 {offset = 48}
  global_store_b128_saddr %16, %27, %output_view
  global_store_b64_saddr %16, %29, %output_view {offset = 16}
  return
}
