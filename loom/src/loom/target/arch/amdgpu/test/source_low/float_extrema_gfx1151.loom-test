// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @float_extrema_f32(%lhs: f32, %rhs: f32) -> (f32, f32, f32, f32) {
  %minimum = scalar.minimumf %lhs, %rhs : f32
  %maximum = scalar.maximumf %lhs, %rhs : f32
  %minnum = scalar.minnumf %lhs, %rhs : f32
  %maxnum = scalar.maxnumf %lhs, %rhs : f32
  func.return %minimum, %maximum, %minnum, %maxnum : f32, f32, f32, f32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float_extrema_f32(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %24 = v_max_f32 %lhs, %lhs
  %25 = v_max_f32 %rhs, %rhs
  %26 = v_min_f32 %24, %25
  %27 = v_cmp_u_f32 %lhs, %rhs
  %minimum = v_cndmask_b32_src1_lit %26, %27, 2143289344
  %32 = v_max_f32 %24, %25
  %maximum = v_cndmask_b32_src1_lit %32, %27, 2143289344
  return %minimum, %maximum, %26, %32
}

// ====

kernel.def @float_extrema_uniform() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_bits: i32, %rhs_bits: i32, %result_buffer_0: buffer, %result_buffer_1: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xf32>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xf32>
  %lhs = scalar.bitcast %lhs_bits : i32 to f32
  %rhs = scalar.bitcast %rhs_bits : i32 to f32
  %minimum = scalar.minnumf %lhs, %rhs : f32
  %maximum = scalar.maxnumf %lhs, %rhs : f32
  view.store %minimum, %result_view_0[%fixture_lane] : f32, view<64xf32>
  view.store %maximum, %result_view_1[%fixture_lane] : f32, view<64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs_bits", arg1 = "rhs_bits"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 4, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @float_extrema_uniform(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = s_max_f32 %lhs, %lhs
  %20 = s_max_f32 %rhs, %rhs
  %minimum = s_min_f32 %19, %20
  %maximum = s_max_f32 %19, %20
  %25 = v_mov_b32_copy %minimum
  %26 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %26, %25, %result_view_0
  %27 = v_mov_b32_copy %maximum
  global_store_b32_saddr %26, %27, %result_view_1
  return
}

// ====

func.def @float_extrema_no_nan(%lhs: f32, %rhs: f32) -> (f32, f32, f32) {
  %minimum = scalar.minnumf<nnan> %lhs, %rhs : f32
  %maximum = scalar.maxnumf<nnan> %lhs, %rhs : f32
  %upper_bound = scalar.constant 1.0 : f32
  %bounded = scalar.minnumf<nnan> %lhs, %upper_bound : f32
  func.return %minimum, %maximum, %bounded : f32, f32, f32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float_extrema_no_nan(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %minimum = v_min_f32 %lhs, %rhs
  %maximum = v_max_f32 %lhs, %rhs
  %bounded = v_min_f32_src0_inline %lhs, "f32_1_0"
  return %minimum, %maximum, %bounded
}
