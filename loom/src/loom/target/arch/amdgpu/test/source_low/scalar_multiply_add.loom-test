amdgpu.target<gfx942> @target

kernel.def target(@target) @commuted_inline_scale_with_uniform_value() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%value: i32, %lanes_buffer: buffer, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %lanes_view = buffer.view %lanes_buffer[%fixture_base] : buffer -> view<64x2xi32>
  %lanes = vector.load %lanes_view[%fixture_lane, 0] : view<64x2xi32> -> vector<2xi32>
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi32>
  %bounded = scalar.assume %value [range(%value, 0, 255)] : i32
  %lane = vector.extract %lanes[0] : vector<2xi32> -> i32
  %scale = scalar.constant 20 : i32
  %product = scalar.muli %scale, %bounded : i32
  %result = scalar.addi %product, %lane : i32
  view.store %result, %result_view_0[%fixture_lane] : i32, view<64xi32>
  kernel.return
}

