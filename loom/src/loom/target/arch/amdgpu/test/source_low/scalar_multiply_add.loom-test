amdgpu.target<gfx942> @target

low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @commuted_inline_scale_with_uniform_value(%bounded: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lanes_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %21 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  %lane = global_load_dword_saddr %21, %lanes_view : reg<amdgpu.vgpr>
  %result = v_mad_u32_u24_src0_inline %bounded, %lane, 20
  %24 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_dword_saddr %24, %result, %result_view_0
  return
}

