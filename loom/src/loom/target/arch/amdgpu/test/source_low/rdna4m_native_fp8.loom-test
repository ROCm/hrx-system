// ====

amdgpu.target<gfx1170> @target

func.def target(@target) @decode_fp8x4(%input: vector<4xf8E4M3>) -> (vector<4xf32>) {
  %result = vector.extf %input : vector<4xf8E4M3> to vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @decode_fp8x4(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %5 = v_cvt_pk_f32_fp8 %input
  %6 = slice %5[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %7 = slice %5[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %8 = v_lshrrev_b32_src0_inline %input, 16
  %9 = v_cvt_pk_f32_fp8 %8
  %10 = slice %9[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = slice %9[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = concat(%6, %7, %10, %11) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

amdgpu.target<gfx1170> @target

func.def target(@target) @encode_fp8x4(%input: vector<4xf32>) -> (vector<4xf8E4M3>) {
  %result = vector.fptrunc %input : vector<4xf32> to vector<4xf8E4M3>
  func.return %result : vector<4xf8E4M3>
}

// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @encode_fp8x4(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr>) asm {
  %5 = v_mov_b32 1138753536
  %6 = v_mov_b32 3286237184
  %7 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = v_med3_num_f32 %7, %5, %6
  %12 = v_cmp_u_f32 %7, %7
  %13 = v_cndmask_b32 %11, %7, %12
  %14 = v_med3_num_f32 %8, %5, %6
  %15 = v_cmp_u_f32 %8, %8
  %16 = v_cndmask_b32 %14, %8, %15
  %17 = v_cvt_pk_fp8_f32_low %13, %16
  %18 = v_med3_num_f32 %9, %5, %6
  %19 = v_cmp_u_f32 %9, %9
  %20 = v_cndmask_b32 %18, %9, %19
  %21 = v_med3_num_f32 %10, %5, %6
  %22 = v_cmp_u_f32 %10, %10
  %23 = v_cndmask_b32 %21, %10, %22
  %result = v_cvt_pk_fp8_f32_high %17, %20, %23
  return %result
}

