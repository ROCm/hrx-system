// RUN: emit source-low output=low

amdgpu.target<gfx1170> @target

func.def target(@target) @decode_fp8(%input: f8E4M3) -> (f32) {
  %result = scalar.extf %input : f8E4M3 to f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @decode_fp8(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_cvt_f32_fp8 %input
  return %result
}

// ====

amdgpu.target<gfx1170> @target

