amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @global_atomic_add_i32() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%buffer_base] : buffer -> view<64xi32>
  %increment = scalar.constant 1 : i32
  view.atomic.reduce<addi> %increment, %view[%tid] {ordering = relaxed, scope = device} : i32, view<64xi32>
  %old = view.atomic.rmw<addi> %increment, %view[%tid] {ordering = relaxed, scope = device} : i32, view<64xi32> -> i32
  kernel.return
}

