// TEMPLATE: loom/src/loom/test/corpus/source_low/packed_payload_offsets.loom-test
// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @packed4_payload_word_offset(%weights: buffer, %block0: index, %word0: index) -> (i32) {
  %block = index.assume %block0 [range(%block0, 0, 63)] : index
  %word = index.assume %word0 [range(%word0, 0, 3)] : index
  %block_byte_stride = index.constant 18 : offset
  %payload_header_offset = index.constant 2 : offset
  %word_byte_stride = index.constant 4 : offset
  %block_base = index.scale %block, %block_byte_stride : index, offset -> offset
  %payload_base = index.add %block_base, %payload_header_offset : offset
  %word_byte_offset = index.scale %word, %word_byte_stride : index, offset -> offset
  %byte_offset = index.add %payload_base, %word_byte_offset : offset
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  %word_view = buffer.view %weights_global[%byte_offset] : buffer -> view<1xi32>
  %packed_word = view.load %word_view[0] : view<1xi32> -> i32
  func.return %packed_word : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @packed4_payload_word_offset(%block: reg<amdgpu.sgpr>, %word: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %word_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %27 = v_mov_b32 0
  %28 = s_mul_i32_rhs_inline %block, 18
  %29 = s_lshl_b32_rhs_inline %word, 2
  %30 = s_add_u32 %28, %29
  %31 = slice %word_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = slice %word_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = s_mov_b32 0
  %34, %35 = s_add_co_u32 %31, %30
  %36, %37 = s_addc_u32 %32, %33, %35
  %38 = concat(%34, %36) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %packed_word = global_load_b32_saddr %27, %38 {offset = 2}
  return %packed_word
}

// ====

func.def @packed5_split_payload_offsets(%weights: buffer, %block0: index, %word0: index) -> (i32, i32) {
  %block = index.assume %block0 [range(%block0, 0, 63)] : index
  %word = index.assume %word0 [range(%word0, 0, 3)] : index
  %block_byte_stride = index.constant 22 : offset
  %side_bits_header_offset = index.constant 2 : offset
  %low_bits_header_offset = index.constant 6 : offset
  %word_byte_stride = index.constant 4 : offset
  %block_base = index.scale %block, %block_byte_stride : index, offset -> offset
  %side_bits_byte_offset = index.add %block_base, %side_bits_header_offset : offset
  %low_bits_base = index.add %block_base, %low_bits_header_offset : offset
  %low_word_byte_offset = index.scale %word, %word_byte_stride : index, offset -> offset
  %low_bits_byte_offset = index.add %low_bits_base, %low_word_byte_offset : offset
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  %side_bits_view = buffer.view %weights_global[%side_bits_byte_offset] : buffer -> view<1xi32>
  %low_bits_view = buffer.view %weights_global[%low_bits_byte_offset] : buffer -> view<1xi32>
  %side_bits_word = view.load %side_bits_view[0] : view<1xi32> -> i32
  %low_bits_word = view.load %low_bits_view[0] : view<1xi32> -> i32
  func.return %side_bits_word, %low_bits_word : i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @packed5_split_payload_offsets(%block: reg<amdgpu.sgpr>, %word: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %low_bits_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %35 = v_mov_b32 0
  %36 = s_mul_i32_rhs_inline %block, 22
  %37 = slice %low_bits_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = slice %low_bits_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %39 = s_mov_b32 0
  %40, %41 = s_add_co_u32 %37, %36
  %42, %43 = s_addc_u32 %38, %39, %41
  %44 = concat(%40, %42) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %side_bits_word = global_load_b32_saddr %35, %44 {offset = 2}
  %48 = s_lshl_b32_rhs_inline %word, 2
  %49 = s_add_u32 %36, %48
  %53, %54 = s_add_co_u32 %37, %49
  %55, %56 = s_addc_u32 %38, %39, %54
  %57 = concat(%53, %55) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %low_bits_word = global_load_b32_saddr %35, %57 {offset = 6}
  return %side_bits_word, %low_bits_word
}

// ====

func.def @packed6_split_payload_offsets(%weights: buffer, %block0: index, %low_word0: index, %high_word0: index, %scale0: index) -> (i32, i32, f16) {
  %block = index.assume %block0 [range(%block0, 0, 63)] : index
  %low_word = index.assume %low_word0 [range(%low_word0, 0, 31)] : index
  %high_word = index.assume %high_word0 [range(%high_word0, 0, 15)] : index
  %scale = index.assume %scale0 [range(%scale0, 0, 15)] : index
  %block_byte_stride = index.constant 210 : offset
  %low_bits_header_offset = index.constant 0 : offset
  %high_bits_header_offset = index.constant 128 : offset
  %scale_header_offset = index.constant 192 : offset
  %word_byte_stride = index.constant 4 : offset
  %half_byte_stride = index.constant 2 : offset
  %block_base = index.scale %block, %block_byte_stride : index, offset -> offset
  %low_bits_base = index.add %block_base, %low_bits_header_offset : offset
  %high_bits_base = index.add %block_base, %high_bits_header_offset : offset
  %scale_base = index.add %block_base, %scale_header_offset : offset
  %low_word_byte_offset = index.scale %low_word, %word_byte_stride : index, offset -> offset
  %high_word_byte_offset = index.scale %high_word, %word_byte_stride : index, offset -> offset
  %scale_element_byte_offset = index.scale %scale, %half_byte_stride : index, offset -> offset
  %low_bits_byte_offset = index.add %low_bits_base, %low_word_byte_offset : offset
  %high_bits_byte_offset = index.add %high_bits_base, %high_word_byte_offset : offset
  %scale_byte_offset = index.add %scale_base, %scale_element_byte_offset : offset
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  %low_bits_view = buffer.view %weights_global[%low_bits_byte_offset] : buffer -> view<1xi32>
  %high_bits_view = buffer.view %weights_global[%high_bits_byte_offset] : buffer -> view<1xi32>
  %scale_view = buffer.view %weights_global[%scale_byte_offset] : buffer -> view<1xf16>
  %low_bits_word = view.load %low_bits_view[0] : view<1xi32> -> i32
  %high_bits_word = view.load %high_bits_view[0] : view<1xi32> -> i32
  %scale_value = view.load %scale_view[0] : view<1xf16> -> f16
  func.return %low_bits_word, %high_bits_word, %scale_value : i32, i32, f16
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @packed6_split_payload_offsets(%block: reg<amdgpu.sgpr>, %low_word: reg<amdgpu.sgpr>, %high_word: reg<amdgpu.sgpr>, %scale: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %scale_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %57 = v_mov_b32 0
  %58 = s_mov_b32 210
  %59 = s_mul_i32 %block, %58
  %60 = s_lshl_b32_rhs_inline %low_word, 2
  %61 = s_add_u32 %59, %60
  %62 = slice %scale_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %63 = slice %scale_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %64 = s_mov_b32 0
  %65, %66 = s_add_co_u32 %62, %61
  %67, %68 = s_addc_u32 %63, %64, %66
  %69 = concat(%65, %67) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %low_bits_word = global_load_b32_saddr %57, %69
  %74 = s_lshl_b32_rhs_inline %high_word, 2
  %75 = s_add_u32 %59, %74
  %79, %80 = s_add_co_u32 %62, %75
  %81, %82 = s_addc_u32 %63, %64, %80
  %83 = concat(%79, %81) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %high_bits_word = global_load_b32_saddr %57, %83 {offset = 128}
  %88 = s_lshl_b32_rhs_inline %scale, 1
  %89 = s_add_u32 %59, %88
  %93, %94 = s_add_co_u32 %62, %89
  %95, %96 = s_addc_u32 %63, %64, %94
  %97 = concat(%93, %95) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %scale_value = global_load_u16_saddr %57, %97 {offset = 192}
  return %low_bits_word, %high_bits_word, %scale_value
}
