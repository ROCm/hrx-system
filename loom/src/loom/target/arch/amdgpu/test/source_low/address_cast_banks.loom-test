// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Narrow address components keep their own register bank across fixed-width
// casts, including values also carried by a loop.
kernel.def @narrow_lane_casts() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%metadata: buffer, %bytes: buffer, %halves: buffer, %words: buffer, %pairs: buffer) {
  %origin = index.constant 0 : offset
  %threads = index.constant 32 : index
  %thread = kernel.workitem.id<x> : index
  %header = buffer.view %metadata[%origin] : buffer -> view<1xi32>
  %count_word = view.load %header[0] : view<1xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, 128)] : index
  %bytes_view = buffer.view %bytes[%origin] : buffer -> view<128xi8>
  %halves_view = buffer.view %halves[%origin] : buffer -> view<128xi16>
  %words_view = buffer.view %words[%origin] : buffer -> view<128xi32>
  %pairs_view = buffer.view %pairs[%origin] : buffer -> view<128xi64>
  scf.for %position = [%thread to %count step %threads] {
    %value_bytes = index.cast %position : index to i8
    view.store %value_bytes, %bytes_view[%position] : i8, view<128xi8>
    %value_halves = index.cast %position : index to i16
    view.store %value_halves, %halves_view[%position] : i16, view<128xi16>
    %value_words = index.cast %position : index to i32
    view.store %value_words, %words_view[%position] : i32, view<128xi32>
    %value_pairs = index.cast %position : index to i64
    view.store %value_pairs, %pairs_view[%position] : i64, view<128xi64>
  }
  %thread_bytes = index.cast %thread : index to i8
  view.store %thread_bytes, %bytes_view[%thread] : i8, view<128xi8>
  %thread_halves = index.cast %thread : index to i16
  view.store %thread_halves, %halves_view[%thread] : i16, view<128xi16>
  %thread_words = index.cast %thread : index to i32
  view.store %thread_words, %words_view[%thread] : i32, view<128xi32>
  %thread_pairs = index.cast %thread : index to i64
  view.store %thread_pairs, %pairs_view[%thread] : i64, view<128xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 5, resource_count = 5, resource_offsets = [0, 8, 16, 24, 32], resource_parameter_indices = [0, 1, 2, 3, 4], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @narrow_lane_casts() asm {
  %thread_words = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %header = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %bytes_view = resource<hal_binding> {extent = 128, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %halves_view = resource<hal_binding> {extent = 256, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %words_view = resource<hal_binding> {extent = 512, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %pairs_view = resource<hal_binding> {extent = 1024, index = 4, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %threads = s_mov_b32 32
  %40 = s_mov_b32 0
  %count = s_load_dword %header, %40
  %43 = s_mov_b64_exec_read
  low.br ^_bb1(%thread_words: reg<amdgpu.vgpr>)
^_bb1(%value_words: reg<amdgpu.vgpr>):
  %42 = v_cmp_lt_i32 %value_words, %count
  %44, %45 = s_and_saveexec_b64 %42
  low.cond_br %45, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %value_bytes = v_bfe_i32_offset_width_inline %value_words {offset = 0, width = 8}
  global_store_b8_saddr %value_words, %value_bytes, %bytes_view
  %value_halves = v_bfe_i32_offset_width_inline %value_words {offset = 0, width = 16}
  %50 = v_lshlrev_b32_src0_inline %value_words, 1
  global_store_short_saddr %50, %value_halves, %halves_view
  %51 = v_lshlrev_b32_src0_inline %value_words, 2
  global_store_b32_saddr %51, %value_words, %words_view
  %52 = v_mov_b32 0
  %value_pairs = concat(%value_words, %52) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %54 = v_lshlrev_b32_src0_inline %value_words, 3
  global_store_b64_saddr %54, %value_pairs, %pairs_view
  %55 = v_add_u32 %threads, %value_words
  low.br ^_bb1(%55: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %43
  %thread_bytes = v_bfe_i32_offset_width_inline %thread_words {offset = 0, width = 8}
  global_store_b8_saddr %thread_words, %thread_bytes, %bytes_view
  %thread_halves = v_bfe_i32_offset_width_inline %thread_words {offset = 0, width = 16}
  %60 = v_lshlrev_b32_src0_inline %thread_words, 1
  global_store_short_saddr %60, %thread_halves, %halves_view
  %61 = v_lshlrev_b32_src0_inline %thread_words, 2
  global_store_b32_saddr %61, %thread_words, %words_view
  %62 = v_mov_b32 0
  %thread_pairs = concat(%thread_words, %62) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %64 = v_lshlrev_b32_src0_inline %thread_words, 3
  global_store_b64_saddr %64, %thread_pairs, %pairs_view
  return
}

// ====

// A loaded wide integer keeps its vector bank through an address join. Memory
// addressing may then project both uniform words into the scalar base address.
kernel.def @loaded_wide_address_join() {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%metadata: buffer, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %field = index.constant 16 : offset
  %header = buffer.view %metadata[%origin] : buffer -> view<1xi32>
  %count = view.load %header[0] : view<1xi32> -> i32
  %inactive = scalar.constant 0 : i32
  %active = scalar.cmpi sgt, %count, %inactive : i32
  %selected = scf.if %active -> (offset) {
    %address_view = buffer.view %metadata[%field] : buffer -> view<1xi64>
    %address_bits = view.load %address_view[0] : view<1xi64> -> i64
    %bounded = scalar.assume %address_bits [range(%address_bits, 0, 9223372036854775807)] : i64
    %address = index.cast %bounded : i64 to offset
    scf.yield %address : offset
  } else {
    scf.yield %origin : offset
  }
  %lane = kernel.workitem.id<x> : index
  %source = buffer.view %input[%selected] : buffer -> view<64xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<64xf32>
  %value = view.load %source[%lane] : view<64xf32> -> f32
  view.store %value, %destination[%lane] : f32, view<64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @loaded_wide_address_join() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %address_view = resource<hal_binding> {extent = 24, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %source = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 256, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %26 = s_mov_b32 0
  %count = s_load_dword %address_view, %26
  %active = s_cmp_gt_i32 %count, %26
  low.cond_br %active, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %address = s_load_dwordx2 %address_view, %26 {offset = 16}
  %49 = slice %address[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %50 = slice %address[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^_bb3(%49: reg<amdgpu.sgpr>, %50: reg<amdgpu.sgpr>)
^_bb2:
  low.br ^_bb3(%26: reg<amdgpu.sgpr>, %26: reg<amdgpu.sgpr>)
^_bb3(%47: reg<amdgpu.sgpr>, %48: reg<amdgpu.sgpr>):
  %35 = v_lshlrev_b32_src0_inline %lane, 2
  %36 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %40, %41 = s_add_co_u32 %36, %47
  %42, %43 = s_addc_u32 %37, %48, %41
  %44 = concat(%40, %42) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_b32_saddr %35, %44
  global_store_b32_saddr %35, %value, %destination
  return
}

// ====

// A negative logical-coordinate alternative does not discard the high word of
// a wide address. The following arithmetic uses the complete joined range.
kernel.def @loaded_mixed_index_join() {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %condition: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %inactive = scalar.constant 0 : i32
  %active = scalar.cmpi ne, %condition, %inactive : i32
  %selected = scf.if %active -> (index) {
    %source = buffer.view %input[%origin] : buffer -> view<1xi64>
    %word = view.load %source[0] : view<1xi64> -> i64
    %bounded = scalar.assume %word [range(%word, 0, 1099511627775)] : i64
    %coordinate = index.cast %bounded : i64 to index
    scf.yield %coordinate : index
  } else {
    %fallback = index.constant -17 : index
    scf.yield %fallback : index
  }
  %step = index.constant 1 : index
  %next = index.add %selected, %step : index
  %value = index.cast %next : index to i64
  %lane = kernel.workitem.id<x> : index
  %destination = buffer.view %output[%origin] : buffer -> view<64xi64>
  view.store %value, %destination[%lane] : i64, view<64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "condition"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 16], resource_parameter_indices = [0, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @loaded_mixed_index_join(%condition: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %inactive = s_mov_b32 0
  %active = s_cmp_lg_i32 %condition, %inactive
  low.cond_br %active, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %coordinate = s_load_dwordx2 %source, %inactive
  %52 = slice %coordinate[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %53 = slice %coordinate[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^_bb3(%52: reg<amdgpu.sgpr>, %53: reg<amdgpu.sgpr>)
^_bb2:
  %29 = s_mov_b32 4294967279
  %30 = s_mov_b32 4294967295
  low.br ^_bb3(%29: reg<amdgpu.sgpr>, %30: reg<amdgpu.sgpr>)
^_bb3(%50: reg<amdgpu.sgpr>, %51: reg<amdgpu.sgpr>):
  %step = s_mov_b32 1
  %39, %40 = s_add_co_u32 %50, %step
  %41, %42 = s_addc_u32 %51, %inactive, %40
  %45 = v_mov_b32_copy %39
  %47 = v_mov_b32_copy %41
  %48 = concat(%45, %47) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %49 = v_lshlrev_b32_src0_inline %lane, 3
  global_store_b64_saddr %49, %48, %destination
  return
}
