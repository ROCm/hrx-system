low.kernel.def target<amdgpu.gfx9_4.generic.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 1, resource_count = 0, resource_offsets = [], resource_parameter_indices = [], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_packed_f16_atomic_add(%value: reg<amdgpu.sgpr>) asm {
  %14 = storage {byte_alignment = 4, byte_length = 64} : low.storage<workgroup>
  %scratch_view = storage_address %14 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %16 = v_mov_b32_copy %value
  ds_pk_add_f16 %scratch_view, %16
  %old = ds_pk_add_rtn_f16 %scratch_view, %16
  return
}

