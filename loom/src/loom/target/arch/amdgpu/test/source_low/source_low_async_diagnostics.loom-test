// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @async_group_argument_rejected(%group: kernel.async.group) {
  // ERROR@+1: LOWERING/029 {op_name="kernel.async.wait", phase_name="source-low"}
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  func.return
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @async_copy_transfer_rejected(%input: buffer) {
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%buffer_base] : buffer -> view<16xi8>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dest = buffer.view %scratch[%buffer_base] : buffer -> view<16xi8>
  // ERROR@+1: AMDGPU/023 {constraint_key="async.transfer_packet"}
  %copy = kernel.async.copy %source to %dest {cache_scope = cu, cache_temporal = regular, direction = global_to_workgroup} : view<16xi8> to view<16xi8> -> kernel.async.token
  // ERROR@+1: AMDGPU/023 {constraint_key="async_group.local_transfer_tokens"}
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  // ERROR@+1: AMDGPU/023 {constraint_key="async_wait.group_token"}
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  func.return
}

// ====

amdgpu.target<gfx950> @target

kernel.def target(@target) @async_gather_destination_read_before_wait() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source_base = buffer.view %global[%buffer_base] : buffer -> view<64x4xi8>
  %source = view.subview %source_base[%tid, 0] : view<64x4xi8> -> view<1x4xi8>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dest = buffer.view %scratch[%buffer_base] : buffer -> view<64x1x4xi8>
  %copy = kernel.async.gather %source to %dest {cache_scope = device, cache_temporal = regular} : view<1x4xi8> to view<64x1x4xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  // ERROR@+1: LOWERING/028 {op_name="view.load", phase_name="source-low"}
  %loaded = view.load %dest[0, 0, 0] : view<64x1x4xi8> -> i8
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi8>
  view.store %loaded, %output_view[0] : i8, view<1xi8>
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.return
}

