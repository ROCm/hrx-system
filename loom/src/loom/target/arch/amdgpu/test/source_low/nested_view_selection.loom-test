// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// A derived selection retains both the selected buffer and its byte base.
func.def @derived_selection(%first: buffer, %second: buffer, %third: buffer, %position_input: index, %select_first: i1, %select_pair: i1) -> (i32) {
  %position = index.assume %position_input [range(%position_input, 1, 2)] : index
  %base0 = index.constant 4 : offset
  %base1 = index.constant 8 : offset
  %base2 = index.constant 12 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %third_aligned = buffer.assume.alignment %third {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%base0] : buffer -> view<4xi32>
  %second_view = buffer.view %second_aligned[%base1] : buffer -> view<4xi32>
  %third_view = buffer.view %third_aligned[%base2] : buffer -> view<1xi32>
  %pair = scf.select %select_first, %first_view, %second_view : view<4xi32>
  %refined = view.refine %pair : view<4xi32> -> view<4xi32>
  %part = view.subview %refined[%position] : view<4xi32> -> view<1xi32>
  %selected = scf.select %select_pair, %part, %third_view : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @derived_selection(%position: reg<amdgpu.sgpr>, %select_first: reg<amdgpu.sgpr>, %select_pair: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %first_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %second_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %third_aligned = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %base0 = s_mov_b32 4
  %base1 = s_mov_b32 8
  %base2 = s_mov_b32 12
  %53 = s_mov_b32 0
  %54 = s_cmp_lg_i32 %select_first, %53
  low.cond_br %54, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %84 = slice %first_aligned[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %85 = slice %first_aligned[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^_bb3(%84: reg<amdgpu.sgpr>, %85: reg<amdgpu.sgpr>, %base0: reg<amdgpu.sgpr>)
^_bb2:
  %86 = slice %second_aligned[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %87 = slice %second_aligned[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^_bb3(%86: reg<amdgpu.sgpr>, %87: reg<amdgpu.sgpr>, %base1: reg<amdgpu.sgpr>)
^_bb3(%82: reg<amdgpu.sgpr>, %83: reg<amdgpu.sgpr>, %pair_offset: reg<amdgpu.sgpr>):
  %56 = concat(%position, %53) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %57 = s_mov_b32 2
  %61 = s_lshl_b64 %56, %57
  %62 = slice %61[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %63 = s_add_u32 %pair_offset, %62
  %65 = s_cmp_lg_i32 %select_pair, %53
  low.cond_br %65, ^_bb4, ^_bb5 : reg<amdgpu.scc>
^_bb4:
  low.br ^_bb6(%82: reg<amdgpu.sgpr>, %83: reg<amdgpu.sgpr>, %63: reg<amdgpu.sgpr>)
^_bb5:
  %80 = slice %third_aligned[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %81 = slice %third_aligned[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^_bb6(%80: reg<amdgpu.sgpr>, %81: reg<amdgpu.sgpr>, %base2: reg<amdgpu.sgpr>)
^_bb6(%76: reg<amdgpu.sgpr>, %77: reg<amdgpu.sgpr>, %selected_offset: reg<amdgpu.sgpr>):
  %66 = v_mov_b32 0
  %70, %71 = s_add_co_u32 %76, %selected_offset
  %72, %73 = s_addc_u32 %77, %53, %71
  %74 = concat(%70, %72) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_b32_saddr %66, %74
  return %value
}

// ====

// Nested selections compose with structured side effects and explicit CFG.
func.def @selection_with_side_effects(%first: buffer, %second: buffer, %third: buffer, %select_first: i1, %select_pair: i1, %enter: i1, %side: i1, %initial: i32) -> (i32) {
  %base = index.constant 0 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %third_aligned = buffer.assume.alignment %third {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%base] : buffer -> view<1xi32>
  %second_view = buffer.view %second_aligned[%base] : buffer -> view<1xi32>
  %third_view = buffer.view %third_aligned[%base] : buffer -> view<1xi32>
  cfg.cond_br %enter, ^producer, ^exit
^producer:
  view.store %initial, %third_view[0] : i32, view<1xi32>
  scf.if %side {
    view.store %initial, %first_view[0] : i32, view<1xi32>
  }
  %pair = scf.select %select_first, %first_view, %second_view : view<1xi32>
  cfg.br ^consumer
^consumer:
  %selected = scf.select %select_pair, %pair, %third_view : view<1xi32>
  %result = view.load %selected[0] : view<1xi32> -> i32
  func.return %result : i32
^exit:
  func.return %initial : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @selection_with_side_effects(%select_first: reg<amdgpu.sgpr>, %select_pair: reg<amdgpu.sgpr>, %enter: reg<amdgpu.sgpr>, %side: reg<amdgpu.sgpr>, %initial: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %first_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %second_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %third_view = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %41 = s_mov_b32 0
  %42 = s_cmp_lg_i32 %enter, %41
  low.cond_br %42, ^producer, ^exit : reg<amdgpu.scc>
^producer:
  %43 = v_mov_b32_copy %initial
  %44 = v_mov_b32 0
  global_store_b32_saddr %44, %43, %third_view
  %46 = s_cmp_lg_i32 %side, %41
  low.cond_br %46, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  global_store_b32_saddr %44, %43, %first_view
  low.br ^_bb3
^_bb3:
  %50 = s_cmp_lg_i32 %select_first, %41
  low.cond_br %50, ^_bb4, ^_bb5 : reg<amdgpu.scc>
^_bb4:
  low.br ^_bb6(%first_view: reg<amdgpu.sgpr x2>)
^_bb5:
  low.br ^_bb6(%second_aligned: reg<amdgpu.sgpr x2>)
^_bb6(%pair_root: reg<amdgpu.sgpr x2>):
  %52 = s_cmp_lg_i32 %select_pair, %41
  low.cond_br %52, ^_bb7, ^_bb8 : reg<amdgpu.scc>
^_bb7:
  low.br ^_bb9(%pair_root: reg<amdgpu.sgpr x2>)
^_bb8:
  low.br ^_bb9(%third_view: reg<amdgpu.sgpr x2>)
^_bb9(%selected: reg<amdgpu.sgpr x2>):
  %result = global_load_b32_saddr %44, %selected
  return %result
^exit:
  %55 = v_mov_b32_copy %initial
  return %55
}
