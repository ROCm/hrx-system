// RUN: emit source-low output=low

amdgpu.target<gfx1201> @target
func.def target(@target) @vector_fptrunc_f32x4_to_bf8(%input: vector<4xf32>) -> (vector<4xf8E5M2>) {
  %converted = vector.fptrunc %input : vector<4xf32> to vector<4xf8E5M2>
  func.return %converted : vector<4xf8E5M2>
}

// ----
low.func.def target(@target) abi(hal_kernel) @vector_fptrunc_f32x4_to_bf8(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr>) asm<amdgpu.rdna4.core> {
  %5 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %6 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %7 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = v_cvt_pk_bf8_f32_low %5, %6
  %converted = v_cvt_pk_bf8_f32_high %9, %7, %8
  return %converted
}

// ====

amdgpu.target<gfx1201> @target
func.def target(@target) @vector_fptrunc_f16x3_to_fp8(%input: vector<3xf16>) -> (vector<3xf8E4M3>) {
  %converted = vector.fptrunc %input : vector<3xf16> to vector<3xf8E4M3>
  func.return %converted : vector<3xf8E4M3>
}

// ----
low.func.def target(@target) abi(hal_kernel) @vector_fptrunc_f16x3_to_fp8(%input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm<amdgpu.rdna4.core> {
  %5 = v_mov_b32 1138753536
  %6 = v_mov_b32 3286237184
  %7 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %8 = v_cvt_f32_f16 %7
  %10 = v_lshrrev_b32_src0_inline %7, 16
  %11 = v_cvt_f32_f16 %10
  %12 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %13 = v_cvt_f32_f16 %12
  %14 = v_cmp_gt_f32 %8, %5
  %15 = v_cndmask_b32 %8, %5, %14
  %16 = v_cmp_lt_f32 %15, %6
  %17 = v_cndmask_b32 %15, %6, %16
  %18 = v_cmp_gt_f32 %11, %5
  %19 = v_cndmask_b32 %11, %5, %18
  %20 = v_cmp_lt_f32 %19, %6
  %21 = v_cndmask_b32 %19, %6, %20
  %22 = v_cvt_pk_fp8_f32_low %17, %21
  %23 = v_cmp_gt_f32 %13, %5
  %24 = v_cndmask_b32 %13, %5, %23
  %25 = v_cmp_lt_f32 %24, %6
  %26 = v_cndmask_b32 %24, %6, %25
  %converted = v_cvt_pk_fp8_f32_high %22, %26, %26
  return %converted
}
