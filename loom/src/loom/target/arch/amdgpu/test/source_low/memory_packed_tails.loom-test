low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @copy_byte_tail_3() asm {
  %source_e5m2 = resource<hal_binding> {extent = 10, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target_e5m2 = resource<hal_binding> {extent = 10, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_mov_b32 0
  %17 = global_load_u16_saddr %16, %source_e5m2 {offset = 1}
  %19 = global_load_i8_saddr %16, %source_e5m2 {offset = 3}
  %20 = v_lshlrev_b32_src0_inline %19, 16
  %value_integer = v_or_b32 %17, %20
  global_store_short_saddr %16, %value_integer, %target_e5m2 {offset = 1}
  %25 = v_lshrrev_b32_src0_inline %value_integer, 16
  global_store_b8_saddr %16, %25, %target_e5m2 {offset = 3}
  %28 = global_load_u16_saddr %16, %source_e5m2 {offset = 4}
  %30 = global_load_i8_saddr %16, %source_e5m2 {offset = 6}
  %31 = v_lshlrev_b32_src0_inline %30, 16
  %value_e4m3 = v_or_b32 %28, %31
  global_store_short_saddr %16, %value_e4m3, %target_e5m2 {offset = 4}
  %36 = v_lshrrev_b32_src0_inline %value_e4m3, 16
  global_store_b8_saddr %16, %36, %target_e5m2 {offset = 6}
  %39 = global_load_u16_saddr %16, %source_e5m2 {offset = 7}
  %41 = global_load_i8_saddr %16, %source_e5m2 {offset = 9}
  %42 = v_lshlrev_b32_src0_inline %41, 16
  %value_e5m2 = v_or_b32 %39, %42
  global_store_short_saddr %16, %value_e5m2, %target_e5m2 {offset = 7}
  %47 = v_lshrrev_b32_src0_inline %value_e5m2, 16
  global_store_b8_saddr %16, %47, %target_e5m2 {offset = 9}
  return
}

