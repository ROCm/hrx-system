// Captured bytes survive an aliasing write and a second volatile observation.
func.def @capture_byte_tail(%input: buffer, %output: buffer, %replacement_input: buffer) {
  %base = index.constant 0 : offset
  %next = index.constant 3 : offset
  %source = buffer.view %input[%base] : buffer -> view<3xi8>
  %before = buffer.view %output[%base] : buffer -> view<3xi8>
  %after = buffer.view %output[%next] : buffer -> view<3xi8>
  %captured = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  %replacement_view = buffer.view %replacement_input[%base] : buffer -> view<3xi8>
  %replacement = vector.load %replacement_view[0] : view<3xi8> -> vector<3xi8>
  vector.store<volatile> %replacement, %source[0] : vector<3xi8>, view<3xi8>
  %reloaded = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  vector.store %captured, %before[0] : vector<3xi8>, view<3xi8>
  vector.store %reloaded, %after[0] : vector<3xi8>, view<3xi8>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @capture_byte_tail() asm {
  %source = resource<hal_binding> {extent = 3, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %after = resource<hal_binding> {extent = 6, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %replacement_view = resource<hal_binding> {extent = 3, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = v_mov_b32 0
  %16 = global_load_u16_saddr<volatile> %15, %source
  %18 = global_load_i8_saddr<volatile> %15, %source {offset = 2}
  %19 = v_lshlrev_b32_src0_inline %18, 16
  %captured = v_or_b32 %16, %19
  %22 = global_load_u16_saddr %15, %replacement_view
  %24 = global_load_i8_saddr %15, %replacement_view {offset = 2}
  %25 = v_lshlrev_b32_src0_inline %24, 16
  %replacement = v_or_b32 %22, %25
  global_store_short_saddr<volatile> %15, %replacement, %source
  %30 = v_lshrrev_b32_src0_inline %replacement, 16
  global_store_b8_saddr<volatile> %15, %30, %source {offset = 2}
  %33 = global_load_u16_saddr<volatile> %15, %source
  %35 = global_load_i8_saddr<volatile> %15, %source {offset = 2}
  %36 = v_lshlrev_b32_src0_inline %35, 16
  %reloaded = v_or_b32 %33, %36
  global_store_short_saddr %15, %captured, %after
  %41 = v_lshrrev_b32_src0_inline %captured, 16
  global_store_b8_saddr %15, %41, %after {offset = 2}
  global_store_short_saddr %15, %reloaded, %after {offset = 3}
  %46 = v_lshrrev_b32_src0_inline %reloaded, 16
  global_store_b8_saddr %15, %46, %after {offset = 5}
  return
}
