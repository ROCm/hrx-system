// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_packed_tails.loom
// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Packed tails touch only their authored bytes, including the last register.
func.def @copy_byte_tail_3(%input: buffer, %output: buffer) {
  %origin_integer = index.constant 1 : offset
  %source_integer = buffer.view %input[%origin_integer] : buffer -> view<3xi8>
  %target_integer = buffer.view %output[%origin_integer] : buffer -> view<3xi8>
  %value_integer = vector.load %source_integer[0] : view<3xi8> -> vector<3xi8>
  vector.store %value_integer, %target_integer[0] : vector<3xi8>, view<3xi8>
  %origin_e4m3 = index.constant 4 : offset
  %source_e4m3 = buffer.view %input[%origin_e4m3] : buffer -> view<3xf8E4M3>
  %target_e4m3 = buffer.view %output[%origin_e4m3] : buffer -> view<3xf8E4M3>
  %value_e4m3 = vector.load %source_e4m3[0] : view<3xf8E4M3> -> vector<3xf8E4M3>
  vector.store %value_e4m3, %target_e4m3[0] : vector<3xf8E4M3>, view<3xf8E4M3>
  %origin_e5m2 = index.constant 7 : offset
  %source_e5m2 = buffer.view %input[%origin_e5m2] : buffer -> view<3xf8E5M2>
  %target_e5m2 = buffer.view %output[%origin_e5m2] : buffer -> view<3xf8E5M2>
  %value_e5m2 = vector.load %source_e5m2[0] : view<3xf8E5M2> -> vector<3xf8E5M2>
  vector.store %value_e5m2, %target_e5m2[0] : vector<3xf8E5M2>, view<3xf8E5M2>
  func.return
}

