low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @mixed_scc_predicate_bitwise(%values: reg<amdgpu.vgpr x2>, %limit: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %lane = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %mask = v_cmp_lt_i32 %lane, %limit
  %and_left_bool = v_cmp_lt_i32_src1_inline %limit {rhs = 1}
  %and_right_bool = v_cmp_lt_i32_src1_inline %limit {rhs = 2}
  %or_left_bool = v_cmp_lt_i32_src1_inline %limit {rhs = 3}
  %or_right_bool = v_cmp_lt_i32_src1_inline %limit {rhs = 4}
  %xor_left_bool = v_cmp_lt_i32_src1_inline %limit {rhs = 5}
  %xor_right_bool = v_cmp_lt_i32_src1_inline %limit {rhs = 6}
  %and_left = s_and_b64 %and_left_bool, %mask
  %and_right = s_and_b64 %mask, %and_right_bool
  %or_left = s_or_b64 %or_left_bool, %mask
  %or_right = s_or_b64 %mask, %or_right_bool
  %xor_left = s_xor_b64 %xor_left_bool, %mask
  %xor_right = s_xor_b64 %mask, %xor_right_bool
  %and_left_result = v_cndmask_b32 %limit, %lane, %and_left
  %and_right_result = v_cndmask_b32 %limit, %lane, %and_right
  %or_left_result = v_cndmask_b32 %limit, %lane, %or_left
  %or_right_result = v_cndmask_b32 %limit, %lane, %or_right
  %xor_left_result = v_cndmask_b32 %limit, %lane, %xor_left
  %xor_right_result = v_cndmask_b32 %limit, %lane, %xor_right
  return %and_left_result, %and_right_result, %or_left_result, %or_right_result, %xor_left_result, %xor_right_result
}

