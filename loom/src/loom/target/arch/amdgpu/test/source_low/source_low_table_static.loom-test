// RUN: emit source-low target=amdgpu:gfx11-generic output=low

kernel.def @static_table_uniform() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%grid_buffer: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %grid_view = buffer.view %grid_buffer[%origin] : buffer -> view<3xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<16xf32>
  %grid = vector.load %grid_view[0] : view<3xf32> -> vector<3xf32>
  %indices = vector.constant 2 : vector<16xi8>
  %decoded = vector.table.lookup %grid[%indices] : vector<3xf32>, vector<16xi8> -> vector<16xf32>
  vector.store %decoded, %output_view[0] : vector<16xf32>, view<16xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @static_table_uniform() asm {
  %grid_view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 64, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 0
  %grid = global_load_b96_saddr %11, %grid_view
  %15 = slice %grid[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %decoded = concat(%15, %15, %15, %15, %15, %15, %15, %15, %15, %15, %15, %15, %15, %15, %15, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x16>
  %17 = slice %decoded[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %11, %17, %output_view
  %19 = slice %decoded[4] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %11, %19, %output_view {offset = 16}
  %21 = slice %decoded[8] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %11, %21, %output_view {offset = 32}
  %23 = slice %decoded[12] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %11, %23, %output_view {offset = 48}
  return
}

// ====

kernel.def @static_table_permutation() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%grid_buffer: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %grid_view = buffer.view %grid_buffer[%origin] : buffer -> view<3xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<4xf32>
  %grid = vector.load %grid_view[0] : view<3xf32> -> vector<3xf32>
  %first = scalar.constant 0 : i32
  %middle = scalar.constant 1 : i32
  %last = scalar.constant 2 : i32
  %indices = vector.from_elements %last, %first, %last, %middle : vector<4xi32>
  %decoded = vector.table.lookup %grid[%indices] : vector<3xf32>, vector<4xi32> -> vector<4xf32>
  vector.store %decoded, %output_view[0] : vector<4xf32>, view<4xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @static_table_permutation() asm {
  %grid_view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = v_mov_b32 0
  %grid = global_load_b96_saddr %14, %grid_view
  %16 = slice %grid[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %17 = slice %grid[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %18 = slice %grid[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %decoded = concat(%18, %16, %18, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %14, %decoded, %output_view
  return
}

// ====

kernel.def @static_table_partial() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%grid_buffer: buffer, %output: buffer, %index_buffer: buffer) {
  %origin = index.constant 0 : offset
  %grid_view = buffer.view %grid_buffer[%origin] : buffer -> view<3xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<4xf32>
  %grid = vector.load %grid_view[0] : view<3xf32> -> vector<3xf32>
  %index_view = buffer.view %index_buffer[%origin] : buffer -> view<4xi32>
  %dynamic = vector.load %index_view[0] : view<4xi32> -> vector<4xi32>
  %first = scalar.constant 0 : i32
  %last = scalar.constant 2 : i32
  %known_first = vector.insert %first into %dynamic[1] : i32, vector<4xi32>
  %indices = vector.insert %last into %known_first[3] : i32, vector<4xi32>
  %decoded = vector.table.lookup %grid[%indices] : vector<3xf32>, vector<4xi32> -> vector<4xf32>
  vector.store %decoded, %output_view[0] : vector<4xf32>, view<4xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @static_table_partial() asm {
  %grid_view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %index_view = resource<hal_binding> {extent = 16, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = v_mov_b32 0
  %dynamic = global_load_b128_saddr %20, %index_view
  %23 = slice %dynamic[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %25 = slice %dynamic[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %grid = global_load_b96_saddr %20, %grid_view
  %36 = slice %grid[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %37 = slice %grid[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %38 = slice %grid[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %40 = v_cmp_eq_i32_src1_inline %23 {rhs = 1}
  %41 = v_cndmask_b32 %36, %37, %40
  %42 = v_cmp_eq_i32_src1_inline %23 {rhs = 2}
  %43 = v_cndmask_b32 %41, %38, %42
  %45 = v_cmp_eq_i32_src1_inline %25 {rhs = 1}
  %46 = v_cndmask_b32 %36, %37, %45
  %47 = v_cmp_eq_i32_src1_inline %25 {rhs = 2}
  %48 = v_cndmask_b32 %46, %38, %47
  %decoded = concat(%43, %36, %48, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %20, %decoded, %output_view
  return
}
