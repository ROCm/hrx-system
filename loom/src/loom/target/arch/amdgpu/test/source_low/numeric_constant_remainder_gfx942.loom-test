// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_constant_remainder.loom-test
// RUN: with-checks emit source-low output=low

amdgpu.target<gfx942> @target

func.def target(@target) @constant_remainder_uniform(%value: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
CHECK: * = s_mul_i32 *
CHECK: %remainder = s_sub_u32 *
CHECK-NOT: *v_lshl_add_u32*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @constant_remainder_loaded(%input: buffer) -> (i32, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  %mask = scalar.constant 2147483647 : i32
  %nonnegative = scalar.andi %value, %mask : i32
  %position = index.cast %nonnegative : i32 to index
  %index_divisor = index.constant 3 : index
  %index_remainder = index.rem %position, %index_divisor : index
  func.return %remainder, %index_remainder : i32, index
}

// ----
CHECK: * = v_lshl_add_u32_shift_imm *, *, 1
CHECK: %remainder = v_sub* *, *
CHECK: %index_remainder = v_sub* *, *
CHECK-NOT: *v_mul_lo_u32*

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @constant_remainder_factors(%word: i32, %position: index) -> (i32, i32, index, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %c5 = scalar.constant 5 : i32
  %c9 = scalar.constant 9 : i32
  %c5_index = index.constant 5 : index
  %c9_index = index.constant 9 : index
  %word_five = scalar.remui %word, %c5 : i32
  %word_nine = scalar.remui %word, %c9 : i32
  %position_five = index.rem %bounded, %c5_index : index
  %position_nine = index.rem %bounded, %c9_index : index
  func.return %word_five, %word_nine, %position_five, %position_nine : i32, i32, index, index
}

// ----
CHECK: %word_five = s_sub_u32 *
CHECK: %word_nine = s_sub_u32 *
CHECK: %position_five = s_sub_u32 *
CHECK: %position_nine = s_sub_u32 *
CHECK: return %word_five, %word_nine, %position_five, %position_nine

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @constant_remainder_by_seven(%word: i32, %position: index) -> (i32, index, i32, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %word_divisor = scalar.constant 7 : i32
  %index_divisor = index.constant 7 : index
  %word_remainder = scalar.remui %word, %word_divisor : i32
  %index_remainder = index.rem %bounded, %index_divisor : index
  func.return %word_remainder, %index_remainder, %word, %bounded : i32, index, i32, index
}

// ----
CHECK: %word_remainder = s_sub_u32 *
CHECK: %index_remainder = s_sub_u32 *
CHECK: return %word_remainder, %index_remainder, %word, %bounded
