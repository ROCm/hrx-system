// RUN: pass source-to-low

amdgpu.target<gfx1100> @gfx1100

// The concrete gfx1100 record carries the architectural 64 KiB LDS limit.
// ERROR@+1: TARGET/051 {function_name="gfx1100_workgroup_storage_exceeds_limit", target_name="gfx1100", reserved_bytes="65540", limit_bytes="65536"}
kernel.def target(@gfx1100) @gfx1100_workgroup_storage_exceeds_limit() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %byte_length = index.constant 65540 : offset
  %value = scalar.constant 1 : i32
  %storage = buffer.alloca<workgroup> align(16) %byte_length : buffer
  %storage_view = buffer.view %storage[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %value, %storage_view[0] : i32, view<1xi32>
  %loaded = view.load %storage_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ====

// RUN: with-checks pass source-to-low

amdgpu.target<gfx1250> @gfx1250

// gfx1250 permits useful LDS extents above the gfx11 architectural limit.
kernel.def target(@gfx1250) @gfx1250_accepts_large_workgroup_storage() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %byte_length = index.constant 114688 : offset
  %value = scalar.constant 1 : i32
  %storage = buffer.alloca<workgroup> align(16) %byte_length : buffer
  %storage_view = buffer.view %storage[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %value, %storage_view[0] : i32, view<1xi32>
  %loaded = view.load %storage_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ----
CHECK: *storage {byte_alignment = 16, byte_length = 114688} : low.storage<workgroup>

