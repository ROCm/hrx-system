// ERROR@+1: TARGET/051 {function_name="gfx1250_workgroup_storage_exceeds_limit", target_name="gfx1250", reserved_bytes="327681", limit_bytes="327680"}
kernel.def target(@gfx1250) @gfx1250_workgroup_storage_exceeds_limit() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
