// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Packet storage starts after a header and a word-oriented prefix. Byte stores
// and word loads must alias even though their element scales differ.
func.def @packet_alias(%input: buffer, %replacement: i8) -> (i8, i32) {
  %origin = index.constant 64 : offset
  %words = buffer.view %input[%origin] : buffer -> view<16xi32>
  %packet = view.subview %words[3] : view<16xi32> -> view<4xi32>
  %bytes = view.bitcast %packet : view<4xi32> -> view<16xi8>
  view.store %replacement, %bytes[5] : i8, view<16xi8>
  %byte = view.load %bytes[0] : view<16xi8> -> i8
  %word = view.load %packet[1] : view<4xi32> -> i32
  func.return %byte, %word : i8, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @packet_alias(%replacement: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %words = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = slice %words[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = slice %words[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %14
  %17 = v_mov_b32_copy %15
  %18 = concat(%16, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b8_vaddr %18, %replacement {offset = 81}
  %23 = concat(%16, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %byte = global_load_u8_vaddr %23 {offset = 76}
  %29 = concat(%16, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %word = global_load_b32_vaddr %29 {offset = 80}
  return %byte, %word
}

// ====

// A selected view carries its full origin across control flow before it is
// reinterpreted. The bitcast itself must emit no load, copy, or allocation.
func.def @selected_packet_alias(%input: buffer, %condition: i1) -> (i8) {
  %origin = index.constant 64 : offset
  %words = buffer.view %input[%origin] : buffer -> view<16xi32>
  %first = view.subview %words[3] : view<16xi32> -> view<4xi32>
  %second = view.subview %words[8] : view<16xi32> -> view<4xi32>
  %packet = scf.select %condition, %first, %second : view<4xi32>
  %bytes = view.bitcast %packet : view<4xi32> -> view<16xi8>
  %byte = view.load %bytes[5] : view<16xi8> -> i8
  func.return %byte : i8
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @selected_packet_alias(%condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %bytes = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = s_mov_b32 76
  %22 = v_mov_b32_copy %20
  %packet_offset = v_cndmask_b32_src0_lit %22, %condition, 96
  %24 = v_mov_b32 0
  %25 = slice %bytes[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = slice %bytes[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27, %28 = v_add_co_u32 %25, %packet_offset
  %29 = v_mov_b32_copy %26
  %30, %31 = v_add_co_ci_u32 %29, %24, %28
  %32 = concat(%27, %30) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %byte = global_load_u8_vaddr %32 {offset = 5}
  return %byte
}
