// RUN: emit source-low target=amdgpu:gfx11-generic output=low

global.rodata.def @prefix_words = align(64) bytes("070000000a0000000d000000100000001300000016000000190000001c000000")

kernel.def @read_prefix() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %table = global.load @prefix_words : buffer
  %view = buffer.view %table[%origin] : buffer -> view<8xi32>
  %values = vector.load %view[4] : view<8xi32> -> vector<4xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<4xi32>
  vector.store %values, %output_view[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @read_prefix() asm {
  %output_view = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %8 = s_getpc_b64
  %9 = slice %8[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %10 = slice %8[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11, %12 = s_add_u32_rhs_symbol_rel32_lo %9 {symbol = @prefix_words}
  %13, %14 = s_addc_u32_rhs_symbol_rel32_hi %10, %12 {symbol = @prefix_words}
  %view = concat(%11, %13) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %16 = s_mov_b32 0
  %values = s_load_dwordx4 %view, %16 {offset = 16}
  %18 = slice %values[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %20 = slice %values[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %21 = v_mov_b32_copy %20
  %22 = slice %values[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %24 = slice %values[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %25 = v_mov_b32_copy %24
  %26 = concat(%19, %21, %23, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %27 = v_mov_b32 0
  global_store_b128_saddr %27, %26, %output_view
  return
}

// ====

global.rodata.def @words = align(64) bytes("070000000a0000000d000000100000001300000016000000190000001c0000001f0000002200000025000000280000002b0000002e0000003100000034000000")

// Independent lane indices exercise relocations followed by dynamic gathers.
kernel.def @read_words() {
  %unit = index.constant 1 : index
  %threads = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%indices: buffer, %output: buffer) {
  %thread = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %indices_view = buffer.view %indices[%origin] : buffer -> view<4x4xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<4x4xi32>
  %loaded = vector.load %indices_view[%thread, 0] : view<4x4xi32> -> vector<4xi32>
  %mask = vector.splati 15 : vector<4xi32>
  %bounded = vector.andi %loaded, %mask : vector<4xi32>
  %table = global.load @words : buffer
  %view = buffer.view %table[%origin] : buffer -> view<16xi32>
  %values = vector.gather %view[0][%bounded] : view<16xi32>, vector<4xi32> -> vector<4xi32>
  vector.store %values, %output_view[%thread, 0] : vector<4xi32>, view<4x4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(4, 1, 1) workgroup_count(1, 1, 1) @read_words() asm {
  %thread = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %indices_view = resource<hal_binding> {extent = 64, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 64, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %43 = v_lshlrev_b32_src0_inline %thread, 4
  %loaded = global_load_b128_saddr %43, %indices_view
  %45 = s_getpc_b64
  %46 = slice %45[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47 = slice %45[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %48, %49 = s_add_u32_rhs_symbol_rel32_lo %46 {symbol = @words}
  %50, %51 = s_addc_u32_rhs_symbol_rel32_hi %47, %49 {symbol = @words}
  %view = concat(%48, %50) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %53 = slice %loaded[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %54 = v_and_b32_src0_inline %53, 15
  %55 = v_lshlrev_b32_src0_inline %54, 2
  %56 = global_load_b32_saddr %55, %view
  %57 = slice %loaded[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %58 = v_and_b32_src0_inline %57, 15
  %59 = v_lshlrev_b32_src0_inline %58, 2
  %60 = global_load_b32_saddr %59, %view
  %61 = slice %loaded[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %62 = v_and_b32_src0_inline %61, 15
  %63 = v_lshlrev_b32_src0_inline %62, 2
  %64 = global_load_b32_saddr %63, %view
  %65 = slice %loaded[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %66 = v_and_b32_src0_inline %65, 15
  %67 = v_lshlrev_b32_src0_inline %66, 2
  %68 = global_load_b32_saddr %67, %view
  %values = concat(%56, %60, %64, %68) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %70 = v_lshlrev_b32_src0_inline %thread, 4
  global_store_b128_saddr %70, %values, %output_view
  return
}

// ====

global.rodata.def @suffix = align(2) bytes("aabbcc")

// The final byte of a separately aligned, non-word-sized object is live data.
kernel.def @read_tail() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %table = global.load @suffix : buffer
  %view = buffer.view %table[%origin] : buffer -> view<3xi8>
  %byte = view.load %view[2] : view<3xi8> -> i8
  %value = scalar.extui %byte : i8 to i32
  %output_view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %value, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @read_tail() asm {
  %output_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %9 = s_getpc_b64
  %10 = slice %9[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = slice %9[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12, %13 = s_add_u32_rhs_symbol_rel32_lo %10 {symbol = @suffix}
  %14, %15 = s_addc_u32_rhs_symbol_rel32_hi %11, %13 {symbol = @suffix}
  %view = concat(%12, %14) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %17 = v_mov_b32 0
  %value = global_load_u8_saddr %17, %view {offset = 2}
  global_store_b32_saddr %17, %value, %output_view
  return
}
