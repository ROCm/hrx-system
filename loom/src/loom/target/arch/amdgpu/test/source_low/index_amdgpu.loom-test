// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @index_uniform_i64_multiply() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_i64: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %bounded_i64 = scalar.assume %lhs_i64 [range(%lhs_i64, 0, 1023)] : i64
  %lhs_index = index.cast %bounded_i64 : i64 to index
  %stride = index.constant 128 : index
  %product = index.mul %lhs_index, %stride : index
  %result_storage_0 = index.cast %product : index to i64
  view.store %result_storage_0, %result_view_0[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

