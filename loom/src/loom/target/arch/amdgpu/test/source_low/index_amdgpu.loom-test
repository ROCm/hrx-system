^_bb4(%first: reg<amdgpu.vgpr>):
  %22 = s_mov_b64_exec_read
  low.br ^header(%first: reg<amdgpu.vgpr>)
^header(%result: reg<amdgpu.vgpr>):
  %more = v_cmp_lt_u32 %result, %reference_length
  %23, %24 = s_and_saveexec_b64 %more
  low.cond_br %24, ^update, ^_bb5 : reg<amdgpu.scc>
^update:
  %sum = v_add_u32 %result, %reference_length
  %middle = v_lshrrev_b32_src0_inline %sum, 1
  %increment = v_add_u32 %c1, %middle
  %next = v_cndmask_b32 %result, %increment, %choose_upper
  low.br ^header(%next: reg<amdgpu.vgpr>)
^_bb5:
  s_mov_b64_exec %22
  low.br ^exit
^exit:
  return %result
}

