  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %lhs_index = slice %bounded_i64[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = s_mov_b32 7
  %product = s_lshl_b32 %lhs_index, %18
  %20 = s_mov_b32 0
  %23 = v_mov_b32_copy %product
  %25 = v_mov_b32_copy %20
