func.def target(@target) @cfg_binary_search_retains_narrow_index_carrier(%choose_upper: i1, %reference_value: index) -> (i32) {
  %reference_length = index.assume %reference_value [range(%reference_value, 1, 513)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  cfg.br ^header(%c0: index)
^header(%first: index):
  %more = index.cmp ult, %first, %reference_length : index
  cfg.cond_br %more, ^update, ^exit
^update:
  %sum = index.add %first, %reference_length : index
  %middle = index.shrui %sum, %c1 : index
  %increment = index.add %middle, %c1 : index
  %next = scf.select %choose_upper, %increment, %first : index
  cfg.br ^header(%next: index)
^exit:
  %result = index.cast %first : index to i32
  func.return %result : i32
}

