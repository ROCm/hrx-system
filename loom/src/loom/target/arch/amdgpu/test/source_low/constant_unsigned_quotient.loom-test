func.def target(@target) @narrow_quotients(%byte: i8, %halfword: i16) -> (i8, i16) {
  %byte_divisor = scalar.constant 3 : i8
  %halfword_divisor = scalar.constant 7 : i16
  %byte_quotient = scalar.divui %byte, %byte_divisor : i8
  %halfword_quotient = scalar.divui %halfword, %halfword_divisor : i16
