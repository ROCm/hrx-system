  %k_tile_size = index.constant 16 : index
  %k_extent = index.constant 32 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k_tile_size] : vector<16xf16>
