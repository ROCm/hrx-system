amdgpu.target<gfx942> @target

// Extension, multiplication and XOR keep the sign bit clear without an
// assumption on the division itself.
func.def target(@target) @bounded_varying_quotient(%values: vector<2xi32>) -> (i64) {
  %wide = vector.extui %values : vector<2xi32> to vector<2xi64>
  %lhs = vector.extract %wide[0] : vector<2xi64> -> i64
  %rhs = vector.extract %wide[1] : vector<2xi64> -> i64
  %multiplier = scalar.constant 2147483647 : i64
  %product = scalar.muli %lhs, %multiplier : i64
  %hash = scalar.xori %product, %rhs : i64
  %divisor = scalar.constant 7 : i64
  %result = scalar.divui %hash, %divisor : i64
  func.return %result : i64
}

