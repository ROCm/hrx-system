// Both quotient and divisor fit one unsigned word, but their product remains
// two words for the full-width subtraction.
kernel.def target(@target) @narrow_quotient_and_divisor() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: i64, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi64>
  %value = scalar.assume %input [range(%input, 0, 30064771071)] : i64
  %divisor = scalar.constant 7 : i64
  %result = scalar.remui %value, %divisor : i64
  view.store %result, %captured[%capture_lane] : i64, view<64xi64>
  kernel.return
}

