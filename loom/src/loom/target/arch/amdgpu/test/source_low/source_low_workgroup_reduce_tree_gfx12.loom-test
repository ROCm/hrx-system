// TEMPLATE: loom/src/loom/test/corpus/source_low/workgroup_reduce_tree.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1201 output=low

kernel.def @workgroup_tree_float_leader() {
  %unit = index.constant 1 : index
  %size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %input_view = buffer.view %input[%start] : buffer -> view<256xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<1xf32>
  %value = view.load %input_view[%tid] : view<256xf32> -> f32
  %reduced = kernel.workgroup.reduce<addf> %value : f32
  %leader_index = index.constant 0 : index
  %is_leader = index.cmp eq, %tid, %leader_index : index
  scf.if %is_leader {
    view.store %reduced, %output_view[%leader_index] : f32, view<1xf32>
  }
  kernel.return
}

// ----
CHECK: %reduced = v_add_f32_dpp16 * {dpp_ctrl = 321}
CHECK-NOT: * = ds_bpermute_b32 *

// ====

kernel.def @workgroup_tree_integer_leader() {
  %unit = index.constant 1 : index
  %size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %input_view = buffer.view %input[%start] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%start] : buffer -> view<1xi32>
  %value = view.load %input_view[%tid] : view<256xi32> -> i32
  %reduced = kernel.workgroup.reduce<minui> %value : i32
  %leader_index = index.constant 0 : index
  %is_leader = index.cmp eq, %tid, %leader_index : index
  scf.if %is_leader {
    view.store %reduced, %output_view[%leader_index] : i32, view<1xi32>
  }
  kernel.return
}

// ----
CHECK: * = v_mov_b32_dpp16 * {dpp_ctrl = 321}
CHECK: %reduced = v_min_u32 *
CHECK-NOT: * = ds_bpermute_b32 *

// ====

kernel.def @workgroup_tree_vector_all() {
  %unit = index.constant 1 : index
  %size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %input_view = buffer.view %input[%start] : buffer -> view<256x2xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<256x2xf32>
  %value = vector.load %input_view[%tid, 0] : view<256x2xf32> -> vector<2xf32>
  %reduced = kernel.workgroup.reduce<addf> %value : vector<2xf32>
  vector.store %reduced, %output_view[%tid, 0] : vector<2xf32>, view<256x2xf32>
  kernel.return
}

// ----
CHECK: * = v_add_f32_dpp16 * {dpp_ctrl = 321}
CHECK: %reduced = concat(*) : *
CHECK-NOT: * = ds_bpermute_b32 *

// ====

