// RUN: pass target=amdgpu:gfx1151 source-to-low,low-select-operand-forms,low-cse,low-dce

kernel.def @uniform_subtract() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs: i64, %rhs: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %difference = scalar.subi %lhs, %rhs : i64
  view.store %difference, %result_view_0[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 4, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs", arg1 = "rhs"}, direct_arg_offsets = [0, 8], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [8, 8], parameter_count = 3, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_subtract(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17, %18 = s_sub_co_u32 %13, %15
  %19, %20 = s_subb_u32 %14, %16, %18
  %difference = concat(%17, %19) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %22 = slice %difference[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %24 = slice %difference[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = v_mov_b32_copy %24
  %26 = concat(%23, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %27 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %27, %26, %result_view_0
  return
}

// ====

kernel.def @constant_subtract() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%value: i64, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<3x64xi64>
  %c0 = scalar.constant 0 : i64
  %wide = scalar.constant 4294967297 : i64
  %negated = scalar.subi %c0, %value : i64
  %constant_left = scalar.subi %wide, %value : i64
  %constant_right = scalar.subi %value, %wide : i64
  view.store %negated, %captured[0, %capture_lane] : i64, view<3x64xi64>
  view.store %constant_left, %captured[1, %capture_lane] : i64, view<3x64xi64>
  view.store %constant_right, %captured[2, %capture_lane] : i64, view<3x64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [8], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @constant_subtract(%value: reg<amdgpu.sgpr x2>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 1536, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %23 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %66, %67 = s_sub_co_u32_lhs_inline %23, 0
  %68, %69 = s_subb_u32_lhs_inline %24, %67, 0
  %negated = concat(%66, %68) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %70, %71 = s_sub_co_u32_lhs_inline %23, 1
  %72, %73 = s_subb_u32_lhs_inline %24, %71, 1
  %constant_left = concat(%70, %72) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %74, %75 = s_sub_co_u32_rhs_inline %23, 1
  %76, %77 = s_subb_u32_rhs_inline %24, %75, 1
  %constant_right = concat(%74, %76) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %48 = slice %negated[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %49 = v_mov_b32_copy %48
  %50 = slice %negated[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %51 = v_mov_b32_copy %50
  %52 = concat(%49, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %53 = v_lshlrev_b32_src0_inline %capture_lane, 3
  global_store_b64_saddr %53, %52, %captured
  %54 = slice %constant_left[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %55 = v_mov_b32_copy %54
  %56 = slice %constant_left[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %57 = v_mov_b32_copy %56
  %58 = concat(%55, %57) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %53, %58, %captured {offset = 512}
  %60 = slice %constant_right[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %61 = v_mov_b32_copy %60
  %62 = slice %constant_right[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %63 = v_mov_b32_copy %62
  %64 = concat(%61, %63) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %53, %64, %captured {offset = 1024}
  return
}

// ====

func.def @mixed_subtract(%uniform: i64, %values: vector<2xi64>) -> (i64, i64) {
  %varying = vector.extract %values[0] : vector<2xi64> -> i64
  %uniform_left = scalar.subi %uniform, %varying : i64
  %uniform_right = scalar.subi %varying, %uniform : i64
  func.return %uniform_left, %uniform_right : i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @mixed_subtract(%uniform: reg<amdgpu.vgpr x2>, %values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %varying = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %12 = slice %uniform[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %13 = slice %uniform[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = slice %varying[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = slice %varying[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %16, %17 = v_sub_co_u32 %12, %14
  %18, %19 = v_sub_co_ci_u32 %13, %15, %17
  %uniform_left = concat(%16, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %25, %26 = v_sub_co_u32 %14, %12
  %27, %28 = v_sub_co_ci_u32 %15, %13, %26
  %uniform_right = concat(%25, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %uniform_left, %uniform_right
}
