amdgpu.target<gfx942> @target
kernel.def target(@target) @global_atomic_cmpxchg_i64() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer) {
  %tid = kernel.workitem.id<x> : index
  %input_base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%input_base] : buffer -> view<64xi64>
  %expected = scalar.constant 7 : i64
  %replacement = scalar.constant 9 : i64
  %old = view.atomic.cmpxchg %expected, %replacement, %view[%tid] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<64xi64> -> i64
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @global_atomic_cmpxchg_i64() asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %17 = v_mov_b32 0
  %18 = s_mov_b32_m0_imm 0
  %19 = v_mov_b32 7
  %21 = concat(%19, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %22 = v_mov_b32 9
  %24 = concat(%22, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %25 = concat(%24, %21) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %old = global_atomic_cmpswap_x2_rtn_saddr %17, %25, %view, %18
  return
}

// ====

amdgpu.target<gfx942> @target
kernel.def target(@target) @intermediate_block_atomic_output_f32() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c2, %c4, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%partial: buffer, %output: buffer) {
  %intermediate_block = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %partial_global = buffer.assume.memory_space<global> %partial : buffer
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %partial_noalias, %output_noalias = buffer.assume.noalias %partial_global, %output_global : buffer, buffer
  %partial_view = buffer.view %partial_noalias[%buffer_base] : buffer -> view<2x4x64xf32>
  %output_view = buffer.view %output_noalias[%buffer_base] : buffer -> view<4x64xf32>
  %contribution = view.load %partial_view[%intermediate_block, %row, %lane] : view<2x4x64xf32> -> f32
  view.atomic.reduce<addf> %contribution, %output_view[%row, %lane] {ordering = relaxed, scope = device} : f32, view<4x64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(64, 1, 1) workgroup_count(2, 4, 1) @intermediate_block_atomic_output_f32() asm {
  %intermediate_block = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %row = live_in<amdgpu.workgroup_id.y> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %partial_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 2048} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 1024} : reg<amdgpu.sgpr x2>
  %28 = v_lshlrev_b32_src0_inline %lane, 2
  %29 = s_lshl_b32_rhs_inline %intermediate_block, 10
  %30 = s_lshl_b32_rhs_inline %row, 8
  %31 = s_add_u32 %29, %30
  %32 = slice %partial_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = slice %partial_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = s_mov_b32 0
  %35 = s_add_u32 %32, %31
  %36 = s_addc_u32 %33, %34
  %37 = concat(%35, %36) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %38 = s_mov_b32_m0_imm 0
  %contribution = global_load_dword_saddr %28, %37, %38
  %43 = s_lshl_b32_rhs_inline %row, 8
  %44 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47 = s_add_u32 %44, %43
  %48 = s_addc_u32 %45, %34
  %49 = concat(%47, %48) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %42 = s_mov_b32_m0_imm 0
  global_atomic_add_f32_saddr %28, %contribution, %49, %42
  return
}
