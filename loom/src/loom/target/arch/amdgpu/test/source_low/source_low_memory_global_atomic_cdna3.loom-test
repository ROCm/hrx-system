// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @global_atomic_add_i64() asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %13 = v_mov_b32 0
  %14 = s_mov_b32_m0_imm 0
  %15 = v_mov_b32 1
  %17 = concat(%15, %13) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_atomic_add_x2_saddr %13, %17, %view, %14
  %19 = s_mov_b32_m0_imm 0
  %22 = concat(%15, %13) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old = global_atomic_add_x2_rtn_saddr %13, %22, %view, %19
