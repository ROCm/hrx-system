// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @global_atomic_dynamic_add_i64(%value: reg<amdgpu.sgpr x2>) asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 0
  %12 = s_mov_b32_m0_imm 0
  %13 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = v_mov_b32_copy %13
  %15 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %15
  %17 = concat(%14, %16) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %old = global_atomic_add_x2_rtn_saddr %11, %17, %view, %12
  return
}

