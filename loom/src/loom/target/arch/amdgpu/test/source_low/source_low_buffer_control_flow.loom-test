// RUN: emit source-low output=low

// A workgroup-uniform choice between global buffer roots selects both halves of
// the 64-bit address in SGPRs before using it as a scalar global-load base.
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @select_global_buffer(%select_rhs: index) {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%select_rhs: index, %lhs: buffer, %rhs: buffer, %output: buffer) {
  %element_index = index.constant 0 : index
  %rhs_selector = index.constant 1 : index
  %buffer_base = index.constant 0 : offset
  %use_rhs = index.cmp eq, %select_rhs, %rhs_selector : index
  %selected = scf.select %use_rhs, %rhs, %lhs : buffer
  %selected_view = buffer.view %selected[%buffer_base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %selected_value = view.load %selected_view[%element_index] : view<1xi32> -> i32
  view.store %selected_value, %output_view[%element_index] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @select_global_buffer(%select_rhs: reg<amdgpu.sgpr>) asm {
  %lhs = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %rhs = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %rhs_selector = s_mov_b32 1
  %use_rhs = s_cmp_eq_i32 %select_rhs, %rhs_selector
  %20 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = s_cselect_b32 %20, %21, %use_rhs
  %23 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = s_cselect_b32 %23, %24, %use_rhs
  %selected_view = concat(%22, %25) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %27 = v_mov_b32 0
  %selected_value = global_load_b32_saddr %27, %selected_view
  global_store_b32_saddr %27, %selected_value, %output_view
  return
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @select_wide_offsets(%condition: i1, %lhs: offset, %rhs: offset) -> (offset) {
  %selected = scf.select %condition, %lhs, %rhs : offset
  func.return %selected : offset
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @select_wide_offsets(%condition: reg<amdgpu.sgpr>, %lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %9 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %10 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = s_cselect_b32 %10, %11, %9
  %13 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = s_cselect_b32 %13, %14, %9
  %selected = concat(%12, %15) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %selected
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @select_narrow_indices(%condition: i1, %lhs: index, %rhs: index) -> (index) {
  %lhs_bounded = index.assume %lhs [range(%lhs, 0, 1000)] : index
  %rhs_bounded = index.assume %rhs [range(%rhs, 0, 1000)] : index
  %selected = scf.select %condition, %lhs_bounded, %rhs_bounded : index
  func.return %selected : index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @select_narrow_indices(%condition: reg<amdgpu.sgpr>, %lhs_bounded: reg<amdgpu.sgpr>, %rhs_bounded: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %11 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %selected = s_cselect_b32 %lhs_bounded, %rhs_bounded, %11
  return %selected
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @select_mixed_offsets(%condition: i1, %lhs: offset) -> (offset) {
  %rhs_narrow = index.constant 4294967295 : offset
  %selected = scf.select %condition, %lhs, %rhs_narrow : offset
  func.return %selected : offset
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @select_mixed_offsets(%condition: reg<amdgpu.sgpr>, %lhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %rhs_narrow = s_mov_b32 4294967295
  %9 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %10 = s_mov_b32 0
  %12 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = s_cselect_b32 %12, %rhs_narrow, %9
  %15 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = s_cselect_b32 %15, %10, %9
  %selected = concat(%14, %17) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %selected
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @select_reversed_mixed_offsets(%condition: i1, %rhs: offset) -> (offset) {
  %lhs_narrow = index.constant 4294967295 : offset
  %selected = scf.select %condition, %lhs_narrow, %rhs : offset
  func.return %selected : offset
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @select_reversed_mixed_offsets(%condition: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %lhs_narrow = s_mov_b32 4294967295
  %9 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %10 = s_mov_b32 0
  %13 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = s_cselect_b32 %lhs_narrow, %13, %9
  %16 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = s_cselect_b32 %10, %16, %9
  %selected = concat(%14, %17) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %selected
}
