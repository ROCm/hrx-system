amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @lds_b128_split_second_alloca_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %first_bytes = index.constant 64 : offset
  %second_bytes = index.constant 2048 : offset
  %first = buffer.alloca<workgroup> align(16) %first_bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %second_bytes : buffer
  %first_view = buffer.view %first[%buffer_base] : buffer -> view<16xi32>
  %second_view = buffer.view %second[%buffer_base] : buffer -> view<64x8xi32>
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x8xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x8xi32>
  %loaded = vector.load %input_view[%lane, 0] : view<64x8xi32> -> vector<8xi32>
  vector.store %loaded, %second_view[%lane, 0] : vector<8xi32>, view<64x8xi32>
  %roundtrip = vector.load %second_view[%lane, 0] : view<64x8xi32> -> vector<8xi32>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<8xi32>, view<64x8xi32>
  %sentinel = view.load %first_view[0] : view<16xi32> -> i32
  view.store %sentinel, %first_view[1] : i32, view<16xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @lds_b128_split_second_alloca_roundtrip() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 2048} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 2048} : reg<amdgpu.sgpr x2>
  %41 = storage {byte_alignment = 16, byte_length = 64} : low.storage<workgroup>
  %42 = storage {byte_alignment = 16, byte_length = 2048} : low.storage<workgroup>
  %45 = v_lshlrev_b32_src0_inline %lane, 5
  %46 = global_load_b128_saddr %45, %input_view
  %48 = global_load_b128_saddr %45, %input_view {offset = 16}
  ds_write_b128 %45, %46 {offset = 64}
  ds_write_b128 %45, %48 {offset = 80}
  %55 = ds_read_b128 %45 {offset = 64}
  %57 = ds_read_b128 %45 {offset = 80}
  global_store_b128_saddr %45, %55, %output_view
  global_store_b128_saddr %45, %57, %output_view {offset = 16}
  %63 = v_mov_b32 0
  %sentinel = ds_read_b32 %63
  ds_write_b32 %63, %sentinel {offset = 4}
  return
}
