// RUN: emit source-low output=low

amdgpu.target<gfx1151> @target

kernel.def target(@target) @scalar_float_uniform() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_i32: i32, %rhs_i32: i32, %result_buffer_0: buffer, %result_buffer_4: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<4x64xf32>
  %result_view_4 = buffer.view %result_buffer_4[%fixture_base] : buffer -> view<2x64xi32>
  %lhs = scalar.sitofp %lhs_i32 : i32 to f32
  %rhs = scalar.uitofp %rhs_i32 : i32 to f32
  %sum = scalar.addf %lhs, %rhs : f32
  %difference = scalar.subf %sum, %lhs : f32
  %product = scalar.mulf %sum, %difference : f32
  %minimum = scalar.minnumf %product, %sum : f32
  %maximum = scalar.maxnumf %minimum, %difference : f32
  %ceil = scalar.ceilf %maximum : f32
  %floor = scalar.floorf %maximum : f32
  %rounded = scalar.roundevenf %maximum : f32
  %truncated = scalar.truncf %maximum : f32
  %lhs_f16 = scalar.fptrunc %lhs : f32 to f16
  %rhs_f16 = scalar.fptrunc %rhs : f32 to f16
  %sum_f16 = scalar.addf %lhs_f16, %rhs_f16 : f16
  %sum_from_f16 = scalar.extf %sum_f16 : f16 to f32
  %condition = scalar.cmpf olt, %sum_from_f16, %maximum : f32
  %selected = scf.select %condition, %ceil, %floor : f32
  %signed = scalar.fptosi %rounded : f32 to i32
  %unsigned = scalar.fptoui %truncated : f32 to i32
  view.store %selected, %result_view_0[0, %fixture_lane] : f32, view<4x64xf32>
  view.store %rounded, %result_view_0[1, %fixture_lane] : f32, view<4x64xf32>
  view.store %truncated, %result_view_0[2, %fixture_lane] : f32, view<4x64xf32>
  view.store %sum_from_f16, %result_view_0[3, %fixture_lane] : f32, view<4x64xf32>
  view.store %signed, %result_view_4[0, %fixture_lane] : i32, view<2x64xi32>
  view.store %unsigned, %result_view_4[1, %fixture_lane] : i32, view<2x64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs_i32", arg1 = "rhs_i32"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 4, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @scalar_float_uniform(%lhs_i32: reg<amdgpu.sgpr>, %rhs_i32: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_4 = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %lhs = s_cvt_f32_i32 %lhs_i32
  %rhs = s_cvt_f32_u32 %rhs_i32
  %sum = s_add_f32 %lhs, %rhs
  %difference = s_sub_f32 %sum, %lhs
  %product = s_mul_f32 %sum, %difference
  %47 = s_max_f32 %product, %product
  %48 = s_max_f32 %sum, %sum
  %minimum = s_min_f32 %47, %48
  %50 = s_max_f32 %minimum, %minimum
  %51 = s_max_f32 %difference, %difference
  %maximum = s_max_f32 %50, %51
  %ceil = s_ceil_f32 %maximum
  %floor = s_floor_f32 %maximum
  %rounded = s_rndne_f32 %maximum
  %truncated = s_trunc_f32 %maximum
  %lhs_f16 = s_cvt_f16_f32 %lhs
  %rhs_f16 = s_cvt_f16_f32 %rhs
  %sum_f16 = s_add_f16 %lhs_f16, %rhs_f16
  %sum_from_f16 = s_cvt_f32_f16 %sum_f16
  %condition = s_cmp_lt_f32 %sum_from_f16, %maximum
  %selected = s_cselect_b32 %ceil, %floor, %condition
  %signed = s_cvt_i32_f32 %rounded
  %unsigned = s_cvt_u32_f32 %truncated
  %65 = v_mov_b32_copy %selected
  %66 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %66, %65, %result_view_0
  %67 = v_mov_b32_copy %rounded
  global_store_b32_saddr %66, %67, %result_view_0 {offset = 256}
  %69 = v_mov_b32_copy %truncated
  global_store_b32_saddr %66, %69, %result_view_0 {offset = 512}
  %71 = v_mov_b32_copy %sum_from_f16
  global_store_b32_saddr %66, %71, %result_view_0 {offset = 768}
  %73 = v_mov_b32_copy %signed
  global_store_b32_saddr %66, %73, %result_view_4
  %75 = v_mov_b32_copy %unsigned
  global_store_b32_saddr %66, %75, %result_view_4 {offset = 256}
  return
}

// ====

amdgpu.target<gfx1151> @target

func.def target(@target) @scalar_float_lane_values(%lhs: f32, %rhs: f32) -> (f32) {
  %condition = scalar.cmpf olt, %lhs, %rhs : f32
  %result = scf.select %condition, %lhs, %rhs : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @scalar_float_lane_values(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %condition = v_cmp_lt_f32 %lhs, %rhs
  %result = v_cndmask_b32 %rhs, %lhs, %condition
  return %result
}

// ====

amdgpu.target<gfx1151> @target

// A halfword writer must define the whole carrier before returning it.
func.def noinline target(@target) @scalar_half_return(%input: i32) -> (f16) {
  %value = scalar.bitcast %input : i32 to f32
  %half = scalar.fptrunc %value : f32 to f16
  func.return %half : f16
}

kernel.def target(@target) @capture_scalar_half_return() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: i32, %output: buffer) {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %view = buffer.view %output[%base] : buffer -> view<64xf16>
  %half = func.call @scalar_half_return(%input) : (i32) -> (f16)
  view.store %half, %view[%lane] : f16, view<64xf16>
  kernel.return
}

// ----
low.func.def noinline target<amdgpu.rdna3_5.core>(@target) @scalar_half_return(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %half = s_cvt_f16_f32 %value
  %15 = s_bfe_u32_lit_low16 %half
  return %15
}

low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "input"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @capture_scalar_half_return(%input: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %view = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %half = low.func.call pure @scalar_half_return(%input) : (reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>)
  %20 = v_mov_b32_copy %half
  %21 = v_lshlrev_b32_src0_inline %lane, 1
  global_store_short_saddr %21, %20, %view
  return
}

