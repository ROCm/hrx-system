amdgpu.target<gfx1151> @target

kernel.def target(@target) @scalar_half_loop() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: i32, %count: index, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xf16>
  %value = scalar.bitcast %input : i32 to f32
  %initial = scalar.fptrunc %value : f32 to f16
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %count step %step](%carried = %initial : f16) -> (f16) {
    %next = scalar.addf %carried, %initial : f16
    scf.yield %next : f16
  }
  view.store %result, %captured[%capture_lane] : f16, view<64xf16>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "input", arg1 = "count"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @scalar_half_loop(%value: reg<amdgpu.sgpr>, %count: reg<amdgpu.sgpr>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %initial = s_cvt_f16_f32 %value
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %31 = v_bfe_u32_offset_0_width_inline_low16 %initial
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %31: reg<amdgpu.vgpr>)
^_bb1(%iteration: reg<amdgpu.sgpr>, %carried: reg<amdgpu.vgpr>):
  %32 = s_cmp_lt_i32 %iteration, %count
  low.cond_br %32, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %next = v_add_f16 %carried, %31
  %35 = s_add_u32 %iteration, %step
  %36 = v_bfe_u32_offset_0_width_inline_low16 %next
  low.br ^_bb1(%35: reg<amdgpu.sgpr>, %36: reg<amdgpu.vgpr>)
^_bb3:
  %37 = v_lshlrev_b32_src0_inline %capture_lane, 1
  global_store_short_saddr %37, %carried, %captured
  return
}
