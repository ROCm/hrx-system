amdgpu.target<gfx1151> @target

kernel.def target(@target) @scalar_half_select() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs: i32, %rhs: i32, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xf16>
  %lhs_float = scalar.bitcast %lhs : i32 to f32
  %rhs_float = scalar.bitcast %rhs : i32 to f32
  %lhs_half = scalar.fptrunc %lhs_float : f32 to f16
  %rhs_half = scalar.fptrunc %rhs_float : f32 to f16
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  %result = scf.select %condition, %lhs_half, %rhs_half : f16
  view.store %result, %captured[%capture_lane] : f16, view<64xf16>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs", arg1 = "rhs"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @scalar_half_select(%lhs_float: reg<amdgpu.sgpr>, %rhs_float: reg<amdgpu.sgpr>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %lhs_half = s_cvt_f16_f32 %lhs_float
  %rhs_half = s_cvt_f16_f32 %rhs_float
  %condition = s_cmp_lt_i32 %lhs_float, %rhs_float
  %21 = s_bfe_u32_lit_low16 %lhs_half
  %22 = s_bfe_u32_lit_low16 %rhs_half
  %result = s_cselect_b32 %21, %22, %condition
  %24 = v_mov_b32_copy %result
  %25 = v_lshlrev_b32_src0_inline %capture_lane, 1
  global_store_short_saddr %25, %24, %captured
  return
}

