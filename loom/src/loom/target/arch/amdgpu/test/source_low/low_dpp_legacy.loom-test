// RUN: emit amdgpu-assembly @gfx942_legacy_dpp_controls

amdgpu.target<gfx942> @target
low.func.def target<amdgpu.cdna3.core>(@target) @gfx942_legacy_dpp_controls(%offset: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %wave_shl = v_mov_b32_dpp %value {dpp_ctrl = 304}
  %wave_rol = v_mov_b32_dpp %wave_shl {dpp_ctrl = 308}
  %wave_shr = v_mov_b32_dpp %wave_rol {dpp_ctrl = 312}
  %wave_ror = v_mov_b32_dpp %wave_shr {dpp_ctrl = 316}
  %row_bcast15 = v_mov_b32_dpp %wave_ror {dpp_ctrl = 322}
  %row_bcast31 = v_mov_b32_dpp %row_bcast15 {dpp_ctrl = 323}
  %masked = v_mov_b32_dpp_masked %row_bcast31, %value {dpp_ctrl = 177, bank_mask = 10}
  %m0 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %offset, %masked, %output, %m0
  return
}

// ----
  v_mov_b32_dpp v2, v0, wave_shl:1, row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_mov_b32 m0, 0
  s_nop 0
  v_mov_b32_dpp v2, v2, wave_rol:1, row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_nop 1
  v_mov_b32_dpp v2, v2, wave_shr:1, row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_nop 1
  v_mov_b32_dpp v2, v2, wave_ror:1, row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_nop 1
  v_mov_b32_dpp v2, v2, row_bcast:15, row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_nop 1
  v_mov_b32_dpp v2, v2, row_bcast:31, row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  v_mov_b32_dpp v2, v0, quad_perm:[1,0,3,2], row_mask:0xf, bank_mask:0xa, bound_ctrl:1
  global_store_dword v1, v2, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm
