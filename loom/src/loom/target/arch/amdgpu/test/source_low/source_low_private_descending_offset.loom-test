  %112 = v_cmp_lt_u32 %157, %88
  %113 = v_cmp_eq_i32 %158, %91
  %114 = s_and_b64 %113, %112
  %more = s_or_b64 %111, %114
  %117, %118 = s_and_saveexec_b64 %more
  low.cond_br %118, ^_bb5, ^_bb6 : reg<amdgpu.scc>
^_bb5:
  %137 = v_mov_b32 4294967288
  %138 = v_mul_lo_u32 %157, %137
