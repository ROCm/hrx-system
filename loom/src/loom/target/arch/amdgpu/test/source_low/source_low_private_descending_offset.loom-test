// RUN: emit source-low output=low

amdgpu.target<gfx942> @target

kernel.def target(@target) @private_lane_descending_offset() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %scratch = buffer.alloca<private> align(8) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xf64>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xf64>
  %seed = vector.load %input_view[%lane] : view<64xf64> -> vector<1xf64>
  %seed_scalar = vector.extract %seed[0] : vector<1xf64> -> f64
  %scratch_whole = buffer.view %scratch[%buffer_base] : buffer -> view<16xf64>
  %fill_lo = index.constant 0 : index
  %fill_hi = index.constant 16 : index
  %fill_step = index.constant 1 : index
  scf.for %i = [%fill_lo to %fill_hi step %fill_step] {
    view.store %seed_scalar, %scratch_whole[%i] : f64, view<16xf64>
    scf.yield
  }
  %shift = scalar.constant 3 : i64
  %base = index.cast %buffer_base : offset to i64
  %one = scalar.constant 1 : i64
  %lane_i64 = index.cast %lane : index to i64
  %mask = scalar.constant 15 : i64
  %count = scalar.andi %lane_i64, %mask : i64
  %last = scalar.constant 14 : i64
  %first = scalar.constant 0 : i64
  %initial = scalar.constant 0.0 : f64
  %kb_final, %sum = scf.while(%kb = %first : i64, %acc = %initial : f64) -> (i64, f64) {
    %more = scalar.cmpi ult, %kb, %count : i64
    scf.condition %more, %kb, %acc : i1, i64, f64
  } do(%kb_body: i64, %acc_body: f64) {
    %k = scalar.subi %last, %kb_body : i64
    %scaled = scalar.shli %k, %shift : i64
    %byte = scalar.addi %base, %scaled : i64
    %byte_ranged = scalar.assume %byte [range(%byte, 0, 9223372036854775807)] : i64
    %byte_offset = index.cast %byte_ranged : i64 to offset
    %slot = buffer.view %scratch[%byte_offset] : buffer -> view<1xf64>
    %value = view.load %slot[0] : view<1xf64> -> f64
    %next_acc = scalar.addf %acc_body, %value : f64
    %next_kb = scalar.addi %kb_body, %one : i64
    scf.yield %next_kb, %next_acc : i64, f64
  }
  view.store %sum, %output_view[%lane] : f64, view<64xf64>
  kernel.return
}

