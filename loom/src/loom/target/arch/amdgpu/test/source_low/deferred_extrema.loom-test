func.def inline @late_extrema(%exit_early: i1, %lhs: i64, %rhs: i64) -> (i64, i64, i64, i64) {
  func.exit %exit_early : i1 {
    func.return %lhs, %lhs, %lhs, %lhs : i64, i64, i64, i64
  }
  %signed_minimum = scalar.minsi %lhs, %rhs : i64
  %signed_maximum = scalar.maxsi %lhs, %rhs : i64
  %unsigned_minimum = scalar.minui %lhs, %rhs : i64
  %unsigned_maximum = scalar.maxui %lhs, %rhs : i64
  func.return %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum : i64, i64, i64, i64
}

func.def public @late_extrema_caller(%exit_early: i1, %lhs: i64, %rhs: i64) -> (i64, i64, i64, i64) {
  %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum = func.call @late_extrema(%exit_early, %lhs, %rhs) : (i1, i64, i64) -> (i64, i64, i64, i64)
  func.return %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum : i64, i64, i64, i64
}

