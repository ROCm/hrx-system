// RUN: emit amdgpu-native-words @else_mask

amdgpu.target<gfx942> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.cdna3.core>(@target) @else_mask(%saved: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.sgpr x2>) asm {
  %active = s_andn2_b64_exec %saved, %condition
  low.cond_br %active, ^selected, ^exit : reg<amdgpu.scc>
^selected:
  s_mov_b64_exec %saved
  low.br ^exit
^exit:
  return
}

// ----
0x89FE0002
0xBF840001
0xBEFE0102
0xBF810000

