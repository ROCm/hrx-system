// RUN: pass source-to-low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @i16_table_lookup_rejected(%codes: vector<4xi16>) -> (vector<4xf32>) {
  %grid = vector.constantf [-1.0, 0.0, 1.0, 2.0] : vector<4xf32>
  // ERROR@+1: AMDGPU/023 {constraint_key="table_lookup.shape"}
  %decoded = vector.table.lookup %grid[%codes] : vector<4xf32>, vector<4xi16> -> vector<4xf32>
  func.return %decoded : vector<4xf32>
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @i8_table_lookup_unknown_codes_rejected(%grid: vector<4xi8>, %codes: vector<4xi8>) -> (vector<4xi8>) {
  // ERROR@+1: AMDGPU/023 {constraint_key="table_lookup.shape"}
  %decoded = vector.table.lookup %grid[%codes] : vector<4xi8>, vector<4xi8> -> vector<4xi8>
  func.return %decoded : vector<4xi8>
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @f16_table_lookup_rejected(%grid: vector<4xf16>, %input: vector<4xi8>) -> (vector<4xf16>) {
  %mask = vector.splati 3 : vector<4xi8>
  %codes = vector.andi %input, %mask : vector<4xi8>
  // ERROR@+1: AMDGPU/023 {constraint_key="table_lookup.shape"}
  %decoded = vector.table.lookup %grid[%codes] : vector<4xf16>, vector<4xi8> -> vector<4xf16>
  func.return %decoded : vector<4xf16>
}

// ====
// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// Unsupported native element/shape pairs use the shared register lookup recipe.
func.def target(@target) @integer_table_reference(%table: vector<4xi32>, %indices: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.table.lookup %table[%indices] : vector<4xi32>, vector<2xi32> -> vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @integer_table_reference(%table: reg<amdgpu.vgpr x4>, %indices: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %14 = slice %indices[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = slice %table[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = v_mov_b32 1
  %17 = v_cmp_eq_i32 %14, %16
  %18 = slice %table[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %19 = v_cndmask_b32 %15, %18, %17
  %20 = v_mov_b32 2
  %21 = v_cmp_eq_i32 %14, %20
  %22 = slice %table[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %23 = v_cndmask_b32 %19, %22, %21
  %24 = v_mov_b32 3
  %25 = v_cmp_eq_i32 %14, %24
  %26 = slice %table[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %27 = v_cndmask_b32 %23, %26, %25
  %28 = slice %indices[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %31 = v_cmp_eq_i32 %28, %16
  %33 = v_cndmask_b32 %15, %18, %31
  %35 = v_cmp_eq_i32 %28, %20
  %37 = v_cndmask_b32 %33, %22, %35
  %39 = v_cmp_eq_i32 %28, %24
  %41 = v_cndmask_b32 %37, %26, %39
  %result = concat(%27, %41) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}
