low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) abi(hal_kernel) @vector_fptrunc_f16x5_to_bf8(%input: reg<amdgpu.vgpr x3>) -> (reg<amdgpu.vgpr x2>) asm {
  %5 = slice %input[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %6 = v_cvt_pk_bf8_f16_low %5
  %7 = slice %input[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %8 = v_cvt_pk_bf8_f16_high %6, %7
  %9 = slice %input[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %10 = v_and_b32_lit %9, 65535
  %11 = v_lshlrev_b32_src0_inline %10, 16
  %12 = v_or_b32 %10, %11
  %13 = v_cvt_pk_bf8_f16_low %12
  %14 = v_cvt_pk_bf8_f16_high %13, %12
  %converted = concat(%8, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %converted
}

