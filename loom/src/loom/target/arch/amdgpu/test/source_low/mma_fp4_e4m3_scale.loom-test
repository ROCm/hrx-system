  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] using {scale = %rhs_block_scale : vector<2xi32>, schema = %schema : encoding<schema>} : vector<8xi32>
  %zero_acc = vector.splatf 0.0 : vector<8xf32>
