low.kernel.def target<amdgpu.gfx9_4.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(4, 1, 1) @address_guarded_rows(%row_limit: reg<amdgpu.sgpr x2>) asm {
  %group = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %row_in_group = v_lshrrev_b32_lit %lane, 5
  %31 = s_mov_b32 31
  %column = v_and_b32 %31, %lane
  %row = v_lshl_add_u32_shift_imm %group, %row_in_group, 1
  %34 = v_mov_b32 0
  %35 = slice %row_limit[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = v_mov_b32_copy %35
  %37 = slice %row_limit[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = v_mov_b32_copy %37
  %39 = v_cmp_lt_u32 %34, %38
  %40 = v_cmp_lt_u32 %row, %36
  %41 = v_cmp_eq_i32 %34, %38
  %42 = s_and_b64 %41, %40
  %inside = s_or_b64 %39, %42
  %44, %45 = s_and_saveexec_b64 %inside
  low.cond_br %45, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %46 = v_lshl_add_u32_shift_imm %row, %column, 6
  %47 = v_lshlrev_b32_src0_inline %46, 2
  %48 = s_mov_b32_m0_imm 0
  %first = global_load_dword_saddr %47, %input_view, %48
  %52 = s_mov_b32_m0_imm 0
  %second = global_load_dword_saddr %47, %input_view, %52 {offset = 128}
  %56 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %47, %first, %output_view, %56
  %59 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %47, %second, %output_view, %59 {offset = 128}
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %44
  return
}

