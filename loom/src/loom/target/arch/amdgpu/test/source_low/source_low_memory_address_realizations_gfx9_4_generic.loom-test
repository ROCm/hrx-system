amdgpu.target<gfx9-4-generic> @target

kernel.def target(@target) @address_materialized_axes_distinct_roots() {
  %unit = index.constant 1 : index
  %groups = index.constant 4 : index
  %columns = index.constant 16 : index
  %rows = index.constant 2 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%columns, %rows, %unit) : index
} launch(%input: buffer, %other_input: buffer, %output: buffer, %row_limit: index, %column_limit: index) {
  %x = kernel.workitem.id<x> : index
  %y = kernel.workitem.id<y> : index
  %group = kernel.workgroup.id<x> : index
  %row_step = index.constant 2 : index
  %column_step = index.constant 16 : index
  %row = index.madd %group, %row_step, %y : index
  %column = index.madd %group, %column_step, %x : index
  %other_column = index.add %column, %column_step : index
  %c0_offset = index.constant 0 : offset
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<[%row_limit]x80xi32>
  %other_view = buffer.view %other_input[%c0_offset] : buffer -> view<[%row_limit]x80xi32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%row_limit]x80xi32>
  %row_inside = index.cmp ult, %row, %row_limit : index
  scf.if %row_inside {
    %column_inside = index.cmp ult, %column, %column_limit : index
    scf.if %column_inside {
      %first = view.load %input_view[%row, %column] : view<[%row_limit]x80xi32> -> i32
      %second = view.load %other_view[%row, %other_column] : view<[%row_limit]x80xi32> -> i32
      %sum = scalar.addi %first, %second : i32
      view.store %sum, %output_view[%row, %column] : i32, view<[%row_limit]x80xi32>
    }
  }
  kernel.return
}

