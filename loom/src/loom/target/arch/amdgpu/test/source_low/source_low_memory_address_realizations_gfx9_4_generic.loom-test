// RUN: emit source-low output=low

amdgpu.target<gfx9-4-generic> @target

kernel.def target(@target) @address_guarded_rows() {
  %unit = index.constant 1 : index
  %groups = index.constant 4 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %row_limit: index) {
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %rows_per_group = index.constant 2 : index
  %half_wave = index.constant 32 : index
  %row_in_group = index.div %lane, %half_wave : index
  %column = index.rem %lane, %half_wave : index
  %row = index.madd %group, %rows_per_group, %row_in_group : index
  %next_column = index.add %column, %half_wave : index
  %c0_offset = index.constant 0 : offset
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<[%row_limit]x64xi32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%row_limit]x64xi32>
  %inside = index.cmp ult, %row, %row_limit : index
  scf.if %inside {
    %first = view.load %input_view[%row, %column] : view<[%row_limit]x64xi32> -> i32
    %second = view.load %input_view[%row, %next_column] : view<[%row_limit]x64xi32> -> i32
    view.store %first, %output_view[%row, %column] : i32, view<[%row_limit]x64xi32>
    view.store %second, %output_view[%row, %next_column] : i32, view<[%row_limit]x64xi32>
  }
  kernel.return
}

