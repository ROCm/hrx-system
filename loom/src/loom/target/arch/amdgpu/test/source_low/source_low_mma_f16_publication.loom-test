  %init = buffer.view %init_global[%base] : buffer -> view<16x16xf32>
  %output = buffer.view %output_global[%base] : buffer -> view<16x16xf16, %output_layout>
  %lhs_values_scalar = scalar.constant 1.0 : f16
  %lhs_values = vector.splat %lhs_values_scalar : vector<16xf16>
  %rhs_values_scalar = scalar.constant 2.0 : f16
  %rhs_values = vector.splat %rhs_values_scalar : vector<16xf16>
  %lhs = vector.fragment<lhs> %lhs_values shape [%m, %k] : vector<16xf16>
  %rhs = vector.fragment<rhs> %rhs_values shape [%k, %n] : vector<16xf16>
  %initial = vector.fragment.load<init> %init[%c0, %c0] shape [%m, %n] : view<16x16xf32> -> vector<8xf32>
  %result = vector.mma %lhs, %rhs, %initial : vector<16xf16>, vector<16xf16>, vector<8xf32>
  vector.fragment.store<result> %result, %output[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf16, %output_layout>
  kernel.return
}

