// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @raw_byte_roundtrip(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset) -> (i32) {
  %byte = buffer.load.i8.u %source[%source_offset]
  buffer.store.i8 %byte, %target[%target_offset]
  func.return %byte : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @raw_byte_roundtrip(%source_offset: reg<amdgpu.vgpr x2>, %target_offset: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = slice %source_offset[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %12 = slice %source_offset[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %13 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15, %16 = v_add_co_u32 %13, %11
  %17 = v_mov_b32_copy %14
  %18, %19 = v_add_co_ci_u32 %17, %12, %16
  %20 = concat(%15, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %byte = global_load_u8_vaddr %20
  %22 = slice %target_offset[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %23 = slice %target_offset[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %24 = slice %target[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = slice %target[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26, %27 = v_add_co_u32 %24, %22
  %28 = v_mov_b32_copy %25
  %29, %30 = v_add_co_ci_u32 %28, %23, %27
  %31 = concat(%26, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b8_vaddr %31, %byte
  return %byte
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @raw_byte_workgroup(%value: i32) -> (i32) {
  %byte_length = index.constant 4 : offset
  %byte_offset = index.constant 1 : offset
  %scratch = buffer.alloca<workgroup> align(1) %byte_length : buffer
  buffer.store.i8 %value, %scratch[%byte_offset]
  %byte = buffer.load.i8.u %scratch[%byte_offset]
  func.return %byte : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @raw_byte_workgroup(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %8 = storage {byte_alignment = 1, byte_length = 4} : low.storage<workgroup>
  %10 = v_mov_b32 0
  ds_write_b8 %10, %value {offset = 1}
  %byte = ds_read_u8 %10 {offset = 1}
  return %byte
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @raw_byte_private(%value: i32) -> (i32) {
  %byte_length = index.constant 4 : offset
  %byte_offset = index.constant 1 : offset
  %scratch = buffer.alloca<private> align(1) %byte_length : buffer
  buffer.store.i8 %value, %scratch[%byte_offset]
  %byte = buffer.load.i8.u %scratch[%byte_offset]
  func.return %byte : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @raw_byte_private(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %8 = storage {byte_alignment = 1, byte_length = 4} : low.storage<private>
  %10 = v_mov_b32 0
  scratch_store_b8_vaddr %10, %value {offset = 1}
  %byte = scratch_load_u8_vaddr %10 {offset = 1}
  return %byte
}
