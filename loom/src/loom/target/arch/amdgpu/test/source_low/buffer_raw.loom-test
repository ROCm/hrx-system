// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @raw_byte_roundtrip(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset) -> (i32) {
  %byte = buffer.load.i8.u %source[%source_offset]
  buffer.store.i8 %byte, %target[%target_offset]
  func.return %byte : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @raw_byte_roundtrip(%source_offset: reg<amdgpu.sgpr x2>, %target_offset: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 0
  %12 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = slice %source_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = slice %source_offset[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = s_add_u32 %12, %14
  %17 = s_addc_u32 %13, %15
  %18 = concat(%16, %17) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %byte = global_load_u8_saddr %11, %18
  %21 = slice %target[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = slice %target[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = slice %target_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %target_offset[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = s_add_u32 %21, %23
  %26 = s_addc_u32 %22, %24
  %27 = concat(%25, %26) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b8_saddr %11, %byte, %27
  return %byte
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @raw_byte_workgroup(%value: i32) -> (i32) {
  %byte_length = index.constant 4 : offset
  %byte_offset = index.constant 1 : offset
  %scratch = buffer.alloca<workgroup> align(1) %byte_length : buffer
  buffer.store.i8 %value, %scratch[%byte_offset]
  %byte = buffer.load.i8.u %scratch[%byte_offset]
  func.return %byte : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @raw_byte_workgroup(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %8 = storage {byte_alignment = 1, byte_length = 4} : low.storage<workgroup>
  %10 = v_mov_b32_copy %value
  %11 = v_mov_b32 0
  low.op<amdgpu.ds_write_b8>(%11, %10) {offset = 1} memory_access([0, 3, 4, -1, 11, 0, 0, 0, 3, 1, 1, 2, 2]) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>)
  %byte = low.op<amdgpu.ds_read_u8>(%11) {offset = 1} memory_access([0, 3, 4, -1, 11, 0, 0, 0, 3, 1, 1, 2, 2]) : (reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr>
  return %byte
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @raw_byte_private(%value: i32) -> (i32) {
  %byte_length = index.constant 4 : offset
  %byte_offset = index.constant 1 : offset
  %scratch = buffer.alloca<private> align(1) %byte_length : buffer
  buffer.store.i8 %value, %scratch[%byte_offset]
  %byte = buffer.load.i8.u %scratch[%byte_offset]
  func.return %byte : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @raw_byte_private(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %8 = storage {byte_alignment = 1, byte_length = 4} : low.storage<private>
  %10 = v_mov_b32_copy %value
  %11 = v_mov_b32 0
  scratch_store_b8_vaddr %11, %10 {offset = 1}
  %byte = scratch_load_u8_vaddr %11 {offset = 1}
  return %byte
}
