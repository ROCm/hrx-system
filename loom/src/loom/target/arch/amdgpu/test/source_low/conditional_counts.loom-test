// RUN: with-checks compile-report source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// Each arm is reachable, but only one store executes for a given dispatch.
kernel.def target(@target) @conditional_stores() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%enabled: i32, %output: buffer) {
  %disabled = scalar.constant 0 : i32
  %selected = scalar.constant 7 : i32
  %index = index.constant 0 : index
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %condition = scalar.cmpi ne, %enabled, %disabled : i32
  cfg.cond_br %condition, ^selected, ^disabled
^selected:
  view.store %selected, %output_view[%index] : i32, view<1xi32>
  cfg.br ^exit
^disabled:
  view.store %disabled, %output_view[%index] : i32, view<1xi32>
  cfg.br ^exit
^exit:
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: source_low[*] * source_op=view.store *
CHECK: COMPILE-REPORT: source_low_memory * exact_dynamic_packets=0 unknown_dynamic_packets=*
CHECK-NOT: COMPILE-REPORT: source_low_memory * unknown_dynamic_packets=0 *
CHECK: COMPILE-REPORT: source_low_memory_root[*] * source_root=output * exact_dynamic_packets=0 unknown_dynamic_packets=*
CHECK-NOT: COMPILE-REPORT: source_low_memory_root[*] * unknown_dynamic_packets=0 *
CHECK-NOT: COMPILE-REPORT: source_low_memory* dispatch_source_*
CHECK-NOT: COMPILE-REPORT: source_low[*] * source_op=view.store * execution_count=*

// ====

amdgpu.target<gfx11-generic> @target

// Four trips per loop entry do not prove that the loop is entered at all.
kernel.def target(@target) @conditional_counted_loop() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%enabled: i32, %output: buffer) {
  %disabled = scalar.constant 0 : i32
  %loop_begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %condition = scalar.cmpi ne, %enabled, %disabled : i32
  cfg.cond_br %condition, ^preheader, ^exit
^preheader:
  cfg.br ^header(%loop_begin: index)
^header(%position: index):
  %more = index.cmp slt, %position, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %value = index.cast %position : index to i32
  view.store %value, %output_view[%loop_begin] : i32, view<1xi32>
  %next = index.add %position, %step : index
  cfg.br ^header(%next: index)
^exit:
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: source_low[*] * source_op=view.store *
CHECK: COMPILE-REPORT: source_low_memory * exact_dynamic_packets=0 unknown_dynamic_packets=*
CHECK-NOT: COMPILE-REPORT: source_low_memory * unknown_dynamic_packets=0 *
CHECK: COMPILE-REPORT: source_low_memory_root[*] * source_root=output * exact_dynamic_packets=0 unknown_dynamic_packets=*
CHECK-NOT: COMPILE-REPORT: source_low_memory_root[*] * unknown_dynamic_packets=0 *
CHECK-NOT: COMPILE-REPORT: source_low_memory* dispatch_source_*
CHECK-NOT: COMPILE-REPORT: source_low[*] * source_op=view.store * execution_count=*
