// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @f32x4_concat_pair(%lhs: vector<4xf32>, %rhs: vector<4xf32>) -> (vector<8xf32>) {
  %wide = vector.concat<0> %lhs, %rhs : vector<4xf32>, vector<4xf32> -> vector<8xf32>
  func.return %wide : vector<8xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @f32x4_concat_pair(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x8>) asm {
  %wide = concat(%lhs, %rhs) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  return %wide
}

