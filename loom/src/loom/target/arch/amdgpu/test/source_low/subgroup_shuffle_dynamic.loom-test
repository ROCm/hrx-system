// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

kernel.def target(@target) @subgroup_shuffle_dynamic_index_i32() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %lane0 = kernel.subgroup.lane.id : index
  %c3 = index.constant 3 : index
  %c16 = index.constant 16 : index
  %c0 = index.constant 0 : offset
  %lane = index.assume %lane0 [range(%lane0, 0, 63)] : index
  %biased_lane = index.add %lane, %c3 : index
  %source_lane0 = index.rem %biased_lane, %c16 : index
  %source_lane = index.assume %source_lane0 [range(%source_lane0, 0, 15)] : index
  %source_lane_i32 = index.cast %source_lane : index to i32
  %width = scalar.constant 16 : i32
  %input_view = buffer.view %input[%c0] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%c0] : buffer -> view<64xi32>
  %value = view.load %input_view[%lane] : view<64xi32> -> i32
  %shuffled, %valid = kernel.subgroup.shuffle<index> %value, %source_lane_i32, %width : i32, i32, i32
  view.store %shuffled, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_shuffle_dynamic_index_i32() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c3 = s_mov_b32 3
  %biased_lane = v_add_u32 %c3, %lane
  %26 = s_mov_b32 15
  %source_lane_i32 = v_and_b32 %26, %biased_lane
  %28 = v_lshlrev_b32_src0_inline %lane, 2
  %value = global_load_b32_saddr %28, %input_view
  %30 = v_and_b32_lit %lane, 4294967280
  %31 = v_or_b32 %30, %source_lane_i32
  %32 = v_lshlrev_b32_src0_inline %31, 2
  %shuffled = ds_bpermute_b32 %32, %value
  %34 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %34, %shuffled, %output_view
  return
}

