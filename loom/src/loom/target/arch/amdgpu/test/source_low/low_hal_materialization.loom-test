  %value = v_mov_b32 42
  %6 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %7 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %8 = s_mov_b32 65535
  %9 = s_and_b32 %7, %8
  %10 = concat(%6, %9) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %11 = s_mov_b32 16
  %12 = s_mov_b32 822173696
  %descriptor = concat(%10, %11, %12) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  global_store_b32_saddr %offset, %value, %view
  return
}

