// RUN: pass amdgpu-materialize-hal-kernel-abi

amdgpu.target<gfx1100> @target

low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "unused_scalar"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) @all_parameters_unused(%unused_scalar: reg<amdgpu.sgpr>) {
  low.return
}

