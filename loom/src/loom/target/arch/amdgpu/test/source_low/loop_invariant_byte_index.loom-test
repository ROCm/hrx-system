// RUN: emit source-low target=amdgpu:gfx1151 output=low

// The reverse lane is used only as a word index. The rotated lane is used
// as both a word and a byte index, so its original units stay live.
kernel.def @scaled_loop_indices() {
  %unit = index.constant 1 : index
  %lanes = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%storage: buffer, %end: index) {
  %base = index.constant 0 : offset
  %words = buffer.view %storage[%base] : buffer -> view<32xi32>
  %bytes = buffer.view %storage[%base] : buffer -> view<128xi8>
  %lane = kernel.workitem.id<x> : index
  %last = index.constant 31 : index
  %reverse = index.sub %last, %lane : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rotated = index.xori %lane, %step : index
  scf.for %i = [%begin to %end step %step] {
    %word = view.load<volatile> %words[%reverse] : view<32xi32> -> i32
    view.store<volatile> %word, %words[%rotated] : i32, view<32xi32>
    %byte = view.load<volatile> %bytes[%rotated] : view<128xi8> -> i8
  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "end"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @scaled_loop_indices(%end: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %bytes = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %last = s_mov_b32 31
  %reverse = v_sub_nc_u32 %last, %lane
  %26 = v_lshlrev_b32_src0_inline %reverse, 2
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %rotated = v_xor_b32 %step, %lane
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>)
^_bb1(%i: reg<amdgpu.sgpr>):
  %30 = s_cmp_lt_i32 %i, %end
  low.cond_br %30, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %word = global_load_b32_saddr<volatile> %26, %bytes
  %32 = v_lshlrev_b32_src0_inline %rotated, 2
  global_store_b32_saddr<volatile> %32, %word, %bytes
  %byte = global_load_u8_saddr<volatile> %rotated, %bytes
  %34 = s_add_u32 %i, %step
  low.br ^_bb1(%34: reg<amdgpu.sgpr>)
^_bb3:
  return
}
