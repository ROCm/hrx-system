// RUN: pass amdgpu-materialize-hal-kernel-abi,low-select-operand-forms,cse,low-dce

amdgpu.target<gfx1100> @target

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(64, 1, 1) @predicate_operand_form(%position: reg<amdgpu.sgpr>, %step: reg<amdgpu.sgpr>) where [eq(%step, 3)] asm {
  %output = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %offset = v_mov_b32 0
  %result = s_add_u32 %position, %step
  %stored = v_mov_b32_copy %result
  global_store_b32_saddr %offset, %stored, %output
  return
}

// ----
amdgpu.target<gfx1100> @target

low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "position", arg1 = "step"}, direct_arg_offsets = [8, 12], direct_arg_parameter_indices = [1, 2], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) @predicate_operand_form() asm {
  %kernarg = live_in<amdgpu.kernarg_segment_ptr> : reg<amdgpu.sgpr x2>
  %7 = s_load_dwordx2_offset_only %kernarg {offset = 8}
  %position = slice %7[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %output = s_load_dwordx2_offset_only %kernarg
  %offset = v_mov_b32 0
  %result = s_add_u32_rhs_inline %position, 3
  %stored = v_mov_b32_copy %result
  global_store_b32_saddr %offset, %stored, %output
  return
}
