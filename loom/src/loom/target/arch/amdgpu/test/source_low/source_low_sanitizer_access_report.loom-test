// RUN: with-checks emit source-low output=low sanitizer=access

amdgpu.target<gfx11-generic> @target

func.def target(@target) @sanitizer_access_report_default(%input: buffer) {
  %base = index.constant 0 : offset
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<1xi32>
  sanitizer.assert.access<read> %input_view[0] : view<1xi32>
  func.return
}

// ----
// Default access reporting checks shadow memory, reserves a feedback packet,
// publishes its payload before the ready flag, and notifies the host. The
// feedback API tests own exact CFG edges and packet field values.
CHECK: low.func.def *@sanitizer_access_report_default() asm {
CHECK: *{symbol = @iree_asan_config}
CHECK: * = flat_load_u8 *
CHECK: * = flat_load_u8 *
CHECK: low.cond_br *
CHECK: *{symbol = @iree_feedback_config}
CHECK: * = global_atomic_cmpswap_b64_rtn_saddr *
CHECK: low.cond_br *
CHECK: global_store_b32_saddr *{offset = 64}
CHECK: global_store_b64_saddr *{offset = 80}
CHECK: global_store_b64_saddr *{offset = 112}
CHECK: s_waitcnt_vscnt {vscnt = 0}
CHECK: global_store_b32_saddr *{offset = 12}
CHECK: global_atomic_add_u64_saddr *
CHECK: s_sendmsg *{message = 1}
CHECK: s_mov_b64_exec *
CHECK-NOT: *sanitizer.assert.access*
CHECK-NOT: *s_trap*
