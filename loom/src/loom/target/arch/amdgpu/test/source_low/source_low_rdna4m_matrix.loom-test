low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @f16_swmmac(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x8>, %init: reg<amdgpu.vgpr x8>, %sparsity: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x8>) asm {
  %19 = copy %init : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %result = v_swmmac_f32_16x16x32_f16 %19, %lhs, %rhs, %sparsity
  return %result
}

