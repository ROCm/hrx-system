// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_vector_bitwise.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @numeric_vector_bitwise_i32(%lhs: vector<4xi32>, %rhs: vector<4xi32>) -> (vector<4xi32>, vector<4xi32>, vector<4xi32>) {
  %and_result = vector.andi %lhs, %rhs : vector<4xi32>
  %or_result = vector.ori %lhs, %rhs : vector<4xi32>
  %xor_result = vector.xori %lhs, %rhs : vector<4xi32>
  func.return %and_result, %or_result, %xor_result : vector<4xi32>, vector<4xi32>, vector<4xi32>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @numeric_vector_bitwise_i32(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %13 = slice %lhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %14 = slice %rhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = v_and_b32 %13, %14
  %16 = slice %lhs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = slice %rhs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = v_and_b32 %16, %17
  %19 = slice %lhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %20 = slice %rhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = v_and_b32 %19, %20
  %22 = slice %lhs[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %23 = slice %rhs[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %24 = v_and_b32 %22, %23
  %and_result = concat(%15, %18, %21, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %28 = v_or_b32 %13, %14
  %31 = v_or_b32 %16, %17
  %34 = v_or_b32 %19, %20
  %37 = v_or_b32 %22, %23
  %or_result = concat(%28, %31, %34, %37) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %41 = v_xor_b32 %13, %14
  %44 = v_xor_b32 %16, %17
  %47 = v_xor_b32 %19, %20
  %50 = v_xor_b32 %22, %23
  %xor_result = concat(%41, %44, %47, %50) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %and_result, %or_result, %xor_result
}

