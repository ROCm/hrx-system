func.def @numeric_vector_bitwise_i64(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>, vector<2xi64>, vector<2xi64>) {
  %and_result = vector.andi %lhs, %rhs : vector<2xi64>
  %or_result = vector.ori %lhs, %rhs : vector<2xi64>
  %xor_result = vector.xori %lhs, %rhs : vector<2xi64>
  func.return %and_result, %or_result, %xor_result : vector<2xi64>, vector<2xi64>, vector<2xi64>
}

