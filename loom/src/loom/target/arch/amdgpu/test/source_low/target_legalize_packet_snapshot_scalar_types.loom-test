// RUN: with-checks pass target-legalize{mode=final,policy=require-native}

// Every byte-addressable vector payload scalar type uses the same snapshot
// staging representation. Predicates and address scalars have distinct target
// carrier contracts and do not enter this storage path.

amdgpu.target<gfx11-generic> @target

func.def target(@target) @snapshot_fanout_i8(%source: buffer, %destination0: buffer, %destination1: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<512xi8>
  %destination0_view = buffer.view %destination0[%base] : buffer -> view<512xi8>
  %destination1_view = buffer.view %destination1[%base] : buffer -> view<512xi8>
  %snapshot = vector.load %source_view[0] : view<512xi8> -> vector<512xi8>
  vector.store %snapshot, %destination0_view[0] : vector<512xi8>, view<512xi8>
  vector.store %snapshot, %destination1_view[0] : vector<512xi8>, view<512xi8>
  func.return
}

// ----
CHECK: * = buffer.alloca<private> align(16) * : buffer
CHECK-NOT: * = vector.concat * : * -> vector<512xi8>

// ====

