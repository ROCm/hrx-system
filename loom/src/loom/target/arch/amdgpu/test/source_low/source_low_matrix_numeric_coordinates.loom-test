// ====

// The same shape of splat is not invariant when the scalar depends on the
// physical lane. Its bias convention requires canonical result coordinates.
amdgpu.target<gfx1151> @target {subgroup_size = 32}

kernel.def target(@target) @varying_bias_mma_coordinates() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %bias_buffer: buffer, %output: buffer) {
  %buffer_origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %layout = encoding.layout.strided [1, 16] : encoding<layout>
  %lhs_view = buffer.view %lhs_buffer[%buffer_origin] : buffer -> view<16x16xbf16>
  %rhs_view = buffer.view %rhs_buffer[%buffer_origin] : buffer -> view<16x16xbf16, %layout>
  %bias_view = buffer.view %bias_buffer[%buffer_origin] : buffer -> view<16xf32>
  %output_view = buffer.view %output[%buffer_origin] : buffer -> view<16x16xbf16, %layout>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%tile, %tile] : view<16x16xbf16> -> vector<16xbf16>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%tile, %tile] : view<16x16xbf16, %layout> -> vector<16xbf16>
  %initial_values = vector.constant 0.0 : vector<8xf32>
  %initial = vector.fragment<init> %initial_values shape [%tile, %tile] : vector<8xf32>
  %product = vector.mma %lhs, %rhs, %initial : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %lane = kernel.workitem.id<x> : index
  %column = index.rem %lane, %tile : index
  %bias = view.load %bias_view[%column] : view<16xf32> -> f32
  %biases = vector.splat %bias : vector<8xf32>
  %biased = vector.addf %product, %biases : vector<8xf32>
  %rounded = vector.fptrunc %biased : vector<8xf32> to vector<8xbf16>
  vector.fragment.store<result> %rounded, %output_view[0, 0] shape [%tile, %tile] : vector<8xbf16>, view<16x16xbf16, %layout>
  kernel.return
}

