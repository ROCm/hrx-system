// ====

// Wave64 has four packed source elements, distinct from eight-element native
// half accumulation with active-element stride two.
amdgpu.target<gfx1100> @target {subgroup_size = 64}

kernel.def target(@target) @f16_loop_coordinates() {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %count: index) {
  %buffer_origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %tile = index.constant 16 : index
  %layout = encoding.layout.strided [1, 16] : encoding<layout>
  %input_view = buffer.view %input[%buffer_origin] : buffer -> view<16x16xf16, %layout>
  %output_view = buffer.view %output[%buffer_origin] : buffer -> view<16x16xf16, %layout>
  %packed = vector.fragment.load<result> %input_view[0, 0] shape [%tile, %tile] : view<16x16xf16, %layout> -> vector<4xf16>
  %wide = vector.extf %packed : vector<4xf16> to vector<4xf32>
  %result = scf.for %i = [%begin to %count step %unit](%value = %wide : vector<4xf32>) -> (vector<4xf32>) {
    %twice = vector.addf %value, %value : vector<4xf32>
    %rounded = vector.fptrunc %twice : vector<4xf32> to vector<4xf16>
    %extended = vector.extf %rounded : vector<4xf16> to vector<4xf32>
    scf.yield %extended : vector<4xf32>
  }
  vector.fragment.store<result> %result, %output_view[0, 0] shape [%tile, %tile] : vector<4xf32>, view<16x16xf16, %layout>
  kernel.return
}

