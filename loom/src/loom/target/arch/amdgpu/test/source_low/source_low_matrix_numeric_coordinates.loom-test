// ====

// The base load fixes actual source-element coordinates through both SCF arms,
// even when the final BF16 store would independently prefer operand exchange.
amdgpu.target<gfx1151> @target {subgroup_size = 32}

kernel.def target(@target) @bf16_adapter_coordinates() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%base: buffer, %strength: buffer, %output: buffer) {
  %buffer_origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %layout = encoding.layout.strided [1, 16] : encoding<layout>
  %base_view = buffer.view %base[%buffer_origin] : buffer -> view<16x16xbf16, %layout>
  %output_view = buffer.view %output[%buffer_origin] : buffer -> view<16x16xbf16, %layout>
  %strength_view = buffer.view %strength[%buffer_origin] : buffer -> view<1xf32>
  %packed = vector.fragment.load<result> %base_view[0, 0] shape [%tile, %tile] : view<16x16xbf16, %layout> -> vector<8xbf16>
  %wide = vector.extf %packed : vector<8xbf16> to vector<8xf32>
  %scale = view.load %strength_view[0] : view<1xf32> -> f32
  %disabled_scale = scalar.constant 0.0 : f32
  %disabled = scalar.cmpf oeq, %scale, %disabled_scale : f32
  %combined = scf.if %disabled -> (vector<8xf32>) {
    scf.yield %wide : vector<8xf32>
  } else {
    %scales = vector.splat %scale : vector<8xf32>
    %scaled = vector.mulf %wide, %scales : vector<8xf32>
    scf.yield %scaled : vector<8xf32>
  }
  %rounded = vector.fptrunc %combined : vector<8xf32> to vector<8xbf16>
  vector.fragment.store<result> %rounded, %output_view[0, 0] shape [%tile, %tile] : vector<8xbf16>, view<16x16xbf16, %layout>
  kernel.return
}

