// RUN: emit source-low target=amdgpu:gfx1151 output=none

// The ordinary compilation pipeline must check the original row bound even
// after source normalization. g=2336 reaches row 73, beyond the input view.
kernel.def @reject_nonstrict_row_guard() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %raw: i32) {
  %base = index.constant 0 : offset
  %linear = scalar.assume %raw [range(%raw, 0, 2367)] : i32
  %width = index.constant 16 : index
  %scale = scalar.constant 32 : i32
  %capacity = scalar.constant 73 : i32
  %quotient = scalar.divui %linear, %scale : i32
  %remainder = scalar.remui %linear, %scale : i32
  %row = index.cast %quotient : i32 to index
  %group = index.cast %remainder : i32 to index
  %column = index.mul %group, %width : index
  %inputs = buffer.view %input[%base] : buffer -> view<73x512xbf16>
  %outputs = buffer.view %output[%base] : buffer -> view<73x512xbf16>
  %condition = scalar.cmpi ule, %quotient, %capacity : i32
  scf.if %condition {
    // ERROR@+1: SUBRANGE/011 {op_name="vector.load", view_axis="0"}
    %value = vector.load %inputs[%row, %column] : view<73x512xbf16> -> vector<16xbf16>
    // ERROR@+1: SUBRANGE/011 {op_name="vector.store", view_axis="0"}
    vector.store %value, %outputs[%row, %column] : vector<16xbf16>, view<73x512xbf16>
  }
  kernel.return
}

// ====

// An unrelated condition cannot establish the missing scalar-axis bound.
kernel.def @reject_unproved_scalar_row() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %row0: index, %external: i1) {
  %base = index.constant 0 : offset
  %row = index.assume %row0 [range(%row0, 0, 8)] : index
  %inputs = buffer.view %input[%base] : buffer -> view<8x16xf32>
  %outputs = buffer.view %output[%base] : buffer -> view<8x16xf32>
  scf.if %external {
    // ERROR@+1: SUBRANGE/024 {op_name="view.load", view_axis="0"}
    %value = view.load %inputs[%row, 0] : view<8x16xf32> -> f32
    // ERROR@+1: SUBRANGE/024 {op_name="view.store", view_axis="0"}
    view.store %value, %outputs[%row, 0] : f32, view<8x16xf32>
  }
  kernel.return
}

// ====

// RUN: emit source-low target=amdgpu:gfx1151 output=low

// The strict bound still permits the optimized vector transfer.
kernel.def @guarded_row_transfer() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %raw: i32) {
  %base = index.constant 0 : offset
  %linear = scalar.assume %raw [range(%raw, 0, 2367)] : i32
  %width = index.constant 16 : index
  %scale = scalar.constant 32 : i32
  %capacity = scalar.constant 73 : i32
  %quotient = scalar.divui %linear, %scale : i32
  %remainder = scalar.remui %linear, %scale : i32
  %row = index.cast %quotient : i32 to index
  %group = index.cast %remainder : i32 to index
  %column = index.mul %group, %width : index
  %inputs = buffer.view %input[%base] : buffer -> view<73x512xbf16>
  %outputs = buffer.view %output[%base] : buffer -> view<73x512xbf16>
  %condition = scalar.cmpi ult, %quotient, %capacity : i32
  scf.if %condition {
    %value = vector.load %inputs[%row, %column] : view<73x512xbf16> -> vector<16xbf16>
    vector.store %value, %outputs[%row, %column] : vector<16xbf16>, view<73x512xbf16>
  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "raw"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @guarded_row_transfer(%linear: reg<amdgpu.sgpr>) asm {
  %inputs = resource<hal_binding> {extent = 74752, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %outputs = resource<hal_binding> {extent = 74752, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %capacity = s_mov_b32 73
  %34 = s_mov_b32 5
  %row = s_lshr_b32 %linear, %34
  %group = s_and_b32_rhs_inline %linear, 31
  %37 = s_mov_b32 4
  %column = s_lshl_b32 %group, %37
  %condition = s_cmp_lt_u32 %row, %capacity
  low.cond_br %condition, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %40 = s_mov_b32 512
  %41 = s_mul_i32 %row, %40
  %42 = s_add_u32 %41, %column
  %43 = s_lshl_b32_rhs_inline %42, 1
  %44 = slice %inputs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = slice %inputs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46 = s_mov_b32 0
  %47, %48 = s_add_co_u32 %44, %43
  %49, %50 = s_addc_u32 %45, %46, %48
  %51 = concat(%47, %49) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %52 = v_mov_b32 0
  %53 = global_load_b128_saddr %52, %51
  %54 = global_load_b128_saddr %52, %51 {offset = 16}
  %58 = slice %outputs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %59 = slice %outputs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %61, %62 = s_add_co_u32 %58, %43
  %63, %64 = s_addc_u32 %59, %46, %62
  %65 = concat(%61, %63) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %52, %53, %65
  global_store_b128_saddr %52, %54, %65 {offset = 16}
  low.br ^_bb2
^_bb2:
  return
}

// ====

// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A partial final workgroup uses a row guard. Address reconstruction retains
// the refined row so its bound remains available after source cleanup.
kernel.def @row_guarded_vector_groups() {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  %blocks = index.constant 37 : index
  kernel.launch.config workgroups(%blocks, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %threads = index.constant 64 : index
  %capacity = index.constant 73 : index
  %groups = index.constant 32 : index
  %width = index.constant 16 : index
  %block = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %linear = index.madd %block, %threads, %lane : index
  %row = index.div %linear, %groups : index
  %group = index.rem %linear, %groups : index
  %column = index.mul %group, %width : index
  %inside = index.cmp ult, %row, %capacity : index
  %inputs = buffer.view %input[%base] : buffer -> view<73x512xbf16>
  %outputs = buffer.view %output[%base] : buffer -> view<73x512xbf16>
  scf.if %inside {
    %value = vector.load %inputs[%row, %column] : view<73x512xbf16> -> vector<16xbf16>
    vector.store %value, %outputs[%row, %column] : vector<16xbf16>, view<73x512xbf16>
  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(37, 1, 1) @row_guarded_vector_groups() asm {
  %block = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %inputs = resource<hal_binding> {extent = 74752, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %outputs = resource<hal_binding> {extent = 74752, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %capacity = s_mov_b32 73
  %linear = v_lshl_add_u32_shift_imm %block, %lane, 6
  %row = v_lshrrev_b32_src0_inline %linear, 5
  %39 = s_mov_b32 31
  %group = v_and_b32 %39, %linear
  %column = v_lshlrev_b32_src0_inline %group, 4
  %inside = v_cmp_lt_u32 %row, %capacity
  %43, %44 = s_and_saveexec_b64 %inside
  low.cond_br %44, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %45 = v_lshl_add_u32_shift_imm %row, %column, 9
  %46 = v_lshlrev_b32_src0_inline %45, 1
  %47 = global_load_b128_saddr %46, %inputs
  %48 = global_load_b128_saddr %46, %inputs {offset = 16}
  global_store_b128_saddr %46, %47, %outputs
  global_store_b128_saddr %46, %48, %outputs {offset = 16}
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %43
  return
}
