// RUN: emit source-low output=low

amdgpu.target<gfx1251> @target
func.def target(@target) @vector_fptrunc_f32x4_to_fp8(%input: vector<4xf32>) -> (vector<4xf8E4M3>) {
  %converted = vector.fptrunc %input : vector<4xf32> to vector<4xf8E4M3>
  func.return %converted : vector<4xf8E4M3>
}

// ----
low.func.def target<amdgpu.rdna4.gfx1251.core>(@target) abi(hal_kernel) @vector_fptrunc_f32x4_to_fp8(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr>) asm {
  %5 = v_mov_b32 1138753536
  %6 = v_mov_b32 3286237184
  %7 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = v_med3_num_f32 %7, %5, %6
  %12 = v_cmp_u_f32 %7, %7
  %13 = v_cndmask_b32 %11, %7, %12
  %14 = v_med3_num_f32 %8, %5, %6
  %15 = v_cmp_u_f32 %8, %8
  %16 = v_cndmask_b32 %14, %8, %15
  %17 = v_cvt_pk_fp8_f32_low %13, %16
  %18 = v_med3_num_f32 %9, %5, %6
  %19 = v_cmp_u_f32 %9, %9
  %20 = v_cndmask_b32 %18, %9, %19
  %21 = v_med3_num_f32 %10, %5, %6
  %22 = v_cmp_u_f32 %10, %10
  %23 = v_cndmask_b32 %21, %10, %22
  %converted = v_cvt_pk_fp8_f32_high %17, %20, %23
  return %converted
}

// ====

amdgpu.target<gfx1251> @target
func.def target(@target) @vector_fptrunc_f16x5_to_bf8(%input: vector<5xf16>) -> (vector<5xf8E5M2>) {
  %converted = vector.fptrunc %input : vector<5xf16> to vector<5xf8E5M2>
  func.return %converted : vector<5xf8E5M2>
}

// ----
low.func.def target<amdgpu.rdna4.gfx1251.core>(@target) abi(hal_kernel) @vector_fptrunc_f16x5_to_bf8(%input: reg<amdgpu.vgpr x3>) -> (reg<amdgpu.vgpr x2>) asm {
  %5 = slice %input[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %6 = v_cvt_pk_bf8_f16_low %5
  %7 = slice %input[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %8 = v_cvt_pk_bf8_f16_high %6, %7
  %9 = slice %input[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %10 = v_and_b32_lit %9, 65535
  %11 = v_lshlrev_b32_src0_inline %10, 16
  %12 = v_or_b32 %10, %11
  %13 = v_cvt_pk_bf8_f16_low %12
  %14 = v_cvt_pk_bf8_f16_high %13, %12
  %converted = concat(%8, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %converted
}

