// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A uniform row origin is shared by two lane-varying coordinates. Retaining
// that authored origin must not rebuild a full-width scalar address for each
// access when the complete vector offsets are proven to fit u32.
kernel.def @shared_scalar_row_component() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 7)] : index
  %lane = kernel.workitem.id<x> : index
  %bounded_lane = index.assume %lane [range(%lane, 0, 63)] : index
  %row_stride = index.constant 128 : index
  %row_origin = index.mul %bounded_row, %row_stride : index
  %first_index = index.add %row_origin, %bounded_lane : index
  %distance = index.constant 64 : index
  %later_lane = index.add %bounded_lane, %distance : index
  %second_index = index.add %row_origin, %later_lane : index
  %base = index.constant 0 : offset
  %data = buffer.view %input[%base] : buffer -> view<1024xi32>
  %first = view.load<volatile> %data[%first_index] : view<1024xi32> -> i32
  %second = view.load<volatile> %data[%second_index] : view<1024xi32> -> i32
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "row"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @shared_scalar_row_component(%bounded_row: reg<amdgpu.sgpr>) asm {
  %bounded_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %data = resource<hal_binding> {extent = 4096, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %22 = s_mov_b32 7
  %row_origin = s_lshl_b32 %bounded_row, %22
  %24 = v_mov_b32_copy %row_origin
  %25 = v_add_u32 %24, %bounded_lane
  %26 = v_lshlrev_b32_src0_inline %25, 2
  %first = global_load_b32_saddr<volatile> %26, %data
  %second = global_load_b32_saddr<volatile> %26, %data {offset = 256}
  return
}

// ====

// A dynamic view base used by one memory operation stays in the direct
// address path. Merely constructing the view is not a second use that can
// justify retaining another physical address component.
kernel.def @single_dynamic_view_base() {
  %c1 = index.constant 1 : index
  %group_count = index.constant 4 : index
  %group_size = index.constant 256 : index
  kernel.launch.config workgroups(%group_count, %c1, %c1) workgroup_size(%group_size, %c1, %c1) : index
} launch(%output: buffer) {
  %tile_bytes = index.constant 32768 : offset
  %group = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %tile_offset = index.scale %group, %tile_bytes : index, offset -> offset
  %output_view = buffer.view %output[%tile_offset] : buffer -> view<3x256x2xi32>
  %value = vector.splati 1 : vector<2xi32>
  vector.store %value, %output_view[0, %thread, 0] : vector<2xi32>, view<3x256x2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(256, 1, 1) workgroup_count(4, 1, 1) @single_dynamic_view_base() asm {
  %group = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %thread = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = v_mov_b32 1
  %value = concat(%18, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %21 = v_lshlrev_b32_src0_inline %thread, 3
  %22 = s_lshl_b32_rhs_inline %group, 15
  %23 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = s_mov_b32 0
  %26, %27 = s_add_co_u32 %23, %22
  %28, %29 = s_addc_u32 %24, %25, %27
  %30 = concat(%26, %28) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b64_saddr %21, %value, %30
  return
}

// ====

// Two memory operations consume the same authored dynamic view base. The
// common component is retained once while each store preserves its distinct
// static displacement, including the one outside the packet immediate range.
kernel.def @shared_dynamic_view_base() {
  %c1 = index.constant 1 : index
  %group_count = index.constant 4 : index
  %group_size = index.constant 256 : index
  kernel.launch.config workgroups(%group_count, %c1, %c1) workgroup_size(%group_size, %c1, %c1) : index
} launch(%output: buffer) {
  %tile_bytes = index.constant 32768 : offset
  %group = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %tile_offset = index.scale %group, %tile_bytes : index, offset -> offset
  %output_view = buffer.view %output[%tile_offset] : buffer -> view<3x256x2xi32>
  %value = vector.splati 1 : vector<2xi32>
  vector.store %value, %output_view[0, %thread, 0] : vector<2xi32>, view<3x256x2xi32>
  vector.store %value, %output_view[2, %thread, 0] : vector<2xi32>, view<3x256x2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(256, 1, 1) workgroup_count(4, 1, 1) @shared_dynamic_view_base() asm {
  %group = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %thread = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = v_mov_b32 1
  %value = concat(%20, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %23 = v_mov_b32_copy %group
  %24 = v_lshl_add_u32_shift_imm %23, %thread, 12
  %25 = v_lshlrev_b32_src0_inline %24, 3
  global_store_b64_saddr %25, %value, %output_view
  %29 = s_mov_b32 1
  %30 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = s_mov_b32 0
  %33, %34 = s_add_co_u32 %30, %29
  %35, %36 = s_addc_u32 %31, %32, %34
  %37 = concat(%33, %35) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b64_saddr %25, %value, %37 {offset = 4095}
  return
}

// ====

// One wide source load becomes four physical packets. Its row-scaled scalar
// base is shared even though no second source operation can activate the
// cross-access retained-component path.
func.def @multipacket_dynamic_view_base_load(%input: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source = buffer.view %aligned[%row_offset] : buffer -> view<16xi32>
  %value = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @multipacket_dynamic_view_base_load(%bounded_row: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = s_lshl_b32_rhs_inline %bounded_row, 17
  %13 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = s_mov_b32 0
  %16, %17 = s_add_co_u32 %13, %12
  %18, %19 = s_addc_u32 %14, %15, %17
  %20 = concat(%16, %18) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %21 = v_mov_b32 0
  %22 = global_load_b128_saddr<volatile> %21, %20
  %23 = global_load_b128_saddr<volatile> %21, %20 {offset = 16}
  %24 = global_load_b128_saddr<volatile> %21, %20 {offset = 32}
  %25 = global_load_b128_saddr<volatile> %21, %20 {offset = 48}
  return
}

// ====

// Packet offsets straddling the native immediate ceiling use one common scalar
// base bias and distinct residual immediates instead of rebuilding the dynamic
// base for every packet.
func.def @multipacket_dynamic_view_base_large_static(%input: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source = buffer.view %aligned[%row_offset] : buffer -> view<2048xi32>
  %value = vector.load<volatile> %source[1020] : view<2048xi32> -> vector<16xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @multipacket_dynamic_view_base_large_static(%bounded_row: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = s_lshl_b32_rhs_inline %bounded_row, 17
  %13 = s_mov_b32 48
  %14 = s_add_u32 %12, %13
  %15 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = s_mov_b32 0
  %18, %19 = s_add_co_u32 %15, %14
  %20, %21 = s_addc_u32 %16, %17, %19
  %22 = concat(%18, %20) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %23 = v_mov_b32 0
  %24 = global_load_b128_saddr<volatile> %23, %22 {offset = 4032}
  %25 = global_load_b128_saddr<volatile> %23, %22 {offset = 4048}
  %26 = global_load_b128_saddr<volatile> %23, %22 {offset = 4064}
  %27 = global_load_b128_saddr<volatile> %23, %22 {offset = 4080}
  return
}

// ====

// Stores consume the same plan-level scalar address as loads while retaining
// each packet's payload slice and immediate.
func.def @multipacket_dynamic_view_base_store(%output: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %destination = buffer.view %aligned[%row_offset] : buffer -> view<16xi32>
  %value = vector.splati 1 : vector<16xi32>
  vector.store<volatile> %value, %destination[0] : vector<16xi32>, view<16xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @multipacket_dynamic_view_base_store(%bounded_row: reg<amdgpu.sgpr>) asm {
  %destination = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = v_mov_b32 1
  %value = concat(%12, %12, %12, %12, %12, %12, %12, %12, %12, %12, %12, %12, %12, %12, %12, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x16>
  %29 = slice %value[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  %30 = s_lshl_b32_rhs_inline %bounded_row, 17
  %31 = slice %destination[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = slice %destination[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = s_mov_b32 0
  %34, %35 = s_add_co_u32 %31, %30
  %36, %37 = s_addc_u32 %32, %33, %35
  %38 = concat(%34, %36) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %39 = v_mov_b32 0
  global_store_b128_saddr<volatile> %39, %29, %38
  %40 = slice %value[4] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr<volatile> %39, %40, %38 {offset = 16}
  %41 = slice %value[8] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr<volatile> %39, %41, %38 {offset = 32}
  %42 = slice %value[12] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr<volatile> %39, %42, %38 {offset = 48}
  return
}
