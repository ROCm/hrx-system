// RUN: pass low-select-operand-forms,low-cse,low-dce

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @left_shift_counts_gfx942(%value: reg<amdgpu.sgpr x2>, %dynamic_count: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %count_0 = s_mov_b32 0
  %shift_0 = s_lshl_b64 %value, %count_0
  %count_31 = s_mov_b32 31
  %shift_31 = s_lshl_b64 %value, %count_31
  %count_63 = s_mov_b32 63
  %shift_63 = s_lshl_b64 %value, %count_63
  %count_64 = s_mov_b32 64
  %shift_64 = s_lshl_b64 %value, %count_64
  %count_65 = s_mov_b32 65
  %shift_65 = s_lshl_b64 %value, %count_65
  %dynamic = s_lshl_b64 %value, %dynamic_count
  return %shift_0, %shift_31, %shift_63, %shift_64, %shift_65, %dynamic
}

