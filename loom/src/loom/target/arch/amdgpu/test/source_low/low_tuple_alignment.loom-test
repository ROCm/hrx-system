// Gfx125x requires even tuple bases, including non-power-of-two widths.
// RUN: emit amdgpu-assembly @aligned_triple

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @aligned_triple(%offset: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x3>, %base: reg<amdgpu.sgpr x2>) asm {
  global_store_b96_saddr %offset, %value, %base
  return
}

// ----
  global_store_b96 v0, v[2:4], s[0:1] offset:0
  s_wait_storecnt storecnt(0)
  s_endpgm

// ====

// Earlier RDNA can pack the same tuple immediately after its address.
// RUN: emit amdgpu-assembly @unaligned_triple

amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @unaligned_triple(%offset: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x3>, %base: reg<amdgpu.sgpr x2>) asm {
  global_store_b96_saddr %offset, %value, %base
  return
}

// ----
  global_store_b96 v0, v[1:3], s[0:1] offset:0
  s_wait_storecnt storecnt(0)
  s_endpgm

// ====

// A single VGPR can occupy an odd register between aligned tuples.
// RUN: emit amdgpu-assembly @tuple_and_scalar_alignment

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @tuple_and_scalar_alignment(%offset: reg<amdgpu.vgpr>, %scalar: reg<amdgpu.vgpr>, %pair: reg<amdgpu.vgpr x2>, %wide: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>) asm {
  global_store_b32_saddr %offset, %scalar, %base
  global_store_b64_saddr %offset, %pair, %base {offset = 8}
  global_store_b128_saddr %offset, %wide, %base {offset = 16}
  return
}

// ----
  global_store_b32 v1, v0, s[0:1] offset:0
  global_store_b64 v1, v[2:3], s[0:1] offset:8
  global_store_b128 v1, v[4:7], s[0:1] offset:16
  s_wait_storecnt storecnt(0)
  s_endpgm
