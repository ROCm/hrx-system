amdgpu.target<gfx1151> @target

// ERROR@+1: BACKEND/035 {value_name="address", location_base="1", required_alignment="2"}
low.func.def target<amdgpu.rdna3_5.core>(@target) @scalar_pair_requires_even(%address: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = s_load_dword_offset_only %address
  return %loaded
}

