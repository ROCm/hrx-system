  v_mov_b32 v50, v6
  v_mov_b32 v51, v7
  v_mov_b32 v52, v16
  v_mov_b32 v53, v17
  v_mov_b32 v54, v18
  v_mov_b32 v55, v19
  s_waitcnt vmcnt(4) lgkmcnt(63)
  v_wmma_f32_16x16x16_bf16 v[8:15], v[48:55], v[24:31], v[8:15]
  s_waitcnt vmcnt(2) lgkmcnt(63)
  v_mov_b32 v16, v20
  v_mov_b32 v17, v21
  v_mov_b32 v18, v22
  v_mov_b32 v19, v23
  v_mov_b32 v20, v32
  v_mov_b32 v21, v33
  v_mov_b32 v22, v34
