// RUN: emit amdgpu-assembly @bf16_two_k_block_loads_schedule_before_wmma

amdgpu.target<gfx1100> @target
low.func.def target(@target) @bf16_two_k_block_loads_schedule_before_wmma(%workitem_id: reg<amdgpu.vgpr>, %lhs_view: reg<amdgpu.sgpr x2>, %rhs_view: reg<amdgpu.sgpr x2>, %out_view: reg<amdgpu.sgpr x2>) asm<amdgpu.rdna3.core> {
  %lane = v_and_b32_src0_inline %workitem_id, 15
  %byte_offset = v_lshlrev_b32_src0_inline %lane, 6
  %lhs0_low = global_load_b128_saddr %byte_offset, %lhs_view
  %lhs0_high = global_load_b128_saddr %byte_offset, %lhs_view {offset = 16}
  %lhs0 = concat(%lhs0_low, %lhs0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs0_low = global_load_b128_saddr %byte_offset, %rhs_view
  %rhs0_high = global_load_b128_saddr %byte_offset, %rhs_view {offset = 16}
  %rhs0 = concat(%rhs0_low, %rhs0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %zero = v_mov_b32 0
  %zero_acc = concat(%zero, %zero, %zero, %zero, %zero, %zero, %zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %zero_acc_copy = copy %zero_acc : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %partial = v_wmma_f32_16x16x16_bf16 %lhs0, %rhs0, %zero_acc_copy
  %lhs1_low = global_load_b128_saddr %byte_offset, %lhs_view {offset = 32}
  %lhs1_high = global_load_b128_saddr %byte_offset, %lhs_view {offset = 48}
  %lhs1 = concat(%lhs1_low, %lhs1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs1_low = global_load_b128_saddr %byte_offset, %rhs_view {offset = 32}
  %rhs1_high = global_load_b128_saddr %byte_offset, %rhs_view {offset = 48}
  %rhs1 = concat(%rhs1_low, %rhs1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %partial_copy = copy %partial : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %result = v_wmma_f32_16x16x16_bf16 %lhs1, %rhs1, %partial_copy
  %out_offset = v_lshlrev_b32_src0_inline %workitem_id, 2
  %result0 = slice %result[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %out_offset, %result0, %out_view
  %result1 = slice %result[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %out_offset, %result1, %out_view {offset = 128}
  %result2 = slice %result[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %out_offset, %result2, %out_view {offset = 256}
  %result3 = slice %result[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %out_offset, %result3, %out_view {offset = 384}
  %result4 = slice %result[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %out_offset, %result4, %out_view {offset = 512}
  %result5 = slice %result[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %out_offset, %result5, %out_view {offset = 640}
  %result6 = slice %result[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %out_offset, %result6, %out_view {offset = 768}
  %result7 = slice %result[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %out_offset, %result7, %out_view {offset = 896}
  return
}

// Loads for both K blocks should be scheduled before the first WMMA so the
// backend can hide VMEM latency across the matrix pipe instead of preserving
// source order.
// ----
  v_and_b32 v1, 15, v0
  v_lshlrev_b32 v0, 2, v0
  v_mov_b32 v8, 0
  s_delay_alu instid0(VALU_DEP_3)
  v_lshlrev_b32 v1, 6, v1
  global_load_b128 v[4:7], v1, s[0:1] offset:0
  global_load_b128 v[16:19], v1, s[0:1] offset:16
  global_load_b128 v[20:23], v1, s[2:3] offset:0
  global_load_b128 v[24:27], v1, s[2:3] offset:16
  global_load_b128 v[28:31], v1, s[0:1] offset:32
  global_load_b128 v[32:35], v1, s[0:1] offset:48
  global_load_b128 v[36:39], v1, s[2:3] offset:32
  global_load_b128 v[40:43], v1, s[2:3] offset:48
  v_mov_b32 v9, v8
  v_mov_b32 v10, v8
  v_mov_b32 v11, v8
  v_mov_b32 v12, v8
  v_mov_b32 v13, v8
  v_mov_b32 v14, v8
  v_mov_b32 v15, v8
  s_waitcnt vmcnt(6) lgkmcnt(63)
  v_mov_b32 v48, v4
  v_mov_b32 v49, v5
  v_mov_b32 v50, v6
  v_mov_b32 v51, v7
  v_mov_b32 v52, v16
  v_mov_b32 v53, v17
  v_mov_b32 v54, v18
  v_mov_b32 v55, v19
  s_waitcnt vmcnt(4) lgkmcnt(63)
  v_mov_b32 v16, v20
  v_mov_b32 v17, v21
  v_mov_b32 v18, v22
  v_mov_b32 v19, v23
  v_mov_b32 v20, v24
  v_mov_b32 v21, v25
  v_mov_b32 v22, v26
  v_mov_b32 v23, v27
  v_wmma_f32_16x16x16_bf16 v[8:15], v[48:55], v[16:23], v[8:15]
  s_waitcnt vmcnt(2) lgkmcnt(63)
  v_mov_b32 v16, v28
  v_mov_b32 v17, v29
  v_mov_b32 v18, v30
  v_mov_b32 v19, v31
  v_mov_b32 v20, v32
  v_mov_b32 v21, v33
  v_mov_b32 v22, v34
  v_mov_b32 v23, v35
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_mov_b32 v24, v36
  v_mov_b32 v25, v37
  v_mov_b32 v26, v38
  v_mov_b32 v27, v39
  v_mov_b32 v28, v40
  v_mov_b32 v29, v41
  v_mov_b32 v30, v42
  v_mov_b32 v31, v43
  v_wmma_f32_16x16x16_bf16 v[8:15], v[16:23], v[24:31], v[8:15]
  global_store_b32 v0, v8, s[4:5] offset:0
  global_store_b32 v0, v9, s[4:5] offset:128
  global_store_b32 v0, v10, s[4:5] offset:256
  global_store_b32 v0, v11, s[4:5] offset:384
  global_store_b32 v0, v12, s[4:5] offset:512
  global_store_b32 v0, v13, s[4:5] offset:640
  global_store_b32 v0, v14, s[4:5] offset:768
  global_store_b32 v0, v15, s[4:5] offset:896
  s_endpgm
