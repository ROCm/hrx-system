// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Sequentially consistent loads complete earlier stores before observation.
// Both unused observations must survive cleanup, independently of their result.
kernel.def @sequential_store_then_load() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %base = index.constant 0 : offset
  %words = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %c1 = scalar.constant 1 : i32
  view.atomic.store %c1, %words[0] {ordering = seq_cst, scope = device} : i32, view<2xi32>
  %first = view.atomic.load %words[1] {ordering = seq_cst, scope = device} : view<2xi32> -> i32
  %second = view.atomic.load %words[1] {ordering = acquire, scope = device} : view<2xi32> -> i32
  buffer.fence scope(device) ordering(release)
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sequential_store_then_load() asm {
  %words = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %10 = v_mov_b32 1
  %11 = v_mov_b32 0
  global_store_b32_saddr<atomic> %11, %10, %words
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %first = global_load_b32_saddr<atomic> %11, %words {offset = 4, glc = 1}
  s_waitcnt {vmcnt = 0}
  buffer_gl1_inv
  buffer_gl0_inv
  %second = global_load_b32_saddr<atomic> %11, %words {offset = 4, glc = 1}
  s_waitcnt {vmcnt = 0}
  buffer_gl1_inv
  buffer_gl0_inv
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  return
}
