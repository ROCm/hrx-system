// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// A literal scalar and a vector keep independent accumulators while sharing
// the peer addresses and partial-subgroup guards.
kernel.def @independent_payload_minima() {
  %unit = index.constant 1 : index
  %size = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %workitem = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<3x2xi32>
  %destination = buffer.view %output[%base] : buffer -> view<3x3xi32>
  %limit = scalar.constant 37 : i32
  %value = vector.load %source[%workitem, 0] : view<3x2xi32> -> vector<2xi32>
  %scalar_minimum, %vector_minimum = kernel.workgroup.reduce<minsi> %limit, %value : i32, vector<2xi32>
  view.store %scalar_minimum, %destination[%workitem, 0] : i32, view<3x3xi32>
  vector.store %vector_minimum, %destination[%workitem, 1] : vector<2xi32>, view<3x3xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(3, 1, 1) workgroup_count(1, 1, 1) @independent_payload_minima() asm {
  %workitem = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {extent = 24, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 36, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %24 = v_lshlrev_b32_src0_inline %workitem, 3
  %value = global_load_b64_saddr %24, %source
  %26 = v_mov_b32 37
  %27 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %28 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %29 = v_mov_b32 3
  %30 = v_mov_b32 0
  %31 = v_add_u32_src0_inline %workitem, 2
  %32 = v_lshlrev_b32_src0_inline %31, 2
  %33 = v_cmp_lt_u32 %31, %29
  %34 = v_add_u32_src0_inline %workitem, 1
  %35 = v_lshlrev_b32_src0_inline %34, 2
  %36 = v_cmp_lt_u32 %34, %29
  %37 = ds_bpermute_b32 %32, %26
  %38 = v_min_i32 %26, %37
  %39 = v_cndmask_b32 %26, %38, %33
  %40 = ds_bpermute_b32 %35, %39
  %41 = v_min_i32 %39, %40
  %42 = v_cndmask_b32 %39, %41, %36
  %scalar_minimum = ds_bpermute_b32 %30, %42
  %44 = ds_bpermute_b32 %32, %27
  %45 = v_min_i32 %27, %44
  %46 = v_cndmask_b32 %27, %45, %33
  %47 = ds_bpermute_b32 %35, %46
  %48 = v_min_i32 %46, %47
  %49 = v_cndmask_b32 %46, %48, %36
  %50 = ds_bpermute_b32 %30, %49
  %51 = ds_bpermute_b32 %32, %28
  %52 = v_min_i32 %28, %51
  %53 = v_cndmask_b32 %28, %52, %33
  %54 = ds_bpermute_b32 %35, %53
  %55 = v_min_i32 %53, %54
  %56 = v_cndmask_b32 %53, %55, %36
  %57 = ds_bpermute_b32 %30, %56
  %vector_minimum = concat(%50, %57) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %59 = v_mov_b32 12
  %60 = v_mul_lo_u32 %workitem, %59
  global_store_b32_saddr %60, %scalar_minimum, %destination
  global_store_b64_saddr %60, %vector_minimum, %destination {offset = 4}
  return
}

// ====
// RUN: with-checks compile-report source-to-low{control-flow=structured-low},low-dce

amdgpu.target<gfx11-generic> @target

// The first result is leader-only, but a later payload requires publication to
// every workitem, including the short tail subgroup.
kernel.def target(@target) @later_payload_publication() {
  %unit = index.constant 1 : index
  %size = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %workitem = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %leader = index.constant 0 : index
  %source = buffer.view %input[%base] : buffer -> view<67x3xf32>
  %destination = buffer.view %output[%base] : buffer -> view<67x3xf32>
  %scalar = view.load %source[%workitem, 0] : view<67x3xf32> -> f32
  %vector = vector.load %source[%workitem, 1] : view<67x3xf32> -> vector<2xf32>
  %scalar_sum, %vector_sum = kernel.workgroup.reduce<addf> %scalar, %vector : f32, vector<2xf32>
  %is_leader = index.cmp eq, %workitem, %leader : index
  scf.if %is_leader {
    view.store %scalar_sum, %destination[%workitem, 0] : f32, view<67x3xf32>
  }
  vector.store %vector_sum, %destination[%workitem, 1] : vector<2xf32>, view<67x3xf32>
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: source_low[*] * source_op=kernel.workgroup.reduce selection=plan plan_key=amdgpu.workgroup_reduce.publication.lds *
