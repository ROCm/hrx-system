func.def @f32x2x4_transpose(%values: vector<2x4xf32>) -> (vector<4x2xf32>) {
  %result = vector.transpose<[1, 0]> %values : vector<2x4xf32> -> vector<4x2xf32>
  func.return %result : vector<4x2xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @f32x2x4_transpose(%values: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %5 = slice %values[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %6 = slice %values[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %7 = slice %values[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %8 = slice %values[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %9 = slice %values[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %10 = slice %values[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %11 = slice %values[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %12 = slice %values[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %result = concat(%5, %6, %7, %8, %9, %10, %11, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  return %result
}

// ====

func.def @f32x2x2x2_transpose(%values: vector<2x2x2xf32>) -> (vector<2x2x2xf32>) {
  %result = vector.transpose<[2, 0, 1]> %values : vector<2x2x2xf32> -> vector<2x2x2xf32>
  func.return %result : vector<2x2x2xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @f32x2x2x2_transpose(%values: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %5 = slice %values[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %6 = slice %values[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %7 = slice %values[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %8 = slice %values[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %9 = slice %values[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %10 = slice %values[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %11 = slice %values[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %12 = slice %values[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %result = concat(%5, %6, %7, %8, %9, %10, %11, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  return %result
