// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @i32x4_slice_middle(%values: vector<4xi32>) -> (vector<2xi32>) {
  %middle = vector.slice %values[1] : vector<4xi32> -> vector<2xi32>
  func.return %middle : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i32x4_slice_middle(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %middle = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  return %middle
}

// ====

func.def @i8x4_slice_high_half(%bytes: vector<4xi8>) -> (vector<2xi8>) {
  %high = vector.slice %bytes[2] : vector<4xi8> -> vector<2xi8>
  func.return %high : vector<2xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x4_slice_high_half(%bytes: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %high = v_lshrrev_b32_src0_inline %bytes, 16
  return %high
}

// ====

func.def @i64x8_slice_middle(%values: vector<8xi64>) -> (vector<3xi64>) {
  %middle = vector.slice %values[2] : vector<8xi64> -> vector<3xi64>
  func.return %middle : vector<3xi64>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i64x8_slice_middle(%values: reg<amdgpu.vgpr x16>) -> (reg<amdgpu.vgpr x6>) asm {
  %middle = slice %values[4] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x6>
  return %middle
}

// ====

func.def @i1_slice_register_pairs(%small: vector<16xi1>, %full: vector<32xi1>) -> (vector<2xi1>, vector<16xi1>) {
  %middle = vector.slice %small[7] : vector<16xi1> -> vector<2xi1>
  %upper = vector.slice %full[16] : vector<32xi1> -> vector<16xi1>
  func.return %middle, %upper : vector<2xi1>, vector<16xi1>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i1_slice_register_pairs(%small: reg<amdgpu.sgpr x32>, %full: reg<amdgpu.sgpr x64>) -> (reg<amdgpu.sgpr x4>, reg<amdgpu.sgpr x32>) asm {
  %middle = slice %small[14] : reg<amdgpu.sgpr x32> -> reg<amdgpu.sgpr x4>
  %upper = slice %full[32] : reg<amdgpu.sgpr x64> -> reg<amdgpu.sgpr x32>
  return %middle, %upper
}

// ====

func.def @i8x8_interleave(%even: vector<4xi8>, %odd: vector<4xi8>) -> (vector<8xi8>) {
  %result = vector.interleave<0> %even, %odd : vector<4xi8>, vector<4xi8> -> vector<8xi8>
  func.return %result : vector<8xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x8_interleave(%even: reg<amdgpu.vgpr>, %odd: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %7 = v_perm_b32_src2_lit %even, %odd, 17104900
  %8 = v_perm_b32_src2_lit %even, %odd, 50790918
  %result = concat(%7, %8) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

func.def @i8x8_deinterleave(%values: vector<8xi8>) -> (vector<4xi8>, vector<4xi8>) {
  %even, %odd = vector.deinterleave<0> %values : vector<8xi8> -> vector<4xi8>, vector<4xi8>
  func.return %even, %odd : vector<4xi8>, vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x8_deinterleave(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %8 = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %9 = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %even = v_perm_b32_src2_lit %8, %9, 33555972
  %odd = v_perm_b32_src2_lit %8, %9, 50398981
  return %even, %odd
}

// ====

func.def @i16x1_broadcast(%value: vector<1xi16>) -> (vector<16xi16>) {
  %result = vector.broadcast %value : vector<1xi16> -> vector<16xi16>
  func.return %result : vector<16xi16>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i16x1_broadcast(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x8>) asm {
  %7 = v_and_b32_lit %value, 65535
  %9 = v_lshlrev_b32_src0_inline %7, 16
  %10 = v_or_b32 %7, %9
  %result = concat(%10, %10, %10, %10, %10, %10, %10, %10) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  return %result
}

// ====

func.def @f16x4_insert_static(%values: vector<4xf16>, %value: f16) -> (vector<4xf16>) {
  %updated = vector.insert %value into %values[1] : f16, vector<4xf16>
  func.return %updated : vector<4xf16>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @f16x4_insert_static(%values: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %7 = v_and_b32_lit %value, 65535
  %8 = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %9 = v_and_b32_lit %8, 65535
  %10 = v_lshlrev_b32_src0_inline %7, 16
  %11 = v_or_b32 %9, %10
  %12 = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %updated = concat(%11, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %updated
}

// ====

func.def @bf16x4_insert_dynamic(%values: vector<4xbf16>, %value: bf16, %lane: index) -> (vector<4xbf16>) {
  %updated = vector.insert %value into %values[%lane] : bf16, vector<4xbf16>
  func.return %updated : vector<4xbf16>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @bf16x4_insert_dynamic(%values: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>, %lane: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = v_and_b32_lit %value, 65535
  %10 = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = v_and_b32_lit %10, 4294901760
  %12 = v_or_b32 %11, %9
  %13 = v_cmp_eq_i32_src1_inline %lane {rhs = 0}
  %14 = v_cndmask_b32 %10, %12, %13
  %15 = v_and_b32_lit %10, 65535
  %16 = v_lshlrev_b32_src0_inline %9, 16
  %17 = v_or_b32 %15, %16
  %18 = v_cmp_eq_i32_src1_inline %lane {rhs = 1}
  %19 = v_cndmask_b32 %14, %17, %18
  %20 = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = v_and_b32_lit %20, 4294901760
  %22 = v_or_b32 %21, %9
  %23 = v_cmp_eq_i32_src1_inline %lane {rhs = 2}
  %24 = v_cndmask_b32 %20, %22, %23
  %25 = v_and_b32_lit %20, 65535
  %27 = v_or_b32 %25, %16
  %28 = v_cmp_eq_i32_src1_inline %lane {rhs = 3}
  %29 = v_cndmask_b32 %24, %27, %28
  %updated = concat(%19, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %updated
}

// ====

func.def @f16x64_extract_high(%values: vector<64xf16>) -> (f16) {
  %result = vector.extract %values[47] : vector<64xf16> -> f16
  func.return %result : f16
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @f16x64_extract_high(%values: reg<amdgpu.vgpr x32>) -> (reg<amdgpu.vgpr>) asm {
  %5 = slice %values[23] : reg<amdgpu.vgpr x32> -> reg<amdgpu.vgpr>
  %result = v_lshrrev_b32_src0_inline %5, 16
  return %result
}

