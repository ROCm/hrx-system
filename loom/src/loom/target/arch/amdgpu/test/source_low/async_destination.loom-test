low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @gather_specialized_subgroup_extent() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %global = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = storage {byte_alignment = 16, byte_length = 1024} : low.storage<workgroup>
  %17 = v_lshlrev_b32_src0_inline %lane, 2
  %18 = s_mov_b32_m0_imm 0
  global_load_lds_dword_saddr %17, %global, %18
  s_waitcnt {vmcnt = 0}
