// RUN: emit source-low output=low

// A compact explicit layout may give singleton axes arbitrary strides.
amdgpu.target<gfx942> @target

kernel.def target(@target) @gather_explicit_lane_layout() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %storage_bytes = index.constant 1024 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source_base = buffer.view %global[%base] : buffer -> view<64x4xi8>
  %source = view.subview %source_base[%lane, 0] : view<64x4xi8> -> view<1x4xi8>
  %scratch = buffer.alloca<workgroup> align(16) %storage_bytes : buffer
  %layout = encoding.layout.strided [4, 99, 1] : encoding<layout>
  %dest = buffer.view %scratch[%base] : buffer -> view<64x1x4xi8, %layout>
  %copy = kernel.async.gather %source to %dest {cache_scope = device, cache_temporal = regular} : view<1x4xi8> to view<64x1x4xi8, %layout> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @gather_explicit_lane_layout() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %global = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = storage {byte_alignment = 16, byte_length = 1024} : low.storage<workgroup>
  %17 = v_lshlrev_b32_src0_inline %lane, 2
  %18 = s_mov_b32_m0_imm 0
  global_load_lds_dword_saddr %17, %global, %18
  s_waitcnt {vmcnt = 0}
  return
}

// ====

// The selected subgroup size specializes an authored dynamic lane axis.
amdgpu.target<gfx942> @target

kernel.def target(@target) @gather_specialized_subgroup_extent() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer) {
  %lane = kernel.workitem.id<x> : index
  %wave = kernel.subgroup.size : index
  %base = index.constant 0 : offset
  %storage_bytes = index.constant 1024 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source_base = buffer.view %global[%base] : buffer -> view<64x4xi8>
  %source = view.subview %source_base[%lane, 0] : view<64x4xi8> -> view<1x4xi8>
  %scratch = buffer.alloca<workgroup> align(16) %storage_bytes : buffer
  %dest = buffer.view %scratch[%base] : buffer -> view<[%wave]x1x4xi8>
  %copy = kernel.async.gather %source to %dest {cache_scope = device, cache_temporal = regular} : view<1x4xi8> to view<[%wave]x1x4xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.return
}

