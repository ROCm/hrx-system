// TEMPLATE: loom/src/loom/test/corpus/source_low/uniform_predicate_control.loom-test
// RUN: with-checks emit source-low output=low

amdgpu.target<gfx1151> @target

kernel.def target(@target) @uniform_select_guard() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%mode: i32, %input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %number = index.cast %lane : index to i32
  %threshold = scalar.constant 0 : i32
  %negative = scalar.constant -1 : i32
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %in = buffer.view %aligned_input[%base] : buffer -> view<64xi32>
  %out = buffer.view %aligned_output[%base] : buffer -> view<64xi32>
  %condition = scalar.cmpi sgt, %mode, %threshold : i32
  cfg.cond_br %condition, ^read, ^fallback
^read:
  %loaded = view.load %in[%lane] : view<64xi32> -> i32
  cfg.br ^finish(%loaded: i32)
^fallback:
  cfg.br ^finish(%negative: i32)
^finish(%value: i32):
  %selected = scf.select %condition, %number, %negative : i32
  %sum = scalar.addi %value, %selected : i32
  view.store %sum, %out[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
CHECK: %condition = v_cmp*
CHECK: %selected = v_cndmask_b32*
CHECK: *, * = s_and_b64_scc %condition, *
CHECK: low.cond_br *, ^read, ^fallback : reg<amdgpu.scc>
CHECK-NOT: *s_and_saveexec_b64*
CHECK-NOT: *s_mov_b64_exec *

// ====

