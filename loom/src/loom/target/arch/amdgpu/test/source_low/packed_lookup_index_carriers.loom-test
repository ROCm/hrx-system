  %15 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = v_and_b32_lit %15, 7
  %18 = slice %table[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = slice %table[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
