// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Exact contracts cover every native integer selector representation, partial
// packed-i16 sources, and all tails of full-width selector packing.

func.def @byte_table_i16_one_index(%table: vector<8xi8>, %input: vector<1xi16>) -> (vector<1xi8>) {
  %mask_scalar = scalar.constant 7 : i16
  %mask = vector.splat %mask_scalar : vector<1xi16>
  %indices = vector.andi %input, %mask : vector<1xi16>
  %values = vector.table.lookup %table[%indices] : vector<8xi8>, vector<1xi16> -> vector<1xi8>
  func.return %values : vector<1xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @byte_table_i16_one_index(%table: reg<amdgpu.vgpr x2>, %input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %mask = v_mov_b32 458759
  %indices = v_and_b32 %input, %mask
  %12 = slice %table[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %13 = slice %table[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_perm_b32_src2_lit %indices, %indices, 100925952
  %values = v_perm_b32 %13, %12, %14
  return %values
}

