  %9 = v_mov_b32 458759
  %12 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_and_b32 %12, %9
  %15 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %17 = v_and_b32 %15, %9
  %19 = slice %table[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20 = slice %table[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %23 = v_perm_b32_src2_lit %17, %14, 100925952
  %values = v_perm_b32 %20, %19, %23
  return %values
}

