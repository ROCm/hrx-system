// Allocation without a scheduler retains the mask after its final SSA use.
// RUN: with-checks emit low-allocation-json @dead_mask

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @dead_mask(%mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>) asm {
  %selected = v_cndmask_b32 %value, %value, %mask
  %result = s_or_b32 %source, %source
  return %selected, %result
}

// ----
CHECK: *"name":"result","type":"reg<amdgpu.sgpr>"*,"location":{"kind":"physical_register","base":2,"count":1}*

