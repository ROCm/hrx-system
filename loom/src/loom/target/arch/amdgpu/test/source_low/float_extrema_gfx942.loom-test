// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @float_extrema_f32(%lhs: f32, %rhs: f32) -> (f32, f32, f32, f32) {
  %minimum = scalar.minimumf %lhs, %rhs : f32
  %maximum = scalar.maximumf %lhs, %rhs : f32
  %minnum = scalar.minnumf %lhs, %rhs : f32
  %maxnum = scalar.maxnumf %lhs, %rhs : f32
  func.return %minimum, %maximum, %minnum, %maxnum : f32, f32, f32, f32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @float_extrema_f32(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %24 = v_max_f32 %lhs, %lhs
  %25 = v_max_f32 %rhs, %rhs
  %26 = v_min_f32 %24, %25
  %27 = v_cmp_u_f32 %lhs, %rhs
  %28 = v_mov_b32 2143289344
  %minimum = v_cndmask_b32 %26, %28, %27
  %32 = v_max_f32 %24, %25
  %maximum = v_cndmask_b32 %32, %28, %27
  return %minimum, %maximum, %26, %32
}

// ====

kernel.def @float_extrema_uniform() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_bits: i32, %rhs_bits: i32, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<2x64xf32>
  %lhs = scalar.bitcast %lhs_bits : i32 to f32
  %rhs = scalar.bitcast %rhs_bits : i32 to f32
  %minimum = scalar.minnumf %lhs, %rhs : f32
  %maximum = scalar.maxnumf %lhs, %rhs : f32
  view.store %minimum, %result_view_0[0, %fixture_lane] : f32, view<2x64xf32>
  view.store %maximum, %result_view_0[1, %fixture_lane] : f32, view<2x64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs_bits", arg1 = "rhs_bits"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @float_extrema_uniform(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = v_mov_b32_copy %lhs
  %21 = v_max_f32 %19, %19
  %22 = v_mov_b32_copy %rhs
  %24 = v_max_f32 %22, %22
  %minimum = v_min_f32 %21, %24
  %maximum = v_max_f32 %21, %24
  %33 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_dword_saddr %33, %minimum, %result_view_0
  global_store_dword_saddr %33, %maximum, %result_view_0 {offset = 256}
  return
}
