// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @literal_logical_right_shifts(%values: vector<2xi64>) -> (i64, i64, i64, i64, i64, i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %c0 = scalar.constant 0 : i64
  %c8 = scalar.constant 8 : i64
  %c31 = scalar.constant 31 : i64
  %c32 = scalar.constant 32 : i64
  %c33 = scalar.constant 33 : i64
  %c63 = scalar.constant 63 : i64
  %s0 = scalar.shrui %value, %c0 : i64
  %s8 = scalar.shrui %value, %c8 : i64
  %s31 = scalar.shrui %value, %c31 : i64
  %s32 = scalar.shrui %value, %c32 : i64
  %s33 = scalar.shrui %value, %c33 : i64
  %s63 = scalar.shrui %value, %c63 : i64
  func.return %s0, %s8, %s31, %s32, %s33, %s63 : i64, i64, i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @literal_logical_right_shifts(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %value = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %28 = s_mov_b32 8
  %31 = s_mov_b32 31
  %s8 = v_lshrrev_b64 %28, %value
  %s31 = v_lshrrev_b64 %31, %value
  %51 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %39 = v_mov_b32 0
  %s32 = concat(%51, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %43 = v_lshrrev_b32_src0_inline %51, 33
  %s33 = concat(%43, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %47 = v_lshrrev_b32_src0_inline %51, 63
  %s63 = concat(%47, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %value, %s8, %s31, %s32, %s33, %s63
}

// ====

amdgpu.target<gfx11-generic> @target

// Bounded inputs omit only their zero upper-word products, not the upper word
// of the result. The full-width control retains both cross products.
func.def target(@target) @uniform_product_widths(%lhs_input: i64, %rhs_input: i64, %wide_lhs: i64, %wide_rhs: i64) -> (i64, i64, i64, i64) {
  %lhs = scalar.assume %lhs_input [range(%lhs_input, 0, 4294967295)] : i64
  %rhs = scalar.assume %rhs_input [range(%rhs_input, 0, 4294967295)] : i64
  %narrow = scalar.muli %lhs, %rhs : i64
  %left_narrow = scalar.muli %lhs, %wide_rhs : i64
  %right_narrow = scalar.muli %wide_lhs, %rhs : i64
  %wide = scalar.muli %wide_lhs, %wide_rhs : i64
  func.return %narrow, %left_narrow, %right_narrow, %wide : i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_product_widths(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>, %wide_lhs: reg<amdgpu.sgpr x2>, %wide_rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %22 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = s_mul_i32 %22, %23
  %25 = s_mul_hi_u32 %22, %23
  %narrow = concat(%24, %25) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %28 = slice %wide_rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = slice %wide_rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30 = s_mul_i32 %22, %28
  %31 = s_mul_hi_u32 %22, %28
  %32 = s_mul_i32 %22, %29
  %33 = s_add_u32 %31, %32
  %left_narrow = concat(%30, %33) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %36 = slice %wide_lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37 = slice %wide_lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = s_mul_i32 %36, %23
  %39 = s_mul_hi_u32 %36, %23
  %40 = s_mul_i32 %37, %23
  %41 = s_add_u32 %39, %40
  %right_narrow = concat(%38, %41) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %47 = s_mul_i32 %36, %28
  %48 = s_mul_hi_u32 %36, %28
  %49 = s_mul_i32 %36, %29
  %50 = s_mul_i32 %37, %28
  %51 = s_add_u32 %48, %49
  %52 = s_add_u32 %51, %50
  %wide = concat(%47, %52) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %narrow, %left_narrow, %right_narrow, %wide
}

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @varying_product_widths(%values: vector<4xi64>) -> (i64, i64, i64, i64) {
  %lhs_input = vector.extract %values[0] : vector<4xi64> -> i64
  %rhs_input = vector.extract %values[1] : vector<4xi64> -> i64
  %wide_lhs = vector.extract %values[2] : vector<4xi64> -> i64
  %wide_rhs = vector.extract %values[3] : vector<4xi64> -> i64
  %lhs = scalar.assume %lhs_input [range(%lhs_input, 0, 4294967295)] : i64
  %rhs = scalar.assume %rhs_input [range(%rhs_input, 0, 4294967295)] : i64
  %narrow = scalar.muli %lhs, %rhs : i64
  %left_narrow = scalar.muli %lhs, %wide_rhs : i64
  %right_narrow = scalar.muli %wide_lhs, %rhs : i64
  %wide = scalar.muli %wide_lhs, %wide_rhs : i64
  func.return %narrow, %left_narrow, %right_narrow, %wide : i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @varying_product_widths(%values: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %67 = slice %values[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %66 = slice %values[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %26 = v_mul_lo_u32 %67, %66
  %27 = v_mul_hi_u32 %67, %66
  %narrow = concat(%26, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %64 = slice %values[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %63 = slice %values[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %32 = v_mul_lo_u32 %67, %64
  %33 = v_mul_hi_u32 %67, %64
  %34 = v_mul_lo_u32 %67, %63
  %35 = v_add_u32 %33, %34
  %left_narrow = concat(%32, %35) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %61 = slice %values[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %60 = slice %values[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %40 = v_mul_lo_u32 %61, %66
  %41 = v_mul_hi_u32 %61, %66
  %42 = v_mul_lo_u32 %60, %66
  %43 = v_add_u32 %41, %42
  %right_narrow = concat(%40, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %49 = v_mul_lo_u32 %61, %64
  %50 = v_mul_hi_u32 %61, %64
  %51 = v_mul_lo_u32 %61, %63
  %52 = v_mul_lo_u32 %60, %64
  %53 = v_add_u32 %50, %51
  %54 = v_add_u32 %53, %52
  %wide = concat(%49, %54) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %narrow, %left_narrow, %right_narrow, %wide
}
