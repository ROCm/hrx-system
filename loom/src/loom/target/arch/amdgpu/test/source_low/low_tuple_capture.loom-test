// ====
// The aggregate is not live on the writing path. That write must not create
// an eager capture before the conditional branch.
// RUN: emit amdgpu-assembly @write_on_disjoint_path

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @write_on_disjoint_path(%condition: reg<amdgpu.scc>, %seed: reg<amdgpu.vgpr>, %factor: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %initial = concat(%seed, %seed) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.cond_br %condition, ^write, ^forward : reg<amdgpu.scc>
^write:
  %changed = v_fmac_f32 %seed, %factor, %factor
  global_store_b32_saddr %address, %changed, %output
  return
^forward:
  low.br ^output(%initial: reg<amdgpu.vgpr x2>)
^output(%saved: reg<amdgpu.vgpr x2>):
  global_store_b64_saddr %address, %saved, %output
  return
}

// ----
  s_cbranch_scc0 .Lbb2
.Lbb1:
  v_fmac_f32 v0, v1, v1
  global_store_b32 v2, v0, s[0:1] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm
.Lbb2:
  v_mov_b32 v1, v0
.Lbb3:
  global_store_b64 v2, v[0:1], s[0:1] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

