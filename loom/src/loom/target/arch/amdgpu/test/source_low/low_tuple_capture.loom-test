// Concat results capture their component contents at the concat, even when
// branch transport is decomposed and a required source write intervenes.
// RUN: emit amdgpu-assembly @branch_capture
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @branch_capture(%seed: reg<amdgpu.vgpr>, %factor: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %initial = concat(%seed, %seed) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %changed = v_fmac_f32 %seed, %factor, %factor
  low.br ^output(%initial: reg<amdgpu.vgpr x2>)
^output(%saved: reg<amdgpu.vgpr x2>):
  global_store_b64_saddr %address, %saved, %output
  global_store_b32_saddr %address, %changed, %output {offset = 8}
  return
}

// ----
  v_mov_b32 v4, v0
  v_fmac_f32 v0, v1, v1
  s_delay_alu instid0(VALU_DEP_2)
  v_mov_b32 v5, v4
.Lbb1:
  global_store_b64 v2, v[4:5], s[0:1] offset:0
  global_store_b32 v2, v0, s[0:1] offset:8
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

