// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @single_wide_element(%lhs: vector<1xi64>, %rhs: vector<1xi64>) -> (vector<1xi64>) {
  %result = vector.andi %lhs, %rhs : vector<1xi64>
  func.return %result : vector<1xi64>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @single_wide_element(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %7 = slice %lhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %8 = slice %rhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %9 = v_and_b32 %7, %8
  %10 = slice %lhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = slice %rhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %12 = v_and_b32 %10, %11
  %result = concat(%9, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

