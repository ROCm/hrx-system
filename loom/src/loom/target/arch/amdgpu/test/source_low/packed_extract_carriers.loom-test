// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Strided publication observes only the extracted payload, including a field
// with live packed neighbors on both sides.
func.def @static_payload(%bytes: vector<4xi8>, %halves: vector<2xi16>, %output: buffer) {
  %origin = index.constant 0 : offset
  %byte_view = buffer.view %output[%origin] : buffer -> view<8xi8>
  %half_view = buffer.view %output[%origin] : buffer -> view<4xi16>
  %low = vector.extract %bytes[0] : vector<4xi8> -> i8
  %middle = vector.extract %bytes[1] : vector<4xi8> -> i8
  %high = vector.extract %halves[1] : vector<2xi16> -> i16
  view.store %low, %byte_view[0] : i8, view<8xi8>
  view.store %middle, %byte_view[2] : i8, view<8xi8>
  view.store %high, %half_view[3] : i16, view<4xi16>
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @static_payload(%low: reg<amdgpu.vgpr>, %halves: reg<amdgpu.vgpr>) asm {
  %half_view = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %middle = v_lshrrev_b32_src0_inline %low, 8
  %high = v_lshrrev_b32_src0_inline %halves, 16
  %14 = slice %half_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = slice %half_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %14
  %17 = v_mov_b32_copy %15
  %18 = concat(%16, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b8_vaddr %18, %low
  %23 = concat(%16, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b8_vaddr %23, %middle {offset = 2}
  %28 = concat(%16, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_short_vaddr %28, %high {offset = 6}
  return
}

// ====

func.def @static_conversions(%bytes: vector<4xi8>, %halves: vector<2xi16>) -> (i32, i32, i32, i32) {
  %byte_signed = vector.extract %bytes[1] : vector<4xi8> -> i8
  %byte_unsigned = vector.extract %bytes[2] : vector<4xi8> -> i8
  %half_signed = vector.extract %halves[0] : vector<2xi16> -> i16
  %half_unsigned = vector.extract %halves[1] : vector<2xi16> -> i16
  %a = scalar.extsi %byte_signed : i8 to i32
  %b = scalar.extui %byte_unsigned : i8 to i32
  %c = scalar.extsi %half_signed : i16 to i32
  %d = scalar.extui %half_unsigned : i16 to i32
  func.return %a, %b, %c, %d : i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @static_conversions(%bytes: reg<amdgpu.vgpr>, %halves: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %a = v_bfe_i32_offset_width_inline %bytes {offset = 8, width = 8}
  %b = v_bfe_u32_offset_width_inline %bytes {offset = 16, width = 8}
  %c = v_bfe_i32_offset_width_inline %halves {offset = 0, width = 16}
  %d = v_bfe_u32_offset_width_inline %halves {offset = 16, width = 16}
  return %a, %b, %c, %d
}

// ====

func.def @dynamic_payload(%bytes: vector<8xi8>, %halves: vector<4xi16>, %position: index, %output: buffer) where [range(%position, 0, 3)] {
  %origin = index.constant 0 : offset
  %byte_view = buffer.view %output[%origin] : buffer -> view<8xi8>
  %half_view = buffer.view %output[%origin] : buffer -> view<4xi16>
  %byte = vector.extract %bytes[%position] : vector<8xi8> -> i8
  %half = vector.extract %halves[%position] : vector<4xi16> -> i16
  view.store %byte, %byte_view[0] : i8, view<8xi8>
  view.store %half, %half_view[3] : i16, view<4xi16>
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @dynamic_payload(%bytes: reg<amdgpu.vgpr x2>, %halves: reg<amdgpu.vgpr x2>, %position: reg<amdgpu.vgpr>) where [range(%position, 0, 3)] asm {
  %half_view = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = slice %bytes[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_mov_b32 1
  %15 = v_cmp_eq_i32 %position, %14
  %17 = v_lshrrev_b32_src0_inline %13, 8
  %18 = v_cndmask_b32 %13, %17, %15
  %19 = v_mov_b32 2
  %20 = v_cmp_eq_i32 %position, %19
  %22 = v_lshrrev_b32_src0_inline %13, 16
  %23 = v_cndmask_b32 %18, %22, %20
  %24 = v_mov_b32 3
  %25 = v_cmp_eq_i32 %position, %24
  %27 = v_lshrrev_b32_src0_inline %13, 24
  %28 = v_cndmask_b32 %23, %27, %25
  %29 = v_mov_b32 4
  %30 = v_cmp_eq_i32 %position, %29
  %31 = slice %bytes[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %32 = v_cndmask_b32 %28, %31, %30
  %33 = v_mov_b32 5
  %34 = v_cmp_eq_i32 %position, %33
  %36 = v_lshrrev_b32_src0_inline %31, 8
  %37 = v_cndmask_b32 %32, %36, %34
  %38 = v_mov_b32 6
  %39 = v_cmp_eq_i32 %position, %38
  %41 = v_lshrrev_b32_src0_inline %31, 16
  %42 = v_cndmask_b32 %37, %41, %39
  %43 = v_mov_b32 7
  %44 = v_cmp_eq_i32 %position, %43
  %46 = v_lshrrev_b32_src0_inline %31, 24
  %byte = v_cndmask_b32 %42, %46, %44
  %48 = slice %halves[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %52 = v_lshrrev_b32_src0_inline %48, 16
  %53 = v_cndmask_b32 %48, %52, %15
  %56 = slice %halves[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %57 = v_cndmask_b32 %53, %56, %20
  %61 = v_lshrrev_b32_src0_inline %56, 16
  %half = v_cndmask_b32 %57, %61, %25
  %63 = slice %half_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %64 = slice %half_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %65 = v_mov_b32_copy %63
  %66 = v_mov_b32_copy %64
  %67 = concat(%65, %66) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b8_vaddr %67, %byte
  %72 = concat(%65, %66) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_short_vaddr %72, %half {offset = 6}
  return
}

// ====

// One extracted payload has both signed and unsigned consumers. They must
// retain their different interpretations even when the producer stays raw.
func.def @dynamic_conversions(%bytes: vector<4xi8>, %halves: vector<4xi16>, %position: index) -> (i32, i32, i32, i32) where [range(%position, 0, 3)] {
  %byte = vector.extract %bytes[%position] : vector<4xi8> -> i8
  %half = vector.extract %halves[%position] : vector<4xi16> -> i16
  %a = scalar.extsi %byte : i8 to i32
  %b = scalar.extui %byte : i8 to i32
  %c = scalar.extsi %half : i16 to i32
  %d = scalar.extui %half : i16 to i32
  func.return %a, %b, %c, %d : i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @dynamic_conversions(%bytes: reg<amdgpu.vgpr>, %halves: reg<amdgpu.vgpr x2>, %position: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) where [range(%position, 0, 3)] asm {
  %20 = v_bfe_i32_offset_width_inline %bytes {offset = 0, width = 8}
  %21 = v_mov_b32 1
  %22 = v_cmp_eq_i32 %position, %21
  %23 = v_bfe_i32_offset_width_inline %bytes {offset = 8, width = 8}
  %24 = v_cndmask_b32 %20, %23, %22
  %25 = v_mov_b32 2
  %26 = v_cmp_eq_i32 %position, %25
  %27 = v_bfe_i32_offset_width_inline %bytes {offset = 16, width = 8}
  %28 = v_cndmask_b32 %24, %27, %26
  %29 = v_mov_b32 3
  %30 = v_cmp_eq_i32 %position, %29
  %31 = v_ashrrev_i32_src0_inline %bytes, 24
  %a = v_cndmask_b32 %28, %31, %30
  %33 = slice %halves[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %34 = v_bfe_i32_offset_width_inline %33 {offset = 0, width = 16}
  %38 = v_ashrrev_i32_src0_inline %33, 16
  %39 = v_cndmask_b32 %34, %38, %22
  %42 = slice %halves[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %43 = v_bfe_i32_offset_width_inline %42 {offset = 0, width = 16}
  %44 = v_cndmask_b32 %39, %43, %26
  %48 = v_ashrrev_i32_src0_inline %42, 16
  %c = v_cndmask_b32 %44, %48, %30
  %b = v_and_b32_lit %a, 255
  %d = v_and_b32_lit %c, 65535
  return %a, %b, %c, %d
}

// ====

func.def @single_lane(%byte: vector<1xi8>, %half: vector<1xi16>, %output: buffer) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %bytes = buffer.view %output[%origin] : buffer -> view<1xi8>
  %a = vector.extract %byte[0] : vector<1xi8> -> i8
  %b = vector.extract %half[0] : vector<1xi16> -> i16
  %signed = scalar.extsi %b : i16 to i32
  %unsigned = scalar.extui %b : i16 to i32
  view.store %a, %bytes[0] : i8, view<1xi8>
  func.return %signed, %unsigned : i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @single_lane(%a: reg<amdgpu.vgpr>, %half: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %bytes = resource<hal_binding> {extent = 1, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %signed = v_bfe_i32_offset_width_inline %half {offset = 0, width = 16}
  %unsigned = v_and_b32_lit %signed, 65535
  %18 = slice %bytes[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = slice %bytes[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = v_mov_b32_copy %18
  %21 = v_mov_b32_copy %19
  %22 = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b8_vaddr %22, %a
  return %signed, %unsigned
}

// ====

// Scalar LDS loads use unsigned packets when only their payload is consumed.
// Signed and unsigned numeric consumers retain their distinct requirements.
kernel.def @shared_load_carriers() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %size = index.constant 8 : offset
  %stage = buffer.alloca<workgroup> align(8) %size : buffer
  %stage_words = buffer.view %stage[%origin] : buffer -> view<2xi32>
  %stage_bytes = buffer.view %stage[%origin] : buffer -> view<8xi8>
  %stage_halves = buffer.view %stage[%origin] : buffer -> view<4xi16>
  %out_bytes = buffer.view %output[%origin] : buffer -> view<24xi8>
  %out_halves = buffer.view %output[%origin] : buffer -> view<12xi16>
  %out_words = buffer.view %output[%origin] : buffer -> view<6xi32>
  view.store %input, %stage_words[0] : i32, view<2xi32>
  view.store %input, %stage_words[1] : i32, view<2xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %raw_byte = view.load %stage_bytes[0] : view<8xi8> -> i8
  %raw_half = view.load %stage_halves[1] : view<4xi16> -> i16
  %signed_byte = view.load %stage_bytes[4] : view<8xi8> -> i8
  %unsigned_half = view.load %stage_halves[3] : view<4xi16> -> i16
  %a = scalar.extsi %signed_byte : i8 to i32
  %b = scalar.extui %unsigned_half : i16 to i32
  view.store %raw_byte, %out_bytes[0] : i8, view<24xi8>
  view.store %raw_half, %out_halves[1] : i16, view<12xi16>
  view.store %a, %out_words[2] : i32, view<6xi32>
  view.store %b, %out_words[3] : i32, view<6xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "input"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @shared_load_carriers(%input: reg<amdgpu.sgpr>) asm {
  %out_words = resource<hal_binding> {extent = 24, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = storage {byte_alignment = 8, byte_length = 8} : low.storage<workgroup>
  %22 = v_mov_b32_copy %input
  %23 = v_mov_b32 0
  ds_write_b32 %23, %22
  ds_write_b32 %23, %22 {offset = 4}
  s_waitcnt {lgkmcnt = 0}
  %raw_byte = ds_read_u8 %23
  %raw_half = ds_read_u16 %23 {offset = 2}
  %31 = ds_read_u8 %23 {offset = 4}
  %a = v_bfe_i32_offset_width_inline %31 {offset = 0, width = 8}
  %b = ds_read_u16 %23 {offset = 6}
  global_store_b8_saddr %23, %raw_byte, %out_words
  global_store_short_saddr %23, %raw_half, %out_words {offset = 2}
  global_store_b32_saddr %23, %a, %out_words {offset = 8}
  global_store_b32_saddr %23, %b, %out_words {offset = 12}
  return
}
