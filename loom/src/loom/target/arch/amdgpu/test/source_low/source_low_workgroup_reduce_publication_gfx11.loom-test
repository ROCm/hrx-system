// TEMPLATE: loom/src/loom/test/corpus/source_low/workgroup_reduce_publication.loom-test
// RUN: with-checks compile-report target=amdgpu:gfx11-generic scf-to-cfg,cfg-simplify,source-to-low,low-dce

// Tail capacity determines whether every subgroup can combine the partials.
kernel.def @workgroup_reduce_tail_65_all() {
  %unit = index.constant 1 : index
  %size = index.constant 65 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %input_view = buffer.view %input[%start] : buffer -> view<65xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<65xf32>
  %value = view.load %input_view[%tid] : view<65xf32> -> f32
  %sum = kernel.workgroup.reduce<addf> %value : f32
  view.store %sum, %output_view[%tid] : f32, view<65xf32>
  kernel.return
}

