// RUN: emit amdgpu-assembly @branch_edge_copy_consumes_load_result amdgpu.vgpr=9

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @branch_edge_copy_consumes_load_result(%addr: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %loaded = global_load_b32_saddr %addr, %base
  low.br ^join(%loaded: reg<amdgpu.vgpr>)
^join(%joined: reg<amdgpu.vgpr>):
  %used = v_add_u32 %joined, %addr
  return
}

// A register-repair copy on a branch edge is the first hardware consumer of
// the load result. Its LOADCNT wait belongs before the copy, not at the later
// SSA consumer in the successor block.
// ----
  global_load_b32 v1, v0, s[0:1] offset:0
.Lbb1:
  s_wait_loadcnt loadcnt(0)
  v_add_u32 v1, v1, v0
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @branch_edge_copy_precedes_xcnt_drain amdgpu.vgpr=4

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @branch_edge_copy_precedes_xcnt_drain(%initial_addr: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %replacement: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop(%initial_addr: reg<amdgpu.vgpr>)
^loop(%addr: reg<amdgpu.vgpr>):
  global_store_b32_saddr %addr, %value, %base
  low.br ^loop(%replacement: reg<amdgpu.vgpr>)
}

// The edge copy executes before s_branch and overwrites the outstanding
// store's address register. The branch drain therefore cannot discharge the
// source lease until after the copy has been protected explicitly.
// ----
.Lbb1:
  global_store_b32 v0, v1, s[0:1] offset:0
  s_wait_xcnt xcnt(0)
  v_mov_b32 v0, v2
  s_branch .Lbb1

// ====
// RUN: emit amdgpu-assembly @rotating_copy_keeps_future_load_pending amdgpu.vgpr=9

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @rotating_copy_keeps_future_load_pending(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %seed: reg<amdgpu.vgpr>) asm {
  low.br ^loop(%seed: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>):
  %future = global_load_b32_saddr %address, %base
  %used = v_add_u32 %carried, %address
  low.br ^loop(%future: reg<amdgpu.vgpr>)
}

// The prior iteration completed the carried input before copying it. The new
// load can remain pending through the old input's arithmetic; its first read
// is the materialized backedge copy.
// ----
.Lbb1:
  global_load_b32 v2, v1, s[0:1] offset:0
  v_add_u32 v0, v0, v1
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_mov_b32 v0, v2
  s_branch .Lbb1

// ====
// RUN: emit amdgpu-assembly @coalesced_edge_preserves_pending_load amdgpu.vgpr=5

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @coalesced_edge_preserves_pending_load(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %loaded = global_load_b32_saddr %address, %base
  low.br ^join(%loaded: reg<amdgpu.vgpr>)
^join(%joined: reg<amdgpu.vgpr>):
  %used = v_add_u32 %joined, %address
  return
}

// A coalesced edge performs no read and establishes no completion. Its
// successor still waits before consuming the pending load result.
// ----
  global_load_b32 v1, v0, s[0:1] offset:0
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v1, v0
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @packed_edge_preserves_coalesced_counter amdgpu.vgpr=9

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @packed_edge_preserves_coalesced_counter(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %local = ds_read_b32 %address
  %global = global_load_b32_saddr %address, %base
  %pair = concat(%local, %global) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^join(%pair: reg<amdgpu.vgpr x2>)
^join(%joined: reg<amdgpu.vgpr x2>):
  %first = slice %joined[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %used = v_add_u32 %first, %address
  %second = slice %joined[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %second_used = v_add_u32 %second, %address
  return
}

// Packing the global result cannot retire the independently pending LDS
// result forwarded into the first component.
// ----
  global_load_b32 v3, v0, s[0:1] offset:0
  ds_read_b32 v2, v0 offset:0
.Lbb1:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v1, v2, v0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v3, v0
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @successor_argument_reuses_store_base amdgpu.sgpr=6

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @successor_argument_reuses_store_base(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %store_base: reg<amdgpu.sgpr x2>, %first_base: reg<amdgpu.sgpr x2>, %second_base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) asm {
  global_store_b32_saddr %address, %value, %store_base
  low.cond_br %condition, ^first, ^second : reg<amdgpu.scc>
^first:
  low.br ^consume(%first_base: reg<amdgpu.sgpr x2>)
^second:
  low.br ^consume(%second_base: reg<amdgpu.sgpr x2>)
^consume(%joined_base: reg<amdgpu.sgpr x2>):
  global_store_b32_saddr %address, %value, %joined_base {offset = 4}
  global_store_b32_saddr %address, %value, %first_base {offset = 8}
  global_store_b32_saddr %address, %value, %second_base {offset = 12}
  return
}

// A successor argument has no defining schedule node. Its allocation reuses
// an earlier store's captured scalar pair across a diamond. Both incoming pairs
// remain live at the join, so neither can alias the argument. Edge copies can
// reuse the captured pair; stores still complete before termination.
// ----
  global_store_b32 v0, v1, s[0:1] offset:0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_mov_b32 s0, s2
  s_mov_b32 s1, s3
  s_branch .Lbb3
.Lbb2:
  s_mov_b32 s0, s4
  s_mov_b32 s1, s5
.Lbb3:
  global_store_b32 v0, v1, s[0:1] offset:4
  global_store_b32 v0, v1, s[2:3] offset:8
  global_store_b32 v0, v1, s[4:5] offset:12
  s_waitcnt_vscnt vscnt(0)
  s_endpgm
