// ====

// SCC truth is converted to an execution mask before vector construction.
amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @condition_predicate() -> (reg<amdgpu.scc>) asm {
  %word = s_mov_b32 1
  %truth = s_cmp_lg_i32_src1_inline %word {rhs = 0}
  return %truth
}

func.def target(@target) @construct_condition_predicates() -> (vector<1xi1>, vector<3xi1>) {
  %truth = low.invoke @condition_predicate() : () -> (i1)
  %constructed = vector.from_elements %truth : vector<1xi1>
  %splat = vector.splat %truth : vector<3xi1>
  func.return %constructed, %splat : vector<1xi1>, vector<3xi1>
}

