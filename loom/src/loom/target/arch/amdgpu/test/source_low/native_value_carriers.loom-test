  %18 = s_mov_b64_exec_read
  %19 = slice %18[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = slice %18[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = s_mov_b32 0
  %22 = s_cselect_b32 %19, %21, %truth
  %23 = s_cselect_b32 %20, %21, %truth
  %24 = concat(%22, %23) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %splat = concat(%24, %24, %24) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x6>
