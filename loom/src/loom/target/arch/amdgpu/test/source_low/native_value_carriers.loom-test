// ====

amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @scalar_predicate() -> (reg<amdgpu.sgpr>) asm {
  %truth = s_mov_b32 1
  return %truth
}

low.func.def target<amdgpu.rdna3.core>(@target) @lane_predicate() -> (reg<amdgpu.sgpr x2>) asm {
  %mask = s_mov_b64_exec_read
  return %mask
}

func.def target(@target) @construct_native_predicates() -> (vector<3xi1>, vector<3xi1>) {
  %truth = low.invoke @scalar_predicate() : () -> (i1)
  %mask = low.invoke @lane_predicate() : () -> (i1)
  %constructed = vector.from_elements %truth, %mask, %truth : vector<3xi1>
  %splat = vector.splat %truth : vector<3xi1>
  func.return %constructed, %splat : vector<3xi1>, vector<3xi1>
}

// ----
amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @scalar_predicate() -> (reg<amdgpu.sgpr>) asm {
  %truth = s_mov_b32 1
  return %truth
}

low.func.def target<amdgpu.rdna3.core>(@target) @lane_predicate() -> (reg<amdgpu.sgpr x2>) asm {
  %mask = s_mov_b64_exec_read
  return %mask
}

low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @construct_native_predicates() -> (reg<amdgpu.sgpr x6>, reg<amdgpu.sgpr x6>) asm {
  %truth = low.func.call @scalar_predicate() : () -> (reg<amdgpu.sgpr>)
  %mask = low.func.call @lane_predicate() : () -> (reg<amdgpu.sgpr x2>)
  %14 = s_cmp_lg_i32_src1_inline %truth {rhs = 0}
  %15 = s_mov_b64_exec_read
  %16 = slice %15[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = slice %15[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = s_mov_b32 0
  %19 = s_cselect_b32 %16, %18, %14
  %20 = s_cselect_b32 %17, %18, %14
  %21 = concat(%19, %20) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %constructed = concat(%21, %mask, %21) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x6>
  %23 = s_cmp_lg_i32_src1_inline %truth {rhs = 0}
  %24 = s_mov_b64_exec_read
  %25 = slice %24[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = slice %24[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = s_mov_b32 0
  %28 = s_cselect_b32 %25, %27, %23
  %29 = s_cselect_b32 %26, %27, %23
  %30 = concat(%28, %29) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %splat = concat(%30, %30, %30) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x6>
  return %constructed, %splat
}

// ====

// Numeric native results keep their declared bank across logical types.
// Payload word counts still come from the logical scalar or packed-vector type.
amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @native_1() -> (reg<amdgpu.sgpr>) asm {
  %word = s_mov_b32 305430657
  return %word
}

low.func.def target<amdgpu.rdna3.core>(@target) @native_2() -> (reg<amdgpu.sgpr x2>) asm {
  %word = s_mov_b32 305430657
  %result = concat(%word, %word) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result
}

low.func.def target<amdgpu.rdna3.core>(@target) @native_3() -> (reg<amdgpu.sgpr x3>) asm {
  %word = s_mov_b32 305430657
  %result = concat(%word, %word, %word) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x3>
  return %result
}

low.func.def target<amdgpu.rdna3.core>(@target) @native_6() -> (reg<amdgpu.sgpr x6>) asm {
  %word = s_mov_b32 305430657
  %result = concat(%word, %word, %word, %word, %word, %word) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x6>
  return %result
}

func.def target(@target) @sgpr_payloads() -> (i8, i16, i32, i64, f8E4M3, f8E5M2, bf16, f16, f32, f64, vector<3xi8>, vector<3xi16>, vector<3xi32>, vector<3xf64>) {
  %byte = low.invoke @native_1() : () -> (i8)
  %half = low.invoke @native_1() : () -> (i16)
  %word = low.invoke @native_1() : () -> (i32)
  %double_word = low.invoke @native_2() : () -> (i64)
  %e4 = low.invoke @native_1() : () -> (f8E4M3)
  %e5 = low.invoke @native_1() : () -> (f8E5M2)
  %brain = low.invoke @native_1() : () -> (bf16)
  %float_half = low.invoke @native_1() : () -> (f16)
  %float_word = low.invoke @native_1() : () -> (f32)
  %float_double = low.invoke @native_2() : () -> (f64)
  %packed_bytes = low.invoke @native_1() : () -> (vector<3xi8>)
  %packed_halves = low.invoke @native_2() : () -> (vector<3xi16>)
  %words = low.invoke @native_3() : () -> (vector<3xi32>)
  %doubles = low.invoke @native_6() : () -> (vector<3xf64>)
  func.return %byte, %half, %word, %double_word, %e4, %e5, %brain, %float_half, %float_word, %float_double, %packed_bytes, %packed_halves, %words, %doubles : i8, i16, i32, i64, f8E4M3, f8E5M2, bf16, f16, f32, f64, vector<3xi8>, vector<3xi16>, vector<3xi32>, vector<3xf64>
}

