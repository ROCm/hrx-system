// RUN: pass source-to-low,low-dce

// A native carrier promises the declared low payload bits. Signed and unsigned
// consumers must normalize those bits in the selected result bank.

amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @sgpr_i8_bits() -> (reg<amdgpu.sgpr>) asm {
  %bits = s_mov_b32 305430657
  return %bits
}

func.def target(@target) @sgpr_i8_extensions() -> (i16, i32, i64, i16, i32, i64) {
  %input = low.invoke @sgpr_i8_bits() : () -> (i8)
  %signed_i16 = scalar.extsi %input : i8 to i16
  %signed_i32 = scalar.extsi %input : i8 to i32
  %signed_i64 = scalar.extsi %input : i8 to i64
  %unsigned_i16 = scalar.extui %input : i8 to i16
  %unsigned_i32 = scalar.extui %input : i8 to i32
  %unsigned_i64 = scalar.extui %input : i8 to i64
  func.return %signed_i16, %signed_i32, %signed_i64, %unsigned_i16, %unsigned_i32, %unsigned_i64 : i16, i32, i64, i16, i32, i64
}

// ----
amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @sgpr_i8_bits() -> (reg<amdgpu.sgpr>) asm {
  %bits = s_mov_b32 305430657
  return %bits
}

low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @sgpr_i8_extensions() -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) asm {
  %input = low.func.call @sgpr_i8_bits() : () -> (reg<amdgpu.sgpr>)
  %22 = v_mov_b32_copy %input
  %signed_i16 = v_bfe_i32_offset_width_inline %22 {offset = 0, width = 8}
  %signed_i32 = s_bfe_i32_lit %input, 524288
  %25 = s_bfe_i32_lit %input, 524288
  %26 = s_ashr_i32_rhs_inline %25, 31
  %signed_i64 = concat(%25, %26) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %28 = v_mov_b32_copy %input
  %unsigned_i16 = v_and_b32_lit %28, 255
  %unsigned_i32 = s_bfe_u32_lit %input, 524288
  %31 = s_bfe_u32_lit %input, 524288
  %32 = s_mov_b32 0
  %unsigned_i64 = concat(%31, %32) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %signed_i16, %signed_i32, %signed_i64, %unsigned_i16, %unsigned_i32, %unsigned_i64
}

