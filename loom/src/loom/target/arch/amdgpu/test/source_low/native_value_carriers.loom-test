  %signed_i64 = concat(%24, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %unsigned_i16 = v_and_b32_lit %input, 255
  %unsigned_i32 = v_and_b32_lit %input, 255
  %29 = v_and_b32_lit %input, 255
  %30 = v_mov_b32 0
  %unsigned_i64 = concat(%29, %30) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %signed_i16, %signed_i32, %signed_i64, %unsigned_i16, %unsigned_i32, %unsigned_i64
