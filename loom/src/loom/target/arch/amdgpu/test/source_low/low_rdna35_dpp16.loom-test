// RUN: emit amdgpu-assembly @gfx1151_dpp16_uniform_rhs waits=none

amdgpu.target<gfx1151> @target
low.func.def target<amdgpu.rdna3_5.core>(@target) @gfx1151_dpp16_uniform_rhs(%crosslane: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.sgpr>) asm {
  %add_sgpr = v_add_f32_dpp16_sgpr %crosslane, %rhs {dpp_ctrl = 177}
  %add_inline = v_add_f32_dpp16_src1_inline %add_sgpr {rhs = 1065353216, dpp_ctrl = 177}
  %sub_sgpr = v_sub_f32_dpp16_sgpr %add_inline, %rhs {dpp_ctrl = 78}
  %sub_inline = v_sub_f32_dpp16_src1_inline %sub_sgpr {rhs = 1073741824, dpp_ctrl = 78}
  %mul_sgpr = v_mul_f32_dpp16_sgpr %sub_inline, %rhs {dpp_ctrl = 177}
  %mul_inline = v_mul_f32_dpp16_src1_inline %mul_sgpr {rhs = 1056964608, dpp_ctrl = 177}
  %min_sgpr = v_min_f32_dpp16_sgpr %mul_inline, %rhs {dpp_ctrl = 78}
  %min_inline = v_min_f32_dpp16_src1_inline %min_sgpr {rhs = 3212836864, dpp_ctrl = 78}
  %max_sgpr = v_max_f32_dpp16_sgpr %min_inline, %rhs {dpp_ctrl = 177}
  %max_inline = v_max_f32_dpp16_src1_inline %max_sgpr {rhs = 1082130432, dpp_ctrl = 177}
  return
}

