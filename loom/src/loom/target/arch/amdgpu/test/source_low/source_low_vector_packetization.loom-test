low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @vector_extf_f16x34_load_store() asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 68} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 136} : reg<amdgpu.sgpr x2>
  %27 = s_mov_b32 0
  %28 = s_mov_b32 32
  %29 = s_mov_b32 4
  low.br ^_bb1(%27: reg<amdgpu.sgpr>)
^_bb1(%24: reg<amdgpu.sgpr>):
  %30 = s_cmp_lt_i32 %24, %28
  low.cond_br %30, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %31 = v_mov_b32 0
  %55 = s_lshl_b32_rhs_inline %24, 1
  %56 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %57 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %59 = s_add_u32 %56, %55
  %60 = s_addc_u32 %57, %27
  %61 = concat(%59, %60) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %33 = global_load_b64_saddr %31, %61
  %34 = slice %33[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %35 = v_cvt_f32_f16 %34
  %37 = v_lshrrev_b32_src0_inline %34, 16
  %38 = v_cvt_f32_f16 %37
  %39 = slice %33[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %40 = v_cvt_f32_f16 %39
  %42 = v_lshrrev_b32_src0_inline %39, 16
  %43 = v_cvt_f32_f16 %42
  %44 = concat(%35, %38, %40, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %62 = s_lshl_b32_rhs_inline %24, 2
  %63 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %64 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %66 = s_add_u32 %63, %62
  %67 = s_addc_u32 %64, %27
  %68 = concat(%66, %67) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %31, %44, %68
  %47 = s_add_u32 %24, %29
  low.br ^_bb1(%47: reg<amdgpu.sgpr>)
^_bb3:
  %48 = v_mov_b32 0
  %49 = global_load_b32_saddr %48, %input_view {offset = 64}
  %50 = v_cvt_f32_f16 %49
  %51 = v_lshrrev_b32_src0_inline %49, 16
  %52 = v_cvt_f32_f16 %51
  %53 = concat(%50, %52) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %48, %53, %output_view {offset = 128}
