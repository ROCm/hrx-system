low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @vector_extf_f16x34_load_store() asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 68} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 136} : reg<amdgpu.sgpr x2>
  %27 = s_mov_b32 0
  %28 = s_mov_b32 32
  %29 = s_mov_b32 4
  low.br ^_bb1(%27: reg<amdgpu.sgpr>)
^_bb1(%24: reg<amdgpu.sgpr>):
  %30 = s_cmp_lt_i32 %24, %28
  low.cond_br %30, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %31 = v_mov_b32 0
  %32 = s_lshl_b32_rhs_inline %24, 1
  %33 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = s_add_u32 %33, %32
  %37 = s_addc_u32 %34, %27
  %38 = concat(%36, %37) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %39 = global_load_b64_saddr %31, %38
  %40 = slice %39[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %41 = v_cvt_f32_f16 %40
  %43 = v_lshrrev_b32_src0_inline %40, 16
  %44 = v_cvt_f32_f16 %43
  %45 = slice %39[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %46 = v_cvt_f32_f16 %45
  %48 = v_lshrrev_b32_src0_inline %45, 16
  %49 = v_cvt_f32_f16 %48
  %50 = concat(%41, %44, %46, %49) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %52 = s_lshl_b32_rhs_inline %24, 2
  %53 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %56 = s_add_u32 %53, %52
  %57 = s_addc_u32 %54, %27
  %58 = concat(%56, %57) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %31, %50, %58
  %59 = s_add_u32 %24, %29
  low.br ^_bb1(%59: reg<amdgpu.sgpr>)
^_bb3:
  %60 = v_mov_b32 0
  %61 = global_load_b32_saddr %60, %input_view {offset = 64}
  %62 = v_cvt_f32_f16 %61
  %63 = v_lshrrev_b32_src0_inline %61, 16
  %64 = v_cvt_f32_f16 %63
  %65 = concat(%62, %64) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %60, %65, %output_view {offset = 128}
