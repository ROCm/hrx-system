// RUN: emit amdgpu-assembly @buffer_base_capture

// The next descriptor overwrites the first load's base before either result
// completes. Both result tuples still require completion before returning.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @buffer_base_capture(%base: reg<amdgpu.sgpr x2>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %base_low = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_high = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %bound = s_mov_b32 1024
  %format = s_mov_b32 822173696
  %resource = concat(%base, %bound, %format) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %step = s_mov_b32 16
  %zero = s_mov_b32 0
  %first = buffer_load_b128 %resource, %address, %offset
  %next_low, %carry = s_add_co_u32 %base_low, %step
  %next_high, %next_carry = s_addc_u32 %base_high, %zero, %carry
  %next_resource = concat(%next_low, %next_high, %bound, %format) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %second = buffer_load_b128 %next_resource, %address, %offset
  return %first, %second
}

// ----
  s_mov_b32 s2, 16
  s_add_u32 s8, s0, s2
  s_mov_b32 s2, 0
  s_addc_u32 s9, s1, s2
  s_mov_b32 s10, 1024
  s_mov_b32 s11, 822173696
  s_mov_b32 s2, s10
  s_mov_b32 s3, s11
  buffer_load_b128 v[4:7], v0, s[0:3], s4 offen offset:0
  buffer_load_b128 v[0:3], v0, s[8:11], s4 offen offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @buffer_bound_capture

// Changing the bound affects the second load, not the outstanding first load.
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @buffer_bound_capture(%base: reg<amdgpu.sgpr x2>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %bound = s_mov_b32 1024
  %format = s_mov_b32 822173696
  %resource = concat(%base, %bound, %format) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %first = buffer_load_b64 %resource, %address, %offset
  %next_bound = s_mov_b32 0
  %next_resource = concat(%base, %next_bound, %format) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %second = buffer_load_b64 %next_resource, %address, %offset
  return %first, %second
}

// ----
  s_mov_b32 s3, 822173696
  s_mov_b32 s2, 1024
  s_mov_b32 s10, 0
  buffer_load_b64 v[2:3], v0, s[0:3], s4 offen offset:0
  s_mov_b32 s8, s0
  s_mov_b32 s9, s1
  s_mov_b32 s11, s3
  buffer_load_b64 v[0:1], v0, s[8:11], s4 offen offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @buffer_offset_capture

// The generic gfx11 contract also captures SOFFSET independently of the result.
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @buffer_offset_capture(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = buffer_load_dword %resource, %address, %offset
  %next_offset = s_add_u32_rhs_inline %offset, 4
  %second = buffer_load_dword %resource, %address, %next_offset
  return %first, %second
}

// ----
  s_add_u32 s1, s0, 4
  buffer_load_dword v1, v0, s[4:7], s0 offen offset:0
  buffer_load_dword v0, v0, s[4:7], s1 offen offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @buffer_narrow_capture

// Narrow loads share scalar capture, but storing their result still waits for it.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @buffer_narrow_capture(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>, %output: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = buffer_load_u8 %resource, %address, %offset
  %next_offset = s_add_u32_rhs_inline %offset, 1
  global_store_b32_saddr %address, %loaded, %output
  return %next_offset
}

// ----
  buffer_load_ubyte v1, v0, s[0:3], s4 offen offset:0
  s_add_u32 s0, s4, 1
  s_waitcnt vmcnt(0) lgkmcnt(63)
  global_store_b32 v0, v1, s[6:7] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @buffer_tied_half_capture

// The tied low half remains intact while the high half loads. Capturing the
// scalar offset does not make the high-half result ready for its consumer.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @buffer_tied_half_capture(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>, %low_half: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = buffer_load_d16_hi_b16 %low_half, %resource, %address, %offset
  %next_offset = s_add_u32_rhs_inline %offset, 2
  global_store_b32_saddr %address, %loaded, %output
  return %next_offset
}

// ----
  buffer_load_short_d16_hi v0, v1, s[0:3], s4 offen offset:0
  s_add_u32 s0, s4, 2
  s_waitcnt vmcnt(0) lgkmcnt(63)
  global_store_b32 v1, v0, s[6:7] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @buffer_result_overwrite_waits

// Result storage is still owned by the outstanding load, even if its SSA value
// is unused. Reusing that VGPR must wait before issuing the replacement write.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @buffer_result_overwrite_waits(%resource: reg<amdgpu.sgpr x4>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = buffer_load_dword_off_zero %resource
  %replacement = v_mov_b32 42
  return %replacement
}

// ----
  buffer_load_dword v0, off, s[0:3], 0 offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_mov_b32 v0, 42
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @buffer_store_source_lifetime

// Store scalar inputs are captured before memory completion too. The store
// itself still completes before termination.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @buffer_store_source_lifetime(%resource: reg<amdgpu.sgpr x4>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>) asm {
  buffer_store_dword_off_zero %value, %resource
  %replacement = s_mov_b32 0
  return %replacement
}

// ----
  buffer_store_dword v0, off, s[0:3], 0 offset:0
  s_mov_b32 s0, 0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm
