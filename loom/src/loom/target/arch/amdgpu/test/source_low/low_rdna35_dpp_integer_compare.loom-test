// RUN: emit amdgpu-assembly @gfx1170_dpp_integer_compare waits=none

amdgpu.target<gfx1170> @target
low.func.def target<amdgpu.rdna4m.core>(@target) @gfx1170_dpp_integer_compare(%crosslane: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.sgpr>) asm {
  %minimum = v_min_i32_dpp8_sgpr %crosslane, %rhs {dpp8 = 342391}
  %mask = v_cmp_ge_u32_dpp16_src1_inline %minimum {rhs = 42, dpp_ctrl = 27}
  return
}

