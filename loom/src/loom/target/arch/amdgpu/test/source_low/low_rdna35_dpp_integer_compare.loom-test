  v_min_i32_e64_dpp v0, v0, s0, dpp8:[7,6,5,4,3,2,1,0]
  v_cmp_ge_u32_e64_dpp s[0:1], v0, 42, quad_perm:[3,2,1,0], row_mask:0xf, bank_mask:0xf, bound_ctrl:1
