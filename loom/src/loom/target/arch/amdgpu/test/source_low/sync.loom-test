// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @workgroup_barrier() {
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @workgroup_barrier() asm {
  s_barrier
  return
}

