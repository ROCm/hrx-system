low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @smfmac_fp8_compact_lhs_memory() asm {
  %26 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %rhs_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 1024} : reg<amdgpu.sgpr x2>
  %out_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 1024} : reg<amdgpu.sgpr x2>
  %metadata = v_mov_b32 1145324612
  %31 = v_and_b32_src0_inline %26, 15
  %32 = v_lshlrev_b32_src0_inline %31, 5
  %33 = v_lshrrev_b32_src0_inline %26, 4
  %34 = v_lshlrev_b32_src0_inline %33, 3
  %35 = v_add_u32 %32, %34
  %36 = s_mov_b32_m0_imm 0
  %lhs = global_load_dwordx2_saddr %35, %lhs_view, %36
  %38 = v_lshlrev_b32_src0_inline %31, 6
  %39 = v_lshlrev_b32_src0_inline %33, 4
  %40 = v_add_u32 %38, %39
  %41 = s_mov_b32_m0_imm 0
  %rhs = global_load_dwordx4_saddr %40, %rhs_view, %41
  %43 = v_mov_b32 0
  %init = concat(%43, %43, %43, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %48 = copy %init : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %result = v_smfmac_f32_16x16x64_bf8_fp8 %48, %lhs, %rhs, %metadata
  %50 = v_lshlrev_b32_src0_inline %31, 2
  %51 = v_lshlrev_b32_src0_inline %33, 8
  %52 = v_add_u32 %50, %51
  %53 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %54 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %52, %53, %out_view, %54
  %55 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %56 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %52, %55, %out_view, %56 {offset = 64}
  %57 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %58 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %52, %57, %out_view, %58 {offset = 128}
  %59 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %60 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %52, %59, %out_view, %60 {offset = 192}
  return
}

