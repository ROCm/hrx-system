low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @smfmac_fp8_compact_lhs_memory() asm {
  %26 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %rhs_view = resource<hal_binding> {extent = 1024, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %out_view = resource<hal_binding> {extent = 1024, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %metadata = v_mov_b32 1145324612
  %31 = v_and_b32_src0_inline %26, 15
  %32 = v_lshlrev_b32_src0_inline %31, 5
  %33 = v_lshrrev_b32_src0_inline %26, 4
  %34 = v_lshl_add_u32_shift_imm %33, %32, 3
  %lhs = global_load_dwordx2_saddr %34, %lhs_view
  %36 = v_lshlrev_b32_src0_inline %31, 6
  %37 = v_lshl_add_u32_shift_imm %33, %36, 4
  %rhs = global_load_dwordx4_saddr %37, %rhs_view
  %39 = v_mov_b32 0
  %init = concat(%39, %39, %39, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %44 = copy %init : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %result = v_smfmac_f32_16x16x64_bf8_fp8 %44, %lhs, %rhs, %metadata
  %46 = v_lshlrev_b32_src0_inline %31, 2
  %47 = v_lshl_add_u32_shift_imm %33, %46, 8
  %48 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %47, %48, %out_view
  %49 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %47, %49, %out_view {offset = 64}
  %50 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %47, %50, %out_view {offset = 128}
  %51 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %47, %51, %out_view {offset = 192}
  return
}

