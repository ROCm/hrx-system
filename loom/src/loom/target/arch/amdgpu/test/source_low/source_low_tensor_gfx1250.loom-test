  %scratch0 = buffer.alloca<workgroup> align(256) %bytes : buffer
  %dest0 = buffer.view %scratch0[%buffer_base] : buffer -> view<64x64xf32>
  %copy0 = kernel.async.tensor.load.to.lds %source to %dest0 using %descriptor {cache_scope = workgroup, cache_temporal = regular} : view<64x64xf32> to view<64x64xf32>, kernel.tensor.lds.descriptor -> kernel.async.token
