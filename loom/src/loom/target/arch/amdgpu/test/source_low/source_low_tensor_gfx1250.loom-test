amdgpu.target<gfx1250> @target
kernel.def target(@target) @tensor_load_two_stage_wait_depth() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer) {
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 16384 : offset
  %d0 = vector.constant 0 : vector<4xi32>
  %d1 = vector.constant 0 : vector<8xi32>
  %descriptor = kernel.tensor.lds.descriptor dgroups(%d0, %d1) : vector<4xi32>, vector<8xi32> -> kernel.tensor.lds.descriptor
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%buffer_base] : buffer -> view<64x64xf32>
  %scratch0 = buffer.alloca<workgroup> align(256) %bytes : buffer
  %dest0 = buffer.view %scratch0[%buffer_base] : buffer -> view<64x64xf32>
  %copy0 = kernel.async.tensor.load.to.lds %source to %dest0 using %descriptor {cache_scope = cu, cache_temporal = regular} : view<64x64xf32> to view<64x64xf32>, kernel.tensor.lds.descriptor -> kernel.async.token
  %group0 = kernel.async.group %copy0 : kernel.async.token -> kernel.async.group
  %scratch1 = buffer.alloca<workgroup> align(256) %bytes : buffer
  %dest1 = buffer.view %scratch1[%buffer_base] : buffer -> view<64x64xf32>
  %copy1 = kernel.async.tensor.load.to.lds %source to %dest1 using %descriptor {cache_scope = cu, cache_temporal = regular} : view<64x64xf32> to view<64x64xf32>, kernel.tensor.lds.descriptor -> kernel.async.token
  %group1 = kernel.async.group %copy1 : kernel.async.token -> kernel.async.group
  kernel.async.wait %group0 {newer_groups = 1} : kernel.async.group
  kernel.async.wait %group1 {newer_groups = 0} : kernel.async.group
  kernel.return
}

