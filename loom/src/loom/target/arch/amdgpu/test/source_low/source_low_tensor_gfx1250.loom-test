// RUN: emit source-low output=low

amdgpu.target<gfx1250> @target

kernel.def target(@target) @tensor_load_to_lds_d4() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer) {
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 16384 : offset
  %d0 = vector.splati 0 : vector<4xi32>
  %d1 = vector.splati 0 : vector<8xi32>
  %descriptor = kernel.tensor.lds.descriptor dgroups(%d0, %d1, %d0, %d0) : vector<4xi32>, vector<8xi32>, vector<4xi32>, vector<4xi32> -> kernel.tensor.lds.descriptor
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%buffer_base] : buffer -> view<64x64xf32>
  %scratch = buffer.alloca<workgroup> align(256) %bytes : buffer
  %dest = buffer.view %scratch[%buffer_base] : buffer -> view<64x64xf32>
  %copy = kernel.async.tensor.load.to.lds %source to %dest using %descriptor {cache_scope = workgroup, cache_temporal = regular} : view<64x64xf32> to view<64x64xf32>, kernel.tensor.lds.descriptor -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @tensor_load_to_lds_d4() asm {
  %15 = storage {byte_alignment = 256, byte_length = 16384} : low.storage<workgroup>
  %16 = v_mov_b32 0
  %31 = v_readfirstlane_b32 %16
  %33 = v_readfirstlane_b32 %16
  %35 = v_readfirstlane_b32 %16
  %37 = v_readfirstlane_b32 %16
  %38 = concat(%31, %33, %35, %37) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %40 = v_readfirstlane_b32 %16
  %42 = v_readfirstlane_b32 %16
  %44 = v_readfirstlane_b32 %16
  %46 = v_readfirstlane_b32 %16
  %48 = v_readfirstlane_b32 %16
  %50 = v_readfirstlane_b32 %16
  %52 = v_readfirstlane_b32 %16
  %54 = v_readfirstlane_b32 %16
  %55 = concat(%40, %42, %44, %46, %48, %50, %52, %54) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x8>
  %57 = v_readfirstlane_b32 %16
  %59 = v_readfirstlane_b32 %16
  %61 = v_readfirstlane_b32 %16
  %63 = v_readfirstlane_b32 %16
  %64 = concat(%57, %59, %61, %63) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %66 = v_readfirstlane_b32 %16
  %68 = v_readfirstlane_b32 %16
  %70 = v_readfirstlane_b32 %16
  %72 = v_readfirstlane_b32 %16
  %73 = concat(%66, %68, %70, %72) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  tensor_load_to_lds_d4 %38, %55, %64, %73
  s_wait_tensorcnt {tensorcnt = 0}
  return
}

