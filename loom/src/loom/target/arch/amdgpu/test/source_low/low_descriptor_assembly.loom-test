// RUN: emit amdgpu-assembly @rdna4_med3_numeric fixed=%a:physical_register:0:1 fixed=%b:physical_register:1:1 fixed=%c:physical_register:2:1 fixed=%result:physical_register:3:1 fixed=%addr:physical_register:4:1 fixed=%output:physical_register:0:2

amdgpu.target<gfx1200> @rdna4_target

