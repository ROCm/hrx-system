// RUN: emit amdgpu-assembly @vop3_lshl_add_shift_src2_literal

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vop3_lshl_add_shift_src2_literal(%addr: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %result = v_lshl_add_u32_shift_imm_src2_lit %value {shift = 4, imm32 = 1006648320}
  global_store_b32_saddr %addr, %result, %output
  return
}

// ----
  v_lshl_add_u32 v0, v0, 4, 0x3c003c00
  global_store_b32 v1, v0, s[0:1] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====

// LLVM MC encodes SRC1=4 in the middle VOP3 word. Keeping the native words
// here covers the descriptor-to-encoder path that assembly text cannot see.
// RUN: emit amdgpu-native-words @vop3_lshl_add_shift_src2_literal_native waits=none strategy=source fixed=%value:physical_register:11:1 fixed=%result:physical_register:13:1

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vop3_lshl_add_shift_src2_literal_native(%value: reg<amdgpu.vgpr>) asm {
  %result = v_lshl_add_u32_shift_imm_src2_lit %value {shift = 4, imm32 = 15360}
  return
}

// ----
0xD646000D
0x03FD090B
0x00003C00
0xBFB00000

// ====

// RUN: emit amdgpu-assembly @cdna3_med3_numeric fixed=%a:physical_register:0:1 fixed=%b:physical_register:1:1 fixed=%c:physical_register:2:1 fixed=%result:physical_register:3:1 fixed=%addr:physical_register:4:1 fixed=%output:physical_register:0:2

amdgpu.target<gfx942> @cdna3_target

low.func.def target<amdgpu.cdna3.core>(@cdna3_target) @cdna3_med3_numeric(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %addr: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %result = v_med3_f32 %a, %b, %c
  %m0 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %addr, %result, %output, %m0
  return
}

// ----
  v_med3_f32 v3, v0, v1, v2
  s_mov_b32 m0, 0
  global_store_dword v4, v3, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

