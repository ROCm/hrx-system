// RUN: emit source-low target=amdgpu:gfx942 output=low

// A later potentially aliasing write does not change entry contents.
kernel.def @read_before_write() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<4xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<4xi32>
  %values = vector.load %source[0] : view<4xi32> -> vector<4xi32>
  vector.store %values, %destination[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @read_before_write() asm {
  %source = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %9 = s_mov_b32 0
  %values = s_load_dwordx4 %source, %9
  %11 = slice %values[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %12 = v_mov_b32_copy %11
  %13 = slice %values[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %14 = v_mov_b32_copy %13
  %15 = slice %values[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %15
  %17 = slice %values[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %17
  %19 = concat(%12, %14, %16, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %20 = v_mov_b32 0
  global_store_dwordx4_saddr %20, %19, %destination
  return
}

// ====

// An earlier write may alias the input even when its root is a different SSA value.
kernel.def @read_after_write() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<2xi32>
  %replacement = scalar.constant 7 : i32
  view.store %replacement, %destination[0] : i32, view<2xi32>
  %value = view.load %source[0] : view<1xi32> -> i32
  view.store %value, %destination[1] : i32, view<2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @read_after_write() asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 7
  %12 = v_mov_b32 0
  global_store_dword_saddr %12, %11, %destination
  %value = global_load_dword_saddr %12, %source : reg<amdgpu.vgpr>
  global_store_dword_saddr %12, %value, %destination {offset = 4}
  return
}

// ====

// A volatile read retains workitem observations even for a uniform address.
kernel.def @volatile_entry_read() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %source_buffer, %destination_buffer = buffer.assume.noalias %input, %output : buffer, buffer
  %origin = index.constant 0 : offset
  %source = buffer.view %source_buffer[%origin] : buffer -> view<1xi32>
  %destination = buffer.view %destination_buffer[%origin] : buffer -> view<1xi32>
  %value = view.load<volatile> %source[0] : view<1xi32> -> i32
  view.store %value, %destination[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @volatile_entry_read() asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 0
  %value = global_load_dword_saddr<volatile> %11, %source : reg<amdgpu.vgpr>
  global_store_dword_saddr %11, %value, %destination
  return
}

// ====

// A device function has no dispatch boundary establishing coherent entry memory.
func.def device @callable_entry(%input: buffer) -> (i32) {
  %global = buffer.assume.memory_space<global> %input : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 4} : buffer
  %origin = index.constant 0 : offset
  %source = buffer.view %aligned[%origin] : buffer -> view<1xi32>
  %value = view.load %source[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def device target<amdgpu.cdna3.core> abi(hal_kernel) @callable_entry() -> (reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %9 = v_mov_b32 0
  %value = global_load_dword_saddr %9, %source : reg<amdgpu.vgpr>
  return %value
}

// ====

// The first iteration's entry load cannot stand in for later iterations.
kernel.def @loop_carried_memory() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %count: index) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<2xi32>
  %start = index.constant 0 : index
  %step = index.constant 1 : index
  %c1 = scalar.constant 1 : i32
  scf.for %i = [%start to %count step %step] {
    %value = view.load %source[0] : view<1xi32> -> i32
    %next = scalar.addi %value, %c1 : i32
    view.store %next, %destination[0] : i32, view<2xi32>
  }
  %last = view.load %source[0] : view<1xi32> -> i32
  view.store %last, %destination[1] : i32, view<2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "count"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @loop_carried_memory(%count: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %start = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^_bb1(%start: reg<amdgpu.sgpr>)
^_bb1(%i: reg<amdgpu.sgpr>):
  %25 = s_cmp_lt_i32 %i, %count
  low.cond_br %25, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %26 = v_mov_b32 0
  %value = global_load_dword_saddr %26, %source : reg<amdgpu.vgpr>
  %28 = v_mov_b32 1
  %next = v_add_u32 %value, %28
  global_store_dword_saddr %26, %next, %destination
  %31 = s_add_u32 %i, %step
  low.br ^_bb1(%31: reg<amdgpu.sgpr>)
^_bb3:
  %32 = v_mov_b32 0
  %last = global_load_dword_saddr %32, %source : reg<amdgpu.vgpr>
  global_store_dword_saddr %32, %last, %destination {offset = 4}
  return
}

// ====

// A backedge can carry a write to the next execution of the header load.
kernel.def @cfg_carried_memory() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %count: index) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<2xi32>
  %start = index.constant 0 : index
  %step = index.constant 1 : index
  cfg.br ^header(%start: index)
^header(%i: index):
  %value = view.load %source[0] : view<1xi32> -> i32
  %more = index.cmp ult, %i, %count : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %replacement = scalar.constant 7 : i32
  view.store %replacement, %destination[0] : i32, view<2xi32>
  %next = index.add %i, %step : index
  cfg.br ^header(%next: index)
^exit:
  view.store %value, %destination[1] : i32, view<2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "count"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @cfg_carried_memory(%count: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %start = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^header(%start: reg<amdgpu.sgpr>)
^header(%i: reg<amdgpu.sgpr>):
  %20 = v_mov_b32 0
  %value = global_load_dword_saddr %20, %source : reg<amdgpu.vgpr>
  %more = s_cmp_lt_u32 %i, %count
  low.cond_br %more, ^body, ^exit : reg<amdgpu.scc>
^body:
  %24 = v_mov_b32 7
  global_store_dword_saddr %20, %24, %destination
  %next = s_add_u32 %i, %step
  low.br ^header(%next: reg<amdgpu.sgpr>)
^exit:
  global_store_dword_saddr %20, %value, %destination {offset = 4}
  return
}

// ====

// A conditional write contributes to the prefix after reconvergence.
kernel.def @conditional_write() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %condition: i1) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<2xi32>
  %before = view.load %source[0] : view<1xi32> -> i32
  scf.if %condition {
    view.store %before, %destination[0] : i32, view<2xi32>
  }
  %after = view.load %source[0] : view<1xi32> -> i32
  view.store %after, %destination[1] : i32, view<2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "condition"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_payload_sizes = [1], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @conditional_write(%condition$9: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 8, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %condition$12 = s_bfe_u32_lit %condition$9, 524288
  %13 = s_mov_b32 0
  %before = s_load_dword %source, %13
  %16 = s_cmp_lg_i32 %condition$12, %13
  low.cond_br %16, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %17 = v_mov_b32_copy %before
  %18 = v_mov_b32 0
  global_store_dword_saddr %18, %17, %destination
  low.br ^_bb2
^_bb2:
  %19 = v_mov_b32 0
  %after = global_load_dword_saddr %19, %source : reg<amdgpu.vgpr>
  global_store_dword_saddr %19, %after, %destination {offset = 4}
  return
}
