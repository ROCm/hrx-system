// Matrix execution passes are independent of the accumulator footprint.
// RUN: emit amdgpu-assembly @cdna2_four_results_eight_passes

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_four_results_eight_passes(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %acc
  %lane = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %address, %lane, %base
  return
}

// ----
  v_mfma_f32_16x16x4f32 v[4:7], v0, v1, v[4:7]
  s_nop 10
  global_store_dword v2, v4, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

