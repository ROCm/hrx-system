low.func.def target<amdgpu.cdna4.core>(@target) @cdna4_narrow_sources_four_passes(%lhs: reg<amdgpu.vgpr x6>, %rhs: reg<amdgpu.vgpr x4>, %acc: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %result = v_mfma_f32_16x16x128_f8f6f4_f6_f4 %lhs, %rhs, %acc {matrix_a_fmt = "fp6", matrix_b_fmt = "fp4"}
  %lane = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %address, %lane, %base
  return
}

