// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @i32_bitfield_extractu(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %loaded = vector.load %input_view[0] : view<1xi32> -> vector<1xi32>
  %nibble = vector.bitfield.extractu %loaded {offset = 4, width = 4} : vector<1xi32> -> vector<1xi32>
  vector.store %nibble, %output_view[0] : vector<1xi32>, view<1xi32>
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i32_bitfield_extractu() asm {
  %input_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %9 = v_mov_b32 0
  %loaded = global_load_b32_saddr %9, %input_view
  %nibble = v_bfe_u32_offset_width_inline %loaded {offset = 4, width = 4}
  global_store_b32_saddr %9, %nibble, %output_view
  return
}

