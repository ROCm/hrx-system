// ====

func.def @i32_bitfield_b128_shape(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<4xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %low = vector.bitfield.extractu %loaded {offset = 0, width = 4} : vector<4xi32> -> vector<4xi32>
  %high = vector.bitfield.extractu %loaded {offset = 4, width = 2} : vector<4xi32> -> vector<4xi32>
  %merged = vector.bitfield.insert %high into %low {offset = 4, width = 2} : vector<4xi32>, vector<4xi32>
  %bias_scalar = scalar.constant 32 : i32
  %bias = vector.splat %bias_scalar : vector<4xi32>
  %result = vector.subi %merged, %bias : vector<4xi32>
  vector.store %result, %output_view[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i32_bitfield_b128_shape() asm {
  %input_view = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = v_mov_b32 0
  %loaded = global_load_b128_saddr %14, %input_view
  %16 = slice %loaded[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = v_and_b32_src0_inline %16, 15
  %18 = slice %loaded[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %19 = v_and_b32_src0_inline %18, 15
  %20 = slice %loaded[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = v_and_b32_src0_inline %20, 15
  %22 = slice %loaded[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %23 = v_and_b32_src0_inline %22, 15
  %26 = v_bfe_u32_offset_width_inline %16 {offset = 4, width = 2}
  %28 = v_bfe_u32_offset_width_inline %18 {offset = 4, width = 2}
  %30 = v_bfe_u32_offset_width_inline %20 {offset = 4, width = 2}
  %32 = v_bfe_u32_offset_width_inline %22 {offset = 4, width = 2}
  %35 = v_lshlrev_b32_src0_inline %26, 4
  %37 = v_bfi_b32_src0_lit %35, %17, 48
  %39 = v_lshlrev_b32_src0_inline %28, 4
  %41 = v_bfi_b32_src0_lit %39, %19, 48
  %43 = v_lshlrev_b32_src0_inline %30, 4
  %45 = v_bfi_b32_src0_lit %43, %21, 48
  %47 = v_lshlrev_b32_src0_inline %32, 4
  %49 = v_bfi_b32_src0_lit %47, %23, 48
  %51 = v_mov_b32 32
  %58 = v_sub_nc_u32 %37, %51
  %61 = v_sub_nc_u32 %41, %51
  %64 = v_sub_nc_u32 %45, %51
  %67 = v_sub_nc_u32 %49, %51
  %result = concat(%58, %61, %64, %67) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %14, %result, %output_view
  return
}
