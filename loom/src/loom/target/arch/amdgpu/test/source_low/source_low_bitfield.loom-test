  %base = global_load_b32_saddr %13, %base_view
  %17 = v_lshlrev_b32_src0_inline %field, 8
  %inserted = v_bfi_b32_src0_lit %17, %base, 3840
  global_store_b32_saddr %13, %inserted, %output_view
