// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @fma_multiplicand_accumulator(%multiplicand: f32, %multiplier: vector<4xf32>, %accumulator: f32) -> (vector<4xf32>) {
  %multiplicand_lanes = vector.splat %multiplicand : vector<4xf32>
  %accumulator_lanes = vector.splat %accumulator : vector<4xf32>
  %result = vector.fmaf %multiplicand_lanes, %multiplier, %accumulator_lanes : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @fma_multiplicand_accumulator(%multiplicand: reg<amdgpu.vgpr>, %multiplier: reg<amdgpu.vgpr x4>, %accumulator: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %11 = slice %multiplier[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %12 = v_pk_fma_f32.broadcast_a_c %multiplicand, %11, %accumulator
  %13 = slice %multiplier[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %14 = v_pk_fma_f32.broadcast_a_c %multiplicand, %13, %accumulator
  %result = concat(%12, %14) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

kernel.def @uniform_fma() {
  %c1 = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %parameters {minimum_alignment = 64} : buffer
  %scalars, %source, %destination = buffer.assume.noalias %aligned, %input, %output : buffer, buffer, buffer
  %offset = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %scalar_view = buffer.view %scalars[%offset] : buffer -> view<3xf32>
  %source_view = buffer.view %source[%offset] : buffer -> view<64x24xf32>
  %multiplicand = view.load %scalar_view[0] : view<3xf32> -> f32
  %multiplicand_lanes = vector.splat %multiplicand : vector<8xf32>
  %multiplier_lanes = vector.load %source_view[%lane, 8] : view<64x24xf32> -> vector<8xf32>
  %accumulator = view.load %scalar_view[2] : view<3xf32> -> f32
  %accumulator_lanes = vector.splat %accumulator : vector<8xf32>
  %result = vector.fmaf %multiplicand_lanes, %multiplier_lanes, %accumulator_lanes : vector<8xf32>
  %output_view = buffer.view %destination[%offset] : buffer -> view<64x8xf32>
  vector.store %result, %output_view[%lane, 0] : vector<8xf32>, view<64x8xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_fma() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %scalar_view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %source_view = resource<hal_binding> {extent = 6144, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 2048, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %34 = s_mov_b32 0
  %multiplicand = s_load_dword %scalar_view, %34
  %accumulator = s_load_dword %scalar_view, %34 {offset = 8}
  %38 = v_mov_b32 96
  %39 = v_mul_lo_u32 %lane, %38
  %40 = global_load_dwordx4_saddr %39, %source_view {offset = 32} : reg<amdgpu.vgpr x4>
  %41 = global_load_dwordx4_saddr %39, %source_view {offset = 48} : reg<amdgpu.vgpr x4>
  %43 = v_mov_b32_copy %accumulator
  %61 = slice %40[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %45 = v_pk_fma_f32.broadcast_a_c %multiplicand, %61, %43
  %60 = slice %40[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %47 = v_pk_fma_f32.broadcast_a_c %multiplicand, %60, %43
  %59 = slice %41[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %49 = v_pk_fma_f32.broadcast_a_c %multiplicand, %59, %43
  %58 = slice %41[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %51 = v_pk_fma_f32.broadcast_a_c %multiplicand, %58, %43
  %57 = concat(%45, %47) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %54 = v_lshlrev_b32_src0_inline %lane, 5
  global_store_dwordx4_saddr %54, %57, %output_view
  %56 = concat(%49, %51) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  global_store_dwordx4_saddr %54, %56, %output_view {offset = 16}
  return
}
