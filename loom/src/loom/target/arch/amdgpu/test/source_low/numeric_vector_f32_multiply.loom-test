// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_vector_f32_multiply.loom-test
// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @multiply3(%left: vector<3xf32>, %right: vector<3xf32>) -> (vector<3xf32>) {
  %product = vector.mulf %left, %right : vector<3xf32>
  func.return %product : vector<3xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @multiply3(%left: reg<amdgpu.vgpr x3>, %right: reg<amdgpu.vgpr x3>) -> (reg<amdgpu.vgpr x3>) asm {
  %7 = slice %left[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %8 = slice %right[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %9 = v_mul_f32 %7, %8
  %10 = slice %left[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %11 = slice %right[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %12 = v_mul_f32 %10, %11
  %13 = slice %left[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %14 = slice %right[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %15 = v_mul_f32 %13, %14
  %product = concat(%9, %12, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  return %product
}

// ====

func.def @multiply16(%left: vector<16xf32>, %right: vector<16xf32>) -> (vector<16xf32>) {
  %product = vector.mulf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %left, %right : vector<16xf32>
  func.return %product : vector<16xf32>
}

