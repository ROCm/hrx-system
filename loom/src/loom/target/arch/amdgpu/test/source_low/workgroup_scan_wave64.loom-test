// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

kernel.def target(@target) @workgroup_scan_wave64_native_partitions() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %thread = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %value = view.load %input_view[%thread] : view<64xi32> -> i32
  %prefix = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : i32
  view.store %prefix, %output_view[%thread] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @workgroup_scan_wave64_native_partitions() asm {
  %thread = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_lshlrev_b32_src0_inline %thread, 2
  %value = global_load_b32_saddr %13, %input_view
  %15 = v_and_b32_src0_inline %thread, 31
  %16 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %17 = storage_address %16 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %18 = v_and_b32_lit %15, 4294967280
  %19 = v_and_b32_src0_inline %15, 15
  %20 = v_mov_b32 1
  %22 = v_cmp_ge_u32 %19, %20
  %23 = v_mov_b32 2
  %25 = v_cmp_ge_u32 %19, %23
  %26 = v_mov_b32 4
  %28 = v_cmp_ge_u32 %19, %26
  %29 = v_mov_b32 8
  %31 = v_cmp_ge_u32 %19, %29
  %32 = v_mov_b32 16
  %33 = v_sub_nc_u32 %18, %32
  %34 = v_cmp_ge_u32 %18, %32
  %35 = v_lshlrev_b32_src0_inline %33, 2
  %37 = v_sub_nc_u32 %15, %20
  %38 = v_cmp_ge_u32 %15, %20
  %39 = v_lshlrev_b32_src0_inline %37, 2
  %40 = v_mov_b32_dpp16 %value {dpp_ctrl = 273}
  %41 = v_add_u32 %value, %40
  %42 = v_cndmask_b32 %value, %41, %22
  %43 = v_mov_b32_dpp16 %42 {dpp_ctrl = 274}
  %44 = v_add_u32 %42, %43
  %45 = v_cndmask_b32 %42, %44, %25
  %46 = v_mov_b32_dpp16 %45 {dpp_ctrl = 276}
  %47 = v_add_u32 %45, %46
  %48 = v_cndmask_b32 %45, %47, %28
  %49 = v_mov_b32_dpp16 %48 {dpp_ctrl = 280}
  %50 = v_add_u32 %48, %49
  %51 = v_cndmask_b32 %48, %50, %31
  %52 = ds_bpermute_b32 %35, %51 {offset = 60}
  %53 = v_add_u32 %51, %52
  %54 = v_cndmask_b32 %51, %53, %34
  %55 = ds_bpermute_b32 %39, %54
  %56 = v_mov_b32 0
  %57 = v_cndmask_b32 %56, %55, %38
  %58 = v_lshrrev_b32_src0_inline %thread, 5
  %59 = v_lshlrev_b32_src0_inline %58, 2
  %60 = v_mov_b32 31
  %61 = v_cmp_ge_u32 %15, %60
  %62, %63 = s_and_saveexec_b64 %61
  %64 = v_add_u32 %17, %59
  ds_write_b32 %64, %54
  s_mov_b64_exec %62
  s_barrier
  %65 = v_mov_b32 0
  %66 = v_add_u32 %17, %65
  %67 = ds_read_b32 %66
  %68 = v_mov_b32 32
  %69 = v_cmp_ge_u32 %thread, %68
  %70 = v_add_u32 %57, %67
  %prefix = v_cndmask_b32 %57, %70, %69
  %72 = v_lshlrev_b32_src0_inline %thread, 2
  global_store_b32_saddr %72, %prefix, %output_view
  return
}

// ====

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

// The final partition contains one input. Its inclusive total must reach the
// preceding partition without first combining with an empty exclusive prefix.
kernel.def target(@target) @workgroup_scan_reverse_partial_minimum() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 33 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %item = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<33xf32>
  %destination = buffer.view %output[%base] : buffer -> view<33xf32>
  %value = view.load %source[%item] : view<33xf32> -> f32
  %prefix = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = exclusive} : f32
  view.store %prefix, %destination[%item] : f32, view<33xf32>
  kernel.return
}

