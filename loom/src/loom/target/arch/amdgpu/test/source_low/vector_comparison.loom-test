func.def @floating_comparison_flags(%lhs: vector<2xf32>, %rhs: vector<2xf32>) -> (vector<2xi32>) {
  %mask = vector.cmpf<nnan|ninf> olt, %lhs, %rhs : vector<2xf32> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @floating_comparison_flags(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %13 = slice %lhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = slice %rhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = v_cmp_lt_f32 %13, %14
  %16 = slice %lhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %17 = slice %rhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = v_cmp_lt_f32 %16, %17
  %27 = v_cndmask_b32_src0_lit_src1_inline %15 {imm32 = 0, true_value = 1}
  %29 = v_cndmask_b32_src0_lit_src1_inline %18 {imm32 = 0, true_value = 1}
  %result = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}
