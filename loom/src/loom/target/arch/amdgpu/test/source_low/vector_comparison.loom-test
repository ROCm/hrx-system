func.def @wide_integer_comparison(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi32>) {
  %mask = vector.cmpi ugt, %lhs, %rhs : vector<2xi64> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @wide_integer_comparison(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %61 = slice %lhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %60 = slice %lhs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %59 = slice %rhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %58 = slice %rhs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %26 = v_cmp_gt_u32 %60, %58
  %27 = v_cmp_gt_u32 %61, %59
  %28 = v_cmp_eq_i32 %60, %58
  %29 = s_and_b64 %28, %27
  %30 = s_or_b64 %26, %29
  %57 = slice %lhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %56 = slice %lhs[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %55 = slice %rhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %54 = slice %rhs[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %37 = v_cmp_gt_u32 %56, %54
  %38 = v_cmp_gt_u32 %57, %55
  %39 = v_cmp_eq_i32 %56, %54
  %40 = s_and_b64 %39, %38
  %41 = s_or_b64 %37, %40
  %50 = v_cndmask_b32_src0_lit_src1_inline %30 {imm32 = 0, true_value = 1}
  %52 = v_cndmask_b32_src0_lit_src1_inline %41 {imm32 = 0, true_value = 1}
  %result = concat(%50, %52) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

