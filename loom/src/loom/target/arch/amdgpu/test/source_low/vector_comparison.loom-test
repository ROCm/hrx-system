// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @signed_byte_comparison(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (vector<4xi32>) {
  %mask = vector.cmpi slt, %lhs, %rhs : vector<4xi8> -> vector<4xi1>
  %result = vector.extui %mask : vector<4xi1> to vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @signed_byte_comparison(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %36 = v_bfe_i32_offset_width_inline %lhs {offset = 0, width = 8}
  %37 = v_bfe_i32_offset_width_inline %rhs {offset = 0, width = 8}
  %38 = v_cmp_lt_i32 %36, %37
  %39 = v_bfe_i32_offset_width_inline %lhs {offset = 8, width = 8}
  %40 = v_bfe_i32_offset_width_inline %rhs {offset = 8, width = 8}
  %41 = v_cmp_lt_i32 %39, %40
  %42 = v_bfe_i32_offset_width_inline %lhs {offset = 16, width = 8}
  %43 = v_bfe_i32_offset_width_inline %rhs {offset = 16, width = 8}
  %44 = v_cmp_lt_i32 %42, %43
  %45 = v_ashrrev_i32_src0_inline %lhs, 24
  %46 = v_ashrrev_i32_src0_inline %rhs, 24
  %47 = v_cmp_lt_i32 %45, %46
  %60 = v_cndmask_b32_src0_lit_src1_inline %38 {imm32 = 0, true_value = 1}
  %62 = v_cndmask_b32_src0_lit_src1_inline %41 {imm32 = 0, true_value = 1}
  %64 = v_cndmask_b32_src0_lit_src1_inline %44 {imm32 = 0, true_value = 1}
  %66 = v_cndmask_b32_src0_lit_src1_inline %47 {imm32 = 0, true_value = 1}
  %result = concat(%60, %62, %64, %66) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

func.def @unsigned_byte_comparison(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (vector<4xi32>) {
  %mask = vector.cmpi ule, %lhs, %rhs : vector<4xi8> -> vector<4xi1>
  %result = vector.extui %mask : vector<4xi1> to vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @unsigned_byte_comparison(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %36 = v_and_b32_lit %lhs, 255
  %37 = v_and_b32_lit %rhs, 255
  %38 = v_cmp_le_u32 %36, %37
  %39 = v_bfe_u32_offset_width_inline %lhs {offset = 8, width = 8}
  %40 = v_bfe_u32_offset_width_inline %rhs {offset = 8, width = 8}
  %41 = v_cmp_le_u32 %39, %40
  %42 = v_bfe_u32_offset_width_inline %lhs {offset = 16, width = 8}
  %43 = v_bfe_u32_offset_width_inline %rhs {offset = 16, width = 8}
  %44 = v_cmp_le_u32 %42, %43
  %45 = v_bfe_u32_offset_width_inline %lhs {offset = 24, width = 8}
  %46 = v_bfe_u32_offset_width_inline %rhs {offset = 24, width = 8}
  %47 = v_cmp_le_u32 %45, %46
  %60 = v_cndmask_b32_src0_lit_src1_inline %38 {imm32 = 0, true_value = 1}
  %62 = v_cndmask_b32_src0_lit_src1_inline %41 {imm32 = 0, true_value = 1}
  %64 = v_cndmask_b32_src0_lit_src1_inline %44 {imm32 = 0, true_value = 1}
  %66 = v_cndmask_b32_src0_lit_src1_inline %47 {imm32 = 0, true_value = 1}
  %result = concat(%60, %62, %64, %66) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

