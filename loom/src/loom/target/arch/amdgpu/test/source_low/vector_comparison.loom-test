func.def @signed_halfword_comparison(%lhs: vector<2xi16>, %rhs: vector<2xi16>) -> (vector<2xi32>) {
  %mask = vector.cmpi sge, %lhs, %rhs : vector<2xi16> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @signed_halfword_comparison(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %26 = v_bfe_i32_offset_width_inline %lhs {offset = 0, width = 16}
  %27 = v_bfe_i32_offset_width_inline %rhs {offset = 0, width = 16}
  %28 = v_cmp_ge_i32 %26, %27
  %29 = v_ashrrev_i32_src0_inline %lhs, 16
  %30 = v_ashrrev_i32_src0_inline %rhs, 16
  %31 = v_cmp_ge_i32 %29, %30
  %40 = v_cndmask_b32_src0_lit_src1_inline %28 {imm32 = 0, true_value = 1}
  %42 = v_cndmask_b32_src0_lit_src1_inline %31 {imm32 = 0, true_value = 1}
  %result = concat(%40, %42) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

func.def @halfword_equality(%lhs: vector<2xi16>, %rhs: vector<2xi16>) -> (vector<2xi32>) {
  %mask = vector.cmpi eq, %lhs, %rhs : vector<2xi16> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @halfword_equality(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %26 = v_and_b32_lit %lhs, 65535
  %27 = v_and_b32_lit %rhs, 65535
  %28 = v_cmp_eq_i32 %26, %27
  %29 = v_bfe_u32_offset_width_inline %lhs {offset = 16, width = 16}
  %30 = v_bfe_u32_offset_width_inline %rhs {offset = 16, width = 16}
  %31 = v_cmp_eq_i32 %29, %30
  %40 = v_cndmask_b32_src0_lit_src1_inline %28 {imm32 = 0, true_value = 1}
  %42 = v_cndmask_b32_src0_lit_src1_inline %31 {imm32 = 0, true_value = 1}
  %result = concat(%40, %42) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

