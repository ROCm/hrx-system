func.def @signed_halfword_comparison(%lhs: vector<2xi16>, %rhs: vector<2xi16>) -> (vector<2xi32>) {
  %mask = vector.cmpi sge, %lhs, %rhs : vector<2xi16> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @signed_halfword_comparison(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %24 = v_bfe_i32_offset_width_inline %lhs {offset = 0, width = 16}
  %25 = v_bfe_i32_offset_width_inline %rhs {offset = 0, width = 16}
  %26 = v_cmp_ge_i32 %24, %25
  %27 = v_ashrrev_i32_src0_inline %lhs, 16
  %28 = v_ashrrev_i32_src0_inline %rhs, 16
  %29 = v_cmp_ge_i32 %27, %28
  %38 = v_cndmask_b32_src0_lit_src1_inline %26 {imm32 = 0, true_value = 1}
  %40 = v_cndmask_b32_src0_lit_src1_inline %29 {imm32 = 0, true_value = 1}
  %result = concat(%38, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

func.def @halfword_equality(%lhs: vector<2xi16>, %rhs: vector<2xi16>) -> (vector<2xi32>) {
  %mask = vector.cmpi eq, %lhs, %rhs : vector<2xi16> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @halfword_equality(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %24 = v_and_b32_lit %lhs, 65535
  %25 = v_and_b32_lit %rhs, 65535
  %26 = v_cmp_eq_i32 %24, %25
  %27 = v_bfe_u32_offset_width_inline %lhs {offset = 16, width = 16}
  %28 = v_bfe_u32_offset_width_inline %rhs {offset = 16, width = 16}
  %29 = v_cmp_eq_i32 %27, %28
  %38 = v_cndmask_b32_src0_lit_src1_inline %26 {imm32 = 0, true_value = 1}
  %40 = v_cndmask_b32_src0_lit_src1_inline %29 {imm32 = 0, true_value = 1}
  %result = concat(%38, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

func.def @wide_integer_comparison(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi32>) {
  %mask = vector.cmpi ugt, %lhs, %rhs : vector<2xi64> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @wide_integer_comparison(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %18 = slice %lhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %19 = slice %rhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %20 = v_cmp_gt_u64 %18, %19
  %21 = slice %lhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %22 = slice %rhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %23 = v_cmp_gt_u64 %21, %22
  %32 = v_cndmask_b32_src0_lit_src1_inline %20 {imm32 = 0, true_value = 1}
  %34 = v_cndmask_b32_src0_lit_src1_inline %23 {imm32 = 0, true_value = 1}
  %result = concat(%32, %34) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

func.def @floating_comparison_flags(%lhs: vector<2xf32>, %rhs: vector<2xf32>) -> (vector<2xi32>) {
  %mask = vector.cmpf<nnan|ninf> olt, %lhs, %rhs : vector<2xf32> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @floating_comparison_flags(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %11 = slice %lhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %12 = slice %rhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %13 = v_cmp_lt_f32 %11, %12
  %14 = slice %lhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = slice %rhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %16 = v_cmp_lt_f32 %14, %15
  %25 = v_cndmask_b32_src0_lit_src1_inline %13 {imm32 = 0, true_value = 1}
  %27 = v_cndmask_b32_src0_lit_src1_inline %16 {imm32 = 0, true_value = 1}
  %result = concat(%25, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}
