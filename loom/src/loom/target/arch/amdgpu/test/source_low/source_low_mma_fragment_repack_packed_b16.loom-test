amdgpu.target<gfx1100> @target

func.def target(@target) @f16_result_to_rhs_packed_b16(
    %values: vector<16xf16>) -> (vector<16xf16>) {
  %c16 = index.constant 16 : index
  %result = vector.fragment<result> %values shape [%c16, %c16] : vector<16xf16>
  %rhs = vector.fragment.repack<rhs> %result shape [%c16, %c16] : vector<16xf16> -> vector<16xf16>
  func.return %rhs : vector<16xf16>
}

