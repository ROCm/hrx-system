// RUN: emit source-low output=low

amdgpu.target<gfx1250> @target

func.def target(@target) @swmmac_f32_fp8_fp8(%lhs_data: vector<8xi32>, %rhs_data: vector<16xi32>, %init_data: vector<8xf32>, %metadata: vector<2xi32>) -> (vector<8xf32>) {
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 128 : index
  %lhs_schema = encoding.define #encoding.operand<element_format=f8e4m3, payload_elements=32, payload_registers=8, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %rhs_schema = encoding.define #encoding.operand<element_format=f8e4m3, payload_elements=64, payload_registers=16> : encoding<schema>
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] using {schema = %lhs_schema : encoding<schema>, sparsity = %metadata : vector<2xi32>} : vector<8xi32>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] using {schema = %rhs_schema : encoding<schema>} : vector<16xi32>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<8xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<8xi32>, vector<16xi32>, vector<8xf32>
  func.return %result : vector<8xf32>
}

