low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) abi(hal_kernel) @swmmac_f32_fp8_fp8(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x16>, %init: reg<amdgpu.vgpr x8>, %metadata: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x8>) asm {
