// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

kernel.def target(@target) @subgroup_broadcast_i32_named_lane_wave64() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = vector.load %input_view[%tid] : view<64xi32> -> vector<1xi32>
  %value = vector.extract %loaded[0] : vector<1xi32> -> i32
  %source_lane = scalar.constant 33 : i32
  %broadcast = kernel.subgroup.broadcast %value from %source_lane : i32, i32
  %result = vector.from_elements %broadcast : vector<1xi32>
  vector.store %result, %output_view[%tid] : vector<1xi32>, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_broadcast_i32_named_lane_wave64() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %18, %input_view
  %broadcast = v_readlane_b32_src1_inline %value, 33
  %result = v_mov_b32_copy %broadcast
  %22 = v_lshlrev_b32_src0_inline %tid, 2
  global_store_b32_saddr %22, %result, %output_view
  return
}

// ====

amdgpu.target<gfx1151> @target {subgroup_size = 64}

kernel.def target(@target) @subgroup_broadcast_f32x4_named_lane_wave64() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xf32>
  %value = vector.load %input_view[%tid, 0] : view<64x4xf32> -> vector<4xf32>
  %source_lane = scalar.constant 47 : i32
  %broadcast = kernel.subgroup.broadcast %value from %source_lane : vector<4xf32>, i32
  vector.store %broadcast, %output_view[%tid, 0] : vector<4xf32>, view<64x4xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_broadcast_f32x4_named_lane_wave64() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 1024, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = v_lshlrev_b32_src0_inline %tid, 4
  %value = global_load_b128_saddr %19, %input_view
  %21 = slice %value[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22 = v_readlane_b32_src1_inline %21, 47
  %23 = v_mov_b32_copy %22
  %24 = slice %value[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %25 = v_readlane_b32_src1_inline %24, 47
  %26 = v_mov_b32_copy %25
  %27 = slice %value[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %28 = v_readlane_b32_src1_inline %27, 47
  %29 = v_mov_b32_copy %28
  %30 = slice %value[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %31 = v_readlane_b32_src1_inline %30, 47
  %32 = v_mov_b32_copy %31
  %broadcast = concat(%23, %26, %29, %32) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %34 = v_lshlrev_b32_src0_inline %tid, 4
  global_store_b128_saddr %34, %broadcast, %output_view
  return
}

// ====

amdgpu.target<gfx1151> @target {subgroup_size = 64}

kernel.def target(@target) @subgroup_broadcast_i32_uniform_dynamic_lane_wave64(%source_lane: index) {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%source_lane: index, %input: buffer, %output: buffer) {
  %bounded_source_lane = index.assume %source_lane [range(%source_lane, 0, 63)] : index
  %source_lane_i32 = index.cast %bounded_source_lane : index to i32
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = vector.load %input_view[%tid] : view<64xi32> -> vector<1xi32>
  %value = vector.extract %loaded[0] : vector<1xi32> -> i32
  %broadcast = kernel.subgroup.broadcast %value from %source_lane_i32 : i32, i32
  %result = vector.from_elements %broadcast : vector<1xi32>
  vector.store %result, %output_view[%tid] : vector<1xi32>, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "source_lane"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_broadcast_i32_uniform_dynamic_lane_wave64(%source_lane_i32: reg<amdgpu.sgpr>) asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %22 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %22, %input_view
  %broadcast = v_readlane_b32_src1_sgpr %value, %source_lane_i32
  %result = v_mov_b32_copy %broadcast
  %26 = v_lshlrev_b32_src0_inline %tid, 2
  global_store_b32_saddr %26, %result, %output_view
  return
}
