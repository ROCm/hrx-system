// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def public @call_mixed_i32(%input: vector<1xi32>, %delta: i32) -> (i32, i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %mixed = func.call @add_i32(%value, %delta) : (i32, i32) -> (i32)
  %uniform = func.call @add_i32(%delta, %delta) : (i32, i32) -> (i32)
  func.return %mixed, %uniform : i32, i32
}

func.def @add_i32(%value: i32, %delta: i32) -> (i32) {
  %wide_value = scalar.extui %value : i32 to i64
  %wide_delta = scalar.extui %delta : i32 to i64
  %sum = scalar.addi %wide_value, %wide_delta : i64
  %result = scalar.trunci %sum : i64 to i32
  func.return %result : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_mixed_i32(%value: reg<amdgpu.vgpr>, %delta: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %result$20 = v_add_u32 %value, %delta
  %result$21 = v_add_u32 %delta, %delta
  return %result$20, %result$21
}

// ====

func.def public @call_mixed_i64(%input: vector<1xi64>, %delta: i64) -> (i64, i64) {
  %value = vector.extract %input[0] : vector<1xi64> -> i64
  %mixed = func.call @add_i64(%value, %delta) : (i64, i64) -> (i64)
  %uniform = func.call @add_i64(%delta, %delta) : (i64, i64) -> (i64)
  func.return %mixed, %uniform : i64, i64
}

func.def @add_i64(%value: i64, %delta: i64) -> (i64) {
  %result = scalar.addi %value, %delta : i64
  func.return %result : i64
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_mixed_i64(%value: reg<amdgpu.vgpr x2>, %delta: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %16 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %17 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = slice %delta[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = slice %delta[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20, %21 = v_add_co_u32 %16, %18
  %22, %23 = v_add_co_ci_u32 %17, %19, %21
  %result$24 = concat(%20, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %29, %30 = v_add_co_u32 %18, %18
  %31, %32 = v_add_co_ci_u32 %19, %19, %30
  %result$33 = concat(%29, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result$24, %result$33
}

// ====

func.def public @call_vector_result(%input: i32, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %values = vector.from_elements %input, %c1, %c2, %c3 : vector<4xi32>
  %result = func.call inline @select_lane(%values, %lane) : (vector<4xi32>, index) -> (i32)
  func.return %result : i32
}

func.def @select_lane(%values: vector<4xi32>, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %result = vector.extract %values[%lane] : vector<4xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_vector_result(%input: reg<amdgpu.vgpr>, %lane: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) where [range(%lane, 0, 3)] asm {
  %c1 = s_mov_b32 1
  %c2 = s_mov_b32 2
  %c3 = s_mov_b32 3
  %18 = v_mov_b32_copy %c1
  %19 = v_mov_b32_copy %c2
  %20 = v_mov_b32_copy %c3
  %23 = v_mov_b32 1
  %24 = v_cmp_eq_i32 %lane, %23
  %26 = v_cndmask_b32 %input, %18, %24
  %27 = v_mov_b32 2
  %28 = v_cmp_eq_i32 %lane, %27
  %30 = v_cndmask_b32 %26, %19, %28
  %31 = v_mov_b32 3
  %32 = v_cmp_eq_i32 %lane, %31
  %result = v_cndmask_b32 %30, %20, %32
  return %result
}

// ====

func.def public @call_loop(%input: vector<1xi32>, %delta: i32, %count: index) -> (i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %result = func.call @repeat_add(%value, %delta, %count) : (i32, i32, index) -> (i32)
  func.return %result : i32
}

func.def @repeat_add(%value: i32, %delta: i32, %count: index) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%current = %value : i32) -> (i32) {
    %next = func.call @advance_i32(%current, %delta) : (i32, i32) -> (i32)
    scf.yield %next : i32
  }
  func.return %result : i32
}

func.def @advance_i32(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_loop(%value: reg<amdgpu.vgpr>, %delta: reg<amdgpu.vgpr>, %count: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %c0 = s_mov_b32 0
  %c1 = s_mov_b32 1
  %36 = v_mov_b32_copy %c0
  %38 = s_mov_b64_exec_read
  low.br ^_bb1(%36: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>)
^_bb1(%i: reg<amdgpu.vgpr>, %current: reg<amdgpu.vgpr>):
  %37 = v_cmp_lt_i32 %i, %count
  %39, %40 = s_and_saveexec_b64 %37
  low.cond_br %40, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %result = v_add_u32 %current, %delta
  %42 = v_add_u32 %c1, %i
  low.br ^_bb1(%42: reg<amdgpu.vgpr>, %result: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %38
  return %current
}

// ====

func.def public @call_scalar(%value: i32, %delta: i32) -> (i32) {
  %result = func.call @scalar_add(%value, %delta) : (i32, i32) -> (i32)
  func.return %result : i32
}

func.def @scalar_add(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_scalar(%value: reg<amdgpu.vgpr>, %delta: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_add_u32 %value, %delta
  return %result
}

// ====

// Callable contracts retain argument and result identities across source-to-Low
// boundary mapping. Results are signature values rather than body-local values.
func.def public @preserve_contracts(%limit: index, %value: i32) -> (%bounded: index, %echo: i32) where [range(%limit, 1, 8), eq(%bounded, %limit), eq(%echo, %value)] {
  func.return %limit, %value : index, i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @preserve_contracts(%limit: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>) -> (%bounded: reg<amdgpu.vgpr>, %echo: reg<amdgpu.vgpr>) where [range(%limit, 1, 8), eq(%bounded, %limit), eq(%echo, %value)] asm {
  return %limit, %value
}

// ====

// A separately compiled definition must use the same signature as its caller's
// declaration. The declaration is resolved by IR linking, not a runtime import.
func.def public @call_external(%value: i32) -> (i32) {
  // ERROR@+1: LOWERING/044 {op_name="func.call", phase_name="inline-callables", callee_name="increment", failure_code="callee_missing_body"}
  %result = func.call @increment(%value) : (i32) -> (i32)
  func.return %result : i32
}

func.decl @increment(%value: i32) -> (%result: i32) where [eq(%result, %value)]

// ====

// Uniform loads can use vector registers even when a retained helper selects
// scalar registers. Preserve narrow payloads and both words of wide values;
// floating payloads keep their ordinary callable representation.
amdgpu.target<gfx11-generic> @target

func.def noinline @forward_scalars(%i8: i8, %i16: i16, %i32: i32, %i64: i64, %f16: f16, %bf16: bf16, %f32: f32, %f64: f64) -> (i8, i16, i32, i64, f16, bf16, f32, f64) {
  func.return %i8, %i16, %i32, %i64, %f16, %bf16, %f32, %f64 : i8, i16, i32, i64, f16, bf16, f32, f64
}

func.def public target(@target) @loaded_scalars(%input: buffer) -> (i8, i16, i32, i64, f16, bf16, f32, f64) {
  %origin = index.constant 0 : offset
  %view_i8 = buffer.view %input[%origin] : buffer -> view<1xi8>
  %i8 = view.load %view_i8[0] : view<1xi8> -> i8
  %view_i16 = buffer.view %input[%origin] : buffer -> view<1xi16>
  %i16 = view.load %view_i16[0] : view<1xi16> -> i16
  %view_i32 = buffer.view %input[%origin] : buffer -> view<1xi32>
  %i32 = view.load %view_i32[0] : view<1xi32> -> i32
  %view_i64 = buffer.view %input[%origin] : buffer -> view<1xi64>
  %i64 = view.load %view_i64[0] : view<1xi64> -> i64
  %view_f16 = buffer.view %input[%origin] : buffer -> view<1xf16>
  %f16 = view.load %view_f16[0] : view<1xf16> -> f16
  %view_bf16 = buffer.view %input[%origin] : buffer -> view<1xbf16>
  %bf16 = view.load %view_bf16[0] : view<1xbf16> -> bf16
  %view_f32 = buffer.view %input[%origin] : buffer -> view<1xf32>
  %f32 = view.load %view_f32[0] : view<1xf32> -> f32
  %view_f64 = buffer.view %input[%origin] : buffer -> view<1xf64>
  %f64 = view.load %view_f64[0] : view<1xf64> -> f64
  %result_i8, %result_i16, %result_i32, %result_i64, %result_f16, %result_bf16, %result_f32, %result_f64 = func.call @forward_scalars(%i8, %i16, %i32, %i64, %f16, %bf16, %f32, %f64) : (i8, i16, i32, i64, f16, bf16, f32, f64) -> (i8, i16, i32, i64, f16, bf16, f32, f64)
  func.return %result_i8, %result_i16, %result_i32, %result_i64, %result_f16, %result_bf16, %result_f32, %result_f64 : i8, i16, i32, i64, f16, bf16, f32, f64
}

