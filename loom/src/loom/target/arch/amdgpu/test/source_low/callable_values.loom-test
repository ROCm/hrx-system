func.def public @call_vector_result(%input: i32, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %values = vector.from_elements %input, %c1, %c2, %c3 : vector<4xi32>
  %result = func.call @select_lane(%values, %lane) : (vector<4xi32>, index) -> (i32)
  func.return %result : i32
}

func.def @select_lane(%values: vector<4xi32>, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %result = vector.extract %values[%lane] : vector<4xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_vector_result(%input: reg<amdgpu.sgpr>, %lane: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) where [range(%lane, 0, 3)] asm {
  %c1 = s_mov_b32 1
  %c2 = s_mov_b32 2
  %c3 = s_mov_b32 3
  %18 = v_mov_b32_copy %input
  %19 = v_mov_b32_copy %c1
  %20 = v_mov_b32_copy %c2
  %21 = v_mov_b32_copy %c3
  %24 = v_mov_b32_copy %lane
  %25 = v_mov_b32 1
  %26 = v_cmp_eq_i32 %24, %25
  %28 = v_cndmask_b32 %18, %19, %26
  %29 = v_mov_b32 2
  %30 = v_cmp_eq_i32 %24, %29
  %32 = v_cndmask_b32 %28, %20, %30
  %33 = v_mov_b32 3
  %34 = v_cmp_eq_i32 %24, %33
  %result = v_cndmask_b32 %32, %21, %34
  return %result
}

// ====

func.def public @call_loop(%input: vector<1xi32>, %delta: i32, %count: index) -> (i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %result = func.call @repeat_add(%value, %delta, %count) : (i32, i32, index) -> (i32)
  func.return %result : i32
}

func.def @repeat_add(%value: i32, %delta: i32, %count: index) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%current = %value : i32) -> (i32) {
    %next = func.call @advance_i32(%current, %delta) : (i32, i32) -> (i32)
    scf.yield %next : i32
  }
  func.return %result : i32
}

func.def @advance_i32(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_loop(%value: reg<amdgpu.vgpr>, %delta: reg<amdgpu.sgpr>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %c0 = s_mov_b32 0
  %c1 = s_mov_b32 1
  low.br ^_bb1(%c0: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>)
^_bb1(%i: reg<amdgpu.sgpr>, %current: reg<amdgpu.vgpr>):
  %35 = s_cmp_lt_i32 %i, %count
  low.cond_br %35, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %36 = v_mov_b32_copy %delta
  %result = v_add_u32 %current, %36
  %38 = s_add_u32 %i, %c1
  low.br ^_bb1(%38: reg<amdgpu.sgpr>, %result: reg<amdgpu.vgpr>)
^_bb3:
  return %current
}

// ====

func.def public @call_scalar(%value: i32, %delta: i32) -> (i32) {
  %result = func.call @scalar_add(%value, %delta) : (i32, i32) -> (i32)
  func.return %result : i32
}

func.def @scalar_add(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_scalar(%value: reg<amdgpu.sgpr>, %delta: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %result = s_add_u32 %value, %delta
  return %result
}
