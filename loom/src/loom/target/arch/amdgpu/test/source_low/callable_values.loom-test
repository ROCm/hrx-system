// TEMPLATE: loom/src/loom/test/corpus/source_low/callable_values.loom-test
// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def public @call_mixed_i32(%input: vector<1xi32>, %delta: i32) -> (i32, i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %mixed = func.call @add_i32(%value, %delta) : (i32, i32) -> (i32)
  %uniform = func.call @add_i32(%delta, %delta) : (i32, i32) -> (i32)
  func.return %mixed, %uniform : i32, i32
}

func.def @add_i32(%value: i32, %delta: i32) -> (i32) {
  %wide_value = scalar.extui %value : i32 to i64
  %wide_delta = scalar.extui %delta : i32 to i64
  %sum = scalar.addi %wide_value, %wide_delta : i64
  %result = scalar.trunci %sum : i64 to i32
  func.return %result : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_mixed_i32(%value: reg<amdgpu.vgpr>, %delta: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>) asm {
  %27 = v_mov_b32_copy %delta
  %35, %36 = v_add_co_u32 %value, %27
  %45, %46 = s_add_co_u32 %delta, %delta
  return %35, %45
}

// ====

func.def public @call_mixed_i64(%input: vector<1xi64>, %delta: i64) -> (i64, i64) {
  %value = vector.extract %input[0] : vector<1xi64> -> i64
  %mixed = func.call @add_i64(%value, %delta) : (i64, i64) -> (i64)
  %uniform = func.call @add_i64(%delta, %delta) : (i64, i64) -> (i64)
  func.return %mixed, %uniform : i64, i64
}

func.def @add_i64(%value: i64, %delta: i64) -> (i64) {
  %result = scalar.addi %value, %delta : i64
  func.return %result : i64
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @call_mixed_i64(%value: reg<amdgpu.vgpr x2>, %delta: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %16 = slice %delta[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = v_mov_b32_copy %16
  %18 = slice %delta[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %21 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %22 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %25, %26 = v_add_co_u32 %21, %17
  %27, %28 = v_add_co_ci_u32 %22, %19, %26
  %result$29 = concat(%25, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %34, %35 = s_add_co_u32 %16, %16
  %36, %37 = s_addc_u32 %18, %18, %35
  %result$38 = concat(%34, %36) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result$29, %result$38
}

