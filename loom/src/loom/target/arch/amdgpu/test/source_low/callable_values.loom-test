low.func.def noinline target<amdgpu.gfx11.generic.core> @forward_scalars(%i8: reg<amdgpu.vgpr>, %i16: reg<amdgpu.vgpr>, %i32: reg<amdgpu.vgpr>, %i64: reg<amdgpu.vgpr x2>, %f16: reg<amdgpu.vgpr>, %bf16: reg<amdgpu.vgpr>, %f32: reg<amdgpu.vgpr>, %f64: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>) asm {
  return %i8, %i16, %i32, %i64, %f16, %bf16, %f32, %f64
}

low.func.def public target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @loaded_scalars() -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>) asm {
  %view_f64 = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %75 = slice %view_f64[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %76 = slice %view_f64[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %77 = v_mov_b32_copy %75
  %78 = v_mov_b32_copy %76
  %79 = concat(%77, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %i8 = global_load_u8_vaddr %79
  %85 = concat(%77, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %i16 = global_load_u16_vaddr %85
  %91 = concat(%77, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %i32 = global_load_b32_vaddr %91
  %97 = concat(%77, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %i64 = global_load_b64_vaddr %97
  %103 = concat(%77, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %f16 = global_load_u16_vaddr %103
  %109 = concat(%77, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %bf16 = global_load_u16_vaddr %109
  %115 = concat(%77, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %f32 = global_load_b32_vaddr %115
  %121 = concat(%77, %78) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %f64 = global_load_b64_vaddr %121
  %result_i8, %result_i16, %result_i32, %result_i64, %result_f16, %result_bf16, %result_f32, %result_f64 = low.func.call pure @forward_scalars(%i8, %i16, %i32, %i64, %f16, %bf16, %f32, %f64) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>)
  return %result_i8, %result_i16, %result_i32, %result_i64, %result_f16, %result_bf16, %result_f32, %result_f64
