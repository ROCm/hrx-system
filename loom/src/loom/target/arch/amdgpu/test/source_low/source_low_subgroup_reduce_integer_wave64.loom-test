// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

kernel.def target(@target) @subgroup_reduce_integer_wave64() {
  %c1 = index.constant 1 : index
  %wave_size = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%wave_size, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<9xi32>
  %value = view.load %input_view[%lane] : view<64xi32> -> i32
  %sum = kernel.subgroup.reduce<addi> %value : i32
  %product = kernel.subgroup.reduce<muli> %value : i32
  %signed_minimum = kernel.subgroup.reduce<minsi> %value : i32
  %signed_maximum = kernel.subgroup.reduce<maxsi> %value : i32
  %unsigned_minimum = kernel.subgroup.reduce<minui> %value : i32
  %unsigned_maximum = kernel.subgroup.reduce<maxui> %value : i32
  %bitwise_and = kernel.subgroup.reduce<andi> %value : i32
  %bitwise_or = kernel.subgroup.reduce<ori> %value : i32
  %bitwise_xor = kernel.subgroup.reduce<xori> %value : i32
  %is_leader = index.cmp eq, %lane, %c0 : index
  scf.if %is_leader {
    view.store %sum, %output_view[0] : i32, view<9xi32>
    view.store %product, %output_view[1] : i32, view<9xi32>
    view.store %signed_minimum, %output_view[2] : i32, view<9xi32>
    view.store %signed_maximum, %output_view[3] : i32, view<9xi32>
    view.store %unsigned_minimum, %output_view[4] : i32, view<9xi32>
    view.store %unsigned_maximum, %output_view[5] : i32, view<9xi32>
    view.store %bitwise_and, %output_view[6] : i32, view<9xi32>
    view.store %bitwise_or, %output_view[7] : i32, view<9xi32>
    view.store %bitwise_xor, %output_view[8] : i32, view<9xi32>
  }
  kernel.return
}

