// RUN: with-checks compile-report scf-to-cfg,cfg-simplify,source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @report_nested_cfg_loop_memory_counts() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %outer_end = index.constant 4 : index
  %inner_end = index.constant 8 : index
  %initial_sum = scalar.constant 0.0 : f32
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<64xf32>
  %output_view = buffer.view %output_global[%base] : buffer -> view<64xf32>
  %sum = scf.for %outer = [%c0 to %outer_end step %loop_step](%current = %initial_sum : f32) -> (f32) {
    %row_base = index.mul %outer, %inner_end : index
    %inner_sum = scf.for %inner = [%c0 to %inner_end step %loop_step](%inner_current = %current : f32) -> (f32) {
      %position = index.add %row_base, %inner : index
      %loaded = view.load %input_view[%position] : view<64xf32> -> f32
      %next = scalar.addf<reassoc|nnan|nsz> %inner_current, %loaded : f32
      view.store %next, %output_view[%position] : f32, view<64xf32>
      scf.yield %next : f32
    }
    %tail_value = view.load %input_view[%row_base] : view<64xf32> -> f32
    view.store %tail_value, %output_view[%row_base] : f32, view<64xf32>
    scf.yield %inner_sum : f32
  }
  view.store %sum, %output_view[%c0] : f32, view<64xf32>
  kernel.return
}

// ----
// The inner body executes 4*8 times, the outer tail four times, and the
// final store once: 36 reads and 37 writes of four bytes each.
CHECK: COMPILE-REPORT: source_low_memory * unknown_dynamic_packets=0 * dynamic_read_bytes=144 dynamic_write_bytes=148 *
CHECK: COMPILE-REPORT: source_low_memory * dispatch_source_read_bytes=144 dispatch_source_write_bytes=148 *
CHECK: COMPILE-REPORT: source_low[*] * source_op=index.cmp * execution_count=5
CHECK: COMPILE-REPORT: source_low[*] * source_op=index.cmp * execution_count=36
CHECK: COMPILE-REPORT: source_low[*] * source_op=view.load * execution_count=32
CHECK: COMPILE-REPORT: source_low[*] * source_op=view.load * execution_count=4
CHECK: COMPILE-REPORT: source_low[*] * source_op=view.store * execution_count=32
CHECK: COMPILE-REPORT: source_low[*] * source_op=view.store * execution_count=4
CHECK: COMPILE-REPORT: source_low_memory_root[*] * source_root=input * dynamic_read_bytes=144 dynamic_write_bytes=0 *
CHECK: COMPILE-REPORT: source_low_memory_root[*] * source_root=output * dynamic_read_bytes=0 dynamic_write_bytes=148 *
