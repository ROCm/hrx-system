// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @hadamard_f32x4(%input: vector<4xf32>) -> (vector<4xf32>) {
  %transform = encoding.define #transform.hadamard : encoding<transform>
  %result = vector.transform %input, %transform : vector<4xf32>, encoding<transform> -> vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @hadamard_f32x4(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %6 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %7 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = v_add_f32 %6, %7
  %11 = v_sub_f32 %6, %7
  %12 = v_add_f32 %8, %9
  %13 = v_sub_f32 %8, %9
  %14 = v_add_f32 %10, %12
  %15 = v_sub_f32 %10, %12
  %16 = v_add_f32 %11, %13
  %17 = v_sub_f32 %11, %13
  %result = concat(%14, %16, %15, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @hadamard_orthonormal_f32x4(%input: vector<4xf32>) -> (vector<4xf32>) {
  %transform = encoding.define #transform.hadamard<normalization=orthonormal> : encoding<transform>
  %result = vector.transform %input, %transform : vector<4xf32>, encoding<transform> -> vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @hadamard_orthonormal_f32x4(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %6 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %7 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = v_add_f32 %6, %7
  %11 = v_sub_f32 %6, %7
  %12 = v_add_f32 %8, %9
  %13 = v_sub_f32 %8, %9
  %14 = v_add_f32 %10, %12
  %15 = v_sub_f32 %10, %12
  %16 = v_add_f32 %11, %13
  %17 = v_sub_f32 %11, %13
  %18 = v_mul_f32_lit %14, 1056964608
  %19 = v_mul_f32_lit %16, 1056964608
  %20 = v_mul_f32_lit %15, 1056964608
  %21 = v_mul_f32_lit %17, 1056964608
  %result = concat(%18, %19, %20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @hadamard_wide_f16_load() {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %workitem = kernel.workitem.id<x> : index
  %c8 = index.constant 8 : index
  %base = index.mul %workitem, %c8 : index
  %buffer_base = index.constant 0 : offset
  %transform = encoding.define #transform.hadamard : encoding<transform>
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<256xf16>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<256xf16>
  %packed = vector.load %input_view[%base] : view<256xf16> -> vector<8xf16>
  %wide = vector.extf %packed : vector<8xf16> to vector<8xf32>
  %transformed = vector.transform %wide, %transform : vector<8xf32>, encoding<transform> -> vector<8xf32>
  %result = vector.fptrunc %transformed : vector<8xf32> to vector<8xf16>
  vector.store %result, %output_view[%base] : vector<8xf16>, view<256xf16>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @hadamard_wide_f16_load() asm {
  %workitem = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %20 = v_lshlrev_b32_src0_inline %workitem, 4
  %packed = global_load_b128_saddr %20, %input_view
  %22 = slice %packed[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %23 = v_cvt_f32_f16 %22
  %25 = v_lshrrev_b32_src0_inline %22, 16
  %26 = v_cvt_f32_f16 %25
  %27 = slice %packed[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %28 = v_cvt_f32_f16 %27
  %30 = v_lshrrev_b32_src0_inline %27, 16
  %31 = v_cvt_f32_f16 %30
  %32 = slice %packed[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %33 = v_cvt_f32_f16 %32
  %35 = v_lshrrev_b32_src0_inline %32, 16
  %36 = v_cvt_f32_f16 %35
  %37 = slice %packed[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %38 = v_cvt_f32_f16 %37
  %40 = v_lshrrev_b32_src0_inline %37, 16
  %41 = v_cvt_f32_f16 %40
  %51 = v_add_f32 %23, %26
  %52 = v_sub_f32 %23, %26
  %53 = v_add_f32 %28, %31
  %54 = v_sub_f32 %28, %31
  %55 = v_add_f32 %33, %36
  %56 = v_sub_f32 %33, %36
  %57 = v_add_f32 %38, %41
  %58 = v_sub_f32 %38, %41
  %59 = v_add_f32 %51, %53
  %60 = v_sub_f32 %51, %53
  %61 = v_add_f32 %52, %54
  %62 = v_sub_f32 %52, %54
  %63 = v_add_f32 %55, %57
  %64 = v_sub_f32 %55, %57
  %65 = v_add_f32 %56, %58
  %66 = v_sub_f32 %56, %58
  %67 = v_add_f32 %59, %63
  %68 = v_sub_f32 %59, %63
  %69 = v_add_f32 %61, %65
  %70 = v_sub_f32 %61, %65
  %71 = v_add_f32 %60, %64
  %72 = v_sub_f32 %60, %64
  %73 = v_add_f32 %62, %66
  %74 = v_sub_f32 %62, %66
  %77 = v_cvt_f16_f32 %67
  %78 = v_bfe_u32_offset_0_width_16_low16 %77
  %80 = v_cvt_f16_f32 %69
  %81 = v_bfe_u32_offset_0_width_16_low16 %80
  %82 = v_lshl_add_u32_shift_imm %81, %78, 16
  %84 = v_cvt_f16_f32 %71
  %85 = v_bfe_u32_offset_0_width_16_low16 %84
  %87 = v_cvt_f16_f32 %73
  %88 = v_bfe_u32_offset_0_width_16_low16 %87
  %89 = v_lshl_add_u32_shift_imm %88, %85, 16
  %91 = v_cvt_f16_f32 %68
  %92 = v_bfe_u32_offset_0_width_16_low16 %91
  %94 = v_cvt_f16_f32 %70
  %95 = v_bfe_u32_offset_0_width_16_low16 %94
  %96 = v_lshl_add_u32_shift_imm %95, %92, 16
  %98 = v_cvt_f16_f32 %72
  %99 = v_bfe_u32_offset_0_width_16_low16 %98
  %101 = v_cvt_f16_f32 %74
  %102 = v_bfe_u32_offset_0_width_16_low16 %101
  %103 = v_lshl_add_u32_shift_imm %102, %99, 16
  %result = concat(%82, %89, %96, %103) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %20, %result, %output_view
  return
}
