  %lhs = vector.fragment<lhs> %lhs_values shape [%m, %k] : vector<16xbf16>
  %rhs = vector.fragment<rhs> %rhs_values shape [%k, %n] : vector<16xbf16>
  %init = vector.fragment<init> %init_values shape [%m, %n] : vector<8xf32>
  %first = vector.mma %lhs, %rhs, %init : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %repacked = vector.fragment.repack<lhs> %first shape [%m, %k] : vector<8xf32> -> vector<16xbf16>
  %second = vector.mma %repacked, %rhs, %init : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  vector.fragment.store<result> %second, %output_view[0, 0] shape [%m, %n] : vector<8xf32>, view<16x16xf32, #dense>
  kernel.return
}

