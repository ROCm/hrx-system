amdgpu.target<gfx1100> @target

func.def target(@target) @result_fragment_repack_alias(%payload: vector<8xf32>) -> (vector<8xf32>) {
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %fragment = vector.fragment<result> %payload shape [%m, %n] : vector<8xf32>
  %repacked = vector.fragment.repack<result> %fragment shape [%m, %n] : vector<8xf32> -> vector<8xf32>
  func.return %repacked : vector<8xf32>
}

