  %lane_bits = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %22 = v_mov_b32_copy %base
  %element = v_add_u32 %22, %lane_bits
  %41 = v_lshlrev_b32_src0_inline %element, 2
  %42 = v_lshrrev_b32_src0_inline %element, 30
  %43 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %44 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45, %46 = v_add_co_u32 %43, %41
  %47 = v_mov_b32_copy %44
  %48, %49 = v_addc_co_u32 %47, %42, %46
  %50 = concat(%45, %48) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %51 = s_mov_b32_m0_imm 0
  %loaded = global_load_dword_vaddr %50, %51
  %55 = v_lshlrev_b32_src0_inline %lane_bits, 2
  %56 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %55, %loaded, %output_view, %56
  return
}

