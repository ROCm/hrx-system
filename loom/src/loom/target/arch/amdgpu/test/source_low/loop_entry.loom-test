// ====
// RUN: pass source-to-low,low-dce

// A divergent selection retains the first arm while the second arm retires a
// subset of lanes from the enclosing loop. The loop observes the return tuple
// only after both arms have completed their local iteration work.
amdgpu.target<gfx11-generic> @loop_entry_wave64 {subgroup_size = 64}

kernel.def target(@loop_entry_wave64) @nested_exit_region() {
  %workgroup_count = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%workgroup_count, %workgroup_count, %workgroup_count) workgroup_size(%workgroup_size, %workgroup_count, %workgroup_count) : index
} launch(%output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %origin = index.constant 0 : offset
  %begin = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %limit = scalar.constant 4 : i32
  %mask = scalar.constant 3 : i32
  %bias = scalar.constant 10 : i32
  %fallback = scalar.constant -1 : i32
  %lane_i32 = index.cast %lane : index to i32
  %parity = scalar.andi %lane_i32, %c1 : i32
  %exit_path = scalar.cmpi ne, %parity, %begin : i32
  %target = scalar.andi %lane_i32, %mask : i32
  %output_view = buffer.view %output[%origin] : buffer -> view<64xi32>
  cfg.br ^header(%begin: i32)
^header(%counter: i32):
  %more = scalar.cmpi slt, %counter, %limit : i32
  cfg.cond_br %more, ^choose, ^normal_exit
^choose:
  cfg.cond_br %exit_path, ^exit_check, ^retry_path
^retry_path:
  %retry_next = scalar.addi %counter, %c2 : i32
  cfg.br ^latch(%retry_next: i32)
^exit_check:
  %done = scalar.cmpi eq, %counter, %target : i32
  cfg.cond_br %done, ^returned, ^fallthrough
^returned:
  %returned_result = scalar.addi %counter, %bias : i32
  cfg.br ^merge(%returned_result: i32)
^fallthrough:
  %next = scalar.addi %counter, %c1 : i32
  cfg.br ^latch(%next: i32)
^latch(%next_counter: i32):
  cfg.br ^header(%next_counter: i32)
^normal_exit:
  cfg.br ^merge(%fallback: i32)
^merge(%merged_result: i32):
  view.store %merged_result, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

