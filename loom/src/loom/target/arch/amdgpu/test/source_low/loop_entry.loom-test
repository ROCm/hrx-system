  %observed = kernel.subgroup.broadcast.first %lane_i32 : i32
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^outer_body, ^exit
^outer_body:
  %next = index.add %counter, %step : index
  cfg.br ^outer_header(%next: index)
^exit:
  %result = scalar.addi %observed, %inner_count : i32
  view.store %result, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

