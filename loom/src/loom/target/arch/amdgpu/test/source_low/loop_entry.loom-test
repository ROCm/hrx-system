// RUN: pass source-to-low,low-dce

// Distinct lane-varying exits capture their result tuples, resume at their own
// lexical successors, and execute the normal exit only for remaining lanes.
amdgpu.target<gfx11-generic> @loop_entry_wave64 {subgroup_size = 64}

kernel.def target(@loop_entry_wave64) @divergent_exit_regions() {
  %workgroup_count = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%workgroup_count, %workgroup_count, %workgroup_count) workgroup_size(%workgroup_size, %workgroup_count, %workgroup_count) : index
} launch(%output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %origin = index.constant 0 : offset
  %begin = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %limit = scalar.constant 4 : i32
  %parity_mask = scalar.constant 1 : i32
  %target_mask = scalar.constant 3 : i32
  %second_bias = scalar.constant 10 : i32
  %fallback = scalar.constant -1 : i32
  %lane_i32 = index.cast %lane : index to i32
  %parity = scalar.andi %lane_i32, %parity_mask : i32
  %first_kind = scalar.cmpi eq, %parity, %begin : i32
  %target = scalar.andi %lane_i32, %target_mask : i32
  %output_view = buffer.view %output[%origin] : buffer -> view<64xi32>
  cfg.br ^header(%begin: i32)
^header(%counter: i32):
  %more = scalar.cmpi slt, %counter, %limit : i32
  cfg.cond_br %more, ^body, ^normal_exit
^body:
  %matched = scalar.cmpi eq, %counter, %target : i32
  %matched_first = scalar.andi %matched, %first_kind : i1
  cfg.cond_br %matched_first, ^first_exit, ^second_check
^first_exit:
  cfg.br ^merge(%counter: i32)
^second_check:
  %matched_second = scalar.cmpi eq, %counter, %target : i32
  cfg.cond_br %matched_second, ^second_exit, ^latch
^second_exit:
  %second_result = scalar.addi %counter, %second_bias : i32
  cfg.br ^merge(%second_result: i32)
^latch:
  %next = scalar.addi %counter, %increment : i32
  cfg.br ^header(%next: i32)
^normal_exit:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  view.store %result, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

