amdgpu.target<gfx11-generic> @target

// Each nested loop owns its EXEC lifetime. Lanes returning through the inner
// loop retire through both captures, while locally completed lanes resume the
// outer latch with its carried counter.
func.def target(@target) @nested_loop_exit_ownership(%values: vector<2xi32>, %inner_limit: i32) {
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %inner_lane_limit = vector.extract %values[1] : vector<2xi32> -> i32
  %loop_begin = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  cfg.br ^outer_header(%loop_begin: i32)
^outer_header(%outer_counter: i32):
  %more_outer = scalar.cmpi slt, %outer_counter, %lane : i32
  cfg.cond_br %more_outer, ^inner_header, ^exit
^inner_header:
  cfg.br ^inner_condition(%loop_begin: i32)
^inner_condition(%inner_counter: i32):
  %more_inner = scalar.cmpi slt, %inner_counter, %inner_limit : i32
  cfg.cond_br %more_inner, ^inner_body, ^outer_latch
^inner_body:
  %remain_inside = scalar.cmpi slt, %inner_counter, %inner_lane_limit : i32
  cfg.cond_br %remain_inside, ^inner_latch, ^exit
^inner_latch:
  %next_inner = scalar.addi %inner_counter, %increment : i32
  cfg.br ^inner_condition(%next_inner: i32)
^outer_latch:
  %next_outer = scalar.addi %outer_counter, %increment : i32
  cfg.br ^outer_header(%next_outer: i32)
^exit:
  func.return
}

