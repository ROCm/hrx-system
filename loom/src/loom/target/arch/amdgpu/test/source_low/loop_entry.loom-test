// ====
// RUN: pass cfg-converge,source-to-low,low-dce

// An enclosing lane-varying return bypasses a loop whose own exits carry the
// same result. CFG convergence gives the loop an exclusive result frontier so
// the enclosing decision and loop retain independent EXEC lifetimes.
amdgpu.target<gfx11-generic> @loop_entry_wave64 {subgroup_size = 64}

kernel.def target(@loop_entry_wave64) @outer_bypass_and_loop_results() {
  %workgroup_count = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%workgroup_count, %workgroup_count, %workgroup_count) workgroup_size(%workgroup_size, %workgroup_count, %workgroup_count) : index
} launch(%output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %origin = index.constant 0 : index
  %byte_origin = index.constant 0 : offset
  %limit = index.constant 64 : index
  %increment = index.constant 1 : index
  %early_value = scalar.constant -2 : i32
  %fallback_value = scalar.constant -1 : i32
  %early = index.cmp eq, %lane, %origin : index
  %output_view = buffer.view %output[%byte_origin] : buffer -> view<64xi32>
  cfg.cond_br %early, ^early_exit, ^preheader
^early_exit:
  cfg.br ^result(%early_value: i32)
^preheader:
  cfg.br ^header(%origin: index)
^header(%position: index):
  %more = index.cmp ult, %position, %limit : index
  cfg.cond_br %more, ^body, ^normal_exit
^body:
  %matched = index.cmp eq, %position, %lane : index
  cfg.cond_br %matched, ^matched_exit, ^latch
^matched_exit:
  %matched_value = index.cast %position : index to i32
  cfg.br ^result(%matched_value: i32)
^latch:
  %next = index.add %position, %increment : index
  cfg.br ^header(%next: index)
^normal_exit:
  cfg.br ^result(%fallback_value: i32)
^result(%value: i32):
  view.store %value, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

