// A leader-only publication before a polling loop also reconverges through
// one preheader. Retaining it preserves the subgroup-uniform loop condition,
// allowing the loop branch to stay scalar.
amdgpu.target<gfx11-generic> @loop_entry_wave64 {subgroup_size = 64}

kernel.def target(@loop_entry_wave64) @leader_then_while_preserves_entry() {
  %workgroup_count = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%workgroup_count, %workgroup_count, %workgroup_count) workgroup_size(%workgroup_size, %workgroup_count, %workgroup_count) : index
} launch(%summary: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %leader_index = index.constant 0 : index
  %origin = index.constant 0 : offset
  %initial_seen = scalar.constant 0 : i32
  %published_value = scalar.constant 1 : i32
  %leader = index.cmp eq, %lane, %leader_index : index
  %summary_view = buffer.view %summary[%origin] : buffer -> view<2xi32>
  scf.if %leader {
    view.atomic.store %published_value, %summary_view[0] {ordering = release, scope = system} : i32, view<2xi32>
  }
  %finished = scf.while(%seen = %initial_seen : i32) -> (i32) {
    %pending = scalar.cmpi eq, %seen, %initial_seen : i32
    scf.condition %pending, %seen : i1, i32
  } do(%seen: i32) {
    %loaded = view.atomic.load %summary_view[1] {ordering = relaxed, scope = system} : view<2xi32> -> i32
    %value = kernel.subgroup.broadcast.first %loaded : i32
    scf.yield %value : i32
  }
  kernel.return
}

