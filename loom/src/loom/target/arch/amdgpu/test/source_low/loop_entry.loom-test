} launch(%output: buffer) {
  %loop_begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %initial = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %lane = kernel.subgroup.lane.id : index
  %lane_i32 = index.cast %lane : index to i32
  %inner_end = index.add %lane, %step : index
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  cfg.br ^outer_header(%loop_begin: index)
^outer_header(%counter: index):
  %inner_count = scf.for %inner = [%loop_begin to %inner_end step %step](%count = %initial : i32) -> (i32) {
    %next_count = scalar.addi %count, %increment : i32
    scf.yield %next_count : i32
