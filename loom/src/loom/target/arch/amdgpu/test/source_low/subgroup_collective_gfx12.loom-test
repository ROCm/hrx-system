  %53 = v_add_u32 %51, %52
  %54 = v_cndmask_b32 %51, %53, %35
  %55 = ds_bpermute_b32 %39, %54 {offset = 60}
  %56 = v_add_u32 %54, %55
  %57 = v_cndmask_b32 %54, %56, %38
  %58 = v_lshrrev_b32_src0_inline %tid, 5
