  %23 = v_and_b32_src0_inline %19, 15
  %24 = v_mov_b32 1
  %26 = v_cmp_ge_u32 %23, %24
  %27 = v_mov_b32 2
  %29 = v_cmp_ge_u32 %23, %27
  %30 = v_mov_b32 4
  %32 = v_cmp_ge_u32 %23, %30
