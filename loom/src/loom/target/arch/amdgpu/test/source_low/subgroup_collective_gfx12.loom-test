low.kernel.def target<amdgpu.gfx12.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_broadcast_first_i32_wave64_gfx12() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %17 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %17, %input_view
  %broadcast = v_readfirstlane_b32 %value
  %result = v_mov_b32_copy %broadcast
  %21 = v_lshlrev_b32_src0_inline %tid, 2
  global_store_b32_saddr %21, %result, %output_view
  return
}

// ====

amdgpu.target<gfx12-generic> @target {subgroup_size = 64}

kernel.def target(@target) @subgroup_uniform_votes_wave64_gfx12() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch() {
  %tid = kernel.workitem.id<x> : index
  %lane = index.cast %tid : index to i32
  %lower_bound = scalar.constant 5 : i32
  %upper_bound = scalar.constant 10 : i32
  %above_lower_bound = scalar.cmpi uge, %lane, %lower_bound : i32
  %below_upper_bound = scalar.cmpi ult, %lane, %upper_bound : i32
  %active = scalar.andi %above_lower_bound, %below_upper_bound : i1
  cfg.cond_br %active, ^active, ^inactive
^active:
  %predicate = scalar.cmpi uge, %lane, %lower_bound : i32
  // Convergent votes remain live; the exact output proves they need no mask ops.
  %any = kernel.subgroup.vote.any %predicate : i1
  %all = kernel.subgroup.vote.all %predicate : i1
  cfg.br ^exit
^inactive:
  cfg.br ^exit
^exit:
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx12.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_uniform_votes_wave64_gfx12() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %above_lower_bound = v_cmp_ge_u32_src1_inline %lane {rhs = 5}
  %below_upper_bound = v_cmp_lt_u32_src1_inline %lane {rhs = 10}
  %active = s_and_b64 %above_lower_bound, %below_upper_bound
  %16, %17 = s_and_saveexec_b64 %active
  s_mov_b64_exec %16
  return
}

// ====

// GFX12 can exchange all 64 lanes even though its default wave size is 32.
// Exercise every collective consumer of the direct exchange-width fact.
amdgpu.target<gfx12-generic> @target {subgroup_size = 64}

kernel.def target(@target) @full_wave_exchange() {
  %unit = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  %value = view.load %input_view[%lane] : view<64xi32> -> i32
  %distance = scalar.constant 32 : i32
  %width = scalar.constant 64 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<xor> %value, %distance, %width : i32, i32, i32
  %lane_i32 = index.cast %lane : index to i32
  %broadcast = kernel.subgroup.broadcast %shuffled from %lane_i32 : i32, i32
  %sum = kernel.subgroup.reduce<addi> %broadcast : i32
  %prefix = kernel.subgroup.scan<addi> %sum {direction = forward, mode = inclusive} : i32
  view.store %prefix, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx12.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @full_wave_exchange() asm {
  %lane_i32 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = v_lshlrev_b32_src0_inline %lane_i32, 2
  %value = global_load_b32_saddr %20, %input_view
  %22 = v_xor_b32_src0_inline %lane_i32, 32
  %23 = v_lshlrev_b32_src0_inline %22, 2
  %shuffled = ds_bpermute_b32 %23, %value
  %25 = v_lshlrev_b32_src0_inline %lane_i32, 2
  %broadcast = ds_bpermute_b32 %25, %shuffled
  %27 = v_mov_b32_dpp16 %broadcast {dpp_ctrl = 177}
  %28 = v_add_u32 %broadcast, %27
  %29 = v_mov_b32_dpp16 %28 {dpp_ctrl = 78}
  %30 = v_add_u32 %28, %29
  %31 = v_mov_b32_dpp16 %30 {dpp_ctrl = 321}
  %32 = v_add_u32 %30, %31
  %33 = v_mov_b32_dpp16 %32 {dpp_ctrl = 320}
  %34 = v_add_u32 %32, %33
  %35 = v_permlanex16_b32_src12_inline %34, 0, 0
  %36 = v_add_u32 %34, %35
  %37 = v_xor_b32_src0_inline %lane_i32, 32
  %38 = v_lshlrev_b32_src0_inline %37, 2
  %39 = ds_bpermute_b32 %38, %36
  %sum = v_add_u32 %36, %39
  %41 = v_and_b32_lit %lane_i32, 4294967280
  %42 = v_and_b32_src0_inline %lane_i32, 15
  %43 = v_mov_b32 1
  %45 = v_cmp_ge_u32 %42, %43
  %46 = v_mov_b32 2
  %48 = v_cmp_ge_u32 %42, %46
  %49 = v_mov_b32 4
  %51 = v_cmp_ge_u32 %42, %49
  %52 = v_mov_b32 8
  %54 = v_cmp_ge_u32 %42, %52
  %55 = v_mov_b32 16
  %56 = v_sub_nc_u32 %41, %55
  %57 = v_cmp_ge_u32 %41, %55
  %58 = v_lshlrev_b32_src0_inline %56, 2
  %59 = v_mov_b32 32
  %60 = v_sub_nc_u32 %41, %59
  %61 = v_cmp_ge_u32 %41, %59
  %62 = v_lshlrev_b32_src0_inline %60, 2
  %63 = v_mov_b32_dpp16 %sum {dpp_ctrl = 273}
  %64 = v_add_u32 %sum, %63
  %65 = v_cndmask_b32 %sum, %64, %45
  %66 = v_mov_b32_dpp16 %65 {dpp_ctrl = 274}
  %67 = v_add_u32 %65, %66
  %68 = v_cndmask_b32 %65, %67, %48
  %69 = v_mov_b32_dpp16 %68 {dpp_ctrl = 276}
  %70 = v_add_u32 %68, %69
  %71 = v_cndmask_b32 %68, %70, %51
  %72 = v_mov_b32_dpp16 %71 {dpp_ctrl = 280}
  %73 = v_add_u32 %71, %72
  %74 = v_cndmask_b32 %71, %73, %54
  %75 = ds_bpermute_b32 %58, %74 {offset = 60}
  %76 = v_add_u32 %74, %75
  %77 = v_cndmask_b32 %74, %76, %57
  %78 = ds_bpermute_b32 %62, %77 {offset = 60}
  %79 = v_add_u32 %77, %78
  %prefix = v_cndmask_b32 %77, %79, %61
  %81 = v_lshlrev_b32_src0_inline %lane_i32, 2
  global_store_b32_saddr %81, %prefix, %output_view
  return
}
