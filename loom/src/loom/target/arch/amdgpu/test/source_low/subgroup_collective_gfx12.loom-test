low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @workgroup_reduce_addf_f32_multi_wave_gfx1250() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %17 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %17, %input_view
  %19 = v_and_b32_src0_inline %tid, 31
  %20 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %21 = storage_address %20 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %22 = v_add_f32_dpp16 %value, %value {dpp_ctrl = 177}
  %23 = v_add_f32_dpp16 %22, %22 {dpp_ctrl = 78}
  %24 = v_add_f32_dpp16 %23, %23 {dpp_ctrl = 321}
  %25 = v_add_f32_dpp16 %24, %24 {dpp_ctrl = 320}
  %26 = v_permlanex16_b32_src12_inline %25, 0, 0
  %27 = v_add_f32 %25, %26
  %28 = v_lshrrev_b32_src0_inline %tid, 5
  %29 = v_lshlrev_b32_src0_inline %28, 2
  %30 = v_mov_b32 1
  %31 = v_cmp_lt_u32 %19, %30
  %32, %33 = s_and_saveexec_b64 %31
  %34 = v_add_u32 %21, %29
  ds_write_b32 %34, %27
  s_mov_b64_exec %32
  s_barrier_signal_all
  s_barrier_wait_all
  %35 = v_mov_b32 2
  %36 = v_cmp_lt_u32 %19, %35
  %37, %38 = s_and_saveexec_b64 %36
  %39 = v_lshlrev_b32_src0_inline %19, 2
  %40 = v_add_u32 %21, %39
  %41 = ds_read_b32 %40
  %42 = v_add_f32_dpp16 %41, %41 {dpp_ctrl = 177}
  s_mov_b64_exec %37
  %43 = v_mov_b32 0
  %result = ds_bpermute_b32 %43, %42
  s_barrier_signal_all
  s_barrier_wait_all
  %45 = v_lshlrev_b32_src0_inline %tid, 2
  global_store_b32_saddr %45, %result, %output_view
  return
}

