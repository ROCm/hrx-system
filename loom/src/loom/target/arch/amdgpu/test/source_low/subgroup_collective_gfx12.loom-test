low.kernel.def target<amdgpu.gfx12.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_vote_any_wave64_gfx12() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %14, %input_view
  %predicate = v_cmp_gt_i32_src1_inline %value {rhs = 0}
  %17 = s_mov_b64_exec_read
  %18 = s_and_b64 %predicate, %17
  %19 = s_mov_b32 0
  %21 = concat(%19, %19) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %any = s_cmp_lg_u64 %18, %21
  low.cond_br %any, ^then, ^else : reg<amdgpu.scc>
^then:
  return
^else:
  return
}

