CHECK: COMPILE-REPORT: source_low_memory * packets=3 loads=1 stores=2 *
CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.store memory_space=workgroup operation=store packet=amdgpu.ds_write2_b32 source_root=scratch *storage={element_format:i32} * address_form=ds_2addr dynamic_term_kind=vaddr * static_offset_bytes=0 element_bytes=4 vector_lanes=2 issued_read_bytes=0 issued_write_bytes=8 issued_read_unknown_widths=0 issued_write_unknown_widths=0 dynamic_stride_bytes=32 vector_lane_stride_bytes=8
