// RUN: with-checks compile-report source-to-low,low-dce

// Launch geometry retains the explicit cluster shape and dispatch products.
amdgpu.target<gfx1250> @target

kernel.def target(@target) @report_static_cluster_size() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%c4, %c4, %c1) workgroup_size(%c32, %c1, %c1) cluster_size(%c1, %c2, %c1) : index
} launch() {
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: workload workgroup_size=32x1x1 flat_workgroup_size=32 workgroup_count=4x4x1 dispatch_workgroup_count=16 cluster_size=1x2x1 flat_cluster_size=2 dispatch_workitem_count=512

// ====

// A scalar LDS write retains its constant address and four-byte packet width.
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @report_static_lds_address_fields() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<1xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[0] : vector<1xi32>, view<1xi32>
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: source_low_memory * packets=1 loads=0 stores=1 *
CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.store memory_space=workgroup operation=store packet=amdgpu.ds_write_b32 source_root=scratch *storage={element_format:i32} * address_form=default dynamic_term_kind=none * static_offset_bytes=0 element_bytes=4 vector_lanes=1 issued_read_bytes=0 issued_write_bytes=4 issued_read_unknown_widths=0 issued_write_unknown_widths=0 dynamic_stride_bytes=0 vector_lane_stride_bytes=4

// ====

// Two f16 lanes use one four-byte packet with two-byte workitem and lane strides.
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @report_lds_f16_subword_stride_fields() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<128xf16>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<128xf16>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<128xf16>
  %loaded = vector.load %input_view[%tid] : view<128xf16> -> vector<2xf16>
  vector.store %loaded, %scratch_view[%tid] : vector<2xf16>, view<128xf16>
  %roundtrip = vector.load %scratch_view[%tid] : view<128xf16> -> vector<2xf16>
  vector.store %roundtrip, %output_view[%tid] : vector<2xf16>, view<128xf16>
  kernel.return
}

