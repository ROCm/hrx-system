CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.load memory_space=workgroup operation=load packet=amdgpu.ds_read_b32 source_root=scratch *storage={element_format:f16} * address_form=default dynamic_term_kind=vaddr * static_offset_bytes=0 element_bytes=2 vector_lanes=2 issued_read_bytes=4 issued_write_bytes=0 issued_read_unknown_widths=0 issued_write_unknown_widths=0 dynamic_stride_bytes=2 vector_lane_stride_bytes=2
CHECK: COMPILE-REPORT: source_low_memory[*] * source_op=vector.store memory_space=global operation=store packet=amdgpu.global_store_b32_saddr source_root=output *storage={element_format:f16} * address_form=global_saddr dynamic_term_kind=vaddr * static_offset_bytes=0 element_bytes=2 vector_lanes=2 issued_read_bytes=0 issued_write_bytes=4 issued_read_unknown_widths=0 issued_write_unknown_widths=0 dynamic_stride_bytes=2 vector_lane_stride_bytes=2

// ====

// Read2/write2 move eight bytes across two addresses eight bytes apart.
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @report_lds_read2_write2_address_fields() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 2048 : offset
  %layout = encoding.layout.strided [8, 2] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64x4xi32, %layout>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x2xi32>
  %stored_value = vector.constant 1 : vector<2xi32>
  vector.store %stored_value, %scratch_view[%tid, 0] : vector<2xi32>, view<64x4xi32, %layout>
  %loaded = vector.load %scratch_view[%tid, 0] : view<64x4xi32, %layout> -> vector<2xi32>
  vector.store %loaded, %output_view[%tid, 0] : vector<2xi32>, view<64x2xi32>
  kernel.return
}

