  %46 = v_mov_b32_copy %45
  %47 = slice %40[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %48 = v_mov_b32_copy %47
  %49 = concat(%42, %44, %46, %48) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %50 = s_load_dwordx4 %source, %9 {offset = 72}
  %51 = slice %50[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %52 = v_mov_b32_copy %51
