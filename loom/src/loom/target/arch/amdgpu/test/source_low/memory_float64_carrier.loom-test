  %80 = s_load_dwordx4 %source, %9 {offset = 120}
  %81 = slice %80[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %82 = v_mov_b32_copy %81
  %83 = slice %80[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
