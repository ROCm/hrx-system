  %92 = v_mov_b32 0
  global_store_b128_saddr %92, %19, %destination {offset = 8}
  global_store_b128_saddr %92, %29, %destination {offset = 24}
  global_store_b128_saddr %92, %39, %destination {offset = 40}
  global_store_b128_saddr %92, %49, %destination {offset = 56}
  global_store_b128_saddr %92, %59, %destination {offset = 72}
  global_store_b128_saddr %92, %69, %destination {offset = 88}
  global_store_b128_saddr %92, %79, %destination {offset = 104}
  global_store_b128_saddr %92, %89, %destination {offset = 120}
  return
}
