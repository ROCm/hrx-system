  %67 = slice %60[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %68 = v_mov_b32_copy %67
  %69 = concat(%62, %64, %66, %68) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %70 = s_load_dwordx4 %source, %9 {offset = 104}
  %71 = slice %70[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %72 = v_mov_b32_copy %71
