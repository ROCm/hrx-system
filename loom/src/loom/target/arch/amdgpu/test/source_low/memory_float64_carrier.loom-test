// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A 32-register f64 carrier retains all payload bits across native packet
// splitting.
kernel.def @float64_memory_copy() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<18xf64>
  %destination = buffer.view %output[%base] : buffer -> view<18xf64>
  %payload = vector.load %source[1] : view<18xf64> -> vector<16xf64>
  vector.store %payload, %destination[1] : vector<16xf64>, view<18xf64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @float64_memory_copy() asm {
  %source = resource<hal_binding> {extent = 144, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 144, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %9 = s_mov_b32 0
  %10 = s_load_dwordx4 %source, %9 {offset = 8}
  %11 = slice %10[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %12 = v_mov_b32_copy %11
  %13 = slice %10[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %14 = v_mov_b32_copy %13
  %15 = slice %10[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %15
  %17 = slice %10[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %17
  %19 = concat(%12, %14, %16, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %20 = s_load_dwordx4 %source, %9 {offset = 24}
  %21 = slice %20[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %22 = v_mov_b32_copy %21
  %23 = slice %20[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %24 = v_mov_b32_copy %23
  %25 = slice %20[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %26 = v_mov_b32_copy %25
  %27 = slice %20[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %28 = v_mov_b32_copy %27
  %29 = concat(%22, %24, %26, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %30 = s_load_dwordx4 %source, %9 {offset = 40}
  %31 = slice %30[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %32 = v_mov_b32_copy %31
