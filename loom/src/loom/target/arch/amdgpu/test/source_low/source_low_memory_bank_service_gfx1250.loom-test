bank-service function=unknown_divergent_active_lanes source-op=vector.store root=scratch packet=amdgpu.ds_write_b128 model=amdgpu.lds.wave32.b128.quad-phases.write.count-each proof=unknown lane-address=affine-workitem-x-byte-stride active-lanes=unproven base-residue=all-bank-word-residues-common-translation unknown-reason=active-lane-control-not-uniform

