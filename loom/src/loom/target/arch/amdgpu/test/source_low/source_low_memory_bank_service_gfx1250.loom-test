// RUN: emit amdgpu-bank-service

amdgpu.target<gfx1250> @target

kernel.def target(@target) @gfx1250_b128_bank_service() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 4096 : offset
  %stride16 = encoding.layout.strided [4, 1] : encoding<layout>
  %stride64 = encoding.layout.strided [16, 1] : encoding<layout>
  %stride80 = encoding.layout.strided [20, 1] : encoding<layout>
  %stride96 = encoding.layout.strided [24, 1] : encoding<layout>
  %scratch16 = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch64 = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch80 = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch96 = buffer.alloca<workgroup> align(16) %bytes : buffer
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<32x16xi32>
  %view16 = buffer.view %scratch16[%buffer_base] : buffer -> view<32x4xi32, %stride16>
  %view64 = buffer.view %scratch64[%buffer_base] : buffer -> view<32x4xi32, %stride64>
  %view80 = buffer.view %scratch80[%buffer_base] : buffer -> view<32x4xi32, %stride80>
  %view96 = buffer.view %scratch96[%buffer_base] : buffer -> view<32x4xi32, %stride96>
  %value = vector.constant 1 : vector<4xi32>
  vector.store %value, %view16[%lane, 0] : vector<4xi32>, view<32x4xi32, %stride16>
  vector.store %value, %view64[%lane, 0] : vector<4xi32>, view<32x4xi32, %stride64>
  vector.store %value, %view80[%lane, 0] : vector<4xi32>, view<32x4xi32, %stride80>
  vector.store %value, %view96[%lane, 0] : vector<4xi32>, view<32x4xi32, %stride96>
  %loaded16 = vector.load %view16[%lane, 0] : view<32x4xi32, %stride16> -> vector<4xi32>
  %loaded64 = vector.load %view64[%lane, 0] : view<32x4xi32, %stride64> -> vector<4xi32>
  %loaded80 = vector.load %view80[%lane, 0] : view<32x4xi32, %stride80> -> vector<4xi32>
  %loaded96 = vector.load %view96[%lane, 0] : view<32x4xi32, %stride96> -> vector<4xi32>
  vector.store %loaded16, %output_view[%lane, 0] : vector<4xi32>, view<32x16xi32>
  vector.store %loaded64, %output_view[%lane, 4] : vector<4xi32>, view<32x16xi32>
  vector.store %loaded80, %output_view[%lane, 8] : vector<4xi32>, view<32x16xi32>
  vector.store %loaded96, %output_view[%lane, 12] : vector<4xi32>, view<32x16xi32>
  kernel.return
}

