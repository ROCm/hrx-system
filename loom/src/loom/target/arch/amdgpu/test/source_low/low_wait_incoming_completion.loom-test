// RUN: emit amdgpu-assembly @completed_result_gfx1151 strategy=source fixed=%address:physical_register:0:1 fixed=%offset:physical_register:4:1 fixed=%value:physical_register:4:1 fixed=%accumulator:physical_register:5:1 fixed=%next:physical_register:5:1

// The consumer wait completes the result before every backedge. Reusing the
// old result register for address arithmetic needs no second wait.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @completed_result_gfx1151(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = v_mov_b32 0
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^loop(%begin: reg<amdgpu.sgpr>, %zero: reg<amdgpu.vgpr>)
^loop(%index: reg<amdgpu.sgpr>, %accumulator: reg<amdgpu.vgpr>):
  %more = s_cmp_lt_i32 %index, %count
  low.cond_br %more, ^load, ^exit : reg<amdgpu.scc>
^load:
  %offset = v_add_u32 %address, %address
  %value = global_load_b32_saddr %offset, %base
  low.br ^consume
^consume:
  %next = v_add_f32 %accumulator, %value
  %advanced = s_add_u32 %index, %step
  low.br ^loop(%advanced: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>)
^exit:
  return %accumulator
}

// ----
  v_mov_b32 v1, 0
  s_mov_b32 s3, 0
  s_mov_b32 s4, 1
  s_delay_alu instid0(VALU_DEP_1)
  v_mov_b32 v5, v1
.Lbb1:
  s_cmp_lt_i32 s3, s2
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb4
.Lbb2:
  v_add_u32 v4, v0, v0
  global_load_b32 v4, v4, s[0:1] offset:0
.Lbb3:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_f32 v5, v5, v4
  s_add_u32 s3, s3, s4
  s_branch .Lbb1
.Lbb4:
  s_endpgm

