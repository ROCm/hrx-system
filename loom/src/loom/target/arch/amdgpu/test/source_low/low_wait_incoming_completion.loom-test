// ====
// RUN: emit amdgpu-assembly @completed_result_gfx1250

// GFX1250 retains the address lease separately from result completion.
// Reissuing the result needs only the wait at its actual consumer.
amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @completed_result_gfx1250(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
