  s_endpgm

// ====
// RUN: emit amdgpu-assembly @repeated_old_use_retains_younger

// Rereading an already-completed result is not a full counter drain. The
// unrelated younger load must still complete before its address overwrite.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @repeated_old_use_retains_younger(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %old = global_load_b32_saddr %address, %base
  %initial = v_add_u32 %old, %address
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^load(%begin: reg<amdgpu.sgpr>, %initial: reg<amdgpu.vgpr>)
^load(%index: reg<amdgpu.sgpr>, %accumulator: reg<amdgpu.vgpr>):
  %offset = v_add_u32 %address, %address
  %younger = global_load_b32_saddr %offset, %base
  low.br ^consume
^consume:
  %next = v_add_u32 %accumulator, %old
  %advanced = s_add_u32 %index, %step
  %more = s_cmp_lt_i32 %advanced, %count
  low.cond_br %more, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^load(%advanced: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>)
^exit:
  %result = v_add_u32 %next, %younger
  return %result
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  s_mov_b32 s3, 0
  s_mov_b32 s4, 1
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v2, v1, v0
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v3, v0, v0
  global_load_b32 v3, v3, s[0:1] offset:0
.Lbb2:
  v_add_u32 v2, v2, v1
  s_add_u32 s3, s3, s4
  s_cmp_lt_i32 s3, s2
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb4
.Lbb3:
  s_branch .Lbb1
.Lbb4:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v2, v3
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @coalesced_loop_completion

// Coalesced loop arguments carry pending completion to the real consumer.
// Each new load instance still needs that consumer wait on the next trip.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @coalesced_loop_completion(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %seed = global_load_b32_saddr %address, %base
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^consume(%begin: reg<amdgpu.sgpr>, %seed: reg<amdgpu.vgpr>)
^consume(%index: reg<amdgpu.sgpr>, %carried: reg<amdgpu.vgpr>):
  %used = v_add_u32 %carried, %address
  %advanced = s_add_u32 %index, %step
  %more = s_cmp_lt_i32 %advanced, %count
  low.cond_br %more, ^load, ^exit : reg<amdgpu.scc>
^load:
  %future = global_load_b32_saddr %address, %base {offset = 4}
  low.br ^consume(%advanced: reg<amdgpu.sgpr>, %future: reg<amdgpu.vgpr>)
^exit:
  return %used
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  s_mov_b32 s3, 0
  s_mov_b32 s4, 1
  s_waitcnt vmcnt(0) lgkmcnt(63)
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v1, v1, v0
  s_add_u32 s3, s3, s4
  s_cmp_lt_i32 s3, s2
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  global_load_b32 v1, v0, s[0:1] offset:4
  s_branch .Lbb1
.Lbb3:
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @completed_result_retains_younger

// An incoming-result use can retain a younger load with a partial wait.
// The completed older result needs no wait before address reuse; the final
// use of the younger result still requires completion.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @completed_result_retains_younger(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = v_mov_b32 0
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^load(%begin: reg<amdgpu.sgpr>, %zero: reg<amdgpu.vgpr>)
^load(%index: reg<amdgpu.sgpr>, %accumulator: reg<amdgpu.vgpr>):
  %offset = v_add_u32 %address, %address
  %value = global_load_b32_saddr %offset, %base
  low.br ^consume
^consume:
  %younger = global_load_b32_saddr %address, %base {offset = 4}
  %next = v_add_u32 %accumulator, %value
  %advanced = s_add_u32 %index, %step
  %more = s_cmp_lt_i32 %advanced, %count
  low.cond_br %more, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^load(%advanced: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>)
^exit:
  %result = v_add_u32 %next, %younger
  return %result
}

// ----
  v_mov_b32 v1, 0
  s_mov_b32 s3, 0
  s_mov_b32 s4, 1
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v2, v0, v0
  global_load_b32 v3, v2, s[0:1] offset:0
.Lbb2:
  global_load_b32 v2, v0, s[0:1] offset:4
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v1, v1, v3
  s_add_u32 s3, s3, s4
  s_cmp_lt_i32 s3, s2
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb4
.Lbb3:
  s_branch .Lbb1
.Lbb4:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v1, v2
  s_endpgm
