// RUN: emit amdgpu-assembly @completed_result_gfx942 strategy=source fixed=%address:physical_register:0:1 fixed=%offset:physical_register:4:1 fixed=%value:physical_register:4:1 fixed=%accumulator:physical_register:5:1 fixed=%next:physical_register:5:1

// The same incoming-result completion applies to CDNA VMEM.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @completed_result_gfx942(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %m0 = s_mov_b32_m0_imm 0
  %zero = v_mov_b32 0
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^loop(%begin: reg<amdgpu.sgpr>, %zero: reg<amdgpu.vgpr>)
^loop(%index: reg<amdgpu.sgpr>, %accumulator: reg<amdgpu.vgpr>):
  %more = s_cmp_lt_i32 %index, %count
  low.cond_br %more, ^load, ^exit : reg<amdgpu.scc>
^load:
  %offset = v_add_u32 %address, %address
  %value = global_load_dword_saddr %offset, %base, %m0
  low.br ^consume
^consume:
  %next = v_add_f32 %accumulator, %value
  %advanced = s_add_u32 %index, %step
  low.br ^loop(%advanced: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>)
^exit:
  return %accumulator
}

