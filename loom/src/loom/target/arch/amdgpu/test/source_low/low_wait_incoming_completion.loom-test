// ====
// RUN: emit amdgpu-assembly @completed_smem_result

// Unordered SMEM still requires its full consumer wait, but the completed
// result does not require another wait on the next trip.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @completed_smem_result(%address: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^loop(%begin: reg<amdgpu.sgpr>, %zero: reg<amdgpu.sgpr>)
^loop(%index: reg<amdgpu.sgpr>, %accumulator: reg<amdgpu.sgpr>):
  %more = s_cmp_lt_i32 %index, %count
  low.cond_br %more, ^load, ^exit : reg<amdgpu.scc>
^load:
  %offset = s_add_u32 %address, %address
  %value = s_load_dword %base, %offset
  low.br ^consume
^consume:
  %next = s_add_u32 %accumulator, %value
  %advanced = s_add_u32 %index, %step
  low.br ^loop(%advanced: reg<amdgpu.sgpr>, %next: reg<amdgpu.sgpr>)
^exit:
  return %accumulator
}

