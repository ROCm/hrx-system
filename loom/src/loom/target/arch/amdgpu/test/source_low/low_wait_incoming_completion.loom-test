.Lbb1:
  s_cmp_lt_i32 s3, s2
  s_cbranch_scc0 .Lbb4
.Lbb2:
  v_add_u32 v4, v0, v0
  global_load_dword v4, v4, s[0:1] offset:0
.Lbb3:
  s_waitcnt vmcnt(0) lgkmcnt(15)
