// RUN: emit amdgpu-assembly @completed_lds_result

// LDS result completion survives the backedge just like VMEM completion.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @completed_lds_result(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
