// RUN: emit amdgpu-assembly @gfx1250_ds_pair_family

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @gfx1250_ds_pair_family(%address: reg<amdgpu.vgpr>, %data32_0: reg<amdgpu.vgpr>, %data32_1: reg<amdgpu.vgpr>, %data64_0: reg<amdgpu.vgpr x2>, %data64_1: reg<amdgpu.vgpr x2>) asm {
  %regular_b32 = ds_read2_b32 %address {offset1 = 2}
  ds_write2_b32 %address, %data32_0, %data32_1 {offset1 = 2}
  %regular_b64 = ds_read2_b64 %address {offset1 = 2}
  ds_write2_b64 %address, %data64_0, %data64_1 {offset1 = 2}
  %stride64_b32 = ds_read2st64_b32 %address {offset1 = 4}
  ds_write2st64_b32 %address, %data32_0, %data32_1 {offset1 = 4}
  %stride64_b64 = ds_read2st64_b64 %address {offset1 = 4}
  ds_write2st64_b64 %address, %data64_0, %data64_1 {offset1 = 4}
  return
}

// ----
  ds_read2_b32 v[8:9], v2 offset0:0 offset1:2
  s_wait_dscnt dscnt(0)
  ds_write2_b32 v2, v0, v1 offset0:0 offset1:2
  s_wait_dscnt dscnt(0)
  ds_read2_b64 v[8:11], v2 offset0:0 offset1:2
  s_wait_dscnt dscnt(0)
  ds_write2_b64 v2, v[4:5], v[6:7] offset0:0 offset1:2
  s_wait_dscnt dscnt(0)
  ds_read2st64_b32 v[8:9], v2 offset0:0 offset1:4
  s_wait_dscnt dscnt(0)
  ds_write2st64_b32 v2, v0, v1 offset0:0 offset1:4
  s_wait_dscnt dscnt(0)
  ds_read2st64_b64 v[8:11], v2 offset0:0 offset1:4
  s_wait_dscnt dscnt(0)
  ds_write2st64_b64 v2, v[4:5], v[6:7] offset0:0 offset1:4
  s_endpgm
