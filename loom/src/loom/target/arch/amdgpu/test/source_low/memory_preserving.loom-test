// ====

// A false conjunction does not identify which operand failed, so the row may
// remain in bounds. Descriptor zero fill cannot replace the source mask.
func.def @conjunctive_passthrough_preserved(%row0: index, %rows0: index, %column0: index, %input: buffer) -> (vector<4xi32>) {
  %row = index.assume %row0 [range(%row0, 0, 1023)] : index
  %rows = index.assume %rows0 [range(%rows0, 1, 1024)] : index
  %column = index.assume %column0 [range(%column0, 0, 7)] : index
  %base = index.constant 0 : offset
  %columns = index.constant 4 : index
  %descriptor = buffer.assume.memory_space<descriptor> %input : buffer
  %source = buffer.view %descriptor[%base] : buffer -> view<[%rows]x4xi32>
  %row_inside = index.cmp slt, %row, %rows : index
  %column_inside = index.cmp slt, %column, %columns : index
  %inside = scalar.andi %row_inside, %column_inside : i1
  %mask = vector.splat %inside : vector<4xi1>
  %passthrough_scalar = scalar.constant 0 : i32
  %passthrough = vector.splat %passthrough_scalar : vector<4xi32>
  %value = vector.load.mask %source[%row, 0], %mask, %passthrough : view<[%rows]x4xi32>, vector<4xi1>, vector<4xi32>
  func.return %value : vector<4xi32>
}

