  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %condition_view = resource<hal_binding> {extent = 64, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %old_view = resource<hal_binding> {extent = 1024, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 1024, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %condition_bits = global_load_u8_saddr %fixture_lane, %condition_view
  %31 = v_and_b32_src0_inline %condition_bits, 1
  %32 = v_mov_b32 1
  %condition = v_cmp_eq_i32 %31, %32
  %34 = v_lshlrev_b32_src0_inline %fixture_lane, 4
