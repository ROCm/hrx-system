// Private packets share the same fallback ownership contract as global/LDS.
func.def @private_words(%condition: i1, %initial: vector<2xi32>, %old: vector<2xi32>) -> (vector<2xi32>) {
  %base = index.constant 0 : offset
  %bytes = index.constant 8 : offset
