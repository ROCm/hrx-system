  %source = buffer.view %storage[%base] : buffer -> view<2xi32>
  vector.store %initial, %source[0] : vector<2xi32>, view<2xi32>
  %mask = vector.splat %condition : vector<2xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<2xi32>, vector<2xi1>, vector<2xi32>
  func.return %value : vector<2xi32>
}

