  %48 = copy %passthrough : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %50 = s_lshl_b32_rhs_inline %row, 4
  %51 = s_lshl_b32_rhs_inline %rows, 4
