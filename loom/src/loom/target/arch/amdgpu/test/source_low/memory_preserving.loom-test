// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A narrow header and a dynamically sized tail share a materialized record
// base. The tail's field bias belongs in its descriptor end even though the
// retained common prefix contains only the dynamic record address.
func.def @biased_tail_zero_fill(%row0: index, %rows0: index, %base_i32: i32, %input: buffer) -> (i32, vector<4xi32>) {
  %row = index.assume %row0 [range(%row0, 0, 1023)] : index
  %rows = index.assume %rows0 [range(%rows0, 1, 1024)] : index
  %base0 = index.cast %base_i32 : i32 to offset
  %base = index.assume %base0 [range(%base0, 0, 4096), multiple_of(%base0, 16)] : offset
  %bias = index.constant 16 : offset
  %tail = index.add %base, %bias : offset
  %descriptor = buffer.assume.memory_space<descriptor> %input : buffer
  %header = buffer.view %descriptor[%base] : buffer -> view<1xi32>
  %source = buffer.view %descriptor[%tail] : buffer -> view<[%rows]x4xi32>
  %header_value = view.load %header[0] : view<1xi32> -> i32
  %inside = index.cmp slt, %row, %rows : index
  %mask = vector.splat %inside : vector<4xi1>
  %passthrough_scalar = scalar.constant 0 : i32
  %passthrough = vector.splat %passthrough_scalar : vector<4xi32>
  %value = vector.load.mask %source[%row, 0], %mask, %passthrough : view<[%rows]x4xi32>, vector<4xi1>, vector<4xi32>
  func.return %header_value, %value : i32, vector<4xi32>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @biased_tail_zero_fill(%row: reg<amdgpu.sgpr>, %rows: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr x4>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %27 = v_mov_b32 0
  %28 = s_mov_b32 4
  %29 = s_add_u32 %base, %28
  %40 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %41 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %42 = s_mov_b32 65535
  %43 = s_and_b32 %41, %42
  %44 = concat(%40, %43) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %45 = s_mov_b32 822173696
  %46 = concat(%44, %29, %45) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %header_value = buffer_load_dword %46, %27, %base
  %33 = s_lshl_b32_rhs_inline %row, 4
  %34 = s_add_u32 %base, %33
  %35 = s_lshl_b32_rhs_inline %rows, 4
  %36 = s_add_u32 %base, %35
  %37 = s_add_u32_rhs_inline %36, 16
  %50 = s_and_b32 %41, %42
  %51 = concat(%40, %50) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %53 = concat(%51, %37, %45) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %value = buffer_load_b128 %53, %27, %34 {offset = 16}
  return %header_value, %value
}

// ====

// A vector wider than one native load retains separate ownership for both
// packets. Each fallback copy precedes its EXEC envelope, and each load owns
// that copy explicitly. The caller also observes the original fallback.
func.def @split_packed_load(%input: buffer, %condition: i1, %old: vector<20xi8>) -> (vector<20xi8>, vector<20xi8>) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<20xi8>
  %mask = vector.splat %condition : vector<20xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<20xi8>, vector<20xi1>, vector<20xi8>
  func.return %value, %old : vector<20xi8>, vector<20xi8>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @split_packed_load(%condition: reg<amdgpu.sgpr x2>, %old: reg<amdgpu.vgpr x5>) -> (reg<amdgpu.vgpr x5>, reg<amdgpu.vgpr x5>) asm {
  %source = resource<hal_binding> {extent = 20, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = slice %old[0] : reg<amdgpu.vgpr x5> -> reg<amdgpu.vgpr x4>
  %15 = copy %14 : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %16 = v_mov_b32 0
  %17, %18 = s_and_saveexec_b64 %condition
  %19 = global_load_b128_saddr_preserve %15, %16, %source
  s_mov_b64_exec %17
  %20 = slice %old[4] : reg<amdgpu.vgpr x5> -> reg<amdgpu.vgpr>
  %21 = copy %20 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %22, %23 = s_and_saveexec_b64 %condition
  %24 = global_load_b32_saddr_preserve %21, %16, %source {offset = 16}
  s_mov_b64_exec %22
  %value = concat(%19, %24) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x5>
  return %value, %old
}

// ====

// Halfword and byte packets need zero upper bits before packed assembly.
func.def @packed_tail(%input: buffer, %condition: i1, %old: vector<3xi8>) -> (vector<3xi8>, vector<3xi8>) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<3xi8>
  %mask = vector.splat %condition : vector<3xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<3xi8>, vector<3xi1>, vector<3xi8>
  func.return %value, %old : vector<3xi8>, vector<3xi8>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @packed_tail(%condition: reg<amdgpu.sgpr x2>, %old: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {extent = 3, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = v_bfe_u32_offset_width_inline %old {offset = 0, width = 16}
  %16 = copy %15 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %17 = v_mov_b32 0
  %18, %19 = s_and_saveexec_b64 %condition
  %20 = global_load_u16_saddr_preserve %16, %17, %source
  s_mov_b64_exec %18
  %22 = v_bfe_u32_offset_width_inline %old {offset = 16, width = 8}
  %23 = copy %22 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %24, %25 = s_and_saveexec_b64 %condition
  %26 = global_load_u8_saddr_preserve %23, %17, %source {offset = 2}
  s_mov_b64_exec %24
  %27 = v_lshlrev_b32_src0_inline %26, 16
  %value = v_or_b32 %20, %27
  return %value, %old
}

// ====

// An immutable uniform address still needs lane-predicated vector memory.
func.def @uniform_address(%input: buffer, %condition: i1, %old: vector<4xi32>) -> (vector<4xi32>) {
  %base = index.constant 0 : offset
  %constant_input = buffer.assume.memory_space<constant> %input : buffer
  %source = buffer.view %constant_input[%base] : buffer -> view<4xi32>
  %mask = vector.splat %condition : vector<4xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<4xi32>, vector<4xi1>, vector<4xi32>
  func.return %value : vector<4xi32>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @uniform_address(%condition: reg<amdgpu.sgpr x2>, %old: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %source = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = copy %old : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %15 = v_mov_b32 0
  %16, %17 = s_and_saveexec_b64 %condition
  %value = global_load_b128_saddr_preserve %14, %15, %source
  s_mov_b64_exec %16
  return %value
}

// ====

// A narrow floating carrier keeps its native low-half register contract.
func.def @generic_half(%input: buffer, %condition: i1, %old: vector<1xf16>) -> (vector<1xf32>) {
  %base = index.constant 0 : offset
  %generic = buffer.assume.memory_space<generic> %input : buffer
  %source = buffer.view %generic[%base] : buffer -> view<1xf16>
  %mask = vector.splat %condition : vector<1xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<1xf16>, vector<1xi1>, vector<1xf16>
  %wide = vector.extf %value : vector<1xf16> to vector<1xf32>
  func.return %wide : vector<1xf32>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @generic_half(%condition: reg<amdgpu.sgpr x2>, %old: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {extent = 2, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = v_bfe_u32_offset_width_inline %old {offset = 0, width = 16}
  %16 = copy %15 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %17 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %17
  %20 = v_mov_b32_copy %18
  %21 = concat(%19, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %22, %23 = s_and_saveexec_b64 %condition
  %value = flat_load_u16_preserve %16, %21
  s_mov_b64_exec %22
  %wide = v_cvt_f32_f16 %value
  return %wide
}

// ====

// Narrow LDS loads use unsigned carriers; sign repair runs after EXEC is
// restored so inactive fallback lanes participate in the repair too.
func.def @lds_signed_half(%condition: i1, %initial: vector<1xi16>, %old: vector<1xi16>) -> (vector<1xi32>) {
  %base = index.constant 0 : offset
  %bytes = index.constant 2 : offset
  %storage = buffer.alloca<workgroup> align(2) %bytes : buffer
  %source = buffer.view %storage[%base] : buffer -> view<1xi16>
  vector.store %initial, %source[0] : vector<1xi16>, view<1xi16>
  %mask = vector.splat %condition : vector<1xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<1xi16>, vector<1xi1>, vector<1xi16>
  %wide = vector.extsi %value : vector<1xi16> to vector<1xi32>
  func.return %wide : vector<1xi32>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @lds_signed_half(%condition: reg<amdgpu.sgpr x2>, %initial: reg<amdgpu.vgpr>, %old: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %15 = storage {byte_alignment = 2, byte_length = 2} : low.storage<workgroup>
  %17 = v_mov_b32 0
  ds_write_b16 %17, %initial
  %19 = v_bfe_i32_offset_width_inline %old {offset = 0, width = 16}
  %20 = copy %19 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %22, %23 = s_and_saveexec_b64 %condition
  %24 = ds_read_u16_preserve %20, %17
  s_mov_b64_exec %22
  %value = v_bfe_i32_offset_width_inline %24 {offset = 0, width = 16}
  %wide = v_bfe_i32_offset_width_inline %value {offset = 0, width = 16}
  return %wide
}

// ====

func.def @lds_signed_byte(%condition: i1, %initial: vector<1xi8>, %old: vector<1xi8>) -> (vector<1xi32>) {
  %base = index.constant 0 : offset
  %bytes = index.constant 1 : offset
  %storage = buffer.alloca<workgroup> align(1) %bytes : buffer
  %source = buffer.view %storage[%base] : buffer -> view<1xi8>
  vector.store %initial, %source[0] : vector<1xi8>, view<1xi8>
  %mask = vector.splat %condition : vector<1xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<1xi8>, vector<1xi1>, vector<1xi8>
  %wide = vector.extsi %value : vector<1xi8> to vector<1xi32>
  func.return %wide : vector<1xi32>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @lds_signed_byte(%condition: reg<amdgpu.sgpr x2>, %initial: reg<amdgpu.vgpr>, %old: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %15 = storage {byte_alignment = 1, byte_length = 1} : low.storage<workgroup>
  %17 = v_mov_b32 0
  ds_write_b8 %17, %initial
  %19 = v_bfe_i32_offset_width_inline %old {offset = 0, width = 8}
  %20 = copy %19 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %22, %23 = s_and_saveexec_b64 %condition
  %24 = ds_read_u8_preserve %20, %17
  s_mov_b64_exec %22
  %value = v_bfe_i32_offset_width_inline %24 {offset = 0, width = 8}
