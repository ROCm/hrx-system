low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @packed_tail(%condition: reg<amdgpu.sgpr x2>, %old: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {extent = 3, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = v_bfe_u32_offset_width_inline %old {offset = 0, width = 16}
  %16 = copy %15 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %17 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %17
  %20 = v_mov_b32_copy %18
  %21 = concat(%19, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %22, %23 = s_and_saveexec_b64 %condition
  %24 = global_load_u16_vaddr_preserve %16, %21
  s_mov_b64_exec %22
  %26 = v_bfe_u32_offset_width_inline %old {offset = 16, width = 8}
  %27 = copy %26 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %28 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30 = v_mov_b32_copy %28
  %31 = v_mov_b32_copy %29
  %32 = concat(%30, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %33, %34 = s_and_saveexec_b64 %condition
  %35 = global_load_u8_vaddr_preserve %27, %32 {offset = 2}
  s_mov_b64_exec %33
  %36 = v_lshlrev_b32_src0_inline %35, 16
  %value = v_or_b32 %24, %36
  return %value, %old
}

// ====

// An immutable uniform address still needs lane-predicated vector memory.
kernel.def @uniform_address() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %condition_buffer: buffer, %old_buffer: buffer, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %condition_view = buffer.view %condition_buffer[%fixture_base] : buffer -> view<64xi8>
  %condition_bits = view.load %condition_view[%fixture_lane] : view<64xi8> -> i8
  %condition = scalar.trunci %condition_bits : i8 to i1
  %old_view = buffer.view %old_buffer[%fixture_base] : buffer -> view<64x4xi32>
  %old = vector.load %old_view[%fixture_lane, 0] : view<64x4xi32> -> vector<4xi32>
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64x4xi32>
  %base = index.constant 0 : offset
  %constant_input = buffer.assume.memory_space<constant> %input : buffer
  %source = buffer.view %constant_input[%base] : buffer -> view<4xi32>
  %mask = vector.splat %condition : vector<4xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<4xi32>, vector<4xi1>, vector<4xi32>
  vector.store %value, %result_view_0[%fixture_lane, 0] : vector<4xi32>, view<64x4xi32>
  kernel.return
}

