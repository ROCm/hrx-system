// ====

// A strided view needs a stronger address proof than the dense row boundary.
// It retains the source mask even when the passthrough is positive zero.
func.def @strided_passthrough_preserved(%row0: index, %rows0: index, %input: buffer) -> (vector<4xi32>) {
  %row = index.assume %row0 [range(%row0, 0, 1023)] : index
  %rows = index.assume %rows0 [range(%rows0, 1, 1024)] : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %descriptor = buffer.assume.memory_space<descriptor> %input : buffer
  %source = buffer.view %descriptor[%base] : buffer -> view<[%rows]x4xi32, %layout>
  %inside = index.cmp slt, %row, %rows : index
  %mask = vector.splat %inside : vector<4xi1>
  %passthrough_scalar = scalar.constant 0 : i32
  %passthrough = vector.splat %passthrough_scalar : vector<4xi32>
  %value = vector.load.mask %source[%row, 0], %mask, %passthrough : view<[%rows]x4xi32, %layout>, vector<4xi1>, vector<4xi32>
  func.return %value : vector<4xi32>
}

