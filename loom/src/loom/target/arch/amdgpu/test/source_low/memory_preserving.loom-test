// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A narrow header and a dynamically sized tail share a materialized record
// base. The tail's field bias belongs in its descriptor end even though the
// retained common prefix contains only the dynamic record address.
kernel.def @biased_tail_zero_fill() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%row0: index, %rows0: index, %base_i32: i32, %input: buffer, %result_buffer_0: buffer, %result_buffer_1: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi32>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64x4xi32>
  %row = index.assume %row0 [range(%row0, 0, 1023)] : index
  %rows = index.assume %rows0 [range(%rows0, 1, 1024)] : index
  %base0 = index.cast %base_i32 : i32 to offset
  %base = index.assume %base0 [range(%base0, 0, 4096), multiple_of(%base0, 16)] : offset
  %bias = index.constant 16 : offset
  %tail = index.add %base, %bias : offset
  %descriptor = buffer.assume.memory_space<descriptor> %input : buffer
  %header = buffer.view %descriptor[%base] : buffer -> view<1xi32>
  %source = buffer.view %descriptor[%tail] : buffer -> view<[%rows]x4xi32>
  %header_value = view.load %header[0] : view<1xi32> -> i32
  %inside = index.cmp slt, %row, %rows : index
  %mask = vector.splat %inside : vector<4xi1>
  %passthrough = vector.splati 0 : vector<4xi32>
  %value = vector.load.mask %source[%row, 0], %mask, %passthrough : view<[%rows]x4xi32>, vector<4xi1>, vector<4xi32>
  view.store %header_value, %result_view_0[%fixture_lane] : i32, view<64xi32>
  vector.store %value, %result_view_1[%fixture_lane, 0] : vector<4xi32>, view<64x4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 3, direct_arg_count = 3, direct_arg_names = {arg0 = "row0", arg1 = "rows0", arg2 = "base_i32"}, direct_arg_offsets = [0, 4, 8], direct_arg_parameter_indices = [0, 1, 2], direct_arg_sizes = [4, 4, 4], parameter_count = 6, resource_count = 3, resource_offsets = [16, 24, 32], resource_parameter_indices = [3, 4, 5], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @biased_tail_zero_fill(%row: reg<amdgpu.sgpr>, %rows: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 1024, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %36 = v_mov_b32 0
  %37 = s_mov_b32 4
  %38 = s_add_u32 %base, %37
  %51 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %52 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %53 = s_mov_b32 65535
  %54 = s_and_b32 %52, %53
  %55 = concat(%51, %54) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %56 = s_mov_b32 822173696
  %57 = concat(%55, %38, %56) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %header_value = buffer_load_dword %57, %36, %base
  %42 = s_lshl_b32_rhs_inline %row, 4
  %43 = s_add_u32 %base, %42
  %44 = s_lshl_b32_rhs_inline %rows, 4
  %45 = s_add_u32 %base, %44
  %46 = s_add_u32_rhs_inline %45, 16
  %62 = concat(%51, %54) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %64 = concat(%62, %46, %56) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %value = buffer_load_b128 %64, %36, %43 {offset = 16}
  %49 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %49, %header_value, %result_view_0
  %50 = v_lshlrev_b32_src0_inline %fixture_lane, 4
  global_store_b128_saddr %50, %value, %result_view_1
  return
}

// ====

// A vector wider than one native load retains separate ownership for both
// packets. Each fallback copy precedes its EXEC envelope, and each load owns
// that copy explicitly. The caller also observes the original fallback.
func.def @split_packed_load(%input: buffer, %condition: i1, %old: vector<20xi8>) -> (vector<20xi8>, vector<20xi8>) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<20xi8>
  %mask = vector.splat %condition : vector<20xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<20xi8>, vector<20xi1>, vector<20xi8>
  func.return %value, %old : vector<20xi8>, vector<20xi8>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @split_packed_load(%condition: reg<amdgpu.sgpr x2>, %old: reg<amdgpu.vgpr x5>) -> (reg<amdgpu.vgpr x5>, reg<amdgpu.vgpr x5>) asm {
  %source = resource<hal_binding> {extent = 20, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = slice %old[0] : reg<amdgpu.vgpr x5> -> reg<amdgpu.vgpr x4>
  %15 = copy %14 : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %16 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %16
  %19 = v_mov_b32_copy %17
  %20 = concat(%18, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %21, %22 = s_and_saveexec_b64 %condition
  %23 = global_load_b128_vaddr_preserve %15, %20
  s_mov_b64_exec %21
  %24 = slice %old[4] : reg<amdgpu.vgpr x5> -> reg<amdgpu.vgpr>
  %25 = copy %24 : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %26 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = v_mov_b32_copy %26
  %29 = v_mov_b32_copy %27
  %30 = concat(%28, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %31, %32 = s_and_saveexec_b64 %condition
  %33 = global_load_b32_vaddr_preserve %25, %30 {offset = 16}
  s_mov_b64_exec %31
  %value = concat(%23, %33) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x5>
  return %value, %old
}

// ====

// Halfword and byte packets need zero upper bits before packed assembly.
func.def @packed_tail(%input: buffer, %condition: i1, %old: vector<3xi8>) -> (vector<3xi8>, vector<3xi8>) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<3xi8>
  %mask = vector.splat %condition : vector<3xi1>
  %value = vector.load.mask %source[0], %mask, %old : view<3xi8>, vector<3xi1>, vector<3xi8>
  func.return %value, %old : vector<3xi8>, vector<3xi8>
}

