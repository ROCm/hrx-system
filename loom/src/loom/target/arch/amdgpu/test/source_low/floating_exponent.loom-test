// RUN: emit source-low target=amdgpu:gfx942 output=low
func.def @scalar_half(%input: f16, %power: i32) -> (f16, i32, f16) {
  %fraction, %exponent = scalar.frexpf %input : f16, i32
  %scaled = scalar.ldexpf %input, %power : f16, i32
  func.return %fraction, %exponent, %scaled : f16, i32, f16
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @scalar_half(%input: reg<amdgpu.vgpr>, %power: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %fraction = v_frexp_mant_f16 %input
  %14 = v_frexp_exp_i16_f16 %input
  %exponent = v_bfe_i32_offset_0_width_inline_low16 %14
  %16 = v_max_i32_lit %power, 4294967232
  %17 = v_min_i32_src0_inline %16, 64
  %scaled = v_ldexp_f16 %input, %17
  %19 = v_bfe_u32_offset_0_width_inline_low16 %fraction
  %20 = v_bfe_u32_offset_0_width_inline_low16 %scaled
  return %19, %exponent, %20
}

