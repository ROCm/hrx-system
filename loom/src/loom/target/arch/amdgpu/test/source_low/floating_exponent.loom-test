  %fraction = concat(%14, %16) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %19 = v_frexp_exp_i32_f32 %13
  %21 = v_frexp_exp_i32_f32 %15
  %exponent = concat(%19, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
