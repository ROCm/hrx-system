low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(2, 1, 1) workgroup_count(1, 1, 1) @lane_varying_branches_remain_distinct() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %output_view = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = storage {byte_alignment = 16, byte_length = 512} : low.storage<workgroup>
  %is_first = v_cmp_eq_i32_src1_inline %lane {rhs = 0}
  %21, %22 = s_and_saveexec_b64 %is_first
  low.cond_br %22, ^first, ^_bb3 : reg<amdgpu.scc>
^first:
  %25 = v_mov_b32 1
  %26 = v_mov_b32 0
  ds_write_b32 %26, %25
  %first_result = ds_read_b32 %26
  %29 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %29, %first_result, %output_view
  low.br ^_bb3
^_bb3:
  %23 = s_xor_b64_exec %21
  low.cond_br %23, ^second, ^_bb4 : reg<amdgpu.scc>
^second:
  %31 = v_mov_b32 1
  %32 = v_mov_b32 0
  ds_write_b32 %32, %31 {offset = 256}
  %second_result = ds_read_b32 %32 {offset = 256}
  %35 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %35, %second_result, %output_view
  low.br ^_bb4
^_bb4:
  s_mov_b64_exec %21
  return
}

