// A typed but footprint-free root must not increase physical Workgroup
// storage or its alignment.
kernel.def target(@target) @unused_root_does_not_inflate_arena() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %unused_bytes = index.constant 32768 : offset
  %live_bytes = index.constant 64 : offset
  %value = scalar.constant 1 : i32
  %unused = buffer.alloca<workgroup> align(256) %unused_bytes : buffer
  %unused_view = buffer.view %unused[%base] : buffer -> view<1xi32>
  %live = buffer.alloca<workgroup> align(16) %live_bytes : buffer
  %live_view = buffer.view %live[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %value, %live_view[0] : i32, view<1xi32>
  %result = view.load %live_view[0] : view<1xi32> -> i32
  view.store %result, %output_view[0] : i32, view<1xi32>
  kernel.return
}

