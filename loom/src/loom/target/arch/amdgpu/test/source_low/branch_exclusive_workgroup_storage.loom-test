low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sequential_allocations_remain_distinct() asm {
  %output_view = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = storage {byte_alignment = 16, byte_length = 384} : low.storage<workgroup>
  %20 = v_mov_b32 1
  %21 = v_mov_b32 0
  ds_write_b32 %21, %20
  %22 = v_mov_b32 2
  ds_write_b32 %21, %22 {offset = 128}
  %first_result = ds_read_b32 %21
  %second_result = ds_read_b32 %21 {offset = 128}
  global_store_b32_saddr %21, %first_result, %output_view
  global_store_b32_saddr %21, %second_result, %output_view {offset = 4}
  return
}

// ====

amdgpu.target<gfx11-generic> @target

// A cyclic controller may select both alternatives on different iterations.
kernel.def target(@target) @cyclic_branch_allocations_remain_distinct() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %loop_begin = scalar.constant 0 : i32
  %loop_step = scalar.constant 1 : i32
  %loop_end = scalar.constant 2 : i32
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %value = scalar.constant 1 : i32
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2xi32>
  cfg.br ^loop(%loop_begin: i32)
^loop(%i: i32):
  %in_range = scalar.cmpi ult, %i, %loop_end : i32
  cfg.cond_br %in_range, ^body, ^done
^body:
  %is_first = scalar.cmpi eq, %i, %loop_begin : i32
  cfg.cond_br %is_first, ^first, ^second
^first:
  %first_scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_result = view.load %first_view[0] : view<1xi32> -> i32
  view.store %first_result, %output_view[0] : i32, view<2xi32>
  cfg.br ^continue
^second:
  %second_scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_result = view.load %second_view[0] : view<1xi32> -> i32
  view.store %second_result, %output_view[1] : i32, view<2xi32>
  cfg.br ^continue
^continue:
  %next = scalar.addi %i, %loop_step : i32
  cfg.br ^loop(%next: i32)
^done:
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @cyclic_branch_allocations_remain_distinct() asm {
  %output_view = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %21 = storage {byte_alignment = 16, byte_length = 512} : low.storage<workgroup>
  %loop_begin = s_mov_b32 0
  %loop_step = s_mov_b32 1
  %loop_end = s_mov_b32 2
  low.br ^loop(%loop_begin: reg<amdgpu.sgpr>)
^loop(%i: reg<amdgpu.sgpr>):
  %in_range = s_cmp_lt_u32 %i, %loop_end
  low.cond_br %in_range, ^body, ^done : reg<amdgpu.scc>
^body:
  %is_first = s_cmp_eq_i32 %i, %loop_begin
  low.cond_br %is_first, ^first, ^second : reg<amdgpu.scc>
^first:
  %28 = v_mov_b32 1
  %29 = v_mov_b32 0
