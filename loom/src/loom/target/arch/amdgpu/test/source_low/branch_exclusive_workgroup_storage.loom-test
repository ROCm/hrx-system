// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// Concurrent 10 KiB allocations occupy adjacent ranges. A later 32 KiB
// allocation reuses both ranges after a workgroup barrier, so the arena is
// exactly the 32 KiB peak live extent instead of the sum of all allocations.
kernel.def target(@target) @barrier_phases_pack_peak_live_bytes() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %buffer_base = index.constant 0 : offset
  %first_phase_bytes = index.constant 10240 : offset
  %second_phase_bytes = index.constant 32768 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %third_value = scalar.constant 3 : i32
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<3xi32>
  %first = buffer.alloca<workgroup> align(16) %first_phase_bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %first_phase_bytes : buffer
  %first_view = buffer.view %first[%buffer_base] : buffer -> view<1xi32>
  %second_view = buffer.view %second[%buffer_base] : buffer -> view<1xi32>
  view.store %first_value, %first_view[0] : i32, view<1xi32>
  view.store %second_value, %second_view[0] : i32, view<1xi32>
  %first_result = view.load %first_view[0] : view<1xi32> -> i32
  %second_result = view.load %second_view[0] : view<1xi32> -> i32
  view.store %first_result, %output_view[0] : i32, view<3xi32>
  view.store %second_result, %output_view[1] : i32, view<3xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %third = buffer.alloca<workgroup> align(16) %second_phase_bytes : buffer
  %third_view = buffer.view %third[%buffer_base] : buffer -> view<1xi32>
  view.store %third_value, %third_view[0] : i32, view<1xi32>
  %third_result = view.load %third_view[0] : view<1xi32> -> i32
  view.store %third_result, %output_view[2] : i32, view<3xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @barrier_phases_pack_peak_live_bytes() asm {
  %output_view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = storage {byte_alignment = 16, byte_length = 32768} : low.storage<workgroup>
  %25 = v_mov_b32 1
  %26 = v_mov_b32 0
  ds_write_b32 %26, %25
  %27 = v_mov_b32 2
  ds_write_b32 %26, %27 {offset = 10240}
  %first_result = ds_read_b32 %26
  %second_result = ds_read_b32 %26 {offset = 10240}
  global_store_b32_saddr %26, %first_result, %output_view
  global_store_b32_saddr %26, %second_result, %output_view {offset = 4}
  s_waitcnt {lgkmcnt = 0}
  %36 = v_mov_b32 3
  ds_write_b32 %26, %36
  %third_result = ds_read_b32 %26
  global_store_b32_saddr %26, %third_result, %output_view {offset = 8}
  return
}

// ====

amdgpu.target<gfx11-generic> @target

// Workgroup-uniform alternatives overlap at the arena base.
kernel.def target(@target) @branch_exclusive_equal_slots() {
  %unit = index.constant 1 : index
  %workgroup_count = index.constant 2 : index
  kernel.launch.config workgroups(%workgroup_count, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %workgroup = kernel.workgroup.id<x> : index
  %first_workgroup = index.constant 0 : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %value = scalar.constant 1 : i32
  %is_first = index.cmp eq, %workgroup, %first_workgroup : index
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2xi32>
  cfg.cond_br %is_first, ^first, ^second
^first:
  %first_scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  cfg.br ^first_body
^first_body:
  %first_view = buffer.view %first_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_result = view.load %first_view[0] : view<1xi32> -> i32
  view.store %first_result, %output_view[%workgroup] : i32, view<2xi32>
  cfg.br ^done
^second:
  %second_scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  cfg.br ^second_body
^second_body:
  %second_view = buffer.view %second_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_result = view.load %second_view[0] : view<1xi32> -> i32
  view.store %second_result, %output_view[%workgroup] : i32, view<2xi32>
  cfg.br ^done
^done:
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(2, 1, 1) @branch_exclusive_equal_slots() asm {
  %workgroup = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %output_view = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = storage {byte_alignment = 16, byte_length = 256} : low.storage<workgroup>
  %first_workgroup = s_mov_b32 0
  %is_first = s_cmp_eq_i32 %workgroup, %first_workgroup
  low.cond_br %is_first, ^first, ^second : reg<amdgpu.scc>
^first:
  %23 = v_mov_b32 1
  %24 = v_mov_b32 0
  ds_write_b32 %24, %23
  %first_result = ds_read_b32 %24
  %28 = s_lshl_b32_rhs_inline %workgroup, 2
  %29 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32, %33 = s_add_co_u32 %29, %28
  %34, %35 = s_addc_u32 %30, %first_workgroup, %33
  %36 = concat(%32, %34) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %24, %first_result, %36
  low.br ^done
^second:
  %38 = v_mov_b32 1
  %39 = v_mov_b32 0
  ds_write_b32 %39, %38
  %second_result = ds_read_b32 %39
  %43 = s_lshl_b32_rhs_inline %workgroup, 2
  %44 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47, %48 = s_add_co_u32 %44, %43
  %49, %50 = s_addc_u32 %45, %first_workgroup, %48
  %51 = concat(%47, %49) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %39, %second_result, %51
  low.br ^done
^done:
  return
}

