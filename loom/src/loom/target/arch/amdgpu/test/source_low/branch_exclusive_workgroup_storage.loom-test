  %workgroup = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %output_view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %25 = storage {byte_alignment = 64, byte_length = 256} : low.storage<workgroup>
  %first_workgroup = s_mov_b32 0
  %second_workgroup = s_mov_b32 1
  %is_first = s_cmp_eq_i32 %workgroup, %first_workgroup
  low.cond_br %is_first, ^first, ^not_first : reg<amdgpu.scc>
^first:
  %31 = v_mov_b32 1
  %32 = v_mov_b32 0
  ds_write_b32 %32, %31
  %first_result = ds_read_b32 %32
  %36 = s_lshl_b32_rhs_inline %workgroup, 2
  %37 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %40, %41 = s_add_co_u32 %37, %36
  %42, %43 = s_addc_u32 %38, %first_workgroup, %41
  %44 = concat(%40, %42) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %32, %first_result, %44
  low.br ^done
^not_first:
  %is_second = s_cmp_eq_i32 %workgroup, %second_workgroup
  low.cond_br %is_second, ^second, ^third : reg<amdgpu.scc>
^second:
  %47 = v_mov_b32 1
  %48 = v_mov_b32 0
  ds_write_b32 %48, %47
  %second_result = ds_read_b32 %48
  %52 = s_lshl_b32_rhs_inline %workgroup, 2
  %53 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %56, %57 = s_add_co_u32 %53, %52
  %58, %59 = s_addc_u32 %54, %first_workgroup, %57
  %60 = concat(%56, %58) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %48, %second_result, %60
  low.br ^done
^third:
  %62 = v_mov_b32 1
  %63 = v_mov_b32 0
  ds_write_b32 %63, %62
  %third_result = ds_read_b32 %63
  %67 = s_lshl_b32_rhs_inline %workgroup, 2
  %68 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %69 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %71, %72 = s_add_co_u32 %68, %67
  %73, %74 = s_addc_u32 %69, %first_workgroup, %72
  %75 = concat(%71, %73) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %63, %third_result, %75
  low.br ^done
^done:
  return
}

