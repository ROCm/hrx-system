// The joined block can execute after either arm. Inherited control alternatives
// are possible paths, not a proof that these allocations exclude each other.
kernel.def target(@target) @partially_reconverged_allocations_remain_distinct(%outer: index, %inner: index) {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%outer: index, %inner: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %first_arm = index.cmp ne, %outer, %c0 : index
  %continue_left = index.cmp ne, %inner, %c0 : index
  %continue_right = index.cmp eq, %inner, %c0 : index
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2xi32>
  cfg.cond_br %first_arm, ^left, ^right
^left:
  %first_scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %first_value, %first_view[0] : i32, view<1xi32>
  %first_result = view.load %first_view[0] : view<1xi32> -> i32
  view.store %first_result, %output_view[0] : i32, view<2xi32>
  cfg.cond_br %continue_left, ^joined, ^done
^right:
  cfg.cond_br %continue_right, ^joined, ^done
^joined:
  %second_scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %second_value, %second_view[0] : i32, view<1xi32>
  %second_result = view.load %second_view[0] : view<1xi32> -> i32
  view.store %second_result, %output_view[1] : i32, view<2xi32>
  cfg.br ^done
^done:
  kernel.return
}

