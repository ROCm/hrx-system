amdgpu.target<gfx11-generic> @target

// Nested alternatives share an arena sized and aligned for the largest arm.
kernel.def target(@target) @branch_exclusive_nested_max_slot() {
  %unit = index.constant 1 : index
  %workgroup_count = index.constant 3 : index
  kernel.launch.config workgroups(%workgroup_count, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %workgroup = kernel.workgroup.id<x> : index
  %first_workgroup = index.constant 0 : index
  %second_workgroup = index.constant 1 : index
  %buffer_base = index.constant 0 : offset
  %small_bytes = index.constant 128 : offset
  %large_bytes = index.constant 256 : offset
  %medium_bytes = index.constant 192 : offset
  %value = scalar.constant 1 : i32
  %is_first = index.cmp eq, %workgroup, %first_workgroup : index
  %is_second = index.cmp eq, %workgroup, %second_workgroup : index
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<3xi32>
  cfg.cond_br %is_first, ^first, ^not_first
^first:
  %first_scratch = buffer.alloca<workgroup> align(16) %small_bytes : buffer
  %first_view = buffer.view %first_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_result = view.load %first_view[0] : view<1xi32> -> i32
  view.store %first_result, %output_view[%workgroup] : i32, view<3xi32>
  cfg.br ^done
^not_first:
  cfg.cond_br %is_second, ^second, ^third
^second:
  %second_scratch = buffer.alloca<workgroup> align(64) %large_bytes : buffer
  %second_view = buffer.view %second_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_result = view.load %second_view[0] : view<1xi32> -> i32
  view.store %second_result, %output_view[%workgroup] : i32, view<3xi32>
  cfg.br ^done
^third:
  %third_scratch = buffer.alloca<workgroup> align(32) %medium_bytes : buffer
  %third_view = buffer.view %third_scratch[%buffer_base] : buffer -> view<1xi32>
  view.store %value, %third_view[0] : i32, view<1xi32>
  %third_result = view.load %third_view[0] : view<1xi32> -> i32
  view.store %third_result, %output_view[%workgroup] : i32, view<3xi32>
  cfg.br ^done
^done:
  kernel.return
}

