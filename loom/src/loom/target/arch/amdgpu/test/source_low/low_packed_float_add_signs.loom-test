// RUN: emit amdgpu-native-words @packed_signs waits=none strategy=source

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @packed_signs(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  %sum = v_pk_add_f16 %lhs, %rhs
  %difference = v_pk_add_f16 %lhs, %rhs {neg_lo = 2, neg_hi = 2}
  %reverse = v_pk_add_f16 %lhs, %rhs {neg_lo = 1, neg_hi = 1}
  %mixed = v_pk_add_f16 %lhs, %rhs {neg_lo = 3}
  return
}

