// RUN: pass target-legalize{mode=final}

// Final legalization requires an execution mode for collective lowering.
// An unbound target must produce a diagnostic, not choose a mode or assert.
amdgpu.target<gfx11-generic> @unbound

kernel.def target(@unbound) @unresolved_width() {
  %unit = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%value: f32, %output: buffer) {
  // ERROR@+1: AMDGPU/023 {constraint_key="workgroup_reduce.wavefront_size"}
  %sum = kernel.workgroup.reduce<addf> %value : f32
  %base_offset = index.constant 0 : offset
  %view = buffer.view %output[%base_offset] : buffer -> view<1xf32>
  view.store %sum, %view[0] : f32, view<1xf32>
  kernel.return
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @index_uniform_madd(%row_i32: i32, %column_i32: i32) -> (index) {
  %row_index = index.cast %row_i32 : i32 to index
  %column_index = index.cast %column_i32 : i32 to index
  %row = index.assume %row_index [range(%row_index, 0, 7)] : index
  %column = index.assume %column_index [range(%column_index, 0, 6)] : index
  %row_stride = index.constant 7 : index
  %linear = index.madd %row, %row_stride, %column : index
  func.return %linear : index
}

// ====

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @subgroup_match_all_f32_rejected() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch() {
  %value = scalar.constant 1.0 : f32
  // ERROR@+1: AMDGPU/023 {constraint_key="subgroup_match.target_legalization"}
  %mask, %all = kernel.subgroup.match.all %value : f32 -> i32, i1
  cfg.cond_br %all, ^then, ^else
^then:
  kernel.return
^else:
  kernel.return
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @floating_atomic_add_reference(%input: buffer, %index: index, %reduce_delta: f32, %rmw_delta: f32) -> (f32) {
  %base = index.constant 0 : offset
  %bounded_index = index.assume %index [range(%index, 0, 15)] : index
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%base] : buffer -> view<16xf32>
  view.atomic.reduce<addf> %reduce_delta, %view[%bounded_index] {ordering = release, scope = device} : f32, view<16xf32>
  %old = view.atomic.rmw<addf> %rmw_delta, %view[3] {ordering = acq_rel, scope = device} : f32, view<16xf32> -> f32
  func.return %old : f32
}

// ----
amdgpu.target<gfx11-generic> @target

func.def target(@target) @floating_atomic_add_reference(%input: buffer, %index: index, %reduce_delta: f32, %rmw_delta: f32) -> (f32) {
  %base = index.constant 0 : offset
  %bounded_index = index.assume %index [range(%index, 0, 15)] : index
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%base] : buffer -> view<16xf32>
  %19 = scalar.constant 0.0 : f32
  %22 = scf.while(%20 = %19 : f32) -> (f32) {
    %23 = scalar.addf %20, %reduce_delta : f32
    %24 = view.atomic.cmpxchg %20, %23, %view[%bounded_index] {failure_ordering = relaxed, scope = device, success_ordering = release} : f32, view<16xf32> -> f32
    %25 = scalar.bitcast %20 : f32 to i32
    %26 = scalar.bitcast %24 : f32 to i32
    %27 = scalar.cmpi ne, %26, %25 : i32
    scf.condition %27, %24 : i1, f32
  } do(%21: f32) {
    scf.yield %21 : f32
  }
  %10 = scalar.constant 0.0 : f32
  %old = scf.while(%11 = %10 : f32) -> (f32) {
    %14 = scalar.addf %11, %rmw_delta : f32
    %15 = view.atomic.cmpxchg %11, %14, %view[3] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : f32, view<16xf32> -> f32
    %16 = scalar.bitcast %11 : f32 to i32
    %17 = scalar.bitcast %15 : f32 to i32
    %18 = scalar.cmpi ne, %17, %16 : i32
    scf.condition %18, %15 : i1, f32
  } do(%12: f32) {
    scf.yield %12 : f32
  }
  func.return %old : f32
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @hadamard_transform(%input: vector<4xf32>) -> (vector<4xf32>) {
  %transform = encoding.define #transform.hadamard : encoding<transform>
  %result = vector.transform %input, %transform : vector<4xf32>, encoding<transform> -> vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def target(@target) @hadamard_transform(%input: vector<4xf32>) -> (vector<4xf32>) {
  %transform = encoding.define #transform.hadamard : encoding<transform>
  %result = vector.transform %input, %transform : vector<4xf32>, encoding<transform> -> vector<4xf32>
  func.return %result : vector<4xf32>
}

// ====
// RUN: pass target-legalize{mode=eager},target-legalize{mode=eager}

// Address aggregates have no ordinary AMDGPU vector carrier. Their exact
// scalar partition survives legalization for projections or a final target
// diagnostic; it must not cycle between constructors and insertions.
amdgpu.target<gfx1100> @target

func.def target(@target) @logical_address_construction(%a: offset, %b: offset, %c: offset, %replacement: offset) -> (vector<3xoffset>) {
  %values = vector.from_elements %a, %b, %c : vector<3xoffset>
  %result = vector.insert %replacement into %values[1] : offset, vector<3xoffset>
  func.return %result : vector<3xoffset>
}

// ----
amdgpu.target<gfx1100> @target

func.def target(@target) @logical_address_construction(%a: offset, %b: offset, %c: offset, %replacement: offset) -> (vector<3xoffset>) {
  %result = vector.from_elements %a, %replacement, %c : vector<3xoffset>
  func.return %result : vector<3xoffset>
}

// ====
// RUN: pass target-legalize{mode=final},target-legalize{mode=final}

// Native construction still reaches the target's ordinary register vector.
amdgpu.target<gfx1100> @target

func.def target(@target) @native_integer_construction(%a: i32, %b: i32, %replacement: i32) -> (vector<2xi32>) {
  %values = vector.from_elements %a, %b : vector<2xi32>
  %result = vector.insert %replacement into %values[1] : i32, vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
amdgpu.target<gfx1100> @target

func.def target(@target) @native_integer_construction(%a: i32, %b: i32, %replacement: i32) -> (vector<2xi32>) {
  %values = vector.from_elements %a, %b : vector<2xi32>
  %result = vector.insert %replacement into %values[1] : i32, vector<2xi32>
  func.return %result : vector<2xi32>
}

// ====
// RUN: emit source-low target=amdgpu:gfx1100 output=low

// A live non-native aggregate reaches precise target diagnostics instead of
// repeatedly reconstructing itself while legalizing the subgroup operand.
kernel.def @rejected_address_payload() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32x3xi32>
  %destination = buffer.view %output[%base] : buffer -> view<32x3xi64>
  %left = view.load %source[%lane, 0] : view<32x3xi32> -> i32
  %middle = view.load %source[%lane, 1] : view<32x3xi32> -> i32
  %right = view.load %source[%lane, 2] : view<32x3xi32> -> i32
  %a = index.cast %left : i32 to offset
  %b = index.cast %middle : i32 to offset
  %c = index.cast %right : i32 to offset
  // ERROR@+1: TARGET/002 {field_name="result", actual_type="vector<3xoffset>"}
  %values = vector.from_elements %a, %b, %c : vector<3xoffset>
  // ERROR@+1: AMDGPU/023 {constraint_key="subgroup_broadcast_first.payload"}
  %first = kernel.subgroup.broadcast.first %values : vector<3xoffset>
  // ERROR@+3: TARGET/002 {field_name="source", actual_type="vector<3xoffset>"}
  // ERROR@+2: TARGET/002 {field_name="source", actual_type="vector<3xoffset>"}
  // ERROR@+1: TARGET/002 {field_name="source", actual_type="vector<3xoffset>"}
  %bits = vector.index_cast %first : vector<3xoffset> to vector<3xi64>
  vector.store %bits, %destination[%lane, 0] : vector<3xi64>, view<32x3xi64>
  kernel.return
}
