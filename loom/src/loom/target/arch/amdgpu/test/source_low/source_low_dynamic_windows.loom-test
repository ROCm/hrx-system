// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// A runtime leading coordinate selects one complete shaped tail. The source
// and result cross native memory-packet boundaries without materializing the
// unused plane.
func.def @dynamic_shaped_tail(%trial0: index, %input: buffer, %output: buffer) {
  %trial = index.assume %trial0 [range(%trial0, 0, 1)] : index
  %base = index.constant 0 : offset
  %source_view = buffer.view %input[%base] : buffer -> view<2x3x4xi16, align(1)>
  %result_view = buffer.view %output[%base] : buffer -> view<3x4xi16, align(1)>
  %source = vector.load %source_view[0, 0, 0] : view<2x3x4xi16, align(1)> -> vector<2x3x4xi16>
  %result = vector.extract %source[%trial] : vector<2x3x4xi16> -> vector<3x4xi16>
  vector.store %result, %result_view[0, 0] : vector<3x4xi16>, view<3x4xi16, align(1)>
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @dynamic_shaped_tail(%trial: reg<amdgpu.vgpr>) asm {
  %source_view = resource<hal_binding> {extent = 48, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view = resource<hal_binding> {extent = 24, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %27 = v_mov_b32 24
  %28 = v_mul_lo_u32 %trial, %27
  %29 = v_mul_hi_u32 %trial, %27
  %30 = slice %source_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = slice %source_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32, %33 = v_add_co_u32 %30, %28
  %34 = v_mov_b32_copy %31
  %35, %36 = v_add_co_ci_u32 %34, %29, %33
  %37 = concat(%32, %35) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %38 = global_load_b128_vaddr %37
  %49 = concat(%32, %35) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %50 = global_load_b64_vaddr %49 {offset = 16}
  %53 = slice %result_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = slice %result_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %55 = v_mov_b32_copy %53
  %56 = v_mov_b32_copy %54
  %57 = concat(%55, %56) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr %57, %38
  %63 = concat(%55, %56) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_vaddr %63, %50 {offset = 16}
  return
}

// ====

// The packed history remains one row-major carrier across the loop boundary.
// Each iteration drops the oldest row and appends one four-lane row.
func.def @packed_history_loop(%initial: vector<9x4xbf16>, %current: vector<4xbf16>, %end: index) -> (vector<9x4xbf16>, vector<4xbf16>, vector<4xbf16>, vector<4xbf16>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %final = scf.for %iteration = [%begin to %end step %step](%old = %initial : vector<9x4xbf16>) -> (vector<9x4xbf16>) {
    %tail = vector.slice %old[1, 0] : vector<9x4xbf16> -> vector<8x4xbf16>
    %row = vector.broadcast %current : vector<4xbf16> -> vector<1x4xbf16>
    %next = vector.concat<0> %tail, %row : vector<8x4xbf16>, vector<1x4xbf16> -> vector<9x4xbf16>
    scf.yield %next : vector<9x4xbf16>
  }
  %row0 = vector.extract %final[0] : vector<9x4xbf16> -> vector<4xbf16>
  %row3 = vector.extract %final[3] : vector<9x4xbf16> -> vector<4xbf16>
  %row6 = vector.extract %final[6] : vector<9x4xbf16> -> vector<4xbf16>
  func.return %final, %row0, %row3, %row6 : vector<9x4xbf16>, vector<4xbf16>, vector<4xbf16>, vector<4xbf16>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @packed_history_loop(%initial: reg<amdgpu.vgpr x18>, %current: reg<amdgpu.vgpr x2>, %end: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x18>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %51 = v_mov_b32_copy %begin
  %53 = s_mov_b64_exec_read
  low.br ^_bb1(%51: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr x18>)
^_bb1(%iteration: reg<amdgpu.vgpr>, %old: reg<amdgpu.vgpr x18>):
  %52 = v_cmp_lt_i32 %iteration, %end
  %54, %55 = s_and_saveexec_b64 %52
  low.cond_br %55, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %56 = slice %old[2] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %57 = slice %old[3] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %58 = slice %old[4] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %59 = slice %old[5] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %60 = slice %old[6] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %61 = slice %old[7] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %62 = slice %old[8] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %63 = slice %old[9] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %64 = slice %old[10] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %65 = slice %old[11] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %66 = slice %old[12] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %67 = slice %old[13] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %68 = slice %old[14] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %69 = slice %old[15] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %70 = slice %old[16] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %71 = slice %old[17] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %72 = concat(%56, %57, %58, %59, %60, %61, %62, %63, %64, %65, %66, %67, %68, %69, %70, %71) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x16>
  %next = concat(%72, %current) : (reg<amdgpu.vgpr x16>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x18>
  %74 = v_add_u32 %step, %iteration
  low.br ^_bb1(%74: reg<amdgpu.vgpr>, %next: reg<amdgpu.vgpr x18>)
^_bb3:
  s_mov_b64_exec %53
  %75 = slice %old[0] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %76 = slice %old[1] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %row0 = concat(%75, %76) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %78 = slice %old[6] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %79 = slice %old[7] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %row3 = concat(%78, %79) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %81 = slice %old[12] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %82 = slice %old[13] : reg<amdgpu.vgpr x18> -> reg<amdgpu.vgpr>
  %row6 = concat(%81, %82) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %old, %row0, %row3, %row6
}

// ====

// Every packed storage class admits static multidimensional carriers by total
// row-major element count, including odd payload counts that leave a partial
// final register unit.
func.def @packed_shape_storage_family(%i8_value: vector<3x5xi8>, %i16_value: vector<3x3xi16>, %f8e4m3_value: vector<3x5xf8E4M3>, %f8e5m2_value: vector<2x5xf8E5M2>, %f16_value: vector<5x3xf16>, %bf16_value: vector<9x4xbf16>) -> (vector<3x5xi8>, vector<3x3xi16>, vector<3x5xf8E4M3>, vector<2x5xf8E5M2>, vector<5x3xf16>, vector<9x4xbf16>) {
  func.return %i8_value, %i16_value, %f8e4m3_value, %f8e5m2_value, %f16_value, %bf16_value : vector<3x5xi8>, vector<3x3xi16>, vector<3x5xf8E4M3>, vector<2x5xf8E5M2>, vector<5x3xf16>, vector<9x4xbf16>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @packed_shape_storage_family(%i8_value: reg<amdgpu.vgpr x4>, %i16_value: reg<amdgpu.vgpr x5>, %f8e4m3_value: reg<amdgpu.vgpr x4>, %f8e5m2_value: reg<amdgpu.vgpr x3>, %f16_value: reg<amdgpu.vgpr x8>, %bf16_value: reg<amdgpu.vgpr x18>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x5>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x3>, reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x18>) asm {
  return %i8_value, %i16_value, %f8e4m3_value, %f8e5m2_value, %f16_value, %bf16_value
}

// ====

// A load outside an authored unrolled loop is one immutable SSA snapshot.
// Eager legalization leaves it in place until unrolling makes every pair
// offset static, preserving one source read and four disjoint output stores.
func.def @unrolled_load_snapshot(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %input_view = buffer.view %input[%origin] : buffer -> view<8xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<8xbf16>
  %values = vector.load %input_view[0] : view<8xbf16> -> vector<8xbf16>
  scf.for %row = [%begin to %end step %step] unroll {
    %element = index.shli %row, %step : index
    %pair = vector.slice %values[%element] : vector<8xbf16> -> vector<2xbf16>
    vector.store %pair, %output_view[%element] : vector<2xbf16>, view<8xbf16>
  }
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @unrolled_load_snapshot() asm {
  %input_view = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %34 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = v_mov_b32_copy %34
  %37 = v_mov_b32_copy %35
  %38 = concat(%36, %37) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %values = global_load_b128_vaddr %38
  %pair = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %41 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %42 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %43 = v_mov_b32_copy %41
  %44 = v_mov_b32_copy %42
  %45 = concat(%43, %44) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %45, %pair
  %pair_1 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %51 = concat(%43, %44) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %51, %pair_1 {offset = 4}
  %pair_2 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %57 = concat(%43, %44) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %57, %pair_2 {offset = 8}
  %pair_3 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %63 = concat(%43, %44) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %63, %pair_3 {offset = 12}
  return
}
