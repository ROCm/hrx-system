// ====
// RUN: emit amdgpu-assembly @lds_to_vmem_continuation

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @lds_to_vmem_continuation(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = ds_load_u16_d16 %address
  %continued = global_load_d16_hi_b16_saddr %loaded, %address, %input
  %result = v_add_u32 %continued, %rhs
  return %result
}

// Reversing the completion domains must release LDS before the VMEM write.
// ----
  ds_load_u16_d16 v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  global_load_short_d16_hi v2, v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v2, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @continued_result_materialized_copy

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @continued_result_materialized_copy(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_d16_b16_saddr %address, %input
  %continued = ds_load_u16_d16_hi %loaded, %address
  %copied = copy %continued : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %result = v_add_u32 %copied, %rhs
  return %result
}

// The forced move is the first actual read of the continued value. Its LDS
// wait must precede the move; the old VMEM half completed before continuation.
// ----
  global_load_short_d16 v2, v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_load_u16_d16_hi v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v2, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @materialized_copy_before_continuation

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @materialized_copy_before_continuation(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b32_saddr %address, %input
  %copied = copy %loaded : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %continued = ds_load_u16_d16_hi %copied, %address
  %result = v_add_u32 %continued, %rhs
  return %result
}

// A materialized copy has already completed the preserved half's load.
// The continuation must not add another VMEM wait.
// ----
  global_load_b32 v2, v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_load_u16_d16_hi v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v2, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @continued_result_coalesced_edge

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @continued_result_coalesced_edge(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = ds_load_u16_d16 %address
  %continued = global_load_d16_hi_b16_saddr %loaded, %address, %input
  low.br ^join(%continued: reg<amdgpu.vgpr>)
^join(%joined: reg<amdgpu.vgpr>):
  %result = v_add_u32 %joined, %rhs
  return %result
}

// Coalescing the edge leaves VMEM pending, but not the older LDS write.
// The successor's whole-register read must complete the remaining VMEM result.
// ----
  ds_load_u16_d16 v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  global_load_short_d16_hi v2, v0, s[0:1] offset:0
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v2, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @same_vmem_continuation_remains_overlapped

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @same_vmem_continuation_remains_overlapped(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_d16_b16_saddr %address, %input
  %continued = global_load_d16_hi_b16_saddr %loaded, %address, %input {offset = 2}
  %result = v_add_u32 %continued, %rhs
  return %result
}

// Both halves use the same ordered result pipeline and can remain pending
// together. The single final wait completes both halves.
// ----
  global_load_short_d16 v2, v0, s[0:1] offset:0
  global_load_short_d16_hi v2, v0, s[0:1] offset:2
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v2, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @same_lds_continuation_remains_overlapped

amdgpu.target<gfx1200> @target

low.func.def target<amdgpu.rdna4.core>(@target) @same_lds_continuation_remains_overlapped(%address: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = ds_load_u16_d16 %address
  %continued = ds_load_u16_d16_hi %loaded, %address {offset = 2}
  %result = v_add_u32 %continued, %rhs
  return %result
}

// LDS retains the same ordered-partial-write contract with the split counters.
// ----
  ds_load_u16_d16 v2, v0 offset:0
  ds_load_u16_d16_hi v2, v0 offset:2
  s_wait_dscnt dscnt(0)
  v_add_u32 v0, v2, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @coalesced_slice_before_continuation

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @coalesced_slice_before_continuation(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b64_saddr %address, %input
  %sliced = slice %loaded[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %continued = ds_load_u16_d16_hi %sliced, %address
  %result = v_add_u32 %continued, %rhs
  return %result
}

// The coalesced slice performs no hardware read. The original physical lease
// still protects the partial writer without recovering the source by walking IR.
// ----
  global_load_b64 v[2:3], v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_load_u16_d16_hi v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v2, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @mixed_continuation_loop

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @mixed_continuation_loop(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %initial = s_mov_b32 3
  %one = s_mov_b32 1
  %zero = s_mov_b32 0
  low.br ^loop(%initial: reg<amdgpu.sgpr>)
^loop(%remaining: reg<amdgpu.sgpr>):
  %loaded = global_load_d16_b16_saddr %address, %input
  %continued = ds_load_u16_d16_hi %loaded, %address
  %result = v_add_u32 %continued, %rhs
  %next = s_sub_u32 %remaining, %one
  %again = s_cmp_gt_i32 %next, %zero
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next: reg<amdgpu.sgpr>)
^exit:
  return %result
}

// Every dynamic low-half instance completes before the high-half write. Loop
// frontier propagation must not move the release past that partial writer.
// ----
  s_mov_b32 s2, 3
  s_mov_b32 s3, 1
  s_mov_b32 s4, 0
.Lbb1:
  global_load_short_d16 v2, v0, s[0:1] offset:0
  s_sub_u32 s2, s2, s3
  s_cmp_gt_i32 s2, s4
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_load_u16_d16_hi v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v2, v2, v1
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_branch .Lbb1
.Lbb3:
  s_endpgm
