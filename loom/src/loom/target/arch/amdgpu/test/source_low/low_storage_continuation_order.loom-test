// ====
// RUN: emit amdgpu-assembly @gfx1200_vmem_to_valu_continuation

amdgpu.target<gfx1200> @target

low.func.def target<amdgpu.rdna4.core>(@target) @gfx1200_vmem_to_valu_continuation(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b32_saddr %address, %input
  %continued = v_cvt_pk_fp8_f32_high %loaded, %a, %b
  %result = v_add_u32 %continued, %address
  return %result
}

// VALU completion says nothing about the preserved half's pending load.
// The partial conversion must release that load before writing the same VGPR.
// ----
  global_load_b32 v3, v2, s[0:1] offset:0
  s_wait_loadcnt loadcnt(0)
  v_cvt_pk_fp8_f32 v3, v0, v1, op_sel:[0,0,1]
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v3, v2
  s_endpgm

