// RUN: emit amdgpu-assembly @gfx1100_vmem_to_lds_continuation

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @gfx1100_vmem_to_lds_continuation(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b32_saddr %address, %input
  %continued = ds_load_u16_d16_hi %loaded, %address
  %result = v_add_u32 %continued, %rhs
  return %result
}

// The preserved low half belongs to VMEM, not LDS. Its result must complete
// before the partial write crosses into the independently completing pipeline.
// ----
  global_load_b32 v2, v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_load_u16_d16_hi v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v2, v1
  s_endpgm

