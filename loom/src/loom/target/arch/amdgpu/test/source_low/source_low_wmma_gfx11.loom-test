  %f32_f16_result = v_wmma_f32_16x16x16_f16 %f16_rhs, %f16_rhs, %57
  %59 = copy %f32_init : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %f32_bf16_result = v_wmma_f32_16x16x16_bf16 %bf16_rhs, %bf16_rhs, %59
  %61 = copy %f16_init : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %f16_result = v_wmma_f16_16x16x16_f16 %f16_rhs, %f16_rhs, %61
  %63 = copy %bf16_init : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %bf16_result = v_wmma_bf16_16x16x16_bf16 %bf16_rhs, %bf16_rhs, %63
  %65 = copy %i32_init : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %i8_result = v_wmma_i32_16x16x16_iu8 %i8_lhs, %i8_rhs, %65 {neg_lo = 1, neg_hi = 1}
  %67 = copy %i32_init : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %i4_result = v_wmma_i32_16x16x16_iu4 %i4_lhs, %i4_rhs, %67 {neg_lo = 1, neg_hi = 1}
  return %f32_f16_result, %f32_bf16_result, %f16_result, %bf16_result, %i8_result, %i4_result
