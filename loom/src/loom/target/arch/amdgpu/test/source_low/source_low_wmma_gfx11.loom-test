func.def target(@target) @gfx11_wmma_families_wave32(%f16_data: vector<16xf16>, %bf16_data: vector<16xbf16>, %f32_init_data: vector<8xf32>, %f16_init_data: vector<16xf16>, %bf16_init_data: vector<16xbf16>, %i8_lhs_data: vector<4xi32>, %i8_rhs_data: vector<4xi32>, %i4_lhs_data: vector<2xi32>, %i4_rhs_data: vector<2xi32>, %i32_init_data: vector<8xi32>) -> (vector<8xf32>, vector<8xf32>, vector<16xf16>, vector<16xbf16>, vector<8xi32>, vector<8xi32>) {
  %m = index.constant 16 : index
