  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %words_view = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %captured = resource<hal_binding> {extent = 2048, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %37 = v_lshlrev_b32_src0_inline %capture_lane, 4
  %words = global_load_b128_saddr %37, %words_view
  %low_input = slice %words[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %high_input = slice %words[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %joined_or = concat(%low_input, %high_input) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
