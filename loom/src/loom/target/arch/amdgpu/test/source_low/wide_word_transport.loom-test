amdgpu.target<gfx1201> @target

kernel.def target(@target) @varying_words() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%words_buffer: buffer, %uniform_word: i32, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %words_view = buffer.view %words_buffer[%capture_base] : buffer -> view<64x4xi32>
  %words = vector.load %words_view[%capture_lane, 0] : view<64x4xi32> -> vector<4xi32>
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<4x64xi64>
  %low_input = vector.extract %words[0] : vector<4xi32> -> i32
  %high_input = vector.extract %words[1] : vector<4xi32> -> i32
  %c32 = scalar.constant 32 : i64
  %low = scalar.extui %low_input : i32 to i64
  %high_word = scalar.extui %high_input : i32 to i64
  %uniform = scalar.extui %uniform_word : i32 to i64
  %high = scalar.shli %high_word, %c32 : i64
  %uniform_high = scalar.shli %uniform, %c32 : i64
  %joined_or = scalar.ori %low, %high : i64
  %joined_xor = scalar.xori %high, %low : i64
  %mixed_or = scalar.ori %uniform_high, %low : i64
  %mixed_xor = scalar.xori %uniform, %high : i64
  view.store %joined_or, %captured[0, %capture_lane] : i64, view<4x64xi64>
  view.store %joined_xor, %captured[1, %capture_lane] : i64, view<4x64xi64>
  view.store %mixed_or, %captured[2, %capture_lane] : i64, view<4x64xi64>
  view.store %mixed_xor, %captured[3, %capture_lane] : i64, view<4x64xi64>
  kernel.return
}

