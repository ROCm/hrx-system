kernel.def target(@target) @uniform_shifts() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%value: i64, %count_input: i64, %result_buffer_0: buffer, %result_buffer_1: buffer, %result_buffer_2: buffer, %result_buffer_3: buffer, %result_buffer_4: buffer, %result_buffer_5: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xi64>
  %result_view_2 = buffer.view %result_buffer_2[%fixture_base] : buffer -> view<64xi64>
  %result_view_3 = buffer.view %result_buffer_3[%fixture_base] : buffer -> view<64xi64>
  %result_view_4 = buffer.view %result_buffer_4[%fixture_base] : buffer -> view<64xi64>
  %result_view_5 = buffer.view %result_buffer_5[%fixture_base] : buffer -> view<64xi64>
  %count = scalar.assume %count_input [range(%count_input, 0, 63)] : i64
  %c32 = scalar.constant 32 : i64
  %left = scalar.shli %value, %count : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  %word_left = scalar.shli %value, %c32 : i64
  %word_logical = scalar.shrui %value, %c32 : i64
  %word_signed = scalar.shrsi %value, %c32 : i64
  view.store %left, %result_view_0[%fixture_lane] : i64, view<64xi64>
  view.store %logical, %result_view_1[%fixture_lane] : i64, view<64xi64>
  view.store %signed, %result_view_2[%fixture_lane] : i64, view<64xi64>
