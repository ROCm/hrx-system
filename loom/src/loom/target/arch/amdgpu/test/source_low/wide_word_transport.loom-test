  %mixed_xor = concat(%63, %high_input) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %75 = v_lshlrev_b32_src0_inline %capture_lane, 3
  global_store_b64_saddr %75, %joined_or, %captured
  global_store_b64_saddr %75, %joined_xor, %captured {offset = 512}
  global_store_b64_saddr %75, %mixed_or, %captured {offset = 1024}
  global_store_b64_saddr %75, %mixed_xor, %captured {offset = 1536}
  return
