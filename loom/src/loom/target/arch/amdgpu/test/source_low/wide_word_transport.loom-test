// RUN: emit source-low output=low

amdgpu.target<gfx942> @target

// Word producers stay independently useful after the join.
kernel.def target(@target) @uniform_words() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%low_input: i32, %high_input: i32, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<4x64xi64>
  %c32 = scalar.constant 32 : i64
  %low = scalar.extui %low_input : i32 to i64
  %high_word = scalar.extui %high_input : i32 to i64
  %high = scalar.shli %high_word, %c32 : i64
  %joined_or = scalar.ori %high, %low : i64
  %joined_xor = scalar.xori %low, %high : i64
  view.store %joined_or, %result_view_0[0, %fixture_lane] : i64, view<4x64xi64>
  view.store %joined_xor, %result_view_0[1, %fixture_lane] : i64, view<4x64xi64>
  view.store %low, %result_view_0[2, %fixture_lane] : i64, view<4x64xi64>
  view.store %high, %result_view_0[3, %fixture_lane] : i64, view<4x64xi64>
  kernel.return
}

