// RUN: emit source-low output=low

amdgpu.target<gfx942> @target

// Word producers stay independently useful after the join.
kernel.def target(@target) @uniform_words() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%low_input: i32, %high_input: i32, %result_buffer_0: buffer, %result_buffer_1: buffer, %result_buffer_2: buffer, %result_buffer_3: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xi64>
  %result_view_2 = buffer.view %result_buffer_2[%fixture_base] : buffer -> view<64xi64>
  %result_view_3 = buffer.view %result_buffer_3[%fixture_base] : buffer -> view<64xi64>
  %c32 = scalar.constant 32 : i64
  %low = scalar.extui %low_input : i32 to i64
  %high_word = scalar.extui %high_input : i32 to i64
  %high = scalar.shli %high_word, %c32 : i64
  %joined_or = scalar.ori %high, %low : i64
  %joined_xor = scalar.xori %low, %high : i64
  view.store %joined_or, %result_view_0[%fixture_lane] : i64, view<64xi64>
  view.store %joined_xor, %result_view_1[%fixture_lane] : i64, view<64xi64>
  view.store %low, %result_view_2[%fixture_lane] : i64, view<64xi64>
  view.store %high, %result_view_3[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "low_input", arg1 = "high_input"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 6, resource_count = 4, resource_offsets = [8, 16, 24, 32], resource_parameter_indices = [2, 3, 4, 5], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_words(%low_input: reg<amdgpu.sgpr>, %high_input: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_2 = resource<hal_binding> {extent = 512, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_3 = resource<hal_binding> {extent = 512, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %27 = s_mov_b32 0
  %41 = v_mov_b32_copy %low_input
  %43 = v_mov_b32_copy %high_input
  %44 = concat(%41, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %45 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_dwordx2_saddr %45, %44, %result_view_0
  %50 = concat(%41, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %45, %50, %result_view_1
  %55 = v_mov_b32_copy %27
  %56 = concat(%41, %55) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %45, %56, %result_view_2
  %62 = concat(%55, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %45, %62, %result_view_3
  return
}

// ====

amdgpu.target<gfx1100> @target

// Imported range and divisibility facts suffice without inspecting producers.
func.def target(@target) @word_facts(%low_input: i64, %high_input: i64, %overlap: i64) -> (i64, i64, i64, i64) {
  %low = scalar.assume %low_input [range(%low_input, 0, 4294967295)] : i64
  %high = scalar.assume %high_input [multiple_of(%high_input, 4294967296)] : i64
  %joined_or = scalar.ori %low, %high : i64
  %joined_xor = scalar.xori %high, %low : i64
  %overlapping_or = scalar.ori %overlap, %high : i64
  %overlapping_xor = scalar.xori %low, %overlap : i64
  func.return %joined_or, %joined_xor, %overlapping_or, %overlapping_xor : i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @word_facts(%low: reg<amdgpu.vgpr x2>, %high: reg<amdgpu.vgpr x2>, %overlap: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %20 = slice %low[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = slice %high[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %joined_or = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %joined_xor = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %26 = slice %overlap[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %27 = slice %high[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %28 = v_or_b32 %26, %27
  %29 = slice %overlap[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %31 = v_or_b32 %29, %21
  %overlapping_or = concat(%28, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %35 = v_xor_b32 %20, %26
  %36 = slice %low[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %38 = v_xor_b32 %36, %29
  %overlapping_xor = concat(%35, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %joined_or, %joined_xor, %overlapping_or, %overlapping_xor
}

