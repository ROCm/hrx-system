low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @varying_shifts(%values: reg<amdgpu.vgpr x4>, %uniform: reg<amdgpu.vgpr x2>, %uniform_count: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %value = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %45 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %left = v_lshlrev_b64 %45, %value
  %logical = v_lshrrev_b64 %45, %value
  %signed = v_ashrrev_i64 %45, %value
  %mixed_left = v_lshlrev_b64 %45, %uniform
  %38 = slice %uniform_count[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %mixed_logical = v_lshrrev_b64 %38, %value
  %mixed_signed = v_ashrrev_i64 %38, %value
  return %left, %logical, %signed, %mixed_left, %mixed_logical, %mixed_signed
}

