amdgpu.target<gfx1100> @target

// Both source orders keep the uniform words in the scalar-capable operand.
// Constants use the same path without broadcasts into temporary vector words.
kernel.def target(@target) @mixed_bitwise() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%values_buffer: buffer, %uniform: i64, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %values_view = buffer.view %values_buffer[%capture_base] : buffer -> view<64x2xi64>
  %values = vector.load %values_view[%capture_lane, 0] : view<64x2xi64> -> vector<2xi64>
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<6x64xi64>
  %first = vector.extract %values[0] : vector<2xi64> -> i64
  %second = vector.extract %values[1] : vector<2xi64> -> i64
  %mask = scalar.constant -4 : i64
  %pattern = scalar.constant 1311768467015204865 : i64
  %mixed_and = scalar.andi %first, %uniform : i64
  %mixed_or = scalar.ori %uniform, %second : i64
  %mixed_xor = scalar.xori %first, %uniform : i64
  %masked = scalar.andi %first, %mask : i64
  %tagged = scalar.ori %pattern, %second : i64
  %toggled = scalar.xori %first, %pattern : i64
  view.store %mixed_and, %captured[0, %capture_lane] : i64, view<6x64xi64>
  view.store %mixed_or, %captured[1, %capture_lane] : i64, view<6x64xi64>
  view.store %mixed_xor, %captured[2, %capture_lane] : i64, view<6x64xi64>
  view.store %masked, %captured[3, %capture_lane] : i64, view<6x64xi64>
  view.store %tagged, %captured[4, %capture_lane] : i64, view<6x64xi64>
  view.store %toggled, %captured[5, %capture_lane] : i64, view<6x64xi64>
  kernel.return
}

