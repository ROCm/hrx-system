// RUN: emit source-low output=low

amdgpu.target<gfx1100> @target

// Imported range and divisibility facts suffice without inspecting producers.
func.def target(@target) @word_facts(%low_input: i64, %high_input: i64, %overlap: i64) -> (i64, i64, i64, i64) {
  %low = scalar.assume %low_input [range(%low_input, 0, 4294967295)] : i64
  %high = scalar.assume %high_input [multiple_of(%high_input, 4294967296)] : i64
  %joined_or = scalar.ori %low, %high : i64
  %joined_xor = scalar.xori %high, %low : i64
  %overlapping_or = scalar.ori %overlap, %high : i64
  %overlapping_xor = scalar.xori %low, %overlap : i64
  func.return %joined_or, %joined_xor, %overlapping_or, %overlapping_xor : i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @word_facts(%low: reg<amdgpu.vgpr x2>, %high: reg<amdgpu.vgpr x2>, %overlap: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %20 = slice %low[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = slice %high[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %joined_or = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %joined_xor = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %26 = slice %overlap[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %27 = slice %high[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %28 = v_or_b32 %26, %27
  %29 = slice %overlap[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %31 = v_or_b32 %29, %21
  %overlapping_or = concat(%28, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %35 = v_xor_b32 %20, %26
  %36 = slice %low[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %38 = v_xor_b32 %36, %29
  %overlapping_xor = concat(%35, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %joined_or, %joined_xor, %overlapping_or, %overlapping_xor
}

// ====

amdgpu.target<gfx1100> @target

// Both source orders keep the uniform words in the scalar-capable operand.
// Constants use the same path without broadcasts into temporary vector words.
kernel.def target(@target) @mixed_bitwise() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%values_buffer: buffer, %uniform: i64, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %values_view = buffer.view %values_buffer[%capture_base] : buffer -> view<64x2xi64>
  %values = vector.load %values_view[%capture_lane, 0] : view<64x2xi64> -> vector<2xi64>
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<6x64xi64>
  %first = vector.extract %values[0] : vector<2xi64> -> i64
  %second = vector.extract %values[1] : vector<2xi64> -> i64
  %mask = scalar.constant -4 : i64
  %pattern = scalar.constant 1311768467015204865 : i64
  %mixed_and = scalar.andi %first, %uniform : i64
  %mixed_or = scalar.ori %uniform, %second : i64
  %mixed_xor = scalar.xori %first, %uniform : i64
  %masked = scalar.andi %first, %mask : i64
  %tagged = scalar.ori %pattern, %second : i64
  %toggled = scalar.xori %first, %pattern : i64
  view.store %mixed_and, %captured[0, %capture_lane] : i64, view<6x64xi64>
  view.store %mixed_or, %captured[1, %capture_lane] : i64, view<6x64xi64>
  view.store %mixed_xor, %captured[2, %capture_lane] : i64, view<6x64xi64>
  view.store %masked, %captured[3, %capture_lane] : i64, view<6x64xi64>
  view.store %tagged, %captured[4, %capture_lane] : i64, view<6x64xi64>
  view.store %toggled, %captured[5, %capture_lane] : i64, view<6x64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "uniform"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [8], parameter_count = 3, resource_count = 2, resource_offsets = [0, 16], resource_parameter_indices = [0, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @mixed_bitwise(%uniform: reg<amdgpu.sgpr x2>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %values_view = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %captured = resource<hal_binding> {extent = 3072, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %39 = v_lshlrev_b32_src0_inline %capture_lane, 4
  %values = global_load_b128_saddr %39, %values_view
  %43 = s_mov_b32 4294967292
  %44 = s_mov_b32 4294967295
  %46 = s_mov_b32 2147483649
  %47 = s_mov_b32 305419896
  %49 = slice %uniform[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %108 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %51 = v_and_b32 %49, %108
  %52 = slice %uniform[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %107 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %54 = v_and_b32 %52, %107
  %mixed_and = concat(%51, %54) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %106 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %58 = v_or_b32 %49, %106
  %105 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %61 = v_or_b32 %52, %105
  %mixed_or = concat(%58, %61) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %65 = v_xor_b32 %49, %108
  %68 = v_xor_b32 %52, %107
  %mixed_xor = concat(%65, %68) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %72 = v_and_b32 %43, %108
  %75 = v_and_b32 %44, %107
  %masked = concat(%72, %75) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %79 = v_or_b32 %46, %106
  %82 = v_or_b32 %47, %105
  %tagged = concat(%79, %82) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %86 = v_xor_b32 %46, %108
  %89 = v_xor_b32 %47, %107
  %toggled = concat(%86, %89) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %91 = v_lshlrev_b32_src0_inline %capture_lane, 3
  global_store_b64_saddr %91, %mixed_and, %captured
  global_store_b64_saddr %91, %mixed_or, %captured {offset = 512}
  global_store_b64_saddr %91, %mixed_xor, %captured {offset = 1024}
  global_store_b64_saddr %91, %masked, %captured {offset = 1536}
  global_store_b64_saddr %91, %tagged, %captured {offset = 2048}
  global_store_b64_saddr %91, %toggled, %captured {offset = 2560}
  return
}
