low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "low_input", arg1 = "high_input"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_words(%low_input: reg<amdgpu.sgpr>, %high_input: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 2048, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %25 = s_mov_b32 0
  %39 = v_mov_b32_copy %low_input
  %41 = v_mov_b32_copy %high_input
  %42 = concat(%39, %41) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %43 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_dwordx2_saddr %43, %42, %result_view_0
  %48 = concat(%39, %41) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %43, %48, %result_view_0 {offset = 512}
  %53 = v_mov_b32_copy %25
  %54 = concat(%39, %53) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %43, %54, %result_view_0 {offset = 1024}
  %60 = concat(%53, %41) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %43, %60, %result_view_0 {offset = 1536}
  return
}

// ====

amdgpu.target<gfx1100> @target

// Imported range and divisibility facts suffice without inspecting producers.
func.def target(@target) @word_facts(%low_input: i64, %high_input: i64, %overlap: i64) -> (i64, i64, i64, i64) {
  %low = scalar.assume %low_input [range(%low_input, 0, 4294967295)] : i64
  %high = scalar.assume %high_input [multiple_of(%high_input, 4294967296)] : i64
  %joined_or = scalar.ori %low, %high : i64
  %joined_xor = scalar.xori %high, %low : i64
  %overlapping_or = scalar.ori %overlap, %high : i64
  %overlapping_xor = scalar.xori %low, %overlap : i64
  func.return %joined_or, %joined_xor, %overlapping_or, %overlapping_xor : i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @word_facts(%low: reg<amdgpu.vgpr x2>, %high: reg<amdgpu.vgpr x2>, %overlap: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %20 = slice %low[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = slice %high[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %joined_or = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %joined_xor = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %26 = slice %overlap[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %27 = slice %high[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %28 = v_or_b32 %26, %27
  %29 = slice %overlap[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %31 = v_or_b32 %29, %21
  %overlapping_or = concat(%28, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %35 = v_xor_b32 %20, %26
  %36 = slice %low[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %38 = v_xor_b32 %36, %29
  %overlapping_xor = concat(%35, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %joined_or, %joined_xor, %overlapping_or, %overlapping_xor
}

