amdgpu.target<gfx12-generic> @target
func.def target(@target) @vector_fptrunc_f16x3_to_bf8(%input: vector<3xf16>) -> (vector<3xf8E5M2>) {
  %converted = vector.fptrunc %input : vector<3xf16> to vector<3xf8E5M2>
  func.return %converted : vector<3xf8E5M2>
}

