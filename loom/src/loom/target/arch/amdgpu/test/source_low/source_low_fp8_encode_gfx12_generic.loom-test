// RUN: emit source-low output=low

amdgpu.target<gfx12-generic> @target
func.def target(@target) @vector_fptrunc_f32x4_to_fp8(%input: vector<4xf32>) -> (vector<4xf8E4M3>) {
  %converted = vector.fptrunc %input : vector<4xf32> to vector<4xf8E4M3>
  func.return %converted : vector<4xf8E4M3>
}

