low.func.def target(@target) abi(hal_kernel) @vector_fptrunc_f32x4_to_fp8(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr>) asm<amdgpu.gfx12.generic.core> {
  %5 = v_mov_b32 1138753536
  %6 = v_mov_b32 3286237184
  %7 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = v_cmp_gt_f32 %7, %5
  %12 = v_cndmask_b32 %7, %5, %11
  %13 = v_cmp_lt_f32 %12, %6
  %14 = v_cndmask_b32 %12, %6, %13
  %15 = v_cmp_gt_f32 %8, %5
  %16 = v_cndmask_b32 %8, %5, %15
  %17 = v_cmp_lt_f32 %16, %6
  %18 = v_cndmask_b32 %16, %6, %17
  %19 = v_cvt_pk_fp8_f32_low %14, %18
  %20 = v_cmp_gt_f32 %9, %5
  %21 = v_cndmask_b32 %9, %5, %20
  %22 = v_cmp_lt_f32 %21, %6
  %23 = v_cndmask_b32 %21, %6, %22
  %24 = v_cmp_gt_f32 %10, %5
  %25 = v_cndmask_b32 %10, %5, %24
  %26 = v_cmp_lt_f32 %25, %6
  %27 = v_cndmask_b32 %25, %6, %26
  %converted = v_cvt_pk_fp8_f32_high %19, %23, %27
  return %converted
}

