low.func.def target(@target) abi(hal_kernel) @vector_fptrunc_f16x3_to_bf8(%input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm<amdgpu.gfx12.generic.core> {
  %5 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %6 = v_cvt_f32_f16 %5
  %8 = v_lshrrev_b32_src0_inline %5, 16
  %9 = v_cvt_f32_f16 %8
