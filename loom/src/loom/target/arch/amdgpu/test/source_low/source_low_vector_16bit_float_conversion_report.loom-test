amdgpu.target<gfx1200> @target

kernel.def target(@target) @report_gfx1200_bf8_f32_scale_sliced_native_f32_pair() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %schema = encoding.define #encoding.f8e5m2<affine=scale_only, payload_elements=3, scale_format=f32, scale_group_elements=3, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %input_view = buffer.view %input[%base] : buffer -> view<64x4xf8E5M2>
  %scale_view = buffer.view %scale[%base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<64x3xf32>
  %packed = vector.load %input_view[%lane, 0] : view<64x4xf8E5M2> -> vector<4xf8E5M2>
  %payload = vector.slice %packed[0] : vector<4xf8E5M2> -> vector<3xf8E5M2>
  %row_scale = view.load %scale_view[%lane] : view<64xf32> -> f32
  %scale_vector = vector.splat %row_scale : vector<1xf32>
  %decoded = vector.decode %payload using %schema {scale = %scale_vector : vector<1xf32>} : vector<3xf8E5M2>, encoding<schema> -> vector<3xf32>
  vector.store %decoded, %output_view[%lane, 0] : vector<3xf32>, view<64x3xf32>
  kernel.return
}

