// ====

amdgpu.target<gfx1100> @target

kernel.def target(@target) @report_gfx1100_fp8_f32_scale_to_bf16_software_decode() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=8, rounding=finite_only, scale_format=f32, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %input_view = buffer.view %input[%base] : buffer -> view<64x8xf8E4M3>
  %scale_view = buffer.view %scale[%base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<64x8xbf16>
  %payload = vector.load %input_view[%lane, 0] : view<64x8xf8E4M3> -> vector<8xf8E4M3>
  %row_scale = view.load %scale_view[%lane] : view<64xf32> -> f32
  %scale_vector = vector.splat %row_scale : vector<1xf32>
  %decoded = vector.decode %payload using %schema {scale = %scale_vector : vector<1xf32>} : vector<8xf8E4M3>, encoding<schema> -> vector<8xbf16>
  vector.store %decoded, %output_view[%lane, 0] : vector<8xbf16>, view<64x8xbf16>
  kernel.return
}

