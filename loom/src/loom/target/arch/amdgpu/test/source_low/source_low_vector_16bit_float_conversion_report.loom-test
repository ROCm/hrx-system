amdgpu.target<gfx950> @target

kernel.def target(@target) @report_gfx950_fp8_bf8_scalef32_native_decode_variants() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%fp8_input: buffer, %bf8_input: buffer, %scale: buffer, %fp8_output: buffer, %bf8_output: buffer) {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %fp8_schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=8, scale_format=f32, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %bf8_schema = encoding.define #encoding.f8e5m2<affine=scale_only, payload_elements=8, scale_format=f32, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %fp8_input_view = buffer.view %fp8_input[%base] : buffer -> view<64x8xf8E4M3>
  %bf8_input_view = buffer.view %bf8_input[%base] : buffer -> view<64x8xf8E5M2>
  %scale_view = buffer.view %scale[%base] : buffer -> view<64xf32>
  %fp8_output_view = buffer.view %fp8_output[%base] : buffer -> view<64x8xbf16>
  %bf8_output_view = buffer.view %bf8_output[%base] : buffer -> view<64x8xbf16>
  %fp8_payload = vector.load %fp8_input_view[%lane, 0] : view<64x8xf8E4M3> -> vector<8xf8E4M3>
  %bf8_payload = vector.load %bf8_input_view[%lane, 0] : view<64x8xf8E5M2> -> vector<8xf8E5M2>
  %row_scale = view.load %scale_view[%lane] : view<64xf32> -> f32
  %scale_vector = vector.splat %row_scale : vector<1xf32>
  %fp8_decoded = vector.decode %fp8_payload using %fp8_schema {scale = %scale_vector : vector<1xf32>} : vector<8xf8E4M3>, encoding<schema> -> vector<8xbf16>
  %bf8_decoded = vector.decode %bf8_payload using %bf8_schema {scale = %scale_vector : vector<1xf32>} : vector<8xf8E5M2>, encoding<schema> -> vector<8xbf16>
  vector.store %fp8_decoded, %fp8_output_view[%lane, 0] : vector<8xbf16>, view<64x8xbf16>
  vector.store %bf8_decoded, %bf8_output_view[%lane, 0] : vector<8xbf16>, view<64x8xbf16>
  kernel.return
}

