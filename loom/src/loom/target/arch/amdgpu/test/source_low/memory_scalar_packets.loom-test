  %14 = v_mov_b32_copy %element
  %15 = v_mov_b32 0
  global_store_b32_saddr %15, %14, %result
  %sum = s_add_u32 %element, %element
  %17 = v_mov_b32_copy %sum
  global_store_b32_saddr %15, %17, %result {offset = 4}
