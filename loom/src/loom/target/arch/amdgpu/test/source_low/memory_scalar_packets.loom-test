// RUN: emit source-low target=amdgpu:gfx1151 output=low

kernel.def @uniform_1_words() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %constant_input = buffer.assume.memory_space<constant> %input : buffer
  %view = buffer.view %constant_input[%base] : buffer -> view<1xi32>
  %value = vector.load %view[0] : view<1xi32> -> vector<1xi32>
  %result = buffer.view %output[%base] : buffer -> view<2xi32>
  vector.store %value, %result[0] : vector<1xi32>, view<2xi32>
  %element = vector.extract %value[0] : vector<1xi32> -> i32
  %sum = scalar.addi %element, %element : i32
  view.store %sum, %result[1] : i32, view<2xi32>
  kernel.return
}

