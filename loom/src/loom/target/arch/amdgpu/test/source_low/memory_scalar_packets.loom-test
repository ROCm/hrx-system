  %constant_input = buffer.assume.memory_space<constant> %input : buffer
  %view = buffer.view %constant_input[%base] : buffer -> view<3xi32>
  %value = vector.load %view[0] : view<3xi32> -> vector<3xi32>
  %result = buffer.view %output[%base] : buffer -> view<4xi32>
  vector.store %value, %result[0] : vector<3xi32>, view<4xi32>
  %element = vector.extract %value[0] : vector<3xi32> -> i32
  %sum = scalar.addi %element, %element : i32
  view.store %sum, %result[3] : i32, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @native_three_words() asm {
  %view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = s_mov_b32 0
  %value = s_load_b96 %view, %12
  %14 = slice %value[0] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %15 = v_mov_b32_copy %14
  %16 = slice %value[1] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %17 = v_mov_b32_copy %16
  %18 = slice %value[2] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %20 = concat(%15, %17, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %21 = v_mov_b32 0
  global_store_b96_saddr %21, %20, %result
  %sum = s_add_u32 %14, %14
  %24 = v_mov_b32_copy %sum
  global_store_b32_saddr %21, %24, %result {offset = 12}
  return
}
