// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_word.loom
// TEMPLATE-EXCLUDE: @copy_word_tail The packed i16 memory footprint must currently fill complete registers.
// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Equal-width formats preserve their bits through ordinary memory transfers.
func.def @copy_word_scalar(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_half = buffer.view %input[%base] : buffer -> view<3xf16>
  %source_bfloat = buffer.view %input[%base] : buffer -> view<3xbf16>
  %source_integer = buffer.view %input[%base] : buffer -> view<3xi16>
  %target_half = buffer.view %output[%base] : buffer -> view<3xf16>
  %target_bfloat = buffer.view %output[%base] : buffer -> view<3xbf16>
  %target_integer = buffer.view %output[%base] : buffer -> view<3xi16>
  %half = view.load %source_half[0] : view<3xf16> -> f16
  %bfloat = view.load %source_bfloat[1] : view<3xbf16> -> bf16
  %integer = view.load %source_integer[2] : view<3xi16> -> i16
  view.store %half, %target_half[0] : f16, view<3xf16>
  view.store %bfloat, %target_bfloat[1] : bf16, view<3xbf16>
  view.store %integer, %target_integer[2] : i16, view<3xi16>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @copy_word_scalar() asm {
  %source_integer = resource<hal_binding> {extent = 6, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target_integer = resource<hal_binding> {extent = 6, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = v_mov_b32 0
  %half = global_load_d16_b16_saddr %14, %source_integer
  %bfloat = global_load_d16_b16_saddr %14, %source_integer {offset = 2}
  %integer = global_load_i16_saddr %14, %source_integer {offset = 4}
  %20 = v_bfe_u32_offset_0_width_16_low16 %half
  global_store_short_saddr %14, %20, %target_integer
  %22 = v_bfe_u32_offset_0_width_16_low16 %bfloat
  global_store_short_saddr %14, %22, %target_integer {offset = 2}
  global_store_short_saddr %14, %integer, %target_integer {offset = 4}
  return
}

// ====

// Eight words occupy sixteen consecutive bytes in each numeric format.
func.def @copy_word_vector(%input: buffer, %output: buffer) {
  %first = index.constant 0 : offset
  %second = index.constant 16 : offset
  %third = index.constant 32 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<8xf16>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<8xbf16>
  %source_integer = buffer.view %input[%third] : buffer -> view<8xi16>
  %target_half = buffer.view %output[%first] : buffer -> view<8xf16>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<8xbf16>
  %target_integer = buffer.view %output[%third] : buffer -> view<8xi16>
  %half = vector.load %source_half[0] : view<8xf16> -> vector<8xf16>
  %bfloat = vector.load %source_bfloat[0] : view<8xbf16> -> vector<8xbf16>
  %integer = vector.load %source_integer[0] : view<8xi16> -> vector<8xi16>
  vector.store %half, %target_half[0] : vector<8xf16>, view<8xf16>
  vector.store %bfloat, %target_bfloat[0] : vector<8xbf16>, view<8xbf16>
  vector.store %integer, %target_integer[0] : vector<8xi16>, view<8xi16>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @copy_word_vector() asm {
  %source_integer = resource<hal_binding> {extent = 48, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target_integer = resource<hal_binding> {extent = 48, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_mov_b32 0
  %half = global_load_b128_saddr %16, %source_integer
  %bfloat = global_load_b128_saddr %16, %source_integer {offset = 16}
  %integer = global_load_b128_saddr %16, %source_integer {offset = 32}
  global_store_b128_saddr %16, %half, %target_integer
  global_store_b128_saddr %16, %bfloat, %target_integer {offset = 16}
  global_store_b128_saddr %16, %integer, %target_integer {offset = 32}
  return
}

