low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @copy_word_unaligned() asm {
  %source_integer = resource<hal_binding> {extent = 49, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target_integer = resource<hal_binding> {extent = 49, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_mov_b32 0
  %half = global_load_b128_saddr %16, %source_integer {offset = 1}
  %bfloat = global_load_b128_saddr %16, %source_integer {offset = 17}
  %integer = global_load_b128_saddr %16, %source_integer {offset = 33}
  global_store_b128_saddr %16, %half, %target_integer {offset = 1}
  global_store_b128_saddr %16, %bfloat, %target_integer {offset = 17}
  global_store_b128_saddr %16, %integer, %target_integer {offset = 33}
  return
}

