low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @copy_word_vector_wide() asm {
  %source_integer = resource<hal_binding> {extent = 96, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %target_integer = resource<hal_binding> {extent = 96, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_mov_b32 0
  %17 = global_load_b128_saddr %16, %source_integer
  %19 = global_load_b128_saddr %16, %source_integer {offset = 16}
  %22 = global_load_b128_saddr %16, %source_integer {offset = 32}
  %24 = global_load_b128_saddr %16, %source_integer {offset = 48}
  %27 = global_load_b128_saddr %16, %source_integer {offset = 64}
  %29 = global_load_b128_saddr %16, %source_integer {offset = 80}
  global_store_b128_saddr %16, %17, %target_integer
  global_store_b128_saddr %16, %19, %target_integer {offset = 16}
  global_store_b128_saddr %16, %22, %target_integer {offset = 32}
  global_store_b128_saddr %16, %24, %target_integer {offset = 48}
  global_store_b128_saddr %16, %27, %target_integer {offset = 64}
  global_store_b128_saddr %16, %29, %target_integer {offset = 80}
  return
}

