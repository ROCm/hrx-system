// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @half_fma(%factor_input: f32, %values: vector<8xf16>, %addend_input: f32) -> (vector<8xf16>) {
  %factor = scalar.fptrunc %factor_input : f32 to f16
  %addend = scalar.fptrunc %addend_input : f32 to f16
  %factors = vector.splat %factor : vector<8xf16>
  %addends = vector.splat %addend : vector<8xf16>
  %result = vector.fmaf %factors, %values, %addends : vector<8xf16>
  func.return %result : vector<8xf16>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @half_fma(%factor_input: reg<amdgpu.vgpr>, %values: reg<amdgpu.vgpr x4>, %addend_input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %factor = v_cvt_f16_f32 %factor_input
  %addend = v_cvt_f16_f32 %addend_input
  %15 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = v_pk_fma_f16.broadcast_a_c %factor, %15, %addend
  %17 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = v_pk_fma_f16.broadcast_a_c %factor, %17, %addend
  %19 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %20 = v_pk_fma_f16.broadcast_a_c %factor, %19, %addend
  %21 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22 = v_pk_fma_f16.broadcast_a_c %factor, %21, %addend
  %result = concat(%16, %18, %20, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

