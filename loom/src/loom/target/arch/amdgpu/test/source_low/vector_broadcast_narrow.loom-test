func.def @brain_subtract(%offset: bf16, %values: vector<4xbf16>) -> (vector<4xbf16>, vector<4xbf16>) {
  %offsets = vector.splat %offset : vector<4xbf16>
  %left = vector.subf %offsets, %values : vector<4xbf16>
  %right = vector.subf %values, %offsets : vector<4xbf16>
  func.return %left, %right : vector<4xbf16>, vector<4xbf16>
}

// ----
low.func.def target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @brain_subtract(%offset: reg<amdgpu.vgpr>, %values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %11 = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %12 = v_pk_add_bf16.broadcast_lhs %offset, %11 {neg_lo = 2, neg_hi = 2}
  %13 = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_pk_add_bf16.broadcast_lhs %offset, %13 {neg_lo = 2, neg_hi = 2}
  %left = concat(%12, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %17 = v_pk_add_bf16.broadcast_rhs %11, %offset {neg_lo = 2, neg_hi = 2}
  %19 = v_pk_add_bf16.broadcast_rhs %13, %offset {neg_lo = 2, neg_hi = 2}
  %right = concat(%17, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %left, %right
}
