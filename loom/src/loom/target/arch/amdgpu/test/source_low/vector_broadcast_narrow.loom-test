// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @half_clamp(%value: f16, %lower: f16, %upper: vector<4xf16>) -> (vector<4xf16>) {
  %values = vector.splat %value : vector<4xf16>
  %lowers = vector.splat %lower : vector<4xf16>
  %result = vector.clampf<number> %values, %lowers, %upper : vector<4xf16>
  func.return %result : vector<4xf16>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @half_clamp(%value: reg<amdgpu.vgpr>, %lower: reg<amdgpu.vgpr>, %upper: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %11 = v_pk_max_f16.broadcast_lhs_rhs %value, %value
  %12 = v_pk_max_f16.broadcast_lhs_rhs %lower, %lower
  %13 = slice %upper[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = v_pk_max_f16 %13, %13
  %16 = slice %upper[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = v_pk_max_f16 %16, %16
  %20 = v_pk_max_f16.broadcast_lhs_rhs %11, %12
  %22 = v_pk_min_f16 %20, %15
  %24 = v_pk_min_f16 %20, %18
  %result = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

