// ====
// RUN: emit amdgpu-assembly @cdna4_matrix_result_as_scale

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @cdna4_matrix_result_as_scale(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x4>, %acc: reg<amdgpu.vgpr x4>, %next_acc: reg<amdgpu.vgpr x4>, %scale_a: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %first = v_mfma_f32_16x16x128_f8f6f4_f4_f4 %lhs, %rhs, %acc {matrix_a_fmt = "fp4", matrix_b_fmt = "fp4"}
  %scale_b = slice %first[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %second = v_mfma_scale_f32_16x16x128_f8f6f4_f4_f4 %lhs, %rhs, %next_acc, %scale_a, %scale_b {matrix_a_fmt = "fp4", matrix_b_fmt = "fp4"}
  return %second
}

