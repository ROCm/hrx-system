// Result consumers select distinct MFMA pipeline and forwarding windows.
// RUN: emit amdgpu-assembly @cdna2_dgemm_memory

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_dgemm_memory(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>, %acc: reg<amdgpu.vgpr x8>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %result = v_mfma_f64_16x16x4f64 %lhs, %rhs, %acc
  %lane = slice %result[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x2>
  global_store_dwordx2_saddr %address, %lane, %base
  return
}

// ----
  v_mfma_f64_16x16x4f64 v[8:15], v[0:1], v[2:3], v[8:15]
  s_nop 15
  s_nop 1
  global_store_dwordx2 v4, v[8:9], s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

