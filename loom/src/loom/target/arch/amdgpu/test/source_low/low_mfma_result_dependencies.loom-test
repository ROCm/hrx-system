// ====
// RUN: emit amdgpu-assembly @cdna4_same_input_formats

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @cdna4_same_input_formats(%lhs: reg<amdgpu.vgpr x6>, %rhs: reg<amdgpu.vgpr x4>, %acc: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %first = v_mfma_f32_16x16x128_f8f6f4_f6_f4 %lhs, %rhs, %acc {matrix_a_fmt = "fp6", matrix_b_fmt = "fp4"}
  %second = v_mfma_f32_16x16x128_f8f6f4_f6_f4 %lhs, %rhs, %first {matrix_a_fmt = "fp6", matrix_b_fmt = "fp4"}
  return %second
}

