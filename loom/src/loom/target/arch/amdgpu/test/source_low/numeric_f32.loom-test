  %output_view = resource<hal_binding> {extent = 256, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = v_lshlrev_b32_src0_inline %lane, 2
  %lhs = global_load_b32_saddr %19, %lhs_view
  %rhs = global_load_b32_saddr %19, %rhs_view
  %bias = v_mov_b32 1056964608
  %fma = v_fmaak_f32 %lhs, %rhs, 1056964608
  %result = v_sub_f32 %fma, %bias
