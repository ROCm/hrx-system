low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @f32_exact_vector_div() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %rhs_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %17 = v_lshlrev_b32_src0_inline %lane, 2
  %lhs = global_load_b32_saddr %17, %lhs_view
  %rhs = global_load_b32_saddr %17, %rhs_view
  %21, %22 = v_div_scale_f32 %rhs, %rhs, %lhs
  %23 = v_rcp_f32 %21
  %24 = v_fma_f32_neg_a_one %21, %23
  %25 = v_fma_f32 %24, %23, %23
  %26, %27 = v_div_scale_f32 %lhs, %rhs, %lhs
  %28 = v_mul_f32 %26, %25
  %29 = v_fma_f32_neg_a %21, %28, %26
  %30 = v_fma_f32 %29, %25, %28
  %31 = v_fma_f32_neg_a %21, %30, %26
  %32 = v_div_fmas_f32 %31, %25, %30, %27
  %quotient = v_div_fixup_f32 %32, %rhs, %lhs
  global_store_b32_saddr %17, %quotient, %output_view
  return
}

