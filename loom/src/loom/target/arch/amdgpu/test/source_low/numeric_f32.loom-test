low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @f32_arith() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %rhs_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = v_lshlrev_b32_src0_inline %lane, 2
  %lhs = global_load_b32_saddr %20, %lhs_view
  %rhs = global_load_b32_saddr %20, %rhs_view
  %sum = v_add_f32 %lhs, %rhs
  %product = v_mul_f32 %sum, %rhs
  %negated = v_xor_b32_lit %product, 2147483648
  %absolute = v_and_b32_lit %negated, 2147483647
  global_store_b32_saddr %20, %absolute, %output_view
  return
}

