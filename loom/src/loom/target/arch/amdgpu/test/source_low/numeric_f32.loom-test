func.def @f32_scalar_arcp_constant_divisor(%value: f32) -> (f32) {
  %scale = scalar.constant 127.0 : f32
  %result = scalar.divf<nnan|ninf|nsz|arcp> %value, %scale : f32
  func.return %result : f32
}

