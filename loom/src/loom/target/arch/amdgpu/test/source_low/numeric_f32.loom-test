low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @f32_exact_scalar_div() -> (reg<amdgpu.vgpr>) asm {
  %lhs_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %rhs_view = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = slice %lhs_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = slice %lhs_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %16
  %19 = v_mov_b32_copy %17
  %20 = concat(%18, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %lhs = global_load_b32_vaddr %20
  %22 = slice %rhs_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = slice %rhs_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = v_mov_b32_copy %22
  %25 = v_mov_b32_copy %23
  %26 = concat(%24, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %rhs = global_load_b32_vaddr %26
  %28, %29 = v_div_scale_f32 %rhs, %rhs, %lhs
  %30 = v_rcp_f32 %28
  %31 = v_fma_f32_neg_a_one %28, %30
  %32 = v_fma_f32 %31, %30, %30
  %33, %34 = v_div_scale_f32 %lhs, %rhs, %lhs
  %35 = v_mul_f32 %33, %32
  %36 = v_fma_f32_neg_a %28, %35, %33
  %37 = v_fma_f32 %36, %32, %35
  %38 = v_fma_f32_neg_a %28, %37, %33
  %39 = v_div_fmas_f32 %38, %32, %37, %34
  %quotient = v_div_fixup_f32 %39, %rhs, %lhs
  return %quotient
}

