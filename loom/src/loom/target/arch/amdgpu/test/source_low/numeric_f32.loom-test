// RUN: emit source-low target=amdgpu:gfx11-generic output=low

kernel.def @f32_arith() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%buffer_base] : buffer -> view<64xf32>
  %rhs_view = buffer.view %rhs_buffer[%buffer_base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xf32>
  %lhs = vector.load %lhs_view[%lane] : view<64xf32> -> vector<1xf32>
  %rhs = vector.load %rhs_view[%lane] : view<64xf32> -> vector<1xf32>
  %sum = vector.addf %lhs, %rhs : vector<1xf32>
  %product = vector.mulf %sum, %rhs : vector<1xf32>
  %negated = vector.negf %product : vector<1xf32>
  %absolute = vector.absf %negated : vector<1xf32>
  vector.store %absolute, %output_view[%lane] : vector<1xf32>, view<64xf32>
  kernel.return
}

