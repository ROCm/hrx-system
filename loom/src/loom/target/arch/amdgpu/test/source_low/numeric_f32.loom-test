kernel.def @f32_scalarized() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%buffer_base] : buffer -> view<64x4xf32>
  %rhs_view = buffer.view %rhs_buffer[%buffer_base] : buffer -> view<64x4xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xf32>
  %lhs = vector.load %lhs_view[%lane, 0] : view<64x4xf32> -> vector<4xf32>
  %rhs = vector.load %rhs_view[%lane, 0] : view<64x4xf32> -> vector<4xf32>
  %lhs0 = vector.extract %lhs[0] : vector<4xf32> -> f32
  %rhs0 = vector.extract %rhs[0] : vector<4xf32> -> f32
  %lane0 = scalar.addf %lhs0, %rhs0 : f32
  %lhs1 = vector.extract %lhs[1] : vector<4xf32> -> f32
  %rhs1 = vector.extract %rhs[1] : vector<4xf32> -> f32
  %lane1 = scalar.mulf %lhs1, %rhs1 : f32
  %lhs2 = vector.extract %lhs[2] : vector<4xf32> -> f32
  %rhs2 = vector.extract %rhs[2] : vector<4xf32> -> f32
  %difference = scalar.subf %lhs2, %rhs2 : f32
  %negated = scalar.negf %difference : f32
  %lane2 = scalar.absf %negated : f32
  %lhs3 = vector.extract %lhs[3] : vector<4xf32> -> f32
  %rhs3 = vector.extract %rhs[3] : vector<4xf32> -> f32
  %bias = scalar.constant 0.5 : f32
  %lane3 = scalar.fmaf %lhs3, %rhs3, %bias : f32
  %result = vector.from_elements %lane0, %lane1, %lane2, %lane3 : vector<4xf32>
  vector.store %result, %output_view[%lane, 0] : vector<4xf32>, view<64x4xf32>
  kernel.return
}

