low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @f32_scalar_arcp_constant_divisor(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_mul_f32_lit %value, 1006699012
  return %result
}

