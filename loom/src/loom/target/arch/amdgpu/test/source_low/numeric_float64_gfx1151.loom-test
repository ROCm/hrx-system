// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Scalar addition, numerical extrema, and ordered/unordered predicates.
func.def @float64_add_extrema(%lhs: f64, %rhs: f64) -> (f64, f64, f64, f64, f64) {
  %addf = scalar.addf %lhs, %rhs : f64
  %minimumf = scalar.minimumf %lhs, %rhs : f64
  %maximumf = scalar.maximumf %lhs, %rhs : f64
  %minnumf = scalar.minnumf %lhs, %rhs : f64
  %maxnumf = scalar.maxnumf %lhs, %rhs : f64
  func.return %addf, %minimumf, %maximumf, %minnumf, %maxnumf : f64, f64, f64, f64, f64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float64_add_extrema(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %addf = v_add_f64 %lhs, %rhs
  %28 = v_max_f64 %lhs, %lhs
  %29 = v_max_f64 %rhs, %rhs
  %30 = v_min_f64 %28, %29
  %31 = v_cmp_u_f64 %lhs, %rhs
  %32 = v_mov_b32 0
  %33 = v_mov_b32 2146959360
  %36 = slice %30[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %37 = v_cndmask_b32 %36, %32, %31
  %39 = slice %30[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %40 = v_cndmask_b32 %39, %33, %31
  %minimumf = concat(%37, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %44 = v_max_f64 %28, %29
  %46 = slice %44[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %47 = v_cndmask_b32 %46, %32, %31
  %49 = slice %44[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %50 = v_cndmask_b32 %49, %33, %31
  %maximumf = concat(%47, %50) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %addf, %minimumf, %maximumf, %30, %44
}

// ====

// Uniform f64 values retain SGPR storage until a packet requires a VGPR source.
kernel.def @float64_uniform_add() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_bits: i64, %rhs_bits: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xf64>
  %lhs = scalar.bitcast %lhs_bits : i64 to f64
  %rhs = scalar.bitcast %rhs_bits : i64 to f64
  %sum = scalar.addf %lhs, %rhs : f64
  view.store %sum, %result_view_0[%fixture_lane] : f64, view<64xf64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 4, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs_bits", arg1 = "rhs_bits"}, direct_arg_offsets = [0, 8], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [8, 8], parameter_count = 3, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @float64_uniform_add(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %sum = v_add_f64 %lhs, %rhs
  %16 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %16, %sum, %result_view_0
  return
}

// ====

// A mixed VGPR/SGPR pair already consumes only one VOP3 scalar source.
func.def @float64_mixed_add(%lhs: f64, %rhs_bits: i64) -> (f64) {
  %rhs = scalar.bitcast %rhs_bits : i64 to f64
  %sum = scalar.addf %lhs, %rhs : f64
  func.return %sum : f64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float64_mixed_add(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %sum = v_add_f64 %lhs, %rhs
  return %sum
}

// ====

func.def @float64_predicates(%lhs: f64, %rhs: f64) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %oeq = scalar.cmpf oeq, %lhs, %rhs : f64
  %ogt = scalar.cmpf ogt, %lhs, %rhs : f64
  %oge = scalar.cmpf oge, %lhs, %rhs : f64
  %olt = scalar.cmpf olt, %lhs, %rhs : f64
  %ole = scalar.cmpf ole, %lhs, %rhs : f64
  %one = scalar.cmpf one, %lhs, %rhs : f64
  %ord = scalar.cmpf ord, %lhs, %rhs : f64
  %ueq = scalar.cmpf ueq, %lhs, %rhs : f64
  %ugt = scalar.cmpf ugt, %lhs, %rhs : f64
  %uge = scalar.cmpf uge, %lhs, %rhs : f64
  %ult = scalar.cmpf ult, %lhs, %rhs : f64
  %ule = scalar.cmpf ule, %lhs, %rhs : f64
  %une = scalar.cmpf une, %lhs, %rhs : f64
  %uno = scalar.cmpf uno, %lhs, %rhs : f64
  func.return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float64_predicates(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %oeq = v_cmp_eq_f64 %lhs, %rhs
  %ogt = v_cmp_gt_f64 %lhs, %rhs
  %oge = v_cmp_ge_f64 %lhs, %rhs
  %olt = v_cmp_lt_f64 %lhs, %rhs
  %ole = v_cmp_le_f64 %lhs, %rhs
  %one = v_cmp_lg_f64 %lhs, %rhs
  %ord = v_cmp_o_f64 %lhs, %rhs
  %ueq = v_cmp_nlg_f64 %lhs, %rhs
  %ugt = v_cmp_nle_f64 %lhs, %rhs
  %uge = v_cmp_nlt_f64 %lhs, %rhs
  %ult = v_cmp_nge_f64 %lhs, %rhs
  %ule = v_cmp_ngt_f64 %lhs, %rhs
  %une = v_cmp_neq_f64 %lhs, %rhs
  %uno = v_cmp_u_f64 %lhs, %rhs
  return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno
}

// ====

func.def @float64_number_without_nan(%lhs: f64, %rhs: f64) -> (f64, f64) {
  %minimum = scalar.minnumf<nnan> %lhs, %rhs : f64
  %maximum = scalar.maxnumf<nnan> %lhs, %rhs : f64
  func.return %minimum, %maximum : f64, f64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float64_number_without_nan(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %minimum = v_min_f64 %lhs, %rhs
  %maximum = v_max_f64 %lhs, %rhs
  return %minimum, %maximum
}
