// RUN: emit source-low output=low

amdgpu.target<gfx1100> @target

// Four cooperative waves process every record in one workgroup invocation.
pipeline.def<kernel> public target(@target) @stream() run(%input: view<1024xi32>, %output: view<1024xi32>) {
  pipeline.strand<cooperative> workers([0], [4], [1]) {
    %thread = kernel.workitem.id<x> : index
    %width = kernel.workgroup.size<x> : index
    %end = index.constant 1024 : index
    %increment = index.cast %width : index to i32
    scf.for %item = [%thread to %end step %width] {
      %value = view.load %input[%item] : view<1024xi32> -> i32
      %result = scalar.addi %value, %increment : i32
      view.store %result, %output[%item] : i32, view<1024xi32>
    }
  }
}

// ----
low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) export("stream") workgroup_size(128, 1, 1) workgroup_count(1, 1, 1) @stream() asm {
  %thread = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {extent = 4096, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 4096, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %width = s_mov_b32 128
  %end = s_mov_b32 1024
  %36 = s_mov_b64_exec_read
  low.br ^_bb1(%thread: reg<amdgpu.vgpr>)
^_bb1(%item: reg<amdgpu.vgpr>):
  %35 = v_cmp_lt_i32 %item, %end
  %37, %38 = s_and_saveexec_b64 %35
  low.cond_br %38, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %39 = v_lshlrev_b32_src0_inline %item, 2
  %value = global_load_b32_saddr %39, %input
  %41 = v_mov_b32 128
  %result = v_add_u32 %value, %41
  global_store_b32_saddr %39, %result, %output
  %44 = v_add_u32 %width, %item
  low.br ^_bb1(%44: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %36
  return
}

// ====

amdgpu.target<gfx1100> @target

func.def noinline @adjust(%value: i32) -> (i32) {
  %subgroup = target.subgroup.size : index
  %increment = index.cast %subgroup : index to i32
  %result = scalar.addi %value, %increment : i32
  func.return %result : i32
}

// A varying argument keeps the call live while the helper inherits the worker's
// target context and specializes its subgroup query.
pipeline.def<kernel> public target(@target) @retained_helper() run(%output: view<128xi32>) {
  pipeline.strand<cooperative> workers([0], [4], [1]) {
    %thread = kernel.workitem.id<x> : index
    %value = index.cast %thread : index to i32
    %result = func.call @adjust(%value) : (i32) -> (i32)
    view.store %result, %output[%thread] : i32, view<128xi32>
  }
}

// ----
low.func.def noinline target<amdgpu.rdna3.core> @adjust(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %22 = v_mov_b32 32
  %result = v_add_u32 %value, %22
  return %result
}

low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) export("retained_helper") workgroup_size(128, 1, 1) workgroup_count(1, 1, 1) @retained_helper() asm {
  %value = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %output = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = low.func.call pure @adjust(%value) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %27 = v_lshlrev_b32_src0_inline %value, 2
  global_store_b32_saddr %27, %result, %output
  return
}
