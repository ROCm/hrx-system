// RUN: emit source-low output=low

// Provider expansion must expose call-site constants before memory lowering.
//
// A reusable provider may carry optional behavior selected by a constant at
// each application site. Here the optional output aliases the live output, but
// its store is unreachable. If memory packet selection observes that dead
// store, it scalarizes the authored vector loads and store. The default target
// pipeline must instead retain the two 128-bit loads and one 128-bit store.
amdgpu.target<gfx11-generic> @gfx11 {subgroup_size = 32}

template.decl @hip.recipe.vector_loop(%publish_optional: i1, %input: buffer, %weight: buffer, %optional_output: buffer, %output: buffer)

template.def<@hip.recipe.vector_loop> device @vector_loop_provider(%publish_optional: i1, %input: buffer, %weight: buffer, %optional_output: buffer, %output: buffer) {
  %loop_begin = index.constant 0 : index
  %mask_step = index.constant 1 : index
  %vector_width = index.constant 4 : index
  %stripe_step = index.constant 1024 : index
  %element_count = index.constant 2048 : index
  %buffer_base = index.constant 0 : offset
  %masked_zero = vector.constant 0.0 : vector<4xf32>
  %workitem = kernel.workitem.id<x> : index
  %word_element_add = index.mul %workitem, %vector_width : index
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%buffer_base] : buffer -> view<2048xf32>
  %weight_view = buffer.view %weight_noalias[%buffer_base] : buffer -> view<2048xf32>
  %optional_output_view = buffer.view %optional_output[%buffer_base] : buffer -> view<2048xf32>
  %output_view = buffer.view %output_noalias[%buffer_base] : buffer -> view<2048xf32>
  scf.for %stripe_base = [%loop_begin to %element_count step %stripe_step] {
    %channel = index.add %stripe_base, %word_element_add : index
    %mask = vector.mask.range [%channel to %element_count step %mask_step] : index -> vector<4xi1>
    %input_values = vector.load.mask %input_view[%channel], %mask, %masked_zero : view<2048xf32>, vector<4xi1>, vector<4xf32>
    %weight_values = vector.load.mask %weight_view[%channel], %mask, %masked_zero : view<2048xf32>, vector<4xi1>, vector<4xf32>
    %result = vector.mulf %input_values, %weight_values : vector<4xf32>
    scf.if %publish_optional {
      vector.store.mask %result, %optional_output_view[%channel], %mask : vector<4xf32>, view<2048xf32>, vector<4xi1>
    }
    vector.store.mask %result, %output_view[%channel], %mask : vector<4xf32>, view<2048xf32>, vector<4xi1>
  }
  template.return
}

kernel.def target(@gfx11) @template_constant_pruning_memory_width() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %false = scalar.constant false : i1
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  template.apply<@hip.recipe.vector_loop>(%false, %input_noalias, %weight_noalias, %output_noalias, %output_noalias) : (i1, buffer, buffer, buffer, buffer)
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@gfx11) workgroup_size(256, 1, 1) workgroup_count(1, 1, 1) @template_constant_pruning_memory_width() asm {
  %workitem = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 8192} : reg<amdgpu.sgpr x2>
  %weight_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 8192} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 8192} : reg<amdgpu.sgpr x2>
  %loop_begin = s_mov_b32 0
  %stripe_step = s_mov_b32 1024
  %element_count = s_mov_b32 2048
  low.br ^_bb1(%loop_begin: reg<amdgpu.sgpr>)
^_bb1(%stripe_base: reg<amdgpu.sgpr>):
  %56 = s_cmp_lt_i32 %stripe_base, %element_count
  low.cond_br %56, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %57 = v_mov_b32_copy %stripe_base
  %58 = v_lshl_add_u32_shift_imm %workitem, %57, 2
  %59 = v_lshlrev_b32_src0_inline %58, 2
  %input_values = global_load_b128_saddr %59, %input_view
  %weight_values = global_load_b128_saddr %59, %weight_view
  %65 = slice %input_values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %66 = slice %weight_values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %67 = v_mul_f32 %65, %66
  %68 = slice %input_values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %69 = slice %weight_values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %70 = v_mul_f32 %68, %69
  %71 = slice %input_values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %72 = slice %weight_values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %73 = v_mul_f32 %71, %72
  %74 = slice %input_values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %75 = slice %weight_values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %76 = v_mul_f32 %74, %75
  %result = concat(%67, %70, %73, %76) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %59, %result, %output_view
  %81 = s_add_u32 %stripe_base, %stripe_step
  low.br ^_bb1(%81: reg<amdgpu.sgpr>)
^_bb3:
  return
}
