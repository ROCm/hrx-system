// ====

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @global_atomic_ieee_minimum_rejected() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer) {
  %tid = kernel.workitem.id<x> : index
  %input_base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%input_base] : buffer -> view<64xf32>
  %limit = scalar.constant 1.0 : f32
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.kind"}
  view.atomic.reduce<minimumf> %limit, %view[%tid] {ordering = relaxed, scope = device} : f32, view<64xf32>
  kernel.return
}

// ====

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @lds_atomic_ieee_maximum_rejected() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  %tid = kernel.workitem.id<x> : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<64xf32>
  %limit = scalar.constant 1.0 : f32
  // ERROR@+1: AMDGPU/023 {constraint_key="atomic.kind"}
  view.atomic.reduce<maximumf> %limit, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : f32, view<64xf32>
  kernel.return
}
