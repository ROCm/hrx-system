low.kernel.def target(@target) workgroup_size(64, 1, 1) @fp8_mfma_fragment_memory() asm<amdgpu.cdna3.core> {
  %18 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %rhs_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %out_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 1024} : reg<amdgpu.sgpr x2>
  %22 = v_and_b32_src0_inline %18, 15
  %23 = v_lshrrev_b32_src0_inline %18, 4
  %24 = v_lshlrev_b32_src0_inline %23, 3
  %25 = v_lshlrev_b32_src0_inline %22, 5
  %26 = v_add_u32 %24, %25
  %27 = s_mov_b32_m0_imm 0
  %lhs = global_load_dwordx2_saddr %26, %lhs_view, %27
  %29 = s_mov_b32_m0_imm 0
  %rhs = global_load_dwordx2_saddr %26, %rhs_view, %29
  %31 = v_mov_b32 0
  %init = concat(%31, %31, %31, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %36 = copy %init : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %result = v_mfma_f32_16x16x32_fp8_fp8 %lhs, %rhs, %36
  %38 = v_lshlrev_b32_src0_inline %23, 8
  %39 = v_lshlrev_b32_src0_inline %22, 2
  %40 = v_add_u32 %38, %39
  %41 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %42 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %40, %41, %out_view, %42
  %43 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %44 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %40, %43, %out_view, %44 {offset = 64}
  %45 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %46 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %40, %45, %out_view, %46 {offset = 128}
  %47 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %48 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %40, %47, %out_view, %48 {offset = 192}
  return
}

