amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @wmma_zero_accumulator(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %z0 = v_mov_b32 0
  %zero = concat(%z0, %z0, %z0, %z0, %z0, %z0, %z0, %z0) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %result = v_wmma_f32_16x16x16_f16 %lhs, %rhs, %zero
  return %result
}

