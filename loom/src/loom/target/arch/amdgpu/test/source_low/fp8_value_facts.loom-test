// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Conversion planning must carry scalar promises into a splatted payload.
// These independent roots isolate fact-specific instruction selection from
// control flow.
func.def @finite_e4_to_bfloat(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xf8E4M3>
  %result = buffer.view %output[%base] : buffer -> view<2xbf16>
  %raw = view.load %source[0] : view<1xf8E4M3> -> f8E4M3
  %finite = scalar.assume %raw [finite(%raw)] : f8E4M3
  %packed = vector.splat %finite : vector<2xf8E4M3>
  %converted = vector.extf %packed : vector<2xf8E4M3> to vector<2xbf16>
  vector.store %converted, %result[0] : vector<2xbf16>, view<2xbf16>
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @finite_e4_to_bfloat() asm {
  %source = resource<hal_binding> {extent = 1, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = v_mov_b32_copy %13
  %16 = v_mov_b32_copy %14
  %17 = concat(%15, %16) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %finite = global_load_i8_vaddr %17
  %19 = v_and_b32_lit %finite, 255
  %20 = v_and_b32_lit %19, 127
  %21 = v_lshl_add_u32_shift_imm_src2_lit %20 {shift = 4, imm32 = 15360}
  %22 = s_mov_b32 3229614080
  %23 = s_mov_b32 1614815232
  %24 = v_perm_b32 %23, %22, %20
  %25 = s_mov_b32 993737472
  %26 = s_mov_b32 1010580540
  %27 = v_perm_b32 %26, %25, %20
  %28 = v_lshl_add_u32_shift_imm %27, %24, 8
  %29 = v_cmp_lt_u32_src1_inline %20 {rhs = 8}
  %30 = v_cndmask_b32 %21, %28, %29
  %31 = v_lshlrev_b32_src0_inline %19, 8
  %32 = v_bfi_b32_src0_lit %31, %30, 32768
  %33 = v_and_b32_lit %32, 65535
  %35 = v_lshlrev_b32_src0_inline %33, 16
  %converted = v_or_b32 %33, %35
  %37 = slice %result[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = slice %result[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %39 = v_mov_b32_copy %37
  %40 = v_mov_b32_copy %38
  %41 = concat(%39, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %41, %converted
  return
}

