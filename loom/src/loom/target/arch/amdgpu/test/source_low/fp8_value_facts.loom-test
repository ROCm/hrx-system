  %21 = v_lshlrev_b32_src0_inline %20, 8
  %22 = v_and_b32_lit %19, 127
  %23 = v_lshl_add_u32_shift_imm_src2_lit %22 {shift = 5, imm32 = 14336}
  %24 = v_lshlrev_b32_src0_inline %22, 1
  %25 = v_add_u32_src0_inline %24, 1
  %26 = v_lshl_add_u32_shift_imm %25, %24, 8
  %27 = s_mov_b32 931135488
  %28 = s_mov_b32 943732736
  %29 = v_perm_b32 %28, %27, %26
  %30 = v_and_b32_lit %29, 65535
  %31 = v_cmp_lt_u32_src1_inline %22 {rhs = 4}
  %32 = v_cndmask_b32 %23, %30, %31
  %33 = v_or_b32 %21, %32
  %34 = v_or_b32_lit %21, 32640
  %35 = v_mov_b32 124
  %36 = v_cmp_eq_i32 %22, %35
  %37 = v_cndmask_b32 %33, %34, %36
