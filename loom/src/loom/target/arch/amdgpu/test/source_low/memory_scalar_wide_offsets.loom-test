  %53 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = slice %51[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %55 = slice %51[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %56, %57 = s_add_co_u32 %52, %54
  %58, %59 = s_addc_u32 %53, %55, %57
  %60 = concat(%56, %58) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
