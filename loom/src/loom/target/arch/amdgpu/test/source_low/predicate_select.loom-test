amdgpu.target<gfx11-generic> @target

func.def public target(@target) @predicate_scf_select_crossing(%condition: i1, %12: vector<32xi1>, %13: vector<1xi1>, %14: vector<32xi1>, %15: vector<1xi1>) -> (vector<32xi1>, vector<1xi1>) {
  %18 = scf.select %condition, %12, %14 : vector<32xi1>
  %19 = scf.select %condition, %13, %15 : vector<1xi1>
  func.return %18, %19 : vector<32xi1>, vector<1xi1>
}
