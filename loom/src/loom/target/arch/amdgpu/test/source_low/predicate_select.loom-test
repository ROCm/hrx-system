kernel.def @predicate_scf_select_uniform() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%selector: i32, %true_value_buffer: buffer, %false_value_buffer: buffer, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %true_value_view = buffer.view %true_value_buffer[%fixture_base] : buffer -> view<64x4xi8>
  %true_value_bits = vector.load %true_value_view[%fixture_lane, 0] : view<64x4xi8> -> vector<4xi8>
  %true_value = vector.trunci %true_value_bits : vector<4xi8> to vector<4xi1>
  %false_value_view = buffer.view %false_value_buffer[%fixture_base] : buffer -> view<64x4xi8>
  %false_value_bits = vector.load %false_value_view[%fixture_lane, 0] : view<64x4xi8> -> vector<4xi8>
  %false_value = vector.trunci %false_value_bits : vector<4xi8> to vector<4xi1>
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64x4xi8>
  %c0 = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %selector, %c0 : i32
  %selected = scf.select %condition, %true_value, %false_value : vector<4xi1>
  %result_bits_1_0 = vector.extui %selected : vector<4xi1> to vector<4xi8>
  vector.store %result_bits_1_0, %result_view_0[%fixture_lane, 0] : vector<4xi8>, view<64x4xi8>
  kernel.return
}

