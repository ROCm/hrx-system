low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_select_four(%mask: reg<amdgpu.sgpr x8>, %true_value: reg<amdgpu.sgpr x8>, %false_value: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x8>) asm {
  %9 = slice %mask[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %10 = slice %true_value[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %11 = s_and_b64 %9, %10
  %12 = s_mov_b64_exec_read
  %14 = s_xor_b64 %9, %12
  %15 = slice %false_value[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %16 = s_and_b64 %14, %15
  %17 = s_or_b64 %11, %16
  %18 = slice %mask[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %19 = slice %true_value[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %20 = s_and_b64 %18, %19
  %23 = s_xor_b64 %18, %12
  %24 = slice %false_value[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %25 = s_and_b64 %23, %24
  %26 = s_or_b64 %20, %25
  %27 = slice %mask[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %28 = slice %true_value[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %29 = s_and_b64 %27, %28
  %32 = s_xor_b64 %27, %12
  %33 = slice %false_value[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %34 = s_and_b64 %32, %33
  %35 = s_or_b64 %29, %34
  %36 = slice %mask[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %37 = slice %true_value[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %38 = s_and_b64 %36, %37
  %41 = s_xor_b64 %36, %12
  %42 = slice %false_value[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %43 = s_and_b64 %41, %42
  %44 = s_or_b64 %38, %43
  %selected = concat(%17, %26, %35, %44) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x8>
  return %selected
}

// ====

func.def @predicate_scf_select_rank2(%conditions: vector<1xi1>, %true_value: vector<2x2xi1>, %false_value: vector<2x2xi1>) -> (vector<2x2xi1>) {
  %condition = vector.extract %conditions[0] : vector<1xi1> -> i1
  %selected = scf.select %condition, %true_value, %false_value : vector<2x2xi1>
  func.return %selected : vector<2x2xi1>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_scf_select_rank2(%condition: reg<amdgpu.sgpr x2>, %true_value: reg<amdgpu.sgpr x8>, %false_value: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x8>) asm {
  %10 = s_mov_b64_exec_read
  %11 = s_xor_b64 %condition, %10
  %12 = slice %true_value[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %13 = s_and_b64 %condition, %12
  %14 = slice %false_value[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %15 = s_and_b64 %11, %14
  %16 = s_or_b64 %13, %15
  %17 = slice %true_value[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %18 = s_and_b64 %condition, %17
  %19 = slice %false_value[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %20 = s_and_b64 %11, %19
  %21 = s_or_b64 %18, %20
  %22 = slice %true_value[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %23 = s_and_b64 %condition, %22
  %24 = slice %false_value[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %25 = s_and_b64 %11, %24
  %26 = s_or_b64 %23, %25
  %27 = slice %true_value[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %28 = s_and_b64 %condition, %27
  %29 = slice %false_value[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %30 = s_and_b64 %11, %29
  %31 = s_or_b64 %28, %30
  %selected = concat(%16, %21, %26, %31) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x8>
  return %selected
}

// ====

func.def @predicate_scf_select_uniform(%selector: i32, %true_value: vector<4xi1>, %false_value: vector<4xi1>) -> (vector<4xi1>) {
  %c0 = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %selector, %c0 : i32
  %selected = scf.select %condition, %true_value, %false_value : vector<4xi1>
  func.return %selected : vector<4xi1>
}

