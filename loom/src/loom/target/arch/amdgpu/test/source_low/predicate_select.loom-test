// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @predicate_scf_select_crossing(%condition: i1, %true_value: vector<33xi1>, %false_value: vector<33xi1>) -> (vector<33xi1>) {
  %selected = scf.select %condition, %true_value, %false_value : vector<33xi1>
  func.return %selected : vector<33xi1>
}

