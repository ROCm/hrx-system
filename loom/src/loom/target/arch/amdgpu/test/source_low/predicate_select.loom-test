  %61 = slice %true_value[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %60 = slice %false_value[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %26 = s_cselect_b32 %61, %60, %condition
  %59 = slice %true_value[3] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %58 = slice %false_value[3] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %29 = s_cselect_b32 %59, %58, %condition
  %30 = concat(%26, %29) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %57 = slice %true_value[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %56 = slice %false_value[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %35 = s_cselect_b32 %57, %56, %condition
  %55 = slice %true_value[5] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %54 = slice %false_value[5] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %38 = s_cselect_b32 %55, %54, %condition
  %39 = concat(%35, %38) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %53 = slice %true_value[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %52 = slice %false_value[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %44 = s_cselect_b32 %53, %52, %condition
  %51 = slice %true_value[7] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %50 = slice %false_value[7] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
