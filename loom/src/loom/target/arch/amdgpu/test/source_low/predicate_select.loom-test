low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_scf_select_uniform(%selector: reg<amdgpu.sgpr>, %true_value: reg<amdgpu.sgpr x8>, %false_value: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x8>) asm {
