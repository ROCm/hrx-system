// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @predicate_select_crossing(%mask: vector<33xi1>, %true_value: vector<33xi1>, %false_value: vector<33xi1>) -> (vector<33xi1>) {
  %selected = vector.select %mask, %true_value, %false_value : vector<33xi1>
  func.return %selected : vector<33xi1>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @predicate_select_crossing(%13: vector<32xi1>, %14: vector<1xi1>, %15: vector<32xi1>, %16: vector<1xi1>, %17: vector<32xi1>, %18: vector<1xi1>) -> (vector<32xi1>, vector<1xi1>) {
  %21 = vector.select %13, %15, %17 : vector<32xi1>
  %22 = vector.select %14, %16, %18 : vector<1xi1>
  func.return %21, %22 : vector<32xi1>, vector<1xi1>
}

