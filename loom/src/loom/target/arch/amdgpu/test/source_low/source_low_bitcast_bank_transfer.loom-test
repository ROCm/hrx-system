low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @i32_uniform_vector_bitcast() asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 1024, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = s_mov_b32 0
  %loaded = s_load_dwordx4 %input_view, %19
  %21 = slice %loaded[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %22 = v_mov_b32_copy %21
  %23 = slice %loaded[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %24 = v_mov_b32_copy %23
  %25 = slice %loaded[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %26 = v_mov_b32_copy %25
  %27 = slice %loaded[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %28 = v_mov_b32_copy %27
  %floats = concat(%22, %24, %26, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %30 = v_lshlrev_b32_src0_inline %fixture_lane, 4
  global_store_b128_saddr %30, %floats, %result_view_0
  return
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @wide_offset_from_words(%words: vector<2xi32>) -> (offset) {
  %packed = vector.bitcast %words : vector<2xi32> to vector<1xi64>
  %bits = vector.extract %packed[0] : vector<1xi64> -> i64
  %address_bits = scalar.assume %bits [range(%bits, 0, 9223372036854775807)] : i64
  %bytes = index.cast %address_bits : i64 to offset
  func.return %bytes : offset
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_offset_from_words(%bytes: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  return %bytes
}
