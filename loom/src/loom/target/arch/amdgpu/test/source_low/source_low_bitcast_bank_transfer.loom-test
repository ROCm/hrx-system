// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target
func.def target(@target) @i32_uniform_vector_bitcast(%input: buffer) -> (vector<4xf32>) {
  %base = index.constant 0 : offset
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %input_noalias = buffer.assume.noalias %input_global : buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<4xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %floats = vector.bitcast %loaded : vector<4xi32> to vector<4xf32>
  func.return %floats : vector<4xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @i32_uniform_vector_bitcast() -> (reg<amdgpu.vgpr x4>) asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 16} : reg<amdgpu.sgpr x2>
  %10 = s_mov_b32 0
  %loaded = s_load_dwordx4 %input_view, %10
  %12 = slice %loaded[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %13 = v_mov_b32_copy %12
  %14 = slice %loaded[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %15 = v_mov_b32_copy %14
  %16 = slice %loaded[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %17 = v_mov_b32_copy %16
  %18 = slice %loaded[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %floats = concat(%13, %15, %17, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %floats
}
