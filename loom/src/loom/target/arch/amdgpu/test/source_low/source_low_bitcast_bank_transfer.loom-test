// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @i32_uniform_vector_bitcast() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64x4xf32>
  %base = index.constant 0 : offset
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %input_noalias = buffer.assume.noalias %input_global : buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<4xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %floats = vector.bitcast %loaded : vector<4xi32> to vector<4xf32>
  vector.store %floats, %result_view_0[%fixture_lane, 0] : vector<4xf32>, view<64x4xf32>
  kernel.return
}

