// RUN: emit source-low target=amdgpu:gfx942 output=low

// CDNA materializes and reuses register selectors for fixed index packing.

func.def @byte_table_i32_indices_cdna(%table: vector<8xi8>, %input: vector<4xi32>) -> (vector<4xi8>) {
  %mask_scalar = scalar.constant 7 : i32
  %mask = vector.splat %mask_scalar : vector<4xi32>
  %indices = vector.andi %input, %mask : vector<4xi32>
  %values = vector.table.lookup %table[%indices] : vector<8xi8>, vector<4xi32> -> vector<4xi8>
  func.return %values : vector<4xi8>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @byte_table_i32_indices_cdna(%table: reg<amdgpu.vgpr x2>, %input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr>) asm {
  %10 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = v_and_b32_lit %10, 7
  %12 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %13 = v_and_b32_lit %12, 7
  %14 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = v_and_b32_lit %14, 7
  %16 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = v_and_b32_lit %16, 7
  %19 = slice %table[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20 = slice %table[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %25 = s_mov_b32 4
  %26 = v_perm_b32 %11, %13, %25
  %27 = v_perm_b32 %15, %17, %25
  %28 = s_mov_b32 16778500
  %29 = v_perm_b32 %26, %27, %28
  %values = v_perm_b32 %20, %19, %29
  return %values
}
