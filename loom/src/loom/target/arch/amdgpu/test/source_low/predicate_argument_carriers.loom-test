// ====

// A multiword packed argument and an odd-sized argument have independent ABI
// padding. Resources and unused direct arguments retain their signature slots.
amdgpu.target<gfx942> @target {subgroup_size = 64}

kernel.def target(@target) @concatenate_argument_masks() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%left: vector<5xi1>, %output: buffer, %unused: i1, %right: vector<3xi1>) {
  %identity = vector.shuffle<[0, 1, 2, 3, 4]> %left : vector<5xi1>
  %joined = vector.concat<0> %identity, %right : vector<5xi1>, vector<3xi1> -> vector<8xi1>
  %enabled = vector.splati 1 : vector<8xi32>
  %disabled = vector.splati 0 : vector<8xi32>
  %selected = vector.select %joined, %enabled, %disabled : vector<8xi32>
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<8xi32>
  vector.store %selected, %view[0] : vector<8xi32>, view<8xi32>
  kernel.return
}

