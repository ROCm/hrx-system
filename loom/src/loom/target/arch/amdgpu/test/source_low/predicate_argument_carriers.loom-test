  %17 = slice %15[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = s_mov_b32 0
  %19 = s_bfe_u32_lit %condition$13, 524288
  %20 = s_cmp_lg_i32_src1_inline %19 {rhs = 0}
  %21 = s_cselect_b32 %16, %18, %20
  %22 = s_cselect_b32 %17, %18, %20
  %condition$23 = concat(%21, %22) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %26 = s_mov_b64_exec_read
  %inverse = s_xor_b64 %condition$23, %26
  %constructed = concat(%condition$23, %inverse, %condition$23) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x6>
  %splat = concat(%condition$23, %condition$23, %condition$23) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x6>
  %38 = slice %constructed[0] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %39 = v_cndmask_b32_src0_lit_src1_inline %38 {imm32 = 0, true_value = 1}
  %40 = slice %constructed[2] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %41 = v_cndmask_b32_src0_lit_src1_inline %40 {imm32 = 0, true_value = 1}
  %42 = slice %constructed[4] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %43 = v_cndmask_b32_src0_lit_src1_inline %42 {imm32 = 0, true_value = 1}
  %selected = concat(%39, %41, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %45 = slice %splat[0] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %46 = v_cndmask_b32_src0_lit_src1_inline %45 {imm32 = 0, true_value = 1}
  %47 = slice %splat[2] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %48 = v_cndmask_b32_src0_lit_src1_inline %47 {imm32 = 0, true_value = 1}
  %49 = slice %splat[4] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %50 = v_cndmask_b32_src0_lit_src1_inline %49 {imm32 = 0, true_value = 1}
  %repeated = concat(%46, %48, %50) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %52 = v_mov_b32 0
  global_store_b96_saddr %52, %selected, %view
  %53 = v_mov_b32 0
  global_store_b96_saddr %53, %repeated, %view {offset = 12}
  return
}

// ====

// A multiword packed argument and an odd-sized argument have independent ABI
// padding. Resources and unused direct arguments retain their signature slots.
amdgpu.target<gfx942> @target {subgroup_size = 64}

kernel.def target(@target) @concatenate_argument_masks() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%left: vector<5xi1>, %output: buffer, %unused: i1, %right: vector<3xi1>) {
  %identity = vector.shuffle<[0, 1, 2, 3, 4]> %left : vector<5xi1>
  %joined = vector.concat<0> %identity, %right : vector<5xi1>, vector<3xi1> -> vector<8xi1>
  %enabled = vector.splati 1 : vector<8xi32>
  %disabled = vector.splati 0 : vector<8xi32>
  %selected = vector.select %joined, %enabled, %disabled : vector<8xi32>
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<8xi32>
  vector.store %selected, %view[0] : vector<8xi32>, view<8xi32>
  kernel.return
}

