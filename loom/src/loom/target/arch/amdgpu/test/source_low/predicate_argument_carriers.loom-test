// RUN: pass source-to-low,low-dce

// Body planning sees native masks even when construction mixes a kernel
// argument with a computed predicate. Splat retains the same representation.
amdgpu.target<gfx1100> @target {subgroup_size = 32}

kernel.def target(@target) @construct_argument_masks() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%condition: i1, %output: buffer) {
  %true = scalar.constant 1 : i1
  %inverse = scalar.xori %condition, %true : i1
  %constructed = vector.from_elements %condition, %inverse, %condition : vector<3xi1>
  %splat = vector.splat %condition : vector<3xi1>
  %enabled = vector.splati 1 : vector<3xi32>
  %disabled = vector.splati 0 : vector<3xi32>
  %selected = vector.select %constructed, %enabled, %disabled : vector<3xi32>
  %repeated = vector.select %splat, %enabled, %disabled : vector<3xi32>
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<6xi32>
  vector.store %selected, %view[0] : vector<3xi32>, view<6xi32>
  vector.store %repeated, %view[3] : vector<3xi32>, view<6xi32>
  kernel.return
}

