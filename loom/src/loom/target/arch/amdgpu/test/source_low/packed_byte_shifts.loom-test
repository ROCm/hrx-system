// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// A single runtime count supplies the mask for both register words.
func.def @shared_right(%values: vector<7xi8>, %amount: i8) -> (vector<7xi8>) {
  %counts = vector.splat %amount : vector<7xi8>
  %result = vector.shrui %values, %counts : vector<7xi8>
  func.return %result : vector<7xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @shared_right(%values: reg<amdgpu.vgpr x2>, %amount: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %8 = v_mov_b32 255
  %9 = s_mov_b32 16843009
  %10 = v_lshrrev_b32 %amount, %8
  %11 = v_mul_lo_u32 %9, %10
  %12 = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %13 = v_lshrrev_b32 %amount, %12
  %14 = v_and_b32 %11, %13
  %15 = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %16 = v_lshrrev_b32 %amount, %15
  %17 = v_and_b32 %11, %16
  %result = concat(%14, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

// Even and odd byte counts independently select their two halfword shifts.
// The right shifts place the source sign in the high bit before selecting.
func.def @independent_bytes(%values: vector<4xi8>, %counts: vector<4xi8>) -> (vector<4xi8>, vector<4xi8>, vector<4xi8>) {
  %left = vector.shli %values, %counts : vector<4xi8>
  %logical = vector.shrui %values, %counts : vector<4xi8>
  %signed = vector.shrsi %values, %counts : vector<4xi8>
  func.return %left, %logical, %signed : vector<4xi8>, vector<4xi8>, vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @independent_bytes(%values: reg<amdgpu.vgpr>, %counts: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %13 = s_mov_b32 33947652
  %14 = v_lshrrev_b32_src0_inline %values, 8
  %15 = v_lshrrev_b32_src0_inline %counts, 8
  %16 = v_pk_lshlrev_b16 %counts, %values
  %17 = v_pk_lshlrev_b16 %15, %14
  %left = v_perm_b32 %16, %17, %13
  %19 = s_mov_b32 50790661
  %20 = v_lshlrev_b32_src0_inline %values, 8
  %22 = v_pk_lshrrev_b16 %counts, %20
  %23 = v_pk_lshrrev_b16 %15, %values
  %logical = v_perm_b32 %22, %23, %19
  %28 = v_pk_ashrrev_i16 %counts, %20
  %29 = v_pk_ashrrev_i16 %15, %values
  %signed = v_perm_b32 %28, %29, %19
  return %left, %logical, %signed
}
