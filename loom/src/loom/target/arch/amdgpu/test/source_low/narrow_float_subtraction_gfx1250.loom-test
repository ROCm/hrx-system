  %23 = v_cvt_f32_f16 %18
  %25 = v_lshrrev_b32_src0_inline %18, 16
  %26 = v_cvt_f32_f16 %25
  %28 = v_cvt_f32_f16 %20
  %31 = global_load_b32_saddr %17, %right
  %33 = global_load_u16_saddr %17, %right {offset = 4}
  %36 = v_cvt_f32_f16 %31
  %38 = v_lshrrev_b32_src0_inline %31, 16
  %39 = v_cvt_f32_f16 %38
  %41 = v_cvt_f32_f16 %33
  %45 = v_sub_f32 %23, %36
  %48 = v_sub_f32 %26, %39
  %51 = v_sub_f32 %28, %41
  %54 = v_cvt_f16_f32 %45
  %55 = v_bfe_u32_offset_0_width_16_low16 %54
  %57 = v_cvt_f16_f32 %48
  %58 = v_bfe_u32_offset_0_width_16_low16 %57
  %59 = v_lshl_add_u32_shift_imm %58, %55, 16
  %61 = v_cvt_f16_f32 %51
  %62 = v_bfe_u32_offset_0_width_16_low16 %61
  global_store_b32_saddr %17, %59, %result
  global_store_short_saddr %17, %62, %result {offset = 4}
