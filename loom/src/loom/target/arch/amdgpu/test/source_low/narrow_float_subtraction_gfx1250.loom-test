// TEMPLATE: loom/src/loom/test/corpus/source_low/narrow_float_subtraction.loom-test
// RUN: emit source-low target=amdgpu:gfx1250 output=low

func.def @subtract_f16_1(%lhs: f16, %rhs: f16) -> (f16) {
  %difference = scalar.subf %lhs, %rhs : f16
  func.return %difference : f16
}

// ----
low.func.def target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @subtract_f16_1(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %difference = v_sub_f16 %lhs, %rhs
  %8 = v_bfe_u32_offset_0_width_16_low16 %difference
  return %8
}

// ====

func.def @subtract_f16_2(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %byte_offset = index.constant 0 : offset
  %left = buffer.view %lhs[%byte_offset] : buffer -> view<2xf16>
  %right = buffer.view %rhs[%byte_offset] : buffer -> view<2xf16>
  %result = buffer.view %output[%byte_offset] : buffer -> view<2xf16>
  %a = vector.load %left[0] : view<2xf16> -> vector<2xf16>
  %b = vector.load %right[0] : view<2xf16> -> vector<2xf16>
  %difference = vector.subf %a, %b : vector<2xf16>
  vector.store %difference, %result[0] : vector<2xf16>, view<2xf16>
  func.return
}

// ----
low.func.def target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @subtract_f16_2() asm {
  %left = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %right = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_mov_b32 0
  %a = global_load_b32_saddr %13, %left
  %b = global_load_b32_saddr %13, %right
  %difference = v_pk_add_f16 %a, %b {neg_lo = 2, neg_hi = 2}
  global_store_b32_saddr %13, %difference, %result
  return
}

