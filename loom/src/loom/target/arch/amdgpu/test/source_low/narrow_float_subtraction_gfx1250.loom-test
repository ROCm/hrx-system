func.def @subtract_bf16_1(%lhs: bf16, %rhs: bf16) -> (bf16) {
  %difference = scalar.subf %lhs, %rhs : bf16
  func.return %difference : bf16
}

// ----
low.func.def target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @subtract_bf16_1(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %11 = v_lshlrev_b32_src0_16_low16 %lhs
  %12 = v_lshlrev_b32_src0_16_low16 %rhs
  %13 = v_sub_f32 %11, %12
  %14 = v_lshrrev_b32_src0_inline %13, 16
  %15 = v_and_b32_lit %14, 1
  %16 = v_add_u32_lit %15, 32767
  %17 = v_add_u32 %13, %16
  %difference = v_lshrrev_b32_src0_inline %17, 16
  return %difference
}

