low.func.def target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @subtract_f16_8() asm {
  %left = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %right = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 16, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_mov_b32 0
  %a = global_load_b128_saddr %13, %left
  %b = global_load_b128_saddr %13, %right
  %17 = slice %a[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = slice %b[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %19 = v_pk_add_f16 %17, %18 {neg_lo = 2, neg_hi = 2}
  %20 = slice %a[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = slice %b[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22 = v_pk_add_f16 %20, %21 {neg_lo = 2, neg_hi = 2}
  %23 = slice %a[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %24 = slice %b[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %25 = v_pk_add_f16 %23, %24 {neg_lo = 2, neg_hi = 2}
  %26 = slice %a[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %27 = slice %b[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %28 = v_pk_add_f16 %26, %27 {neg_lo = 2, neg_hi = 2}
  %difference = concat(%19, %22, %25, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %13, %difference, %result
  return
}

