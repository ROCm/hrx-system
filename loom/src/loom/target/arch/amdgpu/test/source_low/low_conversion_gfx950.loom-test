// ====
// RUN: emit amdgpu-assembly @gfx950_packed8_encode_f32

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @gfx950_packed8_encode_f32(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %d: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %fp8_low = v_cvt_pk_fp8_f32_low %a, %b
  %fp8 = v_cvt_pk_fp8_f32_high %fp8_low, %c, %d
  %bf8_low = v_cvt_pk_bf8_f32_low %a, %b
  %bf8 = v_cvt_pk_bf8_f32_high %bf8_low, %c, %d
  return %fp8, %bf8
}

