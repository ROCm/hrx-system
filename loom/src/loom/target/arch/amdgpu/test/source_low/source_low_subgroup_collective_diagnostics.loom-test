// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @subgroup_broadcast_dynamic_lane_rejected() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer) {
  %input_base = index.constant 0 : offset
  %input_view = buffer.view %input[%input_base] : buffer -> view<1xi32>
  %lane_vector = vector.load %input_view[0] : view<1xi32> -> vector<1xi32>
  %lane = vector.extract %lane_vector[0] : vector<1xi32> -> i32
  %workitem = kernel.workitem.id<x> : index
  %value = index.cast %workitem : index to i32
  // ERROR@+1: AMDGPU/023 {constraint_key="subgroup_broadcast.lane_range"}
  %broadcast = kernel.subgroup.broadcast %value from %lane : i32, i32
  kernel.return
}

