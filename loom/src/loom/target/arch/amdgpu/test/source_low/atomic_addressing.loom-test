  %31 = v_xor_b32_lit %30, 4294967295
  %32 = v_and_b32_lit %expected, 65535
  %33 = v_and_b32_lit %replacement, 65535
  %34 = v_lshlrev_b32 %28, %32
  %35 = v_lshlrev_b32 %28, %33
  %36 = v_mov_b32 0
  %37 = s_mov_b64_exec_read
  low.br ^_bb1(%36: reg<amdgpu.vgpr>, %37: reg<amdgpu.sgpr x2>)
^_bb1(%38: reg<amdgpu.vgpr>, %39: reg<amdgpu.sgpr x2>):
