func.def @i32_to_u8x4_bitunpack(%packed: vector<1xi32>) -> (vector<4xi32>) {
  %unpacked = vector.bitunpacku<8> %packed : vector<1xi32> -> vector<4xi32>
  func.return %unpacked : vector<4xi32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i32_to_u8x4_bitunpack(%packed: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %5 = v_and_b32_lit %packed, 255
  %6 = v_bfe_u32_offset_width_inline %packed {offset = 8, width = 8}
  %7 = v_bfe_u32_offset_width_inline %packed {offset = 16, width = 8}
  %8 = v_bfe_u32_offset_width_inline %packed {offset = 24, width = 8}
  %unpacked = concat(%5, %6, %7, %8) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %unpacked
}

