low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8_table_indexed_bytes(%table: reg<amdgpu.vgpr x4>, %raw: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %mask = v_mov_b32 252645135
  %indices = v_and_b32 %raw, %mask
  %31 = slice %table[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %32 = slice %table[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %33 = slice %table[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %34 = slice %table[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %35 = v_and_b32_lit %indices, 117901063
  %36 = v_perm_b32 %32, %31, %35
  %37 = v_perm_b32 %34, %33, %35
  %38 = v_and_b32_lit %indices, 134744072
  %39 = v_lshrrev_b32_src0_inline %38, 1
  %40 = v_or_b32_lit %39, 50462976
  %result = v_perm_b32 %37, %36, %40
  return %result
}
