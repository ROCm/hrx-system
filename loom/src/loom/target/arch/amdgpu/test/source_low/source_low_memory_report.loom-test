// ====

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @report_static_lds_address_fields() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<1xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[0] : vector<1xi32>, view<1xi32>
  kernel.return
}

