amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @report_lds_f16_subword_stride_fields() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<128xf16>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<128xf16>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<128xf16>
  %loaded = vector.load %input_view[%tid] : view<128xf16> -> vector<2xf16>
  vector.store %loaded, %scratch_view[%tid] : vector<2xf16>, view<128xf16>
  %roundtrip = vector.load %scratch_view[%tid] : view<128xf16> -> vector<2xf16>
  vector.store %roundtrip, %output_view[%tid] : vector<2xf16>, view<128xf16>
  kernel.return
}

