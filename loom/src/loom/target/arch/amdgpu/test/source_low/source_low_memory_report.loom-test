amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @report_lds_b128_single_lane_extract() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xi32>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64x4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = vector.load %input_view[%tid, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %loaded, %scratch_view[%tid, 0] : vector<4xi32>, view<64x4xi32>
  %roundtrip = vector.load %scratch_view[%tid, 0] : view<64x4xi32> -> vector<4xi32>
  %lane2 = vector.extract %roundtrip[2] : vector<4xi32> -> i32
  view.store %lane2, %output_view[%tid] : i32, view<64xi32>
  kernel.return
}

