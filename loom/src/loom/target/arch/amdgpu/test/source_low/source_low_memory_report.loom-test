  %loaded = vector.fragment.load<rhs> %input_view[0, 0] shape [%k, %n] : view<16x16xf8E4M3, %input_layout> -> vector<4xbf16>
  vector.store %loaded, %output_view[0] : vector<4xbf16>, view<4xbf16, #dense>
  kernel.return
}

