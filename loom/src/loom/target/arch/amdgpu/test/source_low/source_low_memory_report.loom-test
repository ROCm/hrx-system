// RUN: compile-report source-to-low,low-dce

amdgpu.target<gfx1250> @target

kernel.def target(@target) @report_static_cluster_size() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%c4, %c4, %c1) workgroup_size(%c32, %c1, %c1) cluster_size(%c1, %c2, %c1) : index
} launch() {
  kernel.return
}

