// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_boolean_comparison.loom-test
// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def public @boolean_comparisons(%left: i32, %right: i32) -> (i32) {
  %c0 = scalar.constant 0 : i32
  %lhs = scalar.cmpi ne, %left, %c0 : i32
  %rhs = scalar.cmpi ne, %right, %c0 : i32
  %eq = scalar.cmpi eq, %lhs, %rhs : i1
  %eq_bit = scalar.extui %eq : i1 to i32
  %ne = scalar.cmpi ne, %lhs, %rhs : i1
  %ne_bit = scalar.extui %ne : i1 to i32
  %shift_1 = scalar.constant 1 : i32
  %ne_shifted = scalar.shli %ne_bit, %shift_1 : i32
  %mask_1 = scalar.ori %eq_bit, %ne_shifted : i32
  %slt = scalar.cmpi slt, %lhs, %rhs : i1
  %slt_bit = scalar.extui %slt : i1 to i32
  %shift_2 = scalar.constant 2 : i32
  %slt_shifted = scalar.shli %slt_bit, %shift_2 : i32
  %mask_2 = scalar.ori %mask_1, %slt_shifted : i32
  %sle = scalar.cmpi sle, %lhs, %rhs : i1
  %sle_bit = scalar.extui %sle : i1 to i32
  %shift_3 = scalar.constant 3 : i32
  %sle_shifted = scalar.shli %sle_bit, %shift_3 : i32
  %mask_3 = scalar.ori %mask_2, %sle_shifted : i32
  %sgt = scalar.cmpi sgt, %lhs, %rhs : i1
  %sgt_bit = scalar.extui %sgt : i1 to i32
  %shift_4 = scalar.constant 4 : i32
  %sgt_shifted = scalar.shli %sgt_bit, %shift_4 : i32
  %mask_4 = scalar.ori %mask_3, %sgt_shifted : i32
  %sge = scalar.cmpi sge, %lhs, %rhs : i1
  %sge_bit = scalar.extui %sge : i1 to i32
  %shift_5 = scalar.constant 5 : i32
  %sge_shifted = scalar.shli %sge_bit, %shift_5 : i32
  %mask_5 = scalar.ori %mask_4, %sge_shifted : i32
  %ult = scalar.cmpi ult, %lhs, %rhs : i1
  %ult_bit = scalar.extui %ult : i1 to i32
  %shift_6 = scalar.constant 6 : i32
  %ult_shifted = scalar.shli %ult_bit, %shift_6 : i32
  %mask_6 = scalar.ori %mask_5, %ult_shifted : i32
  %ule = scalar.cmpi ule, %lhs, %rhs : i1
  %ule_bit = scalar.extui %ule : i1 to i32
  %shift_7 = scalar.constant 7 : i32
  %ule_shifted = scalar.shli %ule_bit, %shift_7 : i32
  %mask_7 = scalar.ori %mask_6, %ule_shifted : i32
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i1
  %ugt_bit = scalar.extui %ugt : i1 to i32
  %shift_8 = scalar.constant 8 : i32
  %ugt_shifted = scalar.shli %ugt_bit, %shift_8 : i32
  %mask_8 = scalar.ori %mask_7, %ugt_shifted : i32
  %uge = scalar.cmpi uge, %lhs, %rhs : i1
  %uge_bit = scalar.extui %uge : i1 to i32
  %shift_9 = scalar.constant 9 : i32
  %uge_shifted = scalar.shli %uge_bit, %shift_9 : i32
  %mask_9 = scalar.ori %mask_8, %uge_shifted : i32
  func.return %mask_9 : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @boolean_comparisons(%left: reg<amdgpu.sgpr>, %right: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %c0 = s_mov_b32 0
  %lhs = s_cmp_lg_i32 %left, %c0
  %rhs = s_cmp_lg_i32 %right, %c0
  %106 = s_mov_b32 1
  %107 = s_cselect_b32 %106, %c0, %lhs
  %108 = s_cselect_b32 %106, %c0, %rhs
  %109 = s_xor_b32 %107, %108
  %110 = s_cmp_lg_i32 %109, %c0
  %112 = s_cmp_eq_i32 %c0, %c0
  %115 = s_cselect_b32 %106, %c0, %110
  %116 = s_cselect_b32 %106, %c0, %112
  %117 = s_xor_b32 %115, %116
  %eq = s_cmp_lg_i32 %117, %c0
  %eq_bit = s_cselect_b32 %106, %c0, %eq
  %ne_shifted = s_lshl_b32 %115, %106
  %mask_1 = s_or_b32 %eq_bit, %ne_shifted
  %128 = s_xor_b32 %108, %116
  %129 = s_cmp_lg_i32 %128, %c0
  %132 = s_cselect_b32 %106, %c0, %129
  %134 = s_and_b32 %132, %107
  %slt = s_cmp_lg_i32 %134, %c0
  %slt_bit = s_cselect_b32 %106, %c0, %slt
  %shift_2 = s_mov_b32 2
  %slt_shifted = s_lshl_b32 %slt_bit, %shift_2
  %mask_2 = s_or_b32 %mask_1, %slt_shifted
  %144 = s_or_b32 %132, %107
  %sle = s_cmp_lg_i32 %144, %c0
  %sle_bit = s_cselect_b32 %106, %c0, %sle
  %shift_3 = s_mov_b32 3
  %sle_shifted = s_lshl_b32 %sle_bit, %shift_3
  %mask_3 = s_or_b32 %mask_2, %sle_shifted
  %154 = s_xor_b32 %107, %116
  %155 = s_cmp_lg_i32 %154, %c0
  %158 = s_cselect_b32 %106, %c0, %155
  %160 = s_and_b32 %158, %108
  %sgt = s_cmp_lg_i32 %160, %c0
  %sgt_bit = s_cselect_b32 %106, %c0, %sgt
  %shift_4 = s_mov_b32 4
  %sgt_shifted = s_lshl_b32 %sgt_bit, %shift_4
  %mask_4 = s_or_b32 %mask_3, %sgt_shifted
  %170 = s_or_b32 %158, %108
  %sge = s_cmp_lg_i32 %170, %c0
  %sge_bit = s_cselect_b32 %106, %c0, %sge
  %shift_5 = s_mov_b32 5
  %sge_shifted = s_lshl_b32 %sge_bit, %shift_5
  %mask_5 = s_or_b32 %mask_4, %sge_shifted
  %shift_6 = s_mov_b32 6
  %ult_shifted = s_lshl_b32 %sgt_bit, %shift_6
  %mask_6 = s_or_b32 %mask_5, %ult_shifted
  %shift_7 = s_mov_b32 7
  %ule_shifted = s_lshl_b32 %sge_bit, %shift_7
  %mask_7 = s_or_b32 %mask_6, %ule_shifted
  %shift_8 = s_mov_b32 8
  %ugt_shifted = s_lshl_b32 %slt_bit, %shift_8
  %mask_8 = s_or_b32 %mask_7, %ugt_shifted
  %shift_9 = s_mov_b32 9
  %uge_shifted = s_lshl_b32 %sle_bit, %shift_9
  %mask_9 = s_or_b32 %mask_8, %uge_shifted
  return %mask_9
}

// ====

func.def public @boolean_constants() -> (i1, i1) {
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  func.return %false, %true : i1, i1
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @boolean_constants() -> (reg<amdgpu.scc>, reg<amdgpu.scc>) asm {
  %6 = s_mov_b32 0
  %false = s_cmp_lg_i32 %6, %6
  %true = s_cmp_eq_i32 %6, %6
  return %false, %true
}

// ====

func.def public @boolean_algebra(%lhs: i1, %rhs: i1) -> (i1, i1, i1) {
  %and = scalar.andi %lhs, %rhs : i1
  %or = scalar.ori %lhs, %rhs : i1
  %xor = scalar.xori %lhs, %rhs : i1
  func.return %and, %or, %xor : i1, i1, i1
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @boolean_algebra(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.scc>, reg<amdgpu.scc>, reg<amdgpu.scc>) asm {
  %13 = s_mov_b32 0
  %14 = s_and_b32 %lhs, %rhs
  %and = s_cmp_lg_i32 %14, %13
  %17 = s_or_b32 %lhs, %rhs
  %or = s_cmp_lg_i32 %17, %13
  %20 = s_xor_b32 %lhs, %rhs
  %xor = s_cmp_lg_i32 %20, %13
  return %and, %or, %xor
}

// ====

func.def public @boolean_unsigned_extensions(%input: i1) -> (i32, i64) {
  %word = scalar.extui %input : i1 to i32
  %wide = scalar.extui %input : i1 to i64
  func.return %word, %wide : i32, i64
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @boolean_unsigned_extensions(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) asm {
  %14 = s_mov_b32 1
  %15 = s_mov_b32 0
  %16 = s_cmp_lg_i32_src1_inline %input {rhs = 0}
  %word = s_cselect_b32 %14, %15, %16
  %24 = s_cmp_lg_i32_src1_inline %input {rhs = 0}
  %27 = s_cselect_b32 %14, %15, %24
  %30 = s_cselect_b32 %15, %15, %24
  %wide = concat(%27, %30) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %word, %wide
}
