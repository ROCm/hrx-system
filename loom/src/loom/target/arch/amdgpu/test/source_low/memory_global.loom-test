// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Descriptor extents include projected origins and fall back to full global
// addressing when their hardware bound cannot represent the view. Uniform
// readonly loads retain scalar results until a consumer requires vector storage.

kernel.def @descriptor_dynamic_base_static_extent_load_i32() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %base_i32: i32, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi32>
  %base0 = index.cast %base_i32 : i32 to offset
  %base = index.assume %base0 [range(%base0, 0, 4092), multiple_of(%base0, 4)] : offset
  %input_descriptor = buffer.assume.memory_space<descriptor> %input : buffer
  %input_view = buffer.view %input_descriptor[%base] : buffer -> view<4xi32>
  %loaded = view.load %input_view[2] : view<4xi32> -> i32
  view.store %loaded, %result_view_0[%fixture_lane] : i32, view<64xi32>
  kernel.return
}

