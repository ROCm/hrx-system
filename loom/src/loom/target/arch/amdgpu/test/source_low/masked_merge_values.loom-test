// RUN: pass source-to-low,low-dce
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @scalar_values(%word: reg<amdgpu.vgpr>, %pair: reg<amdgpu.vgpr x2>, %truth: reg<amdgpu.sgpr x2>, %input: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %uniform_word = v_readfirstlane_b32 %word
  %lower = slice %pair[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %upper = slice %pair[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %uniform_lower = v_readfirstlane_b32 %lower
  %uniform_upper = v_readfirstlane_b32 %upper
  %uniform_pair = concat(%uniform_lower, %uniform_upper) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %mask, %any_true = s_and_b64_scc %truth, %truth
  %one = s_mov_b32 1
  %zero = s_mov_b32 0
  %uniform_truth = s_cselect_b32 %one, %zero, %any_true
  return %uniform_word, %uniform_pair, %uniform_truth, %input
}

// The same scalar word, numeric pair, and scalar truth reach both arms. Only
// the final numeric choice depends on the lane predicate.
func.def target(@target) @uniform_words_in_masked_merge(%input_word: i32, %input_pair: i64, %input_truth: i1, %input: f32) -> (i32, i64, i1, i32) {
  %word, %pair, %truth, %value = low.invoke @scalar_values(%input_word, %input_pair, %input_truth, %input) : (i32, i64, i1, f32) -> (i32, i64, i1, f32)
  %threshold = scalar.constant 0.0 : f32
  %positive = scalar.cmpf ogt, %value, %threshold : f32
  %left = scalar.constant 3 : i32
  %right = scalar.constant 9 : i32
  cfg.cond_br %positive, ^positive, ^negative
^positive:
  cfg.br ^forward
^forward:
  cfg.br ^join(%word: i32, %pair: i64, %truth: i1, %left: i32)
^negative:
  cfg.br ^join(%word: i32, %pair: i64, %truth: i1, %right: i32)
^join(%merged_word: i32, %merged_pair: i64, %merged_truth: i1, %selected: i32):
  func.return %merged_word, %merged_pair, %merged_truth, %selected : i32, i64, i1, i32
}
