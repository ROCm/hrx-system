low.func.def target<amdgpu.rdna4.core>(@target) @predicate_arrays(%condition: reg<amdgpu.sgpr x2>, %left: reg<amdgpu.sgpr x4>, %right: reg<amdgpu.sgpr x4>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x4>, reg<amdgpu.sgpr x4>) asm {
  return %condition, %left, %right
}

// Each logical vector element has its own lane-mask pair. Reconvergence must
// merge every pair independently instead of selecting the array as scalar bits.
func.def target(@target) @merge_predicate_arrays(%input_condition: i1, %input_left: vector<2xi1>, %input_right: vector<2xi1>) -> (vector<2xi1>) {
  %condition, %left, %right = low.invoke @predicate_arrays(%input_condition, %input_left, %input_right) : (i1, vector<2xi1>, vector<2xi1>) -> (i1, vector<2xi1>, vector<2xi1>)
  cfg.cond_br %condition, ^positive, ^negative
^positive:
  cfg.br ^join(%left: vector<2xi1>)
^negative:
  cfg.br ^join(%right: vector<2xi1>)
^join(%selected: vector<2xi1>):
  func.return %selected : vector<2xi1>
}
