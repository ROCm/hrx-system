  %78 = v_mov_b32 3
  low.br ^_bb5(%word: reg<amdgpu.sgpr>, %pair: reg<amdgpu.sgpr x2>, %truth: reg<amdgpu.sgpr>, %78: reg<amdgpu.vgpr>)
^_bb3:
