  %64 = v_mov_b32 9
  low.br ^join(%word: reg<amdgpu.sgpr>, %pair: reg<amdgpu.sgpr x2>, %truth: reg<amdgpu.sgpr>, %64: reg<amdgpu.vgpr>)
^_bb5(%merged_word$51: reg<amdgpu.sgpr>, %merged_pair$52: reg<amdgpu.sgpr x2>, %merged_truth$53: reg<amdgpu.sgpr>, %selected$54: reg<amdgpu.vgpr>):
  s_mov_b64_exec %62
  %65 = v_mov_b32 9
  %66, %67 = s_and_b64_scc %positive, %62
  %68 = s_cselect_b32 %merged_word$51, %word, %67
  %69 = slice %pair[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %70 = slice %merged_pair$52[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %71 = s_cselect_b32 %70, %69, %67
  %72 = slice %pair[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %73 = slice %merged_pair$52[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %74 = s_cselect_b32 %73, %72, %67
  %75 = concat(%71, %74) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %76 = s_cselect_b32 %merged_truth$53, %truth, %67
  %77 = v_cndmask_b32 %65, %selected$54, %positive
  low.br ^join(%68: reg<amdgpu.sgpr>, %75: reg<amdgpu.sgpr x2>, %76: reg<amdgpu.sgpr>, %77: reg<amdgpu.vgpr>)
