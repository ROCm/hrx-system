amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

low.func.def target<amdgpu.gfx11.generic.core>(@target) @loop_lane_values(%input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  return %input
}

// Only surviving lanes may choose the scalar payload of an arm that also
// contains a loop exit. The sibling counter remains a varying numeric value.
func.def target(@target) @uniform_payload_after_retiring_arm(%word: i64, %input: vector<2xi32>) -> (i64, i32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %limit = scalar.constant 4 : i32
  %values = low.invoke @loop_lane_values(%input) : (vector<2xi32>) -> (vector<2xi32>)
  %selector = vector.extract %values[0] : vector<2xi32> -> i32
  %exit_at = vector.extract %values[1] : vector<2xi32> -> i32
  %exit_path = scalar.cmpi ne, %selector, %c0 : i32
  cfg.br ^header(%c0: i32, %word: i64)
^header(%counter: i32, %retained: i64):
  %more = scalar.cmpi slt, %counter, %limit : i32
  cfg.cond_br %more, ^choose, ^normal_exit
^choose:
  cfg.cond_br %exit_path, ^exit_check, ^retry_path
^retry_path:
  %retry_next = scalar.addi %counter, %c2 : i32
  cfg.br ^latch(%retry_next: i32, %word: i64)
^exit_check:
  %done = scalar.cmpi eq, %counter, %exit_at : i32
  cfg.cond_br %done, ^returned, ^fallthrough
^returned:
  cfg.br ^merge(%retained: i64, %counter: i32)
^fallthrough:
  %next = scalar.addi %counter, %c1 : i32
  cfg.br ^latch(%next: i32, %word: i64)
^latch(%next_counter: i32, %next_word: i64):
  cfg.br ^header(%next_counter: i32, %next_word: i64)
^normal_exit:
  cfg.br ^merge(%retained: i64, %counter: i32)
^merge(%result: i64, %count: i32):
  func.return %result, %count : i64, i32
}
