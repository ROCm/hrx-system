amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

// The exit tuple combines an unchanged numeric pair with two changing lane
// masks. Retiring lanes retain their own predicate bits across later exits.
func.def target(@target) @capture_numeric_pair_and_predicates(%word: i64, %thresholds: vector<2xi32>, %exit_iterations: vector<2xi32>, %initial: vector<2xi1>) -> (i64, vector<2xi1>) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %limit = scalar.constant 4 : i32
  %exit_at = vector.extract %exit_iterations[0] : vector<2xi32> -> i32
  cfg.br ^header(%c0: i32)
^header(%iteration: i32):
  %more = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %more, ^test, ^normal_exit
^test:
  %done = scalar.cmpi eq, %iteration, %exit_at : i32
  cfg.cond_br %done, ^returned, ^latch
^returned:
  %positions = vector.splat %iteration : vector<2xi32>
  %predicates = vector.cmpi slt, %thresholds, %positions : vector<2xi32> -> vector<2xi1>
  cfg.br ^merge(%word: i64, %predicates: vector<2xi1>)
^latch:
  %next = scalar.addi %iteration, %c1 : i32
  cfg.br ^header(%next: i32)
^normal_exit:
  cfg.br ^merge(%word: i64, %initial: vector<2xi1>)
^merge(%result: i64, %flags: vector<2xi1>):
  func.return %result, %flags : i64, vector<2xi1>
}
