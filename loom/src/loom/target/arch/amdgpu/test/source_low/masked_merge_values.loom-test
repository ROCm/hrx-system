  %uniform_upper = v_readfirstlane_b32 %upper
  %uniform_pair = concat(%uniform_lower, %uniform_upper) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
