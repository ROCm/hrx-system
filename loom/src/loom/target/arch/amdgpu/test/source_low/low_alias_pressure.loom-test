// Candidate pressure includes ownership inherited from operands that die in
// this instruction before deciding which result parts can share that storage.
// RUN: emit amdgpu-assembly @dying_source_before_alias

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @dying_source_before_alias(%seed: reg<amdgpu.vgpr>, %factor: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %alias = low.assume %seed [range(%seed, 0, 1024)] : reg<amdgpu.vgpr>
  %saved = concat(%seed, %alias) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %changed = v_fmac_f32 %alias, %factor, %factor
  global_store_b64_saddr %address, %saved, %output
  global_store_b32_saddr %address, %changed, %output {offset = 8}
  return
}

// ----
  v_mov_b32 v0, v1
  global_store_b64 v3, v[0:1], s[0:1] offset:0
  v_fmac_f32 v1, v2, v2
  global_store_b32 v3, v1, s[0:1] offset:8
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @alias_before_dying_source

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @alias_before_dying_source(%seed: reg<amdgpu.vgpr>, %factor: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %alias = low.assume %seed [range(%seed, 0, 1024)] : reg<amdgpu.vgpr>
  %saved = concat(%alias, %seed) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %changed = v_fmac_f32 %alias, %factor, %factor
  global_store_b64_saddr %address, %saved, %output
  global_store_b32_saddr %address, %changed, %output {offset = 8}
  return
}

// ----
  v_mov_b32 v1, v0
  global_store_b64 v3, v[0:1], s[0:1] offset:0
  v_fmac_f32 v0, v2, v2
  global_store_b32 v3, v0, s[0:1] offset:8
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

