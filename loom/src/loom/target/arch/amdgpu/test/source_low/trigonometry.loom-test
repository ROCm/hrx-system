// RUN: emit source-low target=amdgpu:gfx1151 output=low

kernel.def @sine_zero_sign() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%source: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<1xf32>
  %destination = buffer.view %output[%base] : buffer -> view<3xf32>
  %input = view.load %source_view[0] : view<1xf32> -> f32
  %sine = scalar.sinturnsf<afn|preserve> %input : f32
  %relaxed = scalar.sinturnsf<afn> %input : f32
  %cosine = scalar.costurnsf<afn|preserve> %input : f32
  view.store %sine, %destination[0] : f32, view<3xf32>
  view.store %relaxed, %destination[1] : f32, view<3xf32>
  view.store %cosine, %destination[2] : f32, view<3xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sine_zero_sign() asm {
  %source_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 12, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %34 = v_mov_b32 0
  %input = global_load_b32_saddr %34, %source_view
  %36 = v_sin_f32 %input
  %38 = v_bfi_b32_src0_lit %34, %input, 2147483647
  %40 = v_and_b32_lit %36, 2147483647
  %41 = v_cmp_eq_i32_src1_inline %40 {rhs = 0}
  %sine = v_cndmask_b32 %36, %38, %41
  %43 = v_cos_f32 %input
  %44 = v_and_b32_lit %43, 2147483647
  %45 = v_cmp_eq_i32_src1_inline %44 {rhs = 0}
  %cosine = v_cndmask_b32_src1_inline %43, %45 {true_value = 0}
  global_store_b32_saddr %34, %sine, %destination
  global_store_b32_saddr %34, %36, %destination {offset = 4}
  global_store_b32_saddr %34, %cosine, %destination {offset = 8}
  return
}

// ====

kernel.def @sine_lane_signs() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%source: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<3xf32>
  %destination = buffer.view %output[%base] : buffer -> view<9xf32>
  %input = vector.load %source_view[0] : view<3xf32> -> vector<3xf32>
  %sine = vector.sinturnsf<nsz|afn|preserve> %input : vector<3xf32>
  %relaxed = vector.sinturnsf<afn> %input : vector<3xf32>
  %cosine = vector.costurnsf<afn|preserve> %input : vector<3xf32>
  vector.store %sine, %destination[0] : vector<3xf32>, view<9xf32>
  vector.store %relaxed, %destination[3] : vector<3xf32>, view<9xf32>
  vector.store %cosine, %destination[6] : vector<3xf32>, view<9xf32>
  kernel.return
}

