low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sine_lane_signs() asm {
  %source_view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 36, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %33 = v_mov_b32 0
  %input = global_load_b96_saddr %33, %source_view
  %35 = slice %input[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %36 = v_sin_f32 %35
  %37 = slice %input[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %38 = v_sin_f32 %37
  %39 = slice %input[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %40 = v_sin_f32 %39
  %41 = concat(%36, %38, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %48 = v_bfi_b32_src0_lit %33, %35, 2147483647
  %51 = v_bfi_b32_src0_lit %33, %37, 2147483647
  %54 = v_bfi_b32_src0_lit %33, %39, 2147483647
  %61 = v_and_b32_lit %36, 2147483647
  %63 = v_and_b32_lit %38, 2147483647
  %65 = v_and_b32_lit %40, 2147483647
  %68 = v_cmp_eq_i32_src1_inline %61 {rhs = 0}
  %70 = v_cmp_eq_i32_src1_inline %63 {rhs = 0}
  %72 = v_cmp_eq_i32_src1_inline %65 {rhs = 0}
  %77 = v_cndmask_b32 %36, %48, %68
  %81 = v_cndmask_b32 %38, %51, %70
  %85 = v_cndmask_b32 %40, %54, %72
  %sine = concat(%77, %81, %85) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %88 = v_cos_f32 %35
  %90 = v_cos_f32 %37
  %92 = v_cos_f32 %39
  %95 = v_and_b32_lit %88, 2147483647
  %97 = v_and_b32_lit %90, 2147483647
  %99 = v_and_b32_lit %92, 2147483647
  %102 = v_cmp_eq_i32_src1_inline %95 {rhs = 0}
  %104 = v_cmp_eq_i32_src1_inline %97 {rhs = 0}
  %106 = v_cmp_eq_i32_src1_inline %99 {rhs = 0}
  %110 = v_cndmask_b32_src1_inline %88, %102 {true_value = 0}
  %113 = v_cndmask_b32_src1_inline %90, %104 {true_value = 0}
  %116 = v_cndmask_b32_src1_inline %92, %106 {true_value = 0}
  %cosine = concat(%110, %113, %116) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  global_store_b96_saddr %33, %sine, %destination
  global_store_b96_saddr %33, %41, %destination {offset = 12}
  global_store_b96_saddr %33, %cosine, %destination {offset = 24}
  return
}

// ====

// Uniform scalar arguments and their vector splats use scalar register inputs.
kernel.def @uniform_sine() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: f32, %output: buffer) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<4xf32>
  %sine = scalar.sinturnsf<afn|preserve> %input : f32
  %inputs = vector.splat %input : vector<3xf32>
  %sines = vector.sinturnsf<afn|preserve> %inputs : vector<3xf32>
  view.store %sine, %destination[0] : f32, view<4xf32>
  vector.store %sines, %destination[1] : vector<3xf32>, view<4xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "input"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_sine(%input: reg<amdgpu.sgpr>) asm {
  %destination = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %32 = v_sin_f32 %input
  %33 = v_mov_b32 0
  %34 = v_mov_b32_copy %input
  %35 = v_bfi_b32_src0_lit %33, %34, 2147483647
  %36 = v_and_b32_lit %32, 2147483647
  %37 = v_cmp_eq_i32_src1_inline %36 {rhs = 0}
  %sine = v_cndmask_b32 %32, %35, %37
  %42 = v_sin_f32 %34
  %67 = v_and_b32_lit %42, 2147483647
  %74 = v_cmp_eq_i32_src1_inline %67 {rhs = 0}
  %83 = v_cndmask_b32 %42, %35, %74
  %sines = concat(%83, %83, %83) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  global_store_b32_saddr %33, %sine, %destination
  global_store_b96_saddr %33, %sines, %destination {offset = 4}
  return
}
