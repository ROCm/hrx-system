  %22 = v_perm_b32 %16, %15, %21
  %23 = v_perm_b32 %18, %17, %21
  %24 = v_and_b32_lit %12, 134744072
  %25 = v_lshrrev_b32_src0_inline %24, 1
  %26 = v_or_b32_lit %25, 50462976
  %27 = v_perm_b32 %23, %22, %26
  %28 = v_and_b32_lit %13, 117901063
  %29 = v_perm_b32 %16, %15, %28
  %30 = v_perm_b32 %18, %17, %28
  %31 = v_and_b32_lit %13, 134744072
  %32 = v_lshrrev_b32_src0_inline %31, 1
  %33 = v_or_b32_lit %32, 50462976
  %34 = v_perm_b32 %30, %29, %33
  %37 = v_bfe_i32_offset_width_inline %27 {offset = 0, width = 8}
  %38 = v_cvt_f32_i32 %37
  %40 = v_bfe_i32_offset_width_inline %27 {offset = 8, width = 8}
  %41 = v_cvt_f32_i32 %40
  %43 = v_bfe_i32_offset_width_inline %27 {offset = 16, width = 8}
  %44 = v_cvt_f32_i32 %43
  %46 = v_ashrrev_i32_src0_inline %27, 24
  %47 = v_cvt_f32_i32 %46
  %49 = v_bfe_i32_offset_width_inline %34 {offset = 0, width = 8}
  %50 = v_cvt_f32_i32 %49
  %52 = v_bfe_i32_offset_width_inline %34 {offset = 8, width = 8}
  %53 = v_cvt_f32_i32 %52
