  %10 = v_mov_b32 252645135
  %13 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = v_and_b32 %13, %10
  %16 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = v_and_b32 %16, %10
  %20 = slice %table[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = slice %table[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22 = slice %table[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %23 = slice %table[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %26 = v_and_b32_lit %15, 117901063
  %27 = v_perm_b32 %21, %20, %26
  %28 = v_perm_b32 %23, %22, %26
  %29 = v_and_b32_lit %15, 134744072
  %30 = v_lshrrev_b32_src0_inline %29, 1
  %31 = v_or_b32_lit %30, 50462976
  %32 = v_perm_b32 %28, %27, %31
  %33 = v_and_b32_lit %18, 117901063
  %34 = v_perm_b32 %21, %20, %33
  %35 = v_perm_b32 %23, %22, %33
  %36 = v_and_b32_lit %18, 134744072
  %37 = v_lshrrev_b32_src0_inline %36, 1
  %38 = v_or_b32_lit %37, 50462976
  %39 = v_perm_b32 %35, %34, %38
  %values = concat(%32, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %values
}

