  %13 = v_perm_b32_src2_lit %11, %9, 117638658
  %15 = slice %table[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = slice %table[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = slice %table[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
