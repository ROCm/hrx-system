// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @byte_table_8_lanes_5(%table: reg<amdgpu.vgpr x2>, %input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %10 = v_mov_b32 117901063
  %13 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = v_and_b32 %13, %10
  %16 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = v_and_b32 %16, %10
  %20 = slice %table[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = slice %table[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %24 = v_perm_b32 %21, %20, %15
  %25 = v_perm_b32 %21, %20, %18
  %values = concat(%24, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %values
}

