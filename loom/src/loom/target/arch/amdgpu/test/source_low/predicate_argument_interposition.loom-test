// RUN: emit source-low output=low sanitizer=race sanitizer-reporting=trap

// Race setup forwards the physical entry arguments through its guards before
// predicate conversion binds the masks consumed by the kernel body.
amdgpu.target<gfx1100> @target {subgroup_size = 32}

kernel.def target(@target) @forward_argument_masks() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%condition: i1, %output: buffer, %predicates: vector<2xi1>) {
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<32xi32>
  %first = vector.extract %predicates[0] : vector<2xi1> -> i1
  %second = vector.extract %predicates[1] : vector<2xi1> -> i1
  %predicate = scf.select %condition, %first, %second : i1
  %enabled = scalar.constant 1 : i32
  %disabled = scalar.constant 0 : i32
  %selected = scf.select %predicate, %enabled, %disabled : i32
  view.store %selected, %view[%lane] : i32, view<32xi32>
  kernel.return
}

