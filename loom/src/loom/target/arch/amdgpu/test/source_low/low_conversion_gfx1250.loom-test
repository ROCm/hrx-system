// RUN: emit amdgpu-assembly @gfx1250_native_packed_bf16_ops

amdgpu.target<gfx1250> @target
low.func.def target(@target) @gfx1250_native_packed_bf16_ops(%low: reg<amdgpu.vgpr>, %high: reg<amdgpu.vgpr>, %scale: reg<amdgpu.vgpr>) asm<amdgpu.rdna4.gfx125x.core> {
  %packed = v_cvt_pk_bf16_f32 %low, %high
  %product = v_pk_mul_bf16 %packed, %scale
  %fma = v_pk_fma_bf16 %packed, %scale, %product
  return
}

// ----
  v_cvt_pk_bf16_f32 v0, v0, v1
  s_delay_alu instid0(VALU_DEP_1)
  v_pk_mul_bf16 v1, v0, v2
  s_delay_alu instid0(VALU_DEP_1)
  v_pk_fma_bf16 v0, v0, v2, v1
  s_endpgm
