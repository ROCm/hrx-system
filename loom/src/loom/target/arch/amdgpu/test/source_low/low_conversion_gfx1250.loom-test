// RUN: emit amdgpu-assembly @gfx1250_native_bf16_pack

amdgpu.target<gfx1250> @target
low.func.def target(@target) @gfx1250_native_bf16_pack(%low: reg<amdgpu.vgpr>, %high: reg<amdgpu.vgpr>) asm<amdgpu.rdna4.gfx125x.core> {
  %packed = v_cvt_pk_bf16_f32 %low, %high
  return
}

// ----
  v_cvt_pk_bf16_f32 v0, v0, v1
  s_endpgm
