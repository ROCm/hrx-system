// RUN: emit amdgpu-assembly @gfx1151_dpp8_uniform_rhs

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @gfx1151_dpp8_uniform_rhs(%crosslane: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.sgpr>) asm {
  %add_sgpr = v_add_f32_dpp8_sgpr %crosslane, %rhs {dpp8 = 342391}
  %add_inline = v_add_f32_dpp8_src1_inline %add_sgpr {rhs = "f32_1_0", dpp8 = 342391}
  %sub_sgpr = v_sub_f32_dpp8_sgpr %add_inline, %rhs {dpp8 = 342391}
  %sub_inline = v_sub_f32_dpp8_src1_inline %sub_sgpr {rhs = "f32_2_0", dpp8 = 342391}
  %mul_sgpr = v_mul_f32_dpp8_sgpr %sub_inline, %rhs {dpp8 = 342391}
  %mul_inline = v_mul_f32_dpp8_src1_inline %mul_sgpr {rhs = "f32_0_5", dpp8 = 342391}
  %min_sgpr = v_min_f32_dpp8_sgpr %mul_inline, %rhs {dpp8 = 342391}
  %min_inline = v_min_f32_dpp8_src1_inline %min_sgpr {rhs = "f32_n1_0", dpp8 = 342391}
  %max_sgpr = v_max_f32_dpp8_sgpr %min_inline, %rhs {dpp8 = 342391}
  %max_inline = v_max_f32_dpp8_src1_inline %max_sgpr {rhs = "f32_4_0", dpp8 = 342391}
  return
}

