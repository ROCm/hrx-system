  %input = vector.from_elements %first, %second, %third : vector<3xf16>
  %converted = vector.fptrunc %input : vector<3xf16> to vector<3xf8E5M2>
  %first_result = vector.extract %converted[0] : vector<3xf8E5M2> -> f8E5M2
  %second_result = vector.extract %converted[1] : vector<3xf8E5M2> -> f8E5M2
  %third_result = vector.extract %converted[2] : vector<3xf8E5M2> -> f8E5M2
  func.return %first_result, %second_result, %third_result : f8E5M2, f8E5M2, f8E5M2
}

