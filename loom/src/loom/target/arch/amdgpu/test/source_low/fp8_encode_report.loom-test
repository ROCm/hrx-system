CHECK: COMPILE-REPORT: source_low selected_ops=5 emitted_ops=53 rows=5 unkeyed_maximum_emitted_ops=1
CHECK: COMPILE-REPORT: source_low[*] function=report_gfx1100_f32x3_to_f8e4m3_partial_encode source_op=vector.fptrunc selection=plan plan_key=amdgpu.fp8_encode.strategy.f32_software emitted_ops=50

