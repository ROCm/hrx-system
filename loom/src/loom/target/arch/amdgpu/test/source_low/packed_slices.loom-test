  %12 = v_mov_b32 24
  %23 = slice %8[15] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %22 = slice %9[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %15 = v_alignbit_b32 %22, %23, %12
  %20 = slice %9[1] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %18 = v_alignbit_b32 %20, %22, %12
  %result = concat(%15, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

