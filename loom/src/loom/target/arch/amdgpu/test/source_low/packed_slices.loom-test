  %13 = v_mov_b32 24
  %24 = slice %9[15] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %23 = slice %10[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %16 = v_alignbit_b32 %23, %24, %13
  %21 = slice %10[1] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %19 = v_alignbit_b32 %21, %23, %13
  %result = concat(%16, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

