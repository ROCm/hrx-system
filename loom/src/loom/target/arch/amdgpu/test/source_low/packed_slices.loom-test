// ====

// A slice needs only its selected words, even when its source exceeds the
// arithmetic recipe width. The final partial word has no following input.
func.def @wide_i8(%input: vector<128xi8>) -> (vector<3xi8>) {
  %result = vector.slice %input[125] : vector<128xi8> -> vector<3xi8>
  func.return %result : vector<3xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @wide_i8(%10: reg<amdgpu.vgpr x16>, %11: reg<amdgpu.vgpr x16>) -> (reg<amdgpu.vgpr>) asm {
  %13 = slice %11[15] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr>
  %result = v_lshrrev_b32_src0_inline %13, 8
  return %result
}

