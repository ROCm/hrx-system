// RUN: emit source-low target=amdgpu:gfx11-generic output=low
func.def @i8_cross_register(%input: vector<16xi8>) -> (vector<6xi8>) {
  %result = vector.slice %input[1] : vector<16xi8> -> vector<6xi8>
  func.return %result : vector<6xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8_cross_register(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %5 = v_mov_b32 8
  %6 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %7 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = v_alignbit_b32 %7, %6, %5
  %10 = v_lshrrev_b32_src0_inline %7, 8
  %result = concat(%8, %10) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

