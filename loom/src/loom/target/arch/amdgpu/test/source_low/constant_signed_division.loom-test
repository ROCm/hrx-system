// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// Divisors 2, 3, 4, 5, -2, and -3 select all six signed reciprocal
// arithmetic shapes. The remainder also covers the scalar product/subtract
// tail without duplicating every shape.
kernel.def target(@target) @uniform_signed_division() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%value: i32, %result_buffer_0: buffer, %result_buffer_1: buffer, %result_buffer_2: buffer, %result_buffer_3: buffer, %result_buffer_4: buffer, %result_buffer_5: buffer, %result_buffer_6: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi32>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xi32>
  %result_view_2 = buffer.view %result_buffer_2[%fixture_base] : buffer -> view<64xi32>
  %result_view_3 = buffer.view %result_buffer_3[%fixture_base] : buffer -> view<64xi32>
  %result_view_4 = buffer.view %result_buffer_4[%fixture_base] : buffer -> view<64xi32>
  %result_view_5 = buffer.view %result_buffer_5[%fixture_base] : buffer -> view<64xi32>
  %result_view_6 = buffer.view %result_buffer_6[%fixture_base] : buffer -> view<64xi32>
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %cn2 = scalar.constant -2 : i32
  %cn3 = scalar.constant -3 : i32
  %quotient_positive_two = scalar.divsi %value, %c2 : i32
  %quotient_positive_three = scalar.divsi %value, %c3 : i32
  %quotient_positive_four = scalar.divsi %value, %c4 : i32
  %quotient_positive_five = scalar.divsi %value, %c5 : i32
  %quotient_negative_two = scalar.divsi %value, %cn2 : i32
  %quotient_negative_three = scalar.divsi %value, %cn3 : i32
  %remainder_positive_five = scalar.remsi %value, %c5 : i32
  view.store %quotient_positive_two, %result_view_0[%fixture_lane] : i32, view<64xi32>
  view.store %quotient_positive_three, %result_view_1[%fixture_lane] : i32, view<64xi32>
  view.store %quotient_positive_four, %result_view_2[%fixture_lane] : i32, view<64xi32>
  view.store %quotient_positive_five, %result_view_3[%fixture_lane] : i32, view<64xi32>
  view.store %quotient_negative_two, %result_view_4[%fixture_lane] : i32, view<64xi32>
  view.store %quotient_negative_three, %result_view_5[%fixture_lane] : i32, view<64xi32>
  view.store %remainder_positive_five, %result_view_6[%fixture_lane] : i32, view<64xi32>
  kernel.return
}

