// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// Divisors 2, 3, 4, 5, -2, and -3 select all six signed reciprocal
// arithmetic shapes. The remainder also covers the scalar product/subtract
// tail without duplicating every shape.
func.def target(@target) @uniform_signed_division(%value: i32) -> (i32, i32, i32, i32, i32, i32, i32) {
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %cn2 = scalar.constant -2 : i32
  %cn3 = scalar.constant -3 : i32
  %quotient_positive_two = scalar.divsi %value, %c2 : i32
  %quotient_positive_three = scalar.divsi %value, %c3 : i32
  %quotient_positive_four = scalar.divsi %value, %c4 : i32
  %quotient_positive_five = scalar.divsi %value, %c5 : i32
  %quotient_negative_two = scalar.divsi %value, %cn2 : i32
  %quotient_negative_three = scalar.divsi %value, %cn3 : i32
  %remainder_positive_five = scalar.remsi %value, %c5 : i32
  func.return %quotient_positive_two, %quotient_positive_three, %quotient_positive_four, %quotient_positive_five, %quotient_negative_two, %quotient_negative_three, %remainder_positive_five : i32, i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_signed_division(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %c5 = s_mov_b32 5
  %36 = s_mov_b32 2147483649
  %37 = s_mul_hi_i32 %value, %36
  %38 = s_add_u32 %37, %value
  %39 = s_lshr_b32_rhs_inline %38, 31
  %quotient_positive_two = s_add_u32 %38, %39
  %41 = s_mov_b32 1431655766
  %42 = s_mul_hi_i32 %value, %41
  %43 = s_lshr_b32_rhs_inline %42, 31
  %quotient_positive_three = s_add_u32 %42, %43
  %48 = s_ashr_i32_rhs_inline %38, 1
  %49 = s_lshr_b32_rhs_inline %48, 31
  %quotient_positive_four = s_add_u32 %48, %49
  %51 = s_mov_b32 1717986919
  %52 = s_mul_hi_i32 %value, %51
  %53 = s_ashr_i32_rhs_inline %52, 1
  %54 = s_lshr_b32_rhs_inline %53, 31
  %quotient_positive_five = s_add_u32 %53, %54
  %56 = s_mul_i32 %quotient_positive_five, %c5
  %remainder_positive_five = s_sub_u32 %value, %56
  %58 = s_mov_b32 2147483647
  %59 = s_mul_hi_i32 %value, %58
  %60 = s_sub_u32 %59, %value
  %61 = s_lshr_b32_rhs_inline %60, 31
  %quotient_negative_two = s_add_u32 %60, %61
  %63 = s_mov_b32 1431655765
  %64 = s_mul_hi_i32 %value, %63
  %65 = s_sub_u32 %64, %value
  %66 = s_ashr_i32_rhs_inline %65, 1
  %67 = s_lshr_b32_rhs_inline %66, 31
  %quotient_negative_three = s_add_u32 %66, %67
  return %quotient_positive_two, %quotient_positive_three, %quotient_positive_four, %quotient_positive_five, %quotient_negative_two, %quotient_negative_three, %remainder_positive_five
}

// ====

amdgpu.target<gfx942> @target

// A vector extract forces the varying register class. The quotient covers the
// vector path once while the remainders exercise every reciprocal shape.
func.def target(@target) @varying_signed_remainder(%values: vector<2xi32>) -> (i32, i32, i32, i32, i32, i32, i32) {
  %value = vector.extract %values[0] : vector<2xi32> -> i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %cn2 = scalar.constant -2 : i32
  %cn3 = scalar.constant -3 : i32
  %quotient_positive_five = scalar.divsi %value, %c5 : i32
  %remainder_positive_two = scalar.remsi %value, %c2 : i32
  %remainder_positive_three = scalar.remsi %value, %c3 : i32
  %remainder_positive_four = scalar.remsi %value, %c4 : i32
  %remainder_positive_five = scalar.remsi %value, %c5 : i32
  %remainder_negative_two = scalar.remsi %value, %cn2 : i32
  %remainder_negative_three = scalar.remsi %value, %cn3 : i32
  func.return %quotient_positive_five, %remainder_positive_two, %remainder_positive_three, %remainder_positive_four, %remainder_positive_five, %remainder_negative_two, %remainder_negative_three : i32, i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @varying_signed_remainder(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %value = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %43 = v_mov_b32 1717986919
  %44 = v_mul_hi_i32 %value, %43
  %45 = v_ashrrev_i32_src0_inline %44, 1
  %46 = v_lshrrev_b32_src0_inline %45, 31
  %quotient_positive_five = v_add_u32 %45, %46
  %48 = v_mov_b32 5
  %49 = v_mul_lo_u32 %quotient_positive_five, %48
  %remainder_positive_five = v_sub_u32 %value, %49
  %51 = v_mov_b32 2147483649
  %52 = v_mul_hi_i32 %value, %51
  %53 = v_add_u32 %52, %value
  %54 = v_lshrrev_b32_src0_inline %53, 31
  %55 = v_add_u32 %53, %54
  %56 = v_mov_b32 2
  %57 = v_mul_lo_u32 %55, %56
  %remainder_positive_two = v_sub_u32 %value, %57
  %59 = v_mov_b32 1431655766
  %60 = v_mul_hi_i32 %value, %59
  %61 = v_lshrrev_b32_src0_inline %60, 31
  %62 = v_add_u32 %60, %61
  %63 = v_mov_b32 3
  %64 = v_mul_lo_u32 %62, %63
  %remainder_positive_three = v_sub_u32 %value, %64
  %69 = v_ashrrev_i32_src0_inline %53, 1
  %70 = v_lshrrev_b32_src0_inline %69, 31
  %71 = v_add_u32 %69, %70
  %72 = v_mov_b32 4
  %73 = v_mul_lo_u32 %71, %72
  %remainder_positive_four = v_sub_u32 %value, %73
  %75 = v_mov_b32 2147483647
  %76 = v_mul_hi_i32 %value, %75
  %77 = v_sub_u32 %76, %value
  %78 = v_lshrrev_b32_src0_inline %77, 31
  %79 = v_add_u32 %77, %78
  %80 = v_mov_b32 4294967294
  %81 = v_mul_lo_u32 %79, %80
  %remainder_negative_two = v_sub_u32 %value, %81
  %83 = v_mov_b32 1431655765
  %84 = v_mul_hi_i32 %value, %83
  %85 = v_sub_u32 %84, %value
  %86 = v_ashrrev_i32_src0_inline %85, 1
  %87 = v_lshrrev_b32_src0_inline %86, 31
  %88 = v_add_u32 %86, %87
  %89 = v_mov_b32 4294967293
  %90 = v_mul_lo_u32 %88, %89
  %remainder_negative_three = v_sub_u32 %value, %90
  return %quotient_positive_five, %remainder_positive_two, %remainder_positive_three, %remainder_positive_four, %remainder_positive_five, %remainder_negative_two, %remainder_negative_three
}

// ====

amdgpu.target<gfx11-generic> @target

// Narrow signed operations widen through the shared i32 legalization before
// selecting the same reciprocal machinery.
func.def target(@target) @narrow_signed_division(%byte: i8, %halfword: i16) -> (i8, i8, i16, i16) {
  %byte_divisor = scalar.constant -3 : i8
  %halfword_divisor = scalar.constant 5 : i16
  %byte_quotient = scalar.divsi %byte, %byte_divisor : i8
  %byte_remainder = scalar.remsi %byte, %byte_divisor : i8
  %halfword_quotient = scalar.divsi %halfword, %halfword_divisor : i16
  %halfword_remainder = scalar.remsi %halfword, %halfword_divisor : i16
  func.return %byte_quotient, %byte_remainder, %halfword_quotient, %halfword_remainder : i8, i8, i16, i16
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @narrow_signed_division(%byte: reg<amdgpu.vgpr>, %halfword: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %56 = v_bfe_i32_offset_width_inline %byte {offset = 0, width = 8}
  %58 = v_mov_b32 1431655765
  %59 = v_mul_hi_i32 %56, %58
  %60 = v_sub_nc_u32 %59, %56
  %61 = v_ashrrev_i32_src0_inline %60, 1
  %62 = v_lshrrev_b32_src0_inline %61, 31
  %byte_quotient = v_add_u32 %61, %62
  %64 = v_mov_b32 4294967293
  %65 = v_mul_lo_u32 %byte_quotient, %64
  %byte_remainder = v_sub_nc_u32 %56, %65
  %67 = v_bfe_i32_offset_width_inline %halfword {offset = 0, width = 16}
  %69 = v_mov_b32 1717986919
  %70 = v_mul_hi_i32 %67, %69
  %71 = v_ashrrev_i32_src0_inline %70, 1
  %72 = v_lshrrev_b32_src0_inline %71, 31
  %halfword_quotient = v_add_u32 %71, %72
  %74 = v_mov_b32 5
  %75 = v_mul_lo_u32 %halfword_quotient, %74
  %halfword_remainder = v_sub_nc_u32 %67, %75
  return %byte_quotient, %byte_remainder, %halfword_quotient, %halfword_remainder
}
