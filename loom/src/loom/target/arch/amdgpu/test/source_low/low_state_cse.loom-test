// RUN: pass low-cse

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @equal_m0_assignments_share_state(%value0: reg<amdgpu.vgpr>, %value1: reg<amdgpu.vgpr>) asm {
  %m0a = s_mov_b32_m0_imm 0
  ds_write_addtid_b32 %value0, %m0a
  %m0b = s_mov_b32_m0_imm 0
  ds_write_addtid_b32 %value1, %m0b {offset = 4}
  return
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @equal_m0_assignments_share_state(%value0: reg<amdgpu.vgpr>, %value1: reg<amdgpu.vgpr>) asm {
  %m0a = s_mov_b32_m0_imm 0
  ds_write_addtid_b32 %value0, %m0a
  ds_write_addtid_b32 %value1, %m0a {offset = 4}
  return
}

// ====
// Register-valued assignments replace the later SSA result as well as the
// native state write. A different M0 value expires the retained assignment.
// RUN: pass low-cse

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @register_m0_assignments(%base: reg<amdgpu.sgpr>, %other_base: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  %first_base = s_mov_b32_m0 %base
  ds_write_addtid_b32 %value, %first_base
  %same_base = s_mov_b32_m0 %base
  ds_write_addtid_b32 %value, %same_base {offset = 4}
  %changed_base = s_mov_b32_m0 %other_base
  ds_write_addtid_b32 %value, %changed_base {offset = 8}
  %restored_base = s_mov_b32_m0 %base
  ds_write_addtid_b32 %value, %restored_base {offset = 12}
  return
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @register_m0_assignments(%base: reg<amdgpu.sgpr>, %other_base: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  %first_base = s_mov_b32_m0 %base
  ds_write_addtid_b32 %value, %first_base
  ds_write_addtid_b32 %value, %first_base {offset = 4}
  %changed_base = s_mov_b32_m0 %other_base
  ds_write_addtid_b32 %value, %changed_base {offset = 8}
  %restored_base = s_mov_b32_m0 %base
  ds_write_addtid_b32 %value, %restored_base {offset = 12}
  return
}

// ====
// RUN: pass low-cse

amdgpu.target<gfx1100> @target

// SCC writes do not change an EXEC snapshot. The empty bridge block must
// forward the state index to its descendant without creating local entries.
low.func.def target<amdgpu.rdna3.core>(@target) @exec_read_survives_disjoint_writes(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.scc>) asm {
  %active = s_mov_b64_exec_read
  %within_bounds = s_cmp_lt_u32 %ordinal, %limit
  low.br ^bridge
^bridge:
  low.br ^finish
^finish:
  %at_limit = s_cmp_eq_i32 %ordinal, %limit
  %same_active = s_mov_b64_exec_read
  return %same_active, %at_limit
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @exec_read_survives_disjoint_writes(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.scc>) asm {
  %active = s_mov_b64_exec_read
  %within_bounds = s_cmp_lt_u32 %ordinal, %limit
  low.br ^bridge
^bridge:
  low.br ^finish
^finish:
  %at_limit = s_cmp_eq_i32 %ordinal, %limit
  return %active, %at_limit
}

// ====
// RUN: pass low-cse

amdgpu.target<gfx1100> @target

// Restoring EXEC expires the old snapshot. Repeated full barriers and slot
// reuse cannot make an old state-index membership live again.
low.func.def target<amdgpu.rdna3.core>(@target) @exec_read_epochs(%mask: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %before = s_mov_b64_exec_read
  low.br ^restore
^restore:
  s_mov_b64_exec %mask
  %middle = s_mov_b64_exec_read
  %middle_copy = s_mov_b64_exec_read
  s_mov_b64_exec %mask
  %after = s_mov_b64_exec_read
  low.br ^finish
^finish:
  %after_copy = s_mov_b64_exec_read
  return %before, %middle_copy, %after_copy
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @exec_read_epochs(%mask: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %before = s_mov_b64_exec_read
  low.br ^restore
^restore:
  s_mov_b64_exec %mask
  %middle = s_mov_b64_exec_read
  s_mov_b64_exec %mask
  %after = s_mov_b64_exec_read
  low.br ^finish
^finish:
  return %before, %middle, %after
}

// ====
// RUN: pass low-cse

amdgpu.target<gfx1100> @target

// Each join requires a fresh snapshot, but a straight-line successor can reuse
// it across SCC writes. Equal hashes at several depths retain distinct scopes.
low.func.def target<amdgpu.rdna3.core>(@target) @exec_reads_at_joins(%condition: reg<amdgpu.scc>) -> (reg<amdgpu.sgpr x2>) asm {
  %entry_active = s_mov_b64_exec_read
  low.cond_br %condition, ^side, ^join : reg<amdgpu.scc>
^side:
  low.br ^join
^join:
  %joined_active = s_mov_b64_exec_read
  %nonempty = s_cmp_eq_u64 %joined_active, %joined_active
  low.cond_br %nonempty, ^next_side, ^next_join : reg<amdgpu.scc>
^next_side:
  low.br ^next_join
^next_join:
  %next_active = s_mov_b64_exec_read
  low.br ^finish
^finish:
  %unchanged = s_cmp_eq_u64 %next_active, %next_active
  %active_copy = s_mov_b64_exec_read
  return %active_copy
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @exec_reads_at_joins(%condition: reg<amdgpu.scc>) -> (reg<amdgpu.sgpr x2>) asm {
  %entry_active = s_mov_b64_exec_read
  low.cond_br %condition, ^side, ^join : reg<amdgpu.scc>
^side:
  low.br ^join
^join:
  %joined_active = s_mov_b64_exec_read
  %nonempty = s_cmp_eq_u64 %joined_active, %joined_active
  low.cond_br %nonempty, ^next_side, ^next_join : reg<amdgpu.scc>
^next_side:
  low.br ^next_join
^next_join:
  %next_active = s_mov_b64_exec_read
  low.br ^finish
^finish:
  %unchanged = s_cmp_eq_u64 %next_active, %next_active
  return %next_active
}

// ====
// Discarded condition clobbers do not prevent reusing scalar values. Explicit
// condition results remain distinct even when their comparisons are identical.
// RUN: pass low-cse

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @scalar_values_across_condition_lifetimes(%value: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %unsigned_byte = s_bfe_u32_lit %value, 524288
  %signed_byte = s_bfe_i32_lit %value, 524288
  %first_condition = s_cmp_lt_u32 %value, %limit
  %first_selected = s_cselect_b32 %unsigned_byte, %limit, %first_condition
  %same_unsigned = s_bfe_u32_lit %value, 524288
  %same_signed = s_bfe_i32_lit %value, 524288
  %next_condition = s_cmp_lt_u32 %value, %limit
  %next_selected = s_cselect_b32 %same_unsigned, %limit, %next_condition
  %sum = s_add_u32 %same_unsigned, %limit
  %same_sum = s_add_u32 %same_unsigned, %limit
  return %unsigned_byte, %same_unsigned, %signed_byte, %same_signed, %first_selected, %next_selected, %same_sum
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @scalar_values_across_condition_lifetimes(%value: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %unsigned_byte = s_bfe_u32_lit %value, 524288
  %signed_byte = s_bfe_i32_lit %value, 524288
  %first_condition = s_cmp_lt_u32 %value, %limit
  %first_selected = s_cselect_b32 %unsigned_byte, %limit, %first_condition
  %next_condition = s_cmp_lt_u32 %value, %limit
  %next_selected = s_cselect_b32 %unsigned_byte, %limit, %next_condition
  %sum = s_add_u32 %unsigned_byte, %limit
  return %unsigned_byte, %unsigned_byte, %signed_byte, %signed_byte, %first_selected, %next_selected, %sum
}

