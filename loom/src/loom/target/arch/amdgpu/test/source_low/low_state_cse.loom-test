// RUN: pass cse

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @m0_state_writes_do_not_cse(%value0: reg<amdgpu.vgpr>, %value1: reg<amdgpu.vgpr>) asm {
  %m0a = s_mov_b32_m0_imm 0
  ds_write_addtid_b32 %value0, %m0a
  %m0b = s_mov_b32_m0_imm 0
  ds_write_addtid_b32 %value1, %m0b {offset = 4}
  return
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @m0_state_writes_do_not_cse(%value0: reg<amdgpu.vgpr>, %value1: reg<amdgpu.vgpr>) {
  %m0a = low.const<amdgpu.s_mov_b32_m0.imm> {imm32 = 0} : reg<amdgpu.m0>
  low.op<amdgpu.ds_write_addtid_b32>(%value0, %m0a) : (reg<amdgpu.vgpr>, reg<amdgpu.m0>)
  %m0b = low.const<amdgpu.s_mov_b32_m0.imm> {imm32 = 0} : reg<amdgpu.m0>
  low.op<amdgpu.ds_write_addtid_b32>(%value1, %m0b) {offset = 4} : (reg<amdgpu.vgpr>, reg<amdgpu.m0>)
  low.return
}
