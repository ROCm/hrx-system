low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @subtract_f16_2() asm {
  %left = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %right = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_mov_b32 0
  %a = global_load_dword_saddr %13, %left
  %b = global_load_dword_saddr %13, %right
  %difference = v_pk_add_f16 %a, %b {neg_lo = 2, neg_hi = 2}
  global_store_dword_saddr %13, %difference, %result
  return
}

