  %32 = v_mul_lo_u32 %31, %20
  %33 = v_sub_nc_u32 %dividend, %32
  %34 = v_add_u32 %31, %22
  %35, %36 = v_sub_co_u32 %33, %20
  %37 = v_cndmask_b32 %34, %31, %36
  %38 = v_cndmask_b32 %35, %33, %36
  %39 = v_add_u32 %37, %22
  %40, %41 = v_sub_co_u32 %38, %20
  %quotient = v_cndmask_b32 %39, %37, %41
