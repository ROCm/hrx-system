// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Float conversion requires vector storage even though the input is uniform.
// Both integer results must retain that physical operand dependency.
kernel.def @uniform_vector_unsigned_pair() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: f32, %divisor: i32, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<2x64xi32>
  %dividend = scalar.fptoui %input : f32 to i32
  %quotient, %remainder = scalar.divremui %dividend, %divisor : i32
  view.store %quotient, %result_view_0[0, %fixture_lane] : i32, view<2x64xi32>
  view.store %remainder, %result_view_0[1, %fixture_lane] : i32, view<2x64xi32>
  kernel.return
}

