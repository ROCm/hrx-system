// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Float conversion requires vector storage even though the input is uniform.
// Both integer results must retain that physical operand dependency.
func.def @uniform_vector_unsigned_pair(%input: f32, %divisor: i32) -> (i32, i32) {
  %dividend = scalar.fptoui %input : f32 to i32
  %quotient, %remainder = scalar.divremui %dividend, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @uniform_vector_unsigned_pair(%input: reg<amdgpu.vgpr>, %divisor: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %dividend = v_cvt_u32_f32 %input
  %12 = v_mov_b32_copy %divisor
  %13 = v_mov_b32 0
  %14 = v_mov_b32 1
  %15 = v_cvt_f32_u32 %12
  %16 = v_rcp_f32 %15
  %17 = v_mul_f32_lit %16, 1333788670
  %18 = v_cvt_u32_f32 %17
  %19 = v_mul_lo_u32 %12, %18
  %20 = v_sub_nc_u32 %13, %19
  %21 = v_mul_hi_u32 %18, %20
  %22 = v_add_u32 %18, %21
  %23 = v_mul_hi_u32 %dividend, %22
  %24 = v_mul_lo_u32 %23, %12
  %25 = v_sub_nc_u32 %dividend, %24
  %26 = v_add_u32 %23, %14
  %27, %28 = v_sub_co_u32 %25, %12
  %29 = v_cndmask_b32 %26, %23, %28
  %30 = v_cndmask_b32 %27, %25, %28
  %31 = v_add_u32 %29, %14
  %32, %33 = v_sub_co_u32 %30, %12
  %quotient = v_cndmask_b32 %31, %29, %33
  %remainder = v_cndmask_b32 %32, %30, %33
  return %quotient, %remainder
}

// ====

// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @uniform_vector_signed_pair(%input: f32, %divisor: i32) -> (i32, i32) {
  %dividend = scalar.fptosi %input : f32 to i32
  %quotient, %remainder = scalar.divremsi %dividend, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @uniform_vector_signed_pair(%input: reg<amdgpu.vgpr>, %divisor: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %dividend = v_cvt_i32_f32 %input
  %12 = v_mov_b32_copy %divisor
  %13 = v_ashrrev_i32_src0_inline %dividend, 31
  %14 = v_ashrrev_i32_src0_inline %12, 31
  %15 = v_xor_b32 %dividend, %13
  %16 = v_sub_u32 %15, %13
  %17 = v_xor_b32 %12, %14
  %18 = v_sub_u32 %17, %14
  %19 = v_mov_b32 0
  %20 = v_mov_b32 1
  %21 = v_cvt_f32_u32 %18
  %22 = v_rcp_f32 %21
  %23 = v_mul_f32_lit %22, 1333788670
  %24 = v_cvt_u32_f32 %23
  %25 = v_mul_lo_u32 %18, %24
  %26 = v_sub_u32 %19, %25
  %27 = v_mul_hi_u32 %24, %26
  %28 = v_add_u32 %24, %27
  %29 = v_mul_hi_u32 %16, %28
  %30 = v_mul_lo_u32 %29, %18
  %31 = v_sub_u32 %16, %30
  %32 = v_add_u32 %29, %20
  %33, %34 = v_sub_co_u32 %31, %18
  %35 = v_cndmask_b32 %32, %29, %34
  %36 = v_cndmask_b32 %33, %31, %34
  %37 = v_add_u32 %35, %20
  %38, %39 = v_sub_co_u32 %36, %18
  %40 = v_cndmask_b32 %37, %35, %39
  %41 = v_cndmask_b32 %38, %36, %39
  %42 = v_xor_b32 %13, %14
  %43 = v_xor_b32 %40, %42
  %quotient = v_sub_u32 %43, %42
  %45 = v_xor_b32 %41, %13
  %remainder = v_sub_u32 %45, %13
  return %quotient, %remainder
}

// ====

// RUN: emit source-low target=amdgpu:gfx1201 output=low

func.def @uniform_vector_index_pair(%input: f64, %divisor_input: i32) -> (index, index) {
  %converted = scalar.fptoui %input : f64 to i32
  %mask = scalar.constant 65535 : i32
  %c1 = scalar.constant 1 : i32
  %dividend_word = scalar.andi %converted, %mask : i32
  %divisor_masked = scalar.andi %divisor_input, %mask : i32
  %divisor_word = scalar.ori %divisor_masked, %c1 : i32
  %dividend = index.cast %dividend_word : i32 to index
  %divisor = index.cast %divisor_word : i32 to index
  %quotient, %remainder = index.divrem %dividend, %divisor : index
  func.return %quotient, %remainder : index, index
}

// ----
low.func.def target<amdgpu.rdna4.core> abi(hal_kernel) @uniform_vector_index_pair(%input: reg<amdgpu.vgpr x2>, %divisor_input: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %converted = v_cvt_u32_f64 %input
  %dividend = v_and_b32_lit %converted, 65535
  %divisor_masked = s_and_b32_lit %divisor_input, 65535
  %divisor = s_or_b32_rhs_inline %divisor_masked, 1
  %22 = v_mov_b32_copy %divisor
  %23 = v_mov_b32 0
  %24 = v_mov_b32 1
  %25 = v_cvt_f32_u32 %22
  %26 = v_rcp_f32 %25
  %27 = v_mul_f32_lit %26, 1333788670
  %28 = v_cvt_u32_f32 %27
  %29 = v_mul_lo_u32 %22, %28
  %30 = v_sub_nc_u32 %23, %29
  %31 = v_mul_hi_u32 %28, %30
  %32 = v_add_u32 %28, %31
  %33 = v_mul_hi_u32 %dividend, %32
  %34 = v_mul_lo_u32 %33, %22
  %35 = v_sub_nc_u32 %dividend, %34
  %36 = v_add_u32 %33, %24
  %37, %38 = v_sub_co_u32 %35, %22
  %39 = v_cndmask_b32 %36, %33, %38
  %40 = v_cndmask_b32 %37, %35, %38
  %41 = v_add_u32 %39, %24
  %42, %43 = v_sub_co_u32 %40, %22
  %quotient = v_cndmask_b32 %41, %39, %43
  %remainder = v_cndmask_b32 %42, %40, %43
  return %quotient, %remainder
}
