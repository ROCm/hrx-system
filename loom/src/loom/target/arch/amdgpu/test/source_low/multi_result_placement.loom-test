low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "divisor"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 4, resource_count = 3, resource_offsets = [0, 16, 24], resource_parameter_indices = [0, 2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_vector_unsigned_pair(%divisor: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 256, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  %input = global_load_b32_saddr %20, %input_view
  %dividend = v_cvt_u32_f32 %input
  %23 = v_mov_b32_copy %divisor
  %24 = v_mov_b32 0
  %25 = v_mov_b32 1
  %26 = v_cvt_f32_u32 %23
  %27 = v_rcp_f32 %26
  %28 = v_mul_f32_lit %27, 1333788670
  %29 = v_cvt_u32_f32 %28
  %30 = v_mul_lo_u32 %23, %29
  %31 = v_sub_nc_u32 %24, %30
  %32 = v_mul_hi_u32 %29, %31
  %33 = v_add_u32 %29, %32
  %34 = v_mul_hi_u32 %dividend, %33
  %35 = v_mul_lo_u32 %34, %23
  %36 = v_sub_nc_u32 %dividend, %35
  %37 = v_add_u32 %34, %25
  %38, %39 = v_sub_co_u32 %36, %23
  %40 = v_cndmask_b32 %37, %34, %39
  %41 = v_cndmask_b32 %38, %36, %39
  %42 = v_add_u32 %40, %25
  %43, %44 = v_sub_co_u32 %41, %23
  %quotient = v_cndmask_b32 %42, %40, %44
  %remainder = v_cndmask_b32 %43, %41, %44
  global_store_b32_saddr %20, %quotient, %result_view_0
  global_store_b32_saddr %20, %remainder, %result_view_1
  return
}

