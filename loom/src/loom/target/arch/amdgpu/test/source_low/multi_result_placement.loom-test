// RUN: emit source-low target=amdgpu:gfx1201 output=low

kernel.def @uniform_vector_index_pair() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input_buffer: buffer, %divisor_input: i32, %result_buffer_0: buffer, %result_buffer_1: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %input_view = buffer.view %input_buffer[%fixture_base] : buffer -> view<64xf64>
  %input = view.load %input_view[%fixture_lane] : view<64xf64> -> f64
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xi64>
  %converted = scalar.fptoui %input : f64 to i32
  %mask = scalar.constant 65535 : i32
  %c1 = scalar.constant 1 : i32
  %dividend_word = scalar.andi %converted, %mask : i32
  %divisor_masked = scalar.andi %divisor_input, %mask : i32
  %divisor_word = scalar.ori %divisor_masked, %c1 : i32
  %dividend = index.cast %dividend_word : i32 to index
  %divisor = index.cast %divisor_word : i32 to index
  %quotient, %remainder = index.divrem %dividend, %divisor : index
  %result_storage_0 = index.cast %quotient : index to i64
  view.store %result_storage_0, %result_view_0[%fixture_lane] : i64, view<64xi64>
  %result_storage_1 = index.cast %remainder : index to i64
  view.store %result_storage_1, %result_view_1[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

