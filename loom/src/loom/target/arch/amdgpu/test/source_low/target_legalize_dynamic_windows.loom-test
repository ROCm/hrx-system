// RUN: pass target-legalize{mode=eager,policy=require-native},linearize-view-accesses,canonicalize,cse,target-legalize{mode=complete,policy=require-native},canonicalize,cse

amdgpu.target<gfx11-generic> @target

// Wide stores replay conversion from a dynamic predicate window packet by
// packet. The store planner must leave the rejected slice for the dynamic
// window legalizer instead of capturing it as an external producer.
func.def target(@target) @store_streamed_wide_predicate_window(%source: buffer, %output: buffer, %offset: index) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %source[%base] : buffer -> view<80xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<65xi8>
  %values = vector.load %source_view[0] : view<80xi32> -> vector<80xi32>
  %c0 = vector.constant 0 : vector<80xi32>
  %predicates = vector.cmpi slt, %values, %c0 : vector<80xi32> -> vector<80xi1>
  %window = vector.slice %predicates[%offset] : vector<80xi1> -> vector<65xi1>
  %result = vector.extui %window : vector<65xi1> to vector<65xi8>
  vector.store %result, %output_view[0] : vector<65xi8>, view<65xi8>
  func.return
}

