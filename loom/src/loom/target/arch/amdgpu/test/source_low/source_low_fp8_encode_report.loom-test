// ====

// Schema-driven encoding reuses the exact plan selected for the equivalent
// scalar-format conversion instead of scalarizing the logical lanes.
amdgpu.target<gfx1100> @target

func.def target(@target) @report_schema_f32_to_fp8_software(%input: vector<4xf32>) -> (vector<4xf8E4M3>) {
  %schema = encoding.define #encoding.f8e4m3fn<payload_elements=4, rounding=finite_only> : encoding<schema>
  %encoded = vector.encode %input using %schema : vector<4xf32>, encoding<schema> -> vector<4xf8E4M3>
  func.return %encoded : vector<4xf8E4M3>
}

