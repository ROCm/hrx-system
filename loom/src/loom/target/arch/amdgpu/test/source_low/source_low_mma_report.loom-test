// RUN: with-checks compile-report scf-to-cfg,cfg-simplify,source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

func.def target(@target) @report_fixed_trip_matrix_loop(%lhs_data: vector<16xbf16>, %rhs_data: vector<16xbf16>, %init_data: vector<8xf32>) -> (vector<8xf32>) {
  %k_tile_begin = index.constant 0 : index
  %k_tile_step = index.constant 1 : index
  %k_tile_end = index.constant 2 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] : vector<16xbf16>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] : vector<16xbf16>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<8xf32>
  %result = scf.for %k_tile = [%k_tile_begin to %k_tile_end step %k_tile_step](%acc = %init : vector<8xf32>) -> (vector<8xf32>) {
    %next = vector.mma %lhs, %rhs, %acc : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next : vector<8xf32>
  }
  func.return %result : vector<8xf32>
}

// ----
// The loop header runs once more than the MMA body and induction update.
CHECK: COMPILE-REPORT: source_low[*] * source_op=index.cmp * execution_count=3
CHECK: COMPILE-REPORT: source_low[*] * source_op=vector.mma selection=plan descriptor_key=amdgpu.v_wmma_f32_16x16x16_bf16 descriptor_semantic_tag=matrix.wmma.f32.16x16x16.bf16 * execution_count=2
CHECK: COMPILE-REPORT: source_low[*] * source_op=index.add * execution_count=2
CHECK: COMPILE-REPORT: source_low_selection[*] * source_op=vector.mma selection=plan descriptor_key=amdgpu.v_wmma_f32_16x16x16_bf16 descriptor_semantic_tag=matrix.wmma.f32.16x16x16.bf16 selected_ops=1 * exact_dynamic_ops=1 unknown_dynamic_ops=0 dynamic_selected_ops=2 *
CHECK: COMPILE-REPORT: source_low_native[*] * source_op=vector.mma native_contraction={tile:1x16x16x16,participants:32,lhs:{evidence:exact,bits:16,registers:8,payload:16,positions:512,coordinates:256,owners:2},rhs:{evidence:exact,bits:16,registers:8,payload:16,positions:512,coordinates:256,owners:2},accumulator:{evidence:exact,bits:32,registers:8,payload:8,positions:256,coordinates:256,owners:1},result:{evidence:exact,bits:32,registers:8,payload:8,positions:256,coordinates:256,owners:1}}

// ====

amdgpu.target<gfx1100> @target {subgroup_size = 64}

kernel.def target(@target) @report_strided_packed_b16_fragment_load() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %fragment_row_origin = index.constant 0 : index
  %column_origin = index.constant 32 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<16x128xf16>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<64xf16>
  %rhs = vector.fragment.load<rhs> %rhs_view[%fragment_row_origin, %column_origin] shape [%k, %n] : view<16x128xf16> -> vector<16xf16>
  %lane0 = vector.extract %rhs[0] : vector<16xf16> -> f16
  %lane = kernel.workitem.id<x> : index
  view.store %lane0, %output_view[%lane] : f16, view<64xf16>
  kernel.return
}

// ----
CHECK: COMPILE-REPORT: source_low[*] * source_op=vector.fragment.load selection=plan plan_key=strided_d16_packed_b16_fragment_load *
CHECK: COMPILE-REPORT: source_low_memory * packets=17 loads=16 stores=1 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=rhs_buffer * memory_space=global operation=load packet=amdgpu.global_load_b16_d16_saddr strategy=strided_d16_packed_b16_fragment_load storage={element_format:f16}* packets=8 * source_lanes=8 source_bytes=16 * issued_read_bytes=16 issued_write_bytes=0 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
CHECK: COMPILE-REPORT: source_low_memory_argument_packet[*] * source_root=rhs_buffer * memory_space=global operation=load packet=amdgpu.global_load_b16_d16_hi_saddr strategy=strided_d16_packed_b16_fragment_load storage={element_format:f16}* packets=8 * source_lanes=8 source_bytes=16 * issued_read_bytes=16 issued_write_bytes=0 issued_read_unknown_widths=0 issued_write_unknown_widths=0 *
