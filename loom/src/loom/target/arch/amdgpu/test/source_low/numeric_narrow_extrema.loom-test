  %30 = scalar.minnumf %28, %29 : f32
  %31 = scalar.fptrunc %30 : f32 to f8E5M2
  %minimum = vector.from_elements %35, %31 : vector<2xf8E5M2>
  %6 = vector.extract %lhs[0] : vector<2xf8E5M2> -> f8E5M2
