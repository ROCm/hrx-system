func.def @f8e4m3_vector_extrema(%lhs: vector<2xf8E4M3>, %rhs: vector<2xf8E4M3>) -> (vector<2xf8E4M3>, vector<2xf8E4M3>) {
  %21 = vector.extract %lhs[0] : vector<2xf8E4M3> -> f8E4M3
  %22 = vector.extract %rhs[0] : vector<2xf8E4M3> -> f8E4M3
  %32 = scalar.extf %21 : f8E4M3 to f32
  %33 = scalar.extf %22 : f8E4M3 to f32
  %34 = scalar.minnumf %32, %33 : f32
  %35 = scalar.fptrunc %34 : f32 to f8E4M3
  %24 = vector.extract %lhs[1] : vector<2xf8E4M3> -> f8E4M3
  %25 = vector.extract %rhs[1] : vector<2xf8E4M3> -> f8E4M3
  %28 = scalar.extf %24 : f8E4M3 to f32
  %29 = scalar.extf %25 : f8E4M3 to f32
  %30 = scalar.minnumf %28, %29 : f32
  %31 = scalar.fptrunc %30 : f32 to f8E4M3
  %minimum = vector.from_elements %35, %31 : vector<2xf8E4M3>
  %6 = vector.extract %lhs[0] : vector<2xf8E4M3> -> f8E4M3
  %7 = vector.extract %rhs[0] : vector<2xf8E4M3> -> f8E4M3
  %17 = scalar.extf %6 : f8E4M3 to f32
  %18 = scalar.extf %7 : f8E4M3 to f32
  %19 = scalar.maxnumf<nnan|nsz> %17, %18 : f32
  %20 = scalar.fptrunc %19 : f32 to f8E4M3
  %9 = vector.extract %lhs[1] : vector<2xf8E4M3> -> f8E4M3
  %10 = vector.extract %rhs[1] : vector<2xf8E4M3> -> f8E4M3
  %13 = scalar.extf %9 : f8E4M3 to f32
  %14 = scalar.extf %10 : f8E4M3 to f32
  %15 = scalar.maxnumf<nnan|nsz> %13, %14 : f32
  %16 = scalar.fptrunc %15 : f32 to f8E4M3
  %maximum = vector.from_elements %20, %16 : vector<2xf8E4M3>
  func.return %minimum, %maximum : vector<2xf8E4M3>, vector<2xf8E4M3>
}

