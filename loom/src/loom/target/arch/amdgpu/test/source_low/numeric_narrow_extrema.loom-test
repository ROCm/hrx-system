  %32 = scalar.extf %21 : f8E5M2 to f32
  %33 = scalar.extf %22 : f8E5M2 to f32
  %34 = scalar.minnumf %32, %33 : f32
  %35 = scalar.fptrunc %34 : f32 to f8E5M2
  %24 = vector.extract %lhs[1] : vector<2xf8E5M2> -> f8E5M2
