kernel.def target(@target) @gfx1100_explicit_runtime_strided_vector_load() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%row0: index, %row_stride0: index, %input_buffer: buffer, %output_buffer: buffer) {
  %row = index.assume %row0 [range(%row0, 0, 31)] : index
  %row_stride = index.assume %row_stride0 [range(%row_stride0, 16, 32768)] : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [%row_stride, 1] : encoding<layout>
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<32x16xf32, %layout>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<32x4xf32>
  %values = vector.load %input_view[%row, 0] : view<32x16xf32, %layout> -> vector<4xf32>
  vector.store %values, %output_view[%row, 0] : vector<4xf32>, view<32x4xf32>
  kernel.return
}

