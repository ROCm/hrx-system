// RUN: emit source-low output=low

amdgpu.target<gfx1151> @target {subgroup_size = 64}

kernel.def target(@target) @gfx1151_dynamic_result_row_stride() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%row_size0: index, %output: buffer) {
  %row_size = index.assume %row_size0 [range(%row_size0, 64, 32768), multiple_of(%row_size0, 64)] : index
  %base = index.constant 0 : offset
  %origin = index.constant 0 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %output_view = buffer.view %output[%base] : buffer -> view<32x[%row_size]xf32>
  %values_scalar = scalar.constant 0.0 : f32
  %values = vector.splat %values_scalar : vector<4xf32>
  %result = vector.fragment<result> %values shape [%m, %n] : vector<4xf32>
  vector.fragment.store<result> %result, %output_view[%origin, %origin] shape [%m, %n] : vector<4xf32>, view<32x[%row_size]xf32>
  kernel.return
}

