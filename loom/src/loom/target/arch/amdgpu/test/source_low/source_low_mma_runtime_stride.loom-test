  %21 = v_and_b32_src0_inline %13, 15
  %22 = v_lshlrev_b32_src0_inline %21, 2
  %23 = v_lshrrev_b32_src0_inline %13, 4
  %24 = v_mul_lo_u32 %20, %23
  %25 = v_add_u32 %22, %24
  global_store_b32_saddr %25, %15, %output_view
  %28 = s_lshl_b32_rhs_inline %20, 2
  %29 = v_add_u32 %28, %25
  global_store_b32_saddr %29, %15, %output_view
  %31 = v_add_u32 %28, %29
  global_store_b32_saddr %31, %15, %output_view
  %33 = v_add_u32 %28, %31
  global_store_b32_saddr %33, %15, %output_view
  return
}

