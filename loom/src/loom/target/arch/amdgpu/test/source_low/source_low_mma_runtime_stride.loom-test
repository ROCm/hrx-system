kernel.def target(@target) @gfx942_dynamic_operand_strides() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%lhs_column_count0: index, %rhs_column_stride0: index, %lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %lhs_column_count = index.assume %lhs_column_count0 [range(%lhs_column_count0, 16, 32768)] : index
  %rhs_column_stride = index.assume %rhs_column_stride0 [range(%rhs_column_stride0, 16, 32768)] : index
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %rhs_layout = encoding.layout.strided [1, %rhs_column_stride] : encoding<layout>
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<16x[%lhs_column_count]xbf16>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<16x16xbf16, %rhs_layout>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<16x16xf32>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<16x[%lhs_column_count]xbf16> -> vector<4xbf16>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<16x16xbf16, %rhs_layout> -> vector<4xbf16>
  %initial_values = vector.constant 0.0 : vector<4xf32>
  %initial = vector.fragment<init> %initial_values shape [%m, %n] : vector<4xf32>
  %result = vector.mma %lhs, %rhs, %initial : vector<4xbf16>, vector<4xbf16>, vector<4xf32>
  vector.fragment.store<result> %result, %output_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>
  kernel.return
}

