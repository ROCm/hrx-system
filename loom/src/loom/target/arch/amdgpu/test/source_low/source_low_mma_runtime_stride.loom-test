  %output_view = resource<hal_binding> {extent = 1024, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %28 = s_lshl_b32_rhs_inline %lhs_column_count, 1
  %29 = v_lshrrev_b32_src0_inline %24, 4
  %30 = v_lshlrev_b32_src0_inline %29, 3
  %31 = v_and_b32_src0_inline %24, 15
  %32 = v_mul_lo_u32 %28, %31
  %33 = v_add_u32 %30, %32
  %lhs = global_load_dwordx2_saddr %33, %lhs_view
  %35 = s_lshl_b32_rhs_inline %rhs_column_stride, 1
  %37 = v_mul_lo_u32 %35, %31
  %38 = v_add_u32 %30, %37
  %rhs = global_load_dwordx2_saddr %38, %rhs_view
  %40 = v_mov_b32 0
  %initial = concat(%40, %40, %40, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %45 = copy %initial : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %result = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %45
