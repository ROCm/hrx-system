  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_mov_b32 0
  %21 = s_lshl_b32_rhs_inline %row_size, 2
  %22 = v_and_b32_src0_inline %14, 15
  %23 = v_lshlrev_b32_src0_inline %22, 2
  %24 = v_lshrrev_b32_src0_inline %14, 4
  %25 = v_mul_lo_u32 %21, %24
  %26 = v_add_u32 %23, %25
  global_store_b32_saddr %26, %16, %output_view
  %29 = s_lshl_b32_rhs_inline %21, 2
  %30 = v_add_u32 %29, %26
  global_store_b32_saddr %30, %16, %output_view
  %32 = v_add_u32_rhs_tied %29, %30
  global_store_b32_saddr %32, %16, %output_view
  %34 = v_add_u32_rhs_tied %29, %32
  global_store_b32_saddr %34, %16, %output_view
  return
