  %50 = v_lshlrev_b32_src0_inline %29, 8
  %51 = v_add_u32 %49, %50
  %52 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %53 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %51, %52, %output_view, %53
