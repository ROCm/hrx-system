  %layout = encoding.layout.strided [%row_stride, 1] : encoding<layout>
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<32x16xf32, %layout>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<32x4xf32>
