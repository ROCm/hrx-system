  %rhs_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 1024, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %29 = s_lshl_b32_rhs_inline %lhs_column_count, 1
  %30 = v_lshrrev_b32_src0_inline %25, 4
  %31 = v_lshlrev_b32_src0_inline %30, 3
  %32 = v_and_b32_src0_inline %25, 15
  %33 = v_mul_lo_u32 %29, %32
  %34 = v_add_u32 %31, %33
  %lhs = global_load_dwordx2_saddr %34, %lhs_view : reg<amdgpu.vgpr x2>
  %36 = s_lshl_b32_rhs_inline %rhs_column_stride, 1
  %38 = v_mul_lo_u32 %36, %32
  %39 = v_add_u32 %31, %38
  %rhs = global_load_dwordx2_saddr %39, %rhs_view : reg<amdgpu.vgpr x2>
  %initial_values_scalar = v_mov_b32 0
  %initial = concat(%initial_values_scalar, %initial_values_scalar, %initial_values_scalar, %initial_values_scalar) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %43 = copy %initial : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %result = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %43
  %45 = v_lshlrev_b32_src0_inline %32, 2
  %46 = v_lshl_add_u32_shift_imm %30, %45, 8
  %47 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %46, %47, %output_view
  %48 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %46, %48, %output_view {offset = 64}
  %49 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %46, %49, %output_view {offset = 128}
  %50 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %46, %50, %output_view {offset = 192}
  return
