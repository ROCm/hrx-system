  %values = global_load_b128_saddr %20, %30
  %33 = s_lshl_b32_rhs_inline %row, 4
  %34 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37, %38 = s_add_co_u32 %34, %33
  %39, %40 = s_addc_u32 %35, %25, %38
  %41 = concat(%37, %39) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %20, %values, %41
  return
