// ====
// RUN: emit source-low output=low sanitizer-reporting=trap

// Trap reporting branches to the hardware trap without producing a packet.
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @kernel_assert_trap() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: i32) {
  %c0 = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %value, %c0 : i32
  kernel.assert %condition : i1
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 1, resource_count = 0, resource_offsets = [], resource_parameter_indices = [], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @kernel_assert_trap(%value: reg<amdgpu.sgpr>) asm {
  %c0 = s_mov_b32 0
  %condition = s_cmp_lg_i32 %value, %c0
  low.cond_br %condition, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  return
^_bb2:
  s_trap {trapid = 2}
  %7 = s_sendmsg_rtn_b32 {message = 128}
  %8 = s_mov_b32 1023
  %9 = s_and_b32 %7, %8
  %10 = s_mov_b32 1024
  %11 = s_or_b32 %9, %10
  %12 = s_mov_b32_m0 %11
  s_sendmsg %12 {message = 1}
  low.br ^_bb3
^_bb3:
  s_sethalt {reason = 5}
  low.br ^_bb3
}
