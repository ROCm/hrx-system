// RUN: emit source-low output=low

// A durable uniform i1 is unpacked before the hot path compares it against
// zero and branches around the shared cold UBSAN report producer.
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @kernel_assert_uniform_word() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%condition: i1) {
  kernel.assert %condition : i1
  kernel.return
}

