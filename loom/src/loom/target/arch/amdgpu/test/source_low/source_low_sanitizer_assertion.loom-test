// ====

// Divergent assertions narrow EXEC to the active lanes whose predicate is
// false. The feedback packet identifies one of those failed lanes.
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @kernel_assert_varying_mask() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %limit = index.constant 32 : index
  %condition = index.cmp ult, %lane, %limit : index
  kernel.assert %condition : i1
  kernel.return
}

