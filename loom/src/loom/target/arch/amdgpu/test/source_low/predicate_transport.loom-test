  %39 = v_lshlrev_b32_src0_inline %capture_lane, 2
  %lhs = global_load_b32_saddr %39, %lhs_view
  %41 = v_lshlrev_b32_src0_inline %capture_lane, 2
  %rhs = global_load_b32_saddr %41, %rhs_view
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %lane = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %first = v_cmp_lt_i32 %lane, %limit
  %second = v_cmp_gt_i32 %lane, %limit
  low.br ^loop(%begin: reg<amdgpu.sgpr>, %first: reg<amdgpu.sgpr x2>, %second: reg<amdgpu.sgpr x2>)
^loop(%iteration: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr x2>, %tail: reg<amdgpu.sgpr x2>):
  %again = s_cmp_lt_i32 %iteration, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %next = s_add_u32 %iteration, %step
  low.br ^loop(%next: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr x2>, %head: reg<amdgpu.sgpr x2>)
^exit:
  %selected = v_cndmask_b32 %rhs, %lhs, %head
  %result = v_cndmask_b32 %rhs, %selected, %tail
  %52 = v_lshlrev_b32_src0_inline %capture_lane, 2
  global_store_b32_saddr %52, %result, %captured
  return
}

