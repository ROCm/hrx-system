amdgpu.target<gfx11-generic> @target {subgroup_size = 32}

// Uniform selection and queue arguments share normalized scalar storage.
// The loop transports independent predicates without capturing EXEC.
kernel.def target(@target) @uniform_predicate_queue() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%selector: i32, %first_flag: i32, %second_flag: i32, %limit: i32, %output: buffer) {
  %begin = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %pick_first = scalar.cmpi ne, %selector, %begin : i32
  %first = scalar.cmpi ne, %first_flag, %begin : i32
  %second = scalar.cmpi ne, %second_flag, %begin : i32
  %selected = scf.select %pick_first, %first, %second : i1
  cfg.br ^loop(%begin: i32, %selected: i1, %first: i1)
^loop(%iteration: i32, %head: i1, %tail: i1):
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %step : i32
  cfg.br ^loop(%next: i32, %tail: i1, %head: i1)
^exit:
  cfg.cond_br %head, ^enabled, ^disabled
^enabled:
  view.store %step, %output_view[0] : i32, view<1xi32>
  kernel.return
^disabled:
  view.store %begin, %output_view[0] : i32, view<1xi32>
  kernel.return
}

