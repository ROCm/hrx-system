amdgpu.target<gfx11-generic> @target

// Lane predicates retain their full masks while scalar loop control clobbers SCC.
kernel.def target(@target) @rotating_lane_predicates() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%values_buffer: buffer, %limit: i32, %lhs_buffer: buffer, %rhs_buffer: buffer, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %values_view = buffer.view %values_buffer[%capture_base] : buffer -> view<64x2xi32>
  %values = vector.load %values_view[%capture_lane, 0] : view<64x2xi32> -> vector<2xi32>
  %lhs_view = buffer.view %lhs_buffer[%capture_base] : buffer -> view<64xf32>
  %lhs = view.load %lhs_view[%capture_lane] : view<64xf32> -> f32
  %rhs_view = buffer.view %rhs_buffer[%capture_base] : buffer -> view<64xf32>
  %rhs = view.load %rhs_view[%capture_lane] : view<64xf32> -> f32
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xf32>
  %begin = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %first = scalar.cmpi slt, %lane, %limit : i32
  %second = scalar.cmpi sgt, %lane, %limit : i32
  cfg.br ^loop(%begin: i32, %first: i1, %second: i1)
^loop(%iteration: i32, %head: i1, %tail: i1):
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %step : i32
  cfg.br ^loop(%next: i32, %tail: i1, %head: i1)
^exit:
  %selected = scf.select %head, %lhs, %rhs : f32
  %result = scf.select %tail, %selected, %rhs : f32
  view.store %result, %captured[%capture_lane] : f32, view<64xf32>
  kernel.return
}

