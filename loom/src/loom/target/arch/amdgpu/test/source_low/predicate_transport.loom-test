low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 3, direct_arg_count = 3, direct_arg_names = {arg0 = "lhs", arg1 = "rhs", arg2 = "limit"}, direct_arg_offsets = [0, 4, 8], direct_arg_parameter_indices = [0, 1, 2], direct_arg_sizes = [4, 4, 4], parameter_count = 4, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @rotating_predicates(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %32 = s_cmp_lt_i32 %lhs, %rhs
  %33 = s_mov_b32 0
  %34 = s_mov_b32 1
  %first = s_cselect_b32 %34, %33, %32
  %36 = s_cmp_gt_i32 %lhs, %rhs
  %37 = s_mov_b32 0
  %38 = s_mov_b32 1
  %second = s_cselect_b32 %38, %37, %36
  %40 = s_mov_b32 0
  %41 = s_cmp_lg_i32 %first, %40
  low.cond_br %41, ^prepare, ^empty : reg<amdgpu.scc>
^prepare:
  low.br ^loop(%begin: reg<amdgpu.sgpr>, %first: reg<amdgpu.sgpr>, %second: reg<amdgpu.sgpr>)
^loop(%iteration: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr>):
  %again = s_cmp_lt_i32 %iteration, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %next = s_add_u32 %iteration, %step
  low.br ^loop(%next: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr>)
^exit:
  %44 = s_cmp_lg_i32_src1_inline %head {rhs = 0}
  %selected = s_cselect_b32 %lhs, %rhs, %44
  %46 = s_cmp_lg_i32_src1_inline %tail {rhs = 0}
  %result = s_cselect_b32 %selected, %limit, %46
  low.br ^done(%result: reg<amdgpu.sgpr>)
^empty:
  low.br ^done(%begin: reg<amdgpu.sgpr>)
^done(%value: reg<amdgpu.sgpr>):
  %48 = v_mov_b32_copy %value
  %49 = v_lshlrev_b32_src0_inline %capture_lane, 2
  global_store_b32_saddr %49, %48, %captured
  return
}

