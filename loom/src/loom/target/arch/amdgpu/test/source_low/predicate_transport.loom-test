  low.br ^loop(%begin: reg<amdgpu.sgpr>, %41: reg<amdgpu.sgpr>, %44: reg<amdgpu.sgpr>, %47: reg<amdgpu.sgpr>)
^loop(%iteration: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr>, %middle: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr>):
  %again = s_cmp_lt_i32 %iteration, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
