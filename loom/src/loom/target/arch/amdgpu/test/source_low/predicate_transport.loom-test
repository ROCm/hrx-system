// RUN: pass source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// One durable predicate may feed many selections without changing its scalar
// placement.
kernel.def target(@target) @shared_uniform_condition_select_chain() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%condition: i1, %lhs: i32, %rhs: i32, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi32>
  %selected0 = scf.select %condition, %lhs, %rhs : i32
  %selected1 = scf.select %condition, %selected0, %rhs : i32
  %selected2 = scf.select %condition, %selected1, %rhs : i32
  %selected3 = scf.select %condition, %selected2, %rhs : i32
  %selected4 = scf.select %condition, %selected3, %rhs : i32
  %selected5 = scf.select %condition, %selected4, %rhs : i32
  %selected6 = scf.select %condition, %selected5, %rhs : i32
  %selected7 = scf.select %condition, %selected6, %rhs : i32
  view.store %selected7, %result_view_0[%fixture_lane] : i32, view<64xi32>
  kernel.return
}

