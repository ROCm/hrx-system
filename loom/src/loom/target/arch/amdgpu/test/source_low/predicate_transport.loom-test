amdgpu.target<gfx11-generic> @target

// Several predicates survive the loop comparison and rotate independently.
kernel.def target(@target) @rotating_predicates() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs: i32, %rhs: i32, %limit: i32, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi32>
  %begin = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %first = scalar.cmpi slt, %lhs, %rhs : i32
  %second = scalar.cmpi sgt, %lhs, %rhs : i32
  cfg.cond_br %first, ^prepare, ^empty
^prepare:
  cfg.br ^loop(%begin: i32, %first: i1, %second: i1)
^loop(%iteration: i32, %head: i1, %tail: i1):
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %step : i32
  cfg.br ^loop(%next: i32, %tail: i1, %head: i1)
^exit:
  %selected = scf.select %head, %lhs, %rhs : i32
  %result = scf.select %tail, %selected, %limit : i32
  cfg.br ^done(%result: i32)
^empty:
  cfg.br ^done(%begin: i32)
^done(%value: i32):
  view.store %value, %captured[%capture_lane] : i32, view<64xi32>
  kernel.return
}

