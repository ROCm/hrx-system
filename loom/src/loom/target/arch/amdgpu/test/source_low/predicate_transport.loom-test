^_bb10:
  s_mov_b64_exec %39
  low.br ^exit
^exit:
  %selected = v_cndmask_b32 %rhs, %lhs, %head$21
  %result = v_cndmask_b32 %limit, %selected, %tail$22
  low.br ^_bb7(%result: reg<amdgpu.vgpr>)
^_bb5:
  s_mov_b64_exec %32
  %34 = v_mov_b32 0
  low.br ^done(%34: reg<amdgpu.vgpr>)
^_bb7(%value$24: reg<amdgpu.vgpr>):
