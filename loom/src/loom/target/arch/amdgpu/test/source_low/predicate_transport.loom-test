  low.br ^loop(%next: reg<amdgpu.sgpr>, %middle: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr>)
^exit:
  %50 = s_cmp_lg_i32_src1_inline %head {rhs = 0}
  %a = s_cselect_b32 %lhs, %rhs, %50
  %52 = s_cmp_lg_i32_src1_inline %middle {rhs = 0}
  %b = s_cselect_b32 %a, %limit, %52
  %54 = s_cmp_lg_i32_src1_inline %tail {rhs = 0}
  %result = s_cselect_b32 %b, %begin, %54
  %56 = v_mov_b32_copy %result
  %57 = v_lshlrev_b32_src0_inline %capture_lane, 2
  global_store_b32_saddr %57, %56, %captured
