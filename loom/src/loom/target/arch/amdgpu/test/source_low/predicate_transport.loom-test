amdgpu.target<gfx11-generic> @target

// Lane predicates retain their full masks while scalar loop control clobbers SCC.
func.def target(@target) @rotating_lane_predicates(%values: vector<2xi32>, %limit: i32, %lhs: f32, %rhs: f32) -> (f32) {
  %begin = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %first = scalar.cmpi slt, %lane, %limit : i32
  %second = scalar.cmpi sgt, %lane, %limit : i32
  cfg.br ^loop(%begin: i32, %first: i1, %second: i1)
^loop(%iteration: i32, %head: i1, %tail: i1):
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %step : i32
  cfg.br ^loop(%next: i32, %tail: i1, %head: i1)
^exit:
  %selected = scf.select %head, %lhs, %rhs : f32
  %result = scf.select %tail, %selected, %rhs : f32
  func.return %result : f32
}

