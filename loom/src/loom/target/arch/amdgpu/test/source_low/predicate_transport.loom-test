  low.br ^loop(%iteration$25: reg<amdgpu.vgpr>, %head$26: reg<amdgpu.sgpr x2>, %tail$27: reg<amdgpu.sgpr x2>)
^loop(%iteration$20: reg<amdgpu.vgpr>, %head$21: reg<amdgpu.sgpr x2>, %tail$22: reg<amdgpu.sgpr x2>):
