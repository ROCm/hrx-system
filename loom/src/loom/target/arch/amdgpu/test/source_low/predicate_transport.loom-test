// A same-block comparison and constants enter durable loop arguments.
func.def target(@target) @rotating_predicate_constants(%lhs: i32, %rhs: i32, %limit: i32) -> (i32) {
  %begin = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %enabled = scalar.constant true : i1
  %disabled = scalar.constant false : i1
  %compared = scalar.cmpi slt, %lhs, %rhs : i32
  cfg.br ^loop(%begin: i32, %enabled: i1, %disabled: i1, %compared: i1)
^loop(%iteration: i32, %head: i1, %middle: i1, %tail: i1):
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %step : i32
  cfg.br ^loop(%next: i32, %middle: i1, %tail: i1, %head: i1)
^exit:
  %a = scf.select %head, %lhs, %rhs : i32
  %b = scf.select %middle, %a, %limit : i32
  %result = scf.select %tail, %b, %begin : i32
  func.return %result : i32
}

