func.def @subtract_f16_2(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %byte_offset = index.constant 0 : offset
  %left = buffer.view %lhs[%byte_offset] : buffer -> view<2xf16>
  %right = buffer.view %rhs[%byte_offset] : buffer -> view<2xf16>
  %result = buffer.view %output[%byte_offset] : buffer -> view<2xf16>
  %a = vector.load %left[0] : view<2xf16> -> vector<2xf16>
  %b = vector.load %right[0] : view<2xf16> -> vector<2xf16>
  %difference = vector.subf %a, %b : vector<2xf16>
  vector.store %difference, %result[0] : vector<2xf16>, view<2xf16>
  func.return
}

