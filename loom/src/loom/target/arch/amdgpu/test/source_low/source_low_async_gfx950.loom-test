low.kernel.def target<amdgpu.cdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @async_gather_dword() asm {
  %global = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %14 = storage {byte_alignment = 16, byte_length = 256} : low.storage<workgroup>
  %16 = v_mov_b32 0
  %17 = s_mov_b32_m0_imm 0
  global_load_lds_dword_saddr %16, %global, %17
  s_waitcnt {vmcnt = 0}
  return
}

