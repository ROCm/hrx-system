  %copy1b = kernel.async.gather %source to %dest1b {cache_scope = device, cache_temporal = regular} : view<1x1x16xi8> to view<1x64x1x16xi8> -> kernel.async.token
  %load1 = kernel.async.group %copy1a, %copy1b : kernel.async.token, kernel.async.token -> kernel.async.group
  kernel.async.wait %load0 {newer_groups = 1} : kernel.async.group
  kernel.async.wait %load1 {newer_groups = 0} : kernel.async.group
