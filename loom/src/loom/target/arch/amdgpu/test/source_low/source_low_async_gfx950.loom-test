  %global = buffer.assume.memory_space<global> %input : buffer
  %source_base = buffer.view %global[%buffer_base] : buffer -> view<64x1x16xi8>
  %source = view.subview %source_base[%tid, 0, 0] : view<64x1x16xi8> -> view<1x1x16xi8>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dest_base = buffer.view %scratch[%buffer_base] : buffer -> view<3x64x1x16xi8>
  %dest0 = view.subview %dest_base[0, 0, 0, 0] : view<3x64x1x16xi8> -> view<1x64x1x16xi8>
  %dest1a = view.subview %dest_base[1, 0, 0, 0] : view<3x64x1x16xi8> -> view<1x64x1x16xi8>
  %dest1b = view.subview %dest_base[2, 0, 0, 0] : view<3x64x1x16xi8> -> view<1x64x1x16xi8>
  %copy0 = kernel.async.gather %source to %dest0 {cache_scope = device, cache_temporal = regular} : view<1x1x16xi8> to view<1x64x1x16xi8> -> kernel.async.token
