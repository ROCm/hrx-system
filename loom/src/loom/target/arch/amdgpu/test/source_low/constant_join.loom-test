// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// A divergent data selection also carries an equal constant from both arms.
// Only the varying payload needs a masked merge.
kernel.def target(@target) @constant_join() {
  %workgroup_count = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%workgroup_count, %workgroup_count, %workgroup_count) workgroup_size(%width, %workgroup_count, %workgroup_count) : index
} launch(%left: buffer, %right: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %left_values = buffer.view %left[%origin] : buffer -> view<64xi32>
  %right_values = buffer.view %right[%origin] : buffer -> view<64xi32>
  %output_values = buffer.view %output[%origin] : buffer -> view<128xi32>
  %lane = kernel.workitem.id<x> : index
  %half = index.constant 32 : index
  %choose = index.cmp ult, %lane, %half : index
  cfg.cond_br %choose, ^left_arm, ^right_arm
^left_arm:
  %left_value = view.load %left_values[%lane] : view<64xi32> -> i32
  %left_zero = scalar.constant 0 : i32
  cfg.br ^join(%left_value: i32, %left_zero: i32)
^right_arm:
  %right_value = view.load %right_values[%lane] : view<64xi32> -> i32
  %right_zero = scalar.constant 0 : i32
  cfg.br ^join(%right_value: i32, %right_zero: i32)
^join(%value: i32, %zero: i32):
  %packet = vector.from_elements %value, %zero : vector<2xi32>
  %packet_width = index.constant 2 : index
  %position = index.mul %lane, %packet_width : index
  vector.store %packet, %output_values[%position] : vector<2xi32>, view<128xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @constant_join() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %left_values = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %right_values = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_values = resource<hal_binding> {extent = 512, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %31 = s_mov_b32 0
  %choose = v_cmp_lt_u32_src1_inline %lane {rhs = 32}
  %33, %34 = s_and_saveexec_b64 %choose
  low.cond_br %34, ^left_arm, ^_bb5 : reg<amdgpu.scc>
^left_arm:
  %38 = v_lshlrev_b32_src0_inline %lane, 2
  %left_value = global_load_b32_saddr %38, %left_values
  low.br ^_bb4(%left_value: reg<amdgpu.vgpr>)
^_bb4(%value$25: reg<amdgpu.vgpr>):
  %37 = s_andn2_b64_exec %33, %choose
  low.cond_br %37, ^right_arm, ^_bb6 : reg<amdgpu.scc>
^right_arm:
  %40 = v_lshlrev_b32_src0_inline %lane, 2
  %right_value = global_load_b32_saddr %40, %right_values
  s_mov_b64_exec %33
  %36 = v_cndmask_b32 %right_value, %value$25, %choose
  low.br ^join(%36: reg<amdgpu.vgpr>)
^join(%value$24: reg<amdgpu.vgpr>):
  %42 = v_mov_b32_copy %31
  %packet = concat(%value$24, %42) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %44 = v_lshlrev_b32_src0_inline %lane, 3
  global_store_b64_saddr %44, %packet, %output_values
  return
^_bb5:
  s_mov_b64_exec %33
  %35 = v_mov_b32 0
  low.br ^_bb4(%35: reg<amdgpu.vgpr>)
^_bb6:
  s_mov_b64_exec %33
  low.br ^join(%value$25: reg<amdgpu.vgpr>)
}
