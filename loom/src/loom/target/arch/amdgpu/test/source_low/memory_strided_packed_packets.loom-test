  %12 = v_mov_b32 0
  %13 = global_load_u8_saddr %12, %view
  %15 = global_load_u8_saddr %12, %view {offset = 4}
  %16 = v_lshlrev_b32_src0_inline %15, 8
  %17 = v_or_b32 %13, %16
  %19 = global_load_u8_saddr %12, %view {offset = 8}
  %20 = v_lshlrev_b32_src0_inline %19, 16
  %21 = v_or_b32 %17, %20
  %23 = global_load_u8_saddr %12, %view {offset = 12}
  %24 = v_lshlrev_b32_src0_inline %23, 24
