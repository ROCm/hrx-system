// RUN: emit amdgpu-wait-counter-plan-json @loop_carried_lds_fragments_retain_younger_reads strategy=source

amdgpu.target<gfx1100> @target {subgroup_size = 32}

low.func.def target<amdgpu.rdna3.core>(@target) @loop_carried_lds_fragments_retain_younger_reads(%address: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr x8>, %initial_acc: reg<amdgpu.vgpr x8>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr x8>) asm {
  %seed0_low = ds_read_b128 %address
  %seed0_high = ds_read_b128 %address {offset = 16}
  %seed0 = concat(%seed0_low, %seed0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %seed1_low = ds_read_b128 %address {offset = 32}
  %seed1_high = ds_read_b128 %address {offset = 48}
  %seed1 = concat(%seed1_low, %seed1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %seed2_low = ds_read_b128 %address {offset = 64}
  %seed2_high = ds_read_b128 %address {offset = 80}
  %seed2 = concat(%seed2_low, %seed2_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  low.br ^loop(%seed0: reg<amdgpu.vgpr x8>, %seed1: reg<amdgpu.vgpr x8>, %seed2: reg<amdgpu.vgpr x8>, %initial_acc: reg<amdgpu.vgpr x8>)
^loop(%carried0: reg<amdgpu.vgpr x8>, %carried1: reg<amdgpu.vgpr x8>, %carried2: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>):
  %used0 = v_wmma_f32_16x16x16_f16 %carried0, %rhs, %acc
  %used1 = v_wmma_f32_16x16x16_f16 %carried1, %rhs, %used0
  %used2 = v_wmma_f32_16x16x16_f16 %carried2, %rhs, %used1
  %next0_low = ds_read_b128 %address {offset = 96}
  %next0_high = ds_read_b128 %address {offset = 112}
  %next0 = concat(%next0_low, %next0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %next1_low = ds_read_b128 %address {offset = 128}
  %next1_high = ds_read_b128 %address {offset = 144}
  %next1 = concat(%next1_low, %next1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %next2_low = ds_read_b128 %address {offset = 160}
  %next2_high = ds_read_b128 %address {offset = 176}
  %next2 = concat(%next2_low, %next2_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next0: reg<amdgpu.vgpr x8>, %next1: reg<amdgpu.vgpr x8>, %next2: reg<amdgpu.vgpr x8>, %used2: reg<amdgpu.vgpr x8>)
^exit:
  return %used2
}

// The six trailing reads are the stable incoming LDS epoch on each trip
// through the loop. Consumers wait for their two-read fragments while
// retaining the younger fragments at counts four and two.

