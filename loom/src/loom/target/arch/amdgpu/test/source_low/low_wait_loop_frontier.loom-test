// ====
// RUN: emit amdgpu-wait-counter-plan-json @loop_entry_lds_wait_retains_younger_reads strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @loop_entry_lds_wait_retains_younger_reads(%address: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  %invariant = ds_read_b32 %address
  %younger0 = ds_read_b32 %address {offset = 4}
  %younger1 = ds_read_b32 %address {offset = 8}
  low.br ^loop(%initial: reg<amdgpu.vgpr>)
^loop(%acc: reg<amdgpu.vgpr>):
  %next = v_add_f32 %invariant, %acc
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next: reg<amdgpu.vgpr>)
^exit:
  %younger = v_add_f32 %younger0, %younger1
  %result = v_add_f32 %next, %younger
  return %result
}

// The invariant producer is the oldest of three entry reads. Relocation to the
// preheader must wait only for that producer and retain the two younger reads.

// ----
