// RUN: emit amdgpu-wait-counter-plan-json @multiblock_loop_carried_lds_wait_is_conservative strategy=source

amdgpu.target<gfx1100> @target {subgroup_size = 32}

low.func.def target<amdgpu.rdna3.core>(@target) @multiblock_loop_carried_lds_wait_is_conservative(%address: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr x8>, %initial_acc: reg<amdgpu.vgpr x8>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr x8>) asm {
  %seed_low = ds_read_b128 %address
  %seed_high = ds_read_b128 %address {offset = 16}
  %seed = concat(%seed_low, %seed_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  low.br ^loop(%seed: reg<amdgpu.vgpr x8>, %initial_acc: reg<amdgpu.vgpr x8>)
^loop(%carried: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>):
  %used = v_wmma_f32_16x16x16_f16 %carried, %rhs, %acc
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  %next_low = ds_read_b128 %address {offset = 32}
  %next_high = ds_read_b128 %address {offset = 48}
  %next = concat(%next_low, %next_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  low.br ^loop(%next: reg<amdgpu.vgpr x8>, %used: reg<amdgpu.vgpr x8>)
^exit:
  return %used
}

// The producer epoch lives in a distinct loop block. The single-block frontier
// proof must refuse it and retain a conservative full wait with clear
// provenance.

// ----
