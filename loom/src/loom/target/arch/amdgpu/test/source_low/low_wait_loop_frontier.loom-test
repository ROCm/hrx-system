// ====
// RUN: emit amdgpu-assembly @trailing_reset_satisfies_loop_carried_use_assembly strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @trailing_reset_satisfies_loop_carried_use_assembly(%address: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  %seed = ds_read_b32 %address
  low.br ^loop(%seed: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>):
  %used = v_add_u32 %carried, %rhs
  %next = ds_read_b32 %address {offset = 4}
  s_waitcnt {lgkmcnt = 0}
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next: reg<amdgpu.vgpr>)
^exit:
  return %used
}

