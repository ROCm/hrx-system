  ds_read_b32 v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
.Lbb1:
  v_add_u32 v2, v2, v1
  ds_read_b32 v3, v0 offset:4
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  v_mov_b32 v2, v3
  s_branch .Lbb1
.Lbb3:
  s_endpgm

// ====
// RUN: emit amdgpu-wait-counter-plan-json @uncovered_trailing_producer_is_conservative strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @uncovered_trailing_producer_is_conservative(%address: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  %seed = ds_read_b32 %address
  low.br ^loop(%seed: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>):
  %used = v_add_u32 %carried, %rhs
  %next = ds_read_b32 %address {offset = 4}
  %younger = ds_read_b32 %address {offset = 8}
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next: reg<amdgpu.vgpr>)
^exit:
  %result = v_add_u32 %used, %younger
  return %result
}

// The younger read is neither consumed on the backedge nor reset before it.
// That epoch has no proven fixed point, so the loop use remains a conservative
// full drain instead of borrowing a target count from an unstable count.

// ----
