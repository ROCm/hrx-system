// ====
// RUN: emit amdgpu-wait-counter-plan-json @loop_entry_smem_wait_remains_conservative strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @loop_entry_smem_wait_remains_conservative(%base: reg<amdgpu.sgpr x2>, %initial: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  %invariant = s_load_dword %base, %zero
  %younger0 = s_load_dword %base, %zero {offset = 4}
  %younger1 = s_load_dword %base, %zero {offset = 8}
  low.br ^loop(%initial: reg<amdgpu.sgpr>, %zero: reg<amdgpu.sgpr>)
^loop(%acc: reg<amdgpu.sgpr>, %i: reg<amdgpu.sgpr>):
  %next = s_add_u32 %invariant, %acc
  %one = s_mov_b32 1
  %next_i = s_add_u32 %i, %one
  %again = s_cmp_lt_i32 %next_i, %limit
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next: reg<amdgpu.sgpr>, %next_i: reg<amdgpu.sgpr>)
^exit:
  %younger = s_add_u32 %younger0, %younger1
  %result = s_add_u32 %next, %younger
  return %result
}

// SMEM data may complete out of issue order, so the entry dependency must keep
// an explicit conservative provenance and drain the full scalar-memory epoch.

// ----
