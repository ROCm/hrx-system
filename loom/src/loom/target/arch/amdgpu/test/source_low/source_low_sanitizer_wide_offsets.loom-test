low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @sanitizer_wide_dynamic_offset(%byte_offset: reg<amdgpu.sgpr x2>) asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %6 = s_mov_b64_symbol {symbol = @iree_asan_config}
  %7 = s_load_dwordx2_offset_only %6 {offset = 16}
  %8 = v_mov_b32 0
  %9 = v_mov_b32 128
  %10 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = slice %byte_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = slice %byte_offset[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14, %15 = s_add_co_u32 %10, %12
  %16, %17 = s_addc_u32 %11, %13, %15
  %21 = v_mov_b32_copy %14
  %22 = v_mov_b32_copy %16
  %24 = slice %7[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = v_mov_b32_copy %24
  %26 = slice %7[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = v_mov_b32_copy %26
  %31 = v_lshrrev_b32_lit %21, 3
  %32 = v_lshlrev_b32_lit %22, 29
  %33 = v_or_b32 %31, %32
  %34 = v_lshrrev_b32_lit %22, 3
  %40, %41 = v_add_co_u32 %25, %33
  %42, %43 = v_add_co_ci_u32 %27, %34, %41
  %44 = concat(%40, %42) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %45 = flat_load_u8 %44 {glc = 1}
  s_waitcnt {vmcnt = 0}
  %47 = v_and_b32_lit %21, 7
  %48 = v_add_u32_lit %47, 3
  %49 = v_cmp_ne_i32 %45, %8
  %50 = v_cmp_ge_u32 %45, %9
  %51 = v_cmp_ge_u32 %48, %45
  %52 = s_and_b64 %49, %51
  %53 = s_or_b64 %50, %52
  %54 = v_mov_b32 3
  %61, %62 = v_add_co_u32 %21, %54
  %63, %64 = v_add_co_ci_u32 %22, %8, %62
  %73 = v_lshrrev_b32_lit %61, 3
  %74 = v_lshlrev_b32_lit %63, 29
  %75 = v_or_b32 %73, %74
  %76 = v_lshrrev_b32_lit %63, 3
  %82, %83 = v_add_co_u32 %25, %75
  %84, %85 = v_add_co_ci_u32 %27, %76, %83
  %86 = concat(%82, %84) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %87 = flat_load_u8 %86 {glc = 1}
  s_waitcnt {vmcnt = 0}
  %89 = v_and_b32_lit %61, 7
  %90 = v_cmp_ne_i32 %87, %8
  %91 = v_cmp_ge_u32 %87, %9
  %92 = v_cmp_ge_u32 %89, %87
  %93 = s_and_b64 %90, %92
  %94 = s_or_b64 %91, %93
  %95 = s_or_b64 %53, %94
  %96 = slice %95[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %97 = s_mov_b32 0
  %98 = concat(%96, %97) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %107 = concat(%97, %97) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %108 = s_cmp_lg_u64 %98, %107
  low.cond_br %108, ^_bb2, ^_bb1 : reg<amdgpu.scc>
^_bb1:
  return
^_bb2:
  %109, %110 = s_and_saveexec_b64 %98
  s_trap {trapid = 2}
  %99 = s_sendmsg_rtn_b32 {message = 128}
  %100 = s_mov_b32 1023
  %101 = s_and_b32 %99, %100
  %102 = s_mov_b32 1024
  %103 = s_or_b32 %101, %102
  %104 = s_mov_b32_m0 %103
  s_sendmsg %104 {message = 1}
  low.br ^_bb3
^_bb3:
  s_sethalt {reason = 5}
  low.br ^_bb3
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @sanitizer_wide_static_offset(%input: buffer) {
  %byte_offset = index.constant 4294967296 : offset
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %input_view = buffer.view %input_global[%byte_offset] : buffer -> view<1xi32>
  sanitizer.assert.access<read> %input_view[0] : view<1xi32>
  func.return
}

