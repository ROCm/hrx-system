// RUN: emit source-low output=low sanitizer=access sanitizer-reporting=trap

amdgpu.target<gfx11-generic> @target

func.def target(@target) @sanitizer_wide_dynamic_offset(%input: buffer, %byte_offset: offset) {
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %input_view = buffer.view %input_global[%byte_offset] : buffer -> view<1xi32>
  sanitizer.assert.access<read> %input_view[0] : view<1xi32>
  func.return
}

