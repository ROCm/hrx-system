  %17, %18 = v_add_co_ci_u32 %16, %11, %15
  %20 = slice %7[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = v_mov_b32_copy %20
  %22 = slice %7[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %27 = v_lshrrev_b32_lit %14, 3
  %28 = v_lshlrev_b32_lit %17, 29
  %29 = v_or_b32 %27, %28
  %30 = v_lshrrev_b32_lit %17, 3
  %36, %37 = v_add_co_u32 %21, %29
  %38, %39 = v_add_co_ci_u32 %23, %30, %37
  %40 = concat(%36, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %41 = flat_load_u8 %40 {glc = 1}
  s_waitcnt {vmcnt = 0}
  %43 = v_and_b32_lit %14, 7
  %44 = v_add_u32_lit %43, 3
  %45 = v_cmp_ne_i32 %41, %8
  %46 = v_cmp_ge_u32 %41, %9
  %47 = v_cmp_ge_u32 %44, %41
  %48 = s_and_b64 %45, %47
  %49 = s_or_b64 %46, %48
  %50 = v_mov_b32 3
  %57, %58 = v_add_co_u32 %14, %50
  %59, %60 = v_add_co_ci_u32 %17, %8, %58
  %69 = v_lshrrev_b32_lit %57, 3
  %70 = v_lshlrev_b32_lit %59, 29
  %71 = v_or_b32 %69, %70
  %72 = v_lshrrev_b32_lit %59, 3
  %78, %79 = v_add_co_u32 %21, %71
  %80, %81 = v_add_co_ci_u32 %23, %72, %79
  %82 = concat(%78, %80) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %83 = flat_load_u8 %82 {glc = 1}
  s_waitcnt {vmcnt = 0}
  %85 = v_and_b32_lit %57, 7
  %86 = v_cmp_ne_i32 %83, %8
  %87 = v_cmp_ge_u32 %83, %9
  %88 = v_cmp_ge_u32 %85, %83
  %89 = s_and_b64 %86, %88
  %90 = s_or_b64 %87, %89
  %91 = s_or_b64 %49, %90
  %92 = slice %91[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %93 = s_mov_b32 0
  %94 = concat(%92, %93) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %103 = concat(%93, %93) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %104 = s_cmp_lg_u64 %94, %103
  low.cond_br %104, ^_bb2, ^_bb1 : reg<amdgpu.scc>
^_bb1:
  return
^_bb2:
  %105, %106 = s_and_saveexec_b64 %94
  s_trap {trapid = 2}
  %95 = s_sendmsg_rtn_b32 {message = 128}
  %96 = s_mov_b32 1023
  %97 = s_and_b32 %95, %96
  %98 = s_mov_b32 1024
  %99 = s_or_b32 %97, %98
