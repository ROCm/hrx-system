low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @sanitizer_wide_dynamic_offset(%byte_offset: reg<amdgpu.vgpr x2>) asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %6 = s_mov_b64_symbol {symbol = @iree_asan_config}
  %7 = s_load_dwordx2_offset_only %6 {offset = 16}
  %8 = v_mov_b32 0
  %9 = v_mov_b32 128
  %10 = slice %byte_offset[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
