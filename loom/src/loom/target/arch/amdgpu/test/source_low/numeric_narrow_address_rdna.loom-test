// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @signed_narrow_coordinates(%byte: i8, %halfword: i16) -> (index, index) {
  %byte_coordinate = index.cast %byte : i8 to index
  %halfword_coordinate = index.cast %halfword : i16 to index
  func.return %byte_coordinate, %halfword_coordinate : index, index
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @signed_narrow_coordinates(%byte: reg<amdgpu.vgpr>, %halfword: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %byte_coordinate = v_bfe_i32_offset_width_inline %byte {offset = 0, width = 8}
  %halfword_coordinate = v_bfe_i32_offset_width_inline %halfword {offset = 0, width = 16}
  return %byte_coordinate, %halfword_coordinate
}

// ====

func.def @unsigned_narrow_offsets(%byte: i8, %halfword: i16) -> (offset, offset) {
  %byte_offset = index.cast %byte : i8 to offset
  %halfword_offset = index.cast %halfword : i16 to offset
  func.return %byte_offset, %halfword_offset : offset, offset
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @unsigned_narrow_offsets(%byte: reg<amdgpu.vgpr>, %halfword: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %byte_offset = v_and_b32_lit %byte, 255
  %halfword_offset = v_and_b32_lit %halfword, 65535
  return %byte_offset, %halfword_offset
}

// ====

func.def @normalize_truncated_narrow_addresses(%input: i32) -> (index, offset, index, offset) {
  %byte = scalar.trunci %input : i32 to i8
  %halfword = scalar.trunci %input : i32 to i16
  %byte_coordinate = index.cast %byte : i8 to index
  %byte_offset = index.cast %byte : i8 to offset
  %halfword_coordinate = index.cast %halfword : i16 to index
  %halfword_offset = index.cast %halfword : i16 to offset
  func.return %byte_coordinate, %byte_offset, %halfword_coordinate, %halfword_offset : index, offset, index, offset
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @normalize_truncated_narrow_addresses(%halfword: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %byte_coordinate = v_bfe_i32_offset_width_inline %halfword {offset = 0, width = 8}
  %byte_offset = v_and_b32_lit %halfword, 255
  %halfword_coordinate = v_bfe_i32_offset_width_inline %halfword {offset = 0, width = 16}
  %halfword_offset = v_and_b32_lit %halfword, 65535
  return %byte_coordinate, %byte_offset, %halfword_coordinate, %halfword_offset
}

// ====

func.def @narrow_coordinate_payloads(%coordinate: index) -> (i8, i16, i1) {
  %byte = index.cast %coordinate : index to i8
  %halfword = index.cast %coordinate : index to i16
  %low_bit = index.cast %coordinate : index to i1
  func.return %byte, %halfword, %low_bit : i8, i16, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @narrow_coordinate_payloads(%coordinate: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %byte = v_bfe_i32_offset_width_inline %coordinate {offset = 0, width = 8}
  %halfword = v_bfe_i32_offset_width_inline %coordinate {offset = 0, width = 16}
  %16 = v_and_b32_src0_inline %coordinate, 1
  %17 = v_mov_b32 1
  %low_bit = v_cmp_eq_i32 %16, %17
  return %byte, %halfword, %low_bit
}

// ====

func.def @narrow_offset_payloads(%byte_offset: offset) -> (i8, i16, i1) {
  %byte = index.cast %byte_offset : offset to i8
  %halfword = index.cast %byte_offset : offset to i16
  %low_bit = index.cast %byte_offset : offset to i1
  func.return %byte, %halfword, %low_bit : i8, i16, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @narrow_offset_payloads(%byte_offset: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %11 = slice %byte_offset[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %byte = v_bfe_i32_offset_width_inline %11 {offset = 0, width = 8}
  %halfword = v_bfe_i32_offset_width_inline %11 {offset = 0, width = 16}
  %16 = v_and_b32_src0_inline %11, 1
  %17 = v_mov_b32 1
  %low_bit = v_cmp_eq_i32 %16, %17
  return %byte, %halfword, %low_bit
}

// ====

kernel.def @uniform_predicate_casts() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: i32, %result_buffer_0: buffer, %result_buffer_1: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xi64>
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %input, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %byte_offset = index.cast %negative : i1 to offset
  %result_storage_0 = index.cast %coordinate : index to i64
  view.store %result_storage_0, %result_view_0[%fixture_lane] : i64, view<64xi64>
  %result_storage_1 = index.cast %byte_offset : offset to i64
  view.store %result_storage_1, %result_view_1[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "input"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_predicate_casts(%input: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %sign_boundary = s_mov_b32 0
  %negative = s_cmp_lt_i32 %input, %sign_boundary
  %22 = s_mov_b32 1
  %coordinate = s_cselect_b32 %22, %sign_boundary, %negative
  %30 = v_mov_b32_copy %coordinate
  %32 = v_mov_b32_copy %sign_boundary
  %33 = concat(%30, %32) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %34 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %34, %33, %result_view_0
  %41 = concat(%30, %32) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %34, %41, %result_view_1
  return
}

