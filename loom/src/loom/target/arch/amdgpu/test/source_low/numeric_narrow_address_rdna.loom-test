// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @signed_narrow_coordinates(%byte: i8, %halfword: i16) -> (index, index) {
  %byte_coordinate = index.cast %byte : i8 to index
  %halfword_coordinate = index.cast %halfword : i16 to index
  func.return %byte_coordinate, %halfword_coordinate : index, index
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @signed_narrow_coordinates(%byte: reg<amdgpu.vgpr>, %halfword: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %byte_coordinate = v_bfe_i32_offset_width_inline %byte {offset = 0, width = 8}
  %halfword_coordinate = v_bfe_i32_offset_width_inline %halfword {offset = 0, width = 16}
  return %byte_coordinate, %halfword_coordinate
}

// ====

func.def @unsigned_narrow_offsets(%byte: i8, %halfword: i16) -> (offset, offset) {
  %byte_offset = index.cast %byte : i8 to offset
  %halfword_offset = index.cast %halfword : i16 to offset
  func.return %byte_offset, %halfword_offset : offset, offset
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @unsigned_narrow_offsets(%byte: reg<amdgpu.vgpr>, %halfword: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %byte_offset = v_and_b32_lit %byte, 255
  %halfword_offset = v_and_b32_lit %halfword, 65535
  return %byte_offset, %halfword_offset
}

// ====

func.def @normalize_truncated_narrow_addresses(%input: i32) -> (index, offset, index, offset) {
  %byte = scalar.trunci %input : i32 to i8
  %halfword = scalar.trunci %input : i32 to i16
  %byte_coordinate = index.cast %byte : i8 to index
  %byte_offset = index.cast %byte : i8 to offset
  %halfword_coordinate = index.cast %halfword : i16 to index
  %halfword_offset = index.cast %halfword : i16 to offset
  func.return %byte_coordinate, %byte_offset, %halfword_coordinate, %halfword_offset : index, offset, index, offset
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @normalize_truncated_narrow_addresses(%halfword: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %16 = v_mov_b32_copy %halfword
  %byte_coordinate = v_bfe_i32_offset_width_inline %16 {offset = 0, width = 8}
  %byte_offset = v_and_b32_lit %16, 255
  %halfword_coordinate = v_bfe_i32_offset_width_inline %16 {offset = 0, width = 16}
  %halfword_offset = v_and_b32_lit %16, 65535
  return %byte_coordinate, %byte_offset, %halfword_coordinate, %halfword_offset
}

// ====

func.def @narrow_coordinate_payloads(%coordinate: index) -> (i8, i16, i1) {
  %byte = index.cast %coordinate : index to i8
  %halfword = index.cast %coordinate : index to i16
  %low_bit = index.cast %coordinate : index to i1
  func.return %byte, %halfword, %low_bit : i8, i16, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @narrow_coordinate_payloads(%coordinate: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.scc>) asm {
  %12 = v_mov_b32_copy %coordinate
  %byte = v_bfe_i32_offset_width_inline %12 {offset = 0, width = 8}
  %halfword = v_bfe_i32_offset_width_inline %12 {offset = 0, width = 16}
  %17 = s_and_b32_rhs_inline %coordinate, 1
  %18 = s_mov_b32 1
  %low_bit = s_cmp_eq_i32 %17, %18
  return %byte, %halfword, %low_bit
}

// ====

func.def @narrow_offset_payloads(%byte_offset: offset) -> (i8, i16, i1) {
  %byte = index.cast %byte_offset : offset to i8
  %halfword = index.cast %byte_offset : offset to i16
  %low_bit = index.cast %byte_offset : offset to i1
  func.return %byte, %halfword, %low_bit : i8, i16, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @narrow_offset_payloads(%byte_offset: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.scc>) asm {
  %11 = slice %byte_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = v_mov_b32_copy %11
  %byte = v_bfe_i32_offset_width_inline %12 {offset = 0, width = 8}
  %halfword = v_bfe_i32_offset_width_inline %12 {offset = 0, width = 16}
  %18 = s_and_b32_rhs_inline %11, 1
  %19 = s_mov_b32 1
  %low_bit = s_cmp_eq_i32 %18, %19
  return %byte, %halfword, %low_bit
}

// ====

func.def @uniform_predicate_casts(%input: i32) -> (index, offset) {
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %input, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %byte_offset = index.cast %negative : i1 to offset
  func.return %coordinate, %byte_offset : index, offset
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @uniform_predicate_casts(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %sign_boundary = s_mov_b32 0
  %negative = s_cmp_lt_i32 %input, %sign_boundary
  %13 = s_mov_b32 1
  %coordinate = s_cselect_b32 %13, %sign_boundary, %negative
  return %coordinate, %coordinate
}

// ====

func.def @varying_predicate_casts(%input: buffer) -> (index, offset, i1) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %raw, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %byte_offset = index.cast %negative : i1 to offset
  %raw_coordinate = index.cast %raw : i32 to index
  %low_bit = index.cast %raw_coordinate : index to i1
  func.return %coordinate, %byte_offset, %low_bit : index, offset, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @varying_predicate_casts() -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %17 = v_mov_b32 0
  %raw_coordinate = global_load_b32_saddr %17, %source
  %negative = v_cmp_lt_i32_src1_inline %raw_coordinate {rhs = 0}
  %21 = v_mov_b32 1
  %coordinate = v_cndmask_b32 %17, %21, %negative
  %27 = v_and_b32_src0_inline %raw_coordinate, 1
  %low_bit = v_cmp_eq_i32 %27, %21
  return %coordinate, %coordinate, %low_bit
}

// ====

kernel.def @uniform_narrow_memory_coordinates() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%byte: i8, %halfword: i16, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lookup = buffer.view %table[%base] : buffer -> view<65536xi32>
  %destination = buffer.view %output[%base] : buffer -> view<4xi32>
  %byte_coordinate = index.cast %byte : i8 to index
  %halfword_coordinate = index.cast %halfword : i16 to index
  %byte_bias = index.constant 128 : index
  %halfword_bias = index.constant 32768 : index
  %byte_position = index.add %byte_coordinate, %byte_bias : index
  %halfword_position = index.add %halfword_coordinate, %halfword_bias : index
  %byte_value = view.load %lookup[%byte_position] : view<65536xi32> -> i32
  %halfword_value = view.load %lookup[%halfword_position] : view<65536xi32> -> i32
  %byte_offset = index.cast %byte : i8 to offset
  %halfword_offset = index.cast %halfword : i16 to offset
  %unsigned_byte = index.cast %byte_offset : offset to i32
  %unsigned_halfword = index.cast %halfword_offset : offset to i32
  view.store %byte_value, %destination[0] : i32, view<4xi32>
  view.store %halfword_value, %destination[1] : i32, view<4xi32>
  view.store %unsigned_byte, %destination[2] : i32, view<4xi32>
  view.store %unsigned_halfword, %destination[3] : i32, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "byte", arg1 = "halfword"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_payload_sizes = [1, 2], direct_arg_sizes = [4, 4], parameter_count = 4, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_narrow_memory_coordinates(%byte: reg<amdgpu.sgpr>, %halfword: reg<amdgpu.sgpr>) asm {
  %lookup = resource<hal_binding> {extent = 262144, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %24 = s_bfe_i32_lit %byte, 524288
  %25 = s_ashr_i32_rhs_inline %24, 31
  %26 = concat(%24, %25) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %27 = s_mov_b32 2
  %28 = s_lshl_b64 %26, %27
  %29 = slice %lookup[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30 = slice %lookup[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = slice %28[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = slice %28[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33, %34 = s_add_co_u32 %29, %31
  %35, %36 = s_addc_u32 %30, %32, %34
  %40 = v_mov_b32_copy %33
  %41 = v_mov_b32_copy %35
  %42 = concat(%40, %41) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %byte_value = global_load_b32_vaddr %42 {offset = 512}
  %44 = s_mov_b32 131072
  %45 = s_mov_b32 0
  %51, %52 = s_add_co_u32 %29, %44
  %53, %54 = s_addc_u32 %30, %45, %52
  %56 = s_bfe_i32_lit %halfword, 1048576
  %57 = s_ashr_i32_rhs_inline %56, 31
  %58 = concat(%56, %57) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %60 = s_lshl_b64 %58, %27
  %63 = slice %60[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %64 = slice %60[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %65, %66 = s_add_co_u32 %51, %63
  %67, %68 = s_addc_u32 %53, %64, %66
  %72 = v_mov_b32_copy %65
  %73 = v_mov_b32_copy %67
  %74 = concat(%72, %73) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %halfword_value = global_load_b32_vaddr %74
  %76 = v_mov_b32_copy %byte
  %unsigned_byte = v_and_b32_lit %76, 255
  %78 = v_mov_b32_copy %halfword
  %unsigned_halfword = v_and_b32_lit %78, 65535
  %80 = v_mov_b32 0
  global_store_b32_saddr %80, %byte_value, %destination
  global_store_b32_saddr %80, %halfword_value, %destination {offset = 4}
  global_store_b32_saddr %80, %unsigned_byte, %destination {offset = 8}
  global_store_b32_saddr %80, %unsigned_halfword, %destination {offset = 12}
  return
}
