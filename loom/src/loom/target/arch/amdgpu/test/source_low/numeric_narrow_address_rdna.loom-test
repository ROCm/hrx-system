func.def @varying_predicate_casts(%input: buffer) -> (index, offset, i1) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %raw, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %byte_offset = index.cast %negative : i1 to offset
  %raw_coordinate = index.cast %raw : i32 to index
  %low_bit = index.cast %raw_coordinate : index to i1
  func.return %coordinate, %byte_offset, %low_bit : index, offset, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @varying_predicate_casts() -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %17 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %17
  %20 = v_mov_b32_copy %18
  %21 = concat(%19, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %raw_coordinate = global_load_b32_vaddr %21
  %negative = v_cmp_lt_i32_src1_inline %raw_coordinate {rhs = 0}
  %24 = v_mov_b32 0
  %25 = v_mov_b32 1
  %coordinate = v_cndmask_b32 %24, %25, %negative
  %31 = v_and_b32_src0_inline %raw_coordinate, 1
  %low_bit = v_cmp_eq_i32 %31, %25
  return %coordinate, %coordinate, %low_bit
}

