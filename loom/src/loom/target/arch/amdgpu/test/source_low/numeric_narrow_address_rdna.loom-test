low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "byte", arg1 = "halfword"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_payload_sizes = [1, 2], direct_arg_sizes = [4, 4], parameter_count = 4, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_narrow_memory_coordinates(%byte: reg<amdgpu.sgpr>, %halfword: reg<amdgpu.sgpr>) asm {
  %lookup = resource<hal_binding> {extent = 262144, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %24 = s_bfe_i32_lit %byte, 524288
  %25 = s_lshl_b32_rhs_inline %24, 2
  %26 = s_mov_b32 512
  %27 = s_add_u32 %25, %26
  %28 = slice %lookup[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = slice %lookup[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30 = s_mov_b32 0
  %31, %32 = s_add_co_u32 %28, %27
  %33, %34 = s_addc_u32 %29, %30, %32
  %35 = concat(%31, %33) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %byte_value = s_load_dword %35, %30
  %38 = s_bfe_i32_lit %halfword, 1048576
  %39 = s_lshl_b32_rhs_inline %38, 2
  %40 = s_mov_b32 131072
  %41 = s_add_u32 %39, %40
  %45, %46 = s_add_co_u32 %28, %41
  %47, %48 = s_addc_u32 %29, %30, %46
  %49 = concat(%45, %47) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %halfword_value = s_load_dword %49, %30
  %unsigned_byte = s_bfe_u32_lit %byte, 524288
  %unsigned_halfword = s_bfe_u32_lit %halfword, 1048576
  %54 = v_mov_b32_copy %byte_value
  %55 = v_mov_b32 0
  global_store_b32_saddr %55, %54, %destination
  %56 = v_mov_b32_copy %halfword_value
  global_store_b32_saddr %55, %56, %destination {offset = 4}
  %58 = v_mov_b32_copy %unsigned_byte
  global_store_b32_saddr %55, %58, %destination {offset = 8}
  %60 = v_mov_b32_copy %unsigned_halfword
  global_store_b32_saddr %55, %60, %destination {offset = 12}
  return
}
