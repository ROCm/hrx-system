// ====

amdgpu.target<gfx11-generic> @target

// The bypass reaches the result use without crossing the workitem-zero edge,
// so the reduction must publish its result for all workitems.
kernel.def target(@target) @workgroup_reduce_cfg_unguarded_bypass() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %flags: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %leader_index = index.constant 0 : index
  %c0 = scalar.constant 0 : i32
  %input_view = buffer.view %input[%start] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<1xf32>
  %flags_view = buffer.view %flags[%start] : buffer -> view<1xi32>
  %value = view.load %input_view[%tid] : view<64xf32> -> f32
  %sum = kernel.workgroup.reduce<addf> %value : f32
  %flag = view.load %flags_view[%leader_index] : view<1xi32> -> i32
  %condition = scalar.cmpi ne, %flag, %c0 : i32
  %is_leader = index.cmp eq, %tid, %leader_index : index
  scf.if %condition {
    scf.if %is_leader {
      view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
    }
  } else {
    view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
  }
  kernel.return
}

