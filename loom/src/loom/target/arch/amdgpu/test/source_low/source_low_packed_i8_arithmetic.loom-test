func.def @i8x5_shli_7(%values: vector<5xi8>) -> (vector<5xi8>) {
  %amount_scalar = scalar.constant 7 : i8
  %amount = vector.splat %amount_scalar : vector<5xi8>
  %result = vector.shli %values, %amount : vector<5xi8>
  func.return %result : vector<5xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x5_shli_7(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %7 = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %8 = v_lshlrev_b32_src0_inline %7, 7
  %9 = v_and_b32_lit %8, 2155905152
  %10 = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = v_lshlrev_b32_src0_inline %10, 7
  %12 = v_and_b32_lit %11, 2155905152
  %result = concat(%9, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

