// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @i8x4_addi_arguments(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (vector<4xi8>) {
  %sum = vector.addi %lhs, %rhs : vector<4xi8>
  func.return %sum : vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x4_addi_arguments(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %7 = v_and_b32_lit %lhs, 2139062143
  %8 = v_and_b32_lit %rhs, 2139062143
  %9 = v_add_u32 %7, %8
  %10 = v_xor_b32 %lhs, %rhs
  %11 = v_and_b32_lit %10, 2155905152
  %sum = v_xor_b32 %9, %11
  return %sum
}

// ====

func.def @i8x4_subi_arguments(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (vector<4xi8>) {
  %diff = vector.subi %lhs, %rhs : vector<4xi8>
  func.return %diff : vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x4_subi_arguments(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %7 = v_or_b32_lit %lhs, 2155905152
  %8 = v_and_b32_lit %rhs, 2139062143
  %9 = v_sub_nc_u32 %7, %8
  %10 = v_xor_b32 %lhs, %rhs
  %11 = v_xor_b32_lit %10, 2155905152
  %12 = v_and_b32_lit %11, 2155905152
  %diff = v_xor_b32 %9, %12
  return %diff
}

// ====

func.def @i8x4_select_addi(%lhs: i32, %rhs: i32, %true_value: vector<4xi8>, %false_value: vector<4xi8>, %bias: vector<4xi8>) -> (vector<4xi8>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  %mask = vector.splat %condition : vector<4xi1>
  %selected = vector.select %mask, %true_value, %false_value : vector<4xi8>
  %result = vector.addi %selected, %bias : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x4_select_addi(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %true_value: reg<amdgpu.vgpr>, %false_value: reg<amdgpu.vgpr>, %bias: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %condition = v_cmp_lt_i32 %lhs, %rhs
  %selected = v_cndmask_b32 %false_value, %true_value, %condition
  %19 = v_and_b32_lit %selected, 2139062143
  %20 = v_and_b32_lit %bias, 2139062143
  %21 = v_add_u32 %19, %20
  %22 = v_xor_b32 %selected, %bias
  %23 = v_and_b32_lit %22, 2155905152
  %result = v_xor_b32 %21, %23
  return %result
}

// ====

func.def @i8x4_cfg_arg_addi(%lhs: i32, %rhs: i32, %true_value: vector<4xi8>, %false_value: vector<4xi8>, %bias: vector<4xi8>) -> (vector<4xi8>) {
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  cfg.cond_br %condition, ^then, ^else
^then:
  cfg.br ^join(%true_value: vector<4xi8>)
^else:
  cfg.br ^join(%false_value: vector<4xi8>)
^join(%selected: vector<4xi8>):
  %result = vector.addi %selected, %bias : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x4_cfg_arg_addi(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %true_value: reg<amdgpu.vgpr>, %false_value: reg<amdgpu.vgpr>, %bias: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %condition = s_cmp_lt_i32 %lhs, %rhs
  low.cond_br %condition, ^then, ^else : reg<amdgpu.scc>
^then:
  low.br ^join(%true_value: reg<amdgpu.vgpr>)
^else:
  low.br ^join(%false_value: reg<amdgpu.vgpr>)
^join(%selected: reg<amdgpu.vgpr>):
  %17 = v_and_b32_lit %selected, 2139062143
  %18 = v_and_b32_lit %bias, 2139062143
  %19 = v_add_u32 %17, %18
  %20 = v_xor_b32 %selected, %bias
  %21 = v_and_b32_lit %20, 2155905152
  %result = v_xor_b32 %19, %21
  return %result
}

