// ====

func.def @i8x4_bounded_varying_shifts(%values: vector<4xi8>, %amounts: vector<4xi8>) -> (vector<4xi8>) {
  %mask_scalar = scalar.constant 7 : i8
  %mask = vector.splat %mask_scalar : vector<4xi8>
  %bounded = vector.andi %amounts, %mask : vector<4xi8>
  %result = vector.shrui %values, %bounded : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x4_bounded_varying_shifts(%values: reg<amdgpu.vgpr>, %amounts: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %mask = v_mov_b32 117901063
  %bounded = v_and_b32 %amounts, %mask
  %16 = v_and_b32_lit %values, 255
  %17 = v_and_b32_lit %16, 65535
  %18 = v_bfe_u32_offset_width_inline %values {offset = 8, width = 8}
  %19 = v_and_b32_lit %18, 65535
  %20 = v_lshl_add_u32_shift_imm %19, %17, 16
  %21 = v_bfe_u32_offset_width_inline %values {offset = 16, width = 8}
  %22 = v_and_b32_lit %21, 65535
  %23 = v_bfe_u32_offset_width_inline %values {offset = 24, width = 8}
  %24 = v_and_b32_lit %23, 65535
  %25 = v_lshl_add_u32_shift_imm %24, %22, 16
  %27 = v_and_b32_lit %bounded, 255
  %28 = v_and_b32_lit %27, 65535
  %29 = v_bfe_u32_offset_width_inline %bounded {offset = 8, width = 8}
  %30 = v_and_b32_lit %29, 65535
  %31 = v_lshl_add_u32_shift_imm %30, %28, 16
  %32 = v_bfe_u32_offset_width_inline %bounded {offset = 16, width = 8}
  %33 = v_and_b32_lit %32, 65535
  %34 = v_bfe_u32_offset_width_inline %bounded {offset = 24, width = 8}
  %35 = v_and_b32_lit %34, 65535
  %36 = v_lshl_add_u32_shift_imm %35, %33, 16
  %40 = v_pk_lshrrev_b16 %31, %20
  %43 = v_pk_lshrrev_b16 %36, %25
  %47 = v_lshrrev_b32_src0_inline %40, 16
  %50 = v_lshrrev_b32_src0_inline %43, 16
  %51 = v_perm_b32_src2_lit %40, %47, 4
  %52 = v_perm_b32_src2_lit %43, %50, 4
  %result = v_perm_b32_src2_lit %51, %52, 16778500
  return %result
}
