// ====

func.def @i8x4_bounded_varying_shifts(%values: vector<4xi8>, %amounts: vector<4xi8>) -> (vector<4xi8>) {
  %mask = vector.constant 7 : vector<4xi8>
  %bounded = vector.andi %amounts, %mask : vector<4xi8>
  %result = vector.shrui %values, %bounded : vector<4xi8>
  func.return %result : vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x4_bounded_varying_shifts(%values: reg<amdgpu.vgpr>, %amounts: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %mask = v_mov_b32 117901063
  %bounded = v_and_b32 %amounts, %mask
  %15 = v_and_b32_lit %values, 255
  %16 = v_and_b32_lit %15, 65535
  %17 = v_bfe_u32_offset_width_inline %values {offset = 8, width = 8}
  %18 = v_and_b32_lit %17, 65535
  %19 = v_lshl_add_u32_shift_imm %18, %16, 16
  %20 = v_bfe_u32_offset_width_inline %values {offset = 16, width = 8}
  %21 = v_and_b32_lit %20, 65535
  %22 = v_bfe_u32_offset_width_inline %values {offset = 24, width = 8}
  %23 = v_and_b32_lit %22, 65535
  %24 = v_lshl_add_u32_shift_imm %23, %21, 16
  %26 = v_and_b32_lit %bounded, 255
  %27 = v_and_b32_lit %26, 65535
  %28 = v_bfe_u32_offset_width_inline %bounded {offset = 8, width = 8}
  %29 = v_and_b32_lit %28, 65535
  %30 = v_lshl_add_u32_shift_imm %29, %27, 16
  %31 = v_bfe_u32_offset_width_inline %bounded {offset = 16, width = 8}
  %32 = v_and_b32_lit %31, 65535
  %33 = v_bfe_u32_offset_width_inline %bounded {offset = 24, width = 8}
  %34 = v_and_b32_lit %33, 65535
  %35 = v_lshl_add_u32_shift_imm %34, %32, 16
  %39 = v_pk_lshrrev_b16 %30, %19
  %42 = v_pk_lshrrev_b16 %35, %24
  %46 = v_lshrrev_b32_src0_inline %39, 16
  %49 = v_lshrrev_b32_src0_inline %42, 16
  %50 = v_perm_b32_src2_lit %39, %46, 4
  %51 = v_perm_b32_src2_lit %42, %49, 4
  %result = v_perm_b32_src2_lit %50, %51, 16778500
  return %result
}
