kernel.def @i32_scalarized() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xi32>
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  %lane0 = vector.extract %loaded[0] : vector<4xi32> -> i32
  %lane1 = vector.extract %loaded[1] : vector<4xi32> -> i32
  %mask = scalar.constant 255 : i32
  %masked = scalar.andi %lane0, %mask : i32
  %shift = scalar.constant 3 : i32
  %left = scalar.shli %masked, %shift : i32
  %logical = scalar.shrui %lane1, %shift : i32
  %tag = scalar.constant 240 : i32
  %tagged = scalar.ori %left, %tag : i32
  %invert = scalar.constant -1 : i32
  %mixed = scalar.xori %tagged, %invert : i32
  %lane2 = vector.extract %loaded[2] : vector<4xi32> -> i32
  %lane3 = vector.extract %loaded[3] : vector<4xi32> -> i32
  %result = vector.from_elements %mixed, %logical, %lane2, %lane3 : vector<4xi32>
  vector.store %result, %output_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @i32_scalarized() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 1024, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %31 = v_lshlrev_b32_src0_inline %lane, 4
  %loaded = global_load_b128_saddr %31, %input_view
  %lane0 = slice %loaded[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %lane1 = slice %loaded[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %masked = v_and_b32_lit %lane0, 255
  %left = v_lshlrev_b32_src0_inline %masked, 3
  %logical = v_lshrrev_b32_src0_inline %lane1, 3
  %tagged = v_or_b32_lit %left, 240
  %mixed = v_xor_b32_lit %tagged, 4294967295
  %lane2 = slice %loaded[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %lane3 = slice %loaded[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %result = concat(%mixed, %logical, %lane2, %lane3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %31, %result, %output_view
  return
}

// ====

func.def @i32_uniform_encoded_constants(%value: i32) -> (i32, i32, i32, i32, i32, i32) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c255 = scalar.constant 255 : i32
  %and_inline = scalar.andi %value, %c1 : i32
  %or_inline = scalar.ori %c2, %value : i32
  %xor_inline = scalar.xori %value, %c3 : i32
  %and_literal = scalar.andi %c255, %value : i32
  %or_literal = scalar.ori %value, %c255 : i32
  %xor_literal = scalar.xori %c255, %value : i32
  func.return %and_inline, %or_inline, %xor_inline, %and_literal, %or_literal, %xor_literal : i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i32_uniform_encoded_constants(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %and_inline = s_and_b32_rhs_inline %value, 1
  %or_inline = s_or_b32_rhs_inline %value, 2
  %xor_inline = s_xor_b32_rhs_inline %value, 3
  %and_literal = s_and_b32_lit %value, 255
  %or_literal = s_or_b32_lit %value, 255
  %xor_literal = s_xor_b32_lit %value, 255
  return %and_inline, %or_inline, %xor_inline, %and_literal, %or_literal, %xor_literal
}

// ====

kernel.def @i32_varying_encoded_constants() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x8xi32>
  %loaded = vector.load %input_view[%lane] : view<64xi32> -> vector<1xi32>
  %value = vector.extract %loaded[0] : vector<1xi32> -> i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c255 = scalar.constant 255 : i32
  %and_inline = scalar.andi %value, %c1 : i32
  %or_inline = scalar.ori %c2, %value : i32
  %xor_inline = scalar.xori %value, %c3 : i32
  %and_literal = scalar.andi %c255, %value : i32
  %or_literal = scalar.ori %value, %c255 : i32
  %xor_literal = scalar.xori %c255, %value : i32
  %low = vector.from_elements %and_inline, %or_inline, %xor_inline, %and_literal : vector<4xi32>
  %high = vector.from_elements %or_literal, %xor_literal, %value, %value : vector<4xi32>
  vector.store %low, %output_view[%lane, 0] : vector<4xi32>, view<64x8xi32>
  vector.store %high, %output_view[%lane, 4] : vector<4xi32>, view<64x8xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @i32_varying_encoded_constants() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 2048, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %31 = v_lshlrev_b32_src0_inline %lane, 2
  %value = global_load_b32_saddr %31, %input_view
  %and_inline = v_and_b32_src0_inline %value, 1
  %or_inline = v_or_b32_src0_inline %value, 2
  %xor_inline = v_xor_b32_src0_inline %value, 3
  %and_literal = v_and_b32_lit %value, 255
  %or_literal = v_or_b32_lit %value, 255
  %xor_literal = v_xor_b32_lit %value, 255
  %low = concat(%and_inline, %or_inline, %xor_inline, %and_literal) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %high = concat(%or_literal, %xor_literal, %value, %value) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %41 = v_lshlrev_b32_src0_inline %lane, 5
  global_store_b128_saddr %41, %low, %output_view
  global_store_b128_saddr %41, %high, %output_view {offset = 16}
  return
}
