// RUN: emit source-low target=amdgpu:gfx11-generic output=low

kernel.def @i32_bitwise() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = vector.load %input_view[%lane] : view<64xi32> -> vector<1xi32>
  %mask = vector.splati 15 : vector<1xi32>
  %masked = vector.andi %loaded, %mask : vector<1xi32>
  %tag = vector.splati 240 : vector<1xi32>
  %with_tag = vector.ori %masked, %tag : vector<1xi32>
  %result = vector.xori %with_tag, %loaded : vector<1xi32>
  vector.store %result, %output_view[%lane] : vector<1xi32>, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @i32_bitwise() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %17 = v_lshlrev_b32_src0_inline %lane, 2
  %loaded = global_load_b32_saddr %17, %input_view
  %masked = v_and_b32_lit %loaded, 15
  %with_tag = v_or_b32_lit %masked, 240
  %result = v_xor_b32 %with_tag, %loaded
  global_store_b32_saddr %17, %result, %output_view
  return
}

// ====

kernel.def @i32_shift() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = vector.load %input_view[%lane] : view<64xi32> -> vector<1xi32>
  %shift = vector.splati 3 : vector<1xi32>
  %left = vector.shli %loaded, %shift : vector<1xi32>
  %logical = vector.shrui %loaded, %shift : vector<1xi32>
  %arithmetic = vector.shrsi %loaded, %shift : vector<1xi32>
  %joined = vector.ori %left, %logical : vector<1xi32>
  %result = vector.xori %joined, %arithmetic : vector<1xi32>
  vector.store %result, %output_view[%lane] : vector<1xi32>, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @i32_shift() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = v_lshlrev_b32_src0_inline %lane, 2
  %loaded = global_load_b32_saddr %18, %input_view
  %left = v_lshlrev_b32_src0_inline %loaded, 3
  %logical = v_lshrrev_b32_src0_inline %loaded, 3
  %arithmetic = v_ashrrev_i32_src0_inline %loaded, 3
  %joined = v_or_b32 %left, %logical
  %result = v_xor_b32 %joined, %arithmetic
  global_store_b32_saddr %18, %result, %output_view
  return
}

