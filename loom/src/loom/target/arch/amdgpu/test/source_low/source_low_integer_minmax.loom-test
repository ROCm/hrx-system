low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 5, resource_count = 4, resource_offsets = [8, 16, 24, 32], resource_parameter_indices = [1, 2, 3, 4], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_constant_integer_extrema(%value: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_2 = resource<hal_binding> {extent = 256, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_3 = resource<hal_binding> {extent = 256, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %signed_minimum = s_min_i32_rhs_inline %value, 7
  %signed_maximum = s_max_i32_rhs_inline %value, 7
  %unsigned_minimum = s_min_u32_lit %value, 305419896
  %unsigned_maximum = s_max_u32_lit %value, 305419896
  %29 = v_mov_b32_copy %signed_minimum
  %30 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %30, %29, %result_view_0
  %31 = v_mov_b32_copy %signed_maximum
  global_store_b32_saddr %30, %31, %result_view_1
  %33 = v_mov_b32_copy %unsigned_minimum
  global_store_b32_saddr %30, %33, %result_view_2
  %35 = v_mov_b32_copy %unsigned_maximum
  global_store_b32_saddr %30, %35, %result_view_3
  return
}

// ====

// Varying values use the same direct forms with no temporary vector registers.
func.def @varying_constant_integer_extrema(%input: buffer, %position: index) -> (i32, i32, i32, i32) {
  %base = index.constant 0 : offset
  %bounded_position = index.assume %position [range(%position, 0, 31)] : index
  %values = buffer.view %input[%base] : buffer -> view<32xi32>
  %value = view.load %values[%bounded_position] : view<32xi32> -> i32
  %inline = scalar.constant 7 : i32
  %literal = scalar.constant 305419896 : i32
  %signed_minimum = scalar.minsi %value, %literal : i32
  %signed_maximum = scalar.maxsi %literal, %value : i32
  %unsigned_minimum = scalar.minui %value, %inline : i32
  %unsigned_maximum = scalar.maxui %inline, %value : i32
  func.return %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum : i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @varying_constant_integer_extrema(%bounded_position: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %values = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %22 = v_lshlrev_b32_src0_inline %bounded_position, 2
  %23 = v_lshrrev_b32_src0_inline %bounded_position, 30
  %24 = slice %values[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = slice %values[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26, %27 = v_add_co_u32 %24, %22
  %28 = v_mov_b32_copy %25
  %29, %30 = v_add_co_ci_u32 %28, %23, %27
  %31 = concat(%26, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %value = global_load_b32_vaddr %31
  %signed_minimum = v_min_i32_lit %value, 305419896
  %signed_maximum = v_max_i32_lit %value, 305419896
  %unsigned_minimum = v_min_u32_src0_inline %value, 7
  %unsigned_maximum = v_max_u32_src0_inline %value, 7
  return %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum
}
