// RUN: pass-report source-to-low,low-dce

amdgpu.target<gfx942> @target

func.def target(@target) @report_cdna3_native_bf8_fp8_mfma(%lhs_data: vector<2xi32>, %rhs_data: vector<2xi32>, %init_data: vector<4xf32>) -> (vector<4xf32>) {
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 32 : index
  %lhs_schema = encoding.define #matrix_operand<element_format=f8e5m2, payload_elements=8, payload_registers=2> : encoding<schema>
  %rhs_schema = encoding.define #matrix_operand<element_format=f8e4m3, payload_elements=8, payload_registers=2> : encoding<schema>
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] using {schema = %lhs_schema : encoding<schema>} : vector<2xi32>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] using {schema = %rhs_schema : encoding<schema>} : vector<2xi32>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<4xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<2xi32>, vector<2xi32>, vector<4xf32>
  func.return %result : vector<4xf32>
}

