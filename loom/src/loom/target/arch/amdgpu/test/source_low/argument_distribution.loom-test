// RUN: emit source-low output=low

amdgpu.target<gfx1100> @target

// Uniform tuple arguments feed vector arithmetic and merge with an unchanged
// payload, retaining the native vector result representation.
func.def noinline @uniform_merge(%condition: i1, %values: vector<3xf32>) -> (vector<3xf32>) {
  cfg.cond_br %condition, ^twice, ^original
^twice:
  %doubled = vector.addf %values, %values : vector<3xf32>
  cfg.br ^merge(%doubled: vector<3xf32>)
^original:
  cfg.br ^merge(%values: vector<3xf32>)
^merge(%selected: vector<3xf32>):
  func.return %selected : vector<3xf32>
}

kernel.def target(@target) @caller() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%condition: i1, %values: vector<3xf32>, %output: buffer) {
  %result = func.call @uniform_merge(%condition, %values) : (i1, vector<3xf32>) -> (vector<3xf32>)
  %offset = index.constant 0 : offset
  %view = buffer.view %output[%offset] : buffer -> view<3xf32>
  vector.store %result, %view[0] : vector<3xf32>, view<3xf32>
  kernel.return
}

// ----
low.func.def noinline target<amdgpu.rdna3.core> @uniform_merge(%condition: reg<amdgpu.sgpr>, %values: reg<amdgpu.sgpr x3>) -> (reg<amdgpu.vgpr x3>) asm {
  %16 = s_mov_b32 0
  %17 = s_cmp_lg_i32 %condition, %16
  low.cond_br %17, ^twice, ^original : reg<amdgpu.scc>
^twice:
  %18 = slice %values[0] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %20 = slice %values[1] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %21 = v_mov_b32_copy %20
  %22 = slice %values[2] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %27 = v_add_f32 %18, %19
  %30 = v_add_f32 %20, %21
  %33 = v_add_f32 %22, %23
  %doubled = concat(%27, %30, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  low.br ^merge(%doubled: reg<amdgpu.vgpr x3>)
^original:
  %35 = slice %values[0] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %36 = v_mov_b32_copy %35
  %37 = slice %values[1] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %38 = v_mov_b32_copy %37
  %39 = slice %values[2] : reg<amdgpu.sgpr x3> -> reg<amdgpu.sgpr>
  %40 = v_mov_b32_copy %39
  %41 = concat(%36, %38, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  low.br ^merge(%41: reg<amdgpu.vgpr x3>)
^merge(%selected: reg<amdgpu.vgpr x3>):
  return %selected
}

low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 4, direct_arg_count = 2, direct_arg_names = {arg0 = "condition", arg1 = "values"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_payload_sizes = [1, 12], direct_arg_sizes = [4, 12], parameter_count = 3, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @caller(%condition$42: reg<amdgpu.sgpr>, %values: reg<amdgpu.sgpr x3>) asm {
  %view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %condition$45 = s_bfe_u32_lit %condition$42, 524288
  %result = low.func.call pure @uniform_merge(%condition$45, %values) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x3>) -> (reg<amdgpu.vgpr x3>)
  %47 = v_mov_b32 0
  global_store_b96_saddr %47, %result, %view
  return
}

