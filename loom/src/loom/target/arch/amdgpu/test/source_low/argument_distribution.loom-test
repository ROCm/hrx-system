// RUN: emit source-low output=low

amdgpu.target<gfx1100> @target {subgroup_size = 64}

func.def noinline @choose_word(%condition: i1, %first: i32, %second: i32) -> (i32) {
  %selected = scf.select %condition, %first, %second : i32
  func.return %selected : i32
}

func.def noinline @choose_float(%condition: i1, %first: f32, %second: f32) -> (f32) {
  %selected = scf.select %condition, %first, %second : f32
  func.return %selected : f32
}

func.def noinline @choose_lane(%condition: i1, %first: i32, %second: i32) -> (i32) {
  cfg.cond_br %condition, ^then, ^else
^then:
  cfg.br ^forward
^forward:
  cfg.br ^join(%first: i32)
^else:
  cfg.br ^join(%second: i32)
^join(%selected: i32):
  func.return %selected : i32
}

kernel.def target(@target) @caller_contract() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%condition: i1, %word_first: i32, %word_second: i32, %float_first: f32, %float_second: f32, %output: buffer) {
  %word = func.call @choose_word(%condition, %word_first, %word_second) : (i1, i32, i32) -> (i32)
  %fraction = func.call @choose_float(%condition, %float_first, %float_second) : (i1, f32, f32) -> (f32)
  %lane = kernel.workitem.id<x> : index
  %half = index.constant 32 : index
  %active = index.cmp ult, %lane, %half : index
  %chosen_lane = func.call @choose_lane(%active, %word_first, %word_second) : (i1, i32, i32) -> (i32)
  %bits = scalar.bitcast %fraction : f32 to i32
  %payload_width = index.constant 3 : index
  %base = index.mul %lane, %payload_width : index
  %buffer_origin = index.constant 0 : offset
  %results = buffer.view %output[%buffer_origin] : buffer -> view<192xi32>
  %values = vector.from_elements %word, %bits, %chosen_lane : vector<3xi32>
  vector.store %values, %results[%base] : vector<3xi32>, view<192xi32>
  kernel.return
}

// ----
low.func.def noinline target<amdgpu.rdna3.core> @choose_word(%condition: reg<amdgpu.sgpr>, %first: reg<amdgpu.sgpr>, %second: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %39 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %selected = s_cselect_b32 %first, %second, %39
  return %selected
}

low.func.def noinline target<amdgpu.rdna3.core> @choose_float(%condition: reg<amdgpu.sgpr>, %first: reg<amdgpu.sgpr>, %second: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %45 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %selected = s_cselect_b32 %first, %second, %45
  return %selected
}

low.func.def noinline target<amdgpu.rdna3.core> @choose_lane(%condition: reg<amdgpu.sgpr x2>, %first: reg<amdgpu.sgpr>, %second: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %54, %55 = s_and_saveexec_b64 %condition
  low.cond_br %55, ^then, ^_bb5 : reg<amdgpu.scc>
^then:
  %59 = v_mov_b32_copy %first
  low.br ^_bb4(%59: reg<amdgpu.vgpr>)
^_bb4(%selected$52: reg<amdgpu.vgpr>):
  %58 = s_andn2_b64_exec %54, %condition
  low.cond_br %58, ^else, ^_bb6 : reg<amdgpu.scc>
^else:
  %60 = v_mov_b32_copy %second
  s_mov_b64_exec %54
  %57 = v_cndmask_b32 %60, %selected$52, %condition
  low.br ^join(%57: reg<amdgpu.vgpr>)
^join(%selected$51: reg<amdgpu.vgpr>):
  return %selected$51
^_bb5:
  s_mov_b64_exec %54
  %56 = v_mov_b32 0
  low.br ^_bb4(%56: reg<amdgpu.vgpr>)
^_bb6:
  s_mov_b64_exec %54
  low.br ^join(%selected$52: reg<amdgpu.vgpr>)
}

low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 5, direct_arg_count = 5, direct_arg_names = {arg0 = "condition", arg1 = "word_first", arg2 = "word_second", arg3 = "float_first", arg4 = "float_second"}, direct_arg_offsets = [0, 4, 8, 12, 16], direct_arg_parameter_indices = [0, 1, 2, 3, 4], direct_arg_payload_sizes = [1, 4, 4, 4, 4], direct_arg_sizes = [4, 4, 4, 4, 4], parameter_count = 6, resource_count = 1, resource_offsets = [24], resource_parameter_indices = [5], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @caller_contract(%condition$61: reg<amdgpu.sgpr>, %word_first: reg<amdgpu.sgpr>, %word_second: reg<amdgpu.sgpr>, %float_first: reg<amdgpu.sgpr>, %float_second: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %results = resource<hal_binding> {extent = 768, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %condition$68 = s_bfe_u32_lit %condition$61, 524288
  %word = low.func.call pure @choose_word(%condition$68, %word_first, %word_second) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>)
  %bits = low.func.call pure @choose_float(%condition$68, %float_first, %float_second) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>)
  %active = v_cmp_lt_u32_src1_inline %lane {rhs = 32}
  %chosen_lane = low.func.call pure @choose_lane(%active, %word_first, %word_second) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>)
  %73 = v_mov_b32_copy %word
  %74 = v_mov_b32_copy %bits
  %values = concat(%73, %74, %chosen_lane) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %76 = v_mov_b32 12
  %77 = v_mul_lo_u32 %lane, %76
  global_store_b96_saddr %77, %values, %results
  return
}
