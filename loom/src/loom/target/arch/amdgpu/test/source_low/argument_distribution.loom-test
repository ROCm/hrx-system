// RUN: emit source-low output=low

amdgpu.target<gfx1100> @target {subgroup_size = 64}

// A target witness alone does not declare kernel launch participation.
func.def target(@target) @unknown_parameters(%word: i32, %value: f32, %predicate: i1) -> (i32, f32, i1) {
  func.return %word, %value, %predicate : i32, f32, i1
}

// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @unknown_parameters(%word: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %predicate: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  return %word, %value, %predicate
}

// ====

// RUN: emit source-low output=low

amdgpu.target<gfx1100> @target {subgroup_size = 64}

// A target witness alone does not declare kernel launch participation.
func.def target(@target) @unknown_parameters(%word: i32, %value: f32, %predicate: i1) -> (i32, f32, i1) {
  func.return %word, %value, %predicate : i32, f32, i1
}

// Adding another call graph component cannot strengthen this entry's facts.
func.def noinline target(@target) @other_identity(%word: i32) -> (i32) {
  func.return %word : i32
}

func.def target(@target) @other_caller(%word: i32) -> (i32) {
  %result = func.call @other_identity(%word) : (i32) -> (i32)
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @unknown_parameters(%word: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %predicate: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  return %word, %value, %predicate
}

low.func.def noinline target<amdgpu.rdna3.core>(@target) @other_identity(%word: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  return %word
}

low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @other_caller(%word: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = low.func.call pure @other_identity(%word) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  return %result
}
