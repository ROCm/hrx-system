// RUN: pass target-legalize{mode=final},dce,canonicalize

amdgpu.target<gfx1151> @target

func.def target(@target) @predicate_rotations(%value: i1, %amount: i1) -> (i1, i1) {
  %left = scalar.rotli %value, %amount : i1
  %right = scalar.rotri %value, %amount : i1
  func.return %left, %right : i1, i1
}

func.def target(@target) @byte_rotations(%value: i8, %amount: i8) -> (i8, i8) {
  %left = scalar.rotli %value, %amount : i8
  %right = scalar.rotri %value, %amount : i8
  func.return %left, %right : i8, i8
}

