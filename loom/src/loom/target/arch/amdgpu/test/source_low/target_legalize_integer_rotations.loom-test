  %halfword_right = vector.rotri %halfwords, %halfword_amounts : vector<2xi16>
  %word_left = vector.rotli %words, %word_amounts : vector<2xi32>
  %word_right = vector.rotri %words, %word_amounts : vector<2xi32>
  %wide_left = vector.rotli %wide, %wide_amounts : vector<2xi64>
  %wide_right = vector.rotri %wide, %wide_amounts : vector<2xi64>
  func.return %byte_left, %byte_right, %halfword_left, %halfword_right, %word_left, %word_right, %wide_left, %wide_right : vector<2xi8>, vector<2xi8>, vector<2xi16>, vector<2xi16>, vector<2xi32>, vector<2xi32>, vector<2xi64>, vector<2xi64>
}

