  %87 = slice %85[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %88 = v_or_b32 %86, %87
  %89 = slice %80[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %90 = slice %85[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
