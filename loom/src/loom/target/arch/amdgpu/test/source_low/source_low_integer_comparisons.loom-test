  %87 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %88 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %89 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %90 = s_xor_b32_lit %87, 2147483648
  %91 = s_xor_b32_lit %89, 2147483648
  %92 = s_cmp_lt_u32 %86, %88
  %93, %94 = s_subb_u32 %90, %91, %92
  %slt = s_cselect_b32 %80, %79, %94
  %104 = s_cmp_le_u32 %86, %88
  %105, %106 = s_subb_u32 %90, %91, %104
  %sle = s_cselect_b32 %80, %79, %106
  %116 = s_cmp_gt_u32 %86, %88
  %117, %118 = s_subb_u32 %91, %90, %116
  %sgt = s_cselect_b32 %80, %79, %118
  %128 = s_cmp_ge_u32 %86, %88
  %129, %130 = s_subb_u32 %91, %90, %128
  %sge = s_cselect_b32 %80, %79, %130
  %138 = s_cmp_lt_u32 %86, %88
  %139, %140 = s_subb_u32 %87, %89, %138
  %ult = s_cselect_b32 %80, %79, %140
  %148 = s_cmp_le_u32 %86, %88
  %149, %150 = s_subb_u32 %87, %89, %148
  %ule = s_cselect_b32 %80, %79, %150
  %158 = s_cmp_gt_u32 %86, %88
  %159, %160 = s_subb_u32 %89, %87, %158
  %ugt = s_cselect_b32 %80, %79, %160
  %168 = s_cmp_ge_u32 %86, %88
  %169, %170 = s_subb_u32 %89, %87, %168
  %uge = s_cselect_b32 %80, %79, %170
  %175 = s_cmp_lg_i32 %take, %79
  low.cond_br %175, ^observed, ^fallback : reg<amdgpu.scc>
^observed:
  %178 = s_cmp_lg_i32_src1_inline %eq {rhs = 0}
  %eq_word = s_cselect_b32 %80, %79, %178
  %180 = s_cmp_lg_i32_src1_inline %ne {rhs = 0}
  %ne_word = s_cselect_b32 %80, %79, %180
