  %79 = s_mov_b32 0
  %80 = s_mov_b32 1
  %eq = s_cselect_b32 %80, %79, %78
  %82 = s_cmp_lg_u64 %lhs, %rhs
  %ne = s_cselect_b32 %80, %79, %82
