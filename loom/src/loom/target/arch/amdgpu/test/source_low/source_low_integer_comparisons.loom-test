  %184 = s_cmp_lg_i32_src1_inline %sle {rhs = 0}
  %sle_word = s_cselect_b32 %80, %79, %184
  %186 = s_cmp_lg_i32_src1_inline %sgt {rhs = 0}
  %sgt_word = s_cselect_b32 %80, %79, %186
  %188 = s_cmp_lg_i32_src1_inline %sge {rhs = 0}
  %sge_word = s_cselect_b32 %80, %79, %188
  %190 = s_cmp_lg_i32_src1_inline %ult {rhs = 0}
  %ult_word = s_cselect_b32 %80, %79, %190
