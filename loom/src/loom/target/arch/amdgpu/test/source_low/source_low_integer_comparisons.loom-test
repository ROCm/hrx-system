  %eq = scalar.cmpi eq, %lhs, %rhs : i64
  %selected_eq = scf.select %eq, %then_value, %else_value : i32
  %ne = scalar.cmpi ne, %lhs, %rhs : i64
  %selected_ne = scf.select %ne, %then_value, %else_value : i32
  %slt = scalar.cmpi slt, %lhs, %rhs : i64
  %selected_slt = scf.select %slt, %then_value, %else_value : i32
  %sle = scalar.cmpi sle, %lhs, %rhs : i64
