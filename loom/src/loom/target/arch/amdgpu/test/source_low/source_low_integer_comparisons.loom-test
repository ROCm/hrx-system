  %eq = s_cmp_eq_u64 %lhs, %rhs
  %selected_eq = s_cselect_b32 %then_value, %else_value, %eq
  %ne = s_cmp_lg_u64 %lhs, %rhs
  %selected_ne = s_cselect_b32 %then_value, %else_value, %ne
  %52 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %53 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %55 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %56 = s_xor_b32_lit %53, 2147483648
  %57 = s_xor_b32_lit %55, 2147483648
  %58 = s_cmp_lt_u32 %52, %54
  %59, %slt = s_subb_u32 %56, %57, %58
  %selected_slt = s_cselect_b32 %then_value, %else_value, %slt
  %68 = s_cmp_le_u32 %52, %54
  %69, %sle = s_subb_u32 %56, %57, %68
  %selected_sle = s_cselect_b32 %then_value, %else_value, %sle
  %78 = s_cmp_gt_u32 %52, %54
  %79, %sgt = s_subb_u32 %57, %56, %78
  %selected_sgt = s_cselect_b32 %then_value, %else_value, %sgt
  %88 = s_cmp_ge_u32 %52, %54
  %89, %sge = s_subb_u32 %57, %56, %88
  %selected_sge = s_cselect_b32 %then_value, %else_value, %sge
  %96 = s_cmp_lt_u32 %52, %54
  %97, %ult = s_subb_u32 %53, %55, %96
  %selected_ult = s_cselect_b32 %then_value, %else_value, %ult
  %104 = s_cmp_le_u32 %52, %54
  %105, %ule = s_subb_u32 %53, %55, %104
  %selected_ule = s_cselect_b32 %then_value, %else_value, %ule
  %112 = s_cmp_gt_u32 %52, %54
  %113, %ugt = s_subb_u32 %55, %53, %112
  %selected_ugt = s_cselect_b32 %then_value, %else_value, %ugt
  %120 = s_cmp_ge_u32 %52, %54
  %121, %uge = s_subb_u32 %55, %53, %120
  %selected_uge = s_cselect_b32 %then_value, %else_value, %uge
  return %selected_eq, %selected_ne, %selected_slt, %selected_sle, %selected_sgt, %selected_sge, %selected_ult, %selected_ule, %selected_ugt, %selected_uge
}

