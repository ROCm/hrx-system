  %ult_word = scalar.extui %ult : i1 to i32
  %ule_word = scalar.extui %ule : i1 to i32
  %ugt_word = scalar.extui %ugt : i1 to i32
  %uge_word = scalar.extui %uge : i1 to i32
  func.return %eq_word, %ne_word, %slt_word, %sle_word, %sgt_word, %sge_word, %ult_word, %ule_word, %ugt_word, %uge_word : i32, i32, i32, i32, i32, i32, i32, i32, i32, i32
^fallback:
