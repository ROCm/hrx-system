  %sgt = scalar.cmpi sgt, %lhs, %rhs : i64
  %selected_sgt = scf.select %sgt, %then_value, %else_value : i32
  %sge = scalar.cmpi sge, %lhs, %rhs : i64
  %selected_sge = scf.select %sge, %then_value, %else_value : i32
  %ult = scalar.cmpi ult, %lhs, %rhs : i64
  %selected_ult = scf.select %ult, %then_value, %else_value : i32
  %ule = scalar.cmpi ule, %lhs, %rhs : i64
  %selected_ule = scf.select %ule, %then_value, %else_value : i32
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i64
  %selected_ugt = scf.select %ugt, %then_value, %else_value : i32
  %uge = scalar.cmpi uge, %lhs, %rhs : i64
  %selected_uge = scf.select %uge, %then_value, %else_value : i32
  func.return %selected_eq, %selected_ne, %selected_slt, %selected_sle, %selected_sgt, %selected_sge, %selected_ult, %selected_ule, %selected_ugt, %selected_uge : i32, i32, i32, i32, i32, i32, i32, i32, i32, i32
}

