  %196 = s_cmp_lg_i32_src1_inline %uge {rhs = 0}
  %uge_word = s_cselect_b32 %80, %79, %196
  return %eq_word, %ne_word, %slt_word, %sle_word, %sgt_word, %sge_word, %ult_word, %ule_word, %ugt_word, %uge_word
