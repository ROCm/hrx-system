low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @select_i8_7(%mask: reg<amdgpu.sgpr x14>, %true_value: reg<amdgpu.vgpr x2>, %false_value: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = slice %true_value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %10 = slice %false_value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = slice %mask[0] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %12 = v_cndmask_b32 %10, %9, %11
  %13 = slice %mask[2] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %14 = v_cndmask_b32 %10, %9, %13
  %15 = v_bfi_b32_src0_lit %14, %12, 65280
  %16 = slice %mask[4] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %17 = v_cndmask_b32 %10, %9, %16
  %18 = v_bfi_b32_src0_lit %17, %15, 16711680
  %19 = slice %mask[6] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %20 = v_cndmask_b32 %10, %9, %19
  %21 = v_bfi_b32_src0_lit %20, %18, 4278190080
  %22 = slice %true_value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %23 = slice %false_value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %24 = slice %mask[8] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %25 = v_cndmask_b32 %23, %22, %24
  %26 = slice %mask[10] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %27 = v_cndmask_b32 %23, %22, %26
  %28 = v_bfi_b32_src0_lit %27, %25, 65280
  %29 = slice %mask[12] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %30 = v_cndmask_b32 %23, %22, %29
  %31 = v_bfi_b32_src0_lit %30, %28, 16711680
  %selected = concat(%21, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %selected
}

