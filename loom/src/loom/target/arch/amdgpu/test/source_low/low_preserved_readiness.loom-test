// RUN: emit amdgpu-assembly @continued_chain_preserved_read strategy=source

// Repeated high-half writes retain the original low-half completion source.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @continued_chain_preserved_read(%address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %loaded = ds_load_u16_d16 %address
  %first = ds_load_u16_d16_hi %loaded, %address {offset = 2}
  %second = ds_load_u16_d16_hi %first, %address {offset = 4}
  %third = ds_load_u16_d16_hi %second, %address {offset = 6}
  global_store_short_saddr %address, %third, %output
  global_store_b32_saddr %address, %third, %output {offset = 4}
  return
}

