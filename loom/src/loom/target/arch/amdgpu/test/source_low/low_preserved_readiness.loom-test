  ds_load_u16_d16_hi v1, v0 offset:2
  s_waitcnt vmcnt(63) lgkmcnt(1)
  ds_load_u16_d16_hi v1, v0 offset:4
  s_waitcnt vmcnt(63) lgkmcnt(1)
  ds_load_u16_d16_hi v1, v0 offset:6
  global_store_short v0, v1, s[0:1] offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  global_store_b32 v0, v1, s[0:1] offset:4
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

