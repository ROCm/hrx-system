// TEMPLATE: loom/src/loom/test/corpus/source_low/uniform_integer_conversion.loom-test
// RUN: emit source-low target=amdgpu:gfx1100 output=low

kernel.def @uniform_i8_to_float() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %independent = buffer.assume.noalias %aligned : buffer
  %destination = buffer.assume.noalias %output : buffer
  %base = index.constant 0 : offset
  %unsigned_base = index.constant 32 : offset
  %source = buffer.view %independent[%base] : buffer -> view<8xi8>
  %signed_target = buffer.view %destination[%base] : buffer -> view<8xf32>
  %unsigned_target = buffer.view %destination[%unsigned_base] : buffer -> view<8xf32>
  %value = vector.load %source[0] : view<8xi8> -> vector<8xi8>
  %signed = vector.sitofp %value : vector<8xi8> to vector<8xf32>
  %unsigned = vector.uitofp %value : vector<8xi8> to vector<8xf32>
  vector.store %signed, %signed_target[0] : vector<8xf32>, view<8xf32>
  vector.store %unsigned, %unsigned_target[0] : vector<8xf32>, view<8xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_i8_to_float() asm {
  %source = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %unsigned_target = resource<hal_binding> {extent = 64, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = s_mov_b32 0
  %value = s_load_dwordx2 %source, %16
  %18 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_bfe_i32_offset_width_inline %18 {offset = 0, width = 8}
  %20 = v_cvt_f32_i32 %19
  %22 = v_bfe_i32_offset_width_inline %18 {offset = 8, width = 8}
  %23 = v_cvt_f32_i32 %22
  %25 = v_bfe_i32_offset_width_inline %18 {offset = 16, width = 8}
  %26 = v_cvt_f32_i32 %25
  %28 = v_mov_b32_copy %18
  %29 = v_ashrrev_i32_src0_inline %28, 24
  %30 = v_cvt_f32_i32 %29
  %31 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = v_bfe_i32_offset_width_inline %31 {offset = 0, width = 8}
  %33 = v_cvt_f32_i32 %32
  %35 = v_bfe_i32_offset_width_inline %31 {offset = 8, width = 8}
  %36 = v_cvt_f32_i32 %35
  %38 = v_bfe_i32_offset_width_inline %31 {offset = 16, width = 8}
  %39 = v_cvt_f32_i32 %38
  %41 = v_mov_b32_copy %31
  %42 = v_ashrrev_i32_src0_inline %41, 24
  %43 = v_cvt_f32_i32 %42
  %46 = v_cvt_f32_ubyte0 %18
  %47 = v_cvt_f32_ubyte1 %18
  %48 = v_cvt_f32_ubyte2 %18
  %49 = v_cvt_f32_ubyte3 %18
  %51 = v_cvt_f32_ubyte0 %31
  %52 = v_cvt_f32_ubyte1 %31
  %53 = v_cvt_f32_ubyte2 %31
  %54 = v_cvt_f32_ubyte3 %31
  %67 = concat(%20, %23, %26, %30) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %57 = v_mov_b32 0
  global_store_b128_saddr %57, %67, %unsigned_target
  %66 = concat(%33, %36, %39, %43) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %57, %66, %unsigned_target {offset = 16}
  %65 = concat(%46, %47, %48, %49) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %57, %65, %unsigned_target {offset = 32}
  %64 = concat(%51, %52, %53, %54) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %57, %64, %unsigned_target {offset = 48}
  return
}

