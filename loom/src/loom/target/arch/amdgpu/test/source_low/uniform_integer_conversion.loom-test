low.kernel.def target<amdgpu.rdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_i16_to_float() asm {
  %source = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %unsigned_target = resource<hal_binding> {extent = 32, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = s_mov_b32 0
  %value = s_load_dwordx2 %source, %16
  %18 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_bfe_i32_offset_width_inline %18 {offset = 0, width = 16}
  %20 = v_cvt_f32_i32 %19
  %22 = v_mov_b32_copy %18
  %23 = v_ashrrev_i32_src0_inline %22, 16
  %24 = v_cvt_f32_i32 %23
  %25 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = v_bfe_i32_offset_width_inline %25 {offset = 0, width = 16}
  %27 = v_cvt_f32_i32 %26
  %29 = v_mov_b32_copy %25
  %30 = v_ashrrev_i32_src0_inline %29, 16
  %31 = v_cvt_f32_i32 %30
  %signed = concat(%20, %24, %27, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %35 = v_and_b32_lit %22, 65535
  %36 = v_cvt_f32_u32 %35
  %38 = v_bfe_u32_offset_width_inline %18 {offset = 16, width = 16}
  %39 = v_cvt_f32_u32 %38
  %42 = v_and_b32_lit %29, 65535
  %43 = v_cvt_f32_u32 %42
  %45 = v_bfe_u32_offset_width_inline %25 {offset = 16, width = 16}
  %46 = v_cvt_f32_u32 %45
  %unsigned = concat(%36, %39, %43, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %48 = v_mov_b32 0
  global_store_b128_saddr %48, %signed, %unsigned_target
  global_store_b128_saddr %48, %unsigned, %unsigned_target {offset = 16}
  return
}
