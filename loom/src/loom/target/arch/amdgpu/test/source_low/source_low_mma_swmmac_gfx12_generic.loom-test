amdgpu.target<gfx12-generic> @target
func.def target(@target) @swmmac_f32_packed8(
    %fp8_lhs_data: vector<2xi32>, %bf8_lhs_data: vector<2xi32>,
    %fp8_rhs_data: vector<4xi32>, %bf8_rhs_data: vector<4xi32>,
    %init_data: vector<8xf32>, %metadata: vector<1xi32>)
    -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 32 : index
  %fp8_lhs_schema = encoding.define #encoding.operand<element_format=f8e4m3, payload_elements=8, payload_registers=2, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %bf8_lhs_schema = encoding.define #encoding.operand<element_format=f8e5m2, payload_elements=8, payload_registers=2, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %fp8_rhs_schema = encoding.define #encoding.operand<element_format=f8e4m3, payload_elements=16, payload_registers=4> : encoding<schema>
  %bf8_rhs_schema = encoding.define #encoding.operand<element_format=f8e5m2, payload_elements=16, payload_registers=4> : encoding<schema>
  %fp8_lhs = vector.fragment<lhs> %fp8_lhs_data shape [%m, %k] using {sparsity = %metadata : vector<1xi32>, schema = %fp8_lhs_schema : encoding<schema>} : vector<2xi32>
  %bf8_lhs = vector.fragment<lhs> %bf8_lhs_data shape [%m, %k] using {sparsity = %metadata : vector<1xi32>, schema = %bf8_lhs_schema : encoding<schema>} : vector<2xi32>
  %fp8_rhs = vector.fragment<rhs> %fp8_rhs_data shape [%k, %n] using {schema = %fp8_rhs_schema : encoding<schema>} : vector<4xi32>
  %bf8_rhs = vector.fragment<rhs> %bf8_rhs_data shape [%k, %n] using {schema = %bf8_rhs_schema : encoding<schema>} : vector<4xi32>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<8xf32>
  %fp8_fp8 = vector.mma %fp8_lhs, %fp8_rhs, %init : vector<2xi32>, vector<4xi32>, vector<8xf32>
  %fp8_bf8 = vector.mma %fp8_lhs, %bf8_rhs, %init : vector<2xi32>, vector<4xi32>, vector<8xf32>
  %bf8_fp8 = vector.mma %bf8_lhs, %fp8_rhs, %init : vector<2xi32>, vector<4xi32>, vector<8xf32>
  %bf8_bf8 = vector.mma %bf8_lhs, %bf8_rhs, %init : vector<2xi32>, vector<4xi32>, vector<8xf32>
  func.return %fp8_fp8, %fp8_bf8, %bf8_fp8, %bf8_bf8 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
}

