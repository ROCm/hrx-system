func.def target(@target) @swmmac_packed16(
    %f16_lhs_data: vector<4xi32>, %bf16_lhs_data: vector<4xi32>,
    %f16_rhs_data: vector<8xi32>, %bf16_rhs_data: vector<8xi32>,
    %f32_init_data: vector<8xf32>, %f16_init_data: vector<8xf16>,
    %bf16_init_data: vector<8xbf16>, %metadata: vector<1xi32>)
    -> (vector<8xf32>, vector<8xf32>, vector<8xf16>, vector<8xbf16>) {
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 32 : index
  %f16_lhs_schema = encoding.define #encoding.operand<element_format=f16, payload_elements=8, payload_registers=4, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %bf16_lhs_schema = encoding.define #encoding.operand<element_format=bf16, payload_elements=8, payload_registers=4, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %f16_rhs_schema = encoding.define #encoding.operand<element_format=f16, payload_elements=16, payload_registers=8> : encoding<schema>
  %bf16_rhs_schema = encoding.define #encoding.operand<element_format=bf16, payload_elements=16, payload_registers=8> : encoding<schema>
  %f16_lhs = vector.fragment<lhs> %f16_lhs_data shape [%m, %k] using {sparsity = %metadata : vector<1xi32>, schema = %f16_lhs_schema : encoding<schema>} : vector<4xi32>
  %bf16_lhs = vector.fragment<lhs> %bf16_lhs_data shape [%m, %k] using {sparsity = %metadata : vector<1xi32>, schema = %bf16_lhs_schema : encoding<schema>} : vector<4xi32>
  %f16_rhs = vector.fragment<rhs> %f16_rhs_data shape [%k, %n] using {schema = %f16_rhs_schema : encoding<schema>} : vector<8xi32>
  %bf16_rhs = vector.fragment<rhs> %bf16_rhs_data shape [%k, %n] using {schema = %bf16_rhs_schema : encoding<schema>} : vector<8xi32>
  %f32_init = vector.fragment<init> %f32_init_data shape [%m, %n] : vector<8xf32>
  %f16_init = vector.fragment<init> %f16_init_data shape [%m, %n] : vector<8xf16>
  %bf16_init = vector.fragment<init> %bf16_init_data shape [%m, %n] : vector<8xbf16>
  %f32_f16 = vector.mma %f16_lhs, %f16_rhs, %f32_init : vector<4xi32>, vector<8xi32>, vector<8xf32>
  %f32_bf16 = vector.mma %bf16_lhs, %bf16_rhs, %f32_init : vector<4xi32>, vector<8xi32>, vector<8xf32>
  %f16 = vector.mma %f16_lhs, %f16_rhs, %f16_init : vector<4xi32>, vector<8xi32>, vector<8xf16>
  %bf16 = vector.mma %bf16_lhs, %bf16_rhs, %bf16_init : vector<4xi32>, vector<8xi32>, vector<8xbf16>
  func.return %f32_f16, %f32_bf16, %f16, %bf16 : vector<8xf32>, vector<8xf32>, vector<8xf16>, vector<8xbf16>
}

