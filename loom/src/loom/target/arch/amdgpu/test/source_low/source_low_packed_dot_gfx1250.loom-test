// ====

func.def @gfx1250_dot4f8_bf8bf8(%lhs: vector<1xi32>, %rhs: vector<1xi32>, %acc: vector<1xf32>) -> (vector<1xf32>) {
  // ERROR@+1: TARGET/003 {subject_role="descriptor", subject_name="amdgpu.v_dot4_f32", constraint_key="amdgpu.dot4f8.descriptor"}
  %dot = vector.dot4f8<bf8bf8> %lhs, %rhs, %acc : vector<1xi32>, vector<1xf32>
