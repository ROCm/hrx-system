func.def target(@target) @index_compare_mixed_width_divergent(%values: vector<2xi32>, %wide_input: i64) -> (i1) {
  %narrow = vector.extract %values[0] : vector<2xi32> -> i32
  %bounded = scalar.assume %wide_input [range(%wide_input, 0, 8589934591)] : i64
  %wide = index.cast %bounded : i64 to index
  %signed = index.cast %narrow : i32 to index
  %result = index.cmp slt, %wide, %signed : index
  func.return %result : i1
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @index_compare_mixed_width_divergent(%values: reg<amdgpu.vgpr x2>, %wide: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %signed = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %12 = slice %wide[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = v_mov_b32_copy %12
  %14 = slice %wide[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = v_mov_b32_copy %14
  %17 = v_ashrrev_i32_src0_inline %signed, 31
  %23 = v_cmp_lt_i32 %15, %17
  %24 = v_cmp_lt_u32 %13, %signed
  %25 = v_cmp_eq_i32 %15, %17
  %26 = s_and_b64 %25, %24
  %result = s_or_b64 %23, %26
  return %result
}

