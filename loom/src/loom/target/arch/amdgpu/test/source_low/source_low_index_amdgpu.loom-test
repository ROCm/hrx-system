amdgpu.target<gfx11-generic> @target

func.def target(@target) @offset_compare_uniform(%lhs: offset, %rhs: offset) -> (i1) {
  %result = index.cmp ult, %lhs, %rhs : offset
  func.return %result : i1
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @offset_compare_uniform(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %7 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %8 = v_mov_b32_copy %7
  %9 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %10 = v_mov_b32_copy %9
  %12 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = v_mov_b32_copy %12
  %14 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = v_mov_b32_copy %14
  %21 = v_cmp_lt_u32 %10, %15
  %22 = v_cmp_lt_u32 %8, %13
  %23 = v_cmp_eq_i32 %10, %15
  %24 = s_and_b64 %23, %22
  %result = s_or_b64 %21, %24
  return %result
}

