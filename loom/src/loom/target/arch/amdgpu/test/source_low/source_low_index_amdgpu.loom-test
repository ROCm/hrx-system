amdgpu.target<gfx11-generic> @target

func.def target(@target) @index_compare_mixed_width_uniform(%narrow: i32, %wide_input: i64) -> (i1) {
  %bounded = scalar.assume %wide_input [range(%wide_input, 0, 8589934591)] : i64
  %wide = index.cast %bounded : i64 to index
  %signed = index.cast %narrow : i32 to index
  %result = index.cmp slt, %signed, %wide : index
  func.return %result : i1
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @index_compare_mixed_width_uniform(%signed: reg<amdgpu.sgpr>, %wide: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %10 = v_mov_b32_copy %signed
  %11 = v_ashrrev_i32_src0_inline %10, 31
  %13 = slice %wide[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = v_mov_b32_copy %13
  %15 = slice %wide[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %15
  %22 = v_cmp_lt_i32 %11, %16
  %23 = v_cmp_lt_u32 %10, %14
  %24 = v_cmp_eq_i32 %11, %16
  %25 = s_and_b64 %24, %23
  %result = s_or_b64 %22, %25
  return %result
}

