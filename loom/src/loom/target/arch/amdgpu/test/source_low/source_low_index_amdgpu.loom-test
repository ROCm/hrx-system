// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @index_uniform_i64_multiply(%lhs_i64: i64) -> (index) {
  %bounded_i64 = scalar.assume %lhs_i64 [range(%lhs_i64, 0, 1023)] : i64
  %lhs_index = index.cast %bounded_i64 : i64 to index
  %stride = index.constant 128 : index
  %product = index.mul %lhs_index, %stride : index
  func.return %product : index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @index_uniform_i64_multiply(%bounded_i64: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>) asm {
  %lhs_index = slice %bounded_i64[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = s_mov_b32 7
  %product = s_lshl_b32 %lhs_index, %11
  return %product
}

