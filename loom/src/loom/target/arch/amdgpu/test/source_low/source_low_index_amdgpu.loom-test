  %output_view = resource<hal_binding> {extent = 5040, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %block_begin = s_mov_b32 0
  %block_end = s_mov_b32 12
  %block_step = s_mov_b32 4
  %36 = s_mov_b32 15
  low.br ^_bb1(%block_begin: reg<amdgpu.sgpr>)
^_bb1(%block_base: reg<amdgpu.sgpr>):
  %37 = s_cmp_lt_i32 %block_base, %block_end
  low.cond_br %37, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %lane_group = v_lshrrev_b32_src0_inline %lane, 4
  %lane_offset = v_and_b32 %36, %lane
  %block = v_add_u32 %block_base, %lane_group
  %linear = v_mad_u32_u24_src1_lit %block, %lane_offset, 105
  %42 = v_lshlrev_b32_src0_inline %linear, 2
  %loaded = global_load_b32_saddr %42, %input_view
  global_store_b32_saddr %42, %loaded, %output_view
  %45 = s_add_u32 %block_base, %block_step
  low.br ^_bb1(%45: reg<amdgpu.sgpr>)
^_bb3:
  return
}

