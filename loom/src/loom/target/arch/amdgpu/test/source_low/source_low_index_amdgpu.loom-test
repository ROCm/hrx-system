amdgpu.target<gfx11-generic> @target

func.def target(@target) @offset_compare_mixed_width(%narrow: i32, %wide: offset) -> (i1) {
  %unsigned = index.cast %narrow : i32 to offset
  %result = index.cmp ult, %unsigned, %wide : offset
  func.return %result : i1
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @offset_compare_mixed_width(%unsigned: reg<amdgpu.sgpr>, %wide: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %8 = v_mov_b32_copy %unsigned
  %9 = v_mov_b32 0
  %11 = slice %wide[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = v_mov_b32_copy %11
  %13 = slice %wide[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = v_mov_b32_copy %13
  %20 = v_cmp_lt_u32 %9, %14
  %21 = v_cmp_lt_u32 %8, %12
  %22 = v_cmp_eq_i32 %9, %14
  %23 = s_and_b64 %22, %21
  %result = s_or_b64 %20, %23
  return %result
}

// ====

// RUN: pass target=amdgpu:gfx1151 canonicalize

// A logical index shift uses the selected 32-bit carrier.
func.def @logical_shift_carrier(%coordinate: index) -> (i64, i64) {
  %amount = index.constant 1 : index
  %shifted = index.shrui %coordinate, %amount : index
  %lo = test.fact_range_lo %shifted : index -> i64
  %hi = test.fact_range_hi %shifted : index -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @logical_shift_carrier(%coordinate: index) -> (i64, i64) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 2147483647 : i64
  func.return %lo, %hi : i64, i64
}
