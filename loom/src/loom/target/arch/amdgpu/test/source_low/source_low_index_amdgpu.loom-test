// RUN: with-checks emit source-low output=low
amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @offset_loop_narrows_induction_operand() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: buffer) {
  %begin = index.constant 0 : offset
  %end = index.constant 2 : offset
  %step = index.constant 1 : offset
  %value = scalar.constant 42 : i8
  scf.for %byte_offset = [%begin to %end step %step] {
    %output_view = buffer.view %output[%byte_offset] : buffer -> view<1xi8>
    view.store %value, %output_view[0] : i8, view<1xi8>
  }
  kernel.return
}

// ----
CHECK: low.kernel.def *@offset_loop_narrows_induction_operand() asm {
CHECK: ^*(%byte_offset: reg<amdgpu.sgpr>):
CHECK: * = s_cmp_lt_u32 %byte_offset, %end
CHECK: global_store_b8_saddr *
CHECK: * = s_add_u32 %byte_offset, %step
CHECK: *return
CHECK-NOT: *saveexec*
CHECK-NOT: *v_cmp*

