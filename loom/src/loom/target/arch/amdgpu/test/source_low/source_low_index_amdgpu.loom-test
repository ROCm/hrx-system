  %23 = v_mov_b32_copy %lower_index
  %at_or_above_lower = v_cmp_ge_i32 %lane, %23
  %26 = slice %at_or_above_lower[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = s_cselect_b32 %26, %empty_reference_count, %has_reference
  %28 = slice %at_or_above_lower[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = s_cselect_b32 %28, %empty_reference_count, %has_reference
  %inside_reference = concat(%27, %29) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32 %false_value, %true_value, %inside_reference
  return %selected
}

