  %7 = v_add_u32_src0_inline %6, 1
  %8 = v_add_u32_src0_inline %6, 2
  %9 = v_add_u32_src0_inline %6, 3
  %lanes = concat(%6, %7, %8, %9) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %lanes
}

