  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %load: i1, %fallback: i32, %output_0: buffer) {
  %lane = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %result_0 = func.call @return_loaded_or_argument(%input, %load, %fallback, %lane) : (buffer, i1, i32, index) -> (i32)
  %destination_0 = buffer.view %output_0[%origin] : buffer -> view<64xi32>
  view.store %result_0, %destination_0[%lane] : i32, view<64xi32>
  kernel.return
}

