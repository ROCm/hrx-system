  %origin = index.constant 0 : offset
  %result_0 = func.call @return_loaded_or_argument(%input, %load, %fallback, %lane) : (buffer, i1, i32, index) -> (i32)
  %destination_0 = buffer.view %output_0[%origin] : buffer -> view<64xi32>
  view.store %result_0, %destination_0[%lane] : i32, view<64xi32>
  kernel.return
}

