// ====

// Dynamic division follows its planned result bank and materializes uniform
// retained-call operands instead of changing the result representation during
// custom plan selection. Reciprocal setup and division share the divisor's
// block-local projection.
func.def noinline @load_uniform_dividend(%source: buffer) -> (i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %source[%origin] : buffer -> view<1xi32>
  %value = view.load<root_in_bounds> %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

kernel.def @divide_uniform_word() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%dividend_source: buffer, %divisor_source: buffer, %output: buffer) {
  %dividend = func.call readonly @load_uniform_dividend(%dividend_source) : (buffer) -> (i32)
  %divisor = func.call readonly @load_uniform_dividend(%divisor_source) : (buffer) -> (i32)
  %quotient = scalar.divui %dividend, %divisor : i32
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store<root_in_bounds> %quotient, %view[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.func.def noinline target<amdgpu.rdna3_5.core> @load_uniform_dividend(%view: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %16 = v_mov_b32 0
  %value = global_load_b32_saddr %16, %view
  return %value
}

