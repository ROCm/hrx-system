  cfg.br ^loop(%lane: offset)
^loop(%byte_offset: offset):
  %inside = index.cmp ult, %byte_offset, %byte_length : offset
  cfg.cond_br %inside, ^body, ^done
^body:
  %target_view = buffer.view %target_global[%byte_offset] : buffer -> view<1xi32>
  vector.store %value, %target_view[0] : vector<1xi32>, view<1xi32>
