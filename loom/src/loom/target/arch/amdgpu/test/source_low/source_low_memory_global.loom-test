  %output_view = buffer.view %output[%base] : buffer -> view<64x4xf32>
  %nct_tile = vector.load %input_view[0, %tile_base] : view<4x64xf32> -> vector<4x4xf32>
  %ntc_tile = vector.transpose<[1, 0]> %nct_tile : vector<4x4xf32> -> vector<4x4xf32>
  vector.store %ntc_tile, %output_view[%tile_base, 0] : vector<4x4xf32>, view<64x4xf32>
  kernel.return
}

