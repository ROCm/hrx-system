// RUN: emit amdgpu-assembly @scc_compare_rematerializes_across_clobber strategy=source waits=none

amdgpu.target<gfx1100> @target

// The second select depends on the add result, but the add clobbers the SCC
// predicate used by the select. Rematerializing the compare next to each select
// preserves both the SSA dependency and the physical SCC lifetime.
low.func.def target<amdgpu.rdna3.core>(@target) @scc_compare_rematerializes_across_clobber(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %valid = s_cmp_lt_u32 %ordinal, %limit
  %bounded = s_cselect_b32 %ordinal, %fallback, %valid
  %advanced = s_add_u32 %bounded, %limit
  %result = s_cselect_b32 %advanced, %fallback, %valid
  return %result
}

// ----
s_cmp_lt_u32 s0, s1
  s_cselect_b32 s3, s0, s2
  s_add_u32 s3, s3, s1
  s_cmp_lt_u32 s0, s1
  s_cselect_b32 s0, s3, s2
  s_endpgm
