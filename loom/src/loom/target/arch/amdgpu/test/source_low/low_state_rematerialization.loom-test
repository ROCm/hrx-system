// ====
// RUN: emit amdgpu-assembly @scc_compare_survives_diamond

amdgpu.target<gfx1100> @target

// Only one incoming path clobbers SCC. The merge consumes the entry predicate
// regardless of which path executed.
low.func.def target<amdgpu.rdna3.core>(@target) @scc_compare_survives_diamond(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %valid = s_cmp_lt_u32 %ordinal, %limit
  low.cond_br %valid, ^advance, ^unchanged : reg<amdgpu.scc>
^advance:
  %advanced = s_add_u32 %ordinal, %limit
  low.br ^merge(%advanced: reg<amdgpu.sgpr>)
^unchanged:
  low.br ^merge(%ordinal: reg<amdgpu.sgpr>)
^merge(%candidate: reg<amdgpu.sgpr>):
  %result = s_cselect_b32 %candidate, %fallback, %valid
  return %result
}

// ----
  s_cmp_lt_u32 s0, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_add_u32 s3, s0, s1
  s_branch .Lbb3
.Lbb2:
  s_mov_b32 s3, s0
.Lbb3:
  s_cmp_lt_u32 s0, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cselect_b32 s0, s3, s2
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @scc_compare_survives_loop_backedge

amdgpu.target<gfx1100> @target

// The initial range check remains the selection predicate on every iteration;
// the induction update and loop-exit check both overwrite SCC.
low.func.def target<amdgpu.rdna3.core>(@target) @scc_compare_survives_loop_backedge(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %valid = s_cmp_lt_u32 %ordinal, %limit
  %one = s_mov_b32 1
  low.br ^loop(%ordinal: reg<amdgpu.sgpr>)
^loop(%index: reg<amdgpu.sgpr>):
  %selected = s_cselect_b32 %index, %fallback, %valid
  %next = s_add_u32 %index, %one
  %again = s_cmp_lt_u32 %next, %limit
  low.cond_br %again, ^latch, ^done : reg<amdgpu.scc>
^latch:
  low.br ^loop(%next: reg<amdgpu.sgpr>)
^done:
  return %selected
}

// ----
  s_mov_b32 s3, 1
  s_mov_b32 s4, s0
.Lbb1:
  s_cmp_lt_u32 s0, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cselect_b32 s5, s4, s2
  s_add_u32 s4, s4, s3
  s_cmp_lt_u32 s4, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_branch .Lbb1
.Lbb3:
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @scc_compare_crosses_transparent_blocks

amdgpu.target<gfx1100> @target

// There is no SCC writer between producer and consumer, so one comparison is
// sufficient across both edges.
low.func.def target<amdgpu.rdna3.core>(@target) @scc_compare_crosses_transparent_blocks(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %valid = s_cmp_lt_u32 %ordinal, %limit
  low.br ^control
^control:
  %candidate = copy %ordinal : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^consume
^consume:
  %result = s_cselect_b32 %candidate, %fallback, %valid
  return %result
}

// ----
  s_cmp_lt_u32 s1, s0
.Lbb1:
.Lbb2:
  s_delay_alu instid0(SALU_CYCLE_2)
  s_cselect_b32 s0, s1, s2
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @scc_copy_crosses_transparent_blocks

amdgpu.target<gfx1100> @target

// An explicit state copy preserves the same condition. Its lifetime starts
// after the comparison rather than treating the comparison as a clobber.
low.func.def target<amdgpu.rdna3.core>(@target) @scc_copy_crosses_transparent_blocks(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %valid = s_cmp_lt_u32 %ordinal, %limit
  %alias = copy %valid : reg<amdgpu.scc> -> reg<amdgpu.scc>
  low.br ^control
^control:
  %candidate = copy %ordinal : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^consume
^consume:
  %result = s_cselect_b32 %candidate, %fallback, %alias
  return %result
}

// ----
  s_cmp_lt_u32 s1, s0
.Lbb1:
.Lbb2:
  s_delay_alu instid0(SALU_CYCLE_2)
  s_cselect_b32 s0, s1, s2
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @scc_block_argument_crosses_transparent_block

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @scc_block_argument_crosses_transparent_block(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %valid = s_cmp_lt_u32 %ordinal, %limit
  low.br ^control(%valid: reg<amdgpu.scc>)
^control(%condition: reg<amdgpu.scc>):
  %candidate = copy %ordinal : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^consume
^consume:
  %result = s_cselect_b32 %candidate, %fallback, %condition
  return %result
}

// ----
  s_cmp_lt_u32 s1, s0
.Lbb1:
.Lbb2:
  s_delay_alu instid0(SALU_CYCLE_2)
  s_cselect_b32 s0, s1, s2
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @scc_compare_rematerializes_for_repeated_assertion_branches

amdgpu.target<gfx1100> @target

// Two lowered assertions may branch on the same source predicate. The first
// branch consumes SCC, while work on its success path may clobber SCC before
// the second branch. The source comparison must be rematerialized there.
low.func.def target<amdgpu.rdna3.core>(@target) @scc_compare_rematerializes_for_repeated_assertion_branches(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %increment: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %valid = s_cmp_lt_u32 %ordinal, %limit
  low.cond_br %valid, ^second_assertion, ^failure : reg<amdgpu.scc>
^second_assertion:
  %advanced = s_add_u32 %ordinal, %increment
  low.cond_br %valid, ^success, ^failure : reg<amdgpu.scc>
^success:
  return %advanced
^failure:
  return %ordinal
}

// ----
  s_cmp_lt_u32 s2, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb1:
  s_add_u32 s0, s2, s0
  s_cmp_lt_u32 s2, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_endpgm
.Lbb3:
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @imported_scc_clobber_is_diagnosed

amdgpu.target<gfx1100> @target

// Imported state has no recomputable definition. The compiler names the value
// and the instruction that loses it instead of selecting with the add carry.
low.func.def target<amdgpu.rdna3.core>(@target) @imported_scc_clobber_is_diagnosed(%ordinal: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>, %valid: reg<amdgpu.scc>) -> (reg<amdgpu.sgpr>) asm {
  low.br ^control
^control:
  // ERROR@+1: BACKEND/048 {function_name="imported_scc_clobber_is_diagnosed", block_name="control", value_name="valid", clobber_packet="amdgpu.s_add_u32"}
  %advanced = s_add_u32 %ordinal, %limit
  low.br ^consume
^consume:
  %result = s_cselect_b32 %advanced, %fallback, %valid
  return %result
}

// ====
// RUN: emit amdgpu-assembly @borrow_chain_across_clobber

amdgpu.target<gfx1100> @target

// A wide comparison returns its predicate as the second result. Both the
// low-word comparison and the high-word borrow must replay after the add.
low.func.def target<amdgpu.rdna3.core>(@target) @borrow_chain_across_clobber(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>, %limit_low: reg<amdgpu.sgpr>, %limit_high: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %low_borrow = s_cmp_lt_u32 %low, %limit_low
  %difference, %borrow = s_subb_u32 %high, %limit_high, %low_borrow
  %bounded = s_cselect_b32 %low, %fallback, %borrow
  %advanced = s_add_u32 %bounded, %limit_low
  %result = s_cselect_b32 %advanced, %fallback, %borrow
  return %result
}

// ----
  s_cmp_lt_u32 s0, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_subb_u32 s5, s2, s3
  s_cselect_b32 s5, s0, s4
  s_add_u32 s5, s5, s1
  s_cmp_lt_u32 s0, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_subb_u32 s0, s2, s3
  s_cselect_b32 s0, s5, s4
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @carry_chain_preserves_arithmetic_results

amdgpu.target<gfx1100> @target

// The original arithmetic results remain live after their carry is replayed.
// A tied update consumes the high word without consuming the carry's inputs.
low.func.def target<amdgpu.rdna3.core>(@target) @carry_chain_preserves_arithmetic_results(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>, %increment_low: reg<amdgpu.sgpr>, %increment_high: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %low_sum, %low_carry = s_add_co_u32 %low, %increment_low
  %high_sum, %carry = s_addc_u32 %high, %increment_high, %low_carry
  %bounded = s_cselect_b32 %low_sum, %fallback, %carry
  %updated = s_addk_i32 %high_sum, 1
  %advanced = s_add_u32 %bounded, %updated
  %result = s_cselect_b32 %advanced, %low_sum, %carry
  return %result, %updated
}

// ----
  s_add_u32 s5, s1, s2
  s_addc_u32 s6, s3, s4
  s_add_u32 s7, s1, s2
  s_addc_u32 s7, s3, s4
  s_cselect_b32 s0, s5, s0
  s_addk_i32 s6, 1
  s_add_u32 s0, s0, s6
  s_add_u32 s1, s1, s2
  s_addc_u32 s1, s3, s4
  s_cselect_b32 s0, s0, s5
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @inline_borrow_crosses_branch

amdgpu.target<gfx1100> @target

// Immediate variants retain the same explicit state dependency through a
// source-order boundary, even when the arithmetic high word is unused.
low.func.def target<amdgpu.rdna3.core>(@target) @inline_borrow_crosses_branch(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %low_difference, %low_borrow = s_sub_co_u32_rhs_inline %low, 63
  %high_difference, %borrow = s_subb_u32_lhs_inline %high, %low_borrow, 0
  %bounded = s_cselect_b32 %low_difference, %fallback, %borrow
  %advanced = s_add_u32 %bounded, %high
  low.cond_br %borrow, ^success, ^failure : reg<amdgpu.scc>
^success:
  return %advanced
^failure:
  return %fallback
}

// ----
  s_sub_u32 s3, s0, 63
  s_sub_u32 s4, s0, 63
  s_subb_u32 s4, 0, s1
  s_cselect_b32 s3, s3, s2
  s_add_u32 s3, s3, s1
  s_sub_u32 s0, s0, 63
  s_subb_u32 s0, 0, s1
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_endpgm
.Lbb2:
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @inline_carry_crosses_blocks

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @inline_carry_crosses_blocks(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %low_sum, %low_carry = s_add_co_u32_rhs_inline %low, 1
  %high_sum, %carry = s_addc_u32_rhs_inline %high, %low_carry, 0
  %bounded = s_cselect_b32 %low_sum, %fallback, %carry
  low.br ^advance
^advance:
  %advanced = s_add_u32 %bounded, %high_sum
  low.br ^consume
^consume:
  %result = s_cselect_b32 %advanced, %fallback, %carry
  return %result
}

// ----
  s_add_u32 s3, s0, 1
  s_addc_u32 s4, s1, 0
  s_add_u32 s5, s0, 1
  s_addc_u32 s5, s1, 0
  s_cselect_b32 s3, s3, s2
.Lbb1:
  s_add_u32 s3, s3, s4
.Lbb2:
  s_add_u32 s0, s0, 1
  s_addc_u32 s0, s1, 0
  s_cselect_b32 s0, s3, s2
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @carry_recipe_shares_arithmetic_and_state_inputs

amdgpu.target<gfx1201> @target

// Both inputs of the high step come from one low step. Each replay must clone
// that predecessor once and wire both of its results to the same successor.
low.func.def target<amdgpu.rdna4.core>(@target) @carry_recipe_shares_arithmetic_and_state_inputs(%value: reg<amdgpu.sgpr>, %increment: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %sum, %carry = s_add_co_u32 %value, %increment
  %extended_sum, %extended_carry = s_addc_u32 %sum, %increment, %carry
  %bounded = s_cselect_b32 %extended_sum, %fallback, %extended_carry
  %advanced = s_add_u32 %bounded, %value
  %result = s_cselect_b32 %advanced, %sum, %extended_carry
  return %result
}

// ----
  s_add_u32 s3, s1, s2
  s_addc_u32 s4, s3, s2
  s_add_u32 s5, s1, s2
  s_addc_u32 s5, s5, s2
  s_cselect_b32 s0, s4, s0
  s_add_u32 s0, s0, s1
  s_add_u32 s1, s1, s2
  s_addc_u32 s1, s1, s2
  s_cselect_b32 s0, s0, s3
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @borrow_from_imported_state_is_not_replayable

amdgpu.target<gfx1100> @target

// Replay cannot reconstruct an imported carry, even when its consumer has a
// replay declaration. A clobber still requires a diagnostic at its owner.
low.func.def target<amdgpu.rdna3.core>(@target) @borrow_from_imported_state_is_not_replayable(%value: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %fallback: reg<amdgpu.sgpr>, %incoming_borrow: reg<amdgpu.scc>) -> (reg<amdgpu.sgpr>) asm {
  %difference, %borrow = s_subb_u32 %value, %limit, %incoming_borrow
  %bounded = s_cselect_b32 %value, %fallback, %borrow
  low.br ^advance
^advance:
  // ERROR@+1: BACKEND/048 {function_name="borrow_from_imported_state_is_not_replayable", block_name="advance", value_name="borrow", clobber_packet="amdgpu.s_add_u32"}
  %advanced = s_add_u32 %bounded, %limit
  low.br ^consume
^consume:
  %result = s_cselect_b32 %advanced, %fallback, %borrow
  return %result
}

// ----
