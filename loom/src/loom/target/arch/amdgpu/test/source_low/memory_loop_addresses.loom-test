// RUN: with-checks emit source-low target=amdgpu:gfx1151 output=low

// An odd step alternates banks, including a nonzero entry phase. Every lane's
// complete packet fits inside a bank; the loop also carries an authored value.
kernel.def @alternating_banks() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %banks = buffer.view %scratch[%base] : buffer -> view<2x32x4xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x4xi32>
  %begin = index.constant 1 : index
  %end = index.constant 10 : index
  %step = index.constant 3 : index
  %bank_count = index.constant 2 : index
  %initial = vector.splati 7 : vector<4xi32>
  %final = scf.for %iteration = [%begin to %end step %step](%carried = %initial : vector<4xi32>) -> (vector<4xi32>) {
    %bank = index.rem %iteration, %bank_count : index
    vector.store<volatile> %carried, %banks[%bank, %lane, 0] : vector<4xi32>, view<2x32x4xi32>
    %loaded = vector.load<volatile> %banks[%bank, %lane, 0] : view<2x32x4xi32> -> vector<4xi32>
    scf.yield %loaded : vector<4xi32>
  }
  vector.store %final, %result[%lane, 0] : vector<4xi32>, view<32x4xi32>
  kernel.return
}

// ----
CHECK: * = v_add_u32_lit *, 512
CHECK: ^*(%iteration: reg<amdgpu.sgpr>, %carried: reg<amdgpu.vgpr x4>, *: reg<amdgpu.vgpr>):
CHECK: ds_write_b128<volatile> *, %carried
CHECK: %loaded = ds_read_b128<volatile> *
CHECK: * = v_xor_b32_lit *, 512
CHECK: low.br ^*(*: reg<amdgpu.sgpr>, %loaded: reg<amdgpu.vgpr x4>, *: reg<amdgpu.vgpr>)
CHECK-NOT: %bank = *

// ====

// The logical banks overlap physically. Addition remains necessary when a
// lane's packet can set the purported bank bit independently of the phase.
kernel.def @overlapping_bank_footprints() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 768 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %stride = index.constant 64 : index
  %layout = encoding.layout.strided [%stride, 4, 1] : encoding<layout>
  %banks = buffer.view %scratch[%base] : buffer -> view<2x32x4xi32, %layout>
  %result = buffer.view %output[%base] : buffer -> view<32x4xi32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %bank_count = index.constant 2 : index
  %initial = vector.splati 7 : vector<4xi32>
  %final = scf.for %iteration = [%begin to %end step %step](%carried = %initial : vector<4xi32>) -> (vector<4xi32>) {
    %bank = index.rem %iteration, %bank_count : index
    vector.store<volatile> %carried, %banks[%bank, %lane, 0] : vector<4xi32>, view<2x32x4xi32, %layout>
    %loaded = vector.load<volatile> %banks[%bank, %lane, 0] : view<2x32x4xi32, %layout> -> vector<4xi32>
    scf.yield %loaded : vector<4xi32>
  }
  vector.store %final, %result[%lane, 0] : vector<4xi32>, view<32x4xi32>
  kernel.return
}

// ----
CHECK: ^*(%iteration: reg<amdgpu.sgpr>, %carried: reg<amdgpu.vgpr x4>):
CHECK: %bank = s_and_b32 *
CHECK: ds_write_b128<volatile> *, %carried
CHECK: %loaded = ds_read_b128<volatile> *
CHECK-NOT: * = v_xor_b32*

// ====

// A single access per root cannot amortize a shifted descriptor, even when
// the loop has a clamped uniform term and a large static row bias.
kernel.def @sparse_buffer_origins() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%left: buffer, %right: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %left_view = buffer.view %left[%base] : buffer -> view<1024x16xi32>
  %right_view = buffer.view %right[%base] : buffer -> view<1024x16xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %last = index.constant 2 : index
  %width = index.constant 4 : index
  %distance = index.constant 128 : index
  %row = index.add %lane, %distance : index
  scf.for %iteration = [%begin to %end step %step] {
    %clamped = index.min %iteration, %last : index
    %column = index.mul %clamped, %width : index
    %first = vector.load %left_view[%lane, %column] : view<1024x16xi32> -> vector<4xi32>
    %second = vector.load %right_view[%row, %column] : view<1024x16xi32> -> vector<4xi32>
    vector.store %first, %result[%lane, 0] : vector<4xi32>, view<32x8xi32>
    vector.store %second, %result[%lane, 4] : vector<4xi32>, view<32x8xi32>
  }
  kernel.return
}

// ----
CHECK: * = s_mov_b32 4112
CHECK: %clamped = s_min_i32 %iteration, %last
CHECK: * = s_add_co_u32 *
CHECK: * = s_addc_u32 *
CHECK: %first = global_load_b128_saddr *
CHECK: %second = global_load_b128_saddr * {offset = 4080}
CHECK-NOT: * = buffer_load_b128 *

// ====

// Repeated row biases on two roots pay for one shifted descriptor per root.
// Interleaved roots share the clamped loop term without merging their costs;
// row biases remain scalar/immediate offsets.
kernel.def @reused_buffer_origins() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%left: buffer, %right: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %left_view = buffer.view %left[%base] : buffer -> view<1024x16xi32>
  %right_view = buffer.view %right[%base] : buffer -> view<1024x16xi32>
  %result = buffer.view %output[%base] : buffer -> view<32x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %last = index.constant 2 : index
  %width = index.constant 4 : index
  %distance_one = index.constant 128 : index
  %distance_two = index.constant 256 : index
  %distance_three = index.constant 384 : index
  %row_one = index.add %lane, %distance_one : index
  %row_two = index.add %lane, %distance_two : index
  %row_three = index.add %lane, %distance_three : index
  scf.for %iteration = [%begin to %end step %step] {
    %clamped = index.min %iteration, %last : index
    %column = index.mul %clamped, %width : index
    %left_zero = vector.load %left_view[%lane, %column] : view<1024x16xi32> -> vector<4xi32>
    %right_zero = vector.load %right_view[%lane, %column] : view<1024x16xi32> -> vector<4xi32>
    %left_one = vector.load %left_view[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %right_one = vector.load %right_view[%row_one, %column] : view<1024x16xi32> -> vector<4xi32>
    %left_two = vector.load %left_view[%row_two, %column] : view<1024x16xi32> -> vector<4xi32>
    %right_two = vector.load %right_view[%row_two, %column] : view<1024x16xi32> -> vector<4xi32>
    %left_three = vector.load %left_view[%row_three, %column] : view<1024x16xi32> -> vector<4xi32>
    %right_three = vector.load %right_view[%row_three, %column] : view<1024x16xi32> -> vector<4xi32>
    %left_pair = vector.addi %left_zero, %left_one : vector<4xi32>
    %left_triple = vector.addi %left_pair, %left_two : vector<4xi32>
    %left_sum = vector.addi %left_triple, %left_three : vector<4xi32>
    %right_pair = vector.addi %right_zero, %right_one : vector<4xi32>
    %right_triple = vector.addi %right_pair, %right_two : vector<4xi32>
    %right_sum = vector.addi %right_triple, %right_three : vector<4xi32>
    vector.store %left_sum, %result[%lane, 0] : vector<4xi32>, view<32x8xi32>
    vector.store %right_sum, %result[%lane, 4] : vector<4xi32>, view<32x8xi32>
  }
  kernel.return
}

// ----
CHECK: * = s_mov_b32 4112
CHECK: %clamped = s_min_i32 %iteration, %last
CHECK: * = s_lshl_b32_rhs_inline %clamped, 4
CHECK: * = s_add_co_u32 *
CHECK: * = s_addc_u32 *
CHECK: * = s_sub_u32 *
CHECK: * = concat(*) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
CHECK: %left_zero = buffer_load_b128 *
CHECK: %right_zero = buffer_load_b128 *
CHECK: %left_three = buffer_load_b128 * {offset = 4080}
CHECK: %right_three = buffer_load_b128 * {offset = 4080}
CHECK-NOT: * = global_load_b128_saddr *
CHECK-NOT: * = s_max_u32 *

// ====

// A preheader access publishes an exact plane origin. Each loop access adds a
// distinct lane term and the same clamped iteration term, so the retained
// origin covers only part of each invariant address. The target composes each
// lane residual once and still shifts one resource descriptor by the uniform
// loop term.
kernel.def @partial_retained_buffer_origins() {
  %unit_count = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_count, %unit_count, %unit_count) workgroup_size(%threads, %unit_count, %unit_count) : index
} launch(%input: buffer) {
  %lane = kernel.workitem.id<x> : index
  %c2 = index.constant 2 : index
  %plane = index.rem %lane, %c2 : index
  %row_group = index.div %lane, %c2 : index
  %plane_stride = index.constant 16 : index
  %plane_row = index.madd %plane, %plane_stride, %row_group : index
  %plane_extent = index.constant 32768 : index
  %plane_base = index.mul %plane_row, %plane_extent : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1048576xi32>
  %seed = vector.load<volatile> %source[%plane_base] : view<1048576xi32> -> vector<4xi32>
  %row_stride = index.constant 16 : index
  %distance_one = index.constant 128 : index
  %distance_two = index.constant 256 : index
  %distance_three = index.constant 384 : index
  %distance_four = index.constant 512 : index
  %distance_five = index.constant 640 : index
  %distance_six = index.constant 768 : index
  %distance_seven = index.constant 896 : index
  %lane_two = index.mul %lane, %c2 : index
  %c3 = index.constant 3 : index
  %lane_three = index.mul %lane, %c3 : index
  %c4 = index.constant 4 : index
  %lane_four = index.mul %lane, %c4 : index
  %c5 = index.constant 5 : index
  %lane_five = index.mul %lane, %c5 : index
  %c6 = index.constant 6 : index
  %lane_six = index.mul %lane, %c6 : index
  %c7 = index.constant 7 : index
  %lane_seven = index.mul %lane, %c7 : index
  %c8 = index.constant 8 : index
  %lane_eight = index.mul %lane, %c8 : index
  %row_one = index.add %lane_two, %distance_one : index
  %row_two = index.add %lane_three, %distance_two : index
  %row_three = index.add %lane_four, %distance_three : index
  %row_four = index.add %lane_five, %distance_four : index
  %row_five = index.add %lane_six, %distance_five : index
  %row_six = index.add %lane_seven, %distance_six : index
  %row_seven = index.add %lane_eight, %distance_seven : index
  %row_zero_base = index.madd %lane, %row_stride, %plane_base : index
  %row_one_base = index.madd %row_one, %row_stride, %plane_base : index
  %row_two_base = index.madd %row_two, %row_stride, %plane_base : index
  %row_three_base = index.madd %row_three, %row_stride, %plane_base : index
  %row_four_base = index.madd %row_four, %row_stride, %plane_base : index
  %row_five_base = index.madd %row_five, %row_stride, %plane_base : index
  %row_six_base = index.madd %row_six, %row_stride, %plane_base : index
  %row_seven_base = index.madd %row_seven, %row_stride, %plane_base : index
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %last = index.constant 2 : index
  %width = index.constant 4 : index
  scf.for %iteration = [%begin to %end step %step] {
    %clamped = index.min %iteration, %last : index
    %position_zero = index.madd %clamped, %width, %row_zero_base : index
    %position_one = index.madd %clamped, %width, %row_one_base : index
    %position_two = index.madd %clamped, %width, %row_two_base : index
    %position_three = index.madd %clamped, %width, %row_three_base : index
    %position_four = index.madd %clamped, %width, %row_four_base : index
    %position_five = index.madd %clamped, %width, %row_five_base : index
    %position_six = index.madd %clamped, %width, %row_six_base : index
    %position_seven = index.madd %clamped, %width, %row_seven_base : index
    %zero = vector.load<volatile> %source[%position_zero] : view<1048576xi32> -> vector<4xi32>
    %one = vector.load<volatile> %source[%position_one] : view<1048576xi32> -> vector<4xi32>
    %two_value = vector.load<volatile> %source[%position_two] : view<1048576xi32> -> vector<4xi32>
    %three_value = vector.load<volatile> %source[%position_three] : view<1048576xi32> -> vector<4xi32>
    %four_value = vector.load<volatile> %source[%position_four] : view<1048576xi32> -> vector<4xi32>
    %five_value = vector.load<volatile> %source[%position_five] : view<1048576xi32> -> vector<4xi32>
    %six_value = vector.load<volatile> %source[%position_six] : view<1048576xi32> -> vector<4xi32>
    %seven_value = vector.load<volatile> %source[%position_seven] : view<1048576xi32> -> vector<4xi32>
  }
  kernel.return
}

