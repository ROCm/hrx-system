// ====

// The workgroup offset is added to a copy of the pointer; the static prefetch
// and both loads keep the original resource.
kernel.def @prefetch_workgroup_id_base_copy() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  %workgroups = index.constant 16 : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %workgroup = kernel.workgroup.id<x> : index
  %c0 = index.constant 0 : offset
  %input_view = buffer.view %input[%c0] : buffer -> view<1024xi32>
  %output_view = buffer.view %output[%c0] : buffer -> view<64xi32>
  %before = view.load %input_view[%lane] : view<1024xi32> -> i32
  // REMARK@+1: BACKEND/041 "selected prefetch 'read/l2'" "dynamic index 'sbase'" "count 0"
  view.prefetch %input_view[%workgroup] {intent = read, locality = l2} : view<1024xi32>
  %c7 = index.constant 7 : index
  // REMARK@+1: BACKEND/041 "selected prefetch 'read/l2'" "immediate offset 28" "count 0"
  view.prefetch %input_view[%c7] {intent = read, locality = l2} : view<1024xi32>
  %c64 = index.constant 64 : index
  %next = index.add %lane, %c64 : index
  %after = view.load %input_view[%next] : view<1024xi32> -> i32
  %sum = scalar.addi %before, %after : i32
  view.store %sum, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(16, 1, 1) @prefetch_workgroup_id_base_copy() asm {
  %workgroup = live_in<amdgpu.cluster_id_x> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 4096, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = v_lshlrev_b32_src0_inline %lane, 2
  %before = global_load_b32_saddr %20, %input_view
  %22 = s_lshl_b32_rhs_inline %workgroup, 2
  %23 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = s_mov_b32 0
  %26, %27 = s_add_co_u32 %23, %22
  %28, %29 = s_addc_u32 %24, %25, %27
  %30 = concat(%26, %28) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  s_prefetch_data %30, %25 {count = 0}
  s_prefetch_data %input_view, %25 {offset = 28, count = 0}
  %after = global_load_b32_saddr %20, %input_view {offset = 256}
  %sum = v_add_u32 %before, %after
  global_store_b32_saddr %20, %sum, %output_view
  return
}
