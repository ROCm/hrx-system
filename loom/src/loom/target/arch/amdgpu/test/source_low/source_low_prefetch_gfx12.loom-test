func.def @prefetch_offset_exceeds_immediate(%input: buffer) {
  %base = index.constant 33554432 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  // REMARK@+1: BACKEND/041 "selected prefetch 'read/l1'" "immediate offset 8388604" "scalar byte offset 25165844" "count 0"
  view.prefetch %input_view[4] {intent = read, locality = l1} : view<64xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna4.core> abi(hal_kernel) @prefetch_offset_exceeds_immediate() asm {
  %input_view = resource<hal_binding> {extent = 33554688, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %4 = s_mov_b32 25165844
  %5 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %6 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %7 = s_mov_b32 0
  %8, %9 = s_add_co_u32 %5, %4
  %10, %11 = s_addc_u32 %6, %7, %9
  %12 = concat(%8, %10) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  s_prefetch_data %12, %7 {offset = 8388604, count = 0}
  return
}

