  %base = index.constant 8388592 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  // REMARK@+1: BACKEND/041 "selected prefetch 'read/l1'" "immediate offset 8388604" "scalar byte offset 4" "count 0"
  view.prefetch %input_view[4] {intent = read, locality = l1} : view<64xi32>
  func.return
