low.kernel.def target(@a0) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @a0_lds_two_address_selection() asm<amdgpu.rdna4.gfx125x.core> {
  %workitem = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %58 = storage {byte_alignment = 16, byte_length = 2048} : low.storage<workgroup>
  %one = s_mov_b32 1
  %two = s_mov_b32 2
  %62 = v_mov_b32_copy %one
  %63 = v_mov_b32_copy %two
  %66 = v_lshlrev_b32_src0_inline %workitem, 5
  low.op<amdgpu.ds_write_b32>(%66, %62) {offset = 0} memory_access([0, 3, 7, -1, 43, 32, 0, 4, 3, 0, 2016, 4, 2020]) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>)
  low.op<amdgpu.ds_write_b32>(%66, %63) {offset = 8} memory_access([0, 3, 7, -1, 43, 32, 8, 12, 3, 8, 2024, 12, 2028]) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>)
  %70 = low.op<amdgpu.ds_read_b32>(%66) {offset = 0} memory_access([0, 3, 7, -1, 43, 32, 0, 4, 3, 0, 2016, 4, 2020]) : (reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr>
  %72 = low.op<amdgpu.ds_read_b32>(%66) {offset = 8} memory_access([0, 3, 7, -1, 43, 32, 8, 12, 3, 8, 2024, 12, 2028]) : (reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr>
  %loaded = concat(%70, %72) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %74 = v_lshlrev_b32_src0_inline %workitem, 3
  global_store_b64_saddr %74, %loaded, %output_view
  return
}

low.kernel.def target(@b0) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @b0_lds_two_address_selection() asm<amdgpu.rdna4.gfx125x.core> {
  %workitem = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
