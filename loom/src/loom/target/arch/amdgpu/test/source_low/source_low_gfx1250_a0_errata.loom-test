// RUN: emit source-low output=low

amdgpu.target<gfx1250> @target {gfx1250_revision = a0}

kernel.def target(@target) @a0_lds_two_address_selection() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%output: buffer) {
  %workitem = kernel.workitem.id<x> : index
  %zero = index.constant 0 : offset
  %bytes = index.constant 2048 : offset
  %layout = encoding.layout.strided [8, 2] : encoding<layout>
  %scratch = buffer.alloca %bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %scratch_view = buffer.view %scratch[%zero] : buffer -> view<64x4xi32, %layout>
  %output_view = buffer.view %output[%zero] : buffer -> view<64x2xi32, #dense>
  %one = vector.constant 1 : vector<2xi32>
  // ERROR@+1: AMDGPU/047 {function_name="a0_lds_two_address_selection", descriptor_name="amdgpu.ds_write2_b32", revision="a0", erratum_key="gfx1250.a0.ds2_alignment", legalization_key="split_ds2_to_single_address"}
  vector.store %one, %scratch_view[%workitem, 0] : vector<2xi32>, view<64x4xi32, %layout>
  // ERROR@+1: AMDGPU/047 {function_name="a0_lds_two_address_selection", descriptor_name="amdgpu.ds_read2_b32", revision="a0", erratum_key="gfx1250.a0.ds2_alignment", legalization_key="split_ds2_to_single_address"}
  %loaded = vector.load %scratch_view[%workitem, 0] : view<64x4xi32, %layout> -> vector<2xi32>
  vector.store %loaded, %output_view[%workitem, 0] : vector<2xi32>, view<64x2xi32, #dense>
  kernel.return
}

// ====

amdgpu.target<gfx1250> @target {gfx1250_revision = a0}

func.def target(@target) @a0_k128_matrix_selection(%lhs_data: vector<16xi32>, %rhs_data: vector<16xi32>, %init_data: vector<8xf16>) -> (vector<8xf16>) {
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 128 : index
  %schema = encoding.define #matrix_operand<element_format=f8e5m2, payload_elements=64, payload_registers=16> : encoding<schema>
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] using {schema = %schema : encoding<schema>} : vector<16xi32>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] using {schema = %schema : encoding<schema>} : vector<16xi32>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<8xf16>
  // ERROR@+1: AMDGPU/047 {function_name="a0_k128_matrix_selection", descriptor_name="amdgpu.v_wmma_f16_16x16x128_bf8_bf8", revision="a0", erratum_key="gfx1250.a0.wmma_k128_fp8_bf8", legalization_key="split_wmma_k128_to_regular_scale_k64"}
  %result = vector.mma %lhs, %rhs, %init : vector<16xi32>, vector<16xi32>, vector<8xf16>
  func.return %result : vector<8xf16>
}

