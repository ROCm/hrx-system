func.def target(@target) @a0_sparse_f32_matrix_selection(%lhs_data: vector<8xi32>, %rhs_data: vector<16xi32>, %init_data: vector<8xf32>, %metadata: vector<2xi32>) -> (vector<8xf32>) {
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 128 : index
  %lhs_schema = encoding.define #matrix_operand<element_format=f8e4m3, payload_elements=32, payload_registers=8, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
