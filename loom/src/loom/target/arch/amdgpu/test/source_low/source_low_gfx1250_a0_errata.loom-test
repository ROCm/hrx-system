  low.op<amdgpu.ds_write2_b32>(%84, %81, %82) {offset0 = 0, offset1 = 2} memory_access([0, 3, 21, -1, 43, 32, 0, 12, 3, 0, 2016, 12, 2028]) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>)
  %loaded = low.op<amdgpu.ds_read2_b32>(%84) {offset0 = 0, offset1 = 2} memory_access([0, 3, 21, -1, 43, 32, 0, 12, 3, 0, 2016, 12, 2028]) : (reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %89 = v_lshlrev_b32_src0_inline %workitem, 3
  global_store_b64_saddr %89, %loaded, %output_view
