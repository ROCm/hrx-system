func.def public target(@target) @condition_across_call(%value: vector<1xi32>, %flag: i32) -> (vector<1xi32>) {
  %c0 = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %flag, %c0 : i32
  %forwarded = func.call @identity(%value) : (vector<1xi32>) -> (vector<1xi32>)
  %selected = func.call @select_vector(%forwarded, %condition) : (vector<1xi32>, i1) -> (vector<1xi32>)
  func.return %selected : vector<1xi32>
}

