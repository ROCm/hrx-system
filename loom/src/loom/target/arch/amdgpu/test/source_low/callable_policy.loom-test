  %32 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %33 = s_mov_b64_exec_read
  %34 = slice %33[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = slice %33[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
