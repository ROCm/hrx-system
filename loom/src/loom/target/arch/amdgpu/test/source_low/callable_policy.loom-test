// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def noinline @callee(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def public target(@target) @callee_noinline(%value: i32) -> (i32) {
  %result = func.call @callee(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ----
low.func.def noinline target<amdgpu.gfx11.generic.core> @callee(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  return %value
}

low.func.def public target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @callee_noinline(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %result = low.func.call pure @callee(%value) : (reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>)
  return %result
}

