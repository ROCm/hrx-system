low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_ctpopi_i32_sgpr(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %result = s_bcnt1_i32_b32 %input
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @scalar_ctpopi_i32_vgpr(%inputs: vector<2xi32>) -> (i32) {
  %input = vector.extract %inputs[0] : vector<2xi32> -> i32
  %result = scalar.ctpopi %input : i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_ctpopi_i32_vgpr(%inputs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %input = slice %inputs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_bcnt_u32_b32_src1_zero %input
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @scalar_ctpopi_i64_to_index(%input: i64) -> (index) {
  %count_i64 = scalar.ctpopi %input : i64
  %count = index.cast %count_i64 : i64 to index
  func.return %count : index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_ctpopi_i64_to_index(%input: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>) asm {
  %6 = s_bcnt1_i32_b64 %input
  return %6
}
