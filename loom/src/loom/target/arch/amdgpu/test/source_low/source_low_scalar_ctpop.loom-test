// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @scalar_ctpopi_i64_sgpr(%input: i64) -> (i64) {
  %result = scalar.ctpopi %input : i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_ctpopi_i64_sgpr(%input: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %5 = s_bcnt1_i32_b64 %input
  %6 = s_mov_b32 0
  %result = concat(%5, %6) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @scalar_ctpopi_i64_vgpr(%inputs: vector<2xi64>) -> (i64) {
  %input = vector.extract %inputs[0] : vector<2xi64> -> i64
  %result = scalar.ctpopi %input : i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_ctpopi_i64_vgpr(%inputs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %6 = slice %inputs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %7 = slice %inputs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = v_bcnt_u32_b32_src1_zero %6
  %12 = v_bcnt_u32_b32 %7, %10
  %13 = v_mov_b32 0
  %result = concat(%12, %13) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

