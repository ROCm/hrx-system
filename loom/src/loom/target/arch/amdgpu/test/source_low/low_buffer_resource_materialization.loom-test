// ----
amdgpu.target<gfx1250> @target

low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) workgroup_size(64, 1, 1) @extended_static_record(%binding: reg<amdgpu.sgpr x2>) {
  %2 = low.slice %binding[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %3 = low.slice %binding[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %4 = low.const<amdgpu.s_mov_b32> {imm32 = 2} : reg<amdgpu.sgpr>
  %5 = low.const<amdgpu.s_mov_b32> {imm32 = 1174405120} : reg<amdgpu.sgpr>
  %6 = low.op<amdgpu.s_or_b32>(%3, %5) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
  %7 = low.const<amdgpu.s_mov_b32> {imm32 = 0} : reg<amdgpu.sgpr>
  %8 = low.concat(%2, %6) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %descriptor = low.concat(%8, %4, %7) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  low.return
}

// ====

amdgpu.target<gfx1250> @target

low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) workgroup_size(64, 1, 1) @extended_dynamic_record(%binding: reg<amdgpu.sgpr x2>, %extent: reg<amdgpu.sgpr>) {
  %descriptor = low.op<amdgpu.hal.buffer_descriptor.extent>(%binding, %extent) {cache_swizzle_stride = 0} : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  low.return
}

// ----
amdgpu.target<gfx1250> @target

low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) workgroup_size(64, 1, 1) @extended_dynamic_record(%binding: reg<amdgpu.sgpr x2>, %extent: reg<amdgpu.sgpr>) {
  %3 = low.slice %binding[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %4 = low.slice %binding[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %5 = low.op<amdgpu.s_lshl_b32.rhs_inline>(%extent) {imm32 = 25} : (reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
  %6 = low.op<amdgpu.s_or_b32>(%4, %5) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
  %7 = low.op<amdgpu.s_lshr_b32.rhs_inline>(%extent) {imm32 = 7} : (reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
  %8 = low.const<amdgpu.s_mov_b32> {imm32 = 0} : reg<amdgpu.sgpr>
  %9 = low.concat(%3, %6) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %descriptor = low.concat(%9, %7, %8) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  low.return
}

