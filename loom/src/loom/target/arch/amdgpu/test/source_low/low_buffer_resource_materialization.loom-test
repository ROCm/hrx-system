// RUN: pass amdgpu-materialize-hal-buffer-descriptors

amdgpu.target<gfx942> @target

low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(64, 1, 1) @legacy_record(%binding: reg<amdgpu.sgpr x2>) {
  %descriptor = low.op<amdgpu.hal.buffer_descriptor>(%binding) {cache_swizzle_stride = 0, extent = 16} : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  low.return
}

// ----
amdgpu.target<gfx942> @target

low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(64, 1, 1) @legacy_record(%binding: reg<amdgpu.sgpr x2>) {
  %2 = low.slice %binding[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %3 = low.slice %binding[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %4 = low.const<amdgpu.s_mov_b32> {imm32 = 65535} : reg<amdgpu.sgpr>
  %5 = low.op<amdgpu.s_and_b32>(%3, %4) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
  %6 = low.concat(%2, %5) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %7 = low.const<amdgpu.s_mov_b32> {imm32 = 16} : reg<amdgpu.sgpr>
  %8 = low.const<amdgpu.s_mov_b32> {imm32 = 159744} : reg<amdgpu.sgpr>
  %descriptor = low.concat(%6, %7, %8) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  low.return
}

