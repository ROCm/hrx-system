// RUN: emit source-low target=amdgpu:gfx90a output=low

// Integer carriers preserve uniform storage through the floating-point bitcast.
kernel.def @uniform_binary() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_bits: i64, %rhs_bits: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<3x64xf64>
  %lhs = scalar.bitcast %lhs_bits : i64 to f64
  %rhs = scalar.bitcast %rhs_bits : i64 to f64
  %sum = scalar.addf %lhs, %rhs : f64
  %difference = scalar.subf %lhs, %rhs : f64
  %product = scalar.mulf %lhs, %rhs : f64
  view.store %sum, %result_view_0[0, %fixture_lane] : f64, view<3x64xf64>
  view.store %difference, %result_view_0[1, %fixture_lane] : f64, view<3x64xf64>
  view.store %product, %result_view_0[2, %fixture_lane] : f64, view<3x64xf64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna2.core> abi_layout({constant_count = 4, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs_bits", arg1 = "rhs_bits"}, direct_arg_offsets = [0, 8], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [8, 8], parameter_count = 3, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_binary(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 1536, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %22 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %24 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = v_mov_b32_copy %24
  %26 = concat(%23, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %sum = v_add_f64 %lhs, %26
  %32 = concat(%23, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %difference = v_sub_f64 %lhs, %32
  %38 = concat(%23, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %product = v_mul_f64 %lhs, %38
  %40 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_dwordx2_saddr %40, %sum, %result_view_0
  global_store_dwordx2_saddr %40, %difference, %result_view_0 {offset = 512}
  global_store_dwordx2_saddr %40, %product, %result_view_0 {offset = 1024}
  return
}

