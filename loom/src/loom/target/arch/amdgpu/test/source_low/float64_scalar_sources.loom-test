// RUN: emit source-low target=amdgpu:gfx90a output=low

// Integer carriers preserve uniform storage through the floating-point bitcast.
kernel.def @uniform_binary() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_bits: i64, %rhs_bits: i64, %result_buffer_0: buffer, %result_buffer_1: buffer, %result_buffer_2: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xf64>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xf64>
  %result_view_2 = buffer.view %result_buffer_2[%fixture_base] : buffer -> view<64xf64>
  %lhs = scalar.bitcast %lhs_bits : i64 to f64
  %rhs = scalar.bitcast %rhs_bits : i64 to f64
  %sum = scalar.addf %lhs, %rhs : f64
  %difference = scalar.subf %lhs, %rhs : f64
  %product = scalar.mulf %lhs, %rhs : f64
  view.store %sum, %result_view_0[%fixture_lane] : f64, view<64xf64>
  view.store %difference, %result_view_1[%fixture_lane] : f64, view<64xf64>
  view.store %product, %result_view_2[%fixture_lane] : f64, view<64xf64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna2.core> abi_layout({constant_count = 4, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs_bits", arg1 = "rhs_bits"}, direct_arg_offsets = [0, 8], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [8, 8], parameter_count = 5, resource_count = 3, resource_offsets = [16, 24, 32], resource_parameter_indices = [2, 3, 4], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_binary(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_2 = resource<hal_binding> {extent = 512, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %23 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = v_mov_b32_copy %23
  %25 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = v_mov_b32_copy %25
  %27 = concat(%24, %26) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %sum = v_add_f64 %lhs, %27
  %33 = concat(%24, %26) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %difference = v_sub_f64 %lhs, %33
  %39 = concat(%24, %26) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %product = v_mul_f64 %lhs, %39
  %41 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_dwordx2_saddr %41, %sum, %result_view_0
  global_store_dwordx2_saddr %41, %difference, %result_view_1
  global_store_dwordx2_saddr %41, %product, %result_view_2
  return
}

// ====

// RUN: emit source-low target=amdgpu:gfx90a output=low

// Either operand may retain the single scalar-source slot without commuting.
func.def @mixed_binary(%varying: f64, %uniform_bits: i64) -> (f64, f64, f64, f64) {
  %uniform = scalar.bitcast %uniform_bits : i64 to f64
  %sum = scalar.addf %varying, %uniform : f64
  %left_difference = scalar.subf %varying, %uniform : f64
  %right_difference = scalar.subf %uniform, %varying : f64
  %product = scalar.mulf %varying, %uniform : f64
  func.return %sum, %left_difference, %right_difference, %product : f64, f64, f64, f64
}

// ----
low.func.def target<amdgpu.cdna2.core> abi(hal_kernel) @mixed_binary(%varying: reg<amdgpu.vgpr x2>, %uniform: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %sum = v_add_f64 %varying, %uniform
  %left_difference = v_sub_f64 %varying, %uniform
  %right_difference = v_sub_f64 %uniform, %varying
  %product = v_mul_f64 %varying, %uniform
  return %sum, %left_difference, %right_difference, %product
}

// ====

// RUN: emit source-low target=amdgpu:gfx90a output=low

// Repeated reads of the same scalar tuple consume one source slot.
func.def @repeated_source(%bits: i64) -> (f64, f64, f64) {
  %value = scalar.bitcast %bits : i64 to f64
  %sum = scalar.addf %value, %value : f64
  %product = scalar.mulf %value, %value : f64
  %fused = scalar.fmaf %value, %value, %value : f64
  func.return %sum, %product, %fused : f64, f64, f64
}

// ----
low.func.def target<amdgpu.cdna2.core> abi(hal_kernel) @repeated_source(%value: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %sum = v_add_f64 %value, %value
  %product = v_mul_f64 %value, %value
  %fused = v_fma_f64 %value, %value, %value
  return %sum, %product, %fused
}

