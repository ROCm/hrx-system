  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<4x64xf64>
  %a = scalar.bitcast %a_bits : i64 to f64
  %b = scalar.bitcast %b_bits : i64 to f64
  %c = scalar.bitcast %c_bits : i64 to f64
  %sum = scalar.addf %a, %b : f64
  %difference = scalar.subf %a, %b : f64
  %product = scalar.mulf %a, %b : f64
  %fused = scalar.fmaf %a, %b, %c : f64
  view.store %sum, %result_view_0[0, %fixture_lane] : f64, view<4x64xf64>
  view.store %difference, %result_view_0[1, %fixture_lane] : f64, view<4x64xf64>
  view.store %product, %result_view_0[2, %fixture_lane] : f64, view<4x64xf64>
  view.store %fused, %result_view_0[3, %fixture_lane] : f64, view<4x64xf64>
  kernel.return
}

