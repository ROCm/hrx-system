kernel.def @uniform_fma() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%a_bits: i64, %b_bits: i64, %c_bits: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<2x64xf64>
  %a = scalar.bitcast %a_bits : i64 to f64
  %b = scalar.bitcast %b_bits : i64 to f64
  %c = scalar.bitcast %c_bits : i64 to f64
  %distinct = scalar.fmaf %a, %b, %c : f64
  %repeated = scalar.fmaf %a, %b, %b : f64
  view.store %distinct, %result_view_0[0, %fixture_lane] : f64, view<2x64xf64>
  view.store %repeated, %result_view_0[1, %fixture_lane] : f64, view<2x64xf64>
  kernel.return
}

