// ----
low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) abi(hal_kernel) @decode_mxfp4_group_to_bf16(%payload: reg<amdgpu.vgpr x4>, %scale: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x16>) asm {
  %8 = slice %payload[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = v_cvt_scale_pk8_bf16_fp4 %8, %scale
  %10 = slice %payload[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = v_cvt_scale_pk8_bf16_fp4 %10, %scale
  %12 = slice %payload[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %13 = v_cvt_scale_pk8_bf16_fp4 %12, %scale
  %14 = slice %payload[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = v_cvt_scale_pk8_bf16_fp4 %14, %scale
  %decoded = concat(%9, %11, %13, %15) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x16>
  return %decoded
}

