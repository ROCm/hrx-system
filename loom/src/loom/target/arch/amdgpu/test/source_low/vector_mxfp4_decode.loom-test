func.def target(@target) @decode_two_mxfp4_groups_to_bf16(%payload: vector<8xi32>, %scale: vector<1xi32>) -> (vector<64xbf16>) {
  %schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=64, payload_packing=little_endian_nibbles, payload_registers=8, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %decoded = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<8xi32>, encoding<schema> -> vector<64xbf16>
  func.return %decoded : vector<64xbf16>
}

// ----
low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) abi(hal_kernel) @decode_two_mxfp4_groups_to_bf16(%payload: reg<amdgpu.vgpr x8>, %scale: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x32>) asm {
  %8 = slice %payload[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %9 = v_cvt_scale_pk8_bf16_fp4 %8, %scale
  %10 = slice %payload[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %11 = v_cvt_scale_pk8_bf16_fp4 %10, %scale
  %12 = slice %payload[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %13 = v_cvt_scale_pk8_bf16_fp4 %12, %scale
  %14 = slice %payload[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %15 = v_cvt_scale_pk8_bf16_fp4 %14, %scale
  %16 = slice %payload[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %17 = v_cvt_scale_pk8_bf16_fp4 %16, %scale {scale_sel = 1}
  %18 = slice %payload[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %19 = v_cvt_scale_pk8_bf16_fp4 %18, %scale {scale_sel = 1}
  %20 = slice %payload[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %21 = v_cvt_scale_pk8_bf16_fp4 %20, %scale {scale_sel = 1}
  %22 = slice %payload[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %23 = v_cvt_scale_pk8_bf16_fp4 %22, %scale {scale_sel = 1}
  %decoded = concat(%9, %11, %13, %15, %17, %19, %21, %23) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x32>
  return %decoded
}
