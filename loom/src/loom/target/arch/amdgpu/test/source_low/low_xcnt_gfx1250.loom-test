// RUN: emit amdgpu-assembly @vmem_exec_reuse_requires_xcnt

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @vmem_exec_reuse_requires_xcnt(%addr: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %saved_exec: reg<amdgpu.sgpr x2>) asm {
  %loaded = global_load_b32_saddr %addr, %base
  s_mov_b64_exec %saved_exec
  %used = v_add_u32 %loaded, %addr
  return
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  s_wait_xcnt xcnt(0)
  s_mov_b64 exec, s[2:3]
  s_wait_loadcnt loadcnt(0)
  v_add_u32 v0, v1, v0
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @exec_drain_preserves_smem_source

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @exec_drain_preserves_smem_source(%kernarg: reg<amdgpu.sgpr x2>, %saved_exec: reg<amdgpu.sgpr x2>, %keep: reg<amdgpu.sgpr>) asm {
  %loaded = s_load_dword_offset_only %kernarg
  s_mov_b64_exec %saved_exec
  %reuse = s_mov_b32 7
  %sum0 = s_add_u32 %loaded, %keep
  %sum1 = s_add_u32 %sum0, %reuse
  return
}

// EXEC changes require VMEM XCNT completion. They do not complete the scalar
// load's source read, so reusing its base still requires an XCNT wait.
// ----
  s_load_dword s5, s[0:1], 0
  s_mov_b32 s6, 7
  s_mov_b64 exec, s[2:3]
  s_wait_kmcnt kmcnt(0)
  s_add_u32 s2, s5, s4
  s_add_u32 s2, s2, s6
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @cross_block_vmem_exec_reuse_requires_xcnt

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @cross_block_vmem_exec_reuse_requires_xcnt(%addr: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %saved_exec: reg<amdgpu.sgpr x2>) asm {
  global_store_b32_saddr %addr, %value, %base
  low.br ^restore
^restore:
  s_mov_b64_exec %saved_exec
  return
}

// A fallthrough block is still a control-flow boundary in the source program.
// EXEC remains an XCNT source of the outstanding store until the successor
// drains it, even though no hardware branch packet is emitted on this edge.
// ----
  global_store_b32 v0, v1, s[0:1] offset:0
.Lbb1:
  s_wait_xcnt xcnt(0)
  s_mov_b64 exec, s[2:3]
  s_wait_storecnt storecnt(0)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @native_branch_releases_xcnt_source

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @native_branch_releases_xcnt_source(%address: reg<amdgpu.vgpr>, %keep: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b32_saddr %address, %base
  low.cond_br %condition, ^left, ^right : reg<amdgpu.scc>
^left:
  %left_value = v_mov_b32 7
  %left_sum = v_add_u32 %loaded, %keep
  %left_result = v_add_u32 %left_sum, %left_value
  return %left_result
^right:
  %right_value = v_mov_b32 9
  %right_sum = v_add_u32 %loaded, %keep
  %right_result = v_add_u32 %right_sum, %right_value
  return %right_result
}

// The conditional branch drains XCNT on both paths, so each successor can
// reuse the dead address register without an explicit wait or a fourth VGPR.
// ----
  global_load_b32 v2, v0, s[0:1] offset:0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_wait_loadcnt loadcnt(0)
  v_add_u32 v0, v2, v1
  v_mov_b32 v1, 7
  s_delay_alu instid0(VALU_DEP_1) | instid1(VALU_DEP_2)
  v_add_u32 v0, v0, v1
  s_endpgm
.Lbb2:
  s_wait_loadcnt loadcnt(0)
  v_add_u32 v0, v2, v1
  v_mov_b32 v1, 9
  s_delay_alu instid0(VALU_DEP_1) | instid1(VALU_DEP_2)
  v_add_u32 v0, v0, v1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @fallthrough_preserves_xcnt_source

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @fallthrough_preserves_xcnt_source(%address: reg<amdgpu.vgpr>, %keep: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b32_saddr %address, %base
  low.br ^next
^next:
  %next_value = v_mov_b32 7
  %next_sum = v_add_u32 %loaded, %keep
  %result = v_add_u32 %next_sum, %next_value
  return %result
}

// A fallthrough emits no native branch and cannot release the source lease.
// The new value therefore uses v3 while XCNT still owns address register v0.
// ----
  global_load_b32 v2, v0, s[0:1] offset:0
.Lbb1:
  s_wait_loadcnt loadcnt(0)
  v_add_u32 v1, v2, v1
  v_mov_b32 v2, 7
  s_delay_alu instid0(VALU_DEP_1) | instid1(VALU_DEP_2)
  v_add_u32 v1, v1, v2
  s_endpgm
