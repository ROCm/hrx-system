// RUN: pass target=amdgpu:gfx11-generic source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// Power-of-two recipes have the same producer contract in the vector bank.
func.def target(@target) @power_of_two_into_wide_loop(%input_value: index, %increment_word: i64, %again: i1) -> (i64, i64) {
  %input = index.assume %input_value [range(%input_value, 0, 4294967295)] : index
  %divisor = index.constant 32 : index
  %modulus = index.constant 64 : index
  %quotient = index.div %input, %divisor : index
  %remainder = index.rem %input, %modulus : index
  %increment = index.cast %increment_word : i64 to index
  cfg.br ^loop(%quotient: index, %remainder: index)
^loop(%first: index, %second: index):
  cfg.cond_br %again, ^advance, ^exit
^advance:
  %next_first = index.add %first, %increment : index
  %next_second = index.add %second, %increment : index
  cfg.br ^loop(%next_first: index, %next_second: index)
^exit:
  %first_word = index.cast %first : index to i64
  %second_word = index.cast %second : index to i64
  func.return %first_word, %second_word : i64, i64
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @power_of_two_into_wide_loop(%input: reg<amdgpu.vgpr>, %increment: reg<amdgpu.vgpr x2>, %again: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %quotient = v_lshrrev_b32_src0_inline %input, 5
  %remainder = v_and_b32_lit %input, 63
  %28 = v_mov_b32 0
  %29 = concat(%quotient, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %30 = v_mov_b32 0
  %31 = concat(%remainder, %30) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^_bb4(%29: reg<amdgpu.vgpr x2>, %31: reg<amdgpu.vgpr x2>)
^_bb4(%first: reg<amdgpu.vgpr x2>, %second: reg<amdgpu.vgpr x2>):
  %32 = s_mov_b64_exec_read
  low.br ^loop(%first: reg<amdgpu.vgpr x2>, %second: reg<amdgpu.vgpr x2>)
^loop(%first_word: reg<amdgpu.vgpr x2>, %second_word: reg<amdgpu.vgpr x2>):
  %33, %34 = s_and_saveexec_b64 %again
  low.cond_br %34, ^advance, ^_bb5 : reg<amdgpu.scc>
^advance:
  %35 = slice %first_word[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %36 = slice %first_word[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %37 = slice %increment[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %38 = slice %increment[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %39, %40 = v_add_co_u32 %35, %37
  %41, %42 = v_add_co_ci_u32 %36, %38, %40
  %next_first = concat(%39, %41) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %44 = slice %second_word[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %45 = slice %second_word[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %46 = slice %increment[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %47 = slice %increment[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %48, %49 = v_add_co_u32 %44, %46
  %50, %51 = v_add_co_ci_u32 %45, %47, %49
  %next_second = concat(%48, %50) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^loop(%next_first: reg<amdgpu.vgpr x2>, %next_second: reg<amdgpu.vgpr x2>)
^_bb5:
  s_mov_b64_exec %32
  low.br ^exit
^exit:
  return %first_word, %second_word
}

