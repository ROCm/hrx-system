// RUN: pass target=amdgpu:gfx11-generic source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// Uniform quotients and remainders enter a wider, varying loop domain. The
// producer stays word-sized; the receiving edge owns widening and transfer.
func.def target(@target) @constant_division_into_wide_loop(%increment_word: i64, %again: i1) -> (i64, i64) {
  %worker = kernel.workgroup.id<x> : index
  %input = index.assume %worker [range(%worker, 0, 2147483647)] : index
  %divisor = index.constant 192 : index
  %modulus = index.constant 7 : index
  %quotient = index.div %input, %divisor : index
  %remainder = index.rem %input, %modulus : index
  %increment = index.cast %increment_word : i64 to index
  cfg.br ^loop(%quotient: index, %remainder: index)
^loop(%first: index, %second: index):
  cfg.cond_br %again, ^advance, ^exit
^advance:
  %next_first = index.add %first, %increment : index
  %next_second = index.add %second, %increment : index
  cfg.br ^loop(%next_first: index, %next_second: index)
^exit:
  %first_word = index.cast %first : index to i64
  %second_word = index.cast %second : index to i64
  func.return %first_word, %second_word : i64, i64
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @constant_division_into_wide_loop(%increment: reg<amdgpu.vgpr x2>, %again: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %input = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %modulus = s_mov_b32 7
  %27 = s_mov_b32 715827883
  %28 = s_mul_hi_u32 %input, %27
  %29 = s_mov_b32 5
  %quotient = s_lshr_b32 %28, %29
  %31 = s_mov_b32 2454267027
  %32 = s_mul_hi_u32 %input, %31
  %33 = s_mov_b32 2
  %34 = s_lshr_b32 %32, %33
  %35 = s_mul_i32 %34, %modulus
  %remainder = s_sub_u32 %input, %35
  %37 = v_mov_b32_copy %quotient
  %38 = v_mov_b32 0
  %39 = concat(%37, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %40 = v_mov_b32_copy %remainder
  %41 = v_mov_b32 0
  %42 = concat(%40, %41) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^_bb4(%39: reg<amdgpu.vgpr x2>, %42: reg<amdgpu.vgpr x2>)
^_bb4(%first: reg<amdgpu.vgpr x2>, %second: reg<amdgpu.vgpr x2>):
  %43 = s_mov_b64_exec_read
  low.br ^loop(%first: reg<amdgpu.vgpr x2>, %second: reg<amdgpu.vgpr x2>)
^loop(%first_word: reg<amdgpu.vgpr x2>, %second_word: reg<amdgpu.vgpr x2>):
  %44, %45 = s_and_saveexec_b64 %again
  low.cond_br %45, ^advance, ^_bb5 : reg<amdgpu.scc>
^advance:
  %46 = slice %first_word[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %47 = slice %first_word[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %48 = slice %increment[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %49 = slice %increment[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %50, %51 = v_add_co_u32 %46, %48
  %52, %53 = v_add_co_ci_u32 %47, %49, %51
  %next_first = concat(%50, %52) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %55 = slice %second_word[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %56 = slice %second_word[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %57 = slice %increment[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %58 = slice %increment[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %59, %60 = v_add_co_u32 %55, %57
  %61, %62 = v_add_co_ci_u32 %56, %58, %60
  %next_second = concat(%59, %61) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^loop(%next_first: reg<amdgpu.vgpr x2>, %next_second: reg<amdgpu.vgpr x2>)
^_bb5:
  s_mov_b64_exec %43
  low.br ^exit
^exit:
  return %first_word, %second_word
}

