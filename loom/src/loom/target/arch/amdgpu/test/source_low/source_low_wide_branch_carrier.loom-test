low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_branch_carrier(%initial: reg<amdgpu.sgpr x2>, %iteration_count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %c0 = s_mov_b32 0
  %stride = s_mov_b32 1
  %112 = slice %initial[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %113 = v_mov_b32_copy %112
  %114 = slice %initial[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %115 = v_mov_b32_copy %114
  %116 = concat(%113, %115) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^header(%iteration_count: reg<amdgpu.sgpr>, %116: reg<amdgpu.vgpr x2>)
^header(%remaining: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr x2>):
  %117 = v_mov_b32_copy %stride
  %118 = v_mov_b32 0
  %120 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %121 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %124, %125 = v_sub_co_u32 %120, %117
  %126, %127 = v_sub_co_ci_u32 %121, %118, %125
  %next_value = concat(%124, %126) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %more = s_cmp_gt_i32 %remaining, %c0
  low.cond_br %more, ^body, ^exit : reg<amdgpu.scc>
^body:
  %130 = s_mov_b32 4294967295
  %next_remaining = s_add_u32 %remaining, %130
  low.br ^header(%next_remaining: reg<amdgpu.sgpr>, %next_value: reg<amdgpu.vgpr x2>)
^exit:
  return %value
}

