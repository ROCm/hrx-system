  %274 = slice %initial[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %275 = v_mov_b32_copy %274
  %276 = slice %initial[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %277 = v_mov_b32_copy %276
  %278 = concat(%275, %277) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^_bb1(%iteration_count: reg<amdgpu.sgpr>, %278: reg<amdgpu.vgpr x2>)
^_bb1(%remaining: reg<amdgpu.sgpr>, %wide: reg<amdgpu.vgpr x2>):
  %more = s_cmp_gt_i32 %remaining, %c0
  low.cond_br %more, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %280 = slice %wide[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %281 = slice %wide[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %284, %285 = v_add_co_u32 %280, %increment_i32
  %286, %287 = v_add_co_ci_u32 %281, %271, %285
  %next_value = concat(%284, %286) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %next_remaining = s_add_u32 %remaining, %273
  low.br ^_bb1(%next_remaining: reg<amdgpu.sgpr>, %next_value: reg<amdgpu.vgpr x2>)
^_bb3:
