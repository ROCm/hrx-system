  %238 = v_mul_hi_u32 %230, %234
  %239 = v_mul_lo_u32 %232, %234
  %240 = v_add_u32 %238, %239
  %242 = v_mov_b32_copy %low
  %243 = v_mov_b32 0
  %249, %250 = v_add_co_u32 %237, %242
  %251, %252 = v_add_co_ci_u32 %240, %243, %250
