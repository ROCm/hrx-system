amdgpu.target<gfx1100> @target

kernel.def target(@target) export("narrow_argument_i8") @narrow_argument_i8() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%raw_output: buffer, %value: i8, %extended_output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %unsigned_start = index.constant 64 : index
  %unsigned_lane = index.add %lane, %unsigned_start : index
  %raw_start = index.constant 1 : offset
  %extended_start = index.constant 4 : offset
  %raw_view = buffer.view %raw_output[%raw_start] : buffer -> view<64xi8>
  %extended_view = buffer.view %extended_output[%extended_start] : buffer -> view<128xi32>
  %signed_value = scalar.extsi %value : i8 to i32
  %unsigned_value = scalar.extui %value : i8 to i32
  view.store %value, %raw_view[%lane] : i8, view<64xi8>
  view.store %signed_value, %extended_view[%lane] : i32, view<128xi32>
  view.store %unsigned_value, %extended_view[%unsigned_lane] : i32, view<128xi32>
  kernel.return
}

