kernel.def target(@target) export("used_vector_arguments_wave32") @used_vector_arguments_wave32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%values: vector<8xf32>, %predicates: vector<4xi1>, %output: buffer) {
  %value = vector.extract %values[0] : vector<8xf32> -> f32
  %predicate = vector.extract %predicates[0] : vector<4xi1> -> i1
  %fallback = scalar.constant 0.0 : f32
  %selected = scf.select %predicate, %value, %fallback : f32
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<1xf32>
  view.store %selected, %view[0] : f32, view<1xf32>
  kernel.return
}

