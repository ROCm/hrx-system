  %extended_view = resource<hal_binding> {extent = 516, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = v_mov_b32_copy %value
  %signed_value = v_bfe_i32_offset_width_inline %18 {offset = 0, width = 8}
  global_store_b8_saddr %lane, %18, %raw_view {offset = 1}
  %22 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %22, %signed_value, %extended_view {offset = 4}
  global_store_b32_saddr %22, %18, %extended_view {offset = 260}
