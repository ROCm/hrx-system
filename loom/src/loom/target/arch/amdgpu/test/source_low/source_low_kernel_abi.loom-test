amdgpu.target<gfx1100> @target

// Multiple predicate arguments share the entry EXEC read and zero constant.
kernel.def target(@target) export("multiple_predicate_vector_arguments") @multiple_predicate_vector_arguments() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs: vector<2xi1>, %rhs: vector<2xi1>, %output: buffer) {
  %lhs_lane = vector.extract %lhs[0] : vector<2xi1> -> i1
  %rhs_lane = vector.extract %rhs[1] : vector<2xi1> -> i1
  %lhs_word = scalar.extui %lhs_lane : i1 to i32
  %rhs_word = scalar.extui %rhs_lane : i1 to i32
  %sum = scalar.addi %lhs_word, %rhs_word : i32
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %sum, %view[0] : i32, view<1xi32>
  kernel.return
}

