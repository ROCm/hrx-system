  %39 = s_cselect_b32 %21, %23, %38
  %40 = s_cselect_b32 %22, %23, %38
  %rhs$41 = concat(%35, %36, %39, %40) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
