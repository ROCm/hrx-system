  %24 = s_bfe_u32_lit %lhs$17, 524288
  %25 = s_cmp_lg_i32_src1_inline %24 {rhs = 0}
  %26 = s_cselect_b32 %21, %23, %25
  %27 = s_cselect_b32 %22, %23, %25
