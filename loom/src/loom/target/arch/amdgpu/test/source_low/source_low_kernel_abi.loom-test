low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_payload_sizes = [1], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 16], resource_parameter_indices = [0, 2], uses_kernarg_segment_ptr = true}) export("narrow_argument_i8") workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @narrow_argument_i8(%value: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %raw_view = resource<hal_binding> {extent = 65, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %extended_view = resource<hal_binding> {extent = 516, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = v_mov_b32_copy %value
  %signed_value = v_bfe_i32_offset_width_inline %18 {offset = 0, width = 8}
  global_store_b8_saddr %lane, %18, %raw_view {offset = 1}
  %22 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %22, %signed_value, %extended_view {offset = 4}
  global_store_b32_saddr %22, %18, %extended_view {offset = 260}
  return
}

