  %87, %88 = s_addc_u32 %44, %45, %86
  %89 = concat(%85, %87) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %last = global_load_b32_saddr<volatile> %41, %89 {offset = 32}
  %result = v_add_u32 %first, %last
  global_store_b32_saddr %41, %result, %result_view_0
