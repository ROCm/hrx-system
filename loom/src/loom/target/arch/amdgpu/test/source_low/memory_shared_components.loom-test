  %48, %49 = s_addc_u32 %44, %45, %47
  %50 = concat(%46, %48) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %first = global_load_b32_saddr<volatile> %41, %50
