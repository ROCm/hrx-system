// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A preheader access materializes row*16+column. The loop adds a varying
// element while preserving that exact invariant sum across the access boundary.
kernel.def @shared_loop_origin() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %row: index, %column: index, %result_buffer_0: buffer) {
  %result_base = index.constant 0 : offset
  %result_view_0 = buffer.view %result_buffer_0[%result_base] : buffer -> view<1xi32>
  %bounded_row = index.assume %row [range(%row, 0, 7)] : index
  %bounded_column = index.assume %column [range(%column, 0, 7)] : index
  %stride = index.constant 16 : index
  %origin = index.madd %bounded_row, %stride, %bounded_column : index
  %base = index.constant 0 : offset
  %data = buffer.view %input[%base] : buffer -> view<128xi32>
  %first = view.load %data[%origin] : view<128xi32> -> i32
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %sum = scf.for %iteration = [%begin to %end step %step](%total = %first : i32) -> (i32) {
    %position = index.add %origin, %iteration : index
    %value = view.load %data[%position] : view<128xi32> -> i32
    %next = scalar.addi %total, %value : i32
    scf.yield %next : i32
  }
  view.store %sum, %result_view_0[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "row", arg1 = "column"}, direct_arg_offsets = [8, 12], direct_arg_parameter_indices = [1, 2], direct_arg_sizes = [4, 4], parameter_count = 4, resource_count = 2, resource_offsets = [0, 16], resource_parameter_indices = [0, 3], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @shared_loop_origin(%bounded_row: reg<amdgpu.sgpr>, %bounded_column: reg<amdgpu.sgpr>) asm {
  %data = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %36 = v_mov_b32_copy %bounded_row
  %37 = v_mov_b32_copy %bounded_column
  %38 = v_lshl_add_u32_shift_imm %36, %37, 4
  %39 = v_lshlrev_b32_src0_inline %38, 2
  %stride = s_mov_b32 16
  %41 = s_mul_i32 %bounded_row, %stride
  %origin = s_add_u32 %41, %bounded_column
  %43 = s_lshl_b32_rhs_inline %origin, 2
  %first = s_load_dword %data, %43
  %begin = s_mov_b32 0
  %end = s_mov_b32 4
  %step = s_mov_b32 1
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %first: reg<amdgpu.sgpr>, %39: reg<amdgpu.vgpr>)
^_bb1(%iteration: reg<amdgpu.sgpr>, %total: reg<amdgpu.sgpr>, %33: reg<amdgpu.vgpr>):
  %48 = s_cmp_lt_i32 %iteration, %end
  low.cond_br %48, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %value = global_load_b32_saddr %33, %data
  %50 = v_add_u32_src0_inline %33, 4
  %51 = v_mov_b32_copy %total
  %next = v_add_u32 %51, %value
  %53 = s_add_u32 %iteration, %step
  %54 = v_readfirstlane_b32 %next
  low.br ^_bb1(%53: reg<amdgpu.sgpr>, %54: reg<amdgpu.sgpr>, %50: reg<amdgpu.vgpr>)
^_bb3:
  %55 = v_mov_b32_copy %total
  %56 = v_mov_b32 0
  global_store_b32_saddr %56, %55, %result_view_0
  return
}

// ====

// Both accesses have the same dynamic byte sum but distinct static offsets.
// Retaining the index must preserve its element-to-byte conversion exactly.
kernel.def @shared_static_suffix() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %row: index, %column: index, %result_buffer_0: buffer) {
  %result_base = index.constant 0 : offset
  %result_view_0 = buffer.view %result_buffer_0[%result_base] : buffer -> view<1xi32>
  %bounded_row = index.assume %row [range(%row, 0, 7)] : index
  %bounded_column = index.assume %column [range(%column, 0, 7)] : index
  %stride = index.constant 16 : index
  %origin = index.madd %bounded_row, %stride, %bounded_column : index
  %distance = index.constant 8 : index
  %later = index.add %origin, %distance : index
  %base = index.constant 0 : offset
  %data = buffer.view %input[%base] : buffer -> view<128xi32>
  %first = view.load %data[%origin] : view<128xi32> -> i32
  %second = view.load %data[%later] : view<128xi32> -> i32
  %sum = scalar.addi %first, %second : i32
  view.store %sum, %result_view_0[0] : i32, view<1xi32>
  kernel.return
}

