low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "row", arg1 = "column"}, direct_arg_offsets = [8, 12], direct_arg_parameter_indices = [1, 2], direct_arg_sizes = [4, 4], parameter_count = 4, resource_count = 2, resource_offsets = [0, 16], resource_parameter_indices = [0, 3], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @shared_static_suffix(%bounded_row: reg<amdgpu.sgpr>, %bounded_column: reg<amdgpu.sgpr>) asm {
  %data = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %stride = s_mov_b32 16
  %23 = s_mul_i32 %bounded_row, %stride
  %origin = s_add_u32 %23, %bounded_column
  %25 = s_lshl_b32_rhs_inline %origin, 2
  %first = s_load_dword %data, %25
  %second = s_load_dword %data, %25 {offset = 32}
  %sum = s_add_u32 %first, %second
  %30 = v_mov_b32_copy %sum
  %31 = v_mov_b32 0
  global_store_b32_saddr %31, %30, %result_view_0
  return
}

// ====

// Equal canonical terms in sibling branches do not make a branch-local SSA
// realization available in the other branch.
kernel.def @sibling_origins() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %row: index, %column: index, %condition: i1, %result_buffer_0: buffer) {
  %result_base = index.constant 0 : offset
  %result_view_0 = buffer.view %result_buffer_0[%result_base] : buffer -> view<1xi32>
  %bounded_row = index.assume %row [range(%row, 0, 7)] : index
  %bounded_column = index.assume %column [range(%column, 0, 7)] : index
  %stride = index.constant 16 : index
  %base = index.constant 0 : offset
  %data = buffer.view %input[%base] : buffer -> view<128xi32>
  %result = scf.if %condition -> (i32) {
    %left_origin = index.madd %bounded_row, %stride, %bounded_column : index
    %left = view.load<volatile> %data[%left_origin] : view<128xi32> -> i32
    view.store<volatile> %left, %data[%left_origin] : i32, view<128xi32>
    scf.yield %left : i32
  } else {
    %right_origin = index.madd %bounded_row, %stride, %bounded_column : index
    %distance = index.constant 8 : index
    %later = index.add %right_origin, %distance : index
    %right = view.load<volatile> %data[%later] : view<128xi32> -> i32
    scf.yield %right : i32
  }
  view.store %result, %result_view_0[0] : i32, view<1xi32>
  kernel.return
}

