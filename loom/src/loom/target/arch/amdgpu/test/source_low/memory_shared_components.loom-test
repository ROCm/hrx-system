  %left_origin = s_add_u32 %31, %bounded_column
  %33 = v_mov_b32 0
  %34 = s_lshl_b32_rhs_inline %left_origin, 2
  %35 = slice %data[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = slice %data[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38, %39 = s_add_co_u32 %35, %34
  %40, %41 = s_addc_u32 %36, %29, %39
  %42 = concat(%38, %40) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %left = global_load_b32_saddr<volatile> %33, %42
  %49, %50 = s_add_co_u32 %35, %34
  %51, %52 = s_addc_u32 %36, %29, %50
  %53 = concat(%49, %51) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr<volatile> %33, %left, %53
  low.br ^_bb3(%left: reg<amdgpu.vgpr>)
^_bb2:
  %54 = v_mov_b32 0
  %55 = s_lshl_b32_rhs_inline %bounded_row, 6
  %56 = s_lshl_b32_rhs_inline %bounded_column, 2
  %57 = s_add_u32 %55, %56
  %58 = slice %data[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %59 = slice %data[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %61, %62 = s_add_co_u32 %58, %57
  %63, %64 = s_addc_u32 %59, %29, %62
  %65 = concat(%61, %63) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %right = global_load_b32_saddr<volatile> %54, %65 {offset = 32}
  low.br ^_bb3(%right: reg<amdgpu.vgpr>)
^_bb3(%result: reg<amdgpu.vgpr>):
  %67 = v_mov_b32 0
  global_store_b32_saddr %67, %result, %result_view_0
  return
}

// ====

// An enclosing address component remains available through nested scopes and
// after both loops exit. Volatile accesses keep every observation in the IR.
kernel.def @nested_scoped_origin() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %row: index, %column: index, %result_buffer_0: buffer) {
  %result_base = index.constant 0 : offset
  %result_view_0 = buffer.view %result_buffer_0[%result_base] : buffer -> view<1xi32>
  %bounded_row = index.assume %row [range(%row, 0, 7)] : index
  %bounded_column = index.assume %column [range(%column, 0, 7)] : index
  %stride = index.constant 16 : index
  %origin = index.madd %bounded_row, %stride, %bounded_column : index
  %distance = index.constant 8 : index
  %later = index.add %origin, %distance : index
  %base = index.constant 0 : offset
  %data = buffer.view %input[%base] : buffer -> view<128xi32>
  %first = view.load<volatile> %data[%origin] : view<128xi32> -> i32
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  scf.for %outer = [%begin to %end step %step] {
    scf.for %inner = [%begin to %end step %step] {
      %value = view.load<volatile> %data[%later] : view<128xi32> -> i32
      view.store<volatile> %value, %data[%later] : i32, view<128xi32>
    }
  }
  %last = view.load<volatile> %data[%later] : view<128xi32> -> i32
  %result = scalar.addi %first, %last : i32
  view.store %result, %result_view_0[0] : i32, view<1xi32>
  kernel.return
}

