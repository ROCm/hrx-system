  %input_schema = encoding.define #encoding.operand<element_format=f8e4m3fn, payload_elements=8, payload_registers=2, rounding=finite_flush_subnormal> : encoding<schema>
  %input_storage = encoding.define #encoding.storage {layout = %input_layout : encoding<layout>, schema = %input_schema : encoding<schema>} : encoding<storage>
  %input_view = buffer.view %input[%base] : buffer -> view<64x8xf8E4M3, %input_storage>
  %scale_view = buffer.view %scale[%base] : buffer -> view<64xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<64x8xbf16>
  %packed = vector.load %input_view[%lane, 0] : view<64x8xf8E4M3, %input_storage> -> vector<8xf8E4M3>
  %decoded = vector.extf %packed : vector<8xf8E4M3> to vector<8xbf16>
  %row_scale = view.load %scale_view[%lane] : view<64xbf16> -> bf16
  %scale_vector = vector.splat %row_scale : vector<8xbf16>
  %scaled = vector.mulf %decoded, %scale_vector : vector<8xbf16>
  vector.store %scaled, %output_view[%lane, 0] : vector<8xbf16>, view<64x8xbf16>
  kernel.return
}

