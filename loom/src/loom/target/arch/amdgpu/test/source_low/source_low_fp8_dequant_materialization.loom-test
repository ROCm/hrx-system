  %packed = vector.load %input_view[%lane, 0] : view<64x8xf8E4M3, %input_storage> -> vector<8xf8E4M3>
  %wide = vector.extf %packed : vector<8xf8E4M3> to vector<8xf32>
  %row_scale = view.load %scale_view[%lane] : view<64xf32, #dense> -> f32
  %scale_vector = vector.splat %row_scale : vector<8xf32>
  %scaled = vector.mulf %wide, %scale_vector : vector<8xf32>
  %rounded = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
  vector.store %rounded, %output_view[%lane, 0] : vector<8xbf16>, view<64x8xbf16, #dense>
  kernel.return
}

