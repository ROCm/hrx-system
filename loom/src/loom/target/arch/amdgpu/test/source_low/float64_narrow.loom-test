// RUN: emit source-low target=amdgpu:gfx1151 output=low

// All strict destinations share one split-word classification and RNE
// mechanism while retaining their distinct overflow and NaN policies.
kernel.def @narrow_float64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %half_output: buffer, %brain_output: buffer, %e4m3_output: buffer, %e5m2_output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<1xf64>
  %source = view.load %input_view[0] : view<1xf64> -> f64
  %half = scalar.fptrunc %source : f64 to f16
  %brain = scalar.fptrunc %source : f64 to bf16
  %e4m3 = scalar.fptrunc %source : f64 to f8E4M3
  %e5m2 = scalar.fptrunc %source : f64 to f8E5M2
  %half_view = buffer.view %half_output[%base] : buffer -> view<1xf16>
  view.store %half, %half_view[0] : f16, view<1xf16>
  %brain_view = buffer.view %brain_output[%base] : buffer -> view<1xbf16>
  view.store %brain, %brain_view[0] : bf16, view<1xbf16>
  %e4m3_view = buffer.view %e4m3_output[%base] : buffer -> view<1xf8E4M3>
  view.store %e4m3, %e4m3_view[0] : f8E4M3, view<1xf8E4M3>
  %e5m2_view = buffer.view %e5m2_output[%base] : buffer -> view<1xf8E5M2>
  view.store %e5m2, %e5m2_view[0] : f8E5M2, view<1xf8E5M2>
  kernel.return
}

