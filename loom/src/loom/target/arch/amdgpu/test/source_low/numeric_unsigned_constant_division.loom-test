amdgpu.target<gfx1151> @target

func.def target(@target) @index_pair_by_7(%input: index) -> (index, index) {
  %bounded = index.assume %input [range(%input, 0, 4294967295)] : index
  %divisor = index.constant 7 : index
  %quotient = index.div %bounded, %divisor : index
  %remainder = index.rem %bounded, %divisor : index
  func.return %quotient, %remainder : index, index
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @index_pair_by_7(%bounded: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %divisor = s_mov_b32 7
  %11 = s_mov_b32 613566757
  %12 = s_mul_hi_u32 %bounded, %11
  %13 = s_sub_u32 %bounded, %12
  %14 = s_mov_b32 1
  %15 = s_lshr_b32 %13, %14
  %16 = s_add_u32 %15, %12
  %17 = s_mov_b32 2
  %quotient = s_lshr_b32 %16, %17
  %21 = s_sub_u32 %bounded, %12
  %23 = s_lshr_b32 %21, %14
  %24 = s_add_u32 %23, %12
  %26 = s_lshr_b32 %24, %17
  %27 = s_mul_i32 %26, %divisor
  %remainder = s_sub_u32 %bounded, %27
  return %quotient, %remainder
}

