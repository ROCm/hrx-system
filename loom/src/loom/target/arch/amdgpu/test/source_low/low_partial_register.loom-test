// RUN: verify

amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @d16_pair(%addr: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %low = ds_load_u16_d16 %addr
  %full = ds_load_u16_d16_hi %low, %addr
  return %full
}

// ====

amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @d16_low_is_not_full(%addr: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %low = ds_load_u16_d16 %addr
  // ERROR@+1: DOMINANCE/011 "low.return" "operand"
  return %low
}

// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @narrow_stores(%addr: reg<amdgpu.vgpr>, %global: reg<amdgpu.vgpr x2>, %saddr: reg<amdgpu.sgpr x2>, %resource: reg<amdgpu.sgpr x4>, %soffset: reg<amdgpu.sgpr>) asm {
  %low = ds_load_u16_d16 %addr
  ds_write_b8 %addr, %low
  ds_write_b16 %addr, %low
  global_store_b8_vaddr %global, %low
  global_store_b8_saddr %addr, %low, %saddr
  buffer_store_b8 %low, %resource, %addr, %soffset
  buffer_store_b8_vaddr_offset %low, %resource, %addr
  scratch_store_b8_vaddr %addr, %low
  scratch_store_b8_offset_only %low
  return
}

// ====

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @packed_float8_stores(%addr: reg<amdgpu.vgpr>, %global: reg<amdgpu.vgpr x2>, %saddr: reg<amdgpu.sgpr x2>, %resource: reg<amdgpu.sgpr x4>, %soffset: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  %low = v_cvt_pk_fp8_f32_low %value, %value
  ds_write_b8 %addr, %low
  ds_write_b16 %addr, %low
  global_store_b8_vaddr %global, %low
  global_store_b8_saddr %addr, %low, %saddr
  buffer_store_b8 %low, %resource, %addr, %soffset
  buffer_store_b8_vaddr_offset %low, %resource, %addr
  scratch_store_byte_vaddr %addr, %low
  scratch_store_byte_offset_only %low
  return
}

// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @flat_narrow_stores(%address: reg<amdgpu.vgpr x2>, %value_address: reg<amdgpu.vgpr>) asm {
  %low = ds_load_u16_d16 %value_address
  flat_store_b8 %address, %low
  flat_store_b16 %address, %low
  return
}

// ====

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @flat_packed_float8_stores(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) asm {
  %low = v_cvt_pk_fp8_f32_low %value, %value
  flat_store_byte %address, %low
  flat_store_short %address, %low
  return
}

// ====

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @flat_accumulator_stores(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.agpr>) asm {
  flat_store_byte %address, %value
  flat_store_short %address, %value
  return
}

// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @full_store_needs_both_parts(%addr: reg<amdgpu.vgpr>, %saddr: reg<amdgpu.sgpr x2>) asm {
  %low = ds_load_u16_d16 %addr
  // ERROR@+1: DOMINANCE/011 "amdgpu.global_store_b32_saddr" "value"
  global_store_b32_saddr %addr, %low, %saddr
  return
}

// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @flat_full_store_needs_both_parts(%address: reg<amdgpu.vgpr x2>, %value_address: reg<amdgpu.vgpr>) asm {
  %low = ds_load_u16_d16 %value_address
  // ERROR@+1: DOMINANCE/011 "amdgpu.flat_store_b32" "value"
  flat_store_b32 %address, %low
  return
}

// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @packed_broadcast_parts(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %half = v_cvt_f16_f32 %input
  %sum = v_pk_fma_f16.broadcast_a_b_c %half, %half, %half
  %product = v_pk_mul_f16.broadcast_rhs %sum, %half
  %bits = v_pk_mad_i16.broadcast_a_b_c %half, %half, %half
  return %product, %bits
}

// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @nonbroadcast_source_needs_both_parts(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %half = v_cvt_f16_f32 %input
  // ERROR@+1: DOMINANCE/011 "amdgpu.v_pk_mul_f16.broadcast_lhs" "rhs"
  %product = v_pk_mul_f16.broadcast_lhs %half, %half
  return %product
}

// ====

amdgpu.target<gfx1200> @target

low.func.def target<amdgpu.rdna4.core>(@target) @mixed_bank_broadcast_parts(%uniform: reg<amdgpu.sgpr>, %varying: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %uniform_half = s_cvt_f16_f32 %uniform
  %varying_half = v_cvt_f16_f32 %varying
  %sum = v_pk_add_f16.broadcast_lhs_rhs %uniform_half, %varying_half
  %result = v_pk_fma_f16.broadcast_a_c %uniform_half, %sum, %varying_half
  return %result
}

// ====

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @brain_broadcast_parts(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %half = ds_load_u16_d16 %address
  %sum = v_pk_fma_bf16.broadcast_a_b_c %half, %half, %half
  %result = v_pk_mul_bf16.broadcast_rhs %sum, %half
  return %result
}

// ====

amdgpu.target<gfx1151> @target

// Scalar extraction observes only the defined halfword and defines every
// output bit, for both zero and sign extension.
low.func.def target<amdgpu.rdna3_5.core>(@target) @scalar_halfword_extensions(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %half = s_cvt_f16_f32 %input
  %unsigned_byte = s_bfe_u32_lit_low16 %half {imm32 = 524288}
  %signed_byte = s_bfe_i32_lit_low16 %half {imm32 = 524288}
  %unsigned_half = s_bfe_u32_lit_low16 %half
  %signed_half = s_bfe_i32_lit_low16 %half
  return %unsigned_byte, %signed_byte, %unsigned_half, %signed_half
}

// ====

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @scalar_full_field_requires_full_word(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %half = s_cvt_f16_f32 %input
  // ERROR@+1: DOMINANCE/011 {op_name="amdgpu.s_bfe_u32.lit", field_name="value"}
  %value = s_bfe_u32_lit %half, 2097152
  return %value
}

// ====

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @scalar_partial_field_offset(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  // ERROR@+1: STRUCTURE/014 {attr_name="imm32", actual_value="524289"}
  %value = s_bfe_u32_lit_low16 %input {imm32 = 524289}
  return %value
}

// ====

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @scalar_partial_field_width(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  // ERROR@+1: STRUCTURE/014 {attr_name="imm32", actual_value="1114112"}
  %value = s_bfe_i32_lit_low16 %input {imm32 = 1114112}
  return %value
}
