// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

kernel.def target(@target) @offset_uniform_roundtrip() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%value: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %bounded = scalar.assume %value [range(%value, 0, 4294967294)] : i64
  %offset = index.cast %bounded : i64 to offset
  %increment = index.constant 1 : offset
  %next = index.add %offset, %increment : offset
  %result = index.cast %next : offset to i64
  view.store %result, %result_view_0[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [8], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @offset_uniform_roundtrip(%bounded: reg<amdgpu.sgpr x2>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %offset = slice %bounded[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %increment = s_mov_b32 1
  %next = s_add_u32 %offset, %increment
  %18 = s_mov_b32 0
  %21 = v_mov_b32_copy %next
  %23 = v_mov_b32_copy %18
  %24 = concat(%21, %23) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %25 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %25, %24, %result_view_0
  return
}

// ====

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

func.def target(@target) @offset_wide_alias(%value: i64) -> (offset) {
  %bounded = scalar.assume %value [range(%value, 4294967296, 9223372036854775807)] : i64
  %offset = index.cast %bounded : i64 to offset
  func.return %offset : offset
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @offset_wide_alias(%offset: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  return %offset
}

// ====

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

// Unsigned offset carriers keep bit 31 when crossing the fixed-width boundary.
// Arithmetic in the address domain keeps both casts observable after cleanup.
kernel.def target(@target) @offset_integer_casts() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%uniform_input: i64, %varying_input: i64, %uniform_output: buffer, %varying_output: buffer) {
  %uniform_bounded = scalar.assume %uniform_input [range(%uniform_input, 0, 4294967294)] : i64
  %varying_bounded = scalar.assume %varying_input [range(%varying_input, 0, 4294967231)] : i64
  %lane = kernel.workitem.id<x> : index
  %lane_integer = index.cast %lane : index to i64
  %varying_source = scalar.addi %varying_bounded, %lane_integer : i64
  %uniform_offset = index.cast %uniform_bounded : i64 to offset
  %varying_offset = index.cast %varying_source : i64 to offset
  %increment = index.constant 1 : offset
  %uniform_next = index.add %uniform_offset, %increment : offset
  %varying_next = index.add %varying_offset, %increment : offset
  %uniform_result = index.cast %uniform_next : offset to i64
  %varying_result = index.cast %varying_next : offset to i64
  %base = index.constant 0 : offset
  %uniform_storage = buffer.assume.alignment %uniform_output {minimum_alignment = 8} : buffer
  %varying_storage = buffer.assume.alignment %varying_output {minimum_alignment = 8} : buffer
  %uniform_view = buffer.view %uniform_storage[%base] : buffer -> view<64xi64>
  %varying_view = buffer.view %varying_storage[%base] : buffer -> view<64xi64>
  view.store %uniform_result, %uniform_view[%lane] : i64, view<64xi64>
  view.store %varying_result, %varying_view[%lane] : i64, view<64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 4, direct_arg_count = 2, direct_arg_names = {arg0 = "uniform_input", arg1 = "varying_input"}, direct_arg_offsets = [0, 8], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [8, 8], parameter_count = 4, resource_count = 2, resource_offsets = [16, 24], resource_parameter_indices = [2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @offset_integer_casts(%uniform_bounded: reg<amdgpu.sgpr x2>, %varying_bounded: reg<amdgpu.sgpr x2>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %uniform_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %varying_view = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %30 = slice %varying_bounded[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = v_mov_b32_copy %30
  %39, %40 = v_add_co_u32 %31, %lane
  %uniform_offset = slice %uniform_bounded[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %increment = s_mov_b32 1
  %uniform_next = s_add_u32 %uniform_offset, %increment
  %varying_next = v_add_u32 %increment, %39
  %49 = s_mov_b32 0
  %51 = v_mov_b32 0
  %varying_result = concat(%varying_next, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %54 = v_mov_b32_copy %uniform_next
  %56 = v_mov_b32_copy %49
  %57 = concat(%54, %56) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %58 = v_lshlrev_b32_src0_inline %lane, 3
  global_store_b64_saddr %58, %57, %uniform_view
  global_store_b64_saddr %58, %varying_result, %varying_view
  return
}
