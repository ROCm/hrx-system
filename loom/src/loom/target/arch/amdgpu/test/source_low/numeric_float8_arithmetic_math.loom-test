// RUN: pass target=amdgpu:gfx1151 legalize-math

func.def @f8e4m3_scalar_arithmetic(%lhs: f8E4M3, %rhs: f8E4M3) -> (f8E4M3, f8E4M3, f8E4M3, f8E4M3) {
  %sum = scalar.addf %lhs, %rhs : f8E4M3
  %difference = scalar.subf %lhs, %rhs : f8E4M3
  %product = scalar.mulf %lhs, %rhs : f8E4M3
  %finite = scalar.addf<nnan|ninf> %lhs, %rhs : f8E4M3
  func.return %sum, %difference, %product, %finite : f8E4M3, f8E4M3, f8E4M3, f8E4M3
}

// ----
func.def @f8e4m3_scalar_arithmetic(%lhs: f8E4M3, %rhs: f8E4M3) -> (f8E4M3, f8E4M3, f8E4M3, f8E4M3) {
  %22 = scalar.extf %lhs : f8E4M3 to f32
  %23 = scalar.extf %rhs : f8E4M3 to f32
  %24 = scalar.addf %22, %23 : f32
  %sum = scalar.fptrunc %24 : f32 to f8E4M3
  %18 = scalar.extf %lhs : f8E4M3 to f32
  %19 = scalar.extf %rhs : f8E4M3 to f32
  %20 = scalar.subf %18, %19 : f32
  %difference = scalar.fptrunc %20 : f32 to f8E4M3
  %14 = scalar.extf %lhs : f8E4M3 to f32
  %15 = scalar.extf %rhs : f8E4M3 to f32
  %16 = scalar.mulf %14, %15 : f32
  %product = scalar.fptrunc %16 : f32 to f8E4M3
  %10 = scalar.extf %lhs : f8E4M3 to f32
  %11 = scalar.extf %rhs : f8E4M3 to f32
  %12 = scalar.addf<nnan|ninf> %10, %11 : f32
  %finite = scalar.fptrunc %12 : f32 to f8E4M3
  func.return %sum, %difference, %product, %finite : f8E4M3, f8E4M3, f8E4M3, f8E4M3
}

