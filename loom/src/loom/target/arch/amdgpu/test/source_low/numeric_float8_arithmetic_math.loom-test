  %20 = vector.subf %18, %19 : vector<3xf32>
  %difference = vector.fptrunc %20 : vector<3xf32> to vector<3xf8E4M3>
  %14 = vector.extf %lhs : vector<3xf8E4M3> to vector<3xf32>
  %15 = vector.extf %rhs : vector<3xf8E4M3> to vector<3xf32>
  %16 = vector.mulf %14, %15 : vector<3xf32>
  %product = vector.fptrunc %16 : vector<3xf32> to vector<3xf8E4M3>
  %10 = vector.extf %lhs : vector<3xf8E4M3> to vector<3xf32>
  %11 = vector.extf %rhs : vector<3xf8E4M3> to vector<3xf32>
  %12 = vector.addf<nnan|ninf> %10, %11 : vector<3xf32>
  %finite = vector.fptrunc %12 : vector<3xf32> to vector<3xf8E4M3>
