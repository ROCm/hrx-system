  %odd = index.cmp ne, %parity, %loop_begin : index
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  cfg.br ^preheader
^preheader:
  cfg.br ^header(%loop_begin: index)
^header(%counter: index):
  %more = index.cmp ult, %counter, %limit : index
  cfg.cond_br %more, ^choose_latch, ^exit
^choose_latch:
  cfg.cond_br %odd, ^odd_latch, ^even_latch
^odd_latch:
  %odd_next = index.add %counter, %stride : index
  cfg.br ^header(%odd_next: index)
^even_latch:
  %even_next = index.add %counter, %increment : index
  cfg.br ^header(%even_next: index)
^exit:
  %result = index.cast %counter : index to i32
  view.store %result, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

