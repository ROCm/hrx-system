amdgpu.target<gfx11-generic> @loop_entry_wave64 {subgroup_size = 64}

kernel.def target(@loop_entry_wave64) @loop_before_outer_guard() {
  %unit = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%output: buffer) {
  %loop_begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %initial = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %lane = kernel.subgroup.lane.id : index
  %lane_i32 = index.cast %lane : index to i32
  %inner_end = index.add %lane, %step : index
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  cfg.br ^outer_header(%loop_begin: index)
^outer_header(%counter: index):
  %inner_count = scf.for %inner = [%loop_begin to %inner_end step %step](%count = %initial : i32) -> (i32) {
    %next_count = scalar.addi %count, %increment : i32
    scf.yield %next_count : i32
  }
  %observed = kernel.subgroup.broadcast.first %lane_i32 : i32
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^outer_body, ^exit
^outer_body:
  %next = index.add %counter, %step : index
  cfg.br ^outer_header(%next: index)
^exit:
  %result = scalar.addi %observed, %inner_count : i32
  view.store %result, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

