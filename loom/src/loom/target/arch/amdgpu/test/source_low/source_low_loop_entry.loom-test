kernel.def target(@loop_entry_wave64) @guarded_two_exit_loop() {
  %unit = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %length: i32) {
  %workitem_id_x = kernel.workitem.id<x> : index
  %lane = index.cast %workitem_id_x : index to i32
  %index = scf.while(%index = %lane : i32) -> (i32) {
    %inside = scalar.cmpi ult, %index, %length : i32
    %continue = scf.if %inside -> (i1) {
      %offset = index.cast %index : i32 to offset
      %position = index.cast %offset : offset to index
      %element_size = index.constant 4 : offset
      %byte_offset = index.scale %position, %element_size : index, offset -> offset
      %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
      %value = view.load %input_view[0] : view<1xi32> -> i32
      %c0 = scalar.constant 0 : i32
      %positive = scalar.cmpi sgt, %value, %c0 : i32
      scf.yield %positive : i1
    } else {
      scf.yield %inside : i1
    }
    scf.condition %continue, %index : i1, i32
  } do(%current: i32) {
    %c1 = scalar.constant 1 : i32
    %next = scalar.addi %current, %c1 : i32
    scf.yield %next : i32
  }
  %output_offset = index.cast %lane : i32 to offset
  %output_position = index.cast %output_offset : offset to index
  %element_size = index.constant 4 : offset
  %output_byte_offset = index.scale %output_position, %element_size : index, offset -> offset
  %output_view = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store %index, %output_view[0] : i32, view<1xi32>
  kernel.return
}

