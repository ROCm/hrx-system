// RUN: pass scf-to-cfg,cfg-simplify,source-to-low,low-dce

// A leader-only action before a lane-strided loop reconverges through one
// preheader. CFG simplification must retain that gateway so AMDGPU lowering
// sees one external loop entry.
amdgpu.target<gfx11-generic> @loop_entry_wave64 {subgroup_size = 64}

kernel.def target(@loop_entry_wave64) @leader_then_loop_preserves_entry() {
  %workgroup_count = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%workgroup_count, %workgroup_count, %workgroup_count) workgroup_size(%workgroup_size, %workgroup_count, %workgroup_count) : index
} launch(%output: buffer, %publication: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %leader_index = index.constant 0 : index
  %origin = index.constant 0 : offset
  %loop_step = index.constant 64 : index
  %loop_bound = index.constant 128 : index
  %stored_value = scalar.constant 1 : i32
  %publication_view = buffer.view %publication[%origin] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<128xi32>
  %leader = index.cmp eq, %lane, %leader_index : index
  scf.if %leader {
    view.store %stored_value, %publication_view[%leader_index] : i32, view<1xi32>
  }
  scf.for %slot = [%lane to %loop_bound step %loop_step] {
    view.store %stored_value, %output_view[%slot] : i32, view<128xi32>
  }
  kernel.return
}

