  %239 = v_mul_lo_u32 %237, %236
  %240 = v_mul_hi_u32 %237, %236
  %241 = v_mul_lo_u32 %238, %236
  %242 = v_add_u32 %240, %241
  %244 = v_mov_b32_copy %low
  %245 = v_mov_b32 0
  %251, %252 = v_add_co_u32 %239, %244
  %253, %254 = v_add_co_ci_u32 %242, %245, %252
  %258 = v_cndmask_b32 %237, %251, %condition
  %261 = v_cndmask_b32 %238, %253, %condition
  %selected = concat(%258, %261) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %selected
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_offset_fixed_cast_cycle(%initial: reg<amdgpu.vgpr x2>, %increments: reg<amdgpu.vgpr x4>, %iteration_count: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %increment_i32 = slice %increments[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %272 = v_mov_b32 0
  %276 = s_mov_b64_exec_read
  low.br ^_bb1(%iteration_count: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr x2>)
^_bb1(%remaining: reg<amdgpu.vgpr>, %wide: reg<amdgpu.vgpr x2>):
  %more = v_cmp_gt_i32_src1_inline %remaining {rhs = 0}
  %277, %278 = s_and_saveexec_b64 %more
  low.cond_br %278, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %279 = slice %wide[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %280 = slice %wide[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %283, %284 = v_add_co_u32 %279, %increment_i32
  %285, %286 = v_add_co_ci_u32 %280, %272, %284
  %next_value = concat(%283, %285) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %288 = v_mov_b32 4294967295
  %next_remaining = v_add_u32 %remaining, %288
  low.br ^_bb1(%next_remaining: reg<amdgpu.vgpr>, %next_value: reg<amdgpu.vgpr x2>)
^_bb3:
  s_mov_b64_exec %276
  return %wide
}

// ====

// RUN: emit source-low target=amdgpu:gfx1151 output=low

// A dynamic native bound keeps its counter and comparison in one register.
func.def @native_index_counted_carrier(%end: index) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial_sum = scalar.constant 0 : i32
  %result = scf.for %position = [%begin to %end step %step](%sum = %initial_sum : i32) -> (i32) {
    %word = index.cast %position : index to i32
    %next = scalar.addi %sum, %word : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @native_index_counted_carrier(%end: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %25 = v_mov_b32_copy %begin
  %26 = v_mov_b32 0
  %28 = s_mov_b64_exec_read
  low.br ^_bb1(%25: reg<amdgpu.vgpr>, %26: reg<amdgpu.vgpr>)
^_bb1(%word: reg<amdgpu.vgpr>, %sum: reg<amdgpu.vgpr>):
  %27 = v_cmp_lt_i32 %word, %end
  %29, %30 = s_and_saveexec_b64 %27
  low.cond_br %30, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %next = v_add_u32 %sum, %word
  %32 = v_add_u32 %step, %word
  low.br ^_bb1(%32: reg<amdgpu.vgpr>, %next: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %28
  return %sum
}

// ====

// RUN: emit source-low target=amdgpu:gfx1151 output=low

// The same loop with a wide computed bound retains both words of each index.
func.def @wide_index_counted_carrier(%input: i64) -> (i64) {
  %bounded = scalar.assume %input [range(%input, 4294967296, 4294967300)] : i64
  %end = index.cast %bounded : i64 to index
  %begin = index.constant 4294967296 : index
  %step = index.constant 1 : index
  %initial_sum = scalar.constant 0 : i64
  %result = scf.for %position = [%begin to %end step %step](%sum = %initial_sum : i64) -> (i64) {
    %word = index.cast %position : index to i64
    %next = scalar.addi %sum, %word : i64
    scf.yield %next : i64
  }
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @wide_index_counted_carrier(%end: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %24 = v_mov_b32 0
  %25 = v_mov_b32 1
  %begin = concat(%24, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %step = s_mov_b32 1
  %28 = s_mov_b32 0
  %32 = v_mov_b32_copy %28
  %35 = concat(%32, %32) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %37 = s_mov_b64_exec_read
  low.br ^_bb1(%begin: reg<amdgpu.vgpr x2>, %35: reg<amdgpu.vgpr x2>)
^_bb1(%word: reg<amdgpu.vgpr x2>, %sum: reg<amdgpu.vgpr x2>):
  %36 = v_cmp_lt_i64 %word, %end
  %38, %39 = s_and_saveexec_b64 %36
  low.cond_br %39, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %40 = slice %sum[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %41 = slice %sum[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %42 = slice %word[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %43 = slice %word[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %44, %45 = v_add_co_u32 %40, %42
  %46, %47 = v_add_co_ci_u32 %41, %43, %45
  %next = concat(%44, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %49 = v_mov_b32_copy %step
  %50 = v_mov_b32 0
  %56, %57 = v_add_co_u32 %42, %49
  %58, %59 = v_add_co_ci_u32 %43, %50, %57
  %60 = concat(%56, %58) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^_bb1(%60: reg<amdgpu.vgpr x2>, %next: reg<amdgpu.vgpr x2>)
^_bb3:
  s_mov_b64_exec %37
  return %sum
}
