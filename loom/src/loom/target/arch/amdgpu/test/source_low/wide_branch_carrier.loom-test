// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @wide_branch_carrier(%initial: offset, %iteration_count: i32) -> (offset) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %stride = index.constant 1 : offset
  cfg.br ^header(%iteration_count: i32, %initial: offset)
^header(%remaining: i32, %value: offset):
  %next_value = index.sub %value, %stride : offset
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next_remaining = scalar.subi %remaining, %c1 : i32
  cfg.br ^header(%next_remaining: i32, %next_value: offset)
^exit:
  func.return %value : offset
}

// A proven-wide index seed must keep the complete carrier width after the CFG
// fact meet makes the header and recurrence result ranges unknown.
func.def target(@target) @wide_index_branch_carrier() -> (index) {
  %initial = index.constant 4294967303 : index
  %iteration_count = scalar.constant 3 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %step = index.constant 1 : index
  cfg.br ^header(%iteration_count: i32, %initial: index)
^header(%remaining: i32, %value: index):
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next_remaining = scalar.subi %remaining, %c1 : i32
  %next_value = index.sub %value, %step : index
  cfg.br ^header(%next_remaining: i32, %next_value: index)
^exit:
  func.return %value : index
}

// A structurally identical narrow component must retain the single-register
// scalar path.
func.def target(@target) @narrow_index_branch_carrier() -> (index) {
  %initial = index.constant 7 : index
  %iteration_count = scalar.constant 3 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %step = index.constant 1 : index
  cfg.br ^header(%iteration_count: i32, %initial: index)
^header(%remaining: i32, %value: index):
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next_remaining = scalar.subi %remaining, %c1 : i32
  %next_value = index.sub %value, %step : index
  cfg.br ^header(%next_remaining: i32, %next_value: index)
^exit:
  func.return %value : index
}

// Structured loop relations must preserve the same wide carrier decision
// through the condition, body, yield, and result boundaries.
func.def target(@target) @wide_index_while_carrier() -> (index) {
  %initial = index.constant 4294967303 : index
  %iteration_count = scalar.constant 3 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %step = index.constant 1 : index
  %final_remaining, %final_value = scf.while(%remaining = %iteration_count : i32, %value = %initial : index) -> (i32, index) {
    %more = scalar.cmpi sgt, %remaining, %c0 : i32
    scf.condition %more, %remaining, %value : i1, i32, index
  } do(%remaining: i32, %value: index) {
    %next_remaining = scalar.subi %remaining, %c1 : i32
    %next_value = index.sub %value, %step : index
    scf.yield %next_remaining, %next_value : i32, index
  }
  func.return %final_value : index
}

// Select result facts preserve the wide alternative while lowering adapts the
// independently represented narrow payload at the operation boundary.
func.def target(@target) @wide_index_select_carrier(%condition: i1) -> (index) {
  %wide = index.constant 4294967303 : index
  %narrow = index.constant 7 : index
  %selected = scf.select %condition, %wide, %narrow : index
  func.return %selected : index
}

// A narrow argument widened for one select remains usable by an independently
// narrow address-domain cast.
func.def target(@target) @wide_select_narrow_reuse(%narrow: index, %condition: i1) -> (index, offset) where [range(%narrow, 0, 1023)] {
  %wide = index.constant 4294967303 : index
  %selected = scf.select %condition, %wide, %narrow : index
  %offset = index.cast %narrow : index to offset
  func.return %selected, %offset : index, offset
}

// A dynamic wide multiply-add has no scalar realization and must constrain its
// transported result to the vector-register alternative.
func.def target(@target) @wide_index_madd_carrier(%wide: index, %condition: i1) -> (index) where [range(%wide, 4294967296, 4294967396)] {
  %scale = index.constant 3 : index
  %low = index.constant 7 : index
  %result = index.madd %wide, %scale, %low : index
  %selected = scf.select %condition, %result, %wide : index
  func.return %selected : index
}

// Fixed-width arithmetic inside a loop retains the wide address component's
// register bank across both cast boundaries.
func.def target(@target) @wide_offset_fixed_cast_cycle(%initial: offset, %increments: vector<4xi32>, %iteration_count: i32) -> (offset) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %increment_i32 = vector.extract %increments[0] : vector<4xi32> -> i32
  %increment = scalar.extui %increment_i32 : i32 to i64
  %final_remaining, %final_value = scf.while(%remaining = %iteration_count : i32, %value = %initial : offset) -> (i32, offset) {
    %more = scalar.cmpi sgt, %remaining, %c0 : i32
    scf.condition %more, %remaining, %value : i1, i32, offset
  } do(%remaining: i32, %value: offset) {
    %wide = index.cast %value : offset to i64
    %advanced = scalar.addi %wide, %increment : i64
    %bounded = scalar.assume %advanced [range(%advanced, 0, 9223372036854775807)] : i64
    %next_value = index.cast %bounded : i64 to offset
    %next_remaining = scalar.subi %remaining, %c1 : i32
    scf.yield %next_remaining, %next_value : i32, offset
  }
  func.return %final_value : offset
}

