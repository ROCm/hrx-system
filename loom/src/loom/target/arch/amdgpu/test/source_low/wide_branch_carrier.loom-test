  %251 = v_mul_lo_u32 %248, %246
  %252 = v_add_u32 %250, %251
  %254 = v_mov_b32_copy %low
  %255 = v_mov_b32 0
  %261, %262 = v_add_co_u32 %249, %254
  %263, %264 = v_add_co_ci_u32 %252, %255, %262
  %268 = v_cndmask_b32 %247, %261, %condition
  %271 = v_cndmask_b32 %248, %263, %condition
  %selected = concat(%268, %271) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %selected
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_offset_fixed_cast_cycle(%initial: reg<amdgpu.vgpr x2>, %increments: reg<amdgpu.vgpr x4>, %iteration_count: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %increment_i32 = slice %increments[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %282 = v_mov_b32 0
  %286 = s_mov_b64_exec_read
  low.br ^_bb1(%iteration_count: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr x2>)
^_bb1(%remaining: reg<amdgpu.vgpr>, %wide: reg<amdgpu.vgpr x2>):
  %more = v_cmp_gt_i32_src1_inline %remaining {rhs = 0}
  %287, %288 = s_and_saveexec_b64 %more
  low.cond_br %288, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %289 = slice %wide[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %290 = slice %wide[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %293, %294 = v_add_co_u32 %289, %increment_i32
  %295, %296 = v_add_co_ci_u32 %290, %282, %294
