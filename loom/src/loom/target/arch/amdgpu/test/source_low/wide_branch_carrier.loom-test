  %154, %155 = v_sub_co_u32 %150, %147
  %156, %157 = v_sub_co_ci_u32 %151, %148, %155
  %next_value = concat(%154, %156) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^header(%next_remaining: reg<amdgpu.sgpr>, %next_value: reg<amdgpu.vgpr x2>)
^exit:
