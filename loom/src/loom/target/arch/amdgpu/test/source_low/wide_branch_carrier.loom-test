low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_branch_carrier(%initial: reg<amdgpu.vgpr x2>, %iteration_count: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %stride = s_mov_b32 1
  %129 = s_mov_b64_exec_read
  low.br ^header(%iteration_count: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr x2>)
^header(%remaining: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>):
  %116 = v_mov_b32_copy %stride
  %117 = v_mov_b32 0
  %119 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %120 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %123, %124 = v_sub_co_u32 %119, %116
  %125, %126 = v_sub_co_ci_u32 %120, %117, %124
  %next_value = concat(%123, %125) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %more = v_cmp_gt_i32_src1_inline %remaining {rhs = 0}
  %130, %131 = s_and_saveexec_b64 %more
  low.cond_br %131, ^body, ^_bb3 : reg<amdgpu.scc>
^body:
  %133 = v_mov_b32 4294967295
  %next_remaining = v_add_u32 %remaining, %133
  low.br ^header(%next_remaining: reg<amdgpu.vgpr>, %next_value: reg<amdgpu.vgpr x2>)
^_bb3:
  s_mov_b64_exec %129
  return %value
}

