// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @shared_conditional_values(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = scalar.constant 0 : i32
  %completed = scalar.constant 1 : i32
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %in = buffer.view %aligned_input[%base] : buffer -> view<3xi32>
  %out = buffer.view %aligned_output[%base] : buffer -> view<3xi32>
  %outer_value = view.load %in[0] : view<3xi32> -> i32
  %outer = scalar.cmpi ne, %outer_value, %c0 : i32
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %loaded = view.load %in[1] : view<3xi32> -> i32
  view.store %loaded, %out[0] : i32, view<3xi32>
  %inner = scalar.cmpi ne, %loaded, %c0 : i32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %result = scalar.addi %loaded, %loaded : i32
  view.store %result, %out[1] : i32, view<3xi32>
  cfg.br ^exit
^fallback:
  %fallback = view.load %in[2] : view<3xi32> -> i32
  view.store %fallback, %out[1] : i32, view<3xi32>
  cfg.br ^exit
^exit:
  view.store %completed, %out[2] : i32, view<3xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @shared_conditional_values() asm {
  %in = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %out = resource<hal_binding> {extent = 12, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %28 = slice %in[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = slice %in[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30 = v_mov_b32_copy %28
  %31 = v_mov_b32_copy %29
  %32 = concat(%30, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %outer_value = global_load_b32_vaddr %32
  %outer = v_cmp_ne_i32_src1_inline %outer_value {rhs = 0}
  %35, %36 = s_and_saveexec_b64 %outer
  low.cond_br %36, ^evaluate, ^_bb7 : reg<amdgpu.scc>
^evaluate:
  %44 = slice %in[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = slice %in[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46 = v_mov_b32_copy %44
  %47 = v_mov_b32_copy %45
  %48 = concat(%46, %47) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %loaded = global_load_b32_vaddr %48 {offset = 4}
  %50 = slice %out[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %51 = slice %out[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %52 = v_mov_b32_copy %50
  %53 = v_mov_b32_copy %51
  %54 = concat(%52, %53) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %54, %loaded
  %inner = v_cmp_ne_i32_src1_inline %loaded {rhs = 0}
  low.br ^_bb6(%inner: reg<amdgpu.sgpr x2>, %loaded: reg<amdgpu.vgpr>)
^_bb6(%21: reg<amdgpu.sgpr x2>, %22: reg<amdgpu.vgpr>):
  %43 = s_andn2_b64_exec %35, %outer
  low.cond_br %43, ^_bb2, ^_bb8 : reg<amdgpu.scc>
^_bb2:
  %62 = v_mov_b32 0
  s_mov_b64_exec %35
  %40 = s_and_b64 %35, %outer
  %41 = s_and_b64 %40, %21
  %42 = v_cndmask_b32 %62, %22, %outer
  low.br ^_bb3(%41: reg<amdgpu.sgpr x2>, %42: reg<amdgpu.vgpr>)
^_bb3(%19: reg<amdgpu.sgpr x2>, %20: reg<amdgpu.vgpr>):
  %63, %64 = s_and_saveexec_b64 %19
  low.cond_br %64, ^selected, ^_bb9 : reg<amdgpu.scc>
^selected:
  %result = v_add_u32 %20, %20
  %67 = slice %out[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %68 = slice %out[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %69 = v_mov_b32_copy %67
  %70 = v_mov_b32_copy %68
  %71 = concat(%69, %70) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %71, %result {offset = 4}
  low.br ^_bb9
^_bb9:
  %65 = s_xor_b64_exec %63
  low.cond_br %65, ^fallback, ^_bb10 : reg<amdgpu.scc>
^fallback:
  %72 = slice %in[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %73 = slice %in[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %74 = v_mov_b32_copy %72
  %75 = v_mov_b32_copy %73
  %76 = concat(%74, %75) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %fallback = global_load_b32_vaddr %76 {offset = 8}
  %78 = slice %out[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %79 = slice %out[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %80 = v_mov_b32_copy %78
  %81 = v_mov_b32_copy %79
  %82 = concat(%80, %81) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %82, %fallback {offset = 4}
  low.br ^_bb10
^_bb7:
  s_mov_b64_exec %35
  %37 = s_mov_b32 0
  %38 = concat(%37, %37) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %39 = v_mov_b32 0
  low.br ^_bb6(%38: reg<amdgpu.sgpr x2>, %39: reg<amdgpu.vgpr>)
^_bb8:
  s_mov_b64_exec %35
  low.br ^_bb3(%21: reg<amdgpu.sgpr x2>, %22: reg<amdgpu.vgpr>)
^_bb10:
  s_mov_b64_exec %63
  %83 = v_mov_b32 1
  %84 = slice %out[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %85 = slice %out[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %86 = v_mov_b32_copy %84
  %87 = v_mov_b32_copy %85
  %88 = concat(%86, %87) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %88, %83 {offset = 8}
  return
}
