// TEMPLATE: loom/src/loom/test/corpus/source_low/shared_conditional_values.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @shared_conditional_values(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = scalar.constant 0 : i32
  %completed = scalar.constant 1 : i32
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %in = buffer.view %aligned_input[%base] : buffer -> view<3xi32>
  %out = buffer.view %aligned_output[%base] : buffer -> view<3xi32>
  %outer_value = view.load %in[0] : view<3xi32> -> i32
  %outer = scalar.cmpi ne, %outer_value, %c0 : i32
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %loaded = view.load %in[1] : view<3xi32> -> i32
  view.store %loaded, %out[0] : i32, view<3xi32>
  %inner = scalar.cmpi ne, %loaded, %c0 : i32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %result = scalar.addi %loaded, %loaded : i32
  view.store %result, %out[1] : i32, view<3xi32>
  cfg.br ^exit
^fallback:
  %fallback = view.load %in[2] : view<3xi32> -> i32
  view.store %fallback, %out[1] : i32, view<3xi32>
  cfg.br ^exit
^exit:
  view.store %completed, %out[2] : i32, view<3xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @shared_conditional_values() asm {
  %in = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 12} : reg<amdgpu.sgpr x2>
  %out = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 12} : reg<amdgpu.sgpr x2>
  %28 = v_mov_b32 0
  %outer_value = global_load_b32_saddr %28, %in
  %outer = v_cmp_ne_i32_src1_inline %outer_value {rhs = 0}
  %31, %32 = s_and_saveexec_b64 %outer
  low.cond_br %32, ^evaluate, ^_bb7 : reg<amdgpu.scc>
^evaluate:
  %41 = v_mov_b32 0
  %loaded = global_load_b32_saddr %41, %in {offset = 4}
  global_store_b32_saddr %41, %loaded, %out
  %inner = v_cmp_ne_i32_src1_inline %loaded {rhs = 0}
  low.br ^_bb6(%inner: reg<amdgpu.sgpr x2>, %loaded: reg<amdgpu.vgpr>)
^_bb6(%21: reg<amdgpu.sgpr x2>, %22: reg<amdgpu.vgpr>):
  s_mov_b64_exec %31
  %39 = s_and_b64 %31, %outer
  %40 = s_xor_b64_exec %39
  low.cond_br %40, ^_bb2, ^_bb8 : reg<amdgpu.scc>
^_bb2:
  %51 = v_mov_b32 0
  s_mov_b64_exec %31
  %36 = s_and_b64 %31, %outer
  %37 = s_and_b64 %36, %21
  %38 = v_cndmask_b32 %51, %22, %outer
  low.br ^_bb3(%37: reg<amdgpu.sgpr x2>, %38: reg<amdgpu.vgpr>)
^_bb3(%19: reg<amdgpu.sgpr x2>, %20: reg<amdgpu.vgpr>):
  %52, %53 = s_and_saveexec_b64 %19
  low.cond_br %53, ^selected, ^_bb9 : reg<amdgpu.scc>
^selected:
  %result = v_add_u32 %20, %20
  %56 = v_mov_b32 0
  global_store_b32_saddr %56, %result, %out {offset = 4}
  low.br ^_bb9
^_bb9:
  %54 = s_xor_b64_exec %52
  low.cond_br %54, ^fallback, ^_bb10 : reg<amdgpu.scc>
^fallback:
  %57 = v_mov_b32 0
  %fallback = global_load_b32_saddr %57, %in {offset = 8}
  global_store_b32_saddr %57, %fallback, %out {offset = 4}
  low.br ^_bb10
^_bb7:
  s_mov_b64_exec %31
  %33 = s_mov_b32 0
  %34 = concat(%33, %33) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %35 = v_mov_b32 0
  low.br ^_bb6(%34: reg<amdgpu.sgpr x2>, %35: reg<amdgpu.vgpr>)
^_bb8:
  s_mov_b64_exec %31
  low.br ^_bb3(%21: reg<amdgpu.sgpr x2>, %22: reg<amdgpu.vgpr>)
^_bb10:
  s_mov_b64_exec %52
  %60 = v_mov_b32 1
  %61 = v_mov_b32 0
  global_store_b32_saddr %61, %60, %out {offset = 8}
  return
}
