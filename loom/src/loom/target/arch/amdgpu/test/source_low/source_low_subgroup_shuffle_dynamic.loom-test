  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_shuffle_dynamic_down_i32() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %c3 = s_mov_b32 3
  %biased_lane = v_add_u32 %c3, %lane
  %26 = s_mov_b32 15
  %source_lane_i32 = v_and_b32 %26, %biased_lane
  %28 = v_lshlrev_b32_src0_inline %lane, 2
  %value = global_load_b32_saddr %28, %input_view
  %30 = v_add_u32 %lane, %source_lane_i32
  %31 = v_and_b32_src0_inline %lane, 15
  %32 = v_add_u32 %31, %source_lane_i32
  %33 = v_mov_b32 16
  %valid = v_cmp_lt_u32 %32, %33
  %35 = v_lshlrev_b32_src0_inline %30, 2
  %shuffled = ds_bpermute_b32 %35, %value
  %37, %38 = s_and_saveexec_b64 %valid
  low.cond_br %38, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %39 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %39, %shuffled, %output_view
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %37
  return
}
