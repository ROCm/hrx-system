amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @subgroup_shuffle_dynamic_offset() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %input_base = index.constant 0 : offset
  %input_view = buffer.view %input[%input_base] : buffer -> view<1xi32>
  %offset_vector = vector.load %input_view[0] : view<1xi32> -> vector<1xi32>
  %offset = vector.extract %offset_vector[0] : vector<1xi32> -> i32
  %width = scalar.constant 32 : i32
  %value = scalar.constant 1 : i32
  %shuffle, %valid = kernel.subgroup.shuffle<xor> %value, %offset, %width : i32, i32, i32
  %item = kernel.workitem.id<x> : index
  %output_base = index.constant 0 : offset
  %output_view = buffer.view %output[%output_base] : buffer -> view<64x2xi32>
  %c0 = scalar.constant 0 : i32
  %selected = scf.select %valid, %shuffle, %c0 : i32
  %valid_bits = scalar.extui %valid : i1 to i32
  view.store %selected, %output_view[%item, 0] : i32, view<64x2xi32>
  view.store %valid_bits, %output_view[%item, 1] : i32, view<64x2xi32>
  kernel.return
}

