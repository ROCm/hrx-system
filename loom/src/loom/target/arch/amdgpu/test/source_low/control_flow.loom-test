kernel.def target(@target) @uniform_i1_reused_after_join() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%count: i32, %lhs: i32, %rhs: i32, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi32>
  %empty_value = scalar.constant 0 : i32
  %has_count = scalar.cmpi ne, %count, %empty_value : i32
  cfg.cond_br %has_count, ^has_values, ^empty
^has_values:
  cfg.br ^join(%lhs: i32, %rhs: i32)
^empty:
  cfg.br ^join(%empty_value: i32, %empty_value: i32)
^join(%selected_lhs: i32, %selected_rhs: i32):
  %sum = scalar.addi %selected_lhs, %selected_rhs : i32
  cfg.cond_br %has_count, ^sum, ^fallback
^sum:
  cfg.br ^done(%sum: i32)
^fallback:
  cfg.br ^done(%empty_value: i32)
^done(%result: i32):
  view.store %result, %result_view_0[%fixture_lane] : i32, view<64xi32>
  kernel.return
}

