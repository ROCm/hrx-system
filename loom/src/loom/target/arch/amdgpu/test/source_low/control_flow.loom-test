// RUN: emit amdgpu-assembly @uniform_branch_condition_combined_with_lane_mask_assembly

amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @uniform_branch_condition_combined_with_lane_mask_assembly(%values: reg<amdgpu.vgpr x2>, %x: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>, %true_value: reg<amdgpu.sgpr>, %false_value: reg<amdgpu.sgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %zero = s_mov_b32 0
  %lane = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %limit_vgpr = v_mov_b32_copy %limit
  %lane_ok = v_cmp_lt_i32 %lane, %limit_vgpr
  %x_lower = s_cmp_ge_i32 %x, %zero
  %x_upper = s_cmp_lt_i32 %x, %limit
  %one = s_mov_b32 1
  %x_lower_bool = s_cselect_b32 %one, %zero, %x_lower
  %x_upper_bool = s_cselect_b32 %one, %zero, %x_upper
  %x_ok = s_and_b32 %x_lower_bool, %x_upper_bool
  %x_ok_for_mask = s_cmp_lg_i32 %x_ok, %zero
  %lane_ok_low = slice %lane_ok[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %combined_low = s_cselect_b32 %lane_ok_low, %zero, %x_ok_for_mask
  %lane_ok_high = slice %lane_ok[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %combined_high = s_cselect_b32 %lane_ok_high, %zero, %x_ok_for_mask
  %combined = concat(%combined_low, %combined_high) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %x_ok_for_branch = s_cmp_lg_i32 %x_ok, %zero
  low.cond_br %x_ok_for_branch, ^valid, ^clamped : reg<amdgpu.scc>
^valid:
  low.br ^join(%true_value: reg<amdgpu.sgpr>)
^clamped:
  low.br ^join(%false_value: reg<amdgpu.sgpr>)
^join(%selected: reg<amdgpu.sgpr>):
  %selected_vgpr = v_mov_b32_copy %selected
  %sum = v_add_u32 %selected_vgpr, %lane
  %result = v_cndmask_b32 %lane, %sum, %combined
  global_store_b32_saddr %lane, %result, %output
  return
}

