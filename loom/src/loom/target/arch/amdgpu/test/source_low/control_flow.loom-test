amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @index_i1_reused_after_salu_scc_clobber() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%row_i32: i32, %rows_i32: i32, %base_i32: i32, %scale_i32: i32, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi64>
  %row0 = index.cast %row_i32 : i32 to index
  %rows0 = index.cast %rows_i32 : i32 to index
  %base0 = index.cast %base_i32 : i32 to index
  %scale0 = index.cast %scale_i32 : i32 to index
  %row = index.assume %row0 [range(%row0, 0, 1022)] : index
  %rows = index.assume %rows0 [range(%rows0, 1, 1024)] : index
  %base = index.assume %base0 [range(%base0, 0, 1024)] : index
  %scale = index.assume %scale0 [range(%scale0, 0, 1024)] : index
  %row_increment = index.constant 1 : index
  %row1 = index.add %row, %row_increment : index
  %in_bounds = index.cmp ult, %row1, %rows : index
  %entry_guard = scalar.cmpi ne, %base_i32, %scale_i32 : i32
  %combined_guard = scalar.andi %in_bounds, %entry_guard : i1
  cfg.cond_br %combined_guard, ^left, ^right
^left:
  cfg.br ^body(%base: index)
^right:
  cfg.br ^body(%scale: index)
^body(%seed: index):
  %bounded_seed = index.assume %seed [range(%seed, 0, 1024)] : index
  %scaled = index.add %bounded_seed, %scale : index
  cfg.cond_br %in_bounds, ^then, ^body_done
^then:
  %result = index.add %scaled, %row_increment : index
  cfg.br ^done(%result: index)
^body_done:
  cfg.br ^done(%scaled: index)
^done(%out: index):
  %stored_1_0 = index.cast %out : index to i64
  view.store %stored_1_0, %captured[%capture_lane] : i64, view<64xi64>
  kernel.return
}

