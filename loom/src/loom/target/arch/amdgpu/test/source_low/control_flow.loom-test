amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @uniform_branch_condition_combined_with_lane_mask() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%values_buffer: buffer, %x: i32, %limit: i32, %true_value: i32, %false_value: i32, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %values_view = buffer.view %values_buffer[%fixture_base] : buffer -> view<64x2xi32>
  %values = vector.load %values_view[%fixture_lane, 0] : view<64x2xi32> -> vector<2xi32>
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi32>
  %lower_bound = scalar.constant 0 : i32
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %lane_ok = scalar.cmpi slt, %lane, %limit : i32
  %x_lower = scalar.cmpi sge, %x, %lower_bound : i32
  %x_upper = scalar.cmpi slt, %x, %limit : i32
  %x_ok = scalar.andi %x_lower, %x_upper : i1
  %combined = scalar.andi %lane_ok, %x_ok : i1
  cfg.cond_br %x_ok, ^valid, ^clamped
^valid:
  cfg.br ^join(%true_value: i32)
^clamped:
  cfg.br ^join(%false_value: i32)
^join(%selected: i32):
  %selected_vgpr = scalar.addi %selected, %lane : i32
  %result = scf.select %combined, %selected_vgpr, %lane : i32
  view.store %result, %result_view_0[%fixture_lane] : i32, view<64xi32>
  kernel.return
}

