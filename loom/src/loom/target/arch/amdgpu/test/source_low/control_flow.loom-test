  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %values_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %36 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  %lane = global_load_b32_saddr %36, %values_view
  %lower_bound = s_mov_b32 0
  %lane_ok = v_cmp_lt_i32 %lane, %limit
  %x_lower = s_cmp_ge_i32 %x, %lower_bound
  %x_upper = s_cmp_lt_i32 %x, %limit
  %43 = s_mov_b32 1
  %44 = s_cselect_b32 %43, %lower_bound, %x_lower
  %45 = s_cselect_b32 %43, %lower_bound, %x_upper
  %x_ok = s_and_b32 %44, %45
  %48 = s_cmp_lg_i32_src1_inline %x_ok {rhs = 0}
  %49 = slice %lane_ok[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %50 = s_cselect_b32 %49, %lower_bound, %48
  %51 = slice %lane_ok[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %52 = s_cselect_b32 %51, %lower_bound, %48
  %combined = concat(%50, %52) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %55 = s_cmp_lg_i32 %x_ok, %lower_bound
  low.cond_br %55, ^valid, ^clamped : reg<amdgpu.scc>
^valid:
  low.br ^join(%true_value: reg<amdgpu.sgpr>)
^clamped:
  low.br ^join(%false_value: reg<amdgpu.sgpr>)
^join(%selected: reg<amdgpu.sgpr>):
  %56 = v_mov_b32_copy %selected
  %selected_vgpr = v_add_u32 %56, %lane
  %result = v_cndmask_b32 %lane, %selected_vgpr, %combined
  %59 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %59, %result, %result_view_0
  return
