  %empty_value = s_mov_b32 0
  %24 = s_cmp_lg_i32 %count, %empty_value
  %26 = s_mov_b32 1
  %has_count = s_cselect_b32 %26, %empty_value, %24
  %29 = s_cmp_lg_i32 %has_count, %empty_value
  low.cond_br %29, ^has_values, ^empty : reg<amdgpu.scc>
^has_values:
  low.br ^join(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>)
^empty:
  low.br ^join(%empty_value: reg<amdgpu.sgpr>, %empty_value: reg<amdgpu.sgpr>)
^join(%selected_lhs: reg<amdgpu.sgpr>, %selected_rhs: reg<amdgpu.sgpr>):
  %sum = s_add_u32 %selected_lhs, %selected_rhs
  %32 = s_cmp_lg_i32 %has_count, %empty_value
  low.cond_br %32, ^sum, ^fallback : reg<amdgpu.scc>
^sum:
  low.br ^done(%sum: reg<amdgpu.sgpr>)
^fallback:
  low.br ^done(%empty_value: reg<amdgpu.sgpr>)
^done(%result: reg<amdgpu.sgpr>):
  %33 = v_mov_b32_copy %result
  %34 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %34, %33, %result_view_0
  return
