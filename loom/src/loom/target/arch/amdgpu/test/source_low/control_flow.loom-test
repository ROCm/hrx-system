low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 4, direct_arg_count = 4, direct_arg_names = {arg0 = "lhs", arg1 = "rhs", arg2 = "a", arg3 = "b"}, direct_arg_offsets = [0, 4, 8, 12], direct_arg_parameter_indices = [0, 1, 2, 3], direct_arg_sizes = [4, 4, 4, 4], parameter_count = 5, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [4], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @cfg_branch_condition_sink(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %a: reg<amdgpu.sgpr>, %b: reg<amdgpu.sgpr>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %sum = s_add_u32 %a, %b
  %cond = s_cmp_lt_i32 %lhs, %rhs
  low.cond_br %cond, ^then, ^else : reg<amdgpu.scc>
^then:
  low.br ^join(%sum: reg<amdgpu.sgpr>)
^else:
  %diff = s_sub_u32 %a, %b
  low.br ^join(%diff: reg<amdgpu.sgpr>)
^join(%result: reg<amdgpu.sgpr>):
  %24 = v_mov_b32_copy %result
  %25 = v_lshlrev_b32_src0_inline %capture_lane, 2
  global_store_b32_saddr %25, %24, %captured
  return
}

