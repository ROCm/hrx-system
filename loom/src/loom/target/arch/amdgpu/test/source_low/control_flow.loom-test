low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 4, direct_arg_count = 4, direct_arg_names = {arg0 = "row_i32", arg1 = "rows_i32", arg2 = "base_i32", arg3 = "scale_i32"}, direct_arg_offsets = [0, 4, 8, 12], direct_arg_parameter_indices = [0, 1, 2, 3], direct_arg_sizes = [4, 4, 4, 4], parameter_count = 5, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [4], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @index_i1_reused_after_salu_scc_clobber(%row: reg<amdgpu.sgpr>, %rows: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr>, %scale: reg<amdgpu.sgpr>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %row_increment = s_mov_b32 1
  %row1 = s_add_u32 %row, %row_increment
  %39 = s_cmp_lt_u32 %row1, %rows
  %40 = s_mov_b32 0
  %in_bounds = s_cselect_b32 %row_increment, %40, %39
  %entry_guard = s_cmp_lg_i32 %base, %scale
  %46 = s_cselect_b32 %row_increment, %40, %entry_guard
  %47 = s_and_b32 %in_bounds, %46
  %combined_guard = s_cmp_lg_i32 %47, %40
  low.cond_br %combined_guard, ^left, ^right : reg<amdgpu.scc>
^left:
  low.br ^body(%base: reg<amdgpu.sgpr>)
^right:
  low.br ^body(%scale: reg<amdgpu.sgpr>)
^body(%bounded_seed: reg<amdgpu.sgpr>):
  %scaled = s_add_u32 %bounded_seed, %scale
  %51 = s_cmp_lg_i32 %in_bounds, %40
  low.cond_br %51, ^then, ^body_done : reg<amdgpu.scc>
^then:
  %result = s_add_u32 %scaled, %row_increment
  low.br ^done(%result: reg<amdgpu.sgpr>)
^body_done:
  low.br ^done(%scaled: reg<amdgpu.sgpr>)
^done(%out: reg<amdgpu.sgpr>):
  %56 = v_mov_b32_copy %out
  %58 = v_mov_b32_copy %40
  %59 = concat(%56, %58) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %60 = v_lshlrev_b32_src0_inline %capture_lane, 3
  global_store_b64_saddr %60, %59, %captured
  return
}

