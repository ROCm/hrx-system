  %13 = v_and_b32_lit %12, 1023
  %14 = v_mov_b32 3
  %15 = v_mul_lo_u32 %13, %14
  %16 = v_add_u32 %11, %15
  %17 = v_lshrrev_b32_src0_inline %packed_tid, 20
