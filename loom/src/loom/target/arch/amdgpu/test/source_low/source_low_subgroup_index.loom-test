// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @subgroup_id_x_wave32() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%output: buffer) {
  %subgroup_id = kernel.subgroup.id : index
  %output_base = index.constant 0 : offset
  %output_view = buffer.view %output[%output_base] : buffer -> view<2xi32>
  %marker_value = vector.splati 1 : vector<1xi32>
  vector.store %marker_value, %output_view[%subgroup_id] : vector<1xi32>, view<2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_id_x_wave32() asm {
  %7 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %output_view = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %subgroup_id = v_lshrrev_b32_src0_inline %7, 5
  %marker_value = v_mov_b32 1
  %11 = v_lshlrev_b32_src0_inline %subgroup_id, 2
  global_store_b32_saddr %11, %marker_value, %output_view
  return
}

