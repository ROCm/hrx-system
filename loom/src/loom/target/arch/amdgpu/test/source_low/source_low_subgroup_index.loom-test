  %19 = v_mov_b32 15
  %20 = v_mul_lo_u32 %18, %19
  %21 = v_add_u32 %16, %20
  %subgroup_id = v_lshrrev_b32_src0_inline %21, 5
  %marker_value = v_mov_b32 1
  %24 = v_lshlrev_b32_src0_inline %subgroup_id, 2
