amdgpu.target<gfx11-generic> @target

// Non-power-of-two dimensions must linearize before selecting the subgroup.
kernel.def target(@target) @subgroup_id_xyz_non_power_of_two() {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  %c7 = index.constant 7 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c3, %c5, %c7) : index
} launch(%output: buffer) {
  %subgroup_id = kernel.subgroup.id : index
  %output_base = index.constant 0 : offset
  %output_view = buffer.view %output[%output_base] : buffer -> view<4xi32>
  %marker_value = vector.splati 1 : vector<1xi32>
  vector.store %marker_value, %output_view[%subgroup_id] : vector<1xi32>, view<4xi32>
  kernel.return
}

