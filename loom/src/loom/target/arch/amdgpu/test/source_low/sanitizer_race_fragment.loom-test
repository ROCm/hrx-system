// RUN: with-checks emit source-low output=low sanitizer=race

amdgpu.target<gfx11-generic> @target {subgroup_size = 32}

kernel.def target(@target) @race_fragment_shared_store() {
  %c1 = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch() {
  %c0 = index.constant 0 : index
  %c16 = index.constant 16 : index
  %base = index.constant 0 : offset
  %stage_bytes = index.constant 512 : offset
  %stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %stage_view = buffer.view %stage[%base] : buffer -> view<16x16xbf16>
  %operand = vector.splatf 1.0 : vector<16xbf16>
  %initial_values = vector.splatf 0.0 : vector<8xf32>
  %lhs = vector.fragment<lhs> %operand shape [%c16, %c16] : vector<16xbf16>
  %rhs = vector.fragment<rhs> %operand shape [%c16, %c16] : vector<16xbf16>
  %initial = vector.fragment<init> %initial_values shape [%c16, %c16] : vector<8xf32>
  %result = vector.mma %lhs, %rhs, %initial : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  vector.fragment.store<result> %result, %stage_view[%c0, %c0] shape [%c16, %c16] : vector<8xf32>, view<16x16xbf16>
  kernel.return
}

// ----
// This GFX11 fragment store's physical accesses form three contiguous
// byte-width groups. Each group shares one packet-selection loop and one
// static CAS body; the per-byte walk and bounded retry are loops as well.
CHECK: low.kernel.def * @race_fragment_shared_store() asm {
CHECK-COUNT-3: * = global_atomic_cmpswap_b64_rtn_saddr *
CHECK-NOT: *sanitizer.race.fragment_access*

// ====
amdgpu.target<gfx11-generic> @target {subgroup_size = 32}

kernel.def target(@target) @race_fragment_shared_load() {
  %c1 = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%output: buffer) {
  %c0 = index.constant 0 : index
  %c16 = index.constant 16 : index
  %base = index.constant 0 : offset
  %stage_bytes = index.constant 512 : offset
  %stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %stage_view = buffer.view %stage[%base] : buffer -> view<16x16xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  %fragment = vector.fragment.load<lhs> %stage_view[%c0, %c0] shape [%c16, %c16] : view<16x16xbf16> -> vector<16xbf16>
  vector.fragment.store<lhs> %fragment, %output_view[%c0, %c0] shape [%c16, %c16] : vector<16xbf16>, view<16x16xbf16>
  kernel.return
}

// ----
// The matching fragment load shares its observations across three contiguous
// byte-width groups.
CHECK: low.kernel.def * @race_fragment_shared_load() asm {
CHECK-COUNT-3: * = global_atomic_cmpswap_b64_rtn_saddr *
CHECK-NOT: *sanitizer.race.fragment_access*

// ====
// RUN: with-checks emit source-low output=low sanitizer=race sanitizer-reporting=trap

amdgpu.target<gfx950> @target

kernel.def target(@target) @race_crosslane_fragment_publication() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%lhs_data: vector<4xbf16>, %rhs_data: vector<4xbf16>, %init_data: vector<4xf32>, %output: buffer) {
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %stage_bytes = index.constant 512 : offset
  %stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %stage_view = buffer.view %stage[%base] : buffer -> view<16x16xbf16>
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %output_view = buffer.view %output_global[%base] : buffer -> view<16x16xf32>
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] : vector<4xbf16>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] : vector<4xbf16>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<4xf32>
  %first = vector.mma %lhs, %rhs, %init : vector<4xbf16>, vector<4xbf16>, vector<4xf32>
  vector.fragment.store<result> %first, %stage_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xbf16>
  %repacked = vector.fragment.repack<lhs> %first shape [%m, %k] : vector<4xf32> -> vector<4xbf16>
  %second = vector.mma %repacked, %rhs, %init : vector<4xbf16>, vector<4xbf16>, vector<4xf32>
  vector.fragment.store<result> %second, %output_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>
  kernel.return
}

// ----
// Four cross-lane B32 publications remain four physical stores while sharing
// one observation body. Neither the packet loop, byte walk, nor retry policy
// duplicates that body.
CHECK: low.kernel.def * @race_crosslane_fragment_publication(* asm {
CHECK-COUNT-1: * = global_atomic_cmpswap_x2_rtn_saddr *
CHECK-COUNT-4: ds_write_b32 *
CHECK-NOT: *sanitizer.race.fragment_access*
