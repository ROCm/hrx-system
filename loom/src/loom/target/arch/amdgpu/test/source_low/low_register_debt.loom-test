// Six computed values overflow the small vector budget. Required reloads must
// make progress before future store addresses overflow the scalar bank too.
// The exact assembly covers spill insertion, address carries, and EXEC repair.
// RUN: emit amdgpu-assembly @computed_snapshot amdgpu.vgpr=6 amdgpu.sgpr=12

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @computed_snapshot(%input: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>, %lane: reg<amdgpu.vgpr>) asm {
  %saved = s_mov_b64_exec_read
  %output_low = slice %output[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %output_high = slice %output[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %input_low = slice %input[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %input_high = slice %input[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %zero = s_mov_b32 0
  %input_low0, %input_carry0 = s_add_co_u32 %input_low, %offset
  %input_high0, %input_unused0 = s_addc_u32 %input_high, %zero, %input_carry0
  %input_address0 = concat(%input_low0, %input_high0) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %loaded0 = global_load_dword_saddr %lane, %input_address0 : reg<amdgpu.vgpr>
  %input_low1, %input_carry1 = s_add_co_u32 %input_low, %offset
  %input_high1, %input_unused1 = s_addc_u32 %input_high, %zero, %input_carry1
  %input_address1 = concat(%input_low1, %input_high1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %loaded1 = global_load_dword_saddr %lane, %input_address1 {offset = 4} : reg<amdgpu.vgpr>
  %input_low2, %input_carry2 = s_add_co_u32 %input_low, %offset
  %input_high2, %input_unused2 = s_addc_u32 %input_high, %zero, %input_carry2
  %input_address2 = concat(%input_low2, %input_high2) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %loaded2 = global_load_dword_saddr %lane, %input_address2 {offset = 8} : reg<amdgpu.vgpr>
  %input_low3, %input_carry3 = s_add_co_u32 %input_low, %offset
  %input_high3, %input_unused3 = s_addc_u32 %input_high, %zero, %input_carry3
  %input_address3 = concat(%input_low3, %input_high3) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %loaded3 = global_load_dword_saddr %lane, %input_address3 {offset = 12} : reg<amdgpu.vgpr>
  %input_low4, %input_carry4 = s_add_co_u32 %input_low, %offset
  %input_high4, %input_unused4 = s_addc_u32 %input_high, %zero, %input_carry4
  %input_address4 = concat(%input_low4, %input_high4) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %loaded4 = global_load_dword_saddr %lane, %input_address4 {offset = 16} : reg<amdgpu.vgpr>
  %input_low5, %input_carry5 = s_add_co_u32 %input_low, %offset
  %input_high5, %input_unused5 = s_addc_u32 %input_high, %zero, %input_carry5
  %input_address5 = concat(%input_low5, %input_high5) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %loaded5 = global_load_dword_saddr %lane, %input_address5 {offset = 20} : reg<amdgpu.vgpr>
  %bias = v_mov_b32 7
  %computed0 = v_add_u32 %loaded0, %bias
  %low0, %carry0 = s_add_co_u32 %output_low, %offset
  %high0, %unused0 = s_addc_u32 %output_high, %zero, %carry0
  %address0 = concat(%low0, %high0) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_dword_saddr %lane, %computed0, %address0
  %computed1 = v_add_u32 %loaded1, %bias
  %low1, %carry1 = s_add_co_u32 %output_low, %offset
  %high1, %unused1 = s_addc_u32 %output_high, %zero, %carry1
  %address1 = concat(%low1, %high1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_dword_saddr %lane, %computed1, %address1 {offset = 4}
  %computed2 = v_add_u32 %loaded2, %bias
  %low2, %carry2 = s_add_co_u32 %output_low, %offset
  %high2, %unused2 = s_addc_u32 %output_high, %zero, %carry2
  %address2 = concat(%low2, %high2) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_dword_saddr %lane, %computed2, %address2 {offset = 8}
  %computed3 = v_add_u32 %loaded3, %bias
  %low3, %carry3 = s_add_co_u32 %output_low, %offset
  %high3, %unused3 = s_addc_u32 %output_high, %zero, %carry3
  %address3 = concat(%low3, %high3) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_dword_saddr %lane, %computed3, %address3 {offset = 12}
  %computed4 = v_add_u32 %loaded4, %bias
  %low4, %carry4 = s_add_co_u32 %output_low, %offset
  %high4, %unused4 = s_addc_u32 %output_high, %zero, %carry4
  %address4 = concat(%low4, %high4) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_dword_saddr %lane, %computed4, %address4 {offset = 16}
  %computed5 = v_add_u32 %loaded5, %bias
  %low5, %carry5 = s_add_co_u32 %output_low, %offset
  %high5, %unused5 = s_addc_u32 %output_high, %zero, %carry5
  %address5 = concat(%low5, %high5) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_dword_saddr %lane, %computed5, %address5 {offset = 20}
  s_mov_b64_exec %saved
  return
}

