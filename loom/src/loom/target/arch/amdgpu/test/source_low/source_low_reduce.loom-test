low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @f32_configured_width_square_reduce() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %28 = v_lshlrev_b32_src0_inline %lane, 4
  %loaded = global_load_b128_saddr %28, %input_view
  %31 = v_mov_b32 0
  %32 = slice %loaded[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %34 = v_fmac_f32 %31, %32, %32
  %35 = slice %loaded[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %37 = v_mul_f32 %35, %35
  %38 = slice %loaded[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %40 = v_mul_f32 %38, %38
  %41 = slice %loaded[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %43 = v_mul_f32 %41, %41
  %44 = v_add_f32 %34, %37
  %45 = v_add_f32 %40, %43
  %stored = v_add_f32 %44, %45
  %47 = v_mov_b32 0
  global_store_b32_saddr %47, %stored, %output_view
  return
}

