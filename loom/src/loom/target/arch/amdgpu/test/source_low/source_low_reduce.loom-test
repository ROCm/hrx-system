func.def @i32x3_reduce_combining_kinds(%values: vector<3xi32>, %init: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32) {
  %product = vector.reduce<muli> %values, %init : vector<3xi32>, i32
  %signed_minimum = vector.reduce<minsi> %values, %init : vector<3xi32>, i32
  %signed_maximum = vector.reduce<maxsi> %values, %init : vector<3xi32>, i32
  %unsigned_minimum = vector.reduce<minui> %values, %init : vector<3xi32>, i32
  %unsigned_maximum = vector.reduce<maxui> %values, %init : vector<3xi32>, i32
  %bitwise_and = vector.reduce<andi> %values, %init : vector<3xi32>, i32
  %bitwise_or = vector.reduce<ori> %values, %init : vector<3xi32>, i32
  %bitwise_xor = vector.reduce<xori> %values, %init : vector<3xi32>, i32
  func.return %product, %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum, %bitwise_and, %bitwise_or, %bitwise_xor : i32, i32, i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i32x3_reduce_combining_kinds(%values: reg<amdgpu.vgpr x3>, %init: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %28 = v_mov_b32_copy %init
  %29 = slice %values[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %30 = v_mul_lo_u32 %28, %29
  %31 = slice %values[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %32 = v_mul_lo_u32 %30, %31
  %33 = slice %values[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %product = v_mul_lo_u32 %32, %33
  %37 = v_min_i32 %28, %29
  %39 = v_min_i32 %37, %31
  %signed_minimum = v_min_i32 %39, %33
  %44 = v_max_i32 %28, %29
  %46 = v_max_i32 %44, %31
  %signed_maximum = v_max_i32 %46, %33
  %51 = v_min_u32 %28, %29
  %53 = v_min_u32 %51, %31
  %unsigned_minimum = v_min_u32 %53, %33
  %58 = v_max_u32 %28, %29
  %60 = v_max_u32 %58, %31
  %unsigned_maximum = v_max_u32 %60, %33
  %65 = v_and_b32 %28, %29
  %67 = v_and_b32 %65, %31
  %bitwise_and = v_and_b32 %67, %33
  %72 = v_or_b32 %28, %29
  %74 = v_or_b32 %72, %31
  %bitwise_or = v_or_b32 %74, %33
  %79 = v_xor_b32 %28, %29
  %81 = v_xor_b32 %79, %31
  %bitwise_xor = v_xor_b32 %81, %33
  return %product, %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum, %bitwise_and, %bitwise_or, %bitwise_xor
}

