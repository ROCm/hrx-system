amdgpu.target<gfx11-generic> @target
func.def target(@target) @i32_reduce_add(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<4xi32, #encoding.layout.dense>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32, #encoding.layout.dense>
  %loaded = vector.load %input_view[0] : view<4xi32, #encoding.layout.dense> -> vector<4xi32>
  %init = scalar.constant 0 : i32
  %sum = vector.reduce<addi> %loaded, %init : vector<4xi32>, i32
  %stored = vector.from_elements %sum : vector<1xi32>
  vector.store %stored, %output_view[0] : vector<1xi32>, view<1xi32, #encoding.layout.dense>
  func.return
}

