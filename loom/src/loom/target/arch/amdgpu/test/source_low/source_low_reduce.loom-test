  %39 = slice %values[0] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %38 = slice %values[3] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %16 = v_add_u32 %39, %38
  %37 = slice %values[1] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %36 = slice %values[4] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %19 = v_add_u32 %37, %36
  %35 = slice %values[2] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %34 = slice %values[5] : reg<amdgpu.vgpr x6> -> reg<amdgpu.vgpr>
  %22 = v_add_u32 %35, %34
  %24 = slice %init[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %26 = v_add_u32 %24, %16
  %27 = slice %init[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %29 = v_add_u32 %27, %19
  %30 = slice %init[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %32 = v_add_u32 %30, %22
  %result = concat(%26, %29, %32) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  return %result
}
