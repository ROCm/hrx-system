config.def @runtime.vector_width = 4 : index

func.def @i32_configured_width_sum(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %vector_width = config.get @runtime.vector_width : index
  %vector_width_bounded = index.assume %vector_width [range(%vector_width, 2, 4)] : index
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<[%vector_width_bounded]xi32>
  %initial_sum = scalar.constant 0 : i32
  %sum = vector.reduce<addi> %loaded, %initial_sum : vector<[%vector_width_bounded]xi32>, i32
  %stored = vector.from_elements %sum : vector<1xi32>
  vector.store %stored, %output_view[0] : vector<1xi32>, view<1xi32>
  func.return
}

