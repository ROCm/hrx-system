func.def @f32x16_reduce_add_native(%values: vector<16xf32>) -> (f32) {
  %init = scalar.constant 0.0 : f32
  %sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %values, %init : vector<16xf32>, f32
  func.return %sum : f32
}

