func.def @i32_reduce_minui_select_sentinel(%values: vector<4xi32>) -> (i32) {
  %empty_value = scalar.constant 0 : i32
  %zeros = vector.splat %empty_value : vector<4xi32>
  %is_zero = vector.cmpi eq, %values, %zeros : vector<4xi32> -> vector<4xi1>
  %start = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %indices = vector.iota %start step %step : vector<4xi32>
  %sentinel = scalar.constant 2147483647 : i32
  %sentinels = vector.splat %sentinel : vector<4xi32>
  %selected = vector.select %is_zero, %indices, %sentinels : vector<4xi32>
  %result = vector.reduce<minui> %selected, %sentinel : vector<4xi32>, i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i32_reduce_minui_select_sentinel(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr>) asm {
  %25 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %26 = v_cmp_eq_i32_src1_inline %25 {rhs = 0}
  %27 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %28 = v_cmp_eq_i32_src1_inline %27 {rhs = 0}
  %29 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %30 = v_cmp_eq_i32_src1_inline %29 {rhs = 0}
  %31 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %32 = v_cmp_eq_i32_src1_inline %31 {rhs = 0}
  %48 = v_cndmask_b32_src0_lit_src1_inline %26 {imm32 = 2147483647, true_value = 0}
  %50 = v_cndmask_b32_src0_lit_src1_inline %28 {imm32 = 2147483647, true_value = 1}
  %52 = v_cndmask_b32_src0_lit_src1_inline %30 {imm32 = 2147483647, true_value = 2}
  %54 = v_cndmask_b32_src0_lit_src1_inline %32 {imm32 = 2147483647, true_value = 3}
  %58 = v_min_u32 %48, %50
  %60 = v_min_u32 %58, %52
  %result = v_min_u32 %60, %54
  return %result
}

