// ----
low.func.def target<amdgpu.cdna4.core>(@target) abi(hal_kernel) @vector_uitofp_i8x4(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %5 = v_cvt_f32_ubyte0 %input
  %6 = v_cvt_f32_ubyte1 %input
  %7 = v_cvt_f32_ubyte2 %input
  %8 = v_cvt_f32_ubyte3 %input
  %converted = concat(%5, %6, %7, %8) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %converted
}

