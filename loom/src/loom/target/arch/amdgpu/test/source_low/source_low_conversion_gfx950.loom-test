// ----
low.func.def target<amdgpu.cdna4.core>(@target) abi(hal_kernel) @vector_fptosi_i8x8(%input: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x2>) asm {
  %5 = slice %input[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %6 = v_cvt_i32_f32 %5
  %7 = slice %input[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %8 = v_cvt_i32_f32 %7
  %9 = slice %input[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %10 = v_cvt_i32_f32 %9
  %11 = slice %input[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %12 = v_cvt_i32_f32 %11
  %13 = slice %input[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %14 = v_cvt_i32_f32 %13
  %15 = slice %input[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %16 = v_cvt_i32_f32 %15
  %17 = slice %input[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %18 = v_cvt_i32_f32 %17
  %19 = slice %input[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %20 = v_cvt_i32_f32 %19
  %21 = s_mov_b32 4
  %22 = s_mov_b32 16778500
  %23 = v_perm_b32 %6, %8, %21
  %24 = v_perm_b32 %10, %12, %21
  %25 = v_perm_b32 %23, %24, %22
  %26 = v_perm_b32 %14, %16, %21
  %27 = v_perm_b32 %18, %20, %21
  %28 = v_perm_b32 %26, %27, %22
  %converted = concat(%25, %28) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %converted
}

