// RUN: emit amdgpu-bank-service

amdgpu.target<gfx1100> @target_gfx1100_32 {subgroup_size = 32}

kernel.def target(@target_gfx1100_32) @strided_gfx1100_wave32() {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 6144 : offset
  %layout = encoding.layout.strided [24, 1] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<64x4xi32, %layout>
  %value = vector.constant 1 : vector<4xi32>
  vector.store %value, %view[%lane, 0] : vector<4xi32>, view<64x4xi32, %layout>
  kernel.return
}

