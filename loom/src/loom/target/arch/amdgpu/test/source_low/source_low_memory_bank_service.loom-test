// A subgroup-common page offset preserves the per-wave bank profile.
kernel.def target(@target_gfx1100_32) @staged_rows() {
  %unit = index.constant 1 : index
  %columns = index.constant 32 : index
  %rows = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%columns, %rows, %unit) : index
} launch() {
  %column = kernel.workitem.id<x> : index
  %row = kernel.workitem.id<y> : index
  %wave = kernel.subgroup.id : index
  %page_bytes = index.constant 512 : offset
  %base = index.scale %wave, %page_bytes : index, offset -> offset
  %bytes = index.constant 2048 : offset
  %layout = encoding.layout.strided [4, 128, 1] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<32x2x4xi32, %layout>
  %value = vector.constant 1 : vector<4xi32>
  vector.store %value, %view[%column, %row, 0] : vector<4xi32>, view<32x2x4xi32, %layout>
  kernel.return
}

// Row coordinates vary inside each service phase in this workgroup shape.
kernel.def target(@target_gfx1100_32) @rows_inside_wave() {
  %unit = index.constant 1 : index
  %columns = index.constant 4 : index
  %rows = index.constant 8 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%columns, %rows, %unit) : index
} launch() {
  %column = kernel.workitem.id<x> : index
  %row = kernel.workitem.id<y> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 4096 : offset
  %layout = encoding.layout.strided [4, 128, 1] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<4x8x4xi32, %layout>
  %value = vector.constant 1 : vector<4xi32>
  vector.store %value, %view[%column, %row, 0] : vector<4xi32>, view<4x8x4xi32, %layout>
  kernel.return
}

