// RUN: emit source-low target=amdgpu:gfx1100 output=low

func.def @ordinary_f64(%lhs: f64, %rhs: f64, %addend: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  %sum = scalar.addf %lhs, %rhs : f64
  %difference = scalar.subf %lhs, %rhs : f64
  %product = scalar.mulf %lhs, %rhs : f64
  %fused = scalar.fmaf %lhs, %rhs, %addend : f64
  %quotient = scalar.divf %lhs, %rhs : f64
  %copied_sign = scalar.copysignf %lhs, %rhs : f64
  %approximate_root = scalar.sqrtf<afn> %lhs : f64
  func.return %sum, %difference, %product, %fused, %quotient, %copied_sign, %approximate_root : f64, f64, f64, f64, f64, f64, f64
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @ordinary_f64(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>, %addend: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %sum = v_add_f64 %lhs, %rhs
  %difference = v_sub_f64 %lhs, %rhs
  %product = v_mul_f64 %lhs, %rhs
  %fused = v_fma_f64 %lhs, %rhs, %addend
  %31, %32 = v_div_scale_f64 %rhs, %rhs, %lhs
  %33 = v_rcp_f64 %31
  %34 = v_fma_f64_neg_a_one %31, %33
  %35 = v_fma_f64 %33, %34, %33
  %36 = v_fma_f64_neg_a_one %31, %35
  %37, %38 = v_div_scale_f64 %lhs, %rhs, %lhs
  %39 = v_fma_f64 %35, %36, %35
  %40 = v_mul_f64 %37, %39
  %41 = v_fma_f64_neg_a %31, %40, %37
  %42 = v_div_fmas_f64 %41, %39, %40, %38
  %quotient = v_div_fixup_f64 %42, %rhs, %lhs
  %44 = slice %lhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %45 = slice %lhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %46 = slice %rhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %47 = v_bfi_b32_src0_lit %45, %46, 2147483647
  %copied_sign = concat(%44, %47) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %approximate_root = v_sqrt_f64 %lhs
  return %sum, %difference, %product, %fused, %quotient, %copied_sign, %approximate_root
}

// ====

func.def @convert_to_f64(%signed32: i32, %unsigned32: i32, %signed64: i64, %unsigned64: i64) -> (f64, f64, f64, f64) {
  %signed32_result = scalar.sitofp %signed32 : i32 to f64
  %unsigned32_result = scalar.uitofp %unsigned32 : i32 to f64
  %signed64_result = scalar.sitofp %signed64 : i64 to f64
  %unsigned64_result = scalar.uitofp %unsigned64 : i64 to f64
  func.return %signed32_result, %unsigned32_result, %signed64_result, %unsigned64_result : f64, f64, f64, f64
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @convert_to_f64(%signed32: reg<amdgpu.vgpr>, %unsigned32: reg<amdgpu.vgpr>, %signed64: reg<amdgpu.vgpr x2>, %unsigned64: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %signed32_result = v_cvt_f64_i32 %signed32
  %unsigned32_result = v_cvt_f64_u32 %unsigned32
  %22 = slice %signed64[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %23 = slice %signed64[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %24 = v_cvt_f64_u32 %22
  %25 = v_cvt_f64_i32 %23
  %26 = v_mov_b32 0
  %27 = v_mov_b32 1106247680
  %28 = concat(%26, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %29 = v_mul_f64 %25, %28
  %signed64_result = v_add_f64 %29, %24
  %31 = slice %unsigned64[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %32 = slice %unsigned64[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %33 = v_cvt_f64_u32 %31
  %34 = v_cvt_f64_u32 %32
  %37 = concat(%26, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %38 = v_mul_f64 %34, %37
  %unsigned64_result = v_add_f64 %38, %33
  return %signed32_result, %unsigned32_result, %signed64_result, %unsigned64_result
}

// ====

func.def @f64_rounding_and_integer_conversion(%value: f64) -> (f64, f64, f64, f64, i32, i32) {
  %ceiled = scalar.ceilf %value : f64
  %floored = scalar.floorf %value : f64
  %rounded = scalar.roundevenf %value : f64
  %truncated = scalar.truncf %value : f64
  %signed = scalar.fptosi %value : f64 to i32
  %unsigned = scalar.fptoui %value : f64 to i32
  func.return %ceiled, %floored, %rounded, %truncated, %signed, %unsigned : f64, f64, f64, f64, i32, i32
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @f64_rounding_and_integer_conversion(%value: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %ceiled = v_ceil_f64 %value
  %floored = v_floor_f64 %value
  %rounded = v_rndne_f64 %value
  %truncated = v_trunc_f64 %value
  %signed = v_cvt_i32_f64 %value
  %unsigned = v_cvt_u32_f64 %value
  return %ceiled, %floored, %rounded, %truncated, %signed, %unsigned
}

// ====

func.def @f64_number_clamp(%value: f64, %lower: f64, %upper: f64) -> (f64) {
  %result = scalar.clampf<number> %value, %lower, %upper : f64
  func.return %result : f64
}

// ----
low.func.def target<amdgpu.rdna3.core> abi(hal_kernel) @f64_number_clamp(%value: reg<amdgpu.vgpr x2>, %lower: reg<amdgpu.vgpr x2>, %upper: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %37 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %38 = slice %lower[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %39 = v_and_b32 %37, %38
  %40 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %41 = slice %lower[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %42 = v_and_b32 %40, %41
  %44 = v_cmp_gt_f64 %value, %lower
  %45 = v_cmp_gt_f64 %lower, %value
  %48 = v_cndmask_b32 %39, %38, %45
  %51 = v_cndmask_b32 %42, %41, %45
  %55 = v_cndmask_b32 %48, %37, %44
  %58 = v_cndmask_b32 %51, %40, %44
  %60 = v_cmp_neq_f64 %value, %value
  %61 = v_cmp_neq_f64 %lower, %lower
  %62 = v_mov_b32 0
  %63 = v_mov_b32 2146959360
  %67 = v_cndmask_b32 %38, %62, %61
  %70 = v_cndmask_b32 %41, %63, %61
  %74 = v_cndmask_b32 %55, %37, %61
  %77 = v_cndmask_b32 %58, %40, %61
  %81 = v_cndmask_b32 %74, %67, %60
  %84 = v_cndmask_b32 %77, %70, %60
  %85 = concat(%81, %84) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %87 = slice %upper[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %88 = v_or_b32 %81, %87
  %90 = slice %upper[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %91 = v_or_b32 %84, %90
  %93 = v_cmp_lt_f64 %85, %upper
  %94 = v_cmp_lt_f64 %upper, %85
  %97 = v_cndmask_b32 %88, %87, %94
  %100 = v_cndmask_b32 %91, %90, %94
  %104 = v_cndmask_b32 %97, %81, %93
  %107 = v_cndmask_b32 %100, %84, %93
  %109 = v_cmp_neq_f64 %85, %85
  %110 = v_cmp_neq_f64 %upper, %upper
  %113 = v_cndmask_b32 %87, %62, %110
  %116 = v_cndmask_b32 %90, %63, %110
  %120 = v_cndmask_b32 %104, %81, %110
  %123 = v_cndmask_b32 %107, %84, %110
  %127 = v_cndmask_b32 %120, %113, %109
  %130 = v_cndmask_b32 %123, %116, %109
  %result = concat(%127, %130) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}
