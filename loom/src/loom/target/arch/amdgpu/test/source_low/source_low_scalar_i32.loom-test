// RUN: emit source-low target=amdgpu:gfx11-generic output=low

kernel.def @scalar_i32_uniform_sgpr() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs: i32, %rhs: i32, %shift: i32, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi32>
  %add = scalar.addi %lhs, %rhs : i32
  %sub = scalar.subi %add, %rhs : i32
  %product = scalar.muli %sub, %rhs : i32
  %and = scalar.andi %product, %lhs : i32
  %or = scalar.ori %and, %rhs : i32
  %xor = scalar.xori %or, %lhs : i32
  %shl = scalar.shli %xor, %shift : i32
  %ashr = scalar.shrsi %shl, %shift : i32
  %lshr = scalar.shrui %ashr, %shift : i32
  view.store %lshr, %result_view_0[%fixture_lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 3, direct_arg_count = 3, direct_arg_names = {arg0 = "lhs", arg1 = "rhs", arg2 = "shift"}, direct_arg_offsets = [0, 4, 8], direct_arg_parameter_indices = [0, 1, 2], direct_arg_sizes = [4, 4, 4], parameter_count = 4, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @scalar_i32_uniform_sgpr(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %shift: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %product = s_mul_i32 %lhs, %rhs
  %and = s_and_b32 %product, %lhs
  %or = s_or_b32 %and, %rhs
  %xor = s_xor_b32 %or, %lhs
  %shl = s_lshl_b32 %xor, %shift
  %ashr = s_ashr_i32 %shl, %shift
  %lshr = s_lshr_b32 %ashr, %shift
  %30 = v_mov_b32_copy %lshr
  %31 = v_lshlrev_b32_src0_inline %fixture_lane, 2
  global_store_b32_saddr %31, %30, %result_view_0
  return
}

// ====

func.def @scalar_i32_multiply_add(%a: i32, %b: i32, %c: i32) -> (i32) {
  %product = scalar.muli %a, %b : i32
  %result = scalar.addi %product, %c : i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_i32_multiply_add(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %product = v_mul_lo_u32 %a, %b
  %result = v_add_u32 %product, %c
  return %result
}

// ====

func.def @scalar_i32_bitfield_argument(%word: i32) -> (i32, i32, i32, i32, i32, i32) {
  %unsigned_byte = scalar.bitfield.extractu %word {offset = 8, width = 8} : i32 -> i32
  %signed_byte = scalar.bitfield.extracts %word {offset = 16, width = 8} : i32 -> i32
  %unsigned_nibble = scalar.bitfield.extractu %word {offset = 4, width = 4} : i32 -> i32
  %signed_nibble = scalar.bitfield.extracts %word {offset = 4, width = 4} : i32 -> i32
  %unsigned_top = scalar.bitfield.extractu %word {offset = 24, width = 8} : i32 -> i32
  %signed_top = scalar.bitfield.extracts %word {offset = 24, width = 8} : i32 -> i32
  func.return %unsigned_byte, %signed_byte, %unsigned_nibble, %signed_nibble, %unsigned_top, %signed_top : i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_i32_bitfield_argument(%word: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %unsigned_byte = v_bfe_u32_offset_width_inline %word {offset = 8, width = 8}
  %signed_byte = v_bfe_i32_offset_width_inline %word {offset = 16, width = 8}
  %unsigned_nibble = v_bfe_u32_offset_width_inline %word {offset = 4, width = 4}
  %signed_nibble = v_bfe_i32_offset_width_inline %word {offset = 4, width = 4}
  %unsigned_top = v_lshrrev_b32_src0_inline %word, 24
  %signed_top = v_ashrrev_i32_src0_inline %word, 24
  return %unsigned_byte, %signed_byte, %unsigned_nibble, %signed_nibble, %unsigned_top, %signed_top
}

// ====

func.def @scalar_i32_bitfield_vector_lane(%packed: vector<1xi32>) -> (i32, i32, i32, i32) {
  %word = vector.extract %packed[0] : vector<1xi32> -> i32
  %unsigned_top = scalar.bitfield.extractu %word {offset = 24, width = 8} : i32 -> i32
  %signed_top = scalar.bitfield.extracts %word {offset = 24, width = 8} : i32 -> i32
  %unsigned_middle = scalar.bitfield.extractu %word {offset = 8, width = 8} : i32 -> i32
  %signed_middle = scalar.bitfield.extracts %word {offset = 8, width = 8} : i32 -> i32
  func.return %unsigned_top, %signed_top, %unsigned_middle, %signed_middle : i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_i32_bitfield_vector_lane(%word: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %unsigned_top = v_lshrrev_b32_src0_inline %word, 24
  %signed_top = v_ashrrev_i32_src0_inline %word, 24
  %unsigned_middle = v_bfe_u32_offset_width_inline %word {offset = 8, width = 8}
  %signed_middle = v_bfe_i32_offset_width_inline %word {offset = 8, width = 8}
  return %unsigned_top, %signed_top, %unsigned_middle, %signed_middle
}

// ====

func.def @scalar_i32_compare_scc(%lhs: i32, %rhs: i32) -> (i1) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %cmp : i1
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_i32_compare_scc(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %cmp = v_cmp_lt_i32 %lhs, %rhs
  return %cmp
}

// ====

func.def @scalar_i1_constants_scc() -> (i1, i1) {
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  func.return %true, %false : i1, i1
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_i1_constants_scc() -> (reg<amdgpu.scc>, reg<amdgpu.scc>) asm {
  %6 = s_mov_b32 0
  %true = s_cmp_eq_i32 %6, %6
  %false = s_cmp_lg_i32 %6, %6
  return %true, %false
}

// ====

func.def @scalar_i1_bitwise_scc(%lhs: i32, %rhs: i32) -> (i1) {
  %inactive_condition = scalar.constant 0 : i32
  %lhs_nonzero = scalar.cmpi ne, %lhs, %inactive_condition : i32
  %rhs_nonzero = scalar.cmpi ne, %rhs, %inactive_condition : i32
  %both_nonzero = scalar.andi %lhs_nonzero, %rhs_nonzero : i1
  %either_nonzero = scalar.ori %lhs_nonzero, %rhs_nonzero : i1
  %one_nonzero = scalar.xori %both_nonzero, %either_nonzero : i1
  func.return %one_nonzero : i1
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_i1_bitwise_scc(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %lhs_nonzero = v_cmp_ne_i32_src1_inline %lhs {rhs = 0}
  %rhs_nonzero = v_cmp_ne_i32_src1_inline %rhs {rhs = 0}
  %both_nonzero = s_and_b64 %lhs_nonzero, %rhs_nonzero
  %either_nonzero = s_or_b64 %lhs_nonzero, %rhs_nonzero
  %one_nonzero = s_xor_b64 %both_nonzero, %either_nonzero
  return %one_nonzero
}
