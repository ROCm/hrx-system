// RUN: emit amdgpu-assembly @cdna2_wide_store_reuse

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_wide_store_reuse(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dwordx4_saddr %address, %data, %base
  %replacement = v_mov_b32 42
  return %replacement
}

// ----
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
  v_mov_b32 v0, 42
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

