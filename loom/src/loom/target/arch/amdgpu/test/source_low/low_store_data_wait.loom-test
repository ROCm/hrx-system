amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @wide_store_two_slots(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dwordx4_saddr %address, %data, %base
  %first = v_mov_b32 7
  %second = v_add_u32 %first, %first
  %replacement = v_add_u32 %second, %second
  return %replacement
}

// ----
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
  v_mov_b32 v0, 7
  v_add_u32 v0, v0, v0
  v_add_u32 v0, v0, v0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

