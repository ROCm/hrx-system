// RUN: emit amdgpu-assembly @wide_store_reuse

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @wide_store_reuse(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dwordx4_saddr %address, %data, %base
  %replacement = v_mov_b32 42
  return %replacement
}

// The payload remains readable for two slots after the wide store issues.
// ----
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
  v_mov_b32 v0, 42
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @wide_store_last_component

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @wide_store_last_component(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x3>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dwordx3_saddr %address, %data, %base
  %replacement = v_mov_b32 42
  return %replacement
}

// Overlap with the last payload VGPR is still a hazard.
// ----
  global_store_dwordx3 v0, v[2:4], s[0:1] offset:0
  v_mov_b32 v0, 42
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

