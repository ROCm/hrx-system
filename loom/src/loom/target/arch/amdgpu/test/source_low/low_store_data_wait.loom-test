// ====
// RUN: emit amdgpu-assembly @wide_store_prefix_delay_shared

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @wide_store_prefix_delay_shared(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  global_store_dwordx4_saddr %address, %data, %base
  low.br ^first
^first:
  %first = v_mov_b32 7
  low.br ^second
^second:
  %second = v_mov_b32 42
  return %first, %second
}

// A delay protecting the first overwrite also retires the successor's obligation.
// ----
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
.Lbb1:
  v_mov_b32 v0, 7
.Lbb2:
  v_mov_b32 v1, 42
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @wide_store_two_branch_transfer

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @wide_store_two_branch_transfer(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dwordx4_saddr %address, %data, %base
  low.cond_br %condition, ^overwrite, ^exit : reg<amdgpu.scc>
^join(%result: reg<amdgpu.vgpr>):
  return %result
^overwrite:
  %replacement = v_mov_b32 42
  low.br ^join(%replacement: reg<amdgpu.vgpr>)
^exit:
  low.br ^join(%address: reg<amdgpu.vgpr>)
}

// The taken conditional executes only one of the two emitted branch instructions.
// ----
  global_store_dwordx4 v4, v[0:3], s[0:1] offset:0
  s_cbranch_scc1 .Lbb2
  s_branch .Lbb3
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm
.Lbb2:
  v_mov_b32 v4, 42
  s_branch .Lbb1
.Lbb3:
  s_branch .Lbb1

