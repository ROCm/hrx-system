// ====
// A scalar-offset buffer store uses the shorter window in either bank.
// RUN: emit amdgpu-assembly @accumulator_buffer_matrix_write

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @accumulator_buffer_matrix_write(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>, %data: reg<amdgpu.agpr x4>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.agpr x4>) asm {
  buffer_store_dwordx4 %data, %resource, %address, %offset
  %replacement = v_mfma_f32_16x16x4_f32 %lhs, %rhs, %data
  return %replacement
}

// ----
  buffer_store_dwordx4 acc[0:3], v0, s[0:3], s4 offen offset:0
  s_nop 0
  v_mfma_f32_16x16x4_f32 acc[0:3], v1, v2, acc[0:3]
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_nop 8
  s_endpgm

