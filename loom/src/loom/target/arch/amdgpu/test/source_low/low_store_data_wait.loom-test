// ====
// RUN: emit amdgpu-assembly @wide_store_join

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @wide_store_join(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  low.cond_br %condition, ^store, ^empty : reg<amdgpu.scc>
^store:
  global_store_dwordx4_saddr %address, %data, %base
  low.br ^join
^empty:
  low.br ^join
^join:
  %replacement = v_mov_b32 42
  return %replacement
}

// The taken branch supplies one slot on the path that stored the payload.
// ----
  s_cbranch_scc0 .Lbb2
.Lbb1:
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
  s_branch .Lbb3
.Lbb2:
.Lbb3:
  v_mov_b32 v0, 42
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

