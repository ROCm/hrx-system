// ====
// RUN: emit amdgpu-assembly @cdna2_wide_compare_swap_reuse

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_wide_compare_swap_reuse(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>) asm {
  %old = global_atomic_cmpswap_x2_rtn_saddr %address, %data, %base : reg<amdgpu.vgpr x2>
  %replacement = v_mov_b32 42
  return %replacement, %old
}

// ----
  global_atomic_cmpswap_x2 v[0:1], v0, v[4:7], s[0:1] offset:0 glc
  v_mov_b32 v2, 42
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @cdna2_wide_store_backedge

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_wide_store_backedge(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) asm {
  low.br ^loop
^loop:
  %value = v_mov_b32 42
  %data = concat(%value, %value, %value, %value) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_dwordx4_saddr %address, %data, %base
  low.cond_br %condition, ^loop, ^exit : reg<amdgpu.scc>
^exit:
  return
}

// ----
.Lbb1:
  v_mov_b32 v4, 42
  v_mov_b32 v5, v4
  v_mov_b32 v6, v4
  v_mov_b32 v7, v4
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
  s_cbranch_scc1 .Lbb1
.Lbb2:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @cdna2_wide_store_one_slot

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_wide_store_one_slot(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dwordx4_saddr %address, %data, %base
  %gap = v_mov_b32 7
  %replacement = v_add_u32 %gap, %gap
  return %replacement
}

// ----
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
  v_mov_b32 v0, 7
  v_add_u32 v0, v0, v0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm
