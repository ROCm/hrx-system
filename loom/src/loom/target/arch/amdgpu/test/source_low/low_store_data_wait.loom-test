// ====
// RUN: emit amdgpu-assembly @wide_store_alias_reuse

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @wide_store_alias_reuse(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dwordx4_saddr %address, %data, %base
  %part = slice %data[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %replacement = v_add_u32 %part, %part
  return %replacement
}

// The zero-work slice contributes no issue slot before the destructive use.
// ----
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
  v_add_u32 v0, v4, v4
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @wide_store_edge_copy

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @wide_store_edge_copy(%address: reg<amdgpu.vgpr>, %data: reg<amdgpu.vgpr x4>, %base: reg<amdgpu.sgpr x2>, %input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dwordx4_saddr %address, %data, %base
  low.br ^next(%input: reg<amdgpu.vgpr>)
^next(%replacement: reg<amdgpu.vgpr>):
  return %replacement
}

// The materialized edge copy is itself a VALU payload overwrite.
// ----
  global_store_dwordx4 v0, v[4:7], s[0:1] offset:0
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
