low.func.def target<amdgpu.cdna4.core>(@target) @accumulator_scratch_fallthrough(%data: reg<amdgpu.agpr x4>, %lhs: reg<amdgpu.agpr>, %rhs: reg<amdgpu.agpr>) -> (reg<amdgpu.agpr x4>) asm {
  scratch_store_b128_offset_only %data
  low.br ^overwrite
^overwrite:
  %replacement = v_mfma_f32_16x16x4_f32 %lhs, %rhs, %data
  return %replacement
}

// ----
  scratch_store_dwordx4 off, acc[0:3], off offset:0
.Lbb1:
  s_nop 1
  v_mfma_f32_16x16x4_f32 acc[0:3], acc4, acc5, acc[0:3]
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_nop 8
  s_endpgm

