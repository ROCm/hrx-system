kernel.def @uniform_word_transpose() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.noalias %input, %output : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %source[%base] : buffer -> view<2x2xi32>
  %output_view = buffer.view %destination[%base] : buffer -> view<2x2xi32>
  %values = vector.load %input_view[0, 0] : view<2x2xi32> -> vector<2x2xi32>
  %transposed = vector.transpose<[1, 0]> %values : vector<2x2xi32> -> vector<2x2xi32>
  vector.store %transposed, %output_view[0, 0] : vector<2x2xi32>, view<2x2xi32>
  kernel.return
}

