kernel.def @mixed_bank_concatenation() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.noalias %input, %output : buffer, buffer
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %input_view = buffer.view %source[%base] : buffer -> view<64xi32>
  %output_view = buffer.view %destination[%base] : buffer -> view<32x8xi32>
  %uniform = vector.load %input_view[0] : view<64xi32> -> vector<2xi32>
  %varying = vector.load %input_view[%lane] : view<64xi32> -> vector<2xi32>
  %left = vector.concat<0> %uniform, %varying : vector<2xi32>, vector<2xi32> -> vector<4xi32>
  %right = vector.concat<0> %varying, %uniform : vector<2xi32>, vector<2xi32> -> vector<4xi32>
  vector.store %left, %output_view[%lane, 0] : vector<4xi32>, view<32x8xi32>
  vector.store %right, %output_view[%lane, 4] : vector<4xi32>, view<32x8xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @mixed_bank_concatenation() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 1024, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %22 = s_mov_b32 0
  %uniform = s_load_dwordx2 %input_view, %22
  %24 = v_lshlrev_b32_src0_inline %lane, 2
  %varying = global_load_b64_saddr %24, %input_view
  %26 = slice %uniform[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = v_mov_b32_copy %26
  %28 = slice %uniform[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = v_mov_b32_copy %28
  %30 = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %left = concat(%30, %varying) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %36 = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %right = concat(%varying, %36) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %38 = v_lshlrev_b32_src0_inline %lane, 5
  global_store_b128_saddr %38, %left, %output_view
  global_store_b128_saddr %38, %right, %output_view {offset = 16}
  return
}

