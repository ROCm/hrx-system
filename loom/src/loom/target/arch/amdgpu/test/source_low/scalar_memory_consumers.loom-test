low.kernel.def target<amdgpu.rdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @uniform_word_transpose() asm {
  %input_view = resource<hal_binding> {extent = 16, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = s_mov_b32 0
  %19 = s_load_dwordx4 %input_view, %18
  %20 = slice %19[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %21 = v_mov_b32_copy %20
  %22 = slice %19[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %24 = slice %19[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %25 = v_mov_b32_copy %24
  %26 = slice %19[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %27 = v_mov_b32_copy %26
  %transposed = concat(%21, %25, %23, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %34 = v_mov_b32 0
  global_store_b128_saddr %34, %transposed, %output_view
  return
}

