kernel.def @uniform_float_argument() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %initial: f32) {
  %source, %destination = buffer.assume.noalias %input, %output : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %source[%base] : buffer -> view<1xf32>
  %output_view = buffer.view %destination[%base] : buffer -> view<4xf32>
  %value = view.load %input_view[0] : view<1xf32> -> f32
  %sum = scalar.addf %initial, %value : f32
  %product = scalar.mulf %initial, %value : f32
  %minimum = scalar.minimumf %initial, %value : f32
  %maximum = scalar.maximumf %initial, %value : f32
  view.store %sum, %output_view[0] : f32, view<4xf32>
  view.store %product, %output_view[1] : f32, view<4xf32>
  view.store %minimum, %output_view[2] : f32, view<4xf32>
  view.store %maximum, %output_view[3] : f32, view<4xf32>
  kernel.return
}

