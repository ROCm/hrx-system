low.kernel.def target<amdgpu.rdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @uniform_fp8_encoding() asm {
  %input_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 1, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = s_mov_b32 0
  %values = s_load_dword %input_view, %13
  %15 = v_mov_b32 1138753536
  %16 = v_mov_b32 2139095040
  %17 = v_mov_b32 1015021568
  %18 = v_mov_b32 127
  %19 = v_mov_b32_copy %values
  %20 = v_and_b32_lit %19, 2147483647
  %21 = v_min_u32 %15, %20
  %22 = v_bfe_u32_offset_width_inline %21 {offset = 20, width = 1}
  %23 = v_add3_u32_src2_lit %21, %22, 524287
  %24 = v_lshrrev_b32_src0_inline %23, 20
  %25 = v_add_u32_lit %24, 4294966336
  %26 = v_add_f32_lit %21, 1182793728
  %27 = v_add_u32_lit %26, 3112173568
  %28 = v_cmp_lt_u32 %21, %17
  %29 = v_cndmask_b32 %25, %27, %28
  %30 = v_cmp_gt_u32 %20, %16
  %31 = v_cndmask_b32 %29, %18, %30
  %32 = v_lshrrev_b32_src0_inline %19, 24
  %33 = v_bfi_b32_src0_lit %32, %31, 128
  %34 = v_perm_b32_src2_lit %33, %33, 4
  %encoded = v_perm_b32_src2_lit %34, %34, 16778500
  %37 = v_mov_b32 0
  global_store_b8_saddr %37, %encoded, %output_view
  return
}

