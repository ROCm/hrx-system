// RUN: emit source-low target=amdgpu:gfx1100 output=low

// Stable inputs exercise SGPR producers independently of entry-memory proofs.
kernel.def @uniform_wide_shifts() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.noalias %input, %output : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %source[%base] : buffer -> view<4xi64>
  %output_view = buffer.view %destination[%base] : buffer -> view<12xi64>
  %values = vector.load %input_view[0] : view<4xi64> -> vector<2xi64>
  %counts = vector.load %input_view[2] : view<4xi64> -> vector<2xi64>
  %shift = vector.splati 13 : vector<2xi64>
  %constant_left = vector.shli %values, %shift : vector<2xi64>
  %constant_logical = vector.shrui %values, %shift : vector<2xi64>
  %constant_signed = vector.shrsi %values, %shift : vector<2xi64>
  %dynamic_left = vector.shli %values, %counts : vector<2xi64>
  %dynamic_logical = vector.shrui %values, %counts : vector<2xi64>
  %dynamic_signed = vector.shrsi %values, %counts : vector<2xi64>
  vector.store %constant_left, %output_view[0] : vector<2xi64>, view<12xi64>
  vector.store %constant_logical, %output_view[2] : vector<2xi64>, view<12xi64>
  vector.store %constant_signed, %output_view[4] : vector<2xi64>, view<12xi64>
  vector.store %dynamic_left, %output_view[6] : vector<2xi64>, view<12xi64>
  vector.store %dynamic_logical, %output_view[8] : vector<2xi64>, view<12xi64>
  vector.store %dynamic_signed, %output_view[10] : vector<2xi64>, view<12xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @uniform_wide_shifts() asm {
  %input_view = resource<hal_binding> {extent = 32, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 96, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = s_mov_b32 0
  %values = s_load_dwordx4 %input_view, %20
  %counts = s_load_dwordx4 %input_view, %20 {offset = 16}
  %24 = slice %values[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %25 = v_mov_b32_copy %24
  %26 = slice %values[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %27 = v_mov_b32_copy %26
  %28 = slice %values[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %29 = v_mov_b32_copy %28
  %30 = slice %values[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %31 = v_mov_b32_copy %30
  %32 = concat(%25, %27, %29, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %33 = slice %32[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %34 = v_lshlrev_b64_src0_inline %33, 13
  %35 = slice %32[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %36 = v_lshlrev_b64_src0_inline %35, 13
  %constant_left = concat(%34, %36) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %39 = v_lshrrev_b64_src0_inline %33, 13
  %41 = v_lshrrev_b64_src0_inline %35, 13
  %constant_logical = concat(%39, %41) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %44 = v_ashrrev_i64_src0_inline %33, 13
  %46 = v_ashrrev_i64_src0_inline %35, 13
  %constant_signed = concat(%44, %46) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %48 = slice %counts[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %49 = slice %counts[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %53 = v_lshlrev_b64 %48, %33
  %56 = v_lshlrev_b64 %49, %35
  %dynamic_left = concat(%53, %56) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %63 = v_lshrrev_b64 %48, %33
  %66 = v_lshrrev_b64 %49, %35
  %dynamic_logical = concat(%63, %66) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %73 = v_ashrrev_i64 %48, %33
  %76 = v_ashrrev_i64 %49, %35
  %dynamic_signed = concat(%73, %76) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %78 = v_mov_b32 0
  global_store_b128_saddr %78, %constant_left, %output_view
  global_store_b128_saddr %78, %constant_logical, %output_view {offset = 16}
  global_store_b128_saddr %78, %constant_signed, %output_view {offset = 32}
  global_store_b128_saddr %78, %dynamic_left, %output_view {offset = 48}
  global_store_b128_saddr %78, %dynamic_logical, %output_view {offset = 64}
  global_store_b128_saddr %78, %dynamic_signed, %output_view {offset = 80}
  return
}

