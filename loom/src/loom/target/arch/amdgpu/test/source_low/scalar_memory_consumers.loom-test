low.kernel.def target<amdgpu.rdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "initial"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @uniform_float_argument(%initial: reg<amdgpu.sgpr>) asm {
  %input_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %26 = s_mov_b32 0
  %value = s_load_dword %input_view, %26
  %28 = v_mov_b32_copy %value
  %sum = v_add_f32 %initial, %28
  %product = v_mul_f32 %initial, %28
  %32 = v_mov_b32_copy %initial
  %34 = v_max_f32 %32, %32
  %37 = v_max_f32 %28, %28
  %38 = v_min_f32 %34, %37
  %39 = v_cmp_u_f32 %initial, %value
  %minimum = v_cndmask_b32_src1_lit %38, %39, 2143289344
  %48 = v_max_f32 %34, %37
  %maximum = v_cndmask_b32_src1_lit %48, %39, 2143289344
  %50 = v_mov_b32 0
  global_store_b32_saddr %50, %sum, %output_view
  global_store_b32_saddr %50, %product, %output_view {offset = 4}
  global_store_b32_saddr %50, %minimum, %output_view {offset = 8}
  global_store_b32_saddr %50, %maximum, %output_view {offset = 12}
  return
}
