kernel.def @uniform_fp8_encoding() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.noalias %input, %output : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %source[%base] : buffer -> view<1xf32>
  %output_view = buffer.view %destination[%base] : buffer -> view<1xf8E4M3>
  %values = vector.load %input_view[0] : view<1xf32> -> vector<1xf32>
  %encoded = vector.fptrunc %values : vector<1xf32> to vector<1xf8E4M3>
  vector.store %encoded, %output_view[0] : vector<1xf8E4M3>, view<1xf8E4M3>
  kernel.return
}

