// RUN: emit source-low @unrolled_division target=amdgpu:gfx11-generic output=low
kernel.def @unrolled_division() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%word: i32, %divisor: i64, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi64>
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %initial = scalar.extui %word : i32 to i64
  %result = scf.for %position = [%begin to %end step %step](%value = %initial : i64) -> (i64) unroll(%end) {
    %next = scalar.divui %value, %divisor : i64
    scf.yield %next : i64
  }
  view.store %result, %captured[%capture_lane] : i64, view<64xi64>
  kernel.return
}

