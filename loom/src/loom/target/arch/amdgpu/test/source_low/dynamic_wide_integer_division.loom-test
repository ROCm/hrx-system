func.def @bounded_chain(%word: i32, %first: i64, %second: i64) -> (i64, i64, i64) {
  %dividend = scalar.extui %word : i32 to i64
  %10 = scalar.bitfield.extractu %dividend {offset = 0, width = 32} : i64 -> i32
  %11 = scalar.bitfield.extractu %first {offset = 0, width = 32} : i64 -> i32
  %12 = scalar.bitfield.extractu %first {offset = 32, width = 32} : i64 -> i32
  %13 = scalar.constant 0 : i32
  %14 = scalar.constant 1 : i32
  %15 = scalar.cmpi ne, %12, %13 : i32
  %16 = scf.select %15, %14, %11 : i32
  %17, %18 = scalar.divremui %10, %16 : i32
  %19 = scf.select %15, %13, %17 : i32
  %20 = scalar.extui %19 : i32 to i64
  %21 = scf.select %15, %10, %18 : i32
  %22 = scalar.extui %21 : i32 to i64
  %quotient, %remainder = scalar.assume %20, %22 [ule(%20, %dividend), ult(%22, %first)] : i64, i64
  %25 = scalar.bitfield.extractu %quotient {offset = 0, width = 32} : i64 -> i32
  %26 = scalar.bitfield.extractu %second {offset = 0, width = 32} : i64 -> i32
  %27 = scalar.bitfield.extractu %second {offset = 32, width = 32} : i64 -> i32
  %30 = scalar.cmpi ne, %27, %13 : i32
  %31 = scf.select %30, %14, %26 : i32
  %37 = scalar.divui %25, %31 : i32
  %34 = scf.select %30, %13, %37 : i32
  %35 = scalar.extui %34 : i32 to i64
  %next = scalar.assume %35 [ule(%35, %quotient)] : i64
  func.return %next, %quotient, %remainder : i64, i64, i64
}

