// RUN: emit source-low @unrolled_division target=amdgpu:gfx11-generic output=low
func.def @unrolled_division(%word: i32, %divisor: i64) -> (i64) {
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %initial = scalar.extui %word : i32 to i64
  %result = scf.for %position = [%begin to %end step %step](%value = %initial : i64) -> (i64) unroll(%end) {
    %next = scalar.divui %value, %divisor : i64
    scf.yield %next : i64
  }
  func.return %result : i64
}

