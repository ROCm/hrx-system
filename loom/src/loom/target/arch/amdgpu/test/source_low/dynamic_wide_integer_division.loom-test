  %434 = v_or_b32 %432, %425
  %435 = slice %431[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %437 = v_or_b32 %435, %246
  %438 = concat(%434, %437) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %439 = v_cmp_gt_u64 %422, %438
  %440 = s_mov_b32 1
  %441 = s_mov_b32 0
  %447 = v_mov_b32_copy %440
  %449 = v_mov_b32_copy %441
  %450 = v_cndmask_b32 %449, %447, %439
  %458, %459 = v_sub_co_u32 %405, %450
  %460, %461 = v_subb_co_u32 %408, %449, %459
  %467 = v_mul_lo_u32 %458, %207
  %468 = v_mul_hi_u32 %458, %207
  %469 = v_mul_lo_u32 %458, %209
  %470 = v_mul_lo_u32 %460, %207
  %471 = v_add_u32 %468, %469
  %472 = v_add_u32 %471, %470
  %478, %479 = v_sub_co_u32 %189, %467
  %480, %481 = v_subb_co_u32 %191, %472, %479
  %485 = v_xor_b32 %179, %197
  %488 = v_xor_b32 %182, %200
  %492 = v_xor_b32 %458, %485
  %495 = v_xor_b32 %460, %488
  %501, %502 = v_sub_co_u32 %492, %485
  %503, %504 = v_subb_co_u32 %495, %488, %502
  %quotient = concat(%501, %503) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %508 = v_xor_b32 %478, %179
  %511 = v_xor_b32 %480, %182
  %517, %518 = v_sub_co_u32 %508, %179
  %519, %520 = v_subb_co_u32 %511, %182, %518
  %remainder = concat(%517, %519) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %quotient, %remainder
}
