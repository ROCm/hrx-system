  %38 = scalar.bitfield.extractu %33 {offset = 0, width = 32} : i64 -> i32
  %39 = scalar.bitfield.extractu %37 {offset = 0, width = 32} : i64 -> i32
  %40 = scalar.bitfield.extractu %37 {offset = 32, width = 32} : i64 -> i32
  %41 = scalar.constant 0 : i32
  %42 = scalar.constant 1 : i32
  %43 = scalar.cmpi ne, %40, %41 : i32
  %44 = scf.select %43, %42, %39 : i32
  %54 = scalar.divui %38, %44 : i32
  %47 = scf.select %43, %41, %54 : i32
  %48 = scalar.extui %47 : i32 to i64
  %49 = scalar.assume %48 [ule(%48, %33)] : i64
  %50 = scalar.xori %31, %35 : i64
  %51 = scalar.xori %49, %50 : i64
  %quotient = scalar.subi %51, %50 : i64
  %53 = scalar.remui %38, %44 : i32
  %24 = scf.select %43, %38, %53 : i32
  %25 = scalar.extui %24 : i32 to i64
  %26 = scalar.assume %25 [ult(%25, %37), ge(%25, 0)] : i64
  %27 = scalar.xori %26, %31 : i64
  %28 = scalar.subi %27, %31 : i64
  %remainder = scalar.assume %28 [le(%28, %26)] : i64
  func.return %quotient, %remainder : i64, i64
}

