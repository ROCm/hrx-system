// ====
// RUN: emit source-low @signed_pair target=amdgpu:gfx942 output=low
func.def @signed_pair(%inputs: vector<2xi64>) -> (i64, i64) {
  %dividend = vector.extract %inputs[0] : vector<2xi64> -> i64
  %divisor = vector.extract %inputs[1] : vector<2xi64> -> i64
  %quotient, %remainder = scalar.divremsi %dividend, %divisor : i64
  func.return %quotient, %remainder : i64, i64
}

