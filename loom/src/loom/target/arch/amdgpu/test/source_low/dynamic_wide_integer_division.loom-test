// ====
// RUN: pass target=amdgpu:gfx11-generic target-legalize{mode=final},canonicalize,cse,dce
func.def @bounded_chain(%word: i32, %first: i64, %second: i64) -> (i64, i64, i64) {
  %dividend = scalar.extui %word : i32 to i64
  %quotient, %remainder = scalar.divremui %dividend, %first : i64
  %next = scalar.divui %quotient, %second : i64
  func.return %next, %quotient, %remainder : i64, i64, i64
}

// ----
func.def @bounded_chain(%word: i32, %first: i64, %second: i64) -> (i64, i64, i64) {
  %dividend = scalar.extui %word : i32 to i64
  %10 = scalar.bitfield.extractu %dividend {offset = 0, width = 32} : i64 -> i32
  %11 = scalar.bitfield.extractu %first {offset = 0, width = 32} : i64 -> i32
  %12 = scalar.bitfield.extractu %first {offset = 32, width = 32} : i64 -> i32
  %13 = scalar.constant 0 : i32
  %14 = scalar.constant 1 : i32
  %15 = scalar.cmpi ne, %12, %13 : i32
  %16 = scf.select %15, %14, %11 : i32
  %17, %18 = scalar.divremui %10, %16 : i32
  %19 = scf.select %15, %13, %17 : i32
  %20 = scalar.extui %19 : i32 to i64
  %21 = scf.select %15, %10, %18 : i32
  %22 = scalar.extui %21 : i32 to i64
  %quotient, %remainder = scalar.assume %20, %22 [ule(%20, %dividend), ult(%22, %first)] : i64, i64
  %25 = scalar.bitfield.extractu %quotient {offset = 0, width = 32} : i64 -> i32
  %26 = scalar.bitfield.extractu %second {offset = 0, width = 32} : i64 -> i32
  %27 = scalar.bitfield.extractu %second {offset = 32, width = 32} : i64 -> i32
  %30 = scalar.cmpi ne, %27, %13 : i32
  %31 = scf.select %30, %14, %26 : i32
  %37 = scalar.divui %25, %31 : i32
  %34 = scf.select %30, %13, %37 : i32
  %35 = scalar.extui %34 : i32 to i64
  %next = scalar.assume %35 [ule(%35, %quotient)] : i64
  func.return %next, %quotient, %remainder : i64, i64, i64
}

// ====
// RUN: pass target=amdgpu:gfx11-generic target-legalize{mode=final},canonicalize,cse,dce
func.def @bounded_signed(%input: i64, %divisor: i64) -> (i64, i64) {
  %dividend = scalar.assume %input [range(%input, -4294967295, 4294967295)] : i64
  %quotient = scalar.divsi %dividend, %divisor : i64
  %remainder = scalar.remsi %dividend, %divisor : i64
  func.return %quotient, %remainder : i64, i64
}

// ----
func.def @bounded_signed(%input: i64, %divisor: i64) -> (i64, i64) {
  %dividend = scalar.assume %input [range(%input, -4294967295, 4294967295)] : i64
  %30 = scalar.constant 63 : i64
  %31 = scalar.shrsi %dividend, %30 : i64
  %32 = scalar.xori %dividend, %31 : i64
  %33 = scalar.subi %32, %31 : i64
  %35 = scalar.shrsi %divisor, %30 : i64
  %36 = scalar.xori %divisor, %35 : i64
  %37 = scalar.subi %36, %35 : i64
  %38 = scalar.bitfield.extractu %33 {offset = 0, width = 32} : i64 -> i32
  %39 = scalar.bitfield.extractu %37 {offset = 0, width = 32} : i64 -> i32
  %40 = scalar.bitfield.extractu %37 {offset = 32, width = 32} : i64 -> i32
  %41 = scalar.constant 0 : i32
  %42 = scalar.constant 1 : i32
  %43 = scalar.cmpi ne, %40, %41 : i32
  %44 = scf.select %43, %42, %39 : i32
  %54 = scalar.divui %38, %44 : i32
  %47 = scf.select %43, %41, %54 : i32
  %48 = scalar.extui %47 : i32 to i64
  %49 = scalar.assume %48 [ule(%48, %33)] : i64
  %50 = scalar.xori %31, %35 : i64
  %51 = scalar.xori %49, %50 : i64
  %quotient = scalar.subi %51, %50 : i64
  %53 = scalar.remui %38, %44 : i32
  %24 = scf.select %43, %38, %53 : i32
  %25 = scalar.extui %24 : i32 to i64
  %26 = scalar.assume %25 [ult(%25, %37), ge(%25, 0)] : i64
  %27 = scalar.xori %26, %31 : i64
  %28 = scalar.subi %27, %31 : i64
  %remainder = scalar.assume %28 [le(%28, %26)] : i64
  func.return %quotient, %remainder : i64, i64
}

// ====
// RUN: emit source-low @unrolled_division target=amdgpu:gfx11-generic output=low
func.def @unrolled_division(%word: i32, %divisor: i64) -> (i64) {
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %initial = scalar.extui %word : i32 to i64
  %result = scf.for %position = [%begin to %end step %step](%value = %initial : i64) -> (i64) unroll(%end) {
    %next = scalar.divui %value, %divisor : i64
    scf.yield %next : i64
  }
  func.return %result : i64
}

