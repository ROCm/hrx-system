// RUN: emit source-low @unsigned_pair target=amdgpu:gfx11-generic output=low
kernel.def @unsigned_pair() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%dividend: i64, %divisor: i64, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<2x64xi64>
  %quotient, %remainder = scalar.divremui %dividend, %divisor : i64
  view.store %quotient, %captured[0, %capture_lane] : i64, view<2x64xi64>
  view.store %remainder, %captured[1, %capture_lane] : i64, view<2x64xi64>
  kernel.return
}

