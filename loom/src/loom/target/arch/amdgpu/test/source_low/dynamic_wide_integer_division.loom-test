// RUN: compile-report target=amdgpu:gfx11-generic target-legalize{mode=final}
func.def @word_divisor_predecessor(%input: i64, %word_input: i64, %divisor: i64) -> (i64) {
  %word = scalar.assume %word_input [range(%word_input, 1, 4294967295)] : i64
  %first = scalar.divui %input, %word : i64
  %result = scalar.divui %first, %divisor : i64
  func.return %result : i64
}

