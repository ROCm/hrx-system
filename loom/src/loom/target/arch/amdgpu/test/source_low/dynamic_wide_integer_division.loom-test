  %30 = scalar.constant 63 : i64
  %31 = scalar.shrsi %dividend, %30 : i64
  %32 = scalar.xori %dividend, %31 : i64
  %33 = scalar.subi %32, %31 : i64
  %35 = scalar.shrsi %divisor, %30 : i64
  %36 = scalar.xori %divisor, %35 : i64
