// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @mixed_scc_predicate_bitwise(%values: vector<2xi32>, %limit: i32) -> (i32, i32, i32, i32, i32, i32) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %c6 = scalar.constant 6 : i32
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %mask = scalar.cmpi slt, %lane, %limit : i32
  %and_left_bool = scalar.cmpi slt, %limit, %c1 : i32
  %and_right_bool = scalar.cmpi slt, %limit, %c2 : i32
  %or_left_bool = scalar.cmpi slt, %limit, %c3 : i32
  %or_right_bool = scalar.cmpi slt, %limit, %c4 : i32
  %xor_left_bool = scalar.cmpi slt, %limit, %c5 : i32
  %xor_right_bool = scalar.cmpi slt, %limit, %c6 : i32
  %and_left = scalar.andi %and_left_bool, %mask : i1
  %and_right = scalar.andi %mask, %and_right_bool : i1
  %or_left = scalar.ori %or_left_bool, %mask : i1
  %or_right = scalar.ori %mask, %or_right_bool : i1
  %xor_left = scalar.xori %xor_left_bool, %mask : i1
  %xor_right = scalar.xori %mask, %xor_right_bool : i1
  %and_left_result = scf.select %and_left, %lane, %limit : i32
  %and_right_result = scf.select %and_right, %lane, %limit : i32
  %or_left_result = scf.select %or_left, %lane, %limit : i32
  %or_right_result = scf.select %or_right, %lane, %limit : i32
  %xor_left_result = scf.select %xor_left, %lane, %limit : i32
  %xor_right_result = scf.select %xor_right, %lane, %limit : i32
  func.return %and_left_result, %and_right_result, %or_left_result, %or_right_result, %xor_left_result, %xor_right_result : i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @mixed_scc_predicate_bitwise(%values: reg<amdgpu.vgpr x2>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %c1 = s_mov_b32 1
  %c2 = s_mov_b32 2
  %c3 = s_mov_b32 3
  %c4 = s_mov_b32 4
  %c5 = s_mov_b32 5
  %c6 = s_mov_b32 6
  %lane = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %mask = v_cmp_lt_i32 %lane, %limit
  %and_left_bool = s_cmp_lt_i32 %limit, %c1
  %and_right_bool = s_cmp_lt_i32 %limit, %c2
  %or_left_bool = s_cmp_lt_i32 %limit, %c3
  %or_right_bool = s_cmp_lt_i32 %limit, %c4
  %xor_left_bool = s_cmp_lt_i32 %limit, %c5
  %xor_right_bool = s_cmp_lt_i32 %limit, %c6
  %56 = s_mov_b32 0
  %57 = slice %mask[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %58 = s_cselect_b32 %57, %56, %and_left_bool
  %59 = slice %mask[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %60 = s_cselect_b32 %59, %56, %and_left_bool
  %and_left = concat(%58, %60) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %64 = s_cselect_b32 %57, %56, %and_right_bool
  %66 = s_cselect_b32 %59, %56, %and_right_bool
  %and_right = concat(%64, %66) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %68 = s_mov_b64_exec_read
  %69 = slice %68[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %71 = s_cselect_b32 %69, %57, %or_left_bool
  %72 = slice %68[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %74 = s_cselect_b32 %72, %59, %or_left_bool
  %or_left = concat(%71, %74) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %79 = s_cselect_b32 %69, %57, %or_right_bool
  %82 = s_cselect_b32 %72, %59, %or_right_bool
  %or_right = concat(%79, %82) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %88 = s_cselect_b32 %69, %56, %xor_left_bool
  %89 = s_cselect_b32 %72, %56, %xor_left_bool
  %90 = concat(%88, %89) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %xor_left = s_xor_b64 %90, %mask
  %96 = s_cselect_b32 %69, %56, %xor_right_bool
  %97 = s_cselect_b32 %72, %56, %xor_right_bool
  %98 = concat(%96, %97) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %xor_right = s_xor_b64 %mask, %98
  %100 = v_mov_b32_copy %limit
  %and_left_result = v_cndmask_b32 %100, %lane, %and_left
  %and_right_result = v_cndmask_b32 %100, %lane, %and_right
  %or_left_result = v_cndmask_b32 %100, %lane, %or_left
  %or_right_result = v_cndmask_b32 %100, %lane, %or_right
  %xor_left_result = v_cndmask_b32 %100, %lane, %xor_left
  %xor_right_result = v_cndmask_b32 %100, %lane, %xor_right
  return %and_left_result, %and_right_result, %or_left_result, %or_right_result, %xor_left_result, %xor_right_result
}

// ====

func.def @mixed_sgpr_predicate_bitwise(%values: vector<2xi32>, %limit: i32, %and_left_bool: i1, %and_right_bool: i1, %or_left_bool: i1, %or_right_bool: i1, %xor_left_bool: i1, %xor_right_bool: i1) -> (i32, i32, i32, i32, i32, i32) {
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %mask = scalar.cmpi slt, %lane, %limit : i32
  %and_left = scalar.andi %and_left_bool, %mask : i1
  %and_right = scalar.andi %mask, %and_right_bool : i1
  %or_left = scalar.ori %or_left_bool, %mask : i1
  %or_right = scalar.ori %mask, %or_right_bool : i1
  %xor_left = scalar.xori %xor_left_bool, %mask : i1
  %xor_right = scalar.xori %mask, %xor_right_bool : i1
  %and_left_result = scf.select %and_left, %lane, %limit : i32
  %and_right_result = scf.select %and_right, %lane, %limit : i32
  %or_left_result = scf.select %or_left, %lane, %limit : i32
  %or_right_result = scf.select %or_right, %lane, %limit : i32
  %xor_left_result = scf.select %xor_left, %lane, %limit : i32
  %xor_right_result = scf.select %xor_right, %lane, %limit : i32
  func.return %and_left_result, %and_right_result, %or_left_result, %or_right_result, %xor_left_result, %xor_right_result : i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @mixed_sgpr_predicate_bitwise(%values: reg<amdgpu.vgpr x2>, %limit: reg<amdgpu.sgpr>, %and_left_bool: reg<amdgpu.sgpr>, %and_right_bool: reg<amdgpu.sgpr>, %or_left_bool: reg<amdgpu.sgpr>, %or_right_bool: reg<amdgpu.sgpr>, %xor_left_bool: reg<amdgpu.sgpr>, %xor_right_bool: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %lane = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %mask = v_cmp_lt_i32 %lane, %limit
  %44 = s_mov_b32 0
  %45 = s_cmp_lg_i32_src1_inline %and_left_bool {rhs = 0}
  %46 = slice %mask[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47 = s_cselect_b32 %46, %44, %45
  %48 = slice %mask[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %49 = s_cselect_b32 %48, %44, %45
  %and_left = concat(%47, %49) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %52 = s_cmp_lg_i32_src1_inline %and_right_bool {rhs = 0}
  %54 = s_cselect_b32 %46, %44, %52
  %56 = s_cselect_b32 %48, %44, %52
  %and_right = concat(%54, %56) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %58 = s_mov_b64_exec_read
  %59 = s_cmp_lg_i32_src1_inline %or_left_bool {rhs = 0}
  %60 = slice %58[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %62 = s_cselect_b32 %60, %46, %59
  %63 = slice %58[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %65 = s_cselect_b32 %63, %48, %59
  %or_left = concat(%62, %65) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %68 = s_cmp_lg_i32_src1_inline %or_right_bool {rhs = 0}
  %71 = s_cselect_b32 %60, %46, %68
  %74 = s_cselect_b32 %63, %48, %68
  %or_right = concat(%71, %74) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %77 = s_xor_b64 %mask, %58
  %78 = s_cmp_lg_i32_src1_inline %xor_left_bool {rhs = 0}
  %79 = slice %77[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %81 = s_cselect_b32 %79, %46, %78
  %82 = slice %77[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %84 = s_cselect_b32 %82, %48, %78
  %xor_left = concat(%81, %84) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %87 = s_xor_b64 %mask, %58
  %88 = s_cmp_lg_i32_src1_inline %xor_right_bool {rhs = 0}
  %89 = slice %87[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %91 = s_cselect_b32 %89, %46, %88
  %92 = slice %87[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %94 = s_cselect_b32 %92, %48, %88
  %xor_right = concat(%91, %94) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %96 = v_mov_b32_copy %limit
  %and_left_result = v_cndmask_b32 %96, %lane, %and_left
  %and_right_result = v_cndmask_b32 %96, %lane, %and_right
  %or_left_result = v_cndmask_b32 %96, %lane, %or_left
  %or_right_result = v_cndmask_b32 %96, %lane, %or_right
  %xor_left_result = v_cndmask_b32 %96, %lane, %xor_left
  %xor_right_result = v_cndmask_b32 %96, %lane, %xor_right
  return %and_left_result, %and_right_result, %or_left_result, %or_right_result, %xor_left_result, %xor_right_result
}
