// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// A crop reads only its two selected rows, including a partial packed lane.
func.def @rectangle(%input: buffer, %row0: index, %column0: index) -> (vector<2x3xi8>) {
  %column = index.assume %column0 [range(%column0, 0, 5)] : index
  %row = index.assume %row0 [range(%row0, 0, 2)] : index
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<4x8xi8>
  %values = vector.load %view[0, 0] : view<4x8xi8> -> vector<4x8xi8>
  %result = vector.slice %values[%row, %column] : vector<4x8xi8> -> vector<2x3xi8>
  func.return %result : vector<2x3xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @rectangle(%row: reg<amdgpu.vgpr>, %column: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %view = resource<hal_binding> {extent = 32, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %34 = v_mov_b32 0
  %35 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37, %38 = v_add_co_u32 %35, %column
  %39 = v_mov_b32_copy %36
  %40, %41 = v_add_co_ci_u32 %39, %34, %38
  %42 = v_lshlrev_b32_src0_inline %row, 3
  %43 = v_lshrrev_b32_src0_inline %row, 29
  %44, %45 = v_add_co_u32 %37, %42
  %46, %47 = v_add_co_ci_u32 %40, %43, %45
  %48 = concat(%44, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %49 = global_load_u16_vaddr %48
  %64 = concat(%44, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %65 = global_load_u8_vaddr %64 {offset = 2}
  %66 = v_lshlrev_b32_src0_inline %65, 16
  %67 = v_or_b32 %49, %66
  %82 = concat(%44, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %83 = global_load_u16_vaddr %82 {offset = 8}
  %98 = concat(%44, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %99 = global_load_u8_vaddr %98 {offset = 10}
  %100 = v_lshlrev_b32_src0_inline %99, 16
  %101 = v_or_b32 %83, %100
  %102 = v_lshrrev_b32_src0_inline %67, 8
  %103 = v_lshrrev_b32_src0_inline %67, 16
  %104 = v_lshrrev_b32_src0_inline %101, 8
  %105 = v_lshrrev_b32_src0_inline %101, 16
  %106 = v_and_b32_lit %67, 255
  %107 = v_and_b32_lit %102, 255
  %108 = v_lshlrev_b32_src0_inline %107, 8
  %109 = v_or_b32 %106, %108
  %110 = v_and_b32_lit %103, 255
  %111 = v_lshlrev_b32_src0_inline %110, 16
  %112 = v_or_b32 %109, %111
  %113 = v_and_b32_lit %101, 255
  %114 = v_lshlrev_b32_src0_inline %113, 24
  %115 = v_or_b32 %112, %114
  %116 = v_and_b32_lit %104, 255
  %117 = v_and_b32_lit %105, 255
  %118 = v_lshlrev_b32_src0_inline %117, 8
  %119 = v_or_b32 %116, %118
  %result = concat(%115, %119) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

// The full innermost axis joins rows but the cropped middle axis separates
// planes. A static leading offset participates in the common runtime base.
func.def @cropped_planes(%input: buffer, %row0: index) -> (vector<2x2x4xi16>) {
  %row = index.assume %row0 [range(%row0, 0, 2)] : index
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<3x4x4xi16>
  %values = vector.load %view[0, 0, 0] : view<3x4x4xi16> -> vector<3x4x4xi16>
  %result = vector.slice %values[1, %row, 0] : vector<3x4x4xi16> -> vector<2x2x4xi16>
  func.return %result : vector<2x2x4xi16>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @cropped_planes(%row: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x8>) asm {
  %view = resource<hal_binding> {extent = 96, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %44 = v_lshlrev_b32_src0_inline %row, 3
  %45 = v_lshrrev_b32_src0_inline %row, 29
  %46 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %48, %49 = v_add_co_u32 %46, %44
  %50 = v_mov_b32_copy %47
  %51, %52 = v_add_co_ci_u32 %50, %45, %49
  %53 = concat(%48, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %54 = global_load_b64_vaddr %53 {offset = 32}
  %64 = concat(%48, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %65 = global_load_b64_vaddr %64 {offset = 40}
  %75 = concat(%48, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %76 = global_load_b64_vaddr %75 {offset = 64}
  %86 = concat(%48, %51) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %87 = global_load_b64_vaddr %86 {offset = 72}
  %88 = concat(%54, %65) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %89 = concat(%76, %87) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %result = concat(%88, %89) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  return %result
}
