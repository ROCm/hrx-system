// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// A crop reads only its two selected rows, including a partial packed lane.
func.def @rectangle(%input: buffer, %row0: index, %column0: index) -> (vector<2x3xi8>) {
  %column = index.assume %column0 [range(%column0, 0, 5)] : index
  %row = index.assume %row0 [range(%row0, 0, 2)] : index
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<4x8xi8>
  %values = vector.load %view[0, 0] : view<4x8xi8> -> vector<4x8xi8>
  %result = vector.slice %values[%row, %column] : vector<4x8xi8> -> vector<2x3xi8>
  func.return %result : vector<2x3xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @rectangle(%row: reg<amdgpu.sgpr>, %column: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %view = resource<hal_binding> {extent = 32, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %34 = s_lshl_b32_rhs_inline %row, 3
  %35 = s_add_u32 %column, %34
  %36 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = s_mov_b32 0
  %39, %40 = s_add_co_u32 %36, %35
  %41, %42 = s_addc_u32 %37, %38, %40
  %43 = concat(%39, %41) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %44 = v_mov_b32 0
  %45 = global_load_u16_saddr %44, %43
  %46 = global_load_u8_saddr %44, %43 {offset = 2}
  %47 = v_lshlrev_b32_src0_inline %46, 16
  %48 = v_or_b32 %45, %47
  %54, %55 = s_add_co_u32 %36, %35
  %56, %57 = s_addc_u32 %37, %38, %55
  %58 = concat(%54, %56) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %60 = global_load_u16_saddr %44, %58 {offset = 8}
  %61 = global_load_u8_saddr %44, %58 {offset = 10}
  %62 = v_lshlrev_b32_src0_inline %61, 16
  %63 = v_or_b32 %60, %62
  %64 = v_lshrrev_b32_src0_inline %48, 8
  %65 = v_lshrrev_b32_src0_inline %48, 16
  %66 = v_lshrrev_b32_src0_inline %63, 8
  %67 = v_lshrrev_b32_src0_inline %63, 16
  %68 = v_and_b32_lit %48, 255
  %69 = v_and_b32_lit %64, 255
  %70 = v_lshlrev_b32_src0_inline %69, 8
  %71 = v_or_b32 %68, %70
  %72 = v_and_b32_lit %65, 255
  %73 = v_lshlrev_b32_src0_inline %72, 16
  %74 = v_or_b32 %71, %73
  %75 = v_and_b32_lit %63, 255
  %76 = v_lshlrev_b32_src0_inline %75, 24
  %77 = v_or_b32 %74, %76
  %78 = v_and_b32_lit %66, 255
  %79 = v_and_b32_lit %67, 255
  %80 = v_lshlrev_b32_src0_inline %79, 8
  %81 = v_or_b32 %78, %80
  %result = concat(%77, %81) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

// The full innermost axis joins rows but the cropped middle axis separates
// planes. A static leading offset participates in the common runtime base.
func.def @cropped_planes(%input: buffer, %row0: index) -> (vector<2x2x4xi16>) {
  %row = index.assume %row0 [range(%row0, 0, 2)] : index
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<3x4x4xi16>
  %values = vector.load %view[0, 0, 0] : view<3x4x4xi16> -> vector<3x4x4xi16>
  %result = vector.slice %values[1, %row, 0] : vector<3x4x4xi16> -> vector<2x2x4xi16>
  func.return %result : vector<2x2x4xi16>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @cropped_planes(%row: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x8>) asm {
  %view = resource<hal_binding> {extent = 96, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %44 = v_mov_b32 0
  %45 = s_lshl_b32_rhs_inline %row, 3
  %46 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %47 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %48 = s_mov_b32 0
  %49, %50 = s_add_co_u32 %46, %45
  %51, %52 = s_addc_u32 %47, %48, %50
  %53 = concat(%49, %51) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %54 = global_load_b64_saddr %44, %53 {offset = 32}
  %60, %61 = s_add_co_u32 %46, %45
  %62, %63 = s_addc_u32 %47, %48, %61
  %64 = concat(%60, %62) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %65 = global_load_b64_saddr %44, %64 {offset = 40}
  %71, %72 = s_add_co_u32 %46, %45
  %73, %74 = s_addc_u32 %47, %48, %72
  %75 = concat(%71, %73) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %76 = global_load_b64_saddr %44, %75 {offset = 64}
  %82, %83 = s_add_co_u32 %46, %45
  %84, %85 = s_addc_u32 %47, %48, %83
  %86 = concat(%82, %84) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %87 = global_load_b64_saddr %44, %86 {offset = 72}
  %88 = concat(%54, %65) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %89 = concat(%76, %87) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %result = concat(%88, %89) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  return %result
}
