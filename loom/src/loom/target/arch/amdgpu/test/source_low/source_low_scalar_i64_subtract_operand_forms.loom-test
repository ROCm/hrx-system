// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_i64_subtract.loom-test
// RUN: pass target=amdgpu:gfx1151 source-to-low,low-select-operand-forms,low-cse,low-dce

func.def @uniform_subtract(%lhs: i64, %rhs: i64) -> (i64) {
  %difference = scalar.subi %lhs, %rhs : i64
  func.return %difference : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @uniform_subtract(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %7 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %8 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %9 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %10 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11, %12 = s_sub_co_u32 %7, %9
  %13, %14 = s_subb_u32 %8, %10, %12
  %difference = concat(%11, %13) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %difference
}

// ====

func.def @constant_subtract(%value: i64) -> (i64, i64, i64) {
  %c0 = scalar.constant 0 : i64
  %wide = scalar.constant 4294967297 : i64
  %negated = scalar.subi %c0, %value : i64
  %constant_left = scalar.subi %wide, %value : i64
  %constant_right = scalar.subi %value, %wide : i64
  func.return %negated, %constant_left, %constant_right : i64, i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @constant_subtract(%value: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %21 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46, %47 = s_sub_co_u32_lhs_inline %21, 0
  %48, %49 = s_subb_u32_lhs_inline %22, %47, 0
  %negated = concat(%46, %48) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %50, %51 = s_sub_co_u32_lhs_inline %21, 1
  %52, %53 = s_subb_u32_lhs_inline %22, %51, 1
  %constant_left = concat(%50, %52) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %54, %55 = s_sub_co_u32_rhs_inline %21, 1
  %56, %57 = s_subb_u32_rhs_inline %22, %55, 1
  %constant_right = concat(%54, %56) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %negated, %constant_left, %constant_right
}

// ====

func.def @mixed_subtract(%uniform: i64, %values: vector<2xi64>) -> (i64, i64) {
  %varying = vector.extract %values[0] : vector<2xi64> -> i64
  %uniform_left = scalar.subi %uniform, %varying : i64
  %uniform_right = scalar.subi %varying, %uniform : i64
  func.return %uniform_left, %uniform_right : i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @mixed_subtract(%uniform: reg<amdgpu.sgpr x2>, %values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %11 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %12 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %varying = concat(%11, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %14 = slice %uniform[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = v_mov_b32_copy %14
  %16 = slice %uniform[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = v_mov_b32_copy %16
  %18 = concat(%15, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %19 = slice %18[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20 = slice %18[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = slice %varying[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %22 = slice %varying[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %23, %24 = v_sub_co_u32 %19, %21
  %25, %26 = v_sub_co_ci_u32 %20, %22, %24
  %uniform_left = concat(%23, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %32 = concat(%15, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %35 = slice %32[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %36 = slice %32[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %37, %38 = v_sub_co_u32 %21, %35
  %39, %40 = v_sub_co_ci_u32 %22, %36, %38
  %uniform_right = concat(%37, %39) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %uniform_left, %uniform_right
}
