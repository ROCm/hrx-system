kernel.def @uniform_selected_truncated() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%value: i32, %left: i64, %right: i64, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi32>
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  view.store %carried, %captured[%capture_lane] : i32, view<64xi32>
  kernel.return
}

