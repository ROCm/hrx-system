// TEMPLATE: loom/src/loom/test/corpus/source_low/selected_payload_transport.loom-test
// RUN: pass target=amdgpu:gfx11-generic source-to-low

func.def public @selected_truncated(%input: vector<4xi32>, %left: i64, %right: i64) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @selected_truncated(%input: reg<amdgpu.vgpr x4>, %left: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %value = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %condition = v_cmp_gt_i32_src1_inline %value {rhs = 0}
  %17 = slice %left[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %17
  %19 = slice %right[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = v_mov_b32_copy %19
  %21 = v_cndmask_b32 %20, %18, %condition
  %22 = slice %left[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %24 = slice %right[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = v_mov_b32_copy %24
  %26 = v_cndmask_b32 %25, %23, %condition
  %selected = concat(%21, %26) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %payload = slice %selected[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  low.br ^forward(%payload: reg<amdgpu.vgpr>)
^forward(%carried: reg<amdgpu.vgpr>):
  return %carried
}

