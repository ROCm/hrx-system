func.def public @selected_converted_offset(%choice: i32, %narrow: i32, %fallback: offset) -> (offset) {
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %threshold : i32
  %converted = index.cast %narrow : i32 to offset
  %selected = scf.select %condition, %converted, %fallback : offset
  cfg.br ^forward(%selected: offset)
^forward(%carried: offset):
  func.return %carried : offset
}

