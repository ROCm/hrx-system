low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @selected_converted_offset(%choice: reg<amdgpu.vgpr>, %converted: reg<amdgpu.vgpr>, %fallback: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %condition = v_cmp_ne_i32_src1_inline %choice {rhs = 0}
  %15 = v_mov_b32 0
  %16 = concat(%converted, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %17 = slice %16[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = slice %fallback[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = v_cndmask_b32 %18, %17, %condition
  %20 = slice %16[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = slice %fallback[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %22 = v_cndmask_b32 %21, %20, %condition
  %selected = concat(%19, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^forward(%selected: reg<amdgpu.vgpr x2>)
^forward(%carried: reg<amdgpu.vgpr x2>):
  return %carried
}

