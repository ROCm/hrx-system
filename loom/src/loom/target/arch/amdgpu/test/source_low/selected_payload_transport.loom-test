low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @selected_extended_truncation(%input: reg<amdgpu.vgpr x4>, %left: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %value = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %condition = v_cmp_gt_i32_src1_inline %value {rhs = 0}
  %18 = slice %left[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %20 = slice %right[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = v_mov_b32_copy %20
  %22 = v_cndmask_b32 %21, %19, %condition
  %23 = slice %left[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = v_mov_b32_copy %23
  %25 = slice %right[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = v_mov_b32_copy %25
  %27 = v_cndmask_b32 %26, %24, %condition
  %selected = concat(%22, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %narrowed = slice %selected[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %30 = v_ashrrev_i32_src0_inline %narrowed, 31
  %payload = concat(%narrowed, %30) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^forward(%payload: reg<amdgpu.vgpr x2>)
^forward(%carried: reg<amdgpu.vgpr x2>):
  return %carried
}

