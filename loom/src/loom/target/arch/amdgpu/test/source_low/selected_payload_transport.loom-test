low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 5, direct_arg_count = 3, direct_arg_names = {arg0 = "value", arg1 = "left", arg2 = "right"}, direct_arg_offsets = [0, 4, 12], direct_arg_parameter_indices = [0, 1, 2], direct_arg_sizes = [4, 8, 8], parameter_count = 4, resource_count = 1, resource_offsets = [24], resource_parameter_indices = [3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_selected_truncated(%value: reg<amdgpu.sgpr>, %left: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %threshold = s_mov_b32 0
  %condition = s_cmp_gt_i32 %value, %threshold
  %22 = slice %left[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = slice %right[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = s_cselect_b32 %22, %23, %condition
  %25 = slice %left[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = slice %right[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = s_cselect_b32 %25, %26, %condition
  %selected = concat(%24, %27) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %payload = slice %selected[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^forward(%payload: reg<amdgpu.sgpr>)
^forward(%carried: reg<amdgpu.sgpr>):
  %30 = v_mov_b32_copy %carried
  %31 = v_lshlrev_b32_src0_inline %capture_lane, 2
  global_store_b32_saddr %31, %30, %captured
  return
}

