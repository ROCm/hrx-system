low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @selected_truncated(%input: reg<amdgpu.vgpr x4>, %left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %value = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %condition = v_cmp_gt_i32_src1_inline %value {rhs = 0}
  %17 = slice %left[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = slice %right[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = v_cndmask_b32 %18, %17, %condition
  %20 = slice %left[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = slice %right[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %22 = v_cndmask_b32 %21, %20, %condition
  %selected = concat(%19, %22) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %payload = slice %selected[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  low.br ^forward(%payload: reg<amdgpu.vgpr>)
^forward(%carried: reg<amdgpu.vgpr>):
  return %carried
}

