func.def public @uniform_selected_truncated(%value: i32, %left: i64, %right: i64) -> (i32) {
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ----
low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @uniform_selected_truncated(%value: reg<amdgpu.sgpr>, %left: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>) asm {
  %threshold = s_mov_b32 0
  %condition = s_cmp_gt_i32 %value, %threshold
  %16 = slice %left[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = slice %right[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = s_cselect_b32 %16, %17, %condition
  %19 = slice %left[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = slice %right[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = s_cselect_b32 %19, %20, %condition
  %selected = concat(%18, %21) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %payload = slice %selected[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^forward(%payload: reg<amdgpu.sgpr>)
^forward(%carried: reg<amdgpu.sgpr>):
  return %carried
}

