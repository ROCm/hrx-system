low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @independent_predicate_payload(%input: reg<amdgpu.vgpr x4>, %left: reg<amdgpu.sgpr>, %right: reg<amdgpu.sgpr>, %payload: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  low.br ^forward(%payload: reg<amdgpu.sgpr>)
^forward(%carried: reg<amdgpu.sgpr>):
  return %carried
}
