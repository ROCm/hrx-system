low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @independent_transformed_assumption_payload(%input: reg<amdgpu.vgpr x4>, %left: reg<amdgpu.sgpr>, %right: reg<amdgpu.sgpr>, %payload: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %value = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %condition = v_cmp_gt_i32_src1_inline %value {rhs = 0}
  %22 = v_mov_b32_copy %left
  %23 = v_mov_b32_copy %right
  %bounded = v_cndmask_b32 %23, %22, %condition
  %increment = s_mov_b32 3
  %transformed = s_add_u32 %payload, %increment
  low.br ^forward(%transformed: reg<amdgpu.sgpr>)
^forward(%carried: reg<amdgpu.sgpr>):
  return %carried
}

