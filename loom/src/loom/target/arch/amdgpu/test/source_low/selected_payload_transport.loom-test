low.func.def public target<amdgpu.gfx11.generic.core> abi(hal_kernel) @selected_extended_truncation(%input: reg<amdgpu.vgpr x4>, %left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %value = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %condition = v_cmp_gt_i32_src1_inline %value {rhs = 0}
  %18 = slice %left[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = slice %right[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20 = v_cndmask_b32 %19, %18, %condition
  %21 = slice %left[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %22 = slice %right[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %23 = v_cndmask_b32 %22, %21, %condition
  %selected = concat(%20, %23) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %narrowed = slice %selected[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %26 = v_ashrrev_i32_src0_inline %narrowed, 31
  %payload = concat(%narrowed, %26) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^forward(%payload: reg<amdgpu.vgpr x2>)
^forward(%carried: reg<amdgpu.vgpr x2>):
  return %carried
}

