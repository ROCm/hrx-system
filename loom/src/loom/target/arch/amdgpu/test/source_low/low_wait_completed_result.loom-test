// ====
// RUN: emit amdgpu-assembly @completed_scalar_result strategy=source fixed=%old:physical_register:4:2 fixed=%fresh:physical_register:8:1 fixed=%offset:physical_register:2:1 fixed=%first:physical_register:6:1 fixed=%old_again:physical_register:7:1 fixed=%result:physical_register:9:1

// Reading one lane completes the whole load. A younger pending load must not
// force another wait before the second lane's independent arithmetic.
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @completed_scalar_result(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %old = s_load_dwordx2 %base, %offset
  low.br ^stage
^stage:
  %lane0 = slice %old[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %first = s_add_u32 %lane0, %offset
  %fresh = s_load_dword %base, %offset {offset = 8}
  low.br ^consume
^consume:
  %lane1 = slice %old[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %old_again = s_xor_b32 %lane1, %first
  %result = s_add_u32 %fresh, %old_again
  return %result
}

