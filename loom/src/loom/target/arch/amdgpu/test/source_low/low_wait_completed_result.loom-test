// RUN: emit amdgpu-assembly @completed_vector_result strategy=source fixed=%old:physical_register:4:2 fixed=%fresh:physical_register:8:1 fixed=%offset:physical_register:0:1 fixed=%first:physical_register:6:1 fixed=%old_again:physical_register:7:1 fixed=%result:physical_register:9:1

// Reading one lane completes the whole load. A younger pending load must not
// force another wait before the second lane's independent arithmetic.
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @completed_vector_result(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %old = global_load_b64_saddr %offset, %base
  low.br ^stage
^stage:
  %lane0 = slice %old[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %first = v_add_f32 %lane0, %offset
  %fresh = global_load_b32_saddr %offset, %base {offset = 8}
  low.br ^consume
^consume:
  %lane1 = slice %old[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %old_again = v_mul_f32 %lane1, %first
  %result = v_add_u32 %fresh, %old_again
  return %result
}

// ----
  global_load_b64 v[4:5], v0, s[0:1] offset:0
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_f32 v6, v4, v0
  global_load_b32 v8, v0, s[0:1] offset:8
.Lbb2:
  v_mul_f32 v7, v5, v6
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v9, v8, v7
  s_endpgm

