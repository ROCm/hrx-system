  %updated = concat(%20, %30) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %updated
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @i8x1_insert_masks_value(%old: vector<1xi8>, %value: i8) -> (vector<1xi8>) {
  %updated = vector.insert %value into %old[0] : i8, vector<1xi8>
  func.return %updated : vector<1xi8>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @i8x1_insert_masks_value(%old: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %updated = v_and_b32_lit %value, 255
  return %updated
}
