// RUN: with-checks emit low-allocation-json @predicated_tile_sweep_bindings_survive_exec_edges

amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(32, 1, 1) @predicated_tile_sweep_bindings_survive_exec_edges() asm {
  %row_group = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %src0_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 524288} : reg<amdgpu.sgpr x2>
  %src1_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 6308736} : reg<amdgpu.sgpr x2>
  %dst_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 1048576} : reg<amdgpu.sgpr x2>
  %zero = s_mov_b32 0
  %limit = s_mov_b32 128
  %step = s_mov_b32 16
  %row_base = s_lshl_b32_rhs_inline %row_group, 4
  %zero_f32 = v_mov_b32 0
  low.br ^outer(%zero: reg<amdgpu.sgpr>, %zero_f32: reg<amdgpu.vgpr>)
^outer(%kk: reg<amdgpu.sgpr>, %outer_acc: reg<amdgpu.vgpr>):
  %outer_active = s_cmp_lt_i32 %kk, %limit
  low.cond_br %outer_active, ^inner_preheader, ^after : reg<amdgpu.scc>
^inner_preheader:
  %saved_wave_exec = s_mov_b64_exec_read
  low.br ^inner(%lane: reg<amdgpu.vgpr>, %outer_acc: reg<amdgpu.vgpr>)
^inner(%i: reg<amdgpu.vgpr>, %inner_acc: reg<amdgpu.vgpr>):
  %tile_limit = v_mov_b32 256
  %inside = v_cmp_lt_i32 %i, %tile_limit
  %saved_inner_exec, %has_lanes = s_and_saveexec_b64 %inside
  low.cond_br %has_lanes, ^body, ^inner_exit : reg<amdgpu.scc>
^body:
  %mask = v_mov_b32 15
  %rhs_k_inner = v_and_b32 %i, %mask
  %rhs_col_inner = v_lshrrev_b32_lit %i, 4
  %src1_base = v_mov_b32_copy %row_base
  %rhs_col_base = v_mad_u32_u24_src1_lit %rhs_col_inner, %src1_base, 3072
  %kk_v = v_mov_b32_copy %kk
  %rhs_k = v_add_u32 %kk_v, %rhs_k_inner
  %rhs_index = v_add_u32 %rhs_col_base, %rhs_k
  %rhs_address = v_lshlrev_b32_src0_inline %rhs_index, 2
  %rhs = global_load_b32_saddr %rhs_address, %src1_view
  %next = v_add_f32 %inner_acc, %rhs
  %lane_step = v_mov_b32 64
  %next_i = v_add_u32 %i, %lane_step
  low.br ^inner(%next_i: reg<amdgpu.vgpr>, %next: reg<amdgpu.vgpr>)
^inner_exit:
  s_mov_b64_exec %saved_wave_exec
  %next_kk = s_add_u32 %kk, %step
  low.br ^outer(%next_kk: reg<amdgpu.sgpr>, %inner_acc: reg<amdgpu.vgpr>)
^after:
  %src0_offset = s_lshl_b32_rhs_inline %row_base, 10
  %src0_low = slice %src0_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %src0_high = slice %src0_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %src0_address_low, %src0_address_low_carry = s_add_co_u32 %src0_low, %src0_offset
  %src0_address_high, %src0_address_high_carry = s_addc_u32 %src0_high, %zero, %src0_address_low_carry
  %src0_address = concat(%src0_address_low, %src0_address_high) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %src0_half = global_load_d16_b16_saddr %zero_f32, %src0_address
  %src0_f32 = v_cvt_f32_f16 %src0_half
  %result = v_add_f32 %outer_acc, %src0_f32
  %dst_offset = s_lshl_b32_rhs_inline %row_base, 11
  %dst_low = slice %dst_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %dst_high = slice %dst_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %dst_address_low, %dst_address_low_carry = s_add_co_u32 %dst_low, %dst_offset
  %dst_address_high, %dst_address_high_carry = s_addc_u32 %dst_high, %zero, %dst_address_low_carry
  %dst_address = concat(%dst_address_low, %dst_address_high) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %zero_f32, %result, %dst_address
  return
}

