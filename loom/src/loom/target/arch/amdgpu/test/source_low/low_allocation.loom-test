// RUN: emit low-allocation-json @d16_tied_concat_loop_edge

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @d16_tied_concat_loop_edge(%condition: reg<amdgpu.scc>, %address: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  low.br ^loop(%seed: reg<amdgpu.vgpr x8>)
^loop(%state: reg<amdgpu.vgpr x8>):
  low.cond_br %condition, ^body, ^exit : reg<amdgpu.scc>
^body:
  %low = ds_load_u16_d16 %address
  %high = ds_load_u16_d16_hi %low, %address {offset = 2}
  %lane1 = v_mov_b32 1
  %lane2 = v_mov_b32 2
  %lane3 = v_mov_b32 3
  %lane4 = v_mov_b32 4
  %lane5 = v_mov_b32 5
  %lane6 = v_mov_b32 6
  %lane7 = v_mov_b32 7
  %next = concat(%high, %lane1, %lane2, %lane3, %lane4, %lane5, %lane6, %lane7) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  low.br ^loop(%next: reg<amdgpu.vgpr x8>)
^exit:
  return %state
}

