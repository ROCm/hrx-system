// RUN: with-low-asm pass low-materialize-allocation{budgets=amdgpu.vgpr=5}

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @integer_valu_rematerializes_spill_plan(%condition: reg<amdgpu.scc>, %lane: reg<amdgpu.vgpr>, %tail: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %mask = v_mov_b32 255
  %base = v_add_u32 %lane, %tail
  %masked = v_and_b32 %lane, %mask
  %linear = v_lshl_add_u32_shift_imm %masked, %base, 2
  %packed = v_bfi_b32_src0_lit %linear, %tail, 65535
  low.cond_br %condition, ^then, ^else : reg<amdgpu.scc>
^then:
  %then_sum = v_add_u32 %packed, %tail
  %then_mix = v_xor_b32 %then_sum, %linear
  %use0 = v_add_u32 %then_mix, %lane
  return %use0
^else:
  %else_max = v_max_u32 %packed, %base
  %else_mix = v_or_b32 %else_max, %linear
  %use1 = v_add_u32 %else_mix, %tail
  return %use1
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @integer_valu_rematerializes_spill_plan(%condition: reg<amdgpu.scc>, %lane: reg<amdgpu.vgpr>, %tail: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %mask = v_mov_b32 255
  %base = v_add_u32 %lane, %tail
  %masked = v_and_b32 %lane, %mask
  %linear = v_lshl_add_u32_shift_imm %masked, %base, 2
  %packed = v_bfi_b32_src0_lit %linear, %tail, 65535
  low.cond_br %condition, ^then, ^else : reg<amdgpu.scc>
^then:
  %then_sum = v_add_u32 %packed, %tail
  %then_mix = v_xor_b32 %then_sum, %linear
  %use0 = v_add_u32 %then_mix, %lane
  return %use0
^else:
  %else_max = v_max_u32 %packed, %base
  %else_mix = v_or_b32 %else_max, %linear
  %use1 = v_add_u32 %else_mix, %tail
  return %use1
}

// ====

// Overlapping scalar values force actual pressure above the nine-VGPR budget.
// The eight slice users then share one predicted full-width reload.
// RUN: with-checks emit low-allocation-json @dense_spilled_slices_share_full_reload amdgpu.vgpr=9

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @dense_spilled_slices_share_full_reload(%packed: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %temporary = v_add_f32 %acc, %acc
  %initial = v_add_f32 %acc, %temporary
  %lane0 = slice %packed[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum0 = v_add_f32 %initial, %lane0
  %lane1 = slice %packed[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum1 = v_add_f32 %sum0, %lane1
  %lane2 = slice %packed[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum2 = v_add_f32 %sum1, %lane2
  %lane3 = slice %packed[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum3 = v_add_f32 %sum2, %lane3
  %lane4 = slice %packed[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum4 = v_add_f32 %sum3, %lane4
  %lane5 = slice %packed[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum5 = v_add_f32 %sum4, %lane5
  %lane6 = slice %packed[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum6 = v_add_f32 %sum5, %lane6
  %lane7 = slice %packed[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum7 = v_add_f32 %sum6, %lane7
  return %sum7
}

// ----
// All eight slice users share one full-width reload of the spilled tuple.
CHECK: *"spill_count":1,"spill_plan_count":1,*
CHECK: *"space":"scratch","value":{"id":*,"name":"packed","type":"reg<amdgpu.vgpr x8>"},"byte_size":32,"byte_alignment":16,"store_count":1,"reload_count":1}*

// ====

// RUN: emit amdgpu-allocation-json @loaded_chained_destructive_sgpr_results allocation-diagnostics=placement-decisions

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @loaded_chained_destructive_sgpr_results(%base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>) asm {
  %position = s_load_dword_offset_only %base
  // REMARK@+1: BACKEND/043 {source_value_name="position", result_value_name="active_row_count", value_class="amdgpu.sgpr", placement_cause="tied-result", decision="accepted", reason_key="assigned-locations-match"}
  %active_row_count = s_addk_i32 %position, 1
  // REMARK@+1: BACKEND/043 {source_value_name="active_row_count", result_value_name="padded_active_row_count", value_class="amdgpu.sgpr", placement_cause="tied-result", decision="accepted", reason_key="assigned-locations-match"}
  %padded_active_row_count = s_addk_i32 %active_row_count, 63
  %active_block_count = s_lshr_b32_rhs_inline %padded_active_row_count, 6
  return %active_block_count
}

// ====

// RUN: with-checks emit low-allocation-json @d16_tied_concat_loop_edge

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @d16_tied_concat_loop_edge(%condition: reg<amdgpu.scc>, %address: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  low.br ^loop(%seed: reg<amdgpu.vgpr x8>)
^loop(%state: reg<amdgpu.vgpr x8>):
  low.cond_br %condition, ^body, ^exit : reg<amdgpu.scc>
^body:
  %low = ds_load_u16_d16 %address
  %high = ds_load_u16_d16_hi %low, %address {offset = 2}
  %lane1 = v_mov_b32 1
  %lane2 = v_mov_b32 2
  %lane3 = v_mov_b32 3
  %lane4 = v_mov_b32 4
  %lane5 = v_mov_b32 5
  %lane6 = v_mov_b32 6
  %lane7 = v_mov_b32 7
  %next = concat(%high, %lane1, %lane2, %lane3, %lane4, %lane5, %lane6, %lane7) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  low.br ^loop(%next: reg<amdgpu.vgpr x8>)
^exit:
  return %state
}

// ----
// The d16 halves share a register; the tuple coalesces with the loop state.
CHECK: *"spill_count":0,*
CHECK: *"name":"low","type":"reg<amdgpu.vgpr>"},"class":*,"start_point":5,"end_point":15,"unit_count":1,"location":{"kind":"physical_register","base":0,"count":1}}*
CHECK: *"name":"high","type":"reg<amdgpu.vgpr>"},"class":*,"start_point":6,"end_point":15,"unit_count":1,"location":{"kind":"physical_register","base":0,"count":1}}*
CHECK: *"name":"state","type":"reg<amdgpu.vgpr x8>"},"class":*,"start_point":2,"end_point":17,"unit_count":8,"location":{"kind":"physical_register","base":16,"count":8}}*
CHECK: *"name":"next","type":"reg<amdgpu.vgpr x8>"},"class":*,"start_point":14,"end_point":15,"unit_count":8,"location":{"kind":"physical_register","base":16,"count":8}}*
