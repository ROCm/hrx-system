// RUN: with-checks emit low-allocation-json @materialized_pair_descriptor_survives_exec_tail_backedge fixed=%blocker:physical_register:2:2

amdgpu.target<gfx1100> @target

low.kernel.def target<amdgpu.rdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) @materialized_pair_descriptor_survives_exec_tail_backedge() asm {
  %kernarg = live_in<amdgpu.kernarg_segment_ptr> : reg<amdgpu.sgpr x2>
  %blocker = live_in<amdgpu.dispatch_ptr> : reg<amdgpu.sgpr x2>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %binding_pair = s_load_dwordx4_offset_only %kernarg
  %descriptor = slice %binding_pair[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %output = slice %binding_pair[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %mask = v_cmp_eq_i32_src1_inline %lane {rhs = 0}
  %saved_exec, %has_lanes = s_and_saveexec_b64 %mask
  low.cond_br %has_lanes, ^load, ^tail : reg<amdgpu.scc>
^load:
  %address = v_lshlrev_b32_src0_inline %lane, 2
  %loaded = global_load_b32_saddr %address, %descriptor
  low.br ^join(%loaded: reg<amdgpu.vgpr>)
^tail:
  s_mov_b64_exec %saved_exec
  %tail_mask = s_and_b64 %saved_exec, %mask
  %combined_tail_mask = s_or_b64 %tail_mask, %blocker
  %remaining = s_xor_b64_exec %combined_tail_mask
  low.cond_br %remaining, ^load, ^exit : reg<amdgpu.scc>
^join(%value: reg<amdgpu.vgpr>):
  %store_address = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %store_address, %value, %output
  return
^exit:
  return
}

