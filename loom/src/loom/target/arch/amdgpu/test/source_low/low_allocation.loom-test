low.func.def target<amdgpu.rdna3.core>(@target) @dispatch_ptr_lifetime_releases_sgpr_pair() -> (reg<amdgpu.sgpr>) asm {
  %dispatch = live_in<amdgpu.dispatch_ptr> : reg<amdgpu.sgpr x2>
  %grid = s_load_dword_offset_only %dispatch {offset = 12}
  %late = s_mov_b32 7
