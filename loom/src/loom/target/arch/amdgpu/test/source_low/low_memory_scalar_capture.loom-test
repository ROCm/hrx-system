// Scalar input capture and result readiness are separate hardware events.
// Fixed assignments force the overwrite; available spare SGPRs cannot hide it.

// RUN: emit amdgpu-assembly @buffer_scalar_capture_gfx942 strategy=source fixed=%resource:physical_register:32:4 fixed=%offset:physical_register:40:1 fixed=%next_offset:physical_register:40:1 fixed=%first:physical_register:8:1 fixed=%second:physical_register:12:1

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @buffer_scalar_capture_gfx942(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = buffer_load_dword %resource, %address, %offset
  %next_offset = s_add_u32_rhs_inline %offset, 4
  %second = buffer_load_dword %resource, %address, %next_offset
  return %first, %second
}

// ----
  buffer_load_dword v8, v0, s[32:35], s40 offen offset:0
  s_add_u32 s40, s40, 4
  buffer_load_dword v12, v0, s[32:35], s40 offen offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

