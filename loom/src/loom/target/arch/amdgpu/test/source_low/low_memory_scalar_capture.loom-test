// ====
// RUN: emit amdgpu-assembly @global_atomic_scalar_capture strategy=source fixed=%base:physical_register:32:2 fixed=%replacement:physical_register:32:1 fixed=%old:physical_register:8:1

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @global_atomic_scalar_capture(%base: reg<amdgpu.sgpr x2>, %address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>) asm {
  %old = global_atomic_add_rtn_saddr %address, %value, %base
  %replacement = s_mov_b32 0
  return %old, %replacement
}

// ----
  global_atomic_add_rtn_saddr v8, v0, v1, s[32:33] offset:0 sc1:0
  s_mov_b32 s32, 0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

