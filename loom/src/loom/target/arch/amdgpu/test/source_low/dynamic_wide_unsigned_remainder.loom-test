// RUN: emit source-low @uniform_i64 target=amdgpu:gfx11-generic output=low

// A full-width dividend and runtime word divisor use exact scalar arithmetic.
kernel.def @uniform_i64() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%dividend: i64, %divisor0: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %divisor = scalar.assume %divisor0 [range(%divisor0, 1, 4294967295)] : i64
  %remainder = scalar.remui %dividend, %divisor : i64
  view.store %remainder, %result_view_0[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

