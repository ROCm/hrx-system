// RUN: emit source-low @wide_index target=amdgpu:gfx11-generic output=low

// Wide index coordinates may still use runtime extents whose remainders fit
// the target's signed 32-bit index carrier.
kernel.def @wide_index() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%dividend0: index, %divisor0: index, %captured_buffer: buffer) where [range(%dividend0, 4294967296, 8589934591), range(%divisor0, 1, 2147483648)] {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi64>
  %dividend = index.assume %dividend0 [range(%dividend0, 4294967296, 8589934591)] : index
  %divisor = index.assume %divisor0 [range(%divisor0, 1, 2147483648)] : index
  %remainder = index.rem %dividend, %divisor : index
  %stored_1_0 = index.cast %remainder : index to i64
  view.store %stored_1_0, %captured[%capture_lane] : i64, view<64xi64>
  kernel.return
}

