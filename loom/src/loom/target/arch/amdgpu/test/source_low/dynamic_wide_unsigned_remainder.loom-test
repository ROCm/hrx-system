// ====

// RUN: emit source-low @varying_i64 target=amdgpu:gfx942 output=low

// Lane-varying primes preserve every dividend word on CDNA.
func.def @varying_i64(%values: vector<2xi64>) -> (i64) {
  %dividend = vector.extract %values[0] : vector<2xi64> -> i64
  %divisor0 = vector.extract %values[1] : vector<2xi64> -> i64
  %divisor = scalar.assume %divisor0 [range(%divisor0, 1, 16000889)] : i64
  %remainder = scalar.remui %dividend, %divisor : i64
  func.return %remainder : i64
}

