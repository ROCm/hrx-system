  %49 = concat(%46, %48) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %second = low.func.call pure @advance(%49) : (reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>)
  %51 = v_lshlrev_b32_src0_inline %lane, 4
  global_store_b64_saddr %51, %first, %output_view
  global_store_b64_saddr %51, %second, %output_view {offset = 8}
  return
}
