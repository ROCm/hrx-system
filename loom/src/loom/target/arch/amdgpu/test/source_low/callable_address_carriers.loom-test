// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Narrow and wide callers share one retained address signature.
func.def noinline @advance(%value: offset) -> (i64) {
  %increment = index.constant 8 : offset
  %next = index.add %value, %increment : offset
  %bits = index.cast %next : offset to i64
  func.return %bits : i64
}

kernel.def @uniform_offsets() {
  %groups = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %groups, %groups) workgroup_size(%threads, %groups, %groups) : index
} launch(%output: buffer, %wide: offset) where [range(%wide, 0, 8589934591)] {
  %small = index.constant 16 : offset
  %first = func.call @advance(%small) : (offset) -> (i64)
  %second = func.call @advance(%wide) : (offset) -> (i64)
  %origin = index.constant 0 : offset
  %output_view = buffer.view %output[%origin] : buffer -> view<64x2xi64>
  %row = kernel.workitem.id<x> : index
  view.store %first, %output_view[%row, 0] : i64, view<64x2xi64>
  view.store %second, %output_view[%row, 1] : i64, view<64x2xi64>
  kernel.return
}

