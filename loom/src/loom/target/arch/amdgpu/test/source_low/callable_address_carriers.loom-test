  %increment = s_mov_b32 8
  %22 = s_mov_b32 0
  %24 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28, %29 = s_add_co_u32 %24, %increment
  %30, %31 = s_addc_u32 %25, %22, %29
  %bits = concat(%28, %30) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %bits
}

