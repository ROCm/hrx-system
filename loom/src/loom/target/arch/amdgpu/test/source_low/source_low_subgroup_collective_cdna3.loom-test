// ====

amdgpu.target<gfx942> @target

// Each stage visits independent components before the next dependent stage.
// The half-wave combines DPP rows through one DS exchange per component.
kernel.def target(@target) @workgroup_vector_row_reductions() {
  %unit = index.constant 1 : index
  %items = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%float_input: buffer, %integer_input: buffer, %float_output: buffer, %integer_output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %float_source = buffer.view %float_input[%base] : buffer -> view<32x4xf32>
  %integer_source = buffer.view %integer_input[%base] : buffer -> view<32x2xi32>
  %float_destination = buffer.view %float_output[%base] : buffer -> view<32x4xf32>
  %integer_destination = buffer.view %integer_output[%base] : buffer -> view<32x2xi32>
  %float_values = vector.load %float_source[%lane, 0] : view<32x4xf32> -> vector<4xf32>
  %integer_values = vector.load %integer_source[%lane, 0] : view<32x2xi32> -> vector<2xi32>
  %sum = kernel.workgroup.reduce<addf> %float_values : vector<4xf32>
  %minimum = kernel.workgroup.reduce<minsi> %integer_values : vector<2xi32>
  vector.store %sum, %float_destination[%lane, 0] : vector<4xf32>, view<32x4xf32>
  vector.store %minimum, %integer_destination[%lane, 0] : vector<2xi32>, view<32x2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 4, resource_count = 4, resource_offsets = [0, 8, 16, 24], resource_parameter_indices = [0, 1, 2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @workgroup_vector_row_reductions() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %float_source = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %integer_source = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %float_destination = resource<hal_binding> {extent = 512, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %integer_destination = resource<hal_binding> {extent = 256, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %43 = v_lshlrev_b32_src0_inline %lane, 4
  %float_values = global_load_dwordx4_saddr %43, %float_source
  %45 = v_lshlrev_b32_src0_inline %lane, 3
  %integer_values = global_load_dwordx2_saddr %45, %integer_source
  %47 = slice %float_values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %48 = slice %float_values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %49 = slice %float_values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %50 = slice %float_values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %51 = v_add_f32_dpp %47, %47 {dpp_ctrl = 177}
  %52 = v_add_f32_dpp %48, %48 {dpp_ctrl = 177}
  %53 = v_add_f32_dpp %49, %49 {dpp_ctrl = 177}
  %54 = v_add_f32_dpp %50, %50 {dpp_ctrl = 177}
  %55 = v_add_f32_dpp %51, %51 {dpp_ctrl = 78}
  %56 = v_add_f32_dpp %52, %52 {dpp_ctrl = 78}
  %57 = v_add_f32_dpp %53, %53 {dpp_ctrl = 78}
  %58 = v_add_f32_dpp %54, %54 {dpp_ctrl = 78}
  %59 = v_add_f32_dpp %55, %55 {dpp_ctrl = 321}
  %60 = v_add_f32_dpp %56, %56 {dpp_ctrl = 321}
  %61 = v_add_f32_dpp %57, %57 {dpp_ctrl = 321}
  %62 = v_add_f32_dpp %58, %58 {dpp_ctrl = 321}
