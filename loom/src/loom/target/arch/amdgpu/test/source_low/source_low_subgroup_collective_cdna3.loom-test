amdgpu.target<gfx942> @target

kernel.def target(@target) @subgroup_shuffle_xor_f32_pair_cdna3() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xf32>
  %value = view.load %input_view[%tid] : view<64xf32> -> f32
  %offset = scalar.constant 1 : i32
  %width = scalar.constant 2 : i32
  %shuffle, %valid = kernel.subgroup.shuffle<xor> %value, %offset, %width : f32, i32, i32
  view.store %shuffle, %output_view[%tid] : f32, view<64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_shuffle_xor_f32_pair_cdna3() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_dword_saddr %16, %input_view
  %shuffle = v_mov_b32_dpp %value {dpp_ctrl = 177}
  %19 = v_lshlrev_b32_src0_inline %tid, 2
  global_store_dword_saddr %19, %shuffle, %output_view
  return
}

