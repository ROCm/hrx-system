// RUN: emit source-low output=low

amdgpu.target<gfx942> @target

// The bias load intentionally stays outside the lane0 branch. Cross-wave
// workgroup reduction narrows EXEC internally, and later all-lane memory
// operations must not reuse VGPR materializations produced under that narrowed
// participant set.
kernel.def target(@target) @workgroup_reduce_then_all_lane_bias_load() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %bias: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %leader_index = index.constant 0 : index
  %second_output = index.constant 1 : index
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %bias_global = buffer.assume.memory_space<global> %bias : buffer
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %input_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input_global, %bias_global, %output_global : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<128xf32>
  %bias_view = buffer.view %bias_noalias[%base] : buffer -> view<1xbf16>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<2xf32>
  %value = view.load %input_view[%tid] : view<128xf32> -> f32
  %sum0 = kernel.workgroup.reduce<addf> %value : f32
  %sum1 = kernel.workgroup.reduce<addf> %value : f32
  %bias_bf16 = view.load %bias_view[%leader_index] : view<1xbf16> -> bf16
  %bias_f32 = scalar.extf %bias_bf16 : bf16 to f32
  %result0 = scalar.addf<reassoc|nnan|ninf|nsz> %sum0, %bias_f32 : f32
  %result1 = scalar.addf<reassoc|nnan|ninf|nsz> %sum1, %bias_f32 : f32
  %is_lane0 = index.cmp eq, %tid, %leader_index : index
  scf.if %is_lane0 {
    view.store %result0, %output_view[%leader_index] : f32, view<2xf32>
    view.store %result1, %output_view[%second_output] : f32, view<2xf32>
  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(128, 1, 1) workgroup_count(1, 1, 1) @workgroup_reduce_then_all_lane_bias_load() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %bias_view = resource<hal_binding> {extent = 2, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 8, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %30 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_dword_saddr %30, %input_view
  %32 = v_and_b32_src0_inline %tid, 63
  %33 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %34 = storage_address %33 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %35 = v_add_f32_dpp %value, %value {dpp_ctrl = 177}
  %36 = v_add_f32_dpp %35, %35 {dpp_ctrl = 78}
  %37 = v_add_f32_dpp %36, %36 {dpp_ctrl = 321}
  %38 = v_add_f32_dpp %37, %37 {dpp_ctrl = 320}
  %39 = v_xor_b32_src0_inline %32, 16
  %40 = v_lshlrev_b32_src0_inline %39, 2
  %41 = ds_bpermute_b32 %40, %38
  %42 = v_add_f32 %38, %41
  %43 = v_xor_b32_src0_inline %32, 32
  %44 = v_lshlrev_b32_src0_inline %43, 2
  %45 = ds_bpermute_b32 %44, %42
  %46 = v_add_f32 %42, %45
  %47 = v_lshrrev_b32_src0_inline %tid, 6
  %48 = v_lshlrev_b32_src0_inline %47, 2
  %49 = v_mov_b32 1
  %50 = v_cmp_lt_u32 %32, %49
  %51, %52 = s_and_saveexec_b64 %50
  %53 = v_add_u32 %34, %48
  ds_write_b32 %53, %46
  s_mov_b64_exec %51
  s_barrier
  %54 = v_mov_b32 2
  %55 = v_cmp_lt_u32 %32, %54
  %56, %57 = s_and_saveexec_b64 %55
  %58 = v_lshlrev_b32_src0_inline %32, 2
  %59 = v_add_u32 %34, %58
  %60 = ds_read_b32 %59
  %61 = v_add_f32_dpp %60, %60 {dpp_ctrl = 177}
  s_mov_b64_exec %56
  %62 = v_mov_b32 0
  %sum0 = ds_bpermute_b32 %62, %61
  s_barrier
  %64 = v_and_b32_src0_inline %tid, 63
  %65 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %66 = storage_address %65 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %67 = v_add_f32_dpp %value, %value {dpp_ctrl = 177}
  %68 = v_add_f32_dpp %67, %67 {dpp_ctrl = 78}
  %69 = v_add_f32_dpp %68, %68 {dpp_ctrl = 321}
  %70 = v_add_f32_dpp %69, %69 {dpp_ctrl = 320}
  %71 = v_xor_b32_src0_inline %64, 16
  %72 = v_lshlrev_b32_src0_inline %71, 2
  %73 = ds_bpermute_b32 %72, %70
  %74 = v_add_f32 %70, %73
  %75 = v_xor_b32_src0_inline %64, 32
  %76 = v_lshlrev_b32_src0_inline %75, 2
  %77 = ds_bpermute_b32 %76, %74
  %78 = v_add_f32 %74, %77
  %79 = v_lshrrev_b32_src0_inline %tid, 6
  %80 = v_lshlrev_b32_src0_inline %79, 2
  %81 = v_mov_b32 1
  %82 = v_cmp_lt_u32 %64, %81
  %83, %84 = s_and_saveexec_b64 %82
  %85 = v_add_u32 %66, %80
  ds_write_b32 %85, %78
  s_mov_b64_exec %83
  s_barrier
  %86 = v_mov_b32 2
  %87 = v_cmp_lt_u32 %64, %86
  %88, %89 = s_and_saveexec_b64 %87
  %90 = v_lshlrev_b32_src0_inline %64, 2
  %91 = v_add_u32 %66, %90
  %92 = ds_read_b32 %91
  %93 = v_add_f32_dpp %92, %92 {dpp_ctrl = 177}
  s_mov_b64_exec %88
  %94 = v_mov_b32 0
  %sum1 = ds_bpermute_b32 %94, %93
  s_barrier
  %96 = v_mov_b32 0
  %bias_bf16 = global_load_d16_b16_saddr %96, %bias_view
  %bias_f32 = v_lshlrev_b32_src0_16_low16 %bias_bf16
  %result0 = v_add_f32 %sum0, %bias_f32
  %result1 = v_add_f32 %sum1, %bias_f32
  %is_lane0 = v_cmp_eq_i32_src1_inline %tid {rhs = 0}
  %102, %103 = s_and_saveexec_b64 %is_lane0
  low.cond_br %103, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %104 = v_mov_b32 0
  global_store_dword_saddr %104, %result0, %output_view
  global_store_dword_saddr %104, %result1, %output_view {offset = 4}
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %102
  return
}

