// ====
// A partial write consumes the whole old SSA owner, even when a later read
// would happen to observe preserved bits. The result names the new owner.
// RUN: verify

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @partial_write_consumes_original(%seed: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %changed = ds_load_u16_d16_hi %seed, %address
  // ERROR@+1: DOMINANCE/002 {value_name="seed"}
  global_store_short_saddr %address, %seed, %output
  return
}

