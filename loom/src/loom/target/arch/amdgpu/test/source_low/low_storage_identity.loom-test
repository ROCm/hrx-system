  %snapshot = copy %first : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %second = v_fmac_f32 %alias, %factor, %factor
  global_store_b32_saddr %address, %snapshot, %output
  global_store_b32_saddr %address, %second, %output {offset = 4}
  return
}

