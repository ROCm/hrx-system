// A non-writing alias shares the source's current contents. The branch keeps
// the old value observable after the destructive write through that alias.
// RUN: emit amdgpu-assembly @original_read_alias_write

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @original_read_alias_write(%seed: reg<amdgpu.vgpr>, %factor: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %alias = low.assume %seed [range(%seed, 0, 1024)] : reg<amdgpu.vgpr>
  %snapshot = copy %seed : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %changed = v_fmac_f32 %alias, %factor, %factor
  low.br ^exit(%snapshot: reg<amdgpu.vgpr>)
^exit(%saved: reg<amdgpu.vgpr>):
  global_store_b32_saddr %address, %saved, %output
  global_store_b32_saddr %address, %changed, %output {offset = 4}
  return
}

