// RUN: emit amdgpu-assembly @rematerialization_budget_falls_back_to_spills strategy=source amdgpu.vgpr=5

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @rematerialization_budget_falls_back_to_spills(%addr: reg<amdgpu.vgpr>, %a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
  %literal = v_mov_b32 7
  %loaded0 = global_load_b32_saddr %addr, %input
  %loaded1 = global_load_b32_saddr %addr, %input {offset = 4}
  %ab = v_add_u32 %a, %b
  %bc = v_add_u32 %b, %c
  %use0 = v_add_u32 %ab, %literal
  %use1 = v_add_u32 %bc, %literal
  %sum0 = v_add_u32 %loaded0, %use0
  %sum1 = v_add_u32 %loaded1, %use1
  %sum2 = v_add_u32 %sum0, %sum1
  global_store_b32_saddr %addr, %sum2, %output
  return
}

