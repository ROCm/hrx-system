// ====

// A changing divisor cannot amortize preparation. Keep it in the body rather
// than adding work at the header's final exit test.
func.def @changing_divisor(%count: index, %initial: i32, %initial_divisor: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c2 = scalar.constant 2 : i32
  %result, %final_divisor = scf.for %i = [%begin to %count step %step](%value = %initial : i32, %divisor = %initial_divisor : i32) -> (i32, i32) {
    %quotient = scalar.divui %value, %divisor : i32
    %next = scalar.addi %value, %quotient : i32
    %next_divisor = scalar.addi %divisor, %c2 : i32
    scf.yield %next, %next_divisor : i32, i32
  }
  func.return %result : i32
}

