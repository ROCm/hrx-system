  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %37 = v_cvt_f32_u32 %bounded_divisor
  %38 = v_rcp_f32 %37
  %39 = v_mul_f32_lit %38, 1333788670
  %40 = v_cvt_u32_f32 %39
  %41 = v_readfirstlane_b32 %40
  %42 = s_mul_i32 %bounded_divisor, %41
  %43 = s_sub_u32 %begin, %42
  %44 = s_mul_hi_u32 %41, %43
  %45 = s_add_u32 %41, %44
  %46 = s_ashr_i32_rhs_inline %initial, 31
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %initial: reg<amdgpu.sgpr>, %46: reg<amdgpu.sgpr>)
^_bb1(%i: reg<amdgpu.sgpr>, %84: reg<amdgpu.sgpr>, %85: reg<amdgpu.sgpr>):
  %48 = s_cmp_lt_i32 %i, %count
  low.cond_br %48, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %50 = s_mov_b32 1
  %51 = s_mul_hi_u32 %84, %45
  %52 = s_mul_i32 %51, %bounded_divisor
  %53 = s_sub_u32 %84, %52
  %54 = s_add_u32 %51, %50
  %55, %56 = s_sub_co_u32 %53, %bounded_divisor
  %57 = s_cselect_b32 %51, %54, %56
  %58 = s_cselect_b32 %53, %55, %56
  %59 = s_add_u32 %57, %50
  %60, %61 = s_sub_co_u32 %58, %bounded_divisor
  %quotient = s_cselect_b32 %57, %59, %61
  %remainder = s_cselect_b32 %58, %60, %61
  %64 = s_mov_b32 0
  %72, %73 = s_add_co_u32 %quotient, %remainder
  %74, %75 = s_addc_u32 %64, %64, %73
  %77 = s_add_u32 %i, %step
  low.br ^_bb1(%77: reg<amdgpu.sgpr>, %72: reg<amdgpu.sgpr>, %74: reg<amdgpu.sgpr>)
^_bb3:
  %79 = v_mov_b32_copy %84
  %81 = v_mov_b32_copy %85
  %82 = concat(%79, %81) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %83 = v_lshlrev_b32_src0_inline %capture_lane, 3
  global_store_b64_saddr %83, %82, %captured
  return
}

// ====

// Signed and unsigned interpretations of one divisor need separate seeds.
// A later unsigned use shares the first seed across an intervening signed use.
kernel.def @mixed_divisor_domains() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%count: index, %initial: i32, %divisor: i32, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %count step %step](%value = %initial : i32) -> (i32) {
    %unsigned_quotient = scalar.divui %value, %divisor : i32
    %signed_quotient = scalar.divsi %unsigned_quotient, %divisor : i32
    %remainder = scalar.remui %signed_quotient, %divisor : i32
    %next = scalar.addi %value, %remainder : i32
    scf.yield %next : i32
  }
  view.store %result, %captured[%capture_lane] : i32, view<64xi32>
  kernel.return
}

