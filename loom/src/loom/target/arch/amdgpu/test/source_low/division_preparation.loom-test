// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// A memory-free loop requests physical preparation after operand carriers
// are selected. The runtime trip count may be zero, so its signed initial index
// must survive widening even when the body assumes nonnegative values.
func.def @invariant_index_divisor(%count: index, %initial: index, %divisor: index) -> (index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bounded_divisor = index.assume %divisor [range(%divisor, 1, 2147483647)] : index
  %result = scf.for %i = [%begin to %count step %step](%value = %initial : index) -> (index) {
    %bounded_value = index.assume %value [range(%value, 0, 2147483647)] : index
    %quotient, %remainder = index.divrem %bounded_value, %bounded_divisor : index
    %next = index.add %quotient, %remainder : index
    scf.yield %next : index
  }
  func.return %result : index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @invariant_index_divisor(%count: reg<amdgpu.sgpr>, %initial: reg<amdgpu.sgpr>, %bounded_divisor: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %30 = v_cvt_f32_u32 %bounded_divisor
  %31 = v_rcp_f32 %30
  %32 = v_mul_f32_lit %31, 1333788670
  %33 = v_cvt_u32_f32 %32
  %34 = v_readfirstlane_b32 %33
  %35 = s_mul_i32 %bounded_divisor, %34
  %36 = s_sub_u32 %begin, %35
  %37 = s_mul_hi_u32 %34, %36
  %38 = s_add_u32 %34, %37
  %39 = s_ashr_i32_rhs_inline %initial, 31
  %40 = concat(%initial, %39) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %40: reg<amdgpu.sgpr x2>)
^_bb1(%i: reg<amdgpu.sgpr>, %bounded_value: reg<amdgpu.sgpr x2>):
  %41 = s_cmp_lt_i32 %i, %count
  low.cond_br %41, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %42 = slice %bounded_value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %43 = s_mov_b32 1
  %44 = s_mul_hi_u32 %42, %38
  %45 = s_mul_i32 %44, %bounded_divisor
  %46 = s_sub_u32 %42, %45
  %47 = s_add_u32 %44, %43
  %48, %49 = s_sub_co_u32 %46, %bounded_divisor
  %50 = s_cselect_b32 %44, %47, %49
  %51 = s_cselect_b32 %46, %48, %49
  %52 = s_add_u32 %50, %43
  %53, %54 = s_sub_co_u32 %51, %bounded_divisor
  %quotient = s_cselect_b32 %50, %52, %54
  %remainder = s_cselect_b32 %51, %53, %54
  %57 = s_mov_b32 0
  %65, %66 = s_add_co_u32 %quotient, %remainder
  %67, %68 = s_addc_u32 %57, %57, %66
  %next = concat(%65, %67) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %70 = s_add_u32 %i, %step
  low.br ^_bb1(%70: reg<amdgpu.sgpr>, %next: reg<amdgpu.sgpr x2>)
^_bb3:
  return %bounded_value
}

// ====

// Signed and unsigned interpretations of one divisor need separate seeds.
// A later unsigned use shares the first seed across an intervening signed use.
func.def @mixed_divisor_domains(%count: index, %initial: i32, %divisor: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %count step %step](%value = %initial : i32) -> (i32) {
    %unsigned_quotient = scalar.divui %value, %divisor : i32
    %signed_quotient = scalar.divsi %unsigned_quotient, %divisor : i32
    %remainder = scalar.remui %signed_quotient, %divisor : i32
    %next = scalar.addi %value, %remainder : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

