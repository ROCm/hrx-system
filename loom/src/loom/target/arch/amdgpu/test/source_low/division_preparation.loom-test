// A memory-free loop requests physical preparation after operand carriers
// are selected. The runtime trip count may be zero, so its signed initial index
// must survive widening even when the body assumes nonnegative values.
func.def @invariant_index_divisor(%count: index, %initial: index, %divisor: index) -> (index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bounded_divisor = index.assume %divisor [range(%divisor, 1, 2147483647)] : index
  %result = scf.for %i = [%begin to %count step %step](%value = %initial : index) -> (index) {
    %bounded_value = index.assume %value [range(%value, 0, 2147483647)] : index
    %quotient, %remainder = index.divrem %bounded_value, %bounded_divisor : index
    %next = index.add %quotient, %remainder : index
    scf.yield %next : index
  }
  func.return %result : index
}

