^_bb1(%i: reg<amdgpu.sgpr>, %value: reg<amdgpu.sgpr>, %divisor: reg<amdgpu.sgpr>):
  %52 = v_cvt_f32_u32 %divisor
  %53 = v_rcp_f32 %52
  %54 = v_mul_f32_lit %53, 1333788670
  %55 = v_cvt_u32_f32 %54
