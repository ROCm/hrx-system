  low.br ^_bb1(%57: reg<amdgpu.sgpr>, %next: reg<amdgpu.sgpr>)
^_bb6:
  return %value
}

// ====

// A dead selected division must not retain or initialize physical state.
func.def @dead_division(%count: index, %initial: i32, %divisor: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c3 = scalar.constant 3 : i32
  %result = scf.for %i = [%begin to %count step %step](%value = %initial : i32) -> (i32) {
    %unused = scalar.divui %value, %divisor : i32
    %next = scalar.addi %value, %c3 : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

