// ====

// A control-dependent divisor promise remains an initialization dependency.
// Neither the promise nor its preparation may escape the guarded loop body.
func.def @guarded_divisor(%count: index, %initial: i32, %input_divisor: i32, %enabled: i1) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %count step %step](%value = %initial : i32) -> (i32) {
    %next = scf.if %enabled -> (i32) {
      %divisor = scalar.assume %input_divisor [ne(%input_divisor, 0)] : i32
      %quotient = scalar.divui %value, %divisor : i32
      scf.yield %quotient : i32
    } else {
      scf.yield %value : i32
    }
    scf.yield %next : i32
  }
  func.return %result : i32
}

