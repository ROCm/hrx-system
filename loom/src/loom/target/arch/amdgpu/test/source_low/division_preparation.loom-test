// ====

// Extracted vector lanes retain varying carriers. Preparation must follow
// the lane definition and dominate all executions of the loop body.
func.def @varying_divisor(%count: index, %inputs: vector<2xi32>) -> (i32) {
  %initial = vector.extract %inputs[0] : vector<2xi32> -> i32
  %divisor = vector.extract %inputs[1] : vector<2xi32> -> i32
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %count step %step](%value = %initial : i32) -> (i32) {
    %quotient, %remainder = scalar.divremsi %value, %divisor : i32
    %next = scalar.addi %quotient, %remainder : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

