// ====

// Extracted vector lanes retain varying carriers. Preparation must follow
// the lane definition and dominate all executions of the loop body.
kernel.def @varying_divisor() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%count: index, %inputs_buffer: buffer, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %inputs_view = buffer.view %inputs_buffer[%capture_base] : buffer -> view<64x2xi32>
  %inputs = vector.load %inputs_view[%capture_lane, 0] : view<64x2xi32> -> vector<2xi32>
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi32>
  %initial = vector.extract %inputs[0] : vector<2xi32> -> i32
  %divisor = vector.extract %inputs[1] : vector<2xi32> -> i32
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %count step %step](%value = %initial : i32) -> (i32) {
    %quotient, %remainder = scalar.divremsi %value, %divisor : i32
    %next = scalar.addi %quotient, %remainder : i32
    scf.yield %next : i32
  }
  view.store %result, %captured[%capture_lane] : i32, view<64xi32>
  kernel.return
}

