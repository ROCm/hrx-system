// ====

// A divisor carried by the outer loop is still invariant in the inner loop.
// Its seed belongs between the outer header and the inner entry.
kernel.def @nested_divisor() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%count: index, %initial: i32, %initial_divisor: i32, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<64xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c2 = scalar.constant 2 : i32
  %result, %final_divisor = scf.for %i = [%begin to %count step %step](%value = %initial : i32, %divisor = %initial_divisor : i32) -> (i32, i32) {
    %inner_result = scf.for %j = [%begin to %count step %step](%inner_value = %value : i32) -> (i32) {
      %quotient = scalar.divui %inner_value, %divisor : i32
      %next = scalar.addi %inner_value, %quotient : i32
      scf.yield %next : i32
    }
    %next_divisor = scalar.addi %divisor, %c2 : i32
    scf.yield %inner_result, %next_divisor : i32, i32
  }
  view.store %result, %captured[%capture_lane] : i32, view<64xi32>
  kernel.return
}

