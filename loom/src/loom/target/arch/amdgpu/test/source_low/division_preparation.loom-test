  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %c3 = s_mov_b32 3
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %initial: reg<amdgpu.sgpr>)
^_bb1(%i: reg<amdgpu.sgpr>, %value: reg<amdgpu.sgpr>):
