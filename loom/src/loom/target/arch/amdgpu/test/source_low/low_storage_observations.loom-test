  v_mov_b32 v4, v0
.Lbb1:
  v_add_u32 v0, v4, v2
.Lbb2:
  s_cbranch_scc0 .Lbb4
.Lbb3:
  v_mov_b32 v4, v0
  s_branch .Lbb1
.Lbb4:
  v_mov_b32 v5, v4
.Lbb5:
  global_store_b64 v1, v[4:5], s[0:1] offset:0
  global_store_b32 v1, v0, s[0:1] offset:8
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====
// Destructive use of a copy must preserve the source for a later decomposed
// edge, not just for its direct SSA users.
// RUN: emit amdgpu-assembly @tied_copy_preserves_tuple_component

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @tied_copy_preserves_tuple_component(%seed: reg<amdgpu.vgpr>, %factor: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %initial = concat(%seed, %seed) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %mutable = copy %seed : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %changed = v_fmac_f32 %mutable, %factor, %factor
  low.br ^output(%initial: reg<amdgpu.vgpr x2>)
^output(%saved: reg<amdgpu.vgpr x2>):
  global_store_b64_saddr %address, %saved, %output
  global_store_b32_saddr %address, %changed, %output {offset = 8}
  return
}

