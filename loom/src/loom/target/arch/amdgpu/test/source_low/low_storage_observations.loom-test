// ====
// The tuple observation is on a path that the changing loop cannot reach.
// The source and loop state remain eligible to share one physical register.
// RUN: emit amdgpu-assembly @disjoint_tuple_observation

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @disjoint_tuple_observation(%choose: reg<amdgpu.scc>, %count: reg<amdgpu.sgpr>, %seed: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 0
  %increment = v_mov_b32 1
  %initial = concat(%seed, %seed) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.cond_br %choose, ^enter, ^preserve : reg<amdgpu.scc>
^enter:
  low.br ^header(%begin: reg<amdgpu.sgpr>, %seed: reg<amdgpu.vgpr>)
^header(%index: reg<amdgpu.sgpr>, %current: reg<amdgpu.vgpr>):
  %continue = s_cmp_lt_i32 %index, %count
  low.cond_br %continue, ^body, ^exit : reg<amdgpu.scc>
^body:
  %next_index = s_add_u32_rhs_inline %index, 1
  %next = v_add_u32 %current, %increment
  low.br ^header(%next_index: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>)
^exit:
  global_store_b32_saddr %address, %current, %output
  return
^preserve:
  low.br ^output(%initial: reg<amdgpu.vgpr x2>)
^output(%saved: reg<amdgpu.vgpr x2>):
  global_store_b64_saddr %address, %saved, %output
  return
}

