// ====
// Required-component observation also includes ordinary users of an alias,
// independently of tuple decomposition.
// RUN: emit amdgpu-assembly @required_alias_preserves_direct_observation

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @required_alias_preserves_direct_observation(%count: reg<amdgpu.sgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 0
  %zero = v_mov_b32 0
  %increment = v_mov_b32 1
  %alias = low.assume %zero [range(%zero, 0, 1024)] : reg<amdgpu.vgpr>
  low.br ^header(%begin: reg<amdgpu.sgpr>, %zero: reg<amdgpu.vgpr>)
^header(%index: reg<amdgpu.sgpr>, %sum: reg<amdgpu.vgpr>):
  %continue = s_cmp_lt_i32 %index, %count
  low.cond_br %continue, ^body, ^exit : reg<amdgpu.scc>
^body:
  %next_index = s_add_u32_rhs_inline %index, 1
  %next_sum = v_add_u32 %sum, %increment
  low.br ^header(%next_index: reg<amdgpu.sgpr>, %next_sum: reg<amdgpu.vgpr>)
^exit:
  global_store_b32_saddr %address, %alias, %output
  global_store_b32_saddr %address, %sum, %output {offset = 4}
  return
}

