// A decomposed tuple edge still reads the original zero after the changing
// scalar loop value has stopped using it through SSA.
// RUN: emit amdgpu-assembly @loop_preserves_tuple_component

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @loop_preserves_tuple_component(%count: reg<amdgpu.sgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 0
  %zero = v_mov_b32 0
  %increment = v_mov_b32 1
  %initial = concat(%zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^header(%begin: reg<amdgpu.sgpr>, %zero: reg<amdgpu.vgpr>)
^header(%index: reg<amdgpu.sgpr>, %sum: reg<amdgpu.vgpr>):
  %continue = s_cmp_lt_i32 %index, %count
  low.cond_br %continue, ^body, ^exit : reg<amdgpu.scc>
^body:
  %next_index = s_add_u32_rhs_inline %index, 1
  %next_sum = v_add_u32 %sum, %increment
  low.br ^header(%next_index: reg<amdgpu.sgpr>, %next_sum: reg<amdgpu.vgpr>)
^exit:
  low.br ^output(%initial: reg<amdgpu.vgpr x2>)
^output(%saved: reg<amdgpu.vgpr x2>):
  global_store_b64_saddr %address, %saved, %output
  global_store_b32_saddr %address, %sum, %output {offset = 8}
  return
}

// ----
  v_dual_mov_b32 v3, 0 :: v_dual_mov_b32 v2, 1
  s_mov_b32 s1, 0
  s_delay_alu instid0(VALU_DEP_1)
  v_mov_b32 v1, v3
.Lbb1:
  s_cmp_lt_i32 s1, s0
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  v_add_u32 v1, v1, v2
  s_add_u32 s1, s1, 1
  s_branch .Lbb1
.Lbb3:
  v_mov_b32 v2, v3
.Lbb4:
  global_store_b64 v0, v[2:3], s[2:3] offset:0
  global_store_b32 v0, v1, s[2:3] offset:8
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====
// The backedge's destination remains physically observed after a successor
// argument is defined, even though its semantic uses end before that join.
// RUN: emit amdgpu-assembly @join_preserves_prior_tuple

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @join_preserves_prior_tuple(%again: reg<amdgpu.scc>, %seed: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %increment = v_mov_b32 1
  low.br ^header(%seed: reg<amdgpu.vgpr>)
^header(%current: reg<amdgpu.vgpr>):
  %initial = concat(%current, %current) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %next = v_add_u32 %current, %increment
  low.br ^join(%next: reg<amdgpu.vgpr>)
^join(%future: reg<amdgpu.vgpr>):
  low.cond_br %again, ^back, ^exit : reg<amdgpu.scc>
^back:
  low.br ^header(%future: reg<amdgpu.vgpr>)
^exit:
  low.br ^output(%initial: reg<amdgpu.vgpr x2>)
^output(%saved: reg<amdgpu.vgpr x2>):
  global_store_b64_saddr %address, %saved, %output
  global_store_b32_saddr %address, %future, %output {offset = 8}
  return
}

