  s_endpgm

// ====
// A nested concat edge reads its immediate tuple component's assigned storage.
// The changing loop tuple cannot overwrite that component before the exit.
// RUN: emit amdgpu-assembly @nested_tuple_preserves_component

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @nested_tuple_preserves_component(%count: reg<amdgpu.sgpr>, %seed: reg<amdgpu.vgpr x2>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 0
  %increment = v_mov_b32 1
  %low = slice %seed[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %high = slice %seed[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %pair = concat(%low, %high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %initial = concat(%pair, %pair) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  low.br ^header(%begin: reg<amdgpu.sgpr>, %pair: reg<amdgpu.vgpr x2>)
^header(%index: reg<amdgpu.sgpr>, %current: reg<amdgpu.vgpr x2>):
  %continue = s_cmp_lt_i32 %index, %count
  low.cond_br %continue, ^body, ^exit : reg<amdgpu.scc>
^body:
  %current_low = slice %current[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %next_low = v_add_u32 %current_low, %increment
  %next = concat(%next_low, %high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %next_index = s_add_u32_rhs_inline %index, 1
  low.br ^header(%next_index: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr x2>)
^exit:
  low.br ^output(%initial: reg<amdgpu.vgpr x4>)
^output(%saved: reg<amdgpu.vgpr x4>):
  global_store_b128_saddr %address, %saved, %output
  global_store_b64_saddr %address, %current, %output {offset = 16}
  return
}

