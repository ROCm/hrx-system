  s_add_u32 s1, s1, 1
  s_branch .Lbb1
.Lbb3:
  global_store_b32 v0, v1, s[2:3] offset:0
  global_store_b32 v0, v3, s[2:3] offset:4
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====
// Recreating a non-writing alias does not recreate its required component.
// Querying the origin preserves the zero needed by the next alias instance.
// RUN: emit amdgpu-assembly @recreated_alias_keeps_outer_component

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @recreated_alias_keeps_outer_component(%count: reg<amdgpu.sgpr>, %threshold: reg<amdgpu.sgpr>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 0
  %increment = v_mov_b32 1
  %zero = v_mov_b32 0
  low.br ^pack(%begin: reg<amdgpu.sgpr>)
^pack(%index: reg<amdgpu.sgpr>):
  %alias = low.assume %zero [range(%zero, 0, 1024)] : reg<amdgpu.vgpr>
  %initial = concat(%alias, %alias) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %continue = s_cmp_lt_i32 %index, %count
  low.cond_br %continue, ^enter, ^exit : reg<amdgpu.scc>
^enter:
  low.br ^inner(%index: reg<amdgpu.sgpr>, %alias: reg<amdgpu.vgpr>)
^inner(%inner_index: reg<amdgpu.sgpr>, %current: reg<amdgpu.vgpr>):
  %next_index = s_add_u32_rhs_inline %inner_index, 1
  %next = v_add_u32 %current, %increment
  %repeat = s_cmp_lt_i32 %next_index, %threshold
  low.cond_br %repeat, ^back, ^repack : reg<amdgpu.scc>
^back:
  low.br ^inner(%next_index: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>)
^repack:
  low.br ^pack(%next_index: reg<amdgpu.sgpr>)
^exit:
  low.br ^output(%initial: reg<amdgpu.vgpr x2>)
^output(%saved: reg<amdgpu.vgpr x2>):
  global_store_b64_saddr %address, %saved, %output
  return
}

// ----
  v_dual_mov_b32 v1, 1 :: v_dual_mov_b32 v4, 0
  s_mov_b32 s4, 0
.Lbb1:
  s_cmp_lt_i32 s4, s0
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb6
.Lbb2:
  v_mov_b32 v2, v4
.Lbb3:
  v_add_u32 v2, v2, v1
  s_add_u32 s4, s4, 1
  s_cmp_lt_i32 s4, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb5
.Lbb4:
  s_branch .Lbb3
.Lbb5:
  s_branch .Lbb1
.Lbb6:
  v_mov_b32 v3, v4
.Lbb7:
  global_store_b64 v0, v[3:4], s[2:3] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm
