// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @uniform_refined_offset_word(%address: offset) -> (i64, i64) {
  %bounded = index.assume %address [range(%address, 0, 4294967295)] : offset
  %word = index.cast %bounded : offset to i32
  %signed = scalar.extsi %word : i32 to i64
  %unsigned = scalar.extui %word : i32 to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_refined_offset_word(%bounded: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %word = slice %bounded[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = s_ashr_i32_rhs_inline %word, 31
  %signed = concat(%word, %11) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %13 = s_mov_b32 0
  %unsigned = concat(%word, %13) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %signed, %unsigned
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @uniform_refined_offset_wide(%address: offset) -> (i64) {
  %bounded = index.assume %address [range(%address, 0, 4294967295)] : offset
  %result = index.cast %bounded : offset to i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_refined_offset_wide(%result: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @varying_refined_offset_word(%values: vector<2xi64>) -> (i64, i64) {
  %raw = vector.extract %values[0] : vector<2xi64> -> i64
  %nonnegative = scalar.assume %raw [range(%raw, 0, 9223372036854775807)] : i64
  %address = index.cast %nonnegative : i64 to offset
  %bounded = index.assume %address [range(%address, 0, 4294967295)] : offset
  %word = index.cast %bounded : offset to i32
  %signed = scalar.extsi %word : i32 to i64
  %unsigned = scalar.extui %word : i32 to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @varying_refined_offset_word(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %word = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = v_ashrrev_i32_src0_inline %word, 31
  %signed = concat(%word, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %17 = v_mov_b32 0
  %unsigned = concat(%word, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %signed, %unsigned
}

