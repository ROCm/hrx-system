// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @varying_wide_address_i32(%values: vector<2xi64>) -> (i32) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %address_input = scalar.assume %value [range(%value, 0, 9223372036854775807)] : i64
  %address = index.cast %address_input : i64 to offset
  %result = index.cast %address : offset to i32
  func.return %result : i32
}

