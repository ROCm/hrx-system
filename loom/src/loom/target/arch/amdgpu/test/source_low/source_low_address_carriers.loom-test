low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @varying_wide_address_i32(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr>) asm {
  %result = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
