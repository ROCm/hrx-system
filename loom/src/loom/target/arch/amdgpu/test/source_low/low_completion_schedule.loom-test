// RUN: emit amdgpu-assembly @counter_tracked_effect_braid strategy=resource-stall

amdgpu.target<gfx1100> @target {subgroup_size = 32}

low.func.def target<amdgpu.rdna3.core>(@target) @counter_tracked_effect_braid(
    %address: reg<amdgpu.vgpr>,
    %rhs0: reg<amdgpu.vgpr x8>,
    %rhs1: reg<amdgpu.vgpr x8>,
    %acc0: reg<amdgpu.vgpr x8>,
    %acc1: reg<amdgpu.vgpr x8>,
    %next_payload: reg<amdgpu.vgpr x4>) ->
    (reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>) asm {
  %lhs0_low = ds_read_b128 %address
  %lhs0_high = ds_read_b128 %address {offset = 16}
  %lhs0 = concat(%lhs0_low, %lhs0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %next0 = v_wmma_f32_16x16x16_f16 %lhs0, %rhs0, %acc0
  %lhs1_low = ds_read_b128 %address {offset = 32}
  %lhs1_high = ds_read_b128 %address {offset = 48}
  %lhs1 = concat(%lhs1_low, %lhs1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %next1 = v_wmma_f32_16x16x16_f16 %lhs1, %rhs1, %acc1
  ds_write_b128 %address, %next_payload {offset = 1024}
  s_barrier
  return %next0, %next1
}

// The four reads make both WMMAs and the effect-dependent write ready. The
// emitted plan must consume only the oldest inputs, issue useful matrix work,
// and defer the conflicting write until the later full drain.
// ----
  ds_read_b128 v[40:43], v16 offset:0
  ds_read_b128 v[44:47], v16 offset:16
  ds_read_b128 v[48:51], v16 offset:32
  ds_read_b128 v[52:55], v16 offset:48
  s_waitcnt vmcnt(63) lgkmcnt(2)
  v_wmma_f32_16x16x16_f16 v[8:15], v[40:47], v[0:7], v[8:15]
  s_waitcnt vmcnt(63) lgkmcnt(0)
  ds_write_b128 v16, v[20:23] offset:1024
  v_wmma_f32_16x16x16_f16 v[32:39], v[48:55], v[24:31], v[32:39]
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_barrier
  s_endpgm
