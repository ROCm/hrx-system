low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @vector_rsqrt_precision(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %15 = v_mov_b32 1065353216
  %16 = v_sqrt_f32 %value
  %17, %18 = v_div_scale_f32 %16, %16, %15
  %19 = v_rcp_f32 %17
  %20 = v_fma_f32_neg_a_one %17, %19
  %21 = v_fma_f32 %20, %19, %19
  %22, %23 = v_div_scale_f32 %15, %16, %15
  %24 = v_mul_f32 %22, %21
  %25 = v_fma_f32_neg_a %17, %24, %22
  %26 = v_fma_f32 %25, %21, %24
  %27 = v_fma_f32_neg_a %17, %26, %22
  %28 = v_div_fmas_f32 %27, %21, %26, %23
  %exact = v_div_fixup_f32 %28, %16, %15
  %approximate = v_rsq_f32 %value
  return %exact, %approximate
}

