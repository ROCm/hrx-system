amdgpu.target<gfx11-generic> @target

func.def target(@target) @vector_rsqrt_precision(%input: f32) -> (f32, f32) {
  %value = vector.splat %input : vector<1xf32>
  %exact_values = vector.rsqrtf %value : vector<1xf32>
  %approximate_values = vector.rsqrtf<afn> %value : vector<1xf32>
  %exact = vector.extract %exact_values[0] : vector<1xf32> -> f32
  %approximate = vector.extract %approximate_values[0] : vector<1xf32> -> f32
  func.return %exact, %approximate : f32, f32
}

