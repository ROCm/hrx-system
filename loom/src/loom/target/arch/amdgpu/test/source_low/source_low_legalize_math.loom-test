  %21 = v_fma_f32_neg_a %13, %20, %18
  %22 = v_fma_f32 %21, %17, %20
  %23 = v_fma_f32_neg_a %13, %22, %18
  %24 = v_div_fmas_f32 %23, %17, %22, %19
  %exact = v_div_fixup_f32 %24, %12, %11
  %approximate = v_rsq_f32 %input
  return %exact, %approximate
}

