// The current AMDGPU source contract has no complete vector F64 arithmetic
// family: exact division and the refined exact square root are scalar-only.
func.def target(@target) @vector_f64_root_requires_complete_arithmetic(%input: vector<2xf64>) -> (vector<2xf64>) {
