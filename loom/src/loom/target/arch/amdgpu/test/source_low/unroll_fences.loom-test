// RUN: emit source-low output=low

// A fence inside an inline helper orders the carried add before each dependent
// ID-table lookup through the default source preparation and Low lowering.
amdgpu.target<gfx1151> @target

// Dependent lookup composed through two source helpers.
func.def inline @load_payload(%ids: view<8xi32>, %payloads: view<8xf32>, %row: index) -> (f32) {
  scf.schedule.fence
  %id = view.load %ids[%row] : view<8xi32> -> i32
  %index = index.cast %id : i32 to index
  %bounded = index.assume %index [range(%index, 0, 7)] : index
  %payload = view.load %payloads[%bounded] : view<8xf32> -> f32
  func.return %payload : f32
}

func.def inline @consume_and_lookup(%ids: view<8xi32>, %payloads: view<8xf32>, %row: index, %sum: f32, %bias: f32) -> (f32) {
  %consumed = scalar.addf %sum, %bias : f32
  %payload = func.call @load_payload(%ids, %payloads, %row) : (view<8xi32>, view<8xf32>, index) -> (f32)
  %next = scalar.addf %consumed, %payload : f32
  func.return %next : f32
}

kernel.def target(@target) @dependent_lookup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%ids_buffer: buffer, %payloads_buffer: buffer, %output_buffer: buffer, %initial: f32, %bias: f32) {
  %base = index.constant 0 : offset
  %ids_aligned = buffer.assume.alignment %ids_buffer {minimum_alignment = 4} : buffer
  %payloads_aligned = buffer.assume.alignment %payloads_buffer {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output_buffer {minimum_alignment = 4} : buffer
  %ids_storage, %payloads_storage, %output_storage = buffer.assume.noalias %ids_aligned, %payloads_aligned, %output_aligned : buffer, buffer, buffer
  %ids = buffer.view %ids_storage[%base] : buffer -> view<8xi32>
  %payloads = buffer.view %payloads_storage[%base] : buffer -> view<8xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<1xf32>
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(recurrence) {
    %next = func.call @consume_and_lookup(%ids, %payloads, %row, %sum, %bias) : (view<8xi32>, view<8xf32>, index, f32, f32) -> (f32)
    scf.yield %next : f32
  }
  view.store %result, %output[0] : f32, view<1xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "initial", arg1 = "bias"}, direct_arg_offsets = [24, 28], direct_arg_parameter_indices = [3, 4], direct_arg_sizes = [4, 4], parameter_count = 5, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @dependent_lookup(%initial: reg<amdgpu.sgpr>, %bias: reg<amdgpu.sgpr>) asm {
  %ids = resource<hal_binding> {extent = 32, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %payloads = resource<hal_binding> {extent = 32, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  low.schedule.fence
  %consumed = s_add_f32 %initial, %bias
  low.schedule.fence
  %60 = s_mov_b32 0
  %bounded = s_load_dword %ids, %60
  %62 = s_lshl_b32_rhs_inline %bounded, 2
  %payload = s_load_dword %payloads, %62
  %next = s_add_f32 %consumed, %payload
  low.schedule.fence
  %consumed_1 = s_add_f32 %next, %bias
  low.schedule.fence
  %bounded_1 = s_load_dword %ids, %60 {offset = 4}
  %68 = s_lshl_b32_rhs_inline %bounded_1, 2
  %payload_1 = s_load_dword %payloads, %68
  %next_1 = s_add_f32 %consumed_1, %payload_1
  %71 = v_mov_b32_copy %next_1
  %72 = v_mov_b32 0
  global_store_b32_saddr %72, %71, %output
  return
}
