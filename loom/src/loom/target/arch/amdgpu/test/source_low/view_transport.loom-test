// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @wide_subview_selection(%input: buffer, %byte_base0: offset, %condition: i1) -> (i32) {
  %byte_base = index.assume %byte_base0 [range(%byte_base0, 2147483648, 4294967296), multiple_of(%byte_base0, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %root = buffer.view %aligned[%byte_base] : buffer -> view<4xi32>
  %first = view.subview %root[1] : view<4xi32> -> view<1xi32>
  %second = view.subview %root[2] : view<4xi32> -> view<1xi32>
  %selected = scf.select %condition, %first, %second : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @wide_subview_selection(%byte_base: reg<amdgpu.vgpr x2>, %condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %selected = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = s_mov_b32 4
  %21 = v_mov_b32_copy %20
  %22 = v_mov_b32 0
  %24 = slice %byte_base[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %25 = slice %byte_base[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %28, %29 = v_add_co_u32 %24, %21
  %30, %31 = v_add_co_ci_u32 %25, %22, %29
  %33 = s_mov_b32 8
  %34 = v_mov_b32_copy %33
  %41, %42 = v_add_co_u32 %24, %34
  %43, %44 = v_add_co_ci_u32 %25, %22, %42
  %48 = v_cndmask_b32 %41, %28, %condition
  %51 = v_cndmask_b32 %43, %30, %condition
  %55 = slice %selected[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %56 = slice %selected[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %57, %58 = v_add_co_u32 %55, %48
  %59 = v_mov_b32_copy %56
  %60, %61 = v_add_co_ci_u32 %59, %51, %58
  %62 = concat(%57, %60) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %value = global_load_b32_vaddr %62
  return %value
}

// ====

func.def @distinct_root_selection(%first: buffer, %second: buffer, %condition: i1) -> (i32) {
  %first_offset = index.constant 4 : offset
  %second_offset = index.constant 8 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%first_offset] : buffer -> view<1xi32>
  %second_view = buffer.view %second_aligned[%second_offset] : buffer -> view<1xi32>
  %selected = scf.select %condition, %first_view, %second_view : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @distinct_root_selection(%condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %first_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %second_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %first_offset = s_mov_b32 4
  %second_offset = s_mov_b32 8
  %29, %30 = s_and_saveexec_b64 %condition
  low.cond_br %30, ^_bb1, ^_bb5 : reg<amdgpu.scc>
^_bb1:
  %43 = slice %first_aligned[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %44 = v_mov_b32_copy %43
  %45 = slice %first_aligned[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46 = v_mov_b32_copy %45
  %48 = v_mov_b32_copy %first_offset
  low.br ^_bb4(%44: reg<amdgpu.vgpr>, %46: reg<amdgpu.vgpr>, %48: reg<amdgpu.vgpr>)
^_bb4(%68: reg<amdgpu.vgpr>, %69: reg<amdgpu.vgpr>, %selected_offset$22: reg<amdgpu.vgpr>):
  %42 = s_andn2_b64_exec %29, %condition
  low.cond_br %42, ^_bb2, ^_bb6 : reg<amdgpu.scc>
^_bb2:
  %49 = slice %second_aligned[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %50 = v_mov_b32_copy %49
  %51 = slice %second_aligned[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %52 = v_mov_b32_copy %51
  %54 = v_mov_b32_copy %second_offset
  s_mov_b64_exec %29
  %36 = v_cndmask_b32 %50, %68, %condition
  %39 = v_cndmask_b32 %52, %69, %condition
  %41 = v_cndmask_b32 %54, %selected_offset$22, %condition
  low.br ^_bb3(%36: reg<amdgpu.vgpr>, %39: reg<amdgpu.vgpr>, %41: reg<amdgpu.vgpr>)
^_bb3(%64: reg<amdgpu.vgpr>, %65: reg<amdgpu.vgpr>, %selected_offset$20: reg<amdgpu.vgpr>):
  %57 = v_mov_b32 0
  %58, %59 = v_add_co_u32 %64, %selected_offset$20
  %60, %61 = v_add_co_ci_u32 %65, %57, %59
  %62 = concat(%58, %60) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %value = global_load_b32_vaddr %62
  return %value
^_bb5:
  s_mov_b64_exec %29
  %31 = v_mov_b32 0
  low.br ^_bb4(%31: reg<amdgpu.vgpr>, %31: reg<amdgpu.vgpr>, %31: reg<amdgpu.vgpr>)
^_bb6:
  s_mov_b64_exec %29
  low.br ^_bb3(%68: reg<amdgpu.vgpr>, %69: reg<amdgpu.vgpr>, %selected_offset$22: reg<amdgpu.vgpr>)
}

// ====

// Dynamic view refinements used only by memory accesses remain structural
// through nested control flow. Their source views need no target SSA storage.
func.def @nested_dynamic_view_refinement(%input: buffer, %extent_input: index, %position_input: index, %condition: i1) -> (i32) {
  %extent = index.assume %extent_input [range(%extent_input, 1, 128)] : index
  %position = index.assume %position_input [range(%position_input, 0, 127), lt(%position_input, %extent)] : index
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<[%extent]xi32>
  %result = scf.if %condition -> (i32) {
    %refined_extent = index.assume %extent [gt(%extent, 0)] : index
    %refined_view = view.refine %view : view<[%extent]xi32> -> view<[%refined_extent]xi32>
    %second_extent = index.assume %refined_extent [gt(%refined_extent, 0)] : index
    %second_view = view.refine %refined_view : view<[%refined_extent]xi32> -> view<[%second_extent]xi32>
    %value = view.load %second_view[%position] : view<[%second_extent]xi32> -> i32
    scf.yield %value : i32
  } else {
    %value = view.load %view[%position] : view<[%extent]xi32> -> i32
    scf.yield %value : i32
  }
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @nested_dynamic_view_refinement(%extent: reg<amdgpu.vgpr>, %position: reg<amdgpu.vgpr>, %condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %25 = v_lshlrev_b32_src0_inline %position, 2
  %26 = v_lshrrev_b32_src0_inline %position, 30
  %27 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29, %30 = v_add_co_u32 %27, %25
  %31 = v_mov_b32_copy %28
  %32, %33 = v_add_co_ci_u32 %31, %26, %30
  %34 = concat(%29, %32) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %result = global_load_b32_vaddr %34
  return %result
}
