^_bb4:
  low.br ^_bb5(%current1_offset: reg<amdgpu.sgpr>, %current2_offset: reg<amdgpu.sgpr>, %current3_offset: reg<amdgpu.sgpr>, %current0_offset: reg<amdgpu.sgpr>)
