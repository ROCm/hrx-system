low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @correlated_duplicate_rotation(%count: reg<amdgpu.sgpr>, %first_offset: reg<amdgpu.sgpr x2>, %second_offset: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %last_a_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %71 = slice %first_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %72 = slice %second_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %71: reg<amdgpu.sgpr>, %72: reg<amdgpu.sgpr>)
^_bb1(%i: reg<amdgpu.sgpr>, %a_offset: reg<amdgpu.sgpr>, %b_offset: reg<amdgpu.sgpr>):
  %73 = s_cmp_lt_i32 %i, %count
  low.cond_br %73, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %74 = s_add_u32 %i, %step
  low.br ^_bb1(%74: reg<amdgpu.sgpr>, %b_offset: reg<amdgpu.sgpr>, %a_offset: reg<amdgpu.sgpr>)
^_bb3:
  %75 = v_mov_b32 0
  %76 = slice %last_a_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %77 = slice %last_a_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %79, %80 = s_add_co_u32 %76, %a_offset
  %81, %82 = s_addc_u32 %77, %begin, %80
  %83 = concat(%79, %81) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %a_offset_value = global_load_b32_saddr %75, %83
  %89, %90 = s_add_co_u32 %76, %b_offset
  %91, %92 = s_addc_u32 %77, %begin, %90
  %93 = concat(%89, %91) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %b_offset_value = global_load_b32_saddr %75, %93
  %sum0 = v_add_u32 %a_offset_value, %a_offset_value
  %sum1 = v_add_u32 %sum0, %a_offset_value
  %sum2 = v_add_u32 %sum1, %b_offset_value
  %sum3 = v_add_u32 %sum2, %b_offset_value
  return %sum3
}

