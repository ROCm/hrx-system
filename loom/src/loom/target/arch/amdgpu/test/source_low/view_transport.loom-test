// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @wide_subview_selection(%input: buffer, %byte_base0: offset, %condition: i1) -> (i32) {
  %byte_base = index.assume %byte_base0 [range(%byte_base0, 2147483648, 4294967296), mul(%byte_base0, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %root = buffer.view %aligned[%byte_base] : buffer -> view<4xi32>
  %first = view.subview %root[1] : view<4xi32> -> view<1xi32>
  %second = view.subview %root[2] : view<4xi32> -> view<1xi32>
  %selected = scf.select %condition, %first, %second : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_subview_selection(%byte_base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %selected = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %24 = s_mov_b32 4
  %25 = s_mov_b32 0
  %27 = slice %byte_base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = slice %byte_base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = s_add_u32 %27, %24
  %32 = s_addc_u32 %28, %25
  %34 = s_mov_b32 8
  %41 = s_add_u32 %27, %34
  %42 = s_addc_u32 %28, %25
  %44 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %47 = s_cselect_b32 %31, %41, %44
  %50 = s_cselect_b32 %32, %42, %44
  %52 = v_mov_b32 0
  %53 = slice %selected[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = slice %selected[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %57 = s_add_u32 %53, %47
  %58 = s_addc_u32 %54, %50
  %59 = concat(%57, %58) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_b32_saddr %52, %59
  return %value
}

