low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @correlated_cfg_rotation(%select: reg<amdgpu.sgpr>, %again: reg<amdgpu.sgpr>, %left_offset: reg<amdgpu.sgpr x2>, %right_offset: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %23 = s_mov_b32 0
  %24 = s_cmp_lg_i32 %select, %23
  low.cond_br %24, ^left, ^right : reg<amdgpu.scc>
^left:
  %25 = slice %left_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^loop(%25: reg<amdgpu.sgpr>)
^right:
  %26 = slice %right_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^loop(%26: reg<amdgpu.sgpr>)
^loop(%offset: reg<amdgpu.sgpr>):
  %28 = s_cmp_lg_i32 %again, %23
  low.cond_br %28, ^body, ^exit : reg<amdgpu.scc>
^body:
  low.br ^loop(%offset: reg<amdgpu.sgpr>)
^exit:
  %29 = v_mov_b32 0
  %30 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33, %34 = s_add_co_u32 %30, %offset
  %35, %36 = s_addc_u32 %31, %23, %34
  %37 = concat(%33, %35) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_b32_saddr %29, %37
  %sum = v_add_u32 %value, %value
  return %sum
}
