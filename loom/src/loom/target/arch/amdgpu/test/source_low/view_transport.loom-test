low.func.def public target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @rotate_buffer_views(%count: reg<amdgpu.sgpr>, %seed: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %last0 = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %depth = s_mov_b32 4
  %108 = v_mov_b32_copy %seed
  %109 = v_mov_b32 0
  global_store_b32_saddr %109, %108, %last0
  %ordinal1 = s_mov_b32 1
  %initial1 = s_add_u32 %seed, %ordinal1
  %113 = v_mov_b32_copy %initial1
  global_store_b32_saddr %109, %113, %last0 {offset = 4}
  %offset2 = s_mov_b32 8
  %ordinal2 = s_mov_b32 2
  %initial2 = s_add_u32 %seed, %ordinal2
  %118 = v_mov_b32_copy %initial2
  global_store_b32_saddr %109, %118, %last0 {offset = 8}
  %offset3 = s_mov_b32 12
  %ordinal3 = s_mov_b32 3
  %initial3 = s_add_u32 %seed, %ordinal3
  %123 = v_mov_b32_copy %initial3
  global_store_b32_saddr %109, %123, %last0 {offset = 12}
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %begin: reg<amdgpu.sgpr>, %depth: reg<amdgpu.sgpr>, %offset2: reg<amdgpu.sgpr>, %offset3: reg<amdgpu.sgpr>)
^_bb1(%number: reg<amdgpu.sgpr>, %current0_offset: reg<amdgpu.sgpr>, %current1_offset: reg<amdgpu.sgpr>, %current2_offset: reg<amdgpu.sgpr>, %current3_offset: reg<amdgpu.sgpr>):
  %126 = s_cmp_lt_i32 %number, %count
  low.cond_br %126, ^_bb2, ^_bb6 : reg<amdgpu.scc>
^_bb2:
  %future = s_add_u32 %number, %depth
  %value = s_add_u32 %seed, %future
  %129 = v_mov_b32_copy %value
  %131 = slice %last0[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %132 = slice %last0[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %134 = s_add_u32 %131, %current0_offset
  %135 = s_addc_u32 %132, %begin
  %136 = concat(%134, %135) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %109, %129, %136
  %number_1 = s_add_u32 %number, %ordinal1
  %139 = s_cmp_lt_i32 %number_1, %count
  low.cond_br %139, ^_bb3, ^_bb4 : reg<amdgpu.scc>
^_bb3:
  %future_1 = s_add_u32 %number_1, %depth
  %value_1 = s_add_u32 %seed, %future_1
  %142 = v_mov_b32_copy %value_1
  %147 = s_add_u32 %131, %current1_offset
  %148 = s_addc_u32 %132, %begin
  %149 = concat(%147, %148) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %109, %142, %149
  low.br ^_bb5(%current2_offset: reg<amdgpu.sgpr>, %current3_offset: reg<amdgpu.sgpr>, %current0_offset: reg<amdgpu.sgpr>, %current1_offset: reg<amdgpu.sgpr>)
^_bb4:
  low.br ^_bb5(%current1_offset: reg<amdgpu.sgpr>, %current2_offset: reg<amdgpu.sgpr>, %current3_offset: reg<amdgpu.sgpr>, %current0_offset: reg<amdgpu.sgpr>)
^_bb5(%100: reg<amdgpu.sgpr>, %101: reg<amdgpu.sgpr>, %102: reg<amdgpu.sgpr>, %103: reg<amdgpu.sgpr>):
  %150 = s_add_u32 %number, %ordinal2
  low.br ^_bb1(%150: reg<amdgpu.sgpr>, %100: reg<amdgpu.sgpr>, %101: reg<amdgpu.sgpr>, %102: reg<amdgpu.sgpr>, %103: reg<amdgpu.sgpr>)
^_bb6:
  %152 = slice %last0[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %153 = slice %last0[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %155 = s_add_u32 %152, %current0_offset
  %156 = s_addc_u32 %153, %begin
  %157 = concat(%155, %156) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value0 = global_load_b32_saddr %109, %157
