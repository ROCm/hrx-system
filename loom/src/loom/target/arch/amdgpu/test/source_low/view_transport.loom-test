func.def @correlated_duplicate_rotation(%input: buffer, %count_input: index, %first_offset_input: offset, %second_offset_input: offset) -> (i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %first_offset = index.assume %first_offset_input [range(%first_offset_input, 0, 4092), mul(%first_offset_input, 4)] : offset
  %second_offset = index.assume %second_offset_input [range(%second_offset_input, 0, 4092), mul(%second_offset_input, 4)] : offset
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %first_view = buffer.view %storage[%first_offset] : buffer -> view<1xi32>
  %second_view = buffer.view %storage[%second_offset] : buffer -> view<1xi32>
  %last_a_offset, %last_a_view, %last_a_duplicate, %last_b_offset, %last_b_view = scf.for %i = [%begin to %count step %step](%a_offset = %first_offset : offset, %a_view = %first_view : view<1xi32>, %a_duplicate = %first_view : view<1xi32>, %b_offset = %second_offset : offset, %b_view = %second_view : view<1xi32>) -> (offset, view<1xi32>, view<1xi32>, offset, view<1xi32>) {
    scf.yield %b_offset, %b_view, %b_view, %a_offset, %a_view : offset, view<1xi32>, view<1xi32>, offset, view<1xi32>
  }
  %last_a_offset_view = buffer.view %storage[%last_a_offset] : buffer -> view<1xi32>
  %a_offset_value = view.load %last_a_offset_view[0] : view<1xi32> -> i32
  %a_view_value = view.load %last_a_view[0] : view<1xi32> -> i32
  %a_duplicate_value = view.load %last_a_duplicate[0] : view<1xi32> -> i32
  %last_b_offset_view = buffer.view %storage[%last_b_offset] : buffer -> view<1xi32>
  %b_offset_value = view.load %last_b_offset_view[0] : view<1xi32> -> i32
  %b_view_value = view.load %last_b_view[0] : view<1xi32> -> i32
  %sum0 = scalar.addi %a_offset_value, %a_view_value : i32
  %sum1 = scalar.addi %sum0, %a_duplicate_value : i32
  %sum2 = scalar.addi %sum1, %b_offset_value : i32
  %sum3 = scalar.addi %sum2, %b_view_value : i32
  func.return %sum3 : i32
}

