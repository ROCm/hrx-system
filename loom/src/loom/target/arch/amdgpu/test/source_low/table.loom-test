func.def @i8_table_lookup_masked_codes(%grid: vector<16xi8>, %packed: vector<4xi8>) -> (vector<4xi8>) {
  %mask = vector.splati 15 : vector<4xi8>
  %codes = vector.andi %packed, %mask : vector<4xi8>
  %decoded = vector.table.lookup %grid[%codes] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  func.return %decoded : vector<4xi8>
}

