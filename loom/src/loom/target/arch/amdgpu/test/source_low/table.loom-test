  %codes = global_load_b32_saddr %28, %codes_view
  %34 = v_and_b32_lit %codes, 255
  %35 = v_cmp_eq_i32_src1_inline %34 {rhs = 1}
  %36 = v_cndmask_b32_src1_lit %23, %35, 3204448256
  %37 = v_cmp_eq_i32_src1_inline %34 {rhs = 2}
  %38 = v_cndmask_b32_src1_lit %36, %37, 1056964608
  %39 = v_cmp_eq_i32_src1_inline %34 {rhs = 3}
  %40 = v_cndmask_b32_src1_lit %38, %39, 1069547520
  %41 = v_bfe_u32_offset_width_inline %codes {offset = 8, width = 8}
  %42 = v_cmp_eq_i32_src1_inline %41 {rhs = 1}
  %43 = v_cndmask_b32_src1_lit %23, %42, 3204448256
  %44 = v_cmp_eq_i32_src1_inline %41 {rhs = 2}
  %45 = v_cndmask_b32_src1_lit %43, %44, 1056964608
  %46 = v_cmp_eq_i32_src1_inline %41 {rhs = 3}
  %47 = v_cndmask_b32_src1_lit %45, %46, 1069547520
  %48 = v_bfe_u32_offset_width_inline %codes {offset = 16, width = 8}
  %49 = v_cmp_eq_i32_src1_inline %48 {rhs = 1}
  %50 = v_cndmask_b32_src1_lit %23, %49, 3204448256
  %51 = v_cmp_eq_i32_src1_inline %48 {rhs = 2}
  %52 = v_cndmask_b32_src1_lit %50, %51, 1056964608
  %53 = v_cmp_eq_i32_src1_inline %48 {rhs = 3}
  %54 = v_cndmask_b32_src1_lit %52, %53, 1069547520
  %55 = v_bfe_u32_offset_width_inline %codes {offset = 24, width = 8}
  %56 = v_cmp_eq_i32_src1_inline %55 {rhs = 1}
  %57 = v_cndmask_b32_src1_lit %23, %56, 3204448256
  %58 = v_cmp_eq_i32_src1_inline %55 {rhs = 2}
  %59 = v_cndmask_b32_src1_lit %57, %58, 1056964608
  %60 = v_cmp_eq_i32_src1_inline %55 {rhs = 3}
  %61 = v_cndmask_b32_src1_lit %59, %60, 1069547520
  %decoded = concat(%40, %47, %54, %61) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %63 = v_lshlrev_b32_src0_inline %lane, 4
  global_store_b128_saddr %63, %decoded, %output_view
  return
}

