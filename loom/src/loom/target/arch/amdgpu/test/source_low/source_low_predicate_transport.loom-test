// ====

amdgpu.target<gfx11-generic> @target

// Constants defined before divergence materialize the mask active at the edge.
func.def target(@target) @constant_predicates_across_divergence_wave32(%values: vector<2xi32>, %fallback: i1, %yes: f32, %no: f32) -> (f32, f32) {
  %enabled = scalar.constant true : i1
  %disabled = scalar.constant false : i1
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %limit = scalar.constant 8 : i32
  %condition = scalar.cmpi slt, %lane, %limit : i32
  cfg.cond_br %condition, ^then, ^else
^then:
  cfg.br ^join(%enabled: i1, %disabled: i1)
^else:
  cfg.br ^join(%fallback: i1, %fallback: i1)
^join(%positive: i1, %negative: i1):
  %first = scf.select %positive, %yes, %no : f32
  %second = scf.select %negative, %yes, %no : f32
  func.return %first, %second : f32, f32
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @constant_predicates_across_divergence_wave32(%values: reg<amdgpu.vgpr x2>, %fallback: reg<amdgpu.sgpr>, %yes: reg<amdgpu.vgpr>, %no: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %lane = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %condition = v_cmp_lt_i32_src1_inline %lane {rhs = 8}
