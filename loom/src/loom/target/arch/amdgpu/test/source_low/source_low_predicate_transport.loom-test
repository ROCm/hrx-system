amdgpu.target<gfx11-generic> @target {subgroup_size = 32}

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 4, direct_arg_count = 4, direct_arg_names = {arg0 = "selector", arg1 = "first_flag", arg2 = "second_flag", arg3 = "limit"}, direct_arg_offsets = [0, 4, 8, 12], direct_arg_parameter_indices = [0, 1, 2, 3], direct_arg_sizes = [4, 4, 4, 4], parameter_count = 5, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [4], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_predicate_queue(%selector: reg<amdgpu.sgpr>, %first_flag: reg<amdgpu.sgpr>, %second_flag: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) asm {
  %output_view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %29 = s_cmp_lg_i32 %selector, %begin
  %30 = s_mov_b32 0
  %31 = s_mov_b32 1
  %pick_first = s_cselect_b32 %31, %30, %29
  %first = s_cmp_lg_i32 %first_flag, %begin
  %second = s_cmp_lg_i32 %second_flag, %begin
  %35 = s_mov_b32 0
  %36 = s_mov_b32 1
  %37 = s_cselect_b32 %36, %35, %first
  %38 = s_mov_b32 0
  %39 = s_mov_b32 1
  %40 = s_cselect_b32 %39, %38, %second
  %41 = s_cmp_lg_i32_src1_inline %pick_first {rhs = 0}
  %selected = s_cselect_b32 %37, %40, %41
  %43 = s_mov_b32 0
  %44 = s_mov_b32 1
  %45 = s_cselect_b32 %44, %43, %first
  low.br ^loop(%begin: reg<amdgpu.sgpr>, %selected: reg<amdgpu.sgpr>, %45: reg<amdgpu.sgpr>)
^loop(%iteration: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr>):
  %again = s_cmp_lt_i32 %iteration, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %next = s_add_u32 %iteration, %step
  low.br ^loop(%next: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr>)
^exit:
  %48 = s_mov_b32 0
  %49 = s_cmp_lg_i32 %head, %48
  low.cond_br %49, ^enabled, ^disabled : reg<amdgpu.scc>
^enabled:
  %50 = v_mov_b32 1
  %51 = v_mov_b32 0
  global_store_b32_saddr %51, %50, %output_view
  return
^disabled:
  %52 = v_mov_b32 0
  %53 = v_mov_b32 0
  global_store_b32_saddr %53, %52, %output_view
  return
}

