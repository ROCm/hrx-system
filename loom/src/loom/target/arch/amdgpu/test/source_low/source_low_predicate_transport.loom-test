amdgpu.target<gfx942> @target

// Constants defined before divergence materialize the mask active at the edge.
func.def target(@target) @constant_predicates_across_divergence_wave64(%values: vector<2xi32>, %fallback: i1, %yes: f32, %no: f32) -> (f32, f32) {
  %enabled = scalar.constant true : i1
  %disabled = scalar.constant false : i1
  %lane = vector.extract %values[0] : vector<2xi32> -> i32
  %limit = scalar.constant 8 : i32
  %condition = scalar.cmpi slt, %lane, %limit : i32
  cfg.cond_br %condition, ^then, ^else
^then:
  cfg.br ^join(%enabled: i1, %disabled: i1)
^else:
  cfg.br ^join(%fallback: i1, %fallback: i1)
^join(%positive: i1, %negative: i1):
  %first = scf.select %positive, %yes, %no : f32
  %second = scf.select %negative, %yes, %no : f32
  func.return %first, %second : f32, f32
}

