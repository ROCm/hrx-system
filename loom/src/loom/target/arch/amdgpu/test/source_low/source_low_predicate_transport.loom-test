amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_predicate_queue(%selector: reg<amdgpu.sgpr>, %first_flag: reg<amdgpu.sgpr>, %second_flag: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) asm {
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %29 = s_cmp_lg_i32 %selector, %begin
  %30 = s_mov_b32 0
  %31 = s_mov_b32 1
  %pick_first = s_cselect_b32 %31, %30, %29
  %first = s_cmp_lg_i32 %first_flag, %begin
  %second = s_cmp_lg_i32 %second_flag, %begin
  %35 = s_cmp_lg_i32_src1_inline %pick_first {rhs = 0}
  %36 = s_mov_b64_exec_read
  %37 = slice %36[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = slice %36[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %39 = s_mov_b32 0
  %40 = s_cselect_b32 %37, %39, %first
  %41 = s_cselect_b32 %38, %39, %first
  %42 = concat(%40, %41) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %43 = s_mov_b64_exec_read
  %44 = slice %43[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = slice %43[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46 = s_mov_b32 0
  %47 = s_cselect_b32 %44, %46, %second
  %48 = s_cselect_b32 %45, %46, %second
  %49 = concat(%47, %48) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %50 = slice %42[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %51 = slice %49[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %52 = s_cselect_b32 %50, %51, %35
  %53 = slice %42[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = slice %49[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %55 = s_cselect_b32 %53, %54, %35
  %selected = concat(%52, %55) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %57 = s_mov_b32 0
  %58 = s_mov_b32 0
  %59 = concat(%57, %58) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %60 = s_cmp_lg_u64 %selected, %59
  %61 = s_mov_b32 0
  %62 = s_mov_b32 1
  %63 = s_cselect_b32 %62, %61, %60
  %64 = s_mov_b32 0
  %65 = s_mov_b32 1
  %66 = s_cselect_b32 %65, %64, %first
  low.br ^loop(%begin: reg<amdgpu.sgpr>, %63: reg<amdgpu.sgpr>, %66: reg<amdgpu.sgpr>)
^loop(%iteration: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr>):
  %again = s_cmp_lt_i32 %iteration, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %next = s_add_u32 %iteration, %step
  low.br ^loop(%next: reg<amdgpu.sgpr>, %tail: reg<amdgpu.sgpr>, %head: reg<amdgpu.sgpr>)
^exit:
  %69 = s_mov_b32 0
  %70 = s_cmp_lg_i32 %head, %69
  low.cond_br %70, ^enabled, ^disabled : reg<amdgpu.scc>
^enabled:
  %71 = v_mov_b32 1
  %72 = v_mov_b32 0
  global_store_b32_saddr %72, %71, %output_view
  return
^disabled:
  %73 = v_mov_b32 0
  %74 = v_mov_b32 0
  global_store_b32_saddr %74, %73, %output_view
  return
}
