// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @signed_rem20(%step: i32) -> (i32) {
  %c20 = scalar.constant 20 : i32
  %remainder = scalar.remsi %step, %c20 : i32
  func.return %remainder : i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @signed_rem20(%step: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %c20 = s_mov_b32 20
  %7 = s_mov_b32 31
  %8 = s_ashr_i32 %step, %7
  %9 = s_xor_b32 %step, %8
  %10 = s_sub_u32 %9, %8
  %11 = s_mov_b32 3435973837
  %12 = s_mul_hi_u32 %10, %11
  %13 = s_mov_b32 4
  %14 = s_lshr_b32 %12, %13
  %15 = s_mul_i32 %14, %c20
  %16 = s_sub_u32 %10, %15
  %17 = s_xor_b32 %16, %8
  %remainder = s_sub_u32 %17, %8
  return %remainder
}
