  %31 = slice %byte_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = s_load_dwordx4 %source_view, %31 {offset = 64}
  %33 = slice %32[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %34 = v_mov_b32_copy %33
  %35 = slice %32[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %36 = v_mov_b32_copy %35
  %37 = slice %32[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %38 = v_mov_b32_copy %37
  %39 = slice %32[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %40 = v_mov_b32_copy %39
  %41 = concat(%34, %36, %38, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
