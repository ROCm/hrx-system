  %58 = v_mov_b32_copy %57
  %59 = slice %52[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %60 = v_mov_b32_copy %59
  %61 = concat(%54, %56, %58, %60) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %62 = s_load_dwordx4 %source_view, %31 {offset = 112}
  %63 = slice %62[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %64 = v_mov_b32_copy %63
  %65 = slice %62[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %66 = v_mov_b32_copy %65
  %67 = slice %62[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %68 = v_mov_b32_copy %67
  %69 = slice %62[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %70 = v_mov_b32_copy %69
