  %44 = v_mov_b32_copy %43
  %45 = slice %42[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %46 = v_mov_b32_copy %45
  %47 = slice %42[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %48 = v_mov_b32_copy %47
  %49 = slice %42[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %50 = v_mov_b32_copy %49
