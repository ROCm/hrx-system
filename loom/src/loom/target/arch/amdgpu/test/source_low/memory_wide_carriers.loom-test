low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 4, direct_arg_count = 3, direct_arg_names = {arg0 = "base_input", arg1 = "position_input", arg2 = "value"}, direct_arg_offsets = [8, 16, 20], direct_arg_parameter_indices = [1, 2, 3], direct_arg_sizes = [8, 4, 4], parameter_count = 5, resource_count = 2, resource_offsets = [0, 24], resource_parameter_indices = [0, 4], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @exchange_signed_coordinate(%base: reg<amdgpu.sgpr x2>, %signed_position: reg<amdgpu.sgpr>, %value: reg<amdgpu.sgpr>) asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_0 = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %23 = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = s_lshl_b32_rhs_inline %signed_position, 2
  %25 = s_add_u32 %23, %24
  %previous = s_load_dword %view, %25 {offset = 48}
  %27 = v_mov_b32_copy %value
  %28 = v_mov_b32 0
  %32 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = s_mov_b32 0
  %35, %36 = s_add_co_u32 %32, %25
  %37, %38 = s_addc_u32 %33, %34, %36
  %39 = concat(%35, %37) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %28, %27, %39 {offset = 48}
  %40 = v_mov_b32_copy %previous
  global_store_b32_saddr %28, %40, %result_view_0
  return
}
