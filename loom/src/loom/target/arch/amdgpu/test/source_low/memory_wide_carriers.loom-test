  %52 = s_load_dwordx4 %source_view, %31 {offset = 96}
  %53 = slice %52[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %54 = v_mov_b32_copy %53
  %55 = slice %52[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %56 = v_mov_b32_copy %55
