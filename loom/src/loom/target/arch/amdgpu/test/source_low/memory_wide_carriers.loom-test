kernel.def @exchange_wide_origin() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%buffer: buffer, %base_input: i64, %position_input: index, %value: i32, %result_buffer_0: buffer) {
  %result_base = index.constant 0 : offset
  %result_view_0 = buffer.view %result_buffer_0[%result_base] : buffer -> view<1xi32>
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %wide_base = scalar.assume %base_input [range(%base_input, 0, 128), multiple_of(%base_input, 8)] : i64
  %base = index.cast %wide_base : i64 to offset
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  view.store %previous, %result_view_0[0] : i32, view<1xi32>
  kernel.return
}

