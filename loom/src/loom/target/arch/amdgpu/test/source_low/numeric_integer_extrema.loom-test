// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @integer_extrema_i32(%lhs: i32, %rhs: i32) -> (i32, i32, i32, i32) {
  %signed_min = scalar.minsi %lhs, %rhs : i32
  %signed_max = scalar.maxsi %lhs, %rhs : i32
  %unsigned_min = scalar.minui %lhs, %rhs : i32
  %unsigned_max = scalar.maxui %lhs, %rhs : i32
  func.return %signed_min, %signed_max, %unsigned_min, %unsigned_max : i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @integer_extrema_i32(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %signed_min = s_min_i32 %lhs, %rhs
  %signed_max = s_max_i32 %lhs, %rhs
  %unsigned_min = s_min_u32 %lhs, %rhs
  %unsigned_max = s_max_u32 %lhs, %rhs
  return %signed_min, %signed_max, %unsigned_min, %unsigned_max
}

// ====

func.def @integer_extrema_i64(%lhs: i64, %rhs: i64) -> (i64, i64, i64, i64) {
  %signed_min = scalar.minsi %lhs, %rhs : i64
  %signed_max = scalar.maxsi %lhs, %rhs : i64
  %unsigned_min = scalar.minui %lhs, %rhs : i64
  %unsigned_max = scalar.maxui %lhs, %rhs : i64
  func.return %signed_min, %signed_max, %unsigned_min, %unsigned_max : i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @integer_extrema_i64(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %24 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %26 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = s_xor_b32_lit %25, 2147483648
  %29 = s_xor_b32_lit %27, 2147483648
  %30 = s_cmp_lt_u32 %24, %26
  %31, %32 = s_subb_u32 %28, %29, %30
  %35 = s_cselect_b32 %24, %26, %32
  %38 = s_cselect_b32 %25, %27, %32
  %signed_min = concat(%35, %38) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %44 = s_xor_b32_lit %25, 2147483648
  %45 = s_xor_b32_lit %27, 2147483648
  %46 = s_cmp_gt_u32 %24, %26
  %47, %48 = s_subb_u32 %45, %44, %46
  %51 = s_cselect_b32 %24, %26, %48
  %54 = s_cselect_b32 %25, %27, %48
  %signed_max = concat(%51, %54) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %60 = s_cmp_lt_u32 %24, %26
  %61, %62 = s_subb_u32 %25, %27, %60
  %65 = s_cselect_b32 %24, %26, %62
  %68 = s_cselect_b32 %25, %27, %62
  %unsigned_min = concat(%65, %68) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %74 = s_cmp_gt_u32 %24, %26
  %75, %76 = s_subb_u32 %27, %25, %74
  %79 = s_cselect_b32 %24, %26, %76
  %82 = s_cselect_b32 %25, %27, %76
  %unsigned_max = concat(%79, %82) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %signed_min, %signed_max, %unsigned_min, %unsigned_max
}
