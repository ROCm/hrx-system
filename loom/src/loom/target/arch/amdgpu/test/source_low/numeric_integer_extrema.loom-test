// RUN: emit source-low target=amdgpu:gfx1151 output=low

kernel.def @integer_extrema_i32() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs: i32, %rhs: i32, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<4x64xi32>
  %signed_min = scalar.minsi %lhs, %rhs : i32
  %signed_max = scalar.maxsi %lhs, %rhs : i32
  %unsigned_min = scalar.minui %lhs, %rhs : i32
  %unsigned_max = scalar.maxui %lhs, %rhs : i32
  view.store %signed_min, %captured[0, %capture_lane] : i32, view<4x64xi32>
  view.store %signed_max, %captured[1, %capture_lane] : i32, view<4x64xi32>
  view.store %unsigned_min, %captured[2, %capture_lane] : i32, view<4x64xi32>
  view.store %unsigned_max, %captured[3, %capture_lane] : i32, view<4x64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs", arg1 = "rhs"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @integer_extrema_i32(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %signed_min = s_min_i32 %lhs, %rhs
  %signed_max = s_max_i32 %lhs, %rhs
  %unsigned_min = s_min_u32 %lhs, %rhs
  %unsigned_max = s_max_u32 %lhs, %rhs
  %27 = v_mov_b32_copy %signed_min
  %28 = v_lshlrev_b32_src0_inline %capture_lane, 2
  global_store_b32_saddr %28, %27, %captured
  %29 = v_mov_b32_copy %signed_max
  global_store_b32_saddr %28, %29, %captured {offset = 256}
  %31 = v_mov_b32_copy %unsigned_min
  global_store_b32_saddr %28, %31, %captured {offset = 512}
  %33 = v_mov_b32_copy %unsigned_max
  global_store_b32_saddr %28, %33, %captured {offset = 768}
  return
}

