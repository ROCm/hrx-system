// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @integer_extrema_i32(%lhs: i32, %rhs: i32) -> (i32, i32, i32, i32) {
  %signed_min = scalar.minsi %lhs, %rhs : i32
  %signed_max = scalar.maxsi %lhs, %rhs : i32
  %unsigned_min = scalar.minui %lhs, %rhs : i32
  %unsigned_max = scalar.maxui %lhs, %rhs : i32
  func.return %signed_min, %signed_max, %unsigned_min, %unsigned_max : i32, i32, i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @integer_extrema_i32(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %signed_min = v_min_i32 %lhs, %rhs
  %signed_max = v_max_i32 %lhs, %rhs
  %unsigned_min = v_min_u32 %lhs, %rhs
  %unsigned_max = v_max_u32 %lhs, %rhs
  return %signed_min, %signed_max, %unsigned_min, %unsigned_max
}

// ====

func.def @integer_extrema_i64(%lhs: i64, %rhs: i64) -> (i64, i64, i64, i64) {
  %signed_min = scalar.minsi %lhs, %rhs : i64
  %signed_max = scalar.maxsi %lhs, %rhs : i64
  %unsigned_min = scalar.minui %lhs, %rhs : i64
  %unsigned_max = scalar.maxui %lhs, %rhs : i64
  func.return %signed_min, %signed_max, %unsigned_min, %unsigned_max : i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @integer_extrema_i64(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %24 = v_cmp_lt_i64 %lhs, %rhs
  %25 = slice %lhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %26 = slice %rhs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %27 = v_cndmask_b32 %26, %25, %24
  %28 = slice %lhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %29 = slice %rhs[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %30 = v_cndmask_b32 %29, %28, %24
  %signed_min = concat(%27, %30) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %32 = v_cmp_gt_i64 %lhs, %rhs
  %35 = v_cndmask_b32 %26, %25, %32
  %38 = v_cndmask_b32 %29, %28, %32
  %signed_max = concat(%35, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %40 = v_cmp_lt_u64 %lhs, %rhs
  %43 = v_cndmask_b32 %26, %25, %40
  %46 = v_cndmask_b32 %29, %28, %40
  %unsigned_min = concat(%43, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %48 = v_cmp_gt_u64 %lhs, %rhs
  %51 = v_cndmask_b32 %26, %25, %48
  %54 = v_cndmask_b32 %29, %28, %48
  %unsigned_max = concat(%51, %54) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %signed_min, %signed_max, %unsigned_min, %unsigned_max
}
