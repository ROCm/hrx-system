  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<4x64xi64>
  %signed_min = scalar.minsi %lhs, %rhs : i64
  %signed_max = scalar.maxsi %lhs, %rhs : i64
  %unsigned_min = scalar.minui %lhs, %rhs : i64
  %unsigned_max = scalar.maxui %lhs, %rhs : i64
  view.store %signed_min, %captured[0, %capture_lane] : i64, view<4x64xi64>
  view.store %signed_max, %captured[1, %capture_lane] : i64, view<4x64xi64>
  view.store %unsigned_min, %captured[2, %capture_lane] : i64, view<4x64xi64>
  view.store %unsigned_max, %captured[3, %capture_lane] : i64, view<4x64xi64>
