// RUN: emit source-low target=amdgpu:gfx942 output=low

// Uniform f64 values retain SGPR storage until a packet requires a VGPR source.
kernel.def @float64_uniform_add() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs_bits: i64, %rhs_bits: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xf64>
  %lhs = scalar.bitcast %lhs_bits : i64 to f64
  %rhs = scalar.bitcast %rhs_bits : i64 to f64
  %sum = scalar.addf %lhs, %rhs : f64
  view.store %sum, %result_view_0[%fixture_lane] : f64, view<64xf64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 4, direct_arg_count = 2, direct_arg_names = {arg0 = "lhs_bits", arg1 = "rhs_bits"}, direct_arg_offsets = [0, 8], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [8, 8], parameter_count = 3, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @float64_uniform_add(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %15 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = v_mov_b32_copy %15
  %17 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %17
  %19 = concat(%16, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %sum = v_add_f64 %lhs, %19
  %21 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_dwordx2_saddr %21, %sum, %result_view_0
  return
}
