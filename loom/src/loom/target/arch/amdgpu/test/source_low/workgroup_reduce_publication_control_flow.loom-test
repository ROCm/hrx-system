// RUN: pass scf-to-cfg,cfg-simplify,source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// Every path to the result use crosses the workitem-zero edge. Arbitrary
// diamonds and cycles after that edge preserve leader-only publication.
kernel.def target(@target) @workgroup_reduce_leader_cfg_cycle() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %flags: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %leader_index = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %loop_end = index.constant 4 : index
  %c0 = scalar.constant 0 : i32
  %input_view = buffer.view %input[%start] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<1xf32>
  %flags_view = buffer.view %flags[%start] : buffer -> view<1xi32>
  %value = view.load %input_view[%tid] : view<64xf32> -> f32
  %sum = kernel.workgroup.reduce<addf> %value : f32
  %flag = view.load %flags_view[%leader_index] : view<1xi32> -> i32
  %condition = scalar.cmpi ne, %flag, %c0 : i32
  %is_leader = index.cmp eq, %tid, %leader_index : index
  scf.if %is_leader {
    scf.for %iteration = [%leader_index to %loop_end step %loop_step] {
      scf.if %condition {
        view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
      } else {
        view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
      }
    }
  }
  kernel.return
}

// ----
amdgpu.target<gfx11-generic> @target

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @workgroup_reduce_leader_cfg_cycle() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %flags_view = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %leader_index = s_mov_b32 0
  %loop_step = s_mov_b32 1
  %c0 = s_mov_b32 0
  %32 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %32, %input_view
  %34 = v_and_b32_src0_inline %tid, 31
  %35 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %36 = storage_address %35 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %37 = v_add_f32_dpp16 %value, %value {dpp_ctrl = 177}
  %38 = v_add_f32_dpp16 %37, %37 {dpp_ctrl = 78}
  %39 = v_add_f32_dpp16 %38, %38 {dpp_ctrl = 321}
  %40 = v_add_f32_dpp16 %39, %39 {dpp_ctrl = 320}
  %41 = v_permlanex16_b32_src12_inline %40, 0, 0
  %42 = v_add_f32 %40, %41
  %43 = v_lshrrev_b32_src0_inline %tid, 5
  %44 = v_lshlrev_b32_src0_inline %43, 2
  %45 = v_mov_b32 1
  %46 = v_cmp_lt_u32 %34, %45
  %47, %48 = s_and_saveexec_b64 %46
  %49 = v_add_u32 %36, %44
  ds_write_b32 %49, %42
  s_mov_b64_exec %47
  s_barrier
  %50 = v_mov_b32 2
  %51 = v_cmp_lt_u32 %tid, %50
  %52, %53 = s_and_saveexec_b64 %51
  %54 = v_lshlrev_b32_src0_inline %34, 2
  %55 = v_add_u32 %36, %54
  %56 = ds_read_b32 %55
  %sum = v_add_f32_dpp16 %56, %56 {dpp_ctrl = 177}
  s_mov_b64_exec %52
  s_barrier
  %58 = s_mov_b32 0
  %flag = s_load_dword %flags_view, %58
  %60 = s_cmp_lg_i32 %flag, %c0
  %61 = s_mov_b32 0
  %62 = s_mov_b32 1
  %condition = s_cselect_b32 %62, %61, %60
  %is_leader = v_cmp_eq_i32_src1_inline %tid {rhs = 0}
  %65, %66 = s_and_saveexec_b64 %is_leader
  low.cond_br %66, ^_bb1, ^_bb7 : reg<amdgpu.scc>
^_bb1:
  %67 = v_mov_b32_copy %leader_index
  low.br ^_bb2(%67: reg<amdgpu.vgpr>)
^_bb2(%iteration: reg<amdgpu.vgpr>):
  %68 = v_cmp_lt_i32_src1_inline %iteration {rhs = 4}
  %69 = s_mov_b64_exec_read
  %70, %71 = s_and_b64_scc %68, %69
  low.cond_br %71, ^_bb3, ^_bb7 : reg<amdgpu.scc>
^_bb3:
  %72 = s_mov_b32 0
  %73 = s_cmp_lg_i32 %condition, %72
  low.cond_br %73, ^_bb4, ^_bb5 : reg<amdgpu.scc>
^_bb4:
  %74 = v_mov_b32 0
  global_store_b32_saddr %74, %sum, %output_view
  low.br ^_bb6
^_bb5:
  %75 = v_mov_b32 0
  global_store_b32_saddr %75, %sum, %output_view
  low.br ^_bb6
^_bb6:
  %76 = v_add_u32 %loop_step, %iteration
  low.br ^_bb2(%76: reg<amdgpu.vgpr>)
^_bb7:
  s_mov_b64_exec %65
  low.br ^_bb8
^_bb8:
  return
}

// ====

amdgpu.target<gfx11-generic> @target

// The bypass reaches the result use without crossing the workitem-zero edge,
// so the reduction must publish its result for all workitems.
kernel.def target(@target) @workgroup_reduce_cfg_unguarded_bypass() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %flags: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %leader_index = index.constant 0 : index
  %c0 = scalar.constant 0 : i32
  %input_view = buffer.view %input[%start] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<1xf32>
  %flags_view = buffer.view %flags[%start] : buffer -> view<1xi32>
  %value = view.load %input_view[%tid] : view<64xf32> -> f32
  %sum = kernel.workgroup.reduce<addf> %value : f32
  %flag = view.load %flags_view[%leader_index] : view<1xi32> -> i32
  %condition = scalar.cmpi ne, %flag, %c0 : i32
  %is_leader = index.cmp eq, %tid, %leader_index : index
  scf.if %condition {
    scf.if %is_leader {
      view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
    }
  } else {
    view.store %sum, %output_view[%leader_index] : f32, view<1xf32>
  }
  kernel.return
}

// ----
amdgpu.target<gfx11-generic> @target

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @workgroup_reduce_cfg_unguarded_bypass() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %flags_view = resource<hal_binding> {extent = 4, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c0 = s_mov_b32 0
  %22 = v_lshlrev_b32_src0_inline %tid, 2
  %value = global_load_b32_saddr %22, %input_view
  %24 = v_and_b32_src0_inline %tid, 31
  %25 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %26 = storage_address %25 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %27 = v_add_f32_dpp16 %value, %value {dpp_ctrl = 177}
  %28 = v_add_f32_dpp16 %27, %27 {dpp_ctrl = 78}
  %29 = v_add_f32_dpp16 %28, %28 {dpp_ctrl = 321}
  %30 = v_add_f32_dpp16 %29, %29 {dpp_ctrl = 320}
  %31 = v_permlanex16_b32_src12_inline %30, 0, 0
  %32 = v_add_f32 %30, %31
  %33 = v_lshrrev_b32_src0_inline %tid, 5
  %34 = v_lshlrev_b32_src0_inline %33, 2
  %35 = v_mov_b32 1
  %36 = v_cmp_lt_u32 %24, %35
  %37, %38 = s_and_saveexec_b64 %36
  %39 = v_add_u32 %26, %34
  ds_write_b32 %39, %32
  s_mov_b64_exec %37
  s_barrier
  %40 = v_mov_b32 2
  %41 = v_cmp_lt_u32 %24, %40
  %42, %43 = s_and_saveexec_b64 %41
  %44 = v_lshlrev_b32_src0_inline %24, 2
  %45 = v_add_u32 %26, %44
  %46 = ds_read_b32 %45
  %47 = v_add_f32_dpp16 %46, %46 {dpp_ctrl = 177}
  s_mov_b64_exec %42
  %48 = v_mov_b32 0
  %sum = ds_bpermute_b32 %48, %47
  s_barrier
  %50 = s_mov_b32 0
  %flag = s_load_dword %flags_view, %50
  %condition = s_cmp_lg_i32 %flag, %c0
  %is_leader = v_cmp_eq_i32_src1_inline %tid {rhs = 0}
  low.cond_br %condition, ^_bb1, ^_bb3 : reg<amdgpu.scc>
^_bb1:
  %54, %55 = s_and_saveexec_b64 %is_leader
  low.cond_br %55, ^_bb2, ^_bb4 : reg<amdgpu.scc>
^_bb2:
  %56 = v_mov_b32 0
  global_store_b32_saddr %56, %sum, %output_view
  low.br ^_bb4
^_bb3:
  %57 = v_mov_b32 0
  global_store_b32_saddr %57, %sum, %output_view
  low.br ^_bb5
^_bb4:
  s_mov_b64_exec %54
  low.br ^_bb5
^_bb5:
  return
}
