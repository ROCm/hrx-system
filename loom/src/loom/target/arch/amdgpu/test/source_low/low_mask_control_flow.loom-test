low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @loop_mask_reset(%initial: reg<amdgpu.sgpr x2>, %uniform: reg<amdgpu.sgpr>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  low.br ^loop(%initial: reg<amdgpu.sgpr x2>)
^loop(%carried: reg<amdgpu.sgpr x2>):
  %selected = v_cndmask_b32 %lhs, %rhs, %carried
  %broadcast = v_mov_b32_copy %uniform
  %next = v_cmp_lt_i32 %selected, %rhs
  low.br ^loop(%next: reg<amdgpu.sgpr x2>)
