// ====

// A copied mask can retain a previous iteration's read. Its permuted backedge
// requires real register moves, not a forced identity or scratch spill.
// RUN: emit amdgpu-assembly @copied_mask_loop strategy=source

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @copied_mask_loop(%value: reg<amdgpu.vgpr>, %seed: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop(%seed: reg<amdgpu.sgpr x2>)
^loop(%entry: reg<amdgpu.sgpr x2>):
  %current = copy %entry : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %alias = low.assume %current [range(%entry, 0, 1024)] : reg<amdgpu.sgpr x2>
  %first = slice %alias[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %swapped = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  low.br ^loop(%swapped: reg<amdgpu.sgpr x2>)
}

