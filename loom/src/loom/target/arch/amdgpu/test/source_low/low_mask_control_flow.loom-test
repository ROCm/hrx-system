  v_cmp_lt_i32 s[4:5], v2, v1
  v_mov_b32_copy v2, s2
  s_delay_alu instid0(VALU_DEP_2)
  s_mov_b32 s0, s4
  s_mov_b32 s1, s5
  s_branch .Lbb1

