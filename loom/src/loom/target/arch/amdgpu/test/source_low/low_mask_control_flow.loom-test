// ====

// A contradiction within the loop's copy component must not remove write
// exclusions against the independent mask retained by the other branch.
// RUN: emit amdgpu-assembly @copied_mask_branch strategy=source

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @copied_mask_branch(%condition: reg<amdgpu.scc>, %value: reg<amdgpu.vgpr>, %seed: reg<amdgpu.sgpr x2>, %other: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop(%seed: reg<amdgpu.sgpr x2>)
^loop(%entry: reg<amdgpu.sgpr x2>):
  %current = copy %entry : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %first = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %swapped = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.cond_br %condition, ^left, ^right : reg<amdgpu.scc>
^left:
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  low.br ^latch
^right:
  %other_selected = v_cndmask_b32_src0_inline %value, %other {false_value = 0}
  low.br ^latch
^latch:
  low.br ^loop(%swapped: reg<amdgpu.sgpr x2>)
}

