// ====

// Either path can retain a distinct mask while a wider structural copy chain
// aliases its source. Each copy keeps both possible masks protected across
// repeated placement choices, including the subsequent scalar write.
// RUN: emit amdgpu-assembly @branch_retained_copy strategy=source fixed=%left_mask:physical_register:0:2 fixed=%right_mask:physical_register:2:2 fixed=%source:physical_register:4:4 fixed=%scalar:physical_register:8:1

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @branch_retained_copy(%condition: reg<amdgpu.scc>, %value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x4>, %scalar: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x4>, reg<amdgpu.sgpr>) asm {
  low.cond_br %condition, ^left, ^right : reg<amdgpu.scc>
^left:
  %left_mask = v_cmp_eq_i32 %value, %value
  %left_selected = v_cndmask_b32 %value, %value, %left_mask
  low.br ^join
^right:
  %right_mask = v_cmp_eq_i32 %value, %value
  %right_selected = v_cndmask_b32 %value, %value, %right_mask
  low.br ^join
^join:
  %first_copy = copy %source : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x4>
  %second_copy = copy %first_copy : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x4>
  %copied = copy %second_copy : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x4>
  %result = s_or_b32 %scalar, %scalar
  return %copied, %result
}

// ----
  s_cbranch_scc0 .Lbb2
.Lbb1:
  v_cmp_eq_i32 s[0:1], v0, v0
  s_delay_alu instid0(VALU_DEP_1)
  v_cndmask_b32 v0, v0, v0, s[0:1]
  s_branch .Lbb3
.Lbb2:
  v_cmp_eq_i32 s[2:3], v0, v0
  s_delay_alu instid0(VALU_DEP_1)
  v_cndmask_b32 v0, v0, v0, s[2:3]
.Lbb3:
  s_or_b32 s8, s8, s8
  s_endpgm

