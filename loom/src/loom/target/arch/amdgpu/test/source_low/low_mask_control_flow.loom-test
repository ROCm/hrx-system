^loop(%carried: reg<amdgpu.sgpr x2>):
  %selected = v_cndmask_b32 %lhs, %rhs, %carried
  %next = v_cmp_lt_i32 %selected, %rhs
  %broadcast = v_mov_b32_copy %uniform
  low.br ^loop(%next: reg<amdgpu.sgpr x2>)
}

