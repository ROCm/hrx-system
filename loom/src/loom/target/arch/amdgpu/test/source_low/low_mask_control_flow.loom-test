  s_branch .Lbb1

// ====

// A scalar VALU read closes that window before the next iteration's write.
// RUN: emit amdgpu-assembly @reset_mask_backedge strategy=source

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reset_mask_backedge(%source: reg<amdgpu.sgpr x2>, %value: reg<amdgpu.vgpr>) asm {
  low.br ^overwrite
^overwrite:
  %result = s_or_b64 %source, %source
  low.br ^retain
^retain:
  %mask = v_cmp_eq_i32 %value, %value
  %selected = v_cndmask_b32 %value, %value, %mask
  low.br ^reset
^reset:
  %source_word = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %broadcast = v_mov_b32_copy %source_word
  low.br ^overwrite
}

