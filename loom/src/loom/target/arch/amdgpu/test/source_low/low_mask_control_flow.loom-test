// ====

// A reset in one arm cannot retire the mask retained by the other arm.
// RUN: with-checks emit low-allocation-json @branch_retains_mask

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @branch_retains_mask(%condition: reg<amdgpu.scc>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>) asm {
  low.scf.if %condition {
    %selected = v_cndmask_b32 %value, %value, %mask
  } else {
    %broadcast = v_mov_b32_copy %source
  }
  %result = s_or_b32 %source, %source
  return %result
}

// ----
CHECK: *"name":"result","type":"reg<amdgpu.sgpr>"*,"location":{"kind":"physical_register","base":2,"count":1}*

// ====

// The mask is dead in SSA before the backedge, but its physical read survives
// to the scalar write at the start of the next iteration.
// RUN: with-checks emit low-allocation-json @backedge_retains_mask

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @backedge_retains_mask(%lower: reg<amdgpu.sgpr>, %upper: reg<amdgpu.sgpr>, %step: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  low.scf.for signed [%lower to %upper step %step] do(%iteration: reg<amdgpu.sgpr>) {
    %scratch = s_mov_b64_exec_read
    %mask = v_cmp_eq_i32 %value, %value
    %selected = v_cndmask_b32 %value, %value, %mask
  }
  return
}

// ----
CHECK: *"name":"scratch","type":"reg<amdgpu.sgpr x2>"*,"location":{"kind":"physical_register","base":4,"count":2}*
CHECK: *"name":"mask","type":"reg<amdgpu.sgpr x2>"*,"location":{"kind":"physical_register","base":6,"count":2}*

// ====

// A body read survives to the before-region write on the next iteration.
// RUN: with-checks emit low-allocation-json @condition_retains_mask

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @condition_retains_mask(%condition: reg<amdgpu.scc>, %value: reg<amdgpu.vgpr>) asm {
  low.scf.while {
    %scratch = s_mov_b64_exec_read
    low.scf.condition %condition : reg<amdgpu.scc>
  } do {
    %mask = v_cmp_eq_i32 %value, %value
    %selected = v_cndmask_b32 %value, %value, %mask
    low.scf.yield
  }
  return
}

// ----
CHECK: *"name":"scratch","type":"reg<amdgpu.sgpr x2>"*,"location":{"kind":"physical_register","base":0,"count":2}*
CHECK: *"name":"mask","type":"reg<amdgpu.sgpr x2>"*,"location":{"kind":"physical_register","base":2,"count":2}*

// ====

// The local mask is dead in SSA, but its read crosses the backedge to the write.
// Redefining the mask needs a dependency; the independent scalar result
// must still stay outside the retained pair.
// RUN: emit amdgpu-assembly @local_mask_backedge strategy=source

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @local_mask_backedge(%source: reg<amdgpu.sgpr x2>, %value: reg<amdgpu.vgpr>) asm {
  low.br ^overwrite
^overwrite:
  %result = s_or_b64 %source, %source
  low.br ^retain
^retain:
  %mask = v_cmp_eq_i32 %value, %value
  %selected = v_cndmask_b32 %value, %value, %mask
  low.br ^bridge
^bridge:
  low.br ^overwrite
}

