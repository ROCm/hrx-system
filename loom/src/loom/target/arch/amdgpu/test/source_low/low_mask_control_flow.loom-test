// ====

// Required aliases keep the input storage live through the final mask read.
// RUN: emit amdgpu-assembly @retained_alias strategy=source amdgpu.sgpr=4 fixed=%current:physical_register:0:2 fixed=%next:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @retained_alias(%value: reg<amdgpu.vgpr>, %current: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %first_alias = low.assume %current [range(%current, 0, 1024)] : reg<amdgpu.sgpr x2>
  %second_alias = low.assume %first_alias [range(%first_alias, 0, 1024)] : reg<amdgpu.sgpr x2>
  %alias = low.assume %second_alias [range(%second_alias, 0, 1024)] : reg<amdgpu.sgpr x2>
  %first = slice %alias[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %alias[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %swapped = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %alias {false_value = 0}
  low.br ^exit(%swapped: reg<amdgpu.sgpr x2>)
^exit(%next: reg<amdgpu.sgpr x2>):
  return %next
}

