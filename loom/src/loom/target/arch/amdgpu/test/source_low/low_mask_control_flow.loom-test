low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @retained_without_writes(%mask: reg<amdgpu.sgpr x2>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %selected = v_cndmask_b32 %value, %value, %mask
  return %selected
}

