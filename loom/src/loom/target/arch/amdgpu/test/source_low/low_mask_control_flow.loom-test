// ====

// A longer copy chain has the same permutation conflict. The exit keeps the
// selected value observable, and no metadata reference is needed to trigger it.
// RUN: emit amdgpu-assembly @copied_mask_chain strategy=source

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @copied_mask_chain(%value: reg<amdgpu.vgpr>, %seed: reg<amdgpu.sgpr x2>, %repeat: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm {
  low.br ^loop(%seed: reg<amdgpu.sgpr x2>)
^loop(%entry: reg<amdgpu.sgpr x2>):
  %copied = copy %entry : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %current = copy %copied : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %first = slice %current[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %current[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %swapped = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  low.cond_br %repeat, ^latch, ^exit : reg<amdgpu.scc>
^latch:
  low.br ^loop(%swapped: reg<amdgpu.sgpr x2>)
^exit:
  return %selected
}

