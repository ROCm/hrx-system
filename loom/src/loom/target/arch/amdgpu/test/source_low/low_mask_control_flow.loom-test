  s_waitcnt_depctr 0xf19f
  s_delay_alu instid0(VALU_DEP_1)
  v_cndmask_b32 v1, v0, v0, s[0:1]
.Lbb3:
  s_branch .Lbb1

// ====

// A scalar VALU read closes that window before the next iteration's write.
// RUN: emit amdgpu-assembly @reset_mask_backedge strategy=source fixed=%mask:physical_register:0:2 fixed=%source:physical_register:4:1

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reset_mask_backedge(%source: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  low.br ^overwrite
^overwrite:
  %result = s_or_b32 %source, %source
  low.br ^retain
^retain:
  %mask = v_cmp_eq_i32 %value, %value
  %selected = v_cndmask_b32 %value, %value, %mask
  low.br ^reset
^reset:
  %broadcast = v_mov_b32_copy %source
  low.br ^overwrite
}

