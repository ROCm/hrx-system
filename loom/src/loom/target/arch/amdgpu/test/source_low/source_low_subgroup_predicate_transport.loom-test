  global_store_b32_saddr %146, %xor_valid_bits, %destination {offset = 12}
  %148 = v_bfe_u32_offset_width_inline %word {offset = 0, width = 1}
  %149 = v_and_b32_src0_inline %item, 31
  %150 = v_mov_b32 1
  %151 = v_sub_nc_u32 %149, %150
  %152 = v_and_b32_src0_inline %149, 15
