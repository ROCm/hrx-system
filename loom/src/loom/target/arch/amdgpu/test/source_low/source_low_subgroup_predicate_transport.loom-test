  %123 = v_lshlrev_b32_src0_inline %115, 2
  %124 = ds_bpermute_b32 %123, %112
  %indexed_bits = v_bfe_u32_offset_width_inline %124 {offset = 0, width = 1}
  %index_valid_bits = v_cndmask_b32_src0_lit_src1_inline %index_valid {imm32 = 0, true_value = 1}
  %129 = v_lshlrev_b32_src0_inline %item, 5
  global_store_b32_saddr %129, %indexed_bits, %destination
  global_store_b32_saddr %129, %index_valid_bits, %destination {offset = 4}
  %131 = v_bfe_u32_offset_width_inline %word {offset = 0, width = 1}
  %132 = v_and_b32_src0_inline %item, 31
  %133 = v_xor_b32_src0_inline %132, 1
