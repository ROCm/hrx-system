low.kernel.def target<amdgpu.cdna3.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @predicate_vector_transport() asm {
  %item = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {extent = 768, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 2304, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %56 = v_mov_b32 12
  %57 = v_mul_lo_u32 %item, %56
  %words = global_load_dwordx3_saddr %57, %source : reg<amdgpu.vgpr x3>
  %59 = slice %words[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %60 = v_and_b32_src0_inline %59, 1
  %61 = slice %words[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %62 = v_and_b32_src0_inline %61, 1
  %63 = slice %words[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %64 = v_and_b32_src0_inline %63, 1
  %66 = v_mov_b32 132
  %68 = ds_bpermute_b32 %66, %60
  %70 = ds_bpermute_b32 %66, %62
  %72 = ds_bpermute_b32 %66, %64
  %75 = v_and_b32_src0_inline %68, 1
  %77 = v_and_b32_src0_inline %70, 1
  %79 = v_and_b32_src0_inline %72, 1
  %named_bits = concat(%75, %77, %79) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %81 = v_mov_b32 36
  %82 = v_mul_lo_u32 %item, %81
  global_store_dwordx3_saddr %82, %named_bits, %destination
  %83 = v_xor_b32_src0_inline %item, 32
  %84 = v_lshlrev_b32_src0_inline %83, 2
  %86 = ds_bpermute_b32 %84, %60
  %88 = ds_bpermute_b32 %84, %62
  %90 = ds_bpermute_b32 %84, %64
  %93 = v_and_b32_src0_inline %86, 1
  %95 = v_and_b32_src0_inline %88, 1
  %97 = v_and_b32_src0_inline %90, 1
  %shuffled_bits = concat(%93, %95, %97) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %99 = v_mov_b32 36
  %100 = v_mul_lo_u32 %item, %99
  global_store_dwordx3_saddr %100, %shuffled_bits, %destination {offset = 12}
  %102 = v_readfirstlane_b32 %60
  %103 = v_mov_b32_copy %102
  %105 = v_readfirstlane_b32 %62
  %106 = v_mov_b32_copy %105
  %108 = v_readfirstlane_b32 %64
  %109 = v_mov_b32_copy %108
  %112 = v_and_b32_src0_inline %103, 1
  %114 = v_and_b32_src0_inline %106, 1
  %116 = v_and_b32_src0_inline %109, 1
  %first_bits = concat(%112, %114, %116) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %118 = v_mov_b32 36
  %119 = v_mul_lo_u32 %item, %118
  global_store_dwordx3_saddr %119, %first_bits, %destination {offset = 24}
  return
}

// ====

amdgpu.target<gfx1200> @target

// A seven-component predicate has no native packed-vector spelling. Its
// component order and tail survive the shape-preserving carrier conversion.
kernel.def target(@target) @predicate_wide_vector() {
  %c1 = index.constant 1 : index
  %items = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%items, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<32x7xi32>
  %destination = buffer.view %output[%base] : buffer -> view<32x7xi32>
  %words = vector.load %source[%item, 0] : view<32x7xi32> -> vector<7xi32>
  %predicate = vector.trunci %words : vector<7xi32> to vector<7xi1>
  %distance = scalar.constant 1 : i32
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<down> %predicate, %distance, %width : vector<7xi1>, i32, i32
  scf.if %valid {
    %bits = vector.extui %shuffled : vector<7xi1> to vector<7xi32>
    vector.store %bits, %destination[%item, 0] : vector<7xi32>, view<32x7xi32>
  }
  kernel.return
}

