  %valid = s_and_b64 %63, %56
  %65 = v_lshlrev_b32_src0_inline %54, 2
  %67 = ds_bpermute_b32 %65, %39
  %69 = ds_bpermute_b32 %65, %41
  %71 = ds_bpermute_b32 %65, %43
  %73 = ds_bpermute_b32 %65, %45
  %75 = ds_bpermute_b32 %65, %47
  %77 = ds_bpermute_b32 %65, %49
  %79 = ds_bpermute_b32 %65, %51
  %81, %82 = s_and_saveexec_b64 %valid
  low.cond_br %82, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
