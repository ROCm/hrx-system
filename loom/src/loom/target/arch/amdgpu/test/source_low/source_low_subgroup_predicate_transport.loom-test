// RUN: emit source-low output=low

amdgpu.target<gfx1151> @target

// All shuffle modes carry a varying predicate independently from source
// validity. The indexed mode uses a bounded runtime selector.
kernel.def target(@target) @predicate_shuffle_modes() {
  %c1 = index.constant 1 : index
  %items = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%items, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<64xi32>
  %destination = buffer.view %output[%base] : buffer -> view<64x8xi32>
  %word = view.load %source[%item] : view<64xi32> -> i32
  %predicate = scalar.trunci %word : i32 to i1
  %mask = scalar.constant 15 : i32
  %offset = scalar.andi %word, %mask : i32
  %width = scalar.constant 16 : i32
  %c1_i32 = scalar.constant 1 : i32
  %indexed, %index_valid = kernel.subgroup.shuffle<index> %predicate, %offset, %width : i1, i32, i32
  %indexed_bits = scalar.extui %indexed : i1 to i32
  %index_valid_bits = scalar.extui %index_valid : i1 to i32
  view.store %indexed_bits, %destination[%item, 0] : i32, view<64x8xi32>
  view.store %index_valid_bits, %destination[%item, 1] : i32, view<64x8xi32>
  %xored, %xor_valid = kernel.subgroup.shuffle<xor> %predicate, %c1_i32, %width : i1, i32, i32
  %xor_bits = scalar.extui %xored : i1 to i32
  %xor_valid_bits = scalar.extui %xor_valid : i1 to i32
  view.store %xor_bits, %destination[%item, 2] : i32, view<64x8xi32>
  view.store %xor_valid_bits, %destination[%item, 3] : i32, view<64x8xi32>
  %up, %up_valid = kernel.subgroup.shuffle<up> %predicate, %c1_i32, %width : i1, i32, i32
  %up_bits = scalar.extui %up : i1 to i32
  %up_valid_bits = scalar.extui %up_valid : i1 to i32
  view.store %up_bits, %destination[%item, 4] : i32, view<64x8xi32>
  view.store %up_valid_bits, %destination[%item, 5] : i32, view<64x8xi32>
  %down, %down_valid = kernel.subgroup.shuffle<down> %predicate, %c1_i32, %width : i1, i32, i32
  %down_bits = scalar.extui %down : i1 to i32
  %down_valid_bits = scalar.extui %down_valid : i1 to i32
  view.store %down_bits, %destination[%item, 6] : i32, view<64x8xi32>
  view.store %down_valid_bits, %destination[%item, 7] : i32, view<64x8xi32>
  kernel.return
}

