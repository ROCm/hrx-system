low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @predicate_shuffle_modes() asm {
  %item = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %source = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 2048, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %109 = v_lshlrev_b32_src0_inline %item, 2
  %word = global_load_b32_saddr %109, %source
  %offset = v_and_b32_src0_inline %word, 15
  %113 = v_bfe_u32_offset_width_inline %word {offset = 0, width = 1}
  %114 = v_and_b32_src0_inline %item, 31
  %115 = v_and_b32_lit %114, 4294967280
  %116 = v_or_b32 %115, %offset
  %117 = s_mov_b64_exec_read
  %118 = slice %117[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %119 = v_mov_b32_copy %118
  %120 = v_lshrrev_b32 %116, %119
  %121 = v_and_b32_src0_inline %120, 1
  %122 = v_mov_b32 0
  %index_valid = v_cmp_ne_i32 %121, %122
  %124 = v_lshlrev_b32_src0_inline %116, 2
  %125 = ds_bpermute_b32 %124, %113
  %indexed_bits = v_bfe_u32_offset_width_inline %125 {offset = 0, width = 1}
  %index_valid_bits = v_cndmask_b32_src0_lit_src1_inline %index_valid {imm32 = 0, true_value = 1}
  %129 = v_lshlrev_b32_src0_inline %item, 5
  global_store_b32_saddr %129, %indexed_bits, %destination
  global_store_b32_saddr %129, %index_valid_bits, %destination {offset = 4}
  %131 = v_and_b32_src0_inline %item, 31
  %132 = v_xor_b32_src0_inline %131, 1
  %133 = s_mov_b64_exec_read
  %134 = slice %133[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %135 = v_mov_b32_copy %134
  %136 = v_lshrrev_b32 %132, %135
  %137 = v_and_b32_src0_inline %136, 1
  %138 = v_mov_b32 0
  %xor_valid = v_cmp_ne_i32 %137, %138
  %140 = v_mov_b32_dpp16 %113 {dpp_ctrl = 177}
  %xor_bits = v_bfe_u32_offset_width_inline %140 {offset = 0, width = 1}
  %xor_valid_bits = v_cndmask_b32_src0_lit_src1_inline %xor_valid {imm32 = 0, true_value = 1}
  %143 = v_lshlrev_b32_src0_inline %item, 5
  global_store_b32_saddr %143, %xor_bits, %destination {offset = 8}
  global_store_b32_saddr %143, %xor_valid_bits, %destination {offset = 12}
  %145 = v_and_b32_src0_inline %item, 31
  %146 = v_mov_b32 1
  %147 = v_sub_nc_u32 %145, %146
  %148 = v_and_b32_src0_inline %145, 15
  %149 = v_cmp_ge_u32 %148, %146
  %150 = s_mov_b64_exec_read
  %151 = slice %150[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %152 = v_mov_b32_copy %151
  %153 = v_lshrrev_b32 %147, %152
  %154 = v_and_b32_src0_inline %153, 1
  %155 = v_mov_b32 0
  %156 = v_cmp_ne_i32 %154, %155
  %up_valid = s_and_b64 %156, %149
  %158 = v_lshlrev_b32_src0_inline %147, 2
  %159 = ds_bpermute_b32 %158, %113
  %up_bits = v_bfe_u32_offset_width_inline %159 {offset = 0, width = 1}
  %up_valid_bits = v_cndmask_b32_src0_lit_src1_inline %up_valid {imm32 = 0, true_value = 1}
  %162 = v_lshlrev_b32_src0_inline %item, 5
  global_store_b32_saddr %162, %up_bits, %destination {offset = 16}
  global_store_b32_saddr %162, %up_valid_bits, %destination {offset = 20}
  %164 = v_and_b32_src0_inline %item, 31
  %165 = v_mov_b32 1
  %166 = v_add_u32 %164, %165
  %167 = v_and_b32_src0_inline %164, 15
  %168 = v_add_u32 %167, %165
  %169 = v_mov_b32 16
  %170 = v_cmp_lt_u32 %168, %169
  %171 = s_mov_b64_exec_read
  %172 = slice %171[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %173 = v_mov_b32_copy %172
  %174 = v_lshrrev_b32 %166, %173
  %175 = v_and_b32_src0_inline %174, 1
  %176 = v_mov_b32 0
  %177 = v_cmp_ne_i32 %175, %176
  %down_valid = s_and_b64 %177, %170
  %179 = v_lshlrev_b32_src0_inline %166, 2
  %180 = ds_bpermute_b32 %179, %113
  %down_bits = v_bfe_u32_offset_width_inline %180 {offset = 0, width = 1}
  %down_valid_bits = v_cndmask_b32_src0_lit_src1_inline %down_valid {imm32 = 0, true_value = 1}
  %183 = v_lshlrev_b32_src0_inline %item, 5
  global_store_b32_saddr %183, %down_bits, %destination {offset = 24}
  global_store_b32_saddr %183, %down_valid_bits, %destination {offset = 28}
  return
}

// ====

amdgpu.target<gfx942> @target

// Each predicate component becomes a per-lane carrier before the exchange.
// Named and first-active broadcasts still select from the full native wave.
kernel.def target(@target) @predicate_vector_transport() {
  %c1 = index.constant 1 : index
  %items = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%items, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<64x3xi32>
  %destination = buffer.view %output[%base] : buffer -> view<64x9xi32>
  %words = vector.load %source[%item, 0] : view<64x3xi32> -> vector<3xi32>
  %predicate = vector.trunci %words : vector<3xi32> to vector<3xi1>
  %lane = scalar.constant 33 : i32
  %named = kernel.subgroup.broadcast %predicate from %lane : vector<3xi1>, i32
  %named_bits = vector.extui %named : vector<3xi1> to vector<3xi32>
  vector.store %named_bits, %destination[%item, 0] : vector<3xi32>, view<64x9xi32>
  %width = scalar.constant 64 : i32
  %distance = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<xor> %predicate, %distance, %width : vector<3xi1>, i32, i32
  %shuffled_bits = vector.extui %shuffled : vector<3xi1> to vector<3xi32>
  vector.store %shuffled_bits, %destination[%item, 3] : vector<3xi32>, view<64x9xi32>
  %first = kernel.subgroup.broadcast.first %predicate : vector<3xi1>
  %first_bits = vector.extui %first : vector<3xi1> to vector<3xi32>
  vector.store %first_bits, %destination[%item, 6] : vector<3xi32>, view<64x9xi32>
  kernel.return
}

