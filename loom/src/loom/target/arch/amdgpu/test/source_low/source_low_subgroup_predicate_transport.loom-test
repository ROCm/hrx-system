// ====

amdgpu.target<gfx942> @target

// Each predicate component becomes a per-lane carrier before the exchange.
// Named and first-active broadcasts still select from the full native wave.
kernel.def target(@target) @predicate_vector_transport() {
  %c1 = index.constant 1 : index
  %items = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%items, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<64x3xi32>
  %destination = buffer.view %output[%base] : buffer -> view<64x9xi32>
  %words = vector.load %source[%item, 0] : view<64x3xi32> -> vector<3xi32>
  %predicate = vector.trunci %words : vector<3xi32> to vector<3xi1>
  %lane = scalar.constant 33 : i32
  %named = kernel.subgroup.broadcast %predicate from %lane : vector<3xi1>, i32
  %named_bits = vector.extui %named : vector<3xi1> to vector<3xi32>
  vector.store %named_bits, %destination[%item, 0] : vector<3xi32>, view<64x9xi32>
  %width = scalar.constant 64 : i32
  %distance = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<xor> %predicate, %distance, %width : vector<3xi1>, i32, i32
  %shuffled_bits = vector.extui %shuffled : vector<3xi1> to vector<3xi32>
  vector.store %shuffled_bits, %destination[%item, 3] : vector<3xi32>, view<64x9xi32>
  %first = kernel.subgroup.broadcast.first %predicate : vector<3xi1>
  %first_bits = vector.extui %first : vector<3xi1> to vector<3xi32>
  vector.store %first_bits, %destination[%item, 6] : vector<3xi32>, view<64x9xi32>
  kernel.return
}

