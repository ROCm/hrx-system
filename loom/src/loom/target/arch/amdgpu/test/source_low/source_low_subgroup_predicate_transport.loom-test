  %43 = v_and_b32_src0_inline %42, 1
  %44 = slice %words[3] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %45 = v_and_b32_src0_inline %44, 1
  %46 = slice %words[4] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %47 = v_and_b32_src0_inline %46, 1
  %48 = slice %words[5] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %49 = v_and_b32_src0_inline %48, 1
  %50 = slice %words[6] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %51 = v_and_b32_src0_inline %50, 1
  %53 = v_mov_b32 1
  %54 = v_add_u32 %item, %53
  %55 = v_mov_b32 32
  %56 = v_cmp_lt_u32 %54, %55
  %57 = s_mov_b64_exec_read
  %58 = slice %57[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %59 = v_mov_b32_copy %58
