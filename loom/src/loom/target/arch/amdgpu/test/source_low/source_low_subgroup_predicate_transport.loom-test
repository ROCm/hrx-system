  %39 = v_and_b32_src0_inline %38, 1
  %40 = slice %words[1] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %41 = v_and_b32_src0_inline %40, 1
  %42 = slice %words[2] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %43 = v_and_b32_src0_inline %42, 1
  %44 = slice %words[3] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %45 = v_and_b32_src0_inline %44, 1
  %46 = slice %words[4] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %47 = v_and_b32_src0_inline %46, 1
  %48 = slice %words[5] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %49 = v_and_b32_src0_inline %48, 1
  %50 = slice %words[6] : reg<amdgpu.vgpr x7> -> reg<amdgpu.vgpr>
  %51 = v_and_b32_src0_inline %50, 1
  %53 = v_mov_b32 1
  %54 = v_add_u32 %item, %53
  %55 = v_mov_b32 32
  %56 = v_cmp_lt_u32 %54, %55
  %57 = s_mov_b64_exec_read
  %58 = slice %57[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %59 = v_mov_b32_copy %58
  %60 = v_lshrrev_b32 %54, %59
  %61 = v_and_b32_src0_inline %60, 1
  %62 = v_mov_b32 0
  %63 = v_cmp_ne_i32 %61, %62
  %valid = s_and_b64 %63, %56
  %65 = v_lshlrev_b32_src0_inline %54, 2
  %67 = ds_bpermute_b32 %65, %39
  %69 = ds_bpermute_b32 %65, %41
  %71 = ds_bpermute_b32 %65, %43
  %73 = ds_bpermute_b32 %65, %45
  %75 = ds_bpermute_b32 %65, %47
  %77 = ds_bpermute_b32 %65, %49
  %79 = ds_bpermute_b32 %65, %51
  %81, %82 = s_and_saveexec_b64 %valid
  low.cond_br %82, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %84 = v_and_b32_src0_inline %67, 1
  %86 = v_and_b32_src0_inline %69, 1
  %88 = v_and_b32_src0_inline %71, 1
  %90 = v_and_b32_src0_inline %73, 1
  %92 = v_and_b32_src0_inline %75, 1
  %94 = v_and_b32_src0_inline %77, 1
  %96 = v_and_b32_src0_inline %79, 1
  %105 = concat(%84, %86, %88, %90) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %99 = v_mov_b32 28
  %100 = v_mul_lo_u32 %item, %99
  global_store_b128_saddr %100, %105, %destination
  %104 = concat(%92, %94, %96) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
