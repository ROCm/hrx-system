  %85 = slice %words[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %86 = v_and_b32_src0_inline %85, 1
  %87 = slice %words[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %88 = v_and_b32_src0_inline %87, 1
  %90 = v_xor_b32_src0_inline %item, 32
  %91 = v_lshlrev_b32_src0_inline %90, 2
  %93 = ds_bpermute_b32 %91, %84
  %95 = ds_bpermute_b32 %91, %86
  %97 = ds_bpermute_b32 %91, %88
  %100 = v_and_b32_src0_inline %93, 1
  %102 = v_and_b32_src0_inline %95, 1
  %104 = v_and_b32_src0_inline %97, 1
  %shuffled_bits = concat(%100, %102, %104) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %106 = v_mov_b32 36
  %107 = v_mul_lo_u32 %item, %106
  global_store_dwordx3_saddr %107, %shuffled_bits, %destination {offset = 12}
  %108 = slice %words[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %109 = v_and_b32_src0_inline %108, 1
  %110 = slice %words[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %111 = v_and_b32_src0_inline %110, 1
  %112 = slice %words[2] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %113 = v_and_b32_src0_inline %112, 1
  %116 = v_readfirstlane_b32 %109
  %117 = v_mov_b32_copy %116
  %119 = v_readfirstlane_b32 %111
  %120 = v_mov_b32_copy %119
  %122 = v_readfirstlane_b32 %113
  %123 = v_mov_b32_copy %122
  %126 = v_and_b32_src0_inline %117, 1
  %128 = v_and_b32_src0_inline %120, 1
  %130 = v_and_b32_src0_inline %123, 1
  %first_bits = concat(%126, %128, %130) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %132 = v_mov_b32 36
  %133 = v_mul_lo_u32 %item, %132
  global_store_dwordx3_saddr %133, %first_bits, %destination {offset = 24}
  return
}

// ====

amdgpu.target<gfx1200> @target

// A seven-component predicate has no native packed-vector spelling. Its
// component order and tail survive the shape-preserving carrier conversion.
kernel.def target(@target) @predicate_wide_vector() {
  %c1 = index.constant 1 : index
  %items = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%items, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<32x7xi32>
  %destination = buffer.view %output[%base] : buffer -> view<32x7xi32>
  %words = vector.load %source[%item, 0] : view<32x7xi32> -> vector<7xi32>
  %predicate = vector.trunci %words : vector<7xi32> to vector<7xi1>
  %distance = scalar.constant 1 : i32
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<down> %predicate, %distance, %width : vector<7xi1>, i32, i32
  scf.if %valid {
    %bits = vector.extui %shuffled : vector<7xi1> to vector<7xi32>
    vector.store %bits, %destination[%item, 0] : vector<7xi32>, view<32x7xi32>
  }
  kernel.return
}

