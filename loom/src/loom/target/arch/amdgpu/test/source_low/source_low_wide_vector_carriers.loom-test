// ====

// Packet preparation rewrites an oversized load immediately before its
// consumer component. Reporting retains the load's authored contract result
// even though the load is not itself a component member.
// RUN: with-checks compile-report specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @report_packetized_load_root(%input: buffer, %rhs: vector<36xf32>) -> (vector<36xf32>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<36xf32>
  %values = vector.load %input_view[0] : view<36xf32> -> vector<36xf32>
  %result = vector.addf %values, %rhs : vector<36xf32>
  func.return %result : vector<36xf32>
}

// ----
CHECK: COMPILE-REPORT: target_legalization[*] function=report_packetized_load_root source_op=vector.load mode=final policy=prefer-native action=rewritten outcome=target-rewrite contract=unhandled legalizer=vector-packet strategy=target bundle=target config=target scalarized=false source_rejections=0x00000000 source_rejection_detail=0 target_rejections=0x00000000 missing_features=0x00000000 missing_facts=0x00000000 created_ops=10 erased_ops=2

// ====

// Predicate bitstreams split at the native 32-mask carrier boundary while
// preserving packed byte tails in both directions.
// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_predicate_bitunpack(%packed: vector<5xi8>) -> (vector<40xi1>) {
  %unpacked = vector.bitunpacku<1> %packed : vector<5xi8> -> vector<40xi1>
  func.return %unpacked : vector<40xi1>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_predicate_bitunpack(%packed: vector<5xi8>) -> (vector<32xi1>, vector<8xi1>) {
  %8 = vector.slice %packed[0] : vector<5xi8> -> vector<4xi8>
  %9 = vector.bitunpacku<1> %8 : vector<4xi8> -> vector<32xi1>
  %10 = vector.slice %packed[4] : vector<5xi8> -> vector<1xi8>
  %11 = vector.bitunpacku<1> %10 : vector<1xi8> -> vector<8xi1>
  func.return %9, %11 : vector<32xi1>, vector<8xi1>
}

// ====

// RUN: pass specialize-target-callgraph,project-boundary-representations,target-legalize{mode=complete,boundaries=projected},canonicalize,dce

amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_predicate_bitpack(%predicates: vector<40xi1>) -> (vector<5xi8>) {
  %packed = vector.bitpack<1> %predicates : vector<40xi1> -> vector<5xi8>
  func.return %packed : vector<5xi8>
}

// ----
amdgpu.target<gfx11-generic> @target

func.def public target(@target) @wide_predicate_bitpack(%5: vector<32xi1>, %6: vector<8xi1>) -> (vector<5xi8>) {
  %9 = vector.bitpack<1> %5 : vector<32xi1> -> vector<4xi8>
  %11 = vector.bitpack<1> %6 : vector<8xi1> -> vector<1xi8>
  %packed = vector.concat<0> %9, %11 : vector<4xi8>, vector<1xi8> -> vector<5xi8>
  func.return %packed : vector<5xi8>
}
