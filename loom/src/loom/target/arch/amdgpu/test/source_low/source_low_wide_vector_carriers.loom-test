  %280 = global_load_b128_vaddr %279 {offset = 64}
  %285 = concat(%253, %254) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %286 = global_load_b128_vaddr %285 {offset = 80}
