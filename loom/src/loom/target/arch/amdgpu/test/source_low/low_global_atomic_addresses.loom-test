// RUN: emit amdgpu-assembly @global_address_gfx90a

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @global_address_gfx90a(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>, %wide_value: reg<amdgpu.vgpr x2>, %compare_exchange: reg<amdgpu.vgpr x4>) asm {
  %old = global_atomic_add_rtn_vaddr %address, %value {offset = 16} : reg<amdgpu.vgpr>
  global_atomic_xor_x2_vaddr %address, %wide_value {offset = 32}
  %observed = global_atomic_cmpswap_x2_rtn_vaddr %address, %compare_exchange {offset = 64} : reg<amdgpu.vgpr x2>
  return
}

