// RUN: emit source-low target=amdgpu:gfx9-4-generic output=low

func.def @select_i8_1(%mask: vector<1xi1>, %true_value: vector<1xi8>, %false_value: vector<1xi8>) -> (vector<1xi8>) {
  %selected = vector.select %mask, %true_value, %false_value : vector<1xi8>
  func.return %selected : vector<1xi8>
}

// ----
low.func.def target<amdgpu.gfx9_4.generic.core> abi(hal_kernel) @select_i8_1(%mask: reg<amdgpu.sgpr x2>, %true_value: reg<amdgpu.vgpr>, %false_value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %selected = v_cndmask_b32 %false_value, %true_value, %mask
  return %selected
}

