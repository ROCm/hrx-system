low.func.def target<amdgpu.gfx9_4.generic.core> abi(hal_kernel) @select_i8_7(%mask: reg<amdgpu.sgpr x14>, %true_value: reg<amdgpu.vgpr x2>, %false_value: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = slice %true_value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %10 = slice %false_value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = slice %mask[0] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %12 = v_cndmask_b32 %10, %9, %11
  %13 = slice %mask[2] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %14 = v_cndmask_b32 %10, %9, %13
  %15 = s_mov_b32 65280
  %16 = v_bfi_b32 %15, %14, %12
  %17 = slice %mask[4] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %18 = v_cndmask_b32 %10, %9, %17
  %19 = s_mov_b32 16711680
  %20 = v_bfi_b32 %19, %18, %16
  %21 = slice %mask[6] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %22 = v_cndmask_b32 %10, %9, %21
  %23 = s_mov_b32 4278190080
  %24 = v_bfi_b32 %23, %22, %20
  %25 = slice %true_value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %26 = slice %false_value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %27 = slice %mask[8] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %28 = v_cndmask_b32 %26, %25, %27
  %29 = slice %mask[10] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %30 = v_cndmask_b32 %26, %25, %29
  %32 = v_bfi_b32 %15, %30, %28
  %33 = slice %mask[12] : reg<amdgpu.sgpr x14> -> reg<amdgpu.sgpr x2>
  %34 = v_cndmask_b32 %26, %25, %33
  %36 = v_bfi_b32 %19, %34, %32
  %selected = concat(%24, %36) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %selected
}

