low.func.def target<amdgpu.gfx9_4.generic.core> abi(hal_kernel) @select_i16_3(%mask: reg<amdgpu.sgpr x6>, %true_value: reg<amdgpu.vgpr x2>, %false_value: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = slice %true_value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %10 = slice %false_value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = slice %mask[0] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %12 = v_cndmask_b32 %10, %9, %11
  %13 = slice %mask[2] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %14 = v_cndmask_b32 %10, %9, %13
  %15 = s_mov_b32 4294901760
  %16 = v_bfi_b32 %15, %14, %12
  %17 = slice %true_value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = slice %false_value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = slice %mask[4] : reg<amdgpu.sgpr x6> -> reg<amdgpu.sgpr x2>
  %20 = v_cndmask_b32 %18, %17, %19
  %selected = concat(%16, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %selected
}

// ====

// All mask elements share the range [false, true], but choose independently.
func.def @select_byte_comparisons(%input: vector<4xi32>, %true_value: vector<4xi8>, %false_value: vector<4xi8>) -> (vector<4xi8>) {
  %low_bit = scalar.constant 1 : i32
  %low_bits = vector.splat %low_bit : vector<4xi32>
  %bits = vector.andi %input, %low_bits : vector<4xi32>
  %mask = vector.cmpi eq, %bits, %low_bits : vector<4xi32> -> vector<4xi1>
  %selected = vector.select %mask, %true_value, %false_value : vector<4xi8>
  func.return %selected : vector<4xi8>
}

// ----
low.func.def target<amdgpu.gfx9_4.generic.core> abi(hal_kernel) @select_byte_comparisons(%input: reg<amdgpu.vgpr x4>, %true_value: reg<amdgpu.vgpr>, %false_value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %18 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %19 = v_and_b32_lit %18, 1
  %20 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = v_and_b32_lit %20, 1
  %22 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %23 = v_and_b32_lit %22, 1
  %24 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %25 = v_and_b32_lit %24, 1
  %28 = v_cmp_eq_i32_src1_inline %19 {rhs = 1}
  %30 = v_cmp_eq_i32_src1_inline %21 {rhs = 1}
  %32 = v_cmp_eq_i32_src1_inline %23 {rhs = 1}
  %34 = v_cmp_eq_i32_src1_inline %25 {rhs = 1}
  %37 = v_cndmask_b32 %false_value, %true_value, %28
  %39 = v_cndmask_b32 %false_value, %true_value, %30
  %40 = s_mov_b32 65280
  %41 = v_bfi_b32 %40, %39, %37
  %43 = v_cndmask_b32 %false_value, %true_value, %32
  %44 = s_mov_b32 16711680
  %45 = v_bfi_b32 %44, %43, %41
  %47 = v_cndmask_b32 %false_value, %true_value, %34
  %48 = s_mov_b32 4278190080
  %selected = v_bfi_b32 %48, %47, %45
  return %selected
}
