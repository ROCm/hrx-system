// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Scalar-memory packets share their dynamic SOFFSET expression.
func.def @scalar_memory_load(%input: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %constant_input = buffer.assume.memory_space<constant> %aligned : buffer
  %source = buffer.view %constant_input[%row_offset] : buffer -> view<16xi32>
  %value = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @scalar_memory_load(%bounded_row: reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %14 = v_lshlrev_b32_src0_inline %bounded_row, 17
  %15 = v_lshrrev_b32_src0_inline %bounded_row, 15
  %16 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18, %19 = v_add_co_u32 %16, %14
  %20 = v_mov_b32_copy %17
  %21, %22 = v_add_co_ci_u32 %20, %15, %19
  %23 = concat(%18, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %24 = global_load_b128_vaddr<volatile> %23
  %34 = concat(%18, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %35 = global_load_b128_vaddr<volatile> %34 {offset = 16}
  %45 = concat(%18, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %46 = global_load_b128_vaddr<volatile> %45 {offset = 32}
  %56 = concat(%18, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %57 = global_load_b128_vaddr<volatile> %56 {offset = 48}
  return
}

// ====

// Dynamic descriptor packets share their descriptor, VADDR, and SOFFSET.
kernel.def @descriptor_dynamic_load() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %row: index) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %descriptor_input = buffer.assume.memory_space<descriptor> %aligned : buffer
  %source = buffer.view %descriptor_input[%row_offset] : buffer -> view<16xi32>
  %value = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "row"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @descriptor_dynamic_load(%bounded_row: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %row_bytes = s_mov_b32 131072
  %row_offset = s_mul_i32 %bounded_row, %row_bytes
  %17 = v_mov_b32 0
  %18 = s_mov_b32 64
  %19 = s_add_u32 %row_offset, %18
  %26 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = s_mov_b32 65535
  %29 = s_and_b32 %27, %28
  %30 = concat(%26, %29) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %31 = s_mov_b32 822173696
  %32 = concat(%30, %19, %31) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %21 = buffer_load_b128<volatile> %32, %17, %row_offset
  %22 = buffer_load_b128<volatile> %32, %17, %row_offset {offset = 16}
  %23 = buffer_load_b128<volatile> %32, %17, %row_offset {offset = 32}
  %24 = buffer_load_b128<volatile> %32, %17, %row_offset {offset = 48}
  return
}

// ====

// Descriptor stores use the same shared address path as loads.
kernel.def @descriptor_dynamic_store() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%output: buffer, %row: index) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %descriptor_output = buffer.assume.memory_space<descriptor> %aligned : buffer
  %destination = buffer.view %descriptor_output[%row_offset] : buffer -> view<16xi32>
  %value = vector.splati 1 : vector<16xi32>
  vector.store<volatile> %value, %destination[0] : vector<16xi32>, view<16xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "row"}, direct_arg_offsets = [8], direct_arg_parameter_indices = [1], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @descriptor_dynamic_store(%bounded_row: reg<amdgpu.sgpr>) asm {
  %destination = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %row_bytes = s_mov_b32 131072
  %row_offset = s_mul_i32 %bounded_row, %row_bytes
  %14 = v_mov_b32 1
  %value = concat(%14, %14, %14, %14, %14, %14, %14, %14, %14, %14, %14, %14, %14, %14, %14, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x16>
  %31 = slice %value[0] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  %32 = v_mov_b32 0
  %33 = s_mov_b32 64
  %34 = s_add_u32 %row_offset, %33
  %39 = slice %destination[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %40 = slice %destination[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %41 = s_mov_b32 65535
  %42 = s_and_b32 %40, %41
  %43 = concat(%39, %42) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %44 = s_mov_b32 822173696
  %45 = concat(%43, %34, %44) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  buffer_store_b128<volatile> %31, %45, %32, %row_offset
  %36 = slice %value[4] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  buffer_store_b128<volatile> %36, %45, %32, %row_offset {offset = 16}
  %37 = slice %value[8] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  buffer_store_b128<volatile> %37, %45, %32, %row_offset {offset = 32}
  %38 = slice %value[12] : reg<amdgpu.vgpr x16> -> reg<amdgpu.vgpr x4>
  buffer_store_b128<volatile> %38, %45, %32, %row_offset {offset = 48}
  return
}

// ====

// Atomic descriptor bounds and packet SOFFSET share the authored view base.
func.def @descriptor_dynamic_atomic(%storage: buffer, %row: index) -> (i32) {
  %bounded_row = index.assume %row [range(%row, 0, 1023)] : index
  %row_bytes = index.constant 131072 : offset
  %row_offset = index.scale %bounded_row, %row_bytes : index, offset -> offset
  %aligned = buffer.assume.alignment %storage {minimum_alignment = 4} : buffer
  %global_storage = buffer.assume.memory_space<global> %aligned : buffer
  %word = buffer.view %global_storage[%row_offset] : buffer -> view<1xi32>
  %increment = scalar.constant 1 : i32
  %old = view.atomic.rmw<addi> %increment, %word[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  func.return %old : i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @descriptor_dynamic_atomic(%bounded_row: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %word = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %18 = v_lshlrev_b32_src0_inline %bounded_row, 17
  %19 = s_mov_b32 0
  %23 = slice %word[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = slice %word[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = s_mov_b32 65535
  %26 = s_and_b32 %24, %25
  %27 = concat(%23, %26) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %28 = s_mov_b32 4294967295
  %29 = s_mov_b32 822173696
  %30 = concat(%27, %28, %29) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %21 = v_mov_b32 1
  %old = buffer_atomic_add_u32_rtn %21, %30, %18, %19
  return %old
}
