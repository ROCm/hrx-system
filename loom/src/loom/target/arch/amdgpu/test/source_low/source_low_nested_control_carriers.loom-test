// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

// The inner join selects a lane-varying memory result and forwards its block
// argument directly into the outer join. Both joins must retain the VGPR
// carrier while choosing between current input and the three-entry history.
kernel.def target(@target) @nested_memory_load_carrier() {
  %count = index.constant 64 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%metadata: buffer, %input: buffer, %tail_buffer: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %c3 = index.constant 3 : index
  %metadata_view = buffer.view %metadata[%origin] : buffer -> view<128xi32>
  %input_view = buffer.view %input[%origin] : buffer -> view<64xi32>
  %tail_view = buffer.view %tail_buffer[%origin] : buffer -> view<3xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<64xi32>
  %position_index = index.add %row, %c64 : index
  %position32 = view.load %metadata_view[%position_index] : view<128xi32> -> i32
  %begin32 = view.load %metadata_view[%row] : view<128xi32> -> i32
  %position_value = index.cast %position32 : i32 to index
  %position = index.assume %position_value [range(%position_value, 0, 1048575)] : index
  %begin_value = index.cast %begin32 : i32 to index
  %latest_begin = index.add %row, %c3 : index
  %begin = index.assume %begin_value [range(%begin_value, 0, 63), le(%begin_value, %latest_begin)] : index
  %relative = index.sub %row, %begin : index
  %absolute = index.add %position, %relative : index
  %exists = index.cmp sge, %absolute, %c0 : index
  %raw = scf.if %exists -> (i32) {
    %current = index.cmp sge, %relative, %c0 : index
    %selected = scf.if %current -> (i32) {
      %source = index.assume %row [range(%row, 0, 63)] : index
      %value = view.load %input_view[%source] : view<64xi32> -> i32
      scf.yield %value : i32
    } else {
      %bounded = index.assume %relative [range(%relative, -3, -1)] : index
      %padded = index.add %bounded, %c3 : index
      %source = index.assume %padded [range(%padded, 0, 2)] : index
      %value = view.load %tail_view[%source] : view<3xi32> -> i32
      scf.yield %value : i32
    }
    scf.yield %selected : i32
  } else {
    %fallback = scalar.constant 0 : i32
    scf.yield %fallback : i32
  }
  %wide = scalar.extui %raw : i32 to i64
  %factor = scalar.constant 17 : i64
  %product = scalar.muli %wide, %factor : i64
  %narrow = scalar.trunci %product : i64 to i32
  view.store %narrow, %output_view[%row] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 4, resource_count = 4, resource_offsets = [0, 8, 16, 24], resource_parameter_indices = [0, 1, 2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(64, 1, 1) @nested_memory_load_carrier() asm {
  %source$46 = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %metadata_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %input_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %tail_view = resource<hal_binding> {extent = 12, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c0 = s_mov_b32 0
  %c3 = s_mov_b32 3
  %53 = s_lshl_b32_rhs_inline %source$46, 2
  %position = s_load_dword %metadata_view, %53 {offset = 256}
  %55 = s_lshl_b32_rhs_inline %source$46, 2
  %begin = s_load_dword %metadata_view, %55
  %bounded = s_sub_u32 %source$46, %begin
  %absolute = s_add_u32 %position, %bounded
  %exists = s_cmp_ge_i32 %absolute, %c0
  low.cond_br %exists, ^_bb1, ^_bb5 : reg<amdgpu.scc>
^_bb1:
  %current = s_cmp_ge_i32 %bounded, %c0
  low.cond_br %current, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %61 = s_lshl_b32_rhs_inline %source$46, 2
  %value$62 = s_load_dword %input_view, %61
  low.br ^_bb4(%value$62: reg<amdgpu.sgpr>)
^_bb3:
  %source$63 = s_add_u32 %bounded, %c3
  %64 = s_lshl_b32_rhs_inline %source$63, 2
  %value$65 = s_load_dword %tail_view, %64
  low.br ^_bb4(%value$65: reg<amdgpu.sgpr>)
^_bb4(%selected: reg<amdgpu.sgpr>):
  low.br ^_bb6(%selected: reg<amdgpu.sgpr>)
^_bb5:
  low.br ^_bb6(%c0: reg<amdgpu.sgpr>)
^_bb6(%raw: reg<amdgpu.sgpr>):
  %67 = s_mov_b32 17
  %narrow = s_mul_i32 %raw, %67
  %69 = v_mov_b32_copy %narrow
  %70 = v_mov_b32 0
  %71 = s_lshl_b32_rhs_inline %source$46, 2
  %72 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %73 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %75, %76 = s_add_co_u32 %72, %71
  %77, %78 = s_addc_u32 %73, %c0, %76
  %79 = concat(%75, %77) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %70, %69, %79
  return
}

// ====

// RUN: with-checks emit source-low output=low sanitizer=access sanitizer-reporting=report-only

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

// Access instrumentation adds control edges around each memory operation. The
// original nested joins must retain their subgroup-uniform carrier. Only
// those two carrier classes matter here; the native case owns operand wiring.
kernel.def target(@target) @instrumented_nested_memory_load_carrier() {
  %count = index.constant 64 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%metadata: buffer, %input: buffer, %tail_buffer: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %c3 = index.constant 3 : index
  %metadata_view = buffer.view %metadata[%origin] : buffer -> view<128xi32>
  %input_view = buffer.view %input[%origin] : buffer -> view<64xi32>
  %tail_view = buffer.view %tail_buffer[%origin] : buffer -> view<3xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<64xi32>
  %position_index = index.add %row, %c64 : index
  %position32 = view.load %metadata_view[%position_index] : view<128xi32> -> i32
  %begin32 = view.load %metadata_view[%row] : view<128xi32> -> i32
  %position_value = index.cast %position32 : i32 to index
  %position = index.assume %position_value [range(%position_value, 0, 1048575)] : index
  %begin_value = index.cast %begin32 : i32 to index
  %latest_begin = index.add %row, %c3 : index
  %begin = index.assume %begin_value [range(%begin_value, 0, 63), le(%begin_value, %latest_begin)] : index
  %relative = index.sub %row, %begin : index
  %absolute = index.add %position, %relative : index
  %exists = index.cmp sge, %absolute, %c0 : index
  %raw = scf.if %exists -> (i32) {
    %current = index.cmp sge, %relative, %c0 : index
    %selected = scf.if %current -> (i32) {
      %source = index.assume %row [range(%row, 0, 63)] : index
      %value = view.load %input_view[%source] : view<64xi32> -> i32
      scf.yield %value : i32
    } else {
      %bounded = index.assume %relative [range(%relative, -3, -1)] : index
      %padded = index.add %bounded, %c3 : index
      %source = index.assume %padded [range(%padded, 0, 2)] : index
      %value = view.load %tail_view[%source] : view<3xi32> -> i32
      scf.yield %value : i32
    }
    scf.yield %selected : i32
  } else {
    %fallback = scalar.constant 0 : i32
    scf.yield %fallback : i32
  }
  %wide = scalar.extui %raw : i32 to i64
  %factor = scalar.constant 17 : i64
  %product = scalar.muli %wide, %factor : i64
  %narrow = scalar.trunci %product : i64 to i32
  view.store %narrow, %output_view[%row] : i32, view<64xi32>
  kernel.return
}

// ----
CHECK: ^*(%selected: reg<amdgpu.sgpr>):
CHECK: ^*(%raw: reg<amdgpu.sgpr>):

// ====

// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

// The loop's backedge wraps a lane-varying load in arithmetic. Carrier
// placement must follow the complete incoming expression instead of only a
// direct load or forwarded block argument.
func.def target(@target) @loop_expression_carrier(%input: buffer, %coordinates: vector<2xi32>) -> (i32) {
  %lane = vector.extract %coordinates[0] : vector<2xi32> -> i32
  %lane_index = index.cast %lane : i32 to index
  %bounded_lane = index.assume %lane_index [range(%lane_index, 0, 31)] : index
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<32xi32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %sum = scf.for %iteration = [%begin to %end step %step](%total = %initial : i32) -> (i32) {
    %value = view.load<volatile> %source[%bounded_lane] : view<32xi32> -> i32
    %next = scalar.addi %total, %value : i32
    scf.yield %next : i32
  }
  func.return %sum : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @loop_expression_carrier(%coordinates: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %bounded_lane = slice %coordinates[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %begin = s_mov_b32 0
  %end = s_mov_b32 4
  %step = s_mov_b32 1
  %33 = v_mov_b32 0
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %33: reg<amdgpu.vgpr>)
^_bb1(%iteration: reg<amdgpu.sgpr>, %total: reg<amdgpu.vgpr>):
  %34 = s_cmp_lt_i32 %iteration, %end
  low.cond_br %34, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %35 = v_lshlrev_b32_src0_inline %bounded_lane, 2
  %value = global_load_b32_saddr<volatile> %35, %source
  %next = v_add_u32 %total, %value
  %38 = s_add_u32 %iteration, %step
  low.br ^_bb1(%38: reg<amdgpu.sgpr>, %next: reg<amdgpu.vgpr>)
^_bb3:
  return %total
}
