// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

// The inner join selects a lane-varying memory result and forwards its block
// argument directly into the outer join. Both joins must retain the VGPR
// carrier even though one incoming edge is statically unreachable.
kernel.def target(@target) @nested_memory_load_carrier() {
  %count = index.constant 64 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%metadata: buffer, %input: buffer, %tail_buffer: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %c3 = index.constant 3 : index
  %metadata_view = buffer.view %metadata[%origin] : buffer -> view<128xi32>
  %input_view = buffer.view %input[%origin] : buffer -> view<64xi32>
  %tail_view = buffer.view %tail_buffer[%origin] : buffer -> view<3xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<64xi32>
  %position_index = index.add %row, %c64 : index
  %position32 = view.load %metadata_view[%position_index] : view<128xi32> -> i32
  %begin32 = view.load %metadata_view[%row] : view<128xi32> -> i32
  %position_value = index.cast %position32 : i32 to index
  %position = index.assume %position_value [range(%position_value, 0, 1048575)] : index
  %begin_value = index.cast %begin32 : i32 to index
  %begin = index.assume %begin_value [range(%begin_value, 0, 63)] : index
  %relative = index.sub %row, %begin : index
  %absolute = index.add %position, %relative : index
  %exists = index.cmp uge, %absolute, %c0 : index
  %raw = scf.if %exists -> (i32) {
    %current = index.cmp uge, %relative, %c0 : index
    %selected = scf.if %current -> (i32) {
      %source = index.assume %row [range(%row, 0, 63)] : index
      %value = view.load %input_view[%source] : view<64xi32> -> i32
      scf.yield %value : i32
    } else {
      %bounded = index.assume %relative [ge(%relative, 0), lt(%relative, 0)] : index
      %padded = index.add %bounded, %c3 : index
      %source = index.assume %padded [range(%padded, 0, 2)] : index
      %value = view.load %tail_view[%source] : view<3xi32> -> i32
      scf.yield %value : i32
    }
    scf.yield %selected : i32
  } else {
    %fallback = scalar.constant 0 : i32
    scf.yield %fallback : i32
  }
  %wide = scalar.extui %raw : i32 to i64
  %factor = scalar.constant 17 : i64
  %product = scalar.muli %wide, %factor : i64
  %narrow = scalar.trunci %product : i64 to i32
  view.store %narrow, %output_view[%row] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 4, resource_count = 4, resource_offsets = [0, 8, 16, 24], resource_parameter_indices = [0, 1, 2, 3], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(64, 1, 1) @nested_memory_load_carrier() asm {
  %source$45 = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %metadata_view = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %input_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %tail_view = resource<hal_binding> {extent = 12, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 3, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c3 = s_mov_b32 3
  %51 = v_mov_b32 0
  %52 = s_lshl_b32_rhs_inline %source$45, 2
  %53 = slice %metadata_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %54 = slice %metadata_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %55 = s_mov_b32 0
  %56, %57 = s_add_co_u32 %53, %52
  %58, %59 = s_addc_u32 %54, %55, %57
  %60 = concat(%56, %58) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %position = global_load_b32_saddr %51, %60 {offset = 256}
  %63 = s_lshl_b32_rhs_inline %source$45, 2
  %67, %68 = s_add_co_u32 %53, %63
  %69, %70 = s_addc_u32 %54, %55, %68
  %71 = concat(%67, %69) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %begin = global_load_b32_saddr %51, %71
  %bounded = v_sub_nc_u32 %source$45, %begin
  %absolute = v_add_u32 %position, %bounded
  %exists = v_cmp_ge_u32_src1_inline %absolute {rhs = 0}
  %76 = s_mov_b64_exec_read
  %77, %78 = s_and_b64_scc %exists, %76
  low.cond_br %78, ^_bb1, ^_bb5 : reg<amdgpu.scc>
^_bb1:
  %current = v_cmp_ge_u32_src1_inline %bounded {rhs = 0}
  %81, %82 = s_and_b64_scc %current, %76
  low.cond_br %82, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %84 = s_lshl_b32_rhs_inline %source$45, 2
  %85 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %86 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %88, %89 = s_add_co_u32 %85, %84
  %90, %91 = s_addc_u32 %86, %55, %89
  %92 = concat(%88, %90) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value$93 = global_load_b32_saddr %51, %92
  low.br ^_bb4(%value$93: reg<amdgpu.vgpr>)
^_bb3:
  %source$94 = v_add_u32 %c3, %bounded
  %95 = v_lshlrev_b32_src0_inline %source$94, 2
  %value$96 = global_load_b32_saddr %95, %tail_view
  low.br ^_bb4(%value$96: reg<amdgpu.vgpr>)
^_bb4(%selected: reg<amdgpu.vgpr>):
  low.br ^_bb6(%selected: reg<amdgpu.vgpr>)
^_bb5:
  low.br ^_bb6(%51: reg<amdgpu.vgpr>)
^_bb6(%raw: reg<amdgpu.vgpr>):
  %100 = v_mov_b32 17
  %narrow = v_mul_lo_u32 %raw, %100
  %103 = s_lshl_b32_rhs_inline %source$45, 2
  %104 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %105 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %107, %108 = s_add_co_u32 %104, %103
  %109, %110 = s_addc_u32 %105, %55, %108
  %111 = concat(%107, %109) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %51, %narrow, %111
  return
}

// ====

// RUN: with-checks emit source-low output=low sanitizer=access sanitizer-reporting=report-only

amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

// Access instrumentation adds control edges around each memory operation. The
// original nested joins must still agree on their lane-varying carrier.
kernel.def target(@target) @instrumented_nested_memory_load_carrier() {
  %count = index.constant 64 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%metadata: buffer, %input: buffer, %tail_buffer: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %c3 = index.constant 3 : index
  %metadata_view = buffer.view %metadata[%origin] : buffer -> view<128xi32>
  %input_view = buffer.view %input[%origin] : buffer -> view<64xi32>
  %tail_view = buffer.view %tail_buffer[%origin] : buffer -> view<3xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<64xi32>
  %position_index = index.add %row, %c64 : index
  %position32 = view.load %metadata_view[%position_index] : view<128xi32> -> i32
  %begin32 = view.load %metadata_view[%row] : view<128xi32> -> i32
  %position_value = index.cast %position32 : i32 to index
  %position = index.assume %position_value [range(%position_value, 0, 1048575)] : index
  %begin_value = index.cast %begin32 : i32 to index
  %begin = index.assume %begin_value [range(%begin_value, 0, 63)] : index
  %relative = index.sub %row, %begin : index
  %absolute = index.add %position, %relative : index
  %exists = index.cmp uge, %absolute, %c0 : index
  %raw = scf.if %exists -> (i32) {
    %current = index.cmp uge, %relative, %c0 : index
    %selected = scf.if %current -> (i32) {
      %source = index.assume %row [range(%row, 0, 63)] : index
      %value = view.load %input_view[%source] : view<64xi32> -> i32
      scf.yield %value : i32
    } else {
      %bounded = index.assume %relative [ge(%relative, 0), lt(%relative, 0)] : index
      %padded = index.add %bounded, %c3 : index
      %source = index.assume %padded [range(%padded, 0, 2)] : index
      %value = view.load %tail_view[%source] : view<3xi32> -> i32
      scf.yield %value : i32
    }
    scf.yield %selected : i32
  } else {
    %fallback = scalar.constant 0 : i32
    scf.yield %fallback : i32
  }
  %wide = scalar.extui %raw : i32 to i64
  %factor = scalar.constant 17 : i64
  %product = scalar.muli %wide, %factor : i64
  %narrow = scalar.trunci %product : i64 to i32
  view.store %narrow, %output_view[%row] : i32, view<64xi32>
  kernel.return
}

// ----
CHECK: low.kernel.def *@instrumented_nested_memory_load_carrier() asm {
CHECK: ^*(%selected: reg<amdgpu.vgpr>):
CHECK: low.br ^*(%selected: reg<amdgpu.vgpr>)
CHECK: ^*(%raw: reg<amdgpu.vgpr>):
