low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float8_special_constants() -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %e4_positive = v_mov_b32 126
  %e4_negative = v_mov_b32 254
  %e5_positive = v_mov_b32 124
  %e5_negative = v_mov_b32 252
