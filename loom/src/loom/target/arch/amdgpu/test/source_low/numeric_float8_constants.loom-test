func.def @float8_special_constants() -> (f8E4M3, f8E4M3, f8E5M2, f8E5M2, f8E4M3, f8E5M2) {
  %e4_positive = scalar.constant inf : f8E4M3
  %e4_negative = scalar.constant -inf : f8E4M3
