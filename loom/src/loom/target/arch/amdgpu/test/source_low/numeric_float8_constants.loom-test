low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float8_signed_zeros() -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %e4_positive = v_mov_b32 0
  %e4_negative = v_mov_b32 128
