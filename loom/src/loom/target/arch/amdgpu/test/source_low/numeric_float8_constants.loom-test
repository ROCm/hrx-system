low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @float8_vector_specials() -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>) asm {
  %e4_negative_zero = v_mov_b32 2155905152
  %13 = v_mov_b32 2122219134
  %e4_saturated = concat(%13, %13) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %e5_negative_infinity = v_mov_b32 4244438268
  %17 = v_mov_b32 2139062143
  %e5_nan = concat(%17, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %e4_negative_zero, %e4_saturated, %e5_negative_infinity, %e5_nan
}
