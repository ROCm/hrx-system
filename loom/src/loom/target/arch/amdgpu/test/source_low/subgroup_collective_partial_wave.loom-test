amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @subgroup_scan_reverse_partial_wave() {
  %unit = index.constant 1 : index
  %width = index.constant 35 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %item = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<35xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<35xf32>
  %value = view.load %input_view[%item] : view<35xf32> -> f32
  %maximum = kernel.subgroup.scan<maxnumf> %value {direction = reverse, mode = exclusive} : f32
  view.store %maximum, %output_view[%item] : f32, view<35xf32>
  kernel.return
}

