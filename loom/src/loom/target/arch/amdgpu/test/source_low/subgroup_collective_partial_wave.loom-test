  %19 = v_mov_b32 3
  %20 = v_cndmask_b32 %16, %19, %17
  %21 = v_mov_b32 0
  %22 = v_add_u32_src0_inline %15, 16
  %23 = v_lshlrev_b32_src0_inline %22, 2
  %24 = v_cmp_lt_u32 %22, %20
  %25 = ds_bpermute_b32 %23, %value
  %26 = v_add_u32 %value, %25
  %27 = v_cndmask_b32 %value, %26, %24
  %28 = v_add_u32_src0_inline %15, 8
  %29 = v_lshlrev_b32_src0_inline %28, 2
  %30 = v_cmp_lt_u32 %28, %20
  %31 = ds_bpermute_b32 %29, %27
  %32 = v_add_u32 %27, %31
  %33 = v_cndmask_b32 %27, %32, %30
  %34 = v_add_u32_src0_inline %15, 4
  %35 = v_lshlrev_b32_src0_inline %34, 2
  %36 = v_cmp_lt_u32 %34, %20
  %37 = ds_bpermute_b32 %35, %33
  %38 = v_add_u32 %33, %37
  %39 = v_cndmask_b32 %33, %38, %36
  %40 = v_add_u32_src0_inline %15, 2
  %41 = v_lshlrev_b32_src0_inline %40, 2
  %42 = v_cmp_lt_u32 %40, %20
  %43 = ds_bpermute_b32 %41, %39
  %44 = v_add_u32 %39, %43
  %45 = v_cndmask_b32 %39, %44, %42
  %46 = v_add_u32_src0_inline %15, 1
  %47 = v_lshlrev_b32_src0_inline %46, 2
  %48 = v_cmp_lt_u32 %46, %20
  %49 = ds_bpermute_b32 %47, %45
