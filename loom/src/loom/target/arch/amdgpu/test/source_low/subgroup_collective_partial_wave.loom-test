  global_store_b32_saddr %53, %sum, %output_view
  return
}

// ====

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @subgroup_reduce_partial_cluster() {
  %unit = index.constant 1 : index
  %width = index.constant 10 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %item = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<10xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<10xf32>
  %value = view.load %input_view[%item] : view<10xf32> -> f32
  %maximum = kernel.subgroup.reduce<maxnumf> %value {cluster_size = 8} : f32
  view.store %maximum, %output_view[%item] : f32, view<10xf32>
  kernel.return
}

