// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @subgroup_reduce_partial_wave() {
  %unit = index.constant 1 : index
  %width = index.constant 35 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %item = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<35xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<35xi32>
  %value = view.load %input_view[%item] : view<35xi32> -> i32
  %sum = kernel.subgroup.reduce<addi> %value : i32
  view.store %sum, %output_view[%item] : i32, view<35xi32>
  kernel.return
}

