// RUN: emit source-low output=low

amdgpu.target<gfx1151> @target

func.def target(@target) @wide_shift_constant(%values: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = scalar.constant 31 : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @wide_shift_constant(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %7 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %value = concat(%7, %8) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %10 = s_mov_b32 31
  %shifted = v_lshlrev_b64 %10, %value
  return %shifted
}

// ====

amdgpu.target<gfx1151> @target

func.def target(@target) @wide_shift_uniform(%values: vector<2xi64>, %count: i64) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @wide_shift_uniform(%values: reg<amdgpu.vgpr x4>, %count: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %8 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %value = concat(%8, %9) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %11 = slice %count[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %shifted = v_lshlrev_b64 %11, %value
  return %shifted
}

// ====

amdgpu.target<gfx1151> @target

func.def target(@target) @wide_shift_varying(%values: vector<2xi64>, %counts: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = vector.extract %counts[0] : vector<2xi64> -> i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @wide_shift_varying(%values: reg<amdgpu.vgpr x4>, %counts: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %value = concat(%9, %10) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %12 = slice %counts[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %shifted = v_lshlrev_b64 %12, %value
  return %shifted
}
