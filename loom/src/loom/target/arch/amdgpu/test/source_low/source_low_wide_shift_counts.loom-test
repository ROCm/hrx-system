low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @wide_right_shift_word_boundaries(%value: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %30 = s_mov_b32 31
  %33 = s_mov_b32 32
  %36 = s_mov_b32 63
  %logical_low_edge = s_lshr_b64 %value, %30
  %signed_low_edge = s_ashr_i64 %value, %30
  %logical_high_edge = s_lshr_b64 %value, %33
  %signed_high_edge = s_ashr_i64 %value, %33
  %logical_top = s_lshr_b64 %value, %36
  %signed_top = s_ashr_i64 %value, %36
  return %value, %value, %logical_low_edge, %signed_low_edge, %logical_high_edge, %signed_high_edge, %logical_top, %signed_top
}

