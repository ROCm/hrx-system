// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @wide_right_shift_constant(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %10 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %value = concat(%10, %11) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %13 = s_mov_b32 31
  %18 = v_lshrrev_b32_src0_inline %10, 31
  %19 = v_lshlrev_b32_src0_inline %11, 1
  %20 = v_or_b32 %18, %19
  %21 = v_lshrrev_b32_src0_inline %11, 31
  %logical = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %signed = v_ashrrev_i64 %13, %value
  return %logical, %signed
}

// ====

amdgpu.target<gfx1151> @target

func.def target(@target) @wide_shift_word_boundaries(%value: i64) -> (i64, i64, i64, i64) {
  %identity_count = scalar.constant 0 : i64
  %last_low = scalar.constant 31 : i64
  %first_high = scalar.constant 32 : i64
  %last_high = scalar.constant 63 : i64
  %unchanged = scalar.shli %value, %identity_count : i64
  %low_edge = scalar.shli %value, %last_low : i64
  %high_edge = scalar.shli %value, %first_high : i64
  %top_bit = scalar.shli %value, %last_high : i64
  func.return %unchanged, %low_edge, %high_edge, %top_bit : i64, i64, i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @wide_shift_word_boundaries(%value: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %18 = s_mov_b32 31
  %21 = s_mov_b32 32
  %24 = s_mov_b32 63
  %low_edge = s_lshl_b64 %value, %18
  %high_edge = s_lshl_b64 %value, %21
  %top_bit = s_lshl_b64 %value, %24
  return %value, %low_edge, %high_edge, %top_bit
}

