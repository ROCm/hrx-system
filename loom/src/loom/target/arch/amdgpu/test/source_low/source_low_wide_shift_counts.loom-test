  %mask = concat(%7, %8) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = s_and_b64 %input, %mask
  %11 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %result = s_lshl_b64 %value, %11
  return %result
}

// ====

func.def @index_shift_dynamic(%value: index, %count: index) -> (index, index) {
  %left = index.shli %value, %count : index
  %right = index.shrui %value, %count : index
  func.return %left, %right : index, index
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @index_shift_dynamic(%value: reg<amdgpu.sgpr>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %left = s_lshl_b32 %value, %count
  %right = s_lshr_b32 %value, %count
  return %left, %right
}

// ====

func.def @index_shift_constant_four(%value: index) -> (index) {
  %count = index.constant 4 : index
  %result = index.shli %value, %count : index
  func.return %result : index
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @index_shift_constant_four(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %count = s_mov_b32 4
  %result = s_lshl_b32 %value, %count
  return %result
}

// ====

func.def @index_shift_arithmetic(%value: index, %count: index) -> (index) {
  %result = index.shrsi %value, %count : index
  func.return %result : index
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @index_shift_arithmetic(%value: reg<amdgpu.sgpr>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %result = s_ashr_i32 %value, %count
  return %result
}

// ====

func.def @index_shift_bounded(%value: index, %count_input: index) -> (index, index, index) {
  %count = index.assume %count_input [range(%count_input, 0, 31)] : index
  %left = index.shli %value, %count : index
  %logical = index.shrui %value, %count : index
  %signed = index.shrsi %value, %count : index
  func.return %left, %logical, %signed : index, index, index
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @index_shift_bounded(%value: reg<amdgpu.sgpr>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %left = s_lshl_b32 %value, %count
  %logical = s_lshr_b32 %value, %count
  %signed = s_ashr_i32 %value, %count
  return %left, %logical, %signed
}

// ====

func.def @index_shift_constant_boundaries(%value: index) -> (index, index, index, index, index, index) {
  %identity_count = index.constant 0 : index
  %last = index.constant 31 : index
  %left_zero = index.shli %value, %identity_count : index
  %logical_zero = index.shrui %value, %identity_count : index
  %signed_zero = index.shrsi %value, %identity_count : index
  %left_last = index.shli %value, %last : index
  %logical_last = index.shrui %value, %last : index
  %signed_last = index.shrsi %value, %last : index
  func.return %left_zero, %logical_zero, %signed_zero, %left_last, %logical_last, %signed_last : index, index, index, index, index, index
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @index_shift_constant_boundaries(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %last = s_mov_b32 31
  %left_last = s_lshl_b32 %value, %last
  %logical_last = s_lshr_b32 %value, %last
  %signed_last = s_ashr_i32 %value, %last
  return %value, %value, %value, %left_last, %logical_last, %signed_last
}

// ====

func.def @index_shift_arithmetic_reuse(%value: index, %count: index) -> (index) {
  %shifted = index.shrsi %value, %count : index
  %with_count = index.add %shifted, %count : index
  %result = index.xori %with_count, %value : index
  func.return %result : index
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @index_shift_arithmetic_reuse(%value: reg<amdgpu.sgpr>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %shifted = s_ashr_i32 %value, %count
  %with_count = s_add_u32 %shifted, %count
  %result = s_xor_b32 %with_count, %value
  return %result
}
