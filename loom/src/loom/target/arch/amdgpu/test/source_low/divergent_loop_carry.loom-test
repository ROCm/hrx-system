  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %upper_bound_view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %value_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %loop_begin = s_mov_b32 0
  %loop_step = s_mov_b32 1
  %39 = v_lshlrev_b32_src0_inline %lane, 2
  %upper_bound = global_load_b32_saddr %39, %upper_bound_view
  %41 = v_mov_b32_copy %loop_begin
  %42 = v_mov_b32 0
  %44 = s_mov_b64_exec_read
  low.br ^_bb1(%41: reg<amdgpu.vgpr>, %42: reg<amdgpu.vgpr>)
^_bb1(%position: reg<amdgpu.vgpr>, %running_count: reg<amdgpu.vgpr>):
  %43 = v_cmp_lt_i32 %position, %upper_bound
  %45, %46 = s_and_saveexec_b64 %43
  low.cond_br %46, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %47 = v_lshlrev_b32_src0_inline %position, 2
  %value = global_load_b32_saddr %47, %value_view
  %next_count = v_add_u32 %running_count, %value
