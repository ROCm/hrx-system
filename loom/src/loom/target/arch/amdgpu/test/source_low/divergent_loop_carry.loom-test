// RUN: emit source-low output=low

amdgpu.target<gfx9-4-generic> @target

// An unproven loop bound requires per-lane state regardless of whether its
// exits feed scalar or vector selects.
func.def target(@target) @loop_carrier_late_vgpr_demand(%seed: i32, %count: i32, %true_vector: vector<2xi32>, %false_vector: vector<2xi32>) -> (i32, vector<2xi32>) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %choose = scalar.cmpi ne, %count, %c0 : i32
  %final_i, %final_value = scf.while(%i = %c0 : i32, %value = %seed : i32) -> (i32, i32) {
    %keep_going = scalar.cmpi slt, %i, %count : i32
    scf.condition %keep_going, %i, %value : i1, i32, i32
  } do(%i: i32, %value: i32) {
    %parity = scalar.andi %i, %c1 : i32
    %odd = scalar.cmpi ne, %parity, %c0 : i32
    %incremented = scalar.addi %value, %c1 : i32
    %next_value = scf.select %odd, %value, %incremented : i32
    %next_i = scalar.addi %i, %c1 : i32
    scf.yield %next_i, %next_value : i32, i32
  }
  %selected_value = scf.select %choose, %final_value, %seed : i32
  %selected_vector = scf.select %choose, %true_vector, %false_vector : vector<2xi32>
  func.return %selected_value, %selected_vector : i32, vector<2xi32>
}

// ----
low.func.def target<amdgpu.gfx9_4.generic.core>(@target) abi(hal_kernel) @loop_carrier_late_vgpr_demand(%seed: reg<amdgpu.vgpr>, %count: reg<amdgpu.vgpr>, %true_vector: reg<amdgpu.vgpr x2>, %false_vector: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>) asm {
  %choose = v_cmp_ne_i32_src1_inline %count {rhs = 0}
  %c0 = s_mov_b32 0
  %c1 = s_mov_b32 1
  %50 = v_mov_b32_copy %c0
  %52 = s_mov_b64_exec_read
  low.br ^_bb1(%50: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr>)
^_bb1(%i: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>):
  %51 = v_cmp_lt_i32 %i, %count
  %53, %54 = s_and_saveexec_b64 %51
  low.cond_br %54, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %parity = v_and_b32_src0_inline %i, 1
  %odd = v_cmp_ne_i32_src1_inline %parity {rhs = 0}
  %57 = v_mov_b32 1
  %incremented = v_add_u32 %value, %57
  %next_value = v_cndmask_b32 %incremented, %value, %odd
  %60 = v_add_u32 %c1, %i
  low.br ^_bb1(%60: reg<amdgpu.vgpr>, %next_value: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %52
  %selected_value = v_cndmask_b32 %seed, %value, %choose
  %62 = slice %true_vector[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %63 = slice %false_vector[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %64 = v_cndmask_b32 %63, %62, %choose
  %65 = slice %true_vector[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %66 = slice %false_vector[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %67 = v_cndmask_b32 %66, %65, %choose
  %selected_vector = concat(%64, %67) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %selected_value, %selected_vector
}

