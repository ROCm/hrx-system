  %c1 = s_mov_b32 1
  %39 = v_mov_b32_copy %c0
  %41 = s_mov_b64_exec_read
  low.br ^_bb1(%39: reg<amdgpu.vgpr>, %bits: reg<amdgpu.vgpr x2>)
^_bb1(%i: reg<amdgpu.vgpr>, %state: reg<amdgpu.vgpr x2>):
  %40 = v_cmp_lt_i32 %i, %iteration_count
  %42, %43 = s_and_saveexec_b64 %40
  low.cond_br %43, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %44 = slice %state[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %45 = slice %mask[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %46 = v_xor_b32 %44, %45
  %47 = slice %state[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %48 = slice %mask[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %49 = v_xor_b32 %47, %48
  %next_state = concat(%46, %49) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %51 = v_add_u32 %c1, %i
  low.br ^_bb1(%51: reg<amdgpu.vgpr>, %next_state: reg<amdgpu.vgpr x2>)
^_bb3:
  s_mov_b64_exec %41
  return %state
}

