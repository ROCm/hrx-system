amdgpu.target<gfx11-generic> @target {subgroup_size = 64}

kernel.def target(@target) @uniform_constant_exit_values() {
  %c1 = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch(%output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %origin = index.constant 0 : offset
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c4 = scalar.constant 4 : i32
  %mask = scalar.constant 3 : i32
  %success = scalar.constant 1 : i32
  %failure = scalar.constant -2 : i32
  %fallback = scalar.constant -4 : i32
  %lane_i32 = index.cast %lane : index to i32
  %target = scalar.andi %lane_i32, %mask : i32
  %output_view = buffer.view %output[%origin] : buffer -> view<64xi32>
  cfg.br ^header(%c0: i32)
^header(%counter: i32):
  %more = scalar.cmpi slt, %counter, %c4 : i32
  cfg.cond_br %more, ^body, ^normal_exit
^body:
  %matched = scalar.cmpi eq, %counter, %target : i32
  %odd = scalar.andi %lane_i32, %c1 : i32
  %failed = scalar.cmpi ne, %odd, %c0 : i32
  %not_failed = scalar.cmpi eq, %odd, %c0 : i32
  %matched_success = scalar.andi %matched, %not_failed : i1
  cfg.cond_br %matched_success, ^success_exit, ^failure_check
^success_exit:
  cfg.br ^merge(%success: i32)
^failure_check:
  %matched_failure = scalar.andi %matched, %failed : i1
  cfg.cond_br %matched_failure, ^failure_exit, ^latch
^failure_exit:
  cfg.br ^merge(%failure: i32)
^latch:
  %next = scalar.addi %counter, %c1 : i32
  cfg.br ^header(%next: i32)
^normal_exit:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  view.store %result, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

