  %lane = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %c0 = s_mov_b32 0
  %c1 = s_mov_b32 1
  %less = v_cmp_lt_i32 %lane, %limit
  %selected = v_cndmask_b32_src0_lit_src1_inline %less {imm32 = 0, true_value = 1}
  %48 = v_mov_b32 1
  %next_order = v_sub_nc_u32 %48, %selected
  %50 = v_mov_b32_copy %c0
  %51 = v_mov_b32 0
  %53 = s_mov_b64_exec_read
  low.br ^_bb1(%50: reg<amdgpu.vgpr>, %51: reg<amdgpu.vgpr>)
^_bb1(%i: reg<amdgpu.vgpr>, %final_order: reg<amdgpu.vgpr>):
  %52 = v_cmp_lt_i32 %i, %iteration_count
  %54, %55 = s_and_saveexec_b64 %52
  low.cond_br %55, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %56 = v_add_u32 %c1, %i
  low.br ^_bb1(%56: reg<amdgpu.vgpr>, %next_order: reg<amdgpu.vgpr>)
^_bb3:
  s_mov_b64_exec %53
  return %final_order
}

