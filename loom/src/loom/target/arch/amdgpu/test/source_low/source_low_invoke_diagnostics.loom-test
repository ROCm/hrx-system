// ====

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @condition_bit() -> (reg<amdgpu.scc>) asm {
  %word = s_mov_b32 1
  %truth = s_cmp_lg_i32_src1_inline %word {rhs = 0}
  return %truth
}

func.def target(@target) @wrong_numeric_result_class() -> (i16) {
  // ERROR@+1: TARGET/074 {callee_name="condition_bit", value_kind="result", actual_type="reg<amdgpu.vgpr>", expected_type="reg<amdgpu.scc>"}
  %result = low.invoke @condition_bit() : () -> (i16)
  func.return %result : i16
}
