amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @wide_helper(%value: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  return %value
}

func.def target(@target) @wrong_operand_type(%value: vector<1xi32>) -> (vector<2xi32>) {
  // ERROR@+1: TARGET/074 {callee_name="wide_helper", value_kind="operand", actual_type="reg<amdgpu.vgpr>", expected_type="reg<amdgpu.vgpr x2>"}
  %result = low.invoke @wide_helper(%value) : (vector<1xi32>) -> (vector<2xi32>)
  func.return %result : vector<2xi32>
}

// ====

amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @multiple_of_16(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) where [multiple_of(%value, 16)] asm {
  return %value
}

func.def target(@target) @unproven_precondition(%value: index) -> (index) {
  // ERROR@+1: TARGET/078 {callee_name="multiple_of_16", predicate_index="0", predicate_kind="multiple_of", proof_result="not proven"}
  %result = low.invoke @multiple_of_16(%value) : (index) -> (index)
  func.return %result : index
}

// ====

amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @multiple_of_16(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) where [multiple_of(%value, 16)] asm {
  return %value
}

func.def target(@target) @contradicted_precondition() -> (index) {
  %c3 = index.constant 3 : index
  // ERROR@+1: TARGET/078 {callee_name="multiple_of_16", predicate_index="0", predicate_kind="multiple_of", proof_result="proven false"}
  %result = low.invoke @multiple_of_16(%c3) : (index) -> (index)
  func.return %result : index
}

// ====

amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @ordered_pair(%lower: reg<amdgpu.sgpr>, %upper: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) where [le(%lower, %upper)] asm {
  return %lower, %upper
}

// A stronger relational caller contract proves the helper precondition even
// though neither argument has a scalar interval that proves the relation.
func.def target(@target) @proven_relational_precondition(%lower: index, %upper: index) -> (index, index) where [lt(%lower, %upper)] {
  %result_lower, %result_upper = low.invoke @ordered_pair(%lower, %upper) : (index, index) -> (index, index)
  func.return %result_lower, %result_upper : index, index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @proven_relational_precondition(%lower: reg<amdgpu.sgpr>, %upper: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) where [lt(%lower, %upper)] asm {
  %14, %15 = low.assume %lower, %upper [le(%lower, %upper)] : reg<amdgpu.sgpr>, reg<amdgpu.sgpr>
  %18 = copy %14 : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %19 = copy %15 : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  return %18, %19
}

// ====

// Diagnose omitted results at the lowering boundary before dead-call cleanup.
// RUN: pass source-to-low
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @unary_result(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  return %value
}

func.def target(@target) @wrong_result_count(%value: vector<1xi32>) -> (vector<1xi32>) {
  // ERROR@+1: TARGET/073 {callee_name="unary_result", value_kind="result", actual_count="0", expected_count="1"}
  low.invoke @unary_result(%value) : (vector<1xi32>)
  func.return %value : vector<1xi32>
}

// ====

amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @wide_result(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %wide = concat(%value, %value) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %wide
}

func.def target(@target) @wrong_result_type(%value: vector<1xi32>) -> (vector<1xi32>) {
  // ERROR@+1: TARGET/074 {callee_name="wide_result", value_kind="result", actual_type="reg<amdgpu.vgpr>", expected_type="reg<amdgpu.vgpr x2>"}
  %result = low.invoke @wide_result(%value) : (vector<1xi32>) -> (vector<1xi32>)
  func.return %result : vector<1xi32>
}

// ====

amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @cycle_a(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  // ERROR@+1: LOWERING/044 {op_name="low.func.call", phase_name="inline-callables", callee_name="cycle_b", failure_code="native_call_cycle"}
  %result = low.func.call @cycle_b(%value) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  return %result
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) @cycle_b(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  // ERROR@+1: LOWERING/044 {op_name="low.func.call", phase_name="inline-callables", callee_name="cycle_a", failure_code="native_call_cycle"}
  %result = low.func.call @cycle_a(%value) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  return %result
}

func.def target(@target) @recursive_closure_caller(%value: vector<1xi32>) -> (vector<1xi32>) {
  %result = low.invoke @cycle_a(%value) : (vector<1xi32>) -> (vector<1xi32>)
  func.return %result : vector<1xi32>
}

