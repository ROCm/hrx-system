// ====

// A declared numeric bank does not override the source payload width.
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @wide_scalar() -> (reg<amdgpu.sgpr x2>) asm {
  %word = s_mov_b32 1
  %pair = concat(%word, %word) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %pair
}

func.def target(@target) @wrong_narrow_result_width() -> (i8) {
  // ERROR@+1: TARGET/074 {callee_name="wide_scalar", value_kind="result", actual_type="reg<amdgpu.sgpr>", expected_type="reg<amdgpu.sgpr x2>"}
  %result = low.invoke @wide_scalar() : () -> (i8)
  func.return %result : i8
}

