func.def target(@target) @contradicted_precondition() -> (index) {
  %c3 = index.constant 3 : index
  // ERROR@+1: TARGET/078 {callee_name="multiple_of_16", predicate_index="0", predicate_kind="mul", proof_result="proven false"}
  %result = low.invoke @multiple_of_16(%c3) : (index) -> (index)
  func.return %result : index
