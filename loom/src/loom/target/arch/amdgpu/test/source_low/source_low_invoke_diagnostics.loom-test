// RUN: emit source-low output=low

amdgpu.target<gfx1151> @helper_target

amdgpu.target<gfx11-generic> @caller_target

low.func.def target<amdgpu.rdna3_5.core>(@helper_target) @exact_helper(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  return %value
}

func.def target(@caller_target) @generic_caller(%value: vector<1xi32>) -> (vector<1xi32>) {
  // ERROR@+1: TARGET/052 {function_name="exact_helper", authored_target_name="helper_target", specialization_target_name="gfx11-generic"}
  %result = low.invoke @exact_helper(%value) : (vector<1xi32>) -> (vector<1xi32>)
  func.return %result : vector<1xi32>
}

