  %20 = slice %lhs[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %21 = slice %rhs[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %22 = s_xor_b64 %20, %21
  %23 = slice %lhs[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %24 = slice %rhs[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %25 = s_xor_b64 %23, %24
  %sum = concat(%22, %25) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  %29 = s_and_b64 %20, %21
  %32 = s_and_b64 %23, %24
  %carry = concat(%29, %32) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  %36 = s_and_b64 %21, %22
  %39 = s_and_b64 %24, %25
  %borrow = concat(%36, %39) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  return %sum, %carry, %sum, %borrow
}

