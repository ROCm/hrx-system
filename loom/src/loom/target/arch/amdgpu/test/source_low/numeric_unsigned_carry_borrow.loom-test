// RUN: emit source-low @carry_borrow_i1 target=amdgpu:gfx1151 output=low

func.def @carry_borrow_i1(%lhs: i1, %rhs: i1) -> (i1, i1, i1, i1) {
  %sum, %carry = scalar.addcarryui %lhs, %rhs : i1
  %difference, %borrow = scalar.subborrowui %lhs, %rhs : i1
  func.return %sum, %carry, %difference, %borrow : i1, i1, i1, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @carry_borrow_i1(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.scc>, reg<amdgpu.scc>, reg<amdgpu.scc>, reg<amdgpu.scc>) asm {
  %20 = s_mov_b32 0
  %21 = s_xor_b32 %lhs, %rhs
  %sum = s_cmp_lg_i32 %21, %20
  %24 = s_and_b32 %lhs, %rhs
  %carry = s_cmp_lg_i32 %24, %20
  %27 = s_mov_b32 1
  %28 = s_cselect_b32 %27, %20, %sum
  %29 = s_and_b32 %rhs, %28
  %borrow = s_cmp_lg_i32 %29, %20
  return %sum, %carry, %sum, %borrow
}

// ====

// RUN: emit source-low @vector_carry_borrow_i1 target=amdgpu:gfx1151 output=low

func.def @vector_carry_borrow_i1(%lhs: vector<2xi1>, %rhs: vector<2xi1>) -> (vector<2xi1>, vector<2xi1>, vector<2xi1>, vector<2xi1>) {
  %sum, %carry = vector.addcarryui %lhs, %rhs : vector<2xi1> -> vector<2xi1>
  %difference, %borrow = vector.subborrowui %lhs, %rhs : vector<2xi1> -> vector<2xi1>
  func.return %sum, %carry, %difference, %borrow : vector<2xi1>, vector<2xi1>, vector<2xi1>, vector<2xi1>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @vector_carry_borrow_i1(%lhs: reg<amdgpu.sgpr x4>, %rhs: reg<amdgpu.sgpr x4>) -> (reg<amdgpu.sgpr x4>, reg<amdgpu.sgpr x4>, reg<amdgpu.sgpr x4>, reg<amdgpu.sgpr x4>) asm {
  %20 = slice %lhs[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %21 = slice %rhs[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %22 = s_xor_b64 %20, %21
  %23 = slice %lhs[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %24 = slice %rhs[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %25 = s_xor_b64 %23, %24
  %sum = concat(%22, %25) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  %29 = s_and_b64 %20, %21
  %32 = s_and_b64 %23, %24
  %carry = concat(%29, %32) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  %36 = s_and_b64 %21, %22
  %39 = s_and_b64 %24, %25
  %borrow = concat(%36, %39) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  return %sum, %carry, %sum, %borrow
}

