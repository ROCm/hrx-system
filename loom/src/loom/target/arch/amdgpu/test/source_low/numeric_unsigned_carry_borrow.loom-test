// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @varying_carry_borrow_i64(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %43 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %42 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %41 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %40 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22, %23 = v_add_co_u32 %43, %41
  %24, %carry = v_add_co_ci_u32 %42, %40, %23
  %sum = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %31, %32 = v_sub_co_u32 %43, %41
  %33, %borrow = v_sub_co_ci_u32 %42, %40, %32
  %difference = concat(%31, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %sum, %carry, %difference, %borrow
}

