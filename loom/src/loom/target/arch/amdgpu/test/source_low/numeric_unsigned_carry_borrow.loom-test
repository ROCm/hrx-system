// RUN: emit source-low @carry_borrow_i1 target=amdgpu:gfx1151 output=low

kernel.def @carry_borrow_i1() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs: i1, %rhs: i1, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<4x64xi32>
  %sum, %carry = scalar.addcarryui %lhs, %rhs : i1
  %difference, %borrow = scalar.subborrowui %lhs, %rhs : i1
  %stored_1_0 = scalar.extui %sum : i1 to i32
  view.store %stored_1_0, %captured[0, %capture_lane] : i32, view<4x64xi32>
  %stored_1_1 = scalar.extui %carry : i1 to i32
  view.store %stored_1_1, %captured[1, %capture_lane] : i32, view<4x64xi32>
  %stored_1_2 = scalar.extui %difference : i1 to i32
  view.store %stored_1_2, %captured[2, %capture_lane] : i32, view<4x64xi32>
  %stored_1_3 = scalar.extui %borrow : i1 to i32
  view.store %stored_1_3, %captured[3, %capture_lane] : i32, view<4x64xi32>
  kernel.return
}

