// RUN: emit source-low @add_with_input_carry_i32 target=amdgpu:gfx1151 output=low

// An unrestricted carry input requires two additions and combines both carry
// results. The first carry remains live across the second addition and must be
// preserved by physical register allocation.
kernel.def @add_with_input_carry_i32() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%lhs: i32, %rhs: i32, %carry_input: i32, %captured_buffer: buffer) {
  %capture_base = index.constant 0 : offset
  %capture_lane = kernel.workitem.id<x> : index
  %captured = buffer.view %captured_buffer[%capture_base] : buffer -> view<2x64xi32>
  %partial, %lhs_rhs_carry = scalar.addcarryui %lhs, %rhs : i32
  %sum, %input_carry = scalar.addcarryui %partial, %carry_input : i32
  %carry = scalar.ori %lhs_rhs_carry, %input_carry : i1
  %carry_word = scalar.extui %carry : i1 to i32
  view.store %sum, %captured[0, %capture_lane] : i32, view<2x64xi32>
  view.store %carry_word, %captured[1, %capture_lane] : i32, view<2x64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 3, direct_arg_count = 3, direct_arg_names = {arg0 = "lhs", arg1 = "rhs", arg2 = "carry_input"}, direct_arg_offsets = [0, 4, 8], direct_arg_parameter_indices = [0, 1, 2], direct_arg_sizes = [4, 4, 4], parameter_count = 4, resource_count = 1, resource_offsets = [16], resource_parameter_indices = [3], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @add_with_input_carry_i32(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %carry_input: reg<amdgpu.sgpr>) asm {
  %capture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %captured = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %partial, %lhs_rhs_carry = s_add_co_u32 %lhs, %rhs
  %sum, %input_carry = s_add_co_u32 %partial, %carry_input
  %30 = s_mov_b32 0
  %31 = s_mov_b32 1
  %32 = s_cselect_b32 %31, %30, %lhs_rhs_carry
  %33 = s_cselect_b32 %31, %30, %input_carry
  %34 = s_or_b32 %32, %33
  %carry = s_cmp_lg_i32 %34, %30
  %carry_word = s_cselect_b32 %31, %30, %carry
  %39 = v_mov_b32_copy %sum
  %40 = v_lshlrev_b32_src0_inline %capture_lane, 2
  global_store_b32_saddr %40, %39, %captured
  %41 = v_mov_b32_copy %carry_word
  global_store_b32_saddr %40, %41, %captured {offset = 256}
  return
}
