// RUN: emit source-low @varying_carry_borrow_i32 target=amdgpu:gfx1151 output=low

func.def @varying_carry_borrow_i32(%values: vector<2xi32>) -> (i32, i1, i32, i1) {
  %lhs = vector.extract %values[0] : vector<2xi32> -> i32
  %rhs = vector.extract %values[1] : vector<2xi32> -> i32
  %sum, %carry = scalar.addcarryui %lhs, %rhs : i32
  %difference, %borrow = scalar.subborrowui %lhs, %rhs : i32
  func.return %sum, %carry, %difference, %borrow : i32, i1, i32, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @varying_carry_borrow_i32(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %lhs = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %rhs = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %sum, %carry = v_add_co_u32 %lhs, %rhs
  %difference, %borrow = v_sub_co_u32 %lhs, %rhs
  return %sum, %carry, %difference, %borrow
}

