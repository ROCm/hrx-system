// RUN: emit source-low @vector_carry_borrow_i1 target=amdgpu:gfx1151 output=low

func.def @vector_carry_borrow_i1(%lhs: vector<2xi1>, %rhs: vector<2xi1>) -> (vector<2xi1>, vector<2xi1>, vector<2xi1>, vector<2xi1>) {
  %sum, %carry = vector.addcarryui %lhs, %rhs : vector<2xi1> -> vector<2xi1>
  %difference, %borrow = vector.subborrowui %lhs, %rhs : vector<2xi1> -> vector<2xi1>
  func.return %sum, %carry, %difference, %borrow : vector<2xi1>, vector<2xi1>, vector<2xi1>, vector<2xi1>
}

