// RUN: emit source-low @carry_borrow_i32 target=amdgpu:gfx1151 output=low

func.def @carry_borrow_i32(%lhs: i32, %rhs: i32) -> (i32, i1, i32, i1) {
  %sum, %carry = scalar.addcarryui %lhs, %rhs : i32
  %difference, %borrow = scalar.subborrowui %lhs, %rhs : i32
  func.return %sum, %carry, %difference, %borrow : i32, i1, i32, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @carry_borrow_i32(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.scc>, reg<amdgpu.sgpr>, reg<amdgpu.scc>) asm {
  %sum, %carry = s_add_co_u32 %lhs, %rhs
  %difference, %borrow = s_sub_co_u32 %lhs, %rhs
  return %sum, %carry, %difference, %borrow
}

// ====

// RUN: emit source-low @carry_borrow_i64 target=amdgpu:gfx1151 output=low

func.def @carry_borrow_i64(%lhs: i64, %rhs: i64) -> (i64, i1, i64, i1) {
  %sum, %carry = scalar.addcarryui %lhs, %rhs : i64
  %difference, %borrow = scalar.subborrowui %lhs, %rhs : i64
  func.return %sum, %carry, %difference, %borrow : i64, i1, i64, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @carry_borrow_i64(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.scc>, reg<amdgpu.sgpr x2>, reg<amdgpu.scc>) asm {
  %16 = slice %lhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = slice %lhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20, %21 = s_add_co_u32 %16, %18
  %22, %carry = s_addc_u32 %17, %19, %21
  %sum = concat(%20, %22) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %29, %30 = s_sub_co_u32 %16, %18
  %31, %borrow = s_subb_u32 %17, %19, %30
  %difference = concat(%29, %31) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %sum, %carry, %difference, %borrow
}

// ====

// RUN: emit source-low @varying_carry_borrow_i32 target=amdgpu:gfx1151 output=low

func.def @varying_carry_borrow_i32(%values: vector<2xi32>) -> (i32, i1, i32, i1) {
  %lhs = vector.extract %values[0] : vector<2xi32> -> i32
  %rhs = vector.extract %values[1] : vector<2xi32> -> i32
  %sum, %carry = scalar.addcarryui %lhs, %rhs : i32
  %difference, %borrow = scalar.subborrowui %lhs, %rhs : i32
  func.return %sum, %carry, %difference, %borrow : i32, i1, i32, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @varying_carry_borrow_i32(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %lhs = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %rhs = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %sum, %carry = v_add_co_u32 %lhs, %rhs
  %difference, %borrow = v_sub_co_u32 %lhs, %rhs
  return %sum, %carry, %difference, %borrow
}

// ====

// RUN: emit source-low @varying_carry_borrow_i64 target=amdgpu:gfx1151 output=low

func.def @varying_carry_borrow_i64(%values: vector<2xi64>) -> (i64, i1, i64, i1) {
  %lhs = vector.extract %values[0] : vector<2xi64> -> i64
  %rhs = vector.extract %values[1] : vector<2xi64> -> i64
  %sum, %carry = scalar.addcarryui %lhs, %rhs : i64
  %difference, %borrow = scalar.subborrowui %lhs, %rhs : i64
  func.return %sum, %carry, %difference, %borrow : i64, i1, i64, i1
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @varying_carry_borrow_i64(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.vgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %43 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %42 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %41 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %40 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22, %23 = v_add_co_u32 %43, %41
  %24, %carry = v_add_co_ci_u32 %42, %40, %23
  %sum = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %31, %32 = v_sub_co_u32 %43, %41
  %33, %borrow = v_sub_co_ci_u32 %42, %40, %32
  %difference = concat(%31, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %sum, %carry, %difference, %borrow
}

// ====

// RUN: emit source-low @add_with_input_carry_i32 target=amdgpu:gfx1151 output=low

// An unrestricted carry input requires two additions and combines both carry
// results. The first carry remains live across the second addition and must be
// preserved by physical register allocation.
func.def @add_with_input_carry_i32(%lhs: i32, %rhs: i32, %carry_input: i32) -> (i32, i32) {
  %partial, %lhs_rhs_carry = scalar.addcarryui %lhs, %rhs : i32
  %sum, %input_carry = scalar.addcarryui %partial, %carry_input : i32
  %carry = scalar.ori %lhs_rhs_carry, %input_carry : i1
  %carry_word = scalar.extui %carry : i1 to i32
  func.return %sum, %carry_word : i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @add_with_input_carry_i32(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %carry_input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %partial, %lhs_rhs_carry = s_add_co_u32 %lhs, %rhs
  %sum, %input_carry = s_add_co_u32 %partial, %carry_input
  %23 = s_mov_b32 0
  %24 = s_mov_b32 1
  %25 = s_cselect_b32 %24, %23, %lhs_rhs_carry
  %26 = s_cselect_b32 %24, %23, %input_carry
  %27 = s_or_b32 %25, %26
  %carry = s_cmp_lg_i32 %27, %23
  %carry_word = s_cselect_b32 %24, %23, %carry
  return %sum, %carry_word
}
