  %uniform = vector.load %view[0] : view<8xi32> -> vector<4xi32>
  %forward = vector.cmpi slt, %uniform, %varying : vector<4xi32> -> vector<4xi1>
  %reverse = vector.cmpi uge, %varying, %uniform : vector<4xi32> -> vector<4xi1>
  %forward_words = vector.extui %forward : vector<4xi1> to vector<4xi32>
  %reverse_words = vector.extui %reverse : vector<4xi1> to vector<4xi32>
  func.return %forward_words, %reverse_words : vector<4xi32>, vector<4xi32>
