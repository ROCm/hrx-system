// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Mixed widths, an unused slot, and a wide marker exercise the direct
// argument ABI. Raw stores observe the narrow payloads without conversions.
kernel.def @narrow_float_arguments() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%e4: f8E4M3, %unused: f16, %e5: f8E5M2, %marker: f64, %half: f16, %brain: bf16, %output: buffer) {
  %e4_base = index.constant 0 : offset
  %e4_view = buffer.view %output[%e4_base] : buffer -> view<1xf8E4M3>
  view.store %e4, %e4_view[0] : f8E4M3, view<1xf8E4M3>
  %e5_base = index.constant 1 : offset
  %e5_view = buffer.view %output[%e5_base] : buffer -> view<1xf8E5M2>
  view.store %e5, %e5_view[0] : f8E5M2, view<1xf8E5M2>
  %half_base = index.constant 2 : offset
  %half_view = buffer.view %output[%half_base] : buffer -> view<1xf16>
  view.store %half, %half_view[0] : f16, view<1xf16>
  %brain_base = index.constant 4 : offset
  %brain_view = buffer.view %output[%brain_base] : buffer -> view<1xbf16>
  view.store %brain, %brain_view[0] : bf16, view<1xbf16>
  %marker_base = index.constant 64 : offset
  %marker_view = buffer.view %output[%marker_base] : buffer -> view<1xf64>
  view.store %marker, %marker_view[0] : f64, view<1xf64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 7, direct_arg_count = 6, direct_arg_names = {arg0 = "e4", arg1 = "unused", arg2 = "e5", arg3 = "marker", arg4 = "half", arg5 = "brain"}, direct_arg_offsets = [0, 4, 8, 12, 20, 24], direct_arg_parameter_indices = [0, 1, 2, 3, 4, 5], direct_arg_payload_sizes = [1, 2, 1, 8, 2, 2], direct_arg_sizes = [4, 4, 4, 8, 4, 4], parameter_count = 7, resource_count = 1, resource_offsets = [32], resource_parameter_indices = [6], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @narrow_float_arguments(%e4: reg<amdgpu.sgpr>, %unused: reg<amdgpu.sgpr>, %e5: reg<amdgpu.sgpr>, %marker: reg<amdgpu.sgpr x2>, %half: reg<amdgpu.sgpr>, %brain: reg<amdgpu.sgpr>) asm {
  %marker_view = resource<hal_binding> {extent = 72, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %25 = v_mov_b32_copy %e4
  %26 = v_mov_b32 0
  global_store_b8_saddr %26, %25, %marker_view
  %27 = v_mov_b32_copy %e5
  global_store_b8_saddr %26, %27, %marker_view {offset = 1}
  %29 = v_mov_b32_copy %half
  global_store_short_saddr %26, %29, %marker_view {offset = 2}
  %31 = v_mov_b32_copy %brain
  global_store_short_saddr %26, %31, %marker_view {offset = 4}
  %33 = slice %marker[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = v_mov_b32_copy %33
  %35 = slice %marker[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = v_mov_b32_copy %35
  %37 = concat(%34, %36) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %26, %37, %marker_view {offset = 64}
  return
}

// ====

kernel.def @narrow_argument_bitcasts() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%e4_bits: i8, %unused: f16, %e5_bits: i8, %marker: f64, %half_bits: i16, %brain_bits: i16, %output: buffer) {
  %e4 = scalar.bitcast %e4_bits : i8 to f8E4M3
  %e5 = scalar.bitcast %e5_bits : i8 to f8E5M2
  %half = scalar.bitcast %half_bits : i16 to f16
  %brain = scalar.bitcast %brain_bits : i16 to bf16
  %e4_base = index.constant 0 : offset
  %e4_view = buffer.view %output[%e4_base] : buffer -> view<1xf8E4M3>
  view.store %e4, %e4_view[0] : f8E4M3, view<1xf8E4M3>
  %e5_base = index.constant 1 : offset
  %e5_view = buffer.view %output[%e5_base] : buffer -> view<1xf8E5M2>
  view.store %e5, %e5_view[0] : f8E5M2, view<1xf8E5M2>
  %half_base = index.constant 2 : offset
  %half_view = buffer.view %output[%half_base] : buffer -> view<1xf16>
  view.store %half, %half_view[0] : f16, view<1xf16>
  %brain_base = index.constant 4 : offset
  %brain_view = buffer.view %output[%brain_base] : buffer -> view<1xbf16>
  view.store %brain, %brain_view[0] : bf16, view<1xbf16>
  %marker_base = index.constant 64 : offset
  %marker_view = buffer.view %output[%marker_base] : buffer -> view<1xf64>
  view.store %marker, %marker_view[0] : f64, view<1xf64>
  kernel.return
}

