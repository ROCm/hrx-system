low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 7, direct_arg_count = 6, direct_arg_names = {arg0 = "e4_bits", arg1 = "unused", arg2 = "e5_bits", arg3 = "marker", arg4 = "half_bits", arg5 = "brain_bits"}, direct_arg_offsets = [0, 4, 8, 12, 20, 24], direct_arg_parameter_indices = [0, 1, 2, 3, 4, 5], direct_arg_payload_sizes = [1, 2, 1, 8, 2, 2], direct_arg_sizes = [4, 4, 4, 8, 4, 4], parameter_count = 7, resource_count = 1, resource_offsets = [32], resource_parameter_indices = [6], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @narrow_argument_bitcasts(%e4: reg<amdgpu.sgpr>, %unused: reg<amdgpu.sgpr>, %e5: reg<amdgpu.sgpr>, %marker: reg<amdgpu.sgpr x2>, %half: reg<amdgpu.sgpr>, %brain: reg<amdgpu.sgpr>) asm {
  %marker_view = resource<hal_binding> {extent = 72, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %29 = v_mov_b32_copy %e4
  %30 = v_mov_b32 0
  global_store_b8_saddr %30, %29, %marker_view
  %31 = v_mov_b32_copy %e5
  global_store_b8_saddr %30, %31, %marker_view {offset = 1}
  %33 = v_mov_b32_copy %half
  global_store_short_saddr %30, %33, %marker_view {offset = 2}
  %35 = v_mov_b32_copy %brain
  global_store_short_saddr %30, %35, %marker_view {offset = 4}
  %37 = slice %marker[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = v_mov_b32_copy %37
  %39 = slice %marker[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %40 = v_mov_b32_copy %39
  %41 = concat(%38, %40) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %30, %41, %marker_view {offset = 64}
  return
}
