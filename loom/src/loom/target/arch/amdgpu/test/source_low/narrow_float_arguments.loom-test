  %brain_f32 = scalar.extf %brain : bf16 to f32
  view.store %brain_f32, %f32_view[3] : f32, view<4xf32>
  %f64_base = index.constant 32 : offset
  %f64_view = buffer.view %output[%f64_base] : buffer -> view<4xf64>
  %e4_f64 = scalar.extf %e4 : f8E4M3 to f64
  view.store %e4_f64, %f64_view[0] : f64, view<4xf64>
  %e5_f64 = scalar.extf %e5 : f8E5M2 to f64
  view.store %e5_f64, %f64_view[1] : f64, view<4xf64>
  %half_f64 = scalar.extf %half : f16 to f64
  view.store %half_f64, %f64_view[2] : f64, view<4xf64>
  %brain_f64 = scalar.extf %brain : bf16 to f64
