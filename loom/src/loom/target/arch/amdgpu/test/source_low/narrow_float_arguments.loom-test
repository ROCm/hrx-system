  %e5_view = buffer.view %output[%e5_base] : buffer -> view<1xf8E5M2>
  view.store %e5, %e5_view[0] : f8E5M2, view<1xf8E5M2>
  %half_base = index.constant 2 : offset
  %half_view = buffer.view %output[%half_base] : buffer -> view<1xf16>
  view.store %half, %half_view[0] : f16, view<1xf16>
  %brain_base = index.constant 4 : offset
  %brain_view = buffer.view %output[%brain_base] : buffer -> view<1xbf16>
  view.store %brain, %brain_view[0] : bf16, view<1xbf16>
  %converted_half_base = index.constant 8 : offset
  %converted_half_view = buffer.view %output[%converted_half_base] : buffer -> view<2xf16>
  %e4_half = scalar.extf %e4 : f8E4M3 to f16
  view.store %e4_half, %converted_half_view[0] : f16, view<2xf16>
  %e5_half = scalar.extf %e5 : f8E5M2 to f16
  view.store %e5_half, %converted_half_view[1] : f16, view<2xf16>
  %f32_base = index.constant 16 : offset
  %f32_view = buffer.view %output[%f32_base] : buffer -> view<4xf32>
