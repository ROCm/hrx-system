amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @private_f16_static_and_dynamic_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<private> align(2) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2xf16>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<2xf16>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2xf16>
  %static_value = view.load %input_view[0] : view<2xf16> -> f16
  view.store %static_value, %scratch_view[0] : f16, view<2xf16>
  %dynamic_value = view.load %input_view[%lane] : view<2xf16> -> f16
  view.store %dynamic_value, %scratch_view[%lane] : f16, view<2xf16>
  %static_roundtrip = view.load %scratch_view[0] : view<2xf16> -> f16
  view.store %static_roundtrip, %output_view[0] : f16, view<2xf16>
  %dynamic_roundtrip = view.load %scratch_view[%lane] : view<2xf16> -> f16
  view.store %dynamic_roundtrip, %output_view[%lane] : f16, view<2xf16>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(2, 1, 1) workgroup_count(1, 1, 1) @private_f16_static_and_dynamic_roundtrip() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %18 = storage {byte_alignment = 2, byte_length = 4} : low.storage<private>
  %20 = v_mov_b32 0
  %static_value = global_load_d16_b16_saddr %20, %input_view
  %22 = v_bfe_u32_offset_0_width_16_low16 %static_value
  scratch_store_b16_vaddr %20, %22
  %24 = v_lshlrev_b32_src0_inline %lane, 1
  %dynamic_value = global_load_d16_b16_saddr %24, %input_view
  %26 = v_bfe_u32_offset_0_width_16_low16 %dynamic_value
  scratch_store_b16_vaddr %24, %26
  %static_roundtrip = scratch_load_u16_vaddr %20
  global_store_short_saddr %20, %static_roundtrip, %output_view
  %dynamic_roundtrip = scratch_load_u16_vaddr %24
  global_store_short_saddr %24, %dynamic_roundtrip, %output_view
  return
}

