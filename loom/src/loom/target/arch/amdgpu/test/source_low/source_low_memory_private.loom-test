  %second = buffer.alloca<private> align(4) %bytes : buffer
  %third = buffer.alloca<private> align(4) %bytes : buffer
  %selected, %selected_offset = scf.if %choose_pair -> (buffer, offset) {
    %nested, %nested_offset = scf.if %choose_first -> (buffer, offset) {
      scf.yield %first, %buffer_base : buffer, offset
    } else {
      scf.yield %second, %second_offset : buffer, offset
