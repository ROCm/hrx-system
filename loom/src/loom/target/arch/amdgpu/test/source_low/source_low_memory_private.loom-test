  %roundtrip = vector.load %selected_view[0] : view<2xi32> -> vector<2xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<8xi32>
  %output_index = index.shli %lane, %c1 : index
  vector.store %roundtrip, %output_view[%output_index] : vector<2xi32>, view<8xi32>
  kernel.return
}

