  scratch_store_b32_vaddr %29, %32 {offset = 16}
  %38 = v_lshlrev_b32_src0_inline %lane, 2
  %first_loaded = scratch_load_b32_vaddr %38
  %second_loaded = scratch_load_b32_vaddr %38 {offset = 12}
  global_store_b32_saddr %38, %first_loaded, %output_view
