amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @private_root_static_offsets() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %second_index_offset = index.constant 1 : index
  %first_bytes = index.constant 8 : offset
  %first = buffer.alloca<private> align(4) %first_bytes : buffer
  %second_bytes = index.constant 16 : offset
  %second = buffer.alloca<private> align(8) %second_bytes : buffer
  %first_view = buffer.view %first[%buffer_base] : buffer -> view<2xi32>
  %second_view = buffer.view %second[%buffer_base] : buffer -> view<4xi32>
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<4xi32>
  %lhs = view.load %input_view[0] : view<2xi32> -> i32
  view.store %lhs, %first_view[0] : i32, view<2xi32>
  %rhs = view.load %input_view[1] : view<2xi32> -> i32
  view.store %rhs, %first_view[1] : i32, view<2xi32>
  view.store %lhs, %second_view[1] : i32, view<4xi32>
  view.store %rhs, %second_view[2] : i32, view<4xi32>
  %second_index = index.add %lane, %second_index_offset : index
  %first_loaded = view.load %first_view[%lane] : view<2xi32> -> i32
  %second_loaded = view.load %second_view[%second_index] : view<4xi32> -> i32
  view.store %first_loaded, %output_view[%lane] : i32, view<4xi32>
  view.store %second_loaded, %output_view[%second_index] : i32, view<4xi32>
  kernel.return
}

