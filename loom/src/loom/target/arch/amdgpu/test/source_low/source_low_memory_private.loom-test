// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @private_f32_dynamic_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<private> align(4) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xf32>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xf32>
  %loaded = vector.load %input_view[%lane] : view<64xf32> -> vector<1xf32>
  vector.store %loaded, %scratch_view[%lane] : vector<1xf32>, view<64xf32>
  %roundtrip = vector.load %scratch_view[%lane] : view<64xf32> -> vector<1xf32>
  vector.store %roundtrip, %output_view[%lane] : vector<1xf32>, view<64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @private_f32_dynamic_roundtrip() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %16 = storage {byte_alignment = 4, byte_length = 256} : low.storage<private>
  %18 = v_lshlrev_b32_src0_inline %lane, 2
  %loaded = global_load_b32_saddr %18, %input_view
  scratch_store_b32_vaddr %18, %loaded
  %roundtrip = scratch_load_b32_vaddr %18
  global_store_b32_saddr %18, %roundtrip, %output_view
  return
}

// ====

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @private_root_static_offsets() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %second_index_offset = index.constant 1 : index
  %first_bytes = index.constant 8 : offset
  %first = buffer.alloca<private> align(4) %first_bytes : buffer
  %second_bytes = index.constant 16 : offset
  %second = buffer.alloca<private> align(8) %second_bytes : buffer
  %first_view = buffer.view %first[%buffer_base] : buffer -> view<2xi32>
  %second_view = buffer.view %second[%buffer_base] : buffer -> view<4xi32>
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<4xi32>
  %lhs = view.load %input_view[0] : view<2xi32> -> i32
  view.store %lhs, %first_view[0] : i32, view<2xi32>
  %rhs = view.load %input_view[1] : view<2xi32> -> i32
  view.store %rhs, %first_view[1] : i32, view<2xi32>
  view.store %lhs, %second_view[1] : i32, view<4xi32>
  view.store %rhs, %second_view[2] : i32, view<4xi32>
  %second_index = index.add %lane, %second_index_offset : index
  %first_loaded = view.load %first_view[%lane] : view<2xi32> -> i32
  %second_loaded = view.load %second_view[%second_index] : view<4xi32> -> i32
  view.store %first_loaded, %output_view[%lane] : i32, view<4xi32>
  view.store %second_loaded, %output_view[%second_index] : i32, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(2, 1, 1) workgroup_count(1, 1, 1) @private_root_static_offsets() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 8} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 16} : reg<amdgpu.sgpr x2>
  %23 = storage {byte_alignment = 4, byte_length = 8} : low.storage<private>
  %24 = storage {byte_alignment = 8, byte_length = 16} : low.storage<private>
  %27 = v_mov_b32 0
  %lhs = global_load_b32_saddr %27, %input_view
  scratch_store_b32_vaddr %27, %lhs
  %rhs = global_load_b32_saddr %27, %input_view {offset = 4}
  scratch_store_b32_vaddr %27, %rhs {offset = 4}
  scratch_store_b32_vaddr %27, %lhs {offset = 12}
  scratch_store_b32_vaddr %27, %rhs {offset = 16}
  %35 = v_lshlrev_b32_src0_inline %lane, 2
  %first_loaded = scratch_load_b32_vaddr %35
  %second_loaded = scratch_load_b32_vaddr %35 {offset = 12}
  global_store_b32_saddr %35, %first_loaded, %output_view
  global_store_b32_saddr %35, %second_loaded, %output_view {offset = 4}
  return
}

