low.kernel.def target<amdgpu.gfx11.generic.core>(@target) workgroup_size(2, 1, 1) workgroup_count(1, 1, 1) @private_i8_static_and_dynamic_roundtrip() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 2} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 2} : reg<amdgpu.sgpr x2>
  %18 = storage {byte_alignment = 1, byte_length = 2} : low.storage<private>
  %20 = v_mov_b32 0
  %static_value = global_load_i8_saddr %20, %input_view
  scratch_store_b8_vaddr %20, %static_value
  %dynamic_value = global_load_i8_saddr %lane, %input_view
  scratch_store_b8_vaddr %lane, %dynamic_value
  %static_roundtrip = scratch_load_i8_vaddr %20
  global_store_b8_saddr %20, %static_roundtrip, %output_view
  %dynamic_roundtrip = scratch_load_i8_vaddr %lane
  global_store_b8_saddr %lane, %dynamic_roundtrip, %output_view
  return
}
