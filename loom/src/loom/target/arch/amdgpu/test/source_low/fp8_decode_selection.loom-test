amdgpu.target<gfx950> @target

func.def target(@target) @scaled_odd_tail(%input: vector<3xf8E4M3>, %scale: f32) -> (vector<3xbf16>) {
  %wide = vector.extf %input : vector<3xf8E4M3> to vector<3xf32>
  %scale_vector = vector.splat %scale : vector<3xf32>
  %scaled = vector.mulf %wide, %scale_vector : vector<3xf32>
  %result = vector.fptrunc %scaled : vector<3xf32> to vector<3xbf16>
  func.return %result : vector<3xbf16>
}

