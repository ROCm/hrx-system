amdgpu.target<gfx942> @target

func.def target(@target) @native_fnuz_decode(%e4: vector<2xf8E4M3>, %e5: vector<2xf8E5M2>) -> (vector<2xf32>, vector<2xf32>) {
  %e4_schema = encoding.define #encoding.f8e4m3fnuz<payload_elements=2> : encoding<schema>
  %e5_schema = encoding.define #encoding.f8e5m2fnuz<payload_elements=2> : encoding<schema>
  %e4_decoded = vector.decode %e4 using %e4_schema : vector<2xf8E4M3>, encoding<schema> -> vector<2xf32>
  %e5_decoded = vector.decode %e5 using %e5_schema : vector<2xf8E5M2>, encoding<schema> -> vector<2xf32>
  func.return %e4_decoded, %e5_decoded : vector<2xf32>, vector<2xf32>
}

