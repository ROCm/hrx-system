  %23 = v_mov_b32_copy %21
  %24 = v_perm_b32 %22, %23, %14
  %25 = v_lshl_add_u32_shift_imm %24, %20, 8
  %26 = v_cmp_lt_u32_src1_inline %14 {rhs = 8}
  %27 = v_cndmask_b32 %16, %25, %26
  %28 = v_or_b32 %13, %27
  %29 = v_mov_b32 32704
  %30 = v_mov_b32 127
