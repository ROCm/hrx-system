amdgpu.target<gfx1250> @target

func.def target(@target) @native_f16_odd_tail(%input: vector<3xf8E4M3>, %output: buffer) {
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<3xf16>
  %decoded = vector.extf %input : vector<3xf8E4M3> to vector<3xf16>
  vector.store %decoded, %output_view[0] : vector<3xf16>, view<3xf16>
  func.return
}

func.def target(@target) @native_grouped_e8m0_decode(%e4: vector<16xf8E4M3>, %e5: vector<16xf8E5M2>, %scale: vector<1xi32>, %output: buffer) {
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<32xbf16>
  %e4_schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=16, scale_format=e8m0, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %e5_schema = encoding.define #encoding.f8e5m2<affine=scale_only, payload_elements=16, scale_format=e8m0, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %e4_decoded = vector.decode %e4 using %e4_schema {scale = %scale : vector<1xi32>} : vector<16xf8E4M3>, encoding<schema> -> vector<16xbf16>
  %e5_decoded = vector.decode %e5 using %e5_schema {scale = %scale : vector<1xi32>} : vector<16xf8E5M2>, encoding<schema> -> vector<16xbf16>
  vector.store %e4_decoded, %output_view[0] : vector<16xbf16>, view<32xbf16>
  vector.store %e5_decoded, %output_view[16] : vector<16xbf16>, view<32xbf16>
  func.return
}

