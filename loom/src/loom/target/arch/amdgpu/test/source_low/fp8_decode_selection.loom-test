low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @native_fnuz_decode(%e4: reg<amdgpu.vgpr>, %e5: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
