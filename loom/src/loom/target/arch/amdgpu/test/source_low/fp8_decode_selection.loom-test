  %16 = v_cvt_pk_f32_bf8 %e5
  %17 = slice %16[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = slice %16[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %e5_decoded = concat(%17, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %e4_decoded, %e5_decoded
}

