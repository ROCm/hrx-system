func.def target(@target) @varying_refined_offset_word(%values: vector<2xi64>) -> (i64, i64) {
  %raw = vector.extract %values[0] : vector<2xi64> -> i64
  %nonnegative = scalar.assume %raw [range(%raw, 0, 9223372036854775807)] : i64
  %address = index.cast %nonnegative : i64 to offset
  %bounded = index.assume %address [range(%address, 0, 4294967295)] : offset
  %word = index.cast %bounded : offset to i32
  %signed = scalar.extsi %word : i32 to i64
  %unsigned = scalar.extui %word : i32 to i64
  func.return %signed, %unsigned : i64, i64
}

