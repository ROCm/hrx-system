// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @uniform_refined_offset_word() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%address: offset, %result_buffer_0: buffer, %result_buffer_1: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xi64>
  %bounded = index.assume %address [range(%address, 0, 4294967295)] : offset
  %word = index.cast %bounded : offset to i32
  %signed = scalar.extsi %word : i32 to i64
  %unsigned = scalar.extui %word : i32 to i64
  view.store %signed, %result_view_0[%fixture_lane] : i64, view<64xi64>
  view.store %unsigned, %result_view_1[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

