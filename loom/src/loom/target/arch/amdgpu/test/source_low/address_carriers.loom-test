low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "address"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [8], parameter_count = 3, resource_count = 2, resource_offsets = [8, 16], resource_parameter_indices = [1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_refined_offset_word(%bounded: reg<amdgpu.sgpr x2>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result_view_1 = resource<hal_binding> {extent = 512, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %word = slice %bounded[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = s_ashr_i32_rhs_inline %word, 31
  %20 = s_mov_b32 0
  %23 = v_mov_b32_copy %word
  %25 = v_mov_b32_copy %18
  %26 = concat(%23, %25) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %27 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %27, %26, %result_view_0
  %31 = v_mov_b32_copy %20
  %32 = concat(%23, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %27, %32, %result_view_1
  return
}

