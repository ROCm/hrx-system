kernel.def target(@target) @uniform_wide_index_shift() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: i64, %count: index, %output: buffer) {
  %bounded = scalar.assume %value [range(%value, -8589934595, -8589934589)] : i64
  %coordinate = index.cast %bounded : i64 to index
  %shift = index.assume %count [range(%count, 0, 63)] : index
  %arithmetic = index.shrsi %coordinate, %shift : index
  %logical = index.shrui %coordinate, %shift : index
  %arithmetic_bits = index.cast %arithmetic : index to i64
  %logical_bits = index.cast %logical : index to i64
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<2xi64>
  view.store %arithmetic_bits, %results[0] : i64, view<2xi64>
  view.store %logical_bits, %results[1] : i64, view<2xi64>
  kernel.return
}

