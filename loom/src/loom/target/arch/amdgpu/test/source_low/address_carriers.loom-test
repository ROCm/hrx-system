  %logical = v_lshrrev_b64 %shift, %coordinate
  %22 = v_mov_b32 33
  %24 = v_ashrrev_i64 %22, %coordinate
  %word = slice %24[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  return %arithmetic, %logical, %word
}

