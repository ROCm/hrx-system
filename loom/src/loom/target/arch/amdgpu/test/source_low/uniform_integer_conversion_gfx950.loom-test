low.kernel.def target<amdgpu.cdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_i16_to_float() asm {
  %source = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %unsigned_target = resource<hal_binding> {extent = 32, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = s_mov_b32 0
  %value = s_load_dwordx2 %source, %16
  %18 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %20 = v_mov_b32_sdwa %19 {dst_sel = 6, dst_unused = 0, src0_sel = 4, src0_sext = 1}
  %21 = v_cvt_f32_i32 %20
  %24 = v_mov_b32_sdwa %19 {dst_sel = 6, dst_unused = 0, src0_sel = 5, src0_sext = 1}
  %25 = v_cvt_f32_i32 %24
  %26 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = v_mov_b32_copy %26
  %28 = v_mov_b32_sdwa %27 {dst_sel = 6, dst_unused = 0, src0_sel = 4, src0_sext = 1}
  %29 = v_cvt_f32_i32 %28
  %32 = v_mov_b32_sdwa %27 {dst_sel = 6, dst_unused = 0, src0_sel = 5, src0_sext = 1}
  %33 = v_cvt_f32_i32 %32
  %signed = concat(%21, %25, %29, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %37 = v_mov_b32_sdwa %19 {dst_sel = 6, dst_unused = 0, src0_sel = 4, src0_sext = 0}
  %38 = v_cvt_f32_u32 %37
  %41 = v_mov_b32_sdwa %19 {dst_sel = 6, dst_unused = 0, src0_sel = 5, src0_sext = 0}
  %42 = v_cvt_f32_u32 %41
  %45 = v_mov_b32_sdwa %27 {dst_sel = 6, dst_unused = 0, src0_sel = 4, src0_sext = 0}
  %46 = v_cvt_f32_u32 %45
  %49 = v_mov_b32_sdwa %27 {dst_sel = 6, dst_unused = 0, src0_sel = 5, src0_sext = 0}
  %50 = v_cvt_f32_u32 %49
  %unsigned = concat(%38, %42, %46, %50) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %52 = v_mov_b32 0
  global_store_dwordx4_saddr %52, %signed, %unsigned_target
  global_store_dwordx4_saddr %52, %unsigned, %unsigned_target {offset = 16}
  return
}
