// TEMPLATE: loom/src/loom/test/corpus/source_low/uniform_integer_conversion.loom-test
// RUN: emit source-low target=amdgpu:gfx950 output=low

kernel.def @uniform_i8_to_float() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %independent = buffer.assume.noalias %aligned : buffer
  %destination = buffer.assume.noalias %output : buffer
  %base = index.constant 0 : offset
  %unsigned_base = index.constant 32 : offset
  %source = buffer.view %independent[%base] : buffer -> view<8xi8>
  %signed_target = buffer.view %destination[%base] : buffer -> view<8xf32>
  %unsigned_target = buffer.view %destination[%unsigned_base] : buffer -> view<8xf32>
  %value = vector.load %source[0] : view<8xi8> -> vector<8xi8>
  %signed = vector.sitofp %value : vector<8xi8> to vector<8xf32>
  %unsigned = vector.uitofp %value : vector<8xi8> to vector<8xf32>
  vector.store %signed, %signed_target[0] : vector<8xf32>, view<8xf32>
  vector.store %unsigned, %unsigned_target[0] : vector<8xf32>, view<8xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_i8_to_float() asm {
  %source = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %unsigned_target = resource<hal_binding> {extent = 64, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = s_mov_b32 0
  %value = s_load_dwordx2 %source, %16
  %18 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %20 = v_mov_b32_sdwa %19 {dst_sel = 6, dst_unused = 0, src0_sel = 0, src0_sext = 1}
  %21 = v_cvt_f32_i32 %20
  %24 = v_mov_b32_sdwa %19 {dst_sel = 6, dst_unused = 0, src0_sel = 1, src0_sext = 1}
  %25 = v_cvt_f32_i32 %24
  %28 = v_mov_b32_sdwa %19 {dst_sel = 6, dst_unused = 0, src0_sel = 2, src0_sext = 1}
  %29 = v_cvt_f32_i32 %28
  %32 = v_mov_b32_sdwa %19 {dst_sel = 6, dst_unused = 0, src0_sel = 3, src0_sext = 1}
  %33 = v_cvt_f32_i32 %32
  %34 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = v_mov_b32_copy %34
  %36 = v_mov_b32_sdwa %35 {dst_sel = 6, dst_unused = 0, src0_sel = 0, src0_sext = 1}
  %37 = v_cvt_f32_i32 %36
  %40 = v_mov_b32_sdwa %35 {dst_sel = 6, dst_unused = 0, src0_sel = 1, src0_sext = 1}
  %41 = v_cvt_f32_i32 %40
  %44 = v_mov_b32_sdwa %35 {dst_sel = 6, dst_unused = 0, src0_sel = 2, src0_sext = 1}
  %45 = v_cvt_f32_i32 %44
  %48 = v_mov_b32_sdwa %35 {dst_sel = 6, dst_unused = 0, src0_sel = 3, src0_sext = 1}
  %49 = v_cvt_f32_i32 %48
  %52 = v_cvt_f32_ubyte0 %18
  %53 = v_cvt_f32_ubyte1 %18
  %54 = v_cvt_f32_ubyte2 %18
  %55 = v_cvt_f32_ubyte3 %18
  %57 = v_cvt_f32_ubyte0 %34
  %58 = v_cvt_f32_ubyte1 %34
  %59 = v_cvt_f32_ubyte2 %34
  %60 = v_cvt_f32_ubyte3 %34
  %73 = concat(%21, %25, %29, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %63 = v_mov_b32 0
  global_store_dwordx4_saddr %63, %73, %unsigned_target
  %72 = concat(%37, %41, %45, %49) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_dwordx4_saddr %63, %72, %unsigned_target {offset = 16}
  %71 = concat(%52, %53, %54, %55) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_dwordx4_saddr %63, %71, %unsigned_target {offset = 32}
  %70 = concat(%57, %58, %59, %60) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_dwordx4_saddr %63, %70, %unsigned_target {offset = 48}
  return
}

