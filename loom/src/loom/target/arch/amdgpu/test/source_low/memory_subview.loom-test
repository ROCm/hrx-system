func.def @subview_prefetch_strided(%input: buffer) {
  %base = index.constant 8 : offset
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %view = buffer.view %input[%base] : buffer -> view<4x8xi32, %layout>
  %outer = view.subview %view[1, 1] : view<4x8xi32, %layout> -> view<3x6xi32, %layout>
  %inner = view.subview %outer[1, 1] : view<3x6xi32, %layout> -> view<2x3xi32, %layout>
  view.prefetch %inner[0, 1] {intent = read, locality = l1} : view<2x3xi32, %layout>
  func.return
}

