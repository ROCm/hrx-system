func.def public @subview_composed_distinct_bindings(%input: buffer, %output: buffer, %first_width: index, %second_width: index) {
  %first_columns = index.assume %first_width [range(%first_width, 8, 12)] : index
  %second_columns = index.assume %second_width [range(%second_width, 8, 12)] : index
  %origin = index.constant 8 : offset
  %first_storage, %first_crop = func.call @make_storage_crop(%input, %origin, %first_columns) : (buffer, offset, index) -> (encoding<storage>, view<2x3xf32, %first_storage>)
  %second_storage, %second_crop = func.call @make_storage_crop(%input, %origin, %second_columns) : (buffer, offset, index) -> (encoding<storage>, view<2x3xf32, %second_storage>)
  %first = func.call @read_storage_crop(%first_storage, %first_crop) : (encoding<storage>, view<2x3xf32, %first_storage>) -> (f32)
  %second = func.call @read_storage_crop(%second_storage, %second_crop) : (encoding<storage>, view<2x3xf32, %second_storage>) -> (f32)
  %value = scalar.subf %first, %second : f32
  %output_origin = index.constant 4 : offset
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %destination = buffer.view %output_aligned[%output_origin] : buffer -> view<1xf32>
  view.store %value, %destination[0] : f32, view<1xf32>
  func.return
}

