  %view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 136} : reg<amdgpu.sgpr x2>
  %15 = v_mov_b32 0
  %16 = v_mov_b32 1
  global_atomic_add_u32_saddr %15, %16, %view {offset = 84, scope = 2}
  %old = global_atomic_add_u32_rtn_saddr %15, %16, %view {offset = 84, scope = 2}
  %22 = v_mov_b32 99
  %23 = concat(%22, %old) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %observed = global_atomic_cmpswap_b32_rtn_saddr %15, %23, %view {offset = 84, scope = 2}
  return %observed
}

