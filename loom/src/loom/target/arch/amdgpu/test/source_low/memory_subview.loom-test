low.func.def target<amdgpu.gfx12.generic.core> abi(hal_kernel) @subview_nested_dynamic(%origin: reg<amdgpu.sgpr x2>, %row_bounded: reg<amdgpu.sgpr>, %column_bounded: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %source_refined = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %26 = v_mov_b32 0
  %27 = slice %origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = s_lshl_b32_rhs_inline %row_bounded, 5
  %29 = s_add_u32 %27, %28
  %30 = s_lshl_b32_rhs_inline %column_bounded, 2
  %31 = s_add_u32 %29, %30
  %32 = slice %source_refined[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = slice %source_refined[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = s_mov_b32 0
  %35, %36 = s_add_co_u32 %32, %31
  %37, %38 = s_addc_u32 %33, %34, %36
  %39 = concat(%35, %37) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_b32_saddr %26, %39 {offset = 76}
  %43 = s_lshl_b32_rhs_inline %row_bounded, 5
  %44 = s_add_u32 %27, %43
  %45 = s_lshl_b32_rhs_inline %column_bounded, 2
  %46 = s_add_u32 %44, %45
  %47 = slice %destination[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %48 = slice %destination[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %50, %51 = s_add_co_u32 %47, %46
  %52, %53 = s_addc_u32 %48, %34, %51
  %54 = concat(%50, %52) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b32_saddr %26, %value, %54 {offset = 68}
