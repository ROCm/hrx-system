  %destination = buffer.view %output_aligned[%output_base] : buffer -> view<4x12xi32, %layout>
  %source_crop = view.subview %source[1, 2] : view<4x12xi32, %layout> -> view<2x8xi32, %layout>
  %destination_crop = view.subview %destination[1, 1] : view<4x12xi32, %layout> -> view<2x8xi32, %layout>
