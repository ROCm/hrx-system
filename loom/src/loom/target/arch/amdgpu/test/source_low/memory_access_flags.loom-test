// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_access_flags.loom-test
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @observe_scalar(%input: buffer) -> (i32, i32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<1xi32>
  %first = view.load<volatile> %source[0] : view<1xi32> -> i32
  %second = view.load<volatile> %source[0] : view<1xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_scalar() -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 0
  %first = global_load_b32_saddr<volatile> %11, %source
  %second = global_load_b32_saddr<volatile> %11, %source
  return %first, %second
}

// ====

func.def @observe_unused(%input: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_unused() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 8} : reg<amdgpu.sgpr x2>
  %7 = v_mov_b32 0
  %first = global_load_b32_saddr<volatile> %7, %source
  %second = global_load_b32_saddr<volatile> %7, %source {offset = 4}
  return
}

// ====

func.def @repeat_store(%output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %destination = buffer.view %aligned[%base] : buffer -> view<1xi32>
  view.store<volatile> %value, %destination[0] : i32, view<1xi32>
  view.store<volatile> %value, %destination[0] : i32, view<1xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @repeat_store(%value: reg<amdgpu.sgpr>) asm {
  %destination = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %7 = v_mov_b32_copy %value
  %8 = v_mov_b32 0
  global_store_b32_saddr<volatile> %8, %7, %destination
  global_store_b32_saddr<volatile> %8, %7, %destination
  return
}

// ====

func.def @observe_vector(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %source = buffer.view %source_aligned[%base] : buffer -> view<16xi32>
  %destination = buffer.view %destination_aligned[%base] : buffer -> view<32xi32>
  %first = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  %second = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  vector.store<volatile> %first, %destination[0] : vector<16xi32>, view<32xi32>
  vector.store<volatile> %second, %destination[16] : vector<16xi32>, view<32xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_vector() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 64} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 128} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 0
  %12 = global_load_b128_saddr<volatile> %11, %source
  %14 = global_load_b128_saddr<volatile> %11, %source {offset = 16}
  %16 = global_load_b128_saddr<volatile> %11, %source {offset = 32}
  %18 = global_load_b128_saddr<volatile> %11, %source {offset = 48}
  %21 = global_load_b128_saddr<volatile> %11, %source
  %23 = global_load_b128_saddr<volatile> %11, %source {offset = 16}
  %25 = global_load_b128_saddr<volatile> %11, %source {offset = 32}
  %27 = global_load_b128_saddr<volatile> %11, %source {offset = 48}
  global_store_b128_saddr<volatile> %11, %12, %destination
  global_store_b128_saddr<volatile> %11, %14, %destination {offset = 16}
  global_store_b128_saddr<volatile> %11, %16, %destination {offset = 32}
  global_store_b128_saddr<volatile> %11, %18, %destination {offset = 48}
  global_store_b128_saddr<volatile> %11, %21, %destination {offset = 64}
  global_store_b128_saddr<volatile> %11, %23, %destination {offset = 80}
  global_store_b128_saddr<volatile> %11, %25, %destination {offset = 96}
  global_store_b128_saddr<volatile> %11, %27, %destination {offset = 112}
  return
}

// ====

func.def @observe_byte(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi8>
  %first = view.load<volatile> %source[0] : view<1xi8> -> i8
  %second = view.load<volatile> %source[0] : view<1xi8> -> i8
  view.store<volatile> %first, %destination[0] : i8, view<2xi8>
  view.store<volatile> %second, %destination[1] : i8, view<2xi8>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_byte() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 1} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 2} : reg<amdgpu.sgpr x2>
  %9 = v_mov_b32 0
  %first = global_load_i8_saddr<volatile> %9, %source
  %second = global_load_i8_saddr<volatile> %9, %source
  global_store_b8_saddr<volatile> %9, %first, %destination
  global_store_b8_saddr<volatile> %9, %second, %destination {offset = 1}
  return
}

// ====

func.def @observe_dynamic_address(%input: buffer, %byte_offset: offset) -> (i32, i32) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 4092), mul(%byte_offset, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_dynamic_address(%base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = v_mov_b32 0
  %14 = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17 = s_mov_b32 0
  %18, %19 = s_add_co_u32 %15, %14
  %20, %21 = s_addc_u32 %16, %17, %19
  %22 = concat(%18, %20) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %first = global_load_b32_saddr<volatile> %13, %22
  %29, %30 = s_add_co_u32 %15, %14
  %31, %32 = s_addc_u32 %16, %17, %30
  %33 = concat(%29, %31) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %second = global_load_b32_saddr<volatile> %13, %33 {offset = 4}
  return %first, %second
}

// ====

func.def @ordinary_scalar(%input: buffer) -> (i32, i32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<1xi32>
  %first = view.load %source[0] : view<1xi32> -> i32
  %second = view.load %source[0] : view<1xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @ordinary_scalar() -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 0
  %first = global_load_b32_saddr %11, %source
  return %first, %first
}
