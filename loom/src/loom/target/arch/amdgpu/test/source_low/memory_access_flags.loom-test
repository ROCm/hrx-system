// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @observe_unused(%input: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_unused() asm {
  %source = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %7 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %8 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %9 = v_mov_b32_copy %7
  %10 = v_mov_b32_copy %8
  %11 = concat(%9, %10) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %first = global_load_b32_vaddr<volatile> %11
  %17 = concat(%9, %10) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %second = global_load_b32_vaddr<volatile> %17 {offset = 4}
  return
}

// ====

func.def @observe_vector(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %source = buffer.view %source_aligned[%base] : buffer -> view<16xi32>
  %destination = buffer.view %destination_aligned[%base] : buffer -> view<32xi32>
  %first = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  %second = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  vector.store<volatile> %first, %destination[0] : vector<16xi32>, view<32xi32>
  vector.store<volatile> %second, %destination[16] : vector<16xi32>, view<32xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_vector() asm {
  %source = resource<hal_binding> {extent = 64, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 128, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %11 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = v_mov_b32_copy %11
  %14 = v_mov_b32_copy %12
  %15 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %16 = global_load_b128_vaddr<volatile> %15
  %21 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %22 = global_load_b128_vaddr<volatile> %21 {offset = 16}
  %27 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %28 = global_load_b128_vaddr<volatile> %27 {offset = 32}
  %33 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %34 = global_load_b128_vaddr<volatile> %33 {offset = 48}
  %40 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %41 = global_load_b128_vaddr<volatile> %40
  %46 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %47 = global_load_b128_vaddr<volatile> %46 {offset = 16}
  %52 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %53 = global_load_b128_vaddr<volatile> %52 {offset = 32}
  %58 = concat(%13, %14) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %59 = global_load_b128_vaddr<volatile> %58 {offset = 48}
  %62 = slice %destination[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %63 = slice %destination[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %64 = v_mov_b32_copy %62
  %65 = v_mov_b32_copy %63
  %66 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr<volatile> %66, %16
  %72 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr<volatile> %72, %22 {offset = 16}
  %78 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr<volatile> %78, %28 {offset = 32}
  %84 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr<volatile> %84, %34 {offset = 48}
  %90 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr<volatile> %90, %41 {offset = 64}
  %96 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr<volatile> %96, %47 {offset = 80}
  %102 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr<volatile> %102, %53 {offset = 96}
  %108 = concat(%64, %65) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b128_vaddr<volatile> %108, %59 {offset = 112}
  return
}

// ====

func.def @observe_byte(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi8>
  %first = view.load<volatile> %source[0] : view<1xi8> -> i8
  %second = view.load<volatile> %source[0] : view<1xi8> -> i8
  view.store<volatile> %first, %destination[0] : i8, view<2xi8>
  view.store<volatile> %second, %destination[1] : i8, view<2xi8>
  func.return
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_byte() asm {
  %source = resource<hal_binding> {extent = 1, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 2, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %9 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %10 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = v_mov_b32_copy %9
  %12 = v_mov_b32_copy %10
  %13 = concat(%11, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %first = global_load_u8_vaddr<volatile> %13
  %19 = concat(%11, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %second = global_load_u8_vaddr<volatile> %19
  %21 = slice %destination[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = slice %destination[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %21
  %24 = v_mov_b32_copy %22
  %25 = concat(%23, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b8_vaddr<volatile> %25, %first
  %30 = concat(%23, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b8_vaddr<volatile> %30, %second {offset = 1}
  return
}

// ====

func.def @observe_dynamic_address(%input: buffer, %byte_offset: offset) -> (i32, i32) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 4092), multiple_of(%byte_offset, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @observe_dynamic_address(%base: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %13 = slice %base[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = slice %base[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %15 = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %17, %18 = v_add_co_u32 %15, %13
  %19 = v_mov_b32_copy %16
  %20, %21 = v_add_co_ci_u32 %19, %14, %18
  %22 = concat(%17, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %first = global_load_b32_vaddr<volatile> %22
  %33 = concat(%17, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %second = global_load_b32_vaddr<volatile> %33 {offset = 4}
  return %first, %second
}
