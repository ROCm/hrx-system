low.kernel.def target(@target) workgroup_size(64, 1, 1) @fp8_mfma_gfx950_fragment_memory() asm<amdgpu.cdna4.core> {
  %18 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %rhs_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %out_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 1024} : reg<amdgpu.sgpr x2>
  %22 = v_and_b32_src0_inline %18, 15
  %23 = v_lshrrev_b32_src0_inline %18, 4
  %24 = v_lshlrev_b32_src0_inline %23, 3
  %25 = v_lshlrev_b32_src0_inline %22, 5
  %26 = v_add_u32 %24, %25
  %27 = s_mov_b32_m0_imm 0
  %lhs = global_load_dwordx2_saddr %26, %lhs_view, %27
  %34 = s_mov_b32_m0_imm 0
  %rhs = global_load_dwordx2_saddr %26, %rhs_view, %34
  %36 = v_mov_b32 0
  %init = concat(%36, %36, %36, %36) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %41 = copy %init : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %result = v_mfma_f32_16x16x32_fp8_fp8 %lhs, %rhs, %41
  %45 = v_lshlrev_b32_src0_inline %23, 8
  %46 = v_lshlrev_b32_src0_inline %22, 2
  %47 = v_add_u32 %45, %46
  %48 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %49 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %47, %48, %out_view, %49
  %50 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %51 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %47, %50, %out_view, %51 {offset = 64}
  %52 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %53 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %47, %52, %out_view, %53 {offset = 128}
  %54 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %55 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %47, %54, %out_view, %55 {offset = 192}
  return
}

