  %n = index.constant 32 : index
  %k = index.constant 16 : index
  %rhs_layout = encoding.layout.strided [1, 16] : encoding<layout>
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<32x16xf16, #dense>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<16x32xf16, %rhs_layout>
