  low.br ^_bb1(%65: reg<amdgpu.sgpr>, %next0: reg<amdgpu.vgpr x4>, %next1: reg<amdgpu.vgpr x4>, %next2: reg<amdgpu.vgpr x4>, %next3: reg<amdgpu.vgpr x4>)
