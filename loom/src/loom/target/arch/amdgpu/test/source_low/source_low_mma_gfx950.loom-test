    %next1 = vector.mma %lhs, %rhs, %acc1 : vector<8xf16>, vector<8xf16>, vector<4xf32>
    %next2 = vector.mma %lhs, %rhs, %acc2 : vector<8xf16>, vector<8xf16>, vector<4xf32>
    %next3 = vector.mma %lhs, %rhs, %acc3 : vector<8xf16>, vector<8xf16>, vector<4xf32>
    scf.yield %next0, %next1, %next2, %next3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }
  func.return %result0, %result1, %result2, %result3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
}

