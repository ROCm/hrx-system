  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<32x16xf16, #dense> -> vector<8xf16>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<16x32xf16, %rhs_layout> -> vector<8xf16>
  %zero_acc = vector.constant 0.0 : vector<16xf32>
  %init = vector.fragment<init> %zero_acc shape [%m, %n] : vector<16xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<8xf16>, vector<8xf16>, vector<16xf32>
  vector.fragment.store<result> %result, %out_view[0, 0] shape [%m, %n] : vector<16xf32>, view<32x32xf32, #dense>
  kernel.return
}

