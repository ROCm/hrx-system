low.func.def target(@target) abi(hal_kernel) @fp8_fp8_smfmac_gfx950(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x8>, %init: reg<amdgpu.vgpr x4>, %sparsity: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm<amdgpu.cdna4.core> {
  %19 = copy %init : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %result = v_smfmac_f32_16x16x128_fp8_fp8 %19, %lhs, %rhs, %sparsity
  return %result
}
