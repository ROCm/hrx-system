  global_store_dword_saddr %55, %result, %destination
  return
}

// ====

amdgpu.target<gfx942> @target

// Fused arithmetic permutes the first operand. Exclusive shifting still
// crosses row boundaries after both vector components have complete suffixes.
kernel.def target(@target) @subgroup_scan_reverse_vector() {
  %unit = index.constant 1 : index
  %items = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<64x2xf32>
  %destination = buffer.view %output[%base] : buffer -> view<64x2xf32>
  %value = vector.load %source[%item, 0] : view<64x2xf32> -> vector<2xf32>
  %result = kernel.subgroup.scan<minnumf> %value {direction = reverse, mode = exclusive} : vector<2xf32>
  vector.store %result, %destination[%item, 0] : vector<2xf32>, view<64x2xf32>
  kernel.return
}

