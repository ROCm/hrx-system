// ====

amdgpu.target<gfx11-generic> @target

// A partial final row changes reverse participation. Cross-wave composition
// preserves nonempty totals and uses the partition-wide predecessor guard.
kernel.def target(@target) @workgroup_scan_reverse_partial_rows() {
  %unit = index.constant 1 : index
  %items = index.constant 83 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<83xf32>
  %destination = buffer.view %output[%base] : buffer -> view<83xf32>
  %value = view.load %source[%item] : view<83xf32> -> f32
  %result = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = exclusive} : f32
  view.store %result, %destination[%item] : f32, view<83xf32>
  kernel.return
}

