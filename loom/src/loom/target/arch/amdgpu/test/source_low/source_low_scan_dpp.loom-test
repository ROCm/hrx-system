// RUN: emit source-low output=low

amdgpu.target<gfx942> @target

// Legacy DPP moves scan each row; two boundary exchanges complete a wave64
// prefix without substituting an empty value for a missing predecessor.
kernel.def target(@target) @subgroup_scan_integer_rows() {
  %unit = index.constant 1 : index
  %items = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<64xi32>
  %destination = buffer.view %output[%base] : buffer -> view<64xi32>
  %value = view.load %source[%item] : view<64xi32> -> i32
  %result = kernel.subgroup.scan<addi> %value {direction = forward, mode = inclusive} : i32
  view.store %result, %destination[%item] : i32, view<64xi32>
  kernel.return
}

