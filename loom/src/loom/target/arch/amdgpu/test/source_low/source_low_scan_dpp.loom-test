  %17 = v_mov_b32 1
  %19 = v_cmp_ge_u32 %16, %17
  %20 = v_mov_b32 2
  %22 = v_cmp_ge_u32 %16, %20
  %23 = v_mov_b32 4
  %25 = v_cmp_ge_u32 %16, %23
  %26 = v_mov_b32 8
  %28 = v_cmp_ge_u32 %16, %26
  %29 = v_mov_b32 16
  %30 = v_sub_u32 %15, %29
  %31 = v_cmp_ge_u32 %15, %29
  %32 = v_lshlrev_b32_src0_inline %30, 2
  %33 = v_mov_b32 32
  %34 = v_sub_u32 %15, %33
  %35 = v_cmp_ge_u32 %15, %33
  %36 = v_lshlrev_b32_src0_inline %34, 2
  %37 = v_mov_b32_dpp %value {dpp_ctrl = 273}
  %38 = v_add_u32 %value, %37
  %39 = v_cndmask_b32 %value, %38, %19
  %40 = v_mov_b32_dpp %39 {dpp_ctrl = 274}
  %41 = v_add_u32 %39, %40
  %42 = v_cndmask_b32 %39, %41, %22
  %43 = v_mov_b32_dpp %42 {dpp_ctrl = 276}
  %44 = v_add_u32 %42, %43
  %45 = v_cndmask_b32 %42, %44, %25
  %46 = v_mov_b32_dpp %45 {dpp_ctrl = 280}
  %47 = v_add_u32 %45, %46
