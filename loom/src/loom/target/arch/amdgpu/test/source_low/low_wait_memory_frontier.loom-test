// RUN: emit amdgpu-assembly @nested_read_after_write_gfx942

// The outer effect is completed in the prologue. Its static backedge state
// cannot reintroduce that dependency into the inner loop.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @nested_read_after_write_gfx942(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %payload: reg<amdgpu.vgpr>, %count: reg<amdgpu.sgpr>) asm {
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^prologue
^prologue:
  %value = global_load_dword_saddr %address, %base : reg<amdgpu.vgpr>
  low.br ^inner(%begin: reg<amdgpu.sgpr>)
^inner(%index: reg<amdgpu.sgpr>):
  %next = global_load_dword_saddr %address, %base : reg<amdgpu.vgpr>
  %advanced = s_add_u32 %index, %step
  %more = s_cmp_lt_i32 %advanced, %count
  low.cond_br %more, ^backedge, ^tail : reg<amdgpu.scc>
^backedge:
  low.br ^inner(%advanced: reg<amdgpu.sgpr>)
^tail:
  global_store_dword_saddr %address, %payload, %base
  %repeat = s_cmp_lt_i32 %begin, %count
  low.cond_br %repeat, ^prologue, ^exit : reg<amdgpu.scc>
^exit:
  return
}

// ----
  s_mov_b32 s3, 0
  s_mov_b32 s4, 1
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  global_load_dword v2, v0, s[0:1] offset:0
  s_mov_b32 s5, s3
.Lbb2:
  global_load_dword v2, v0, s[0:1] offset:0
  s_add_u32 s5, s5, s4
  s_cmp_lt_i32 s5, s2
  s_cbranch_scc0 .Lbb4
.Lbb3:
  s_branch .Lbb2
.Lbb4:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  global_store_dword v0, v1, s[0:1] offset:0
  s_cmp_lt_i32 s3, s2
  s_cbranch_scc1 .Lbb1
.Lbb5:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

