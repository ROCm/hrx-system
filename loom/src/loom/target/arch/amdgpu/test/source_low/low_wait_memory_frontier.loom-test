// ====
// RUN: emit amdgpu-assembly @nested_bypassed_read

// Incoming completion is path- and memory-space-specific. New producers
// belong to the local outgoing state and survive the incoming-state filter.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @nested_bypassed_read(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %payload: reg<amdgpu.vgpr>, %count: reg<amdgpu.sgpr>) asm {
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  global_store_dword_saddr %address, %payload, %base
  %skip = s_cmp_lt_i32 %begin, %count
  low.cond_br %skip, ^prologue, ^skip : reg<amdgpu.scc>
^prologue:
  %seed = global_load_dword_saddr %address, %base : reg<amdgpu.vgpr>
  low.br ^inner(%begin: reg<amdgpu.sgpr>)
^skip:
  low.br ^inner(%begin: reg<amdgpu.sgpr>)
^inner(%index: reg<amdgpu.sgpr>):
  %next = global_load_dword_saddr %address, %base : reg<amdgpu.vgpr>
  %advanced = s_add_u32 %index, %step
  %more = s_cmp_lt_i32 %advanced, %count
  low.cond_br %more, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^inner(%advanced: reg<amdgpu.sgpr>)
^exit:
  return
}

// ----
  global_store_dword v1, v0, s[0:1] offset:0
  s_mov_b32 s3, 0
  s_cmp_lt_i32 s3, s2
  s_mov_b32 s4, 1
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  global_load_dword v0, v1, s[0:1] offset:0
  s_branch .Lbb3
.Lbb2:
.Lbb3:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  global_load_dword v0, v1, s[0:1] offset:0
  s_add_u32 s3, s3, s4
  s_cmp_lt_i32 s3, s2
  s_cbranch_scc0 .Lbb5
.Lbb4:
  s_branch .Lbb3
.Lbb5:
  s_endpgm

