// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// Positive quotient and negative remainder divisors cover both signed
// numerator adjustments and the two-word remainder reconstruction on SGPRs.
func.def target(@target) @uniform_wide_signed_division(%value: i64) -> (i64, i64) {
  %c5 = scalar.constant 5 : i64
  %cn3 = scalar.constant -3 : i64
  %quotient = scalar.divsi %value, %c5 : i64
  %remainder = scalar.remsi %value, %cn3 : i64
  func.return %quotient, %remainder : i64, i64
}

