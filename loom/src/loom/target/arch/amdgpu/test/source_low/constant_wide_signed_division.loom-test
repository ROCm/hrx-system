// ====

amdgpu.target<gfx942> @target

// A vector extract forces the varying carrier through the same retained
// reciprocal recipe.
func.def target(@target) @varying_wide_signed_division(%values: vector<2xi64>) -> (i64, i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %cn5 = scalar.constant -5 : i64
  %c3 = scalar.constant 3 : i64
  %quotient = scalar.divsi %value, %cn5 : i64
  %remainder = scalar.remsi %value, %c3 : i64
  func.return %quotient, %remainder : i64, i64
}

