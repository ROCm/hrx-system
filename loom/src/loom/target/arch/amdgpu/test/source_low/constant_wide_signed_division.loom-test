// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// Positive quotient and negative remainder divisors cover both signed
// numerator adjustments and the two-word remainder reconstruction on SGPRs.
kernel.def target(@target) @uniform_wide_signed_division() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%value: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<2x64xi64>
  %c5 = scalar.constant 5 : i64
  %cn3 = scalar.constant -3 : i64
  %quotient = scalar.divsi %value, %c5 : i64
  %remainder = scalar.remsi %value, %cn3 : i64
  view.store %quotient, %result_view_0[0, %fixture_lane] : i64, view<2x64xi64>
  view.store %remainder, %result_view_0[1, %fixture_lane] : i64, view<2x64xi64>
  kernel.return
}

