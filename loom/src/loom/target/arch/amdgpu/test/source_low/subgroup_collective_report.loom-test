CHECK: COMPILE-REPORT: target_legalization[*] function=report_subgroup_match_any_i32_wave32 source_op=kernel.subgroup.match.any * action=rewritten outcome=target-rewrite * legalizer=amdgpu strategy=target * created_ops=388 erased_ops=1

