// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @rounded_unknown_f32_to_f16(%input: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %5 = slice %input[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %6 = v_cvt_f16_f32 %5
  %7 = v_bfe_u32_offset_0_width_inline_low16 %6
  %8 = slice %input[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %9 = v_cvt_f16_f32 %8
  %10 = v_bfe_u32_offset_0_width_inline_low16 %9
  %narrow = v_lshl_add_u32_shift_imm %10, %7, 16
  return %narrow
}
