amdgpu.target<gfx942> @target

func.def target(@target) @exact_i8_to_bf16_without_literal_permute(%input: vector<3xi8>) -> (vector<3xbf16>) {
  %wide = vector.sitofp %input : vector<3xi8> to vector<3xf32>
