// ----
low.func.def target<amdgpu.rdna3.core>(@target) abi(hal_kernel) @rounded_i16_to_bf16(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %6 = v_bfe_i32_offset_width_inline %input {offset = 0, width = 16}
  %7 = v_cvt_f32_i32 %6
  %8 = v_ashrrev_i32_src0_inline %input, 16
  %9 = v_cvt_f32_i32 %8
  %13 = v_lshrrev_b32_src0_inline %7, 16
  %14 = v_and_b32_src0_inline %13, 1
  %15 = v_add3_u32_src2_lit %7, %14, 32767
  %16 = v_lshrrev_b32_src0_inline %15, 16
  %17 = v_lshrrev_b32_src0_inline %9, 16
  %18 = v_and_b32_src0_inline %17, 1
  %19 = v_add3_u32_src2_lit %9, %18, 32767
  %20 = v_lshrrev_b32_src0_inline %19, 16
  %narrow = v_cvt_pk_u16_u32 %16, %20
  return %narrow
}

