func.def target(@target) @varying_operands(%values: vector<2xi32>) -> (i32) {
  %lhs = vector.extract %values[0] : vector<2xi32> -> i32
  %rhs = vector.extract %values[1] : vector<2xi32> -> i32
  %position = index.cast %lhs : i32 to index
  %step = index.cast %rhs : i32 to index
  %next = index.add %position, %step : index
  %result = index.cast %next : index to i32
  func.return %result : i32
}

