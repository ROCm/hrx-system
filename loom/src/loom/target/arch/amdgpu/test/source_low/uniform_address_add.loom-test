amdgpu.target<gfx11-generic> @target

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 2, direct_arg_names = {arg0 = "position", arg1 = "step"}, direct_arg_offsets = [0, 4], direct_arg_parameter_indices = [0, 1], direct_arg_sizes = [4, 4], parameter_count = 3, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_result(%position: reg<amdgpu.sgpr>, %step: reg<amdgpu.sgpr>) asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 512, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %result = s_add_u32 %position, %step
  %15 = s_ashr_i32_rhs_inline %result, 31
  %result_storage_0 = concat(%result, %15) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %17 = slice %result_storage_0[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = v_mov_b32_copy %17
  %19 = slice %result_storage_0[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = v_mov_b32_copy %19
  %21 = concat(%18, %20) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %22 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %22, %21, %result_view_0
  return
}

