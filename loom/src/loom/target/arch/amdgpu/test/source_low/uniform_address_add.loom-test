amdgpu.target<gfx11-generic> @target

func.def target(@target) @bounded_offset_lhs(%values: vector<2xi64>, %wide_step: offset) -> (i32) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %position = scalar.assume %value [range(%value, 0, 4294967168)] : i64
  %bounded_position = index.cast %position : i64 to offset
  %step = index.assume %wide_step [range(%wide_step, 0, 127)] : offset
  %next = index.add %step, %bounded_position : offset
  %bounded = index.assume %next [range(%next, 0, 4294967295)] : offset
  %result = index.cast %bounded : offset to i32
  func.return %result : i32
}

