  %position = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %step = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_add_u32 %position, %step
  return %result
}

