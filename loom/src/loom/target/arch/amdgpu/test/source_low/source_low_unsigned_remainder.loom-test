// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @remainder_three_uniform(%value: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @remainder_three_uniform(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %divisor = s_mov_b32 3
  %7 = s_mov_b32 2863311531
  %8 = s_mul_hi_u32 %value, %7
  %9 = s_mov_b32 1
  %10 = s_lshr_b32 %8, %9
  %11 = s_mul_i32 %10, %divisor
  %remainder = s_sub_u32 %value, %11
  return %remainder
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @remainder_three_varying(%values: vector<2xi32>) -> (i32) {
  %value = vector.extract %values[0] : vector<2xi32> -> i32
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @remainder_three_varying(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %value = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %8 = v_mov_b32 2863311531
  %9 = v_mul_hi_u32 %value, %8
  %10 = v_lshrrev_b32_src0_inline %9, 1
  %11 = v_lshl_add_u32_shift_imm %10, %10, 1
  %remainder = v_sub_nc_u32 %value, %11
  return %remainder
}

