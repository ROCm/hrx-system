  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %dividend = slice %bounded_dividend[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %divisor = slice %bounded_divisor[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %25 = s_mov_b32 0
  %26 = s_mov_b32 1
  %27 = v_cvt_f32_u32 %divisor
  %28 = v_rcp_f32 %27
  %29 = v_mul_f32_lit %28, 1333788670
  %30 = v_cvt_u32_f32 %29
  %31 = v_readfirstlane_b32 %30
  %32 = s_mul_i32 %divisor, %31
  %33 = s_sub_u32 %25, %32
  %34 = s_mul_hi_u32 %31, %33
  %35 = s_add_u32 %31, %34
  %36 = s_mul_hi_u32 %dividend, %35
  %37 = s_mul_i32 %36, %divisor
  %38 = s_sub_u32 %dividend, %37
  %39 = s_add_u32 %36, %26
  %40, %41 = s_sub_co_u32 %38, %divisor
  %42 = s_cselect_b32 %36, %39, %41
  %43 = s_cselect_b32 %38, %40, %41
  %44 = s_add_u32 %42, %26
  %45, %46 = s_sub_co_u32 %43, %divisor
  %quotient = s_cselect_b32 %42, %44, %46
  %remainder = s_cselect_b32 %43, %45, %46
  %49 = s_mov_b32 0
  %52 = v_mov_b32_copy %quotient
  %54 = v_mov_b32_copy %49
  %55 = concat(%52, %54) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %56 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %56, %55, %result_view_0
  %60 = v_mov_b32_copy %remainder
  %63 = concat(%60, %54) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
