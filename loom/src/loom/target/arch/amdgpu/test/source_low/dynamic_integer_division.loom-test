// RUN: emit source-low @uniform_narrow_divrem target=amdgpu:gfx11-generic output=low

// Narrow source types widen through shared target legalization before using the
// dynamic i32 recipe.
func.def @uniform_narrow_divrem(%dividend: i16, %divisor: i16) -> (i16, i16) {
  %quotient, %remainder = scalar.divremui %dividend, %divisor : i16
  func.return %quotient, %remainder : i16, i16
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @uniform_narrow_divrem(%dividend: reg<amdgpu.vgpr>, %divisor: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %16 = v_and_b32_lit %dividend, 65535
  %17 = v_and_b32_lit %divisor, 65535
  %18 = v_mov_b32 0
  %19 = v_mov_b32 1
  %20 = v_cvt_f32_u32 %17
  %21 = v_rcp_f32 %20
  %22 = v_mul_f32_lit %21, 1333788670
  %23 = v_cvt_u32_f32 %22
  %24 = v_mul_lo_u32 %17, %23
  %25 = v_sub_nc_u32 %18, %24
  %26 = v_mul_hi_u32 %23, %25
  %27 = v_add_u32 %23, %26
  %28 = v_mul_hi_u32 %16, %27
  %29 = v_mul_lo_u32 %28, %17
  %30 = v_sub_nc_u32 %16, %29
  %31 = v_add_u32 %28, %19
  %32, %33 = v_sub_co_u32 %30, %17
  %34 = v_cndmask_b32 %31, %28, %33
  %35 = v_cndmask_b32 %32, %30, %33
  %36 = v_add_u32 %34, %19
  %37, %38 = v_sub_co_u32 %35, %17
  %quotient = v_cndmask_b32 %36, %34, %38
  %remainder = v_cndmask_b32 %37, %35, %38
  return %quotient, %remainder
}

// ====

// RUN: emit source-low @varying_unsigned_projections target=amdgpu:gfx942 output=low

// Extracted lanes force varying arithmetic. Distinct operand pairs keep the
// standalone quotient and remainder projections independent.
func.def @varying_unsigned_projections(%dividends: vector<2xi32>, %divisors: vector<2xi32>) -> (i32, i32) {
  %quotient_dividend = vector.extract %dividends[0] : vector<2xi32> -> i32
  %remainder_dividend = vector.extract %dividends[1] : vector<2xi32> -> i32
  %quotient_divisor = vector.extract %divisors[0] : vector<2xi32> -> i32
  %remainder_divisor = vector.extract %divisors[1] : vector<2xi32> -> i32
  %quotient = scalar.divui %quotient_dividend, %quotient_divisor : i32
  %remainder = scalar.remui %remainder_dividend, %remainder_divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @varying_unsigned_projections(%dividends: reg<amdgpu.vgpr x2>, %divisors: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %quotient_dividend = slice %dividends[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %remainder_dividend = slice %dividends[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %quotient_divisor = slice %divisors[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %remainder_divisor = slice %divisors[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %18 = v_mov_b32 0
  %19 = v_mov_b32 1
  %20 = v_cvt_f32_u32 %quotient_divisor
  %21 = v_rcp_f32 %20
  %22 = v_mul_f32_lit %21, 1333788670
  %23 = v_cvt_u32_f32 %22
  %24 = v_mul_lo_u32 %quotient_divisor, %23
  %25 = v_sub_u32 %18, %24
  %26 = v_mul_hi_u32 %23, %25
  %27 = v_add_u32 %23, %26
  %28 = v_mul_hi_u32 %quotient_dividend, %27
  %29 = v_mul_lo_u32 %28, %quotient_divisor
  %30 = v_sub_u32 %quotient_dividend, %29
  %31 = v_add_u32 %28, %19
  %32, %33 = v_sub_co_u32 %30, %quotient_divisor
  %34 = v_cndmask_b32 %31, %28, %33
  %35 = v_cndmask_b32 %32, %30, %33
  %36 = v_add_u32 %34, %19
  %37, %38 = v_sub_co_u32 %35, %quotient_divisor
  %quotient = v_cndmask_b32 %36, %34, %38
  %43 = v_cvt_f32_u32 %remainder_divisor
  %44 = v_rcp_f32 %43
  %45 = v_mul_f32_lit %44, 1333788670
  %46 = v_cvt_u32_f32 %45
  %47 = v_mul_lo_u32 %remainder_divisor, %46
  %48 = v_sub_u32 %18, %47
  %49 = v_mul_hi_u32 %46, %48
  %50 = v_add_u32 %46, %49
  %51 = v_mul_hi_u32 %remainder_dividend, %50
  %52 = v_mul_lo_u32 %51, %remainder_divisor
  %53 = v_sub_u32 %remainder_dividend, %52
  %55, %56 = v_sub_co_u32 %53, %remainder_divisor
  %58 = v_cndmask_b32 %55, %53, %56
  %60, %61 = v_sub_co_u32 %58, %remainder_divisor
  %remainder = v_cndmask_b32 %60, %58, %61
  return %quotient, %remainder
}

