// RUN: emit source-low @uniform_index_divrem target=amdgpu:gfx11-generic output=low

// Fact-bounded i64 arguments retain their full-width carriers through the
// index casts while sharing one narrow quotient/remainder recipe.
kernel.def @uniform_index_divrem() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%dividend0: i64, %divisor0: i64, %result_buffer_0: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<2x64xi64>
  %bounded_dividend = scalar.assume %dividend0 [range(%dividend0, 0, 2147483647)] : i64
  %bounded_divisor = scalar.assume %divisor0 [range(%divisor0, 1, 1023)] : i64
  %dividend = index.cast %bounded_dividend : i64 to index
  %divisor = index.cast %bounded_divisor : i64 to index
  %quotient, %remainder = index.divrem %dividend, %divisor : index
  %result_storage_0 = index.cast %quotient : index to i64
  view.store %result_storage_0, %result_view_0[0, %fixture_lane] : i64, view<2x64xi64>
  %result_storage_1 = index.cast %remainder : index to i64
  view.store %result_storage_1, %result_view_0[1, %fixture_lane] : i64, view<2x64xi64>
  kernel.return
}

