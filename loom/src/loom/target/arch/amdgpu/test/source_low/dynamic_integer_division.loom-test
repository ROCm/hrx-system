// RUN: emit source-low @varying_signed_divrem target=amdgpu:gfx942 output=low

func.def @varying_signed_divrem(%dividends: vector<2xi32>, %divisors: vector<2xi32>) -> (i32, i32) {
  %dividend = vector.extract %dividends[0] : vector<2xi32> -> i32
  %divisor = vector.extract %divisors[0] : vector<2xi32> -> i32
  %quotient, %remainder = scalar.divremsi %dividend, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @varying_signed_divrem(%dividends: reg<amdgpu.vgpr x2>, %divisors: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %dividend = slice %dividends[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %divisor = slice %divisors[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_ashrrev_i32_src0_inline %dividend, 31
  %15 = v_ashrrev_i32_src0_inline %divisor, 31
  %16 = v_xor_b32 %dividend, %14
  %17 = v_sub_u32 %16, %14
  %18 = v_xor_b32 %divisor, %15
  %19 = v_sub_u32 %18, %15
  %20 = v_mov_b32 0
  %21 = v_mov_b32 1
  %22 = v_cvt_f32_u32 %19
  %23 = v_rcp_f32 %22
  %24 = v_mul_f32_lit %23, 1333788670
  %25 = v_cvt_u32_f32 %24
  %26 = v_mul_lo_u32 %19, %25
  %27 = v_sub_u32 %20, %26
  %28 = v_mul_hi_u32 %25, %27
  %29 = v_add_u32 %25, %28
  %30 = v_mul_hi_u32 %17, %29
  %31 = v_mul_lo_u32 %30, %19
  %32 = v_sub_u32 %17, %31
  %33 = v_add_u32 %30, %21
  %34, %35 = v_sub_co_u32 %32, %19
  %36 = v_cndmask_b32 %33, %30, %35
  %37 = v_cndmask_b32 %34, %32, %35
  %38 = v_add_u32 %36, %21
  %39, %40 = v_sub_co_u32 %37, %19
  %41 = v_cndmask_b32 %38, %36, %40
  %42 = v_cndmask_b32 %39, %37, %40
  %43 = v_xor_b32 %14, %15
  %44 = v_xor_b32 %41, %43
  %quotient = v_sub_u32 %44, %43
  %46 = v_xor_b32 %42, %14
  %remainder = v_sub_u32 %46, %14
  return %quotient, %remainder
}

// ====

// RUN: emit source-low @uniform_shared_unsigned_divisor target=amdgpu:gfx11-generic output=low

// Independent divisions by the same block-local divisor share its reciprocal
// preparation while retaining their distinct dividends and projections.
func.def @uniform_shared_unsigned_divisor(%quotient_dividend: i32, %remainder_dividend: i32, %divisor: i32) -> (i32, i32) {
  %quotient = scalar.divui %quotient_dividend, %divisor : i32
  %remainder = scalar.remui %remainder_dividend, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @uniform_shared_unsigned_divisor(%quotient_dividend: reg<amdgpu.sgpr>, %remainder_dividend: reg<amdgpu.sgpr>, %divisor: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %12 = s_mov_b32 0
  %13 = s_mov_b32 1
  %14 = v_cvt_f32_u32 %divisor
  %15 = v_rcp_f32 %14
  %16 = v_mul_f32_lit %15, 1333788670
  %17 = v_cvt_u32_f32 %16
  %18 = v_readfirstlane_b32 %17
  %19 = s_mul_i32 %divisor, %18
  %20 = s_sub_u32 %12, %19
  %21 = s_mul_hi_u32 %18, %20
  %22 = s_add_u32 %18, %21
  %23 = s_mul_hi_u32 %quotient_dividend, %22
  %24 = s_mul_i32 %23, %divisor
  %25 = s_sub_u32 %quotient_dividend, %24
  %26 = s_add_u32 %23, %13
  %27, %28 = s_sub_co_u32 %25, %divisor
  %29 = s_cselect_b32 %23, %26, %28
  %30 = s_cselect_b32 %25, %27, %28
  %31 = s_add_u32 %29, %13
  %32, %33 = s_sub_co_u32 %30, %divisor
  %quotient = s_cselect_b32 %29, %31, %33
  %36 = s_mul_hi_u32 %remainder_dividend, %22
  %37 = s_mul_i32 %36, %divisor
  %38 = s_sub_u32 %remainder_dividend, %37
  %40, %41 = s_sub_co_u32 %38, %divisor
  %43 = s_cselect_b32 %38, %40, %41
  %45, %46 = s_sub_co_u32 %43, %divisor
  %remainder = s_cselect_b32 %43, %45, %46
  return %quotient, %remainder
}
