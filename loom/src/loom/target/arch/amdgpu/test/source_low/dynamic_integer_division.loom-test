// RUN: emit source-low @uniform_index_divrem target=amdgpu:gfx11-generic output=low

// Fact-bounded i64 arguments retain their full-width carriers through the
// index casts while sharing one narrow quotient/remainder recipe.
func.def @uniform_index_divrem(%dividend0: i64, %divisor0: i64) -> (index, index) {
  %bounded_dividend = scalar.assume %dividend0 [range(%dividend0, 0, 2147483647)] : i64
  %bounded_divisor = scalar.assume %divisor0 [range(%divisor0, 1, 1023)] : i64
  %dividend = index.cast %bounded_dividend : i64 to index
  %divisor = index.cast %bounded_divisor : i64 to index
  %quotient, %remainder = index.divrem %dividend, %divisor : index
  func.return %quotient, %remainder : index, index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @uniform_index_divrem(%bounded_dividend: reg<amdgpu.sgpr x2>, %bounded_divisor: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %dividend = slice %bounded_dividend[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %divisor = slice %bounded_divisor[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = s_mov_b32 0
  %17 = s_mov_b32 1
  %18 = v_cvt_f32_u32 %divisor
  %19 = v_rcp_f32 %18
  %20 = v_mul_f32_lit %19, 1333788670
  %21 = v_cvt_u32_f32 %20
  %22 = v_readfirstlane_b32 %21
  %23 = s_mul_i32 %divisor, %22
  %24 = s_sub_u32 %16, %23
  %25 = s_mul_hi_u32 %22, %24
  %26 = s_add_u32 %22, %25
  %27 = s_mul_hi_u32 %dividend, %26
  %28 = s_mul_i32 %27, %divisor
  %29 = s_sub_u32 %dividend, %28
  %30 = s_add_u32 %27, %17
  %31, %32 = s_sub_co_u32 %29, %divisor
  %33 = s_cselect_b32 %27, %30, %32
  %34 = s_cselect_b32 %29, %31, %32
  %35 = s_add_u32 %33, %17
  %36, %37 = s_sub_co_u32 %34, %divisor
  %quotient = s_cselect_b32 %33, %35, %37
  %remainder = s_cselect_b32 %34, %36, %37
  return %quotient, %remainder
}

// ====

// RUN: emit source-low @uniform_signed_divrem target=amdgpu:gfx11-generic output=low

// Signed runtime division applies signs around the same unsigned core while
// retaining both results from one reciprocal seed.
func.def @uniform_signed_divrem(%dividend: i32, %divisor: i32) -> (i32, i32) {
  %quotient, %remainder = scalar.divremsi %dividend, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @uniform_signed_divrem(%dividend: reg<amdgpu.sgpr>, %divisor: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %10 = s_ashr_i32_rhs_inline %dividend, 31
  %11 = s_ashr_i32_rhs_inline %divisor, 31
  %12 = s_xor_b32 %dividend, %10
  %13 = s_sub_u32 %12, %10
  %14 = s_xor_b32 %divisor, %11
  %15 = s_sub_u32 %14, %11
  %16 = s_mov_b32 0
  %17 = s_mov_b32 1
  %18 = v_cvt_f32_u32 %15
  %19 = v_rcp_f32 %18
  %20 = v_mul_f32_lit %19, 1333788670
  %21 = v_cvt_u32_f32 %20
  %22 = v_readfirstlane_b32 %21
  %23 = s_mul_i32 %15, %22
  %24 = s_sub_u32 %16, %23
  %25 = s_mul_hi_u32 %22, %24
  %26 = s_add_u32 %22, %25
  %27 = s_mul_hi_u32 %13, %26
  %28 = s_mul_i32 %27, %15
  %29 = s_sub_u32 %13, %28
  %30 = s_add_u32 %27, %17
  %31, %32 = s_sub_co_u32 %29, %15
  %33 = s_cselect_b32 %27, %30, %32
  %34 = s_cselect_b32 %29, %31, %32
  %35 = s_add_u32 %33, %17
  %36, %37 = s_sub_co_u32 %34, %15
  %38 = s_cselect_b32 %33, %35, %37
  %39 = s_cselect_b32 %34, %36, %37
  %40 = s_xor_b32 %10, %11
  %41 = s_xor_b32 %38, %40
  %quotient = s_sub_u32 %41, %40
  %43 = s_xor_b32 %39, %10
  %remainder = s_sub_u32 %43, %10
  return %quotient, %remainder
}

