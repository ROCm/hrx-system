// RUN: emit source-low output=low

amdgpu.target<gfx1151> @target

func.def target(@target) @scalar_float_uniform(%lhs_i32: i32, %rhs_i32: i32) -> (f32, f32, f32, f32, i32, i32) {
  %lhs = scalar.sitofp %lhs_i32 : i32 to f32
  %rhs = scalar.uitofp %rhs_i32 : i32 to f32
  %sum = scalar.addf %lhs, %rhs : f32
  %difference = scalar.subf %sum, %lhs : f32
  %product = scalar.mulf %sum, %difference : f32
  %minimum = scalar.minnumf %product, %sum : f32
  %maximum = scalar.maxnumf %minimum, %difference : f32
  %ceil = scalar.ceilf %maximum : f32
  %floor = scalar.floorf %maximum : f32
  %rounded = scalar.roundevenf %maximum : f32
  %truncated = scalar.truncf %maximum : f32
  %lhs_f16 = scalar.fptrunc %lhs : f32 to f16
  %rhs_f16 = scalar.fptrunc %rhs : f32 to f16
  %sum_f16 = scalar.addf %lhs_f16, %rhs_f16 : f16
  %sum_from_f16 = scalar.extf %sum_f16 : f16 to f32
  %condition = scalar.cmpf olt, %sum_from_f16, %maximum : f32
  %selected = scf.select %condition, %ceil, %floor : f32
  %signed = scalar.fptosi %rounded : f32 to i32
  %unsigned = scalar.fptoui %truncated : f32 to i32
  func.return %selected, %rounded, %truncated, %sum_from_f16, %signed, %unsigned : f32, f32, f32, f32, i32, i32
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @scalar_float_uniform(%lhs_i32: reg<amdgpu.sgpr>, %rhs_i32: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %lhs = s_cvt_f32_i32 %lhs_i32
  %rhs = s_cvt_f32_u32 %rhs_i32
  %sum = s_add_f32 %lhs, %rhs
  %difference = s_sub_f32 %sum, %lhs
  %product = s_mul_f32 %sum, %difference
  %40 = s_max_f32 %product, %product
  %41 = s_max_f32 %sum, %sum
  %minimum = s_min_f32 %40, %41
  %43 = s_max_f32 %minimum, %minimum
  %44 = s_max_f32 %difference, %difference
  %maximum = s_max_f32 %43, %44
  %ceil = s_ceil_f32 %maximum
  %floor = s_floor_f32 %maximum
  %rounded = s_rndne_f32 %maximum
  %truncated = s_trunc_f32 %maximum
  %lhs_f16 = s_cvt_f16_f32 %lhs
  %rhs_f16 = s_cvt_f16_f32 %rhs
  %sum_f16 = s_add_f16 %lhs_f16, %rhs_f16
  %sum_from_f16 = s_cvt_f32_f16 %sum_f16
  %condition = s_cmp_lt_f32 %sum_from_f16, %maximum
  %selected = s_cselect_b32 %ceil, %floor, %condition
  %signed = s_cvt_i32_f32 %rounded
  %unsigned = s_cvt_u32_f32 %truncated
  return %selected, %rounded, %truncated, %sum_from_f16, %signed, %unsigned
}

// ====

amdgpu.target<gfx1151> @target

func.def target(@target) @scalar_float_lane_values(%lhs: f32, %rhs: f32) -> (f32) {
  %condition = scalar.cmpf olt, %lhs, %rhs : f32
  %result = scf.select %condition, %lhs, %rhs : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @scalar_float_lane_values(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %condition = v_cmp_lt_f32 %lhs, %rhs
  %result = v_cndmask_b32 %rhs, %lhs, %condition
  return %result
}

// ====

amdgpu.target<gfx1151> @target

// A halfword writer must define the whole carrier before returning it.
func.def target(@target) @scalar_half_return(%input: i32) -> (f16) {
  %value = scalar.bitcast %input : i32 to f32
  %half = scalar.fptrunc %value : f32 to f16
  func.return %half : f16
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @scalar_half_return(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %half = s_cvt_f16_f32 %value
  %7 = s_bfe_u32_lit_low16 %half
  return %7
}

// ====

amdgpu.target<gfx1151> @target

func.def target(@target) @scalar_half_select(%lhs: i32, %rhs: i32) -> (f16) {
  %lhs_float = scalar.bitcast %lhs : i32 to f32
  %rhs_float = scalar.bitcast %rhs : i32 to f32
  %lhs_half = scalar.fptrunc %lhs_float : f32 to f16
  %rhs_half = scalar.fptrunc %rhs_float : f32 to f16
  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  %result = scf.select %condition, %lhs_half, %rhs_half : f16
  func.return %result : f16
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @scalar_half_select(%lhs_float: reg<amdgpu.sgpr>, %rhs_float: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %lhs_half = s_cvt_f16_f32 %lhs_float
  %rhs_half = s_cvt_f16_f32 %rhs_float
  %condition = s_cmp_lt_i32 %lhs_float, %rhs_float
  %15 = s_bfe_u32_lit_low16 %lhs_half
  %16 = s_bfe_u32_lit_low16 %rhs_half
  %result = s_cselect_b32 %15, %16, %condition
  return %result
}

// ====

amdgpu.target<gfx1151> @target

func.def target(@target) @scalar_half_loop(%input: i32, %count: index) -> (f16) {
  %value = scalar.bitcast %input : i32 to f32
  %initial = scalar.fptrunc %value : f32 to f16
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %count step %step](%carried = %initial : f16) -> (f16) {
    %next = scalar.addf %carried, %initial : f16
    scf.yield %next : f16
  }
  func.return %result : f16
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @scalar_half_loop(%value: reg<amdgpu.sgpr>, %count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %initial = s_cvt_f16_f32 %value
  %begin = s_mov_b32 0
  %step = s_mov_b32 1
  %25 = v_bfe_u32_offset_0_width_inline_low16 %initial
  low.br ^_bb1(%begin: reg<amdgpu.sgpr>, %25: reg<amdgpu.vgpr>)
^_bb1(%iteration: reg<amdgpu.sgpr>, %carried: reg<amdgpu.vgpr>):
  %26 = s_cmp_lt_i32 %iteration, %count
  low.cond_br %26, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %next = v_add_f16 %carried, %25
  %29 = s_add_u32 %iteration, %step
  %30 = v_bfe_u32_offset_0_width_inline_low16 %next
  low.br ^_bb1(%29: reg<amdgpu.sgpr>, %30: reg<amdgpu.vgpr>)
^_bb3:
  return %carried
}
