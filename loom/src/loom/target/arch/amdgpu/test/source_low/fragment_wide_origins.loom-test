  %24 = global_load_b128_saddr %22, %20 {offset = 16}
  %27 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30, %31 = s_add_co_u32 %27, %12
  %32, %33 = s_addc_u32 %28, %15, %31
  %34 = concat(%30, %32) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %22, %23, %34
  global_store_b128_saddr %22, %24, %34 {offset = 16}
  return
}
