low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @fragment_static_wide_origin() asm {
  %9 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 1099511628544, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 1099511628544, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = s_mov_b32 256
  %15 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19, %20 = s_add_co_u32 %15, %12
  %21, %22 = s_addc_u32 %16, %12, %20
  %23 = concat(%19, %21) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %24 = v_and_b32_src0_inline %9, 15
  %25 = v_lshlrev_b32_src0_inline %24, 5
  %26 = global_load_b128_saddr %25, %23
  %27 = global_load_b128_saddr %25, %23 {offset = 16}
  %32 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %33 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36, %37 = s_add_co_u32 %32, %12
  %38, %39 = s_addc_u32 %33, %12, %37
  %40 = concat(%36, %38) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %25, %26, %40
  global_store_b128_saddr %25, %27, %40 {offset = 16}
  return
}

// ====

// The source origin alone fits U32, but the fragment crosses that boundary.
kernel.def @fragment_crossing_u32_origin() {
  %unit_extent = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%threads, %unit_extent, %unit_extent) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 4294967040 : offset
  %extent = index.constant 16 : index
  %input_view = buffer.view %input[%base] : buffer -> view<16x16xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  %fragment = vector.fragment.load<lhs> %input_view[0, 0] shape [%extent, %extent] : view<16x16xbf16> -> vector<16xbf16>
  vector.fragment.store<lhs> %fragment, %output_view[0, 0] shape [%extent, %extent] : vector<16xbf16>, view<16x16xbf16>
  kernel.return
}

