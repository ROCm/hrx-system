// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Dynamic byte origins retain both words before lane-relative fragment loads
// and stores. The static contribution occurs exactly once.
kernel.def @fragment_dynamic_origin() {
  %unit_extent = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%threads, %unit_extent, %unit_extent) : index
} launch(%input: buffer, %output: buffer, %origin_input: offset) {
  %origin = index.assume %origin_input [multiple_of(%origin_input, 16)] : offset
  %padding = index.constant 256 : offset
  %base = index.add %origin, %padding : offset
  %extent = index.constant 16 : index
  %input_view = buffer.view %input[%base] : buffer -> view<16x16xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  %fragment = vector.fragment.load<lhs> %input_view[0, 0] shape [%extent, %extent] : view<16x16xbf16> -> vector<16xbf16>
  vector.fragment.store<lhs> %fragment, %output_view[0, 0] shape [%extent, %extent] : vector<16xbf16>, view<16x16xbf16>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "origin_input"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [8], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @fragment_dynamic_origin(%origin: reg<amdgpu.sgpr x2>) asm {
  %13 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %padding = s_mov_b32 256
  %17 = s_mov_b32 0
  %19 = slice %origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = slice %origin[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23, %24 = s_add_co_u32 %19, %padding
  %25, %26 = s_addc_u32 %20, %17, %24
  %28 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32, %33 = s_add_co_u32 %28, %23
  %34, %35 = s_addc_u32 %29, %25, %33
  %36 = concat(%32, %34) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %37 = v_and_b32_src0_inline %13, 15
  %38 = v_lshlrev_b32_src0_inline %37, 5
  %39 = global_load_b128_saddr %38, %36
  %40 = global_load_b128_saddr %38, %36 {offset = 16}
  %42 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %43 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46, %47 = s_add_co_u32 %42, %23
  %48, %49 = s_addc_u32 %43, %25, %47
  %50 = concat(%46, %48) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %38, %39, %50
  global_store_b128_saddr %38, %40, %50 {offset = 16}
  return
}

// ====

// A cold resident-row table supplies an arbitrary I64 byte origin. The table
// is disjoint from the destination, so the origin retains scalar placement.
kernel.def @fragment_table_origin() {
  %unit_extent = index.constant 1 : index
  %groups = index.constant 4 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit_extent, %unit_extent) workgroup_size(%threads, %unit_extent, %unit_extent) : index
} launch(%table: buffer, %input: buffer, %output: buffer, %layer_origin: offset) {
  %table_unique, %input_unique, %output_unique = buffer.assume.noalias %table, %input, %output : buffer, buffer, buffer
  %table_origin = index.constant 0 : offset
  %row = kernel.workgroup.id<x> : index
  %origins = buffer.view %table_unique[%table_origin] : buffer -> view<4xi64>
  %word = view.load %origins[%row] : view<4xi64> -> i64
  %nonnegative = scalar.assume %word [range(%word, 0, 9223372036854775807), multiple_of(%word, 16)] : i64
  %origin = index.cast %nonnegative : i64 to offset
  %base = index.add %origin, %layer_origin : offset
  %extent = index.constant 16 : index
  %subgroup = kernel.subgroup.id : index
  %tile_row = index.mul %subgroup, %extent : index
  %input_view = buffer.view %input_unique[%base] : buffer -> view<32x16xbf16>
  %output_view = buffer.view %output_unique[%base] : buffer -> view<32x16xbf16>
  %fragment = vector.fragment.load<lhs> %input_view[%tile_row, 0] shape [%extent, %extent] : view<32x16xbf16> -> vector<16xbf16>
  vector.fragment.store<lhs> %fragment, %output_view[%tile_row, 0] shape [%extent, %extent] : vector<16xbf16>, view<32x16xbf16>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "layer_origin"}, direct_arg_offsets = [24], direct_arg_parameter_indices = [3], direct_arg_sizes = [8], parameter_count = 4, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(4, 1, 1) @fragment_table_origin(%layer_origin: reg<amdgpu.sgpr x2>) asm {
  %row = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %27 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %origins = resource<hal_binding> {extent = 32, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %input_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %31 = s_lshl_b32_rhs_inline %row, 3
  %origin = s_load_dwordx2 %origins, %31
  %33 = slice %origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = slice %origin[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = slice %layer_origin[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = slice %layer_origin[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37, %38 = s_add_co_u32 %33, %35
  %39, %40 = s_addc_u32 %34, %36, %38
  %subgroup = v_lshrrev_b32_src0_inline %27, 5
  %43 = v_and_b32_src0_inline %27, 31
  %44 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %48, %49 = s_add_co_u32 %44, %37
  %50, %51 = s_addc_u32 %45, %39, %49
  %52 = concat(%48, %50) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %53 = v_lshlrev_b32_src0_inline %subgroup, 9
  %54 = v_and_b32_src0_inline %43, 15
  %55 = v_lshl_add_u32_shift_imm %54, %53, 5
  %56 = global_load_b128_saddr %55, %52
  %57 = global_load_b128_saddr %55, %52 {offset = 16}
  %59 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %60 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %63, %64 = s_add_co_u32 %59, %37
  %65, %66 = s_addc_u32 %60, %39, %64
  %67 = concat(%63, %65) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_b128_saddr %55, %56, %67
  global_store_b128_saddr %55, %57, %67 {offset = 16}
  return
}

// ====

// Both a nonzero high word and low-word displacement belong to the scalar
// pointer. Fragment coordinates remain small relative offsets.
kernel.def @fragment_static_wide_origin() {
  %unit_extent = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%threads, %unit_extent, %unit_extent) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 1099511628032 : offset
  %extent = index.constant 16 : index
  %input_view = buffer.view %input[%base] : buffer -> view<16x16xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  %fragment = vector.fragment.load<lhs> %input_view[0, 0] shape [%extent, %extent] : view<16x16xbf16> -> vector<16xbf16>
  vector.fragment.store<lhs> %fragment, %output_view[0, 0] shape [%extent, %extent] : vector<16xbf16>, view<16x16xbf16>
  kernel.return
}

