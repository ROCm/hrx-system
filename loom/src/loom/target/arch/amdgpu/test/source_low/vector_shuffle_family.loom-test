// RUN: with-checks compile-report target-legalize{mode=final},source-to-low

amdgpu.target<gfx11-generic> @target

// Exercise the smallest non-identity map for each physical storage contract.
func.def target(@target) @i1_min(%values: vector<2xi1>) -> (vector<2xi1>) {
  %result = vector.shuffle<[1, 0]> %values : vector<2xi1>
  func.return %result : vector<2xi1>
}

