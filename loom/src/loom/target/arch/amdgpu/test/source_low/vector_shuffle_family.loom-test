amdgpu.target<gfx942> @gfx942_target

// Exceed the regular-selector emitter's bounded 16-entry working set with
// eighteen distinct selector payloads, then revisit the first evicted pair.
// All ten words draw from three source words, keeping source slices small.
func.def target(@gfx942_target) @i8_selector_working_set(%values: vector<40xi8>) -> (vector<40xi8>) {
  %result = vector.shuffle<[0, 0, 4, 8, 0, 0, 5, 9, 0, 0, 6, 10, 0, 0, 7, 11, 0, 4, 8, 0, 0, 4, 9, 1, 0, 4, 10, 2, 0, 4, 11, 3, 0, 5, 8, 8, 0, 0, 4, 8]> %values : vector<40xi8>
  func.return %result : vector<40xi8>
}

// ----
CHECK: COMPILE-REPORT: source_low selected_ops=19 * rows=19
CHECK: COMPILE-REPORT: target_legalization * scalarized=0 * rows=19
CHECK-NOT: scalarized=true
