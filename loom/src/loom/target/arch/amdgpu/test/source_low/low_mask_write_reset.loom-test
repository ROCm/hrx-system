low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @late_reset(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop
^loop:
  %mask = s_or_b64 %source, %source
  %word = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %broadcast = v_mov_b32_copy %word
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^loop
}

// ----
.Lbb1:
  s_or_b64 s[2:3], s[0:1], s[0:1]
  s_waitcnt_depctr 0xff9e
  v_mov_b32 v1, s0
  v_cndmask_b32 v1, 0, v0, s[2:3]
  s_branch .Lbb1

