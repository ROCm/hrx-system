// RUN: emit amdgpu-assembly @m0_read_reset strategy=source

// The implicit native M0 input resets the previous mask read.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @m0_read_reset(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>, %m0: reg<amdgpu.m0>) asm {
  low.br ^loop
^loop:
  %interpolated = v_interp_p10_f32 %value, %value, %value, %m0
  %mask = s_or_b64 %source, %source
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^loop
}

