// RUN: emit amdgpu-assembly @partial_join_reset strategy=source

// One cleared arm cannot discard the mask arriving through the other arm.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @partial_join_reset(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>, %decision: reg<amdgpu.sgpr>) asm {
  %threshold = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^produce
^produce:
  %mask = s_or_b64 %source, %source
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %condition = s_cmp_lt_u32 %decision, %threshold
  low.cond_br %condition, ^clear, ^skip : reg<amdgpu.scc>
^clear:
  %broadcast = v_mov_b32_copy %threshold
  low.br ^join
^skip:
  low.br ^join
^join:
  low.br ^produce
}

// ----
.Lbb1:
  s_or_b64 s[4:5], s[0:1], s[0:1]
  s_waitcnt_depctr 0xff9e
  v_cndmask_b32 v1, 0, v0, s[4:5]
  s_cmp_lt_u32 s2, s0
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  v_mov_b32 v1, s0
  s_branch .Lbb4
.Lbb3:
.Lbb4:
  s_branch .Lbb1

// ====

// RUN: emit amdgpu-assembly @complete_join_reset strategy=source

// The overwrite needs no wait when both incoming paths reset the mask latch.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @complete_join_reset(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>, %decision: reg<amdgpu.sgpr>) asm {
  %threshold = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  low.br ^produce
^produce:
  %mask = s_or_b64 %source, %source
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %condition = s_cmp_lt_u32 %decision, %threshold
  low.cond_br %condition, ^clear, ^other : reg<amdgpu.scc>
^clear:
  %broadcast = v_mov_b32_copy %threshold
  low.br ^join
^other:
  %other_word = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %other_broadcast = v_mov_b32_copy %other_word
  low.br ^join
^join:
  low.br ^produce
}

// ----
.Lbb1:
  s_or_b64 s[4:5], s[0:1], s[0:1]
  v_cndmask_b32 v1, 0, v0, s[4:5]
  s_cmp_lt_u32 s2, s0
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  v_mov_b32 v1, s0
  s_branch .Lbb4
.Lbb3:
  v_mov_b32 v1, s1
.Lbb4:
  s_branch .Lbb1

