// RUN: emit amdgpu-assembly @vcc_read_reset strategy=source

// Reading VCC resets the incoming SGPR mask, then protects its own overwrite.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @vcc_read_reset(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>, %initial_vcc: reg<amdgpu.vcc>) asm {
  low.br ^loop(%initial_vcc: reg<amdgpu.vcc>)
^loop(%vcc_mask: reg<amdgpu.vcc>):
  %vcc_selected = v_cndmask_b32_src0_inline_vcc %value, %vcc_mask {false_value = 0}
  %mask = s_or_b64 %source, %source
  %vcc_replacement = s_mov_b32_vcc_imm 1
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^loop(%vcc_replacement: reg<amdgpu.vcc>)
}

// ----
.Lbb1:
  v_cndmask_b32 v1, 0, v0, vcc
  s_or_b64 s[2:3], s[0:1], s[0:1]
  s_mov_b32 vcc_lo, 1
  s_waitcnt_depctr 0xff9e
  v_cndmask_b32 v1, 0, v0, s[2:3]
  s_branch .Lbb1

// ====

// RUN: emit amdgpu-assembly @scalar_resets_vcc strategy=source

// An ordinary scalar VALU read also clears prior VCC mask history.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @scalar_resets_vcc(%value: reg<amdgpu.vgpr>, %uniform: reg<amdgpu.sgpr>, %vcc_mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %vcc_mask {false_value = 0}
  %broadcast = v_mov_b32_copy %uniform
  %vcc_replacement = v_cmp_eq_i32_src0_inline_vcc %value {lhs = 0}
  %again = v_cndmask_b32_src0_inline_vcc %selected, %vcc_replacement {false_value = 0}
  return
}

// ----
  v_cndmask_b32 v1, 0, v0, vcc
  v_mov_b32 v2, s0
  v_cmp_eq_i32 vcc, 0, v0
  s_delay_alu instid0(VALU_DEP_3)
  v_cndmask_b32 v0, 0, v1, vcc
  s_endpgm

