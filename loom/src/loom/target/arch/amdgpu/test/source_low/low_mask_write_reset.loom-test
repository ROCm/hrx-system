// RUN: emit amdgpu-assembly @loop_header_reset strategy=source

// A loop-header reset kills the mask read carried around the backedge.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @loop_header_reset(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>) asm {
  low.br ^header
^header:
  %word = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %broadcast = v_mov_b32_copy %word
  %mask = s_or_b64 %source, %source
  low.br ^body
^body:
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^header
}

