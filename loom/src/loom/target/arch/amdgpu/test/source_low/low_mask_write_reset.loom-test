// RUN: emit amdgpu-assembly @carry_replaces_mask strategy=source

// The carry read resets the old latch before writing its result. Its current
// predicate read still protects the scalar update feeding the next iteration.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @carry_replaces_mask(%value: reg<amdgpu.vgpr>, %initial: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop(%initial: reg<amdgpu.sgpr x2>)
^loop(%current: reg<amdgpu.sgpr x2>):
  %selected = v_cndmask_b32_src0_inline %value, %current {false_value = 0}
  %sum, %carry = v_add_co_ci_u32 %value, %value, %current
  %next = s_or_b64 %carry, %carry
  low.br ^loop(%next: reg<amdgpu.sgpr x2>)
}

// ----
.Lbb1:
  v_cndmask_b32 v1, 0, v0, s[0:1]
  v_add_co_ci_u32 v1, s[0:1], v0, v0, s[0:1]
  s_delay_alu instid0(VALU_DEP_1)
  s_or_b64 s[0:1], s[0:1], s[0:1]
  s_waitcnt_depctr 0xff9e
  s_branch .Lbb1

// ====

// RUN: emit amdgpu-assembly @late_reset strategy=source

