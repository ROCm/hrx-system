.Lbb1:
  v_interp_p10_f32 v1, v0, v0, v0 wait_exp:7
  s_or_b64 s[2:3], s[0:1], s[0:1]
  v_cndmask_b32 v1, 0, v0, s[2:3]
  s_branch .Lbb1

