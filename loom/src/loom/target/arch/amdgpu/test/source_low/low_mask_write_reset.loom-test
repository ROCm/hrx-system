// ====
// RUN: emit amdgpu-assembly @reuse strategy=source fixed=%mask:physical_register:0:2 fixed=%carry:physical_register:0:2 fixed=%next_mask:physical_register:2:2 fixed=%replacement:physical_register:2:2 fixed=%source:physical_register:4:2

// A scalar read clears the old mask before the same VALU writes it;
// the current predicate read still protects a later overwrite.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %incoming_mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>, %incoming_next_mask: reg<amdgpu.sgpr x2>) asm {
  %mask = low.assume %incoming_mask [] : reg<amdgpu.sgpr x2>
  %next_mask = low.assume %incoming_next_mask [] : reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %sum, %carry = v_add_co_ci_u32 %value, %value, %next_mask
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_cndmask_b32 v1, 0, v0, s[0:1]
  v_add_co_ci_u32 v0, s[0:1], v0, v0, s[2:3]
  s_or_b64 s[2:3], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
  s_and_b64 s[0:1], s[2:3], s[4:5]
  s_endpgm

// ====
// A reset after an overwrite cannot erase its already-required wait.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %incoming_mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %mask = low.assume %incoming_mask [] : reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %replacement = s_or_b64 %source, %source
  %word = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %broadcast = v_mov_b32_copy %word
  %result = s_and_b64 %replacement, %source
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
  v_mov_b32_copy v0, s4
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm

// ====
// An EXEC-only VALU read does not reset the lane-mask state.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %incoming_mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %mask = low.assume %incoming_mask [] : reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %vector = v_add_f32 %value, %value
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

