// RUN: emit amdgpu-assembly @successor_reset strategy=source

// A successor reset kills the retained mask before control returns to its writer.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @successor_reset(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>) asm {
  low.br ^produce
^produce:
  %mask = s_or_b64 %source, %source
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^clear
^clear:
  %word = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %broadcast = v_mov_b32_copy %word
  low.br ^produce
}

// ----
.Lbb1:
  s_or_b64 s[2:3], s[0:1], s[0:1]
  v_cndmask_b32 v1, 0, v0, s[2:3]
.Lbb2:
  v_mov_b32 v1, s0
  s_branch .Lbb1

