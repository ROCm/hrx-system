// ====

// RUN: emit amdgpu-native-words @packet_permutation_loop strategy=source

// Repeated packet-local copies encode both register fields and completion waits.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @packet_permutation_loop(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop
^loop:
  %first = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %mask = concat(%second, %first) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^loop
}

