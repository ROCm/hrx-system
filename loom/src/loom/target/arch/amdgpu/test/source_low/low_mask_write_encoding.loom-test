// RUN: emit amdgpu-native-words @scalar_completion_loop strategy=source

// The recurring SALU write uses only its scalar-destination dependency field.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @scalar_completion_loop(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>) asm {
  low.br ^loop
^loop:
  %mask = s_or_b64 %source, %source
  %result = s_and_b64 %mask, %source
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^loop
}

