// RUN: emit source-low output=pipeline sanitizer=access

amdgpu.target<gfx11-generic> @target

func.def target(@target) @sanitizer_pipeline_probe(%value: i32) -> (i32) {
  func.return %value : i32
}

// ----
pass.pipeline<module> @__loom_check_source_low pipeline {
  for func {
    where target {
      normalize-kernel-resources
      promote-private-fragments
      canonicalize
      cse
    }
  }
  repeat until_converged(max_iterations = 64) {
    select-templates(mode = "early")
    inline-callables
    if changed {
      for func {
        where target {
          canonicalize
        }
      }
    }
  }
  select-templates(mode = "final")
  specialize-target-callgraph
  for func {
    where target {
      legalize-math
    }
  }
  target-legalize(mode = "eager")
  for func {
    where target {
      vector-memory-to-scalar
      linearize-view-accesses
      canonicalize
      cse
      if changed {
        canonicalize
      }
    }
  }
  target-legalize(mode = "eager")
  if changed {
    for func {
      where target {
        canonicalize
        cse
      }
    }
  }
  for func {
    where target {
      unroll-scf-for
      if changed {
        canonicalize
        cse
      }
      sroa-vector-banks
      if changed {
        canonicalize
        cse
      }
      sink-single-use-reads
      if changed {
        canonicalize
        cse
      }
      promote-private-fragments
      if changed {
        canonicalize
        cse
      }
      scf-to-cfg
      cfg-simplify
      canonicalize
      cse
      branch-sink
    }
  }
  for func {
    where target {
      sanitizer-insert-assertions(checks = "access")
