// ====
// RUN: emit source-low output=module

amdgpu.target<gfx11-generic> @target

func.def target(@target) @module_output_prints_low_asm(%lhs: i32, %rhs: i32) -> (i32) {
  %product = scalar.muli %lhs, %rhs : i32
  func.return %product : i32
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@__loom_target_context_0_0) abi(hal_kernel) @module_output_prints_low_asm(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %product = s_mul_i32 %lhs, %rhs
  return %product
}

amdgpu.target<gfx11-generic> @__loom_target_context_0_0 {subgroup_size = 32}

// ====
// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

template.decl @pipeline.late_fragment_epilogue(%payload0: vector<8xf32>, %payload1: vector<8xf32>, %payload2: vector<8xf32>, %payload3: vector<8xf32>, %output: buffer, %column_count: index)

template.def<@pipeline.late_fragment_epilogue> target(@target) @late_fragment_epilogue_provider(%payload0: vector<8xf32>, %payload1: vector<8xf32>, %payload2: vector<8xf32>, %payload3: vector<8xf32>, %output: buffer, %column_count: index) {
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16x[%column_count]xbf16>
  %epilogue0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %payload0, %payload0 : vector<8xf32>
  %epilogue1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %payload1, %payload1 : vector<8xf32>
  %epilogue2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %payload2, %payload2 : vector<8xf32>
  %epilogue3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %payload3, %payload3 : vector<8xf32>
  vector.fragment.store<result> %epilogue0, %output_view[0, 0] shape [%m, %n] : vector<8xf32>, view<16x[%column_count]xbf16>
  vector.fragment.store<result> %epilogue1, %output_view[0, 16] shape [%m, %n] : vector<8xf32>, view<16x[%column_count]xbf16>
  vector.fragment.store<result> %epilogue2, %output_view[0, 32] shape [%m, %n] : vector<8xf32>, view<16x[%column_count]xbf16>
  vector.fragment.store<result> %epilogue3, %output_view[0, 48] shape [%m, %n] : vector<8xf32>, view<16x[%column_count]xbf16>
  template.return
}

kernel.def target(@target) @target_legalization_precedes_cfg_finalization() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%output: buffer) {
  %payload0 = vector.constant 1.0 : vector<8xf32>
  %payload1 = vector.constant 2.0 : vector<8xf32>
  %payload2 = vector.constant 3.0 : vector<8xf32>
  %payload3 = vector.constant 4.0 : vector<8xf32>
  %column_count = index.constant 64 : index
  template.apply<@pipeline.late_fragment_epilogue>(%payload0, %payload1, %payload2, %payload3, %output, %column_count) : (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, buffer, index)
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @target_legalization_precedes_cfg_finalization() asm {
  %34 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %output_view = resource<hal_binding> {extent = 2048, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %72 = v_and_b32_src0_inline %34, 15
  %73 = v_lshlrev_b32_src0_inline %72, 1
  %74 = v_lshrrev_b32_src0_inline %34, 4
