  %84 = v_mov_b32 16512
  global_store_short_saddr %75, %84, %output_view {offset = 32}
  global_store_short_saddr %75, %84, %output_view {offset = 288}
  global_store_short_saddr %75, %84, %output_view {offset = 544}
