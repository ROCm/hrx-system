amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @sopk_immediate_mul_rejected_live_lhs(%position: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %scale = s_mov_b32 3
  // REMARK@+2: BACKEND/042 {source_descriptor_key="amdgpu.s_mul_i32", replacement_descriptor_key="amdgpu.s_mulk_i32", decision="rejected", reason_key="destructive_operand_not_single_use", immediate_name="imm16", immediate_value="3", tied_operand_name="lhs", tied_value_name="position"}
  // REMARK@+1: BACKEND/042 {source_descriptor_key="amdgpu.s_mul_i32", replacement_descriptor_key="amdgpu.s_mul_i32.rhs_inline", decision="selected", reason_key="selected", immediate_name="imm32", immediate_value="3", tied_operand_name="<none>", tied_value_name="<none>"}
