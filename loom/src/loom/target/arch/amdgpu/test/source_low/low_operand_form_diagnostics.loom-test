low.func.def target<amdgpu.rdna3.core>(@target) @sopk_immediate_mul_rejected_live_lhs(%position: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
