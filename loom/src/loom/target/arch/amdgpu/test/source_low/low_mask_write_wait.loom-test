// RUN: emit amdgpu-assembly @latest_retained_mask strategy=source allocation-diagnostics=predicted-spills fixed=%first_mask:physical_register:0:2 fixed=%second_mask:physical_register:4:2 fixed=%first_joined:physical_register:0:2 fixed=%second_joined:physical_register:4:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @latest_retained_mask(%value: reg<amdgpu.vgpr>, %first_mask: reg<amdgpu.sgpr x2>, %second_mask: reg<amdgpu.sgpr x2>, %input: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %first_selected = v_cndmask_b32_src0_inline %value, %first_mask {false_value = 0}
  %second_selected = v_cndmask_b32_src0_inline %value, %second_mask {false_value = 0}
  %source = s_or_b64 %input, %input
  %first_copy = copy %source : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %second_copy = copy %source : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  low.br ^join(%first_copy: reg<amdgpu.sgpr x2>, %second_copy: reg<amdgpu.sgpr x2>)
^join(%first_joined: reg<amdgpu.sgpr x2>, %second_joined: reg<amdgpu.sgpr x2>):
  %first_result = s_or_b64 %first_joined, %source
  %second_result = s_or_b64 %second_joined, %source
  return %first_selected, %second_selected, %first_result, %second_result
}

