// ====

// Overwriting the lower unit retires that unit, not the complete predicate pair.
// RUN: emit amdgpu-assembly @partial_fixed_mask_copy strategy=source fixed=%mask:physical_register:0:2 fixed=%source:physical_register:4:1 fixed=%joined:physical_register:0:1

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @partial_fixed_mask_copy(%value: reg<amdgpu.vgpr>, %incoming_mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>) asm {
  %mask = low.assume %incoming_mask [] : reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^join(%source: reg<amdgpu.sgpr>)
^join(%joined: reg<amdgpu.sgpr>):
  %lower = s_or_b32 %joined, %source
  %upper = s_or_b32 %source, %source
  %result = s_or_b32 %lower, %upper
  return %selected, %result
}

