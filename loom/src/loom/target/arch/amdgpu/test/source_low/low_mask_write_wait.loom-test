// ====

// Two scalar sinks name one retained mask. Preserve it once for both sinks.
// RUN: emit amdgpu-assembly @shared_retained_mask strategy=source allocation-diagnostics=predicted-spills fixed=%mask:physical_register:0:2 fixed=%joined_low:physical_register:0:1 fixed=%joined_high:physical_register:1:1

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @shared_retained_mask(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %input: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %source_low = s_or_b32 %input, %input
  %source_high = s_and_b32 %input, %input
  %copy_low = copy %source_low : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %copy_high = copy %source_high : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^join(%copy_low: reg<amdgpu.sgpr>, %copy_high: reg<amdgpu.sgpr>)
^join(%joined_low: reg<amdgpu.sgpr>, %joined_high: reg<amdgpu.sgpr>):
  %result_low = s_or_b32 %joined_low, %source_low
  %result_high = s_or_b32 %joined_high, %source_high
  return %selected, %result_low, %result_high
}

