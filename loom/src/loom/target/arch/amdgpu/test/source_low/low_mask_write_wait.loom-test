// RUN: emit amdgpu-assembly @reuse strategy=source fixed=%mask:physical_register:0:2 fixed=%replacement:physical_register:0:2 fixed=%source:physical_register:4:2

// The join precedes its mask-reading predecessor in layout order.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %incoming_mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) asm {
  %mask = low.assume %incoming_mask [] : reg<amdgpu.sgpr x2>
  low.cond_br %condition, ^read_mask, ^skip : reg<amdgpu.scc>
^skip:
  low.br ^join
^join:
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
^read_mask:
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  low.br ^join
}

// ----
  s_cbranch_scc1 .Lbb3
.Lbb1:
.Lbb2:
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
  s_and_b64 s[0:1], s[0:1], s[4:5]
  s_endpgm
.Lbb3:
  v_cndmask_b32 v0, 0, v0, s[0:1]
  s_branch .Lbb2

