  %copied = copy %source : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^join(%copied: reg<amdgpu.sgpr>)
^join(%joined: reg<amdgpu.sgpr>):
  %result = s_or_b32 %joined, %source
  return %selected, %result
}

