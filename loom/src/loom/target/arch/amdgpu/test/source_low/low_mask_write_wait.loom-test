  s_mov_b32 s8, s2
  s_mov_b32 s9, s3
  s_mov_b32 s2, s0
  s_mov_b32 s3, s1
  v_cndmask_b32 v1, 0, v0, s[2:3]
  s_mov_b32 s0, s4
  s_mov_b32 s1, s6
