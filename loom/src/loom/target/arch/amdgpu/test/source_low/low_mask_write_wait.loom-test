  %source_high = slice %source[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %low_first = copy %source_low : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %high_first = copy %source_high : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %low_last = copy %low_first : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %high_last = copy %high_first : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^join(%low_last: reg<amdgpu.sgpr>, %high_last: reg<amdgpu.sgpr>)
^join(%joined_low: reg<amdgpu.sgpr>, %joined_high: reg<amdgpu.sgpr>):
  %result_low = s_or_b32 %joined_low, %source_low
  %result_high = s_or_b32 %joined_high, %source_high
  return %selected, %result_low, %result_high
}

