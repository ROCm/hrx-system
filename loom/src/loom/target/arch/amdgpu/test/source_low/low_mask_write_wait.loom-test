amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @computed_mask_sink(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %input: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %source = s_or_b32 %input, %input
  %copied = copy %source : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^join(%copied: reg<amdgpu.sgpr>)
^join(%joined: reg<amdgpu.sgpr>):
  %result = s_or_b32 %joined, %source
  return %selected, %result
}

