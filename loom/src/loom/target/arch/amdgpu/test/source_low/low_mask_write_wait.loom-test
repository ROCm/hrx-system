// RUN: emit amdgpu-assembly @partial_vcc strategy=source

// Writing vcc_lo leaves the prior high-half mask read relevant to a later
// full-mask overwrite even without an intervening predicate use.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @partial_vcc(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %mask {false_value = 0}
  %partial = s_mov_b32_vcc_imm 1
  %replacement = v_cmp_eq_i32_src0_inline_vcc %value {lhs = 0}
  %again = v_cndmask_b32_src0_inline_vcc %selected, %replacement {false_value = 0}
  return
}

