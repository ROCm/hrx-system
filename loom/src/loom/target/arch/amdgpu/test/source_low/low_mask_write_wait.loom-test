// RUN: emit amdgpu-assembly @reuse strategy=source fixed=%replacement:physical_register:0:2 fixed=%source:physical_register:4:2

// A loop header sees a mask read arriving from its backedge.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @reuse(%value: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>) asm {
  low.br ^header
^header:
  %replacement = s_or_b64 %source, %source
  low.br ^body
^body:
  %chosen = v_cndmask_b32_src0_inline %value, %replacement {false_value = 0}
  low.br ^header
}

// ----
.Lbb1:
  s_or_b64 s[0:1], s[4:5], s[4:5]
  s_waitcnt_depctr 0xff9e
.Lbb2:
  v_cndmask_b32 v1, 0, v0, s[0:1]
  s_branch .Lbb1

