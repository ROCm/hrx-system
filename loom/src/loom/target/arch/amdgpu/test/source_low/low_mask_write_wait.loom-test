// ====

// Independent retained inputs can occupy separate preserved pairs without
// scratch registers, spills or completion waits.
// RUN: emit amdgpu-assembly @independent_computed_masks strategy=source allocation-diagnostics=predicted-spills fixed=%first_mask:physical_register:0:2 fixed=%first_joined:physical_register:0:2 fixed=%second_mask:physical_register:2:2 fixed=%second_joined:physical_register:2:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @independent_computed_masks(%value: reg<amdgpu.vgpr>, %first_mask: reg<amdgpu.sgpr x2>, %second_mask: reg<amdgpu.sgpr x2>, %input: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %first_selected = v_cndmask_b32_src0_inline %value, %first_mask {false_value = 0}
  %first_source = s_or_b64 %input, %input
  %first_copy = copy %first_source : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  low.br ^first_join(%first_copy: reg<amdgpu.sgpr x2>)
^first_join(%first_joined: reg<amdgpu.sgpr x2>):
  %first_result = s_or_b64 %first_joined, %first_source
  %second_selected = v_cndmask_b32_src0_inline %value, %second_mask {false_value = 0}
  %second_source = s_or_b64 %input, %input
  %second_copy = copy %second_source : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  low.br ^second_join(%second_copy: reg<amdgpu.sgpr x2>)
^second_join(%second_joined: reg<amdgpu.sgpr x2>):
  %second_result = s_or_b64 %second_joined, %second_source
  return %first_selected, %first_result, %second_selected, %second_result
}

