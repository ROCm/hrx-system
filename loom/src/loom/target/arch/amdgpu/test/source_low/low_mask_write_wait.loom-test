// ====

// A longer-lived source participates in both transfers. Each fixed mask is
// preserved exactly once despite those shared source observations.
// RUN: emit amdgpu-assembly @nonconsecutive_shared_retained_mask strategy=source allocation-diagnostics=predicted-spills fixed=%first_mask:physical_register:0:2 fixed=%second_mask:physical_register:2:2 fixed=%first_joined_low:physical_register:0:1 fixed=%first_joined_high:physical_register:1:1 fixed=%second_joined:physical_register:2:1

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @nonconsecutive_shared_retained_mask(%value: reg<amdgpu.vgpr>, %first_mask: reg<amdgpu.sgpr x2>, %second_mask: reg<amdgpu.sgpr x2>, %first_source: reg<amdgpu.sgpr>, %second_source: reg<amdgpu.sgpr>, %shared_source: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %first_selected = v_cndmask_b32_src0_inline %value, %first_mask {false_value = 0}
  %first_copy = copy %first_source : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %shared_copy = copy %shared_source : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^first_join(%first_copy: reg<amdgpu.sgpr>, %shared_copy: reg<amdgpu.sgpr>)
^first_join(%first_joined_low: reg<amdgpu.sgpr>, %first_joined_high: reg<amdgpu.sgpr>):
  %first_result_low = s_or_b32 %first_joined_low, %first_source
  %first_result_high = s_or_b32 %first_joined_high, %shared_source
  %second_selected = v_cndmask_b32_src0_inline %value, %second_mask {false_value = 0}
  %second_copy = copy %second_source : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  low.br ^second_join(%second_copy: reg<amdgpu.sgpr>)
^second_join(%second_joined: reg<amdgpu.sgpr>):
  %second_result = s_or_b32 %second_joined, %second_source
  return %first_selected, %first_result_low, %first_result_high, %second_selected, %second_result, %shared_source
}

