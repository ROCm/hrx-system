// ====

// An ordinary scalar VALU input clears the retained read before the same copy.
// RUN: emit amdgpu-assembly @fixed_mask_copy_after_reset strategy=source fixed=%mask:physical_register:0:2 fixed=%source:physical_register:4:2 fixed=%joined:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @fixed_mask_copy_after_reset(%value: reg<amdgpu.vgpr>, %incoming_mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>) asm {
  %mask = low.assume %incoming_mask [] : reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %word = slice %source[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %broadcast = v_mov_b32_copy %word
  low.br ^join(%source: reg<amdgpu.sgpr x2>)
^join(%joined: reg<amdgpu.sgpr x2>):
  %result = s_or_b64 %joined, %source
  return %selected, %broadcast, %result
}

