  %choice = vector.extract %choices[0] : vector<2xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %threshold : i32
  %replacement = scalar.constant 1.0 : f8E4M3
  %selected = scf.select %condition, %left, %right : f8E4M3
  %right_constant = scf.select %condition, %left, %replacement : f8E4M3
  %left_constant = scf.select %condition, %replacement, %right : f8E4M3
  func.return %selected, %right_constant, %left_constant : f8E4M3, f8E4M3, f8E4M3
}

