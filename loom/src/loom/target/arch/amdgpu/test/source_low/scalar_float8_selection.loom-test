  %replacement = scalar.constant 1.0 : f8E5M2
  %selected = scf.select %condition, %left, %right : f8E5M2
  %right_constant = scf.select %condition, %left, %replacement : f8E5M2
  %left_constant = scf.select %condition, %replacement, %right : f8E5M2
