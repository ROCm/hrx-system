// ====
// RUN: emit amdgpu-wait-counter-plan-json @scratch_store_load_memory_effect strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @scratch_store_load_memory_effect(%addr: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  scratch_store_b32_vaddr %addr, %value
  %loaded = scratch_load_b32_vaddr %addr
  return %loaded
}

// The scratch load has no SSA dependency on the preceding scratch store, but
// the schedule records a stack-memory effect dependency. The wait plan must
// drain VMEM stores before the load can observe private memory.
// ----
