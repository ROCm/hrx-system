// ====
// RUN: emit amdgpu-wait-counter-plan-json @loop_carried_branch_arg_waits_at_next_iteration_use strategy=source

amdgpu.target<gfx1100> @target
low.func.def target(@target) @loop_carried_branch_arg_waits_at_next_iteration_use(%addr: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr x2>, %base: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>, %limit: reg<amdgpu.sgpr>) asm<amdgpu.rdna3.core> {
  %zero = s_mov_b32 0
  low.br ^loop(%seed: reg<amdgpu.vgpr x2>, %zero: reg<amdgpu.sgpr>)
^loop(%carried: reg<amdgpu.vgpr x2>, %i: reg<amdgpu.sgpr>):
  global_store_b64_saddr %addr, %carried, %output
  %next_carried = global_load_b64_saddr %addr, %base
  %one = s_mov_b32 1
  %next_i = s_add_u32 %i, %one
  %again = s_cmp_lt_i32 %next_i, %limit
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next_carried: reg<amdgpu.vgpr x2>, %next_i: reg<amdgpu.sgpr>)
^exit:
  return
}

// The loop-carried load is scheduled after the store in the same static block,
// but dynamically feeds the store at the top of the next iteration. The wait
// must therefore stay at the carried value's consumer instead of being elided
// as an already-observed same-block producer.
// ----
