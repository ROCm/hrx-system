// ====
// RUN: emit amdgpu-wait-counter-plan-json @conservative_scratch_stores_do_not_subsume_memory_effects strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @conservative_scratch_stores_do_not_subsume_memory_effects(%addr0: reg<amdgpu.vgpr>, %addr1: reg<amdgpu.vgpr>, %value0: reg<amdgpu.vgpr>, %value1: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  scratch_store_b32_vaddr %addr0, %value0
  scratch_store_b32_vaddr %addr1, %value1
  %loaded = scratch_load_b32_vaddr %addr0
  return %loaded
}

// Descriptor-level scratch effects only prove stack-memory space, not the byte
// slot touched by each dynamic address. The second store must not erase the
// first store from the frontier, because the later load may observe either.
// ----
