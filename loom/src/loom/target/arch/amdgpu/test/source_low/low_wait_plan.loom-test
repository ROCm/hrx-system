low.func.def target(@target) @explicit_lgkm_wait_keeps_vmem_pending(%addr: reg<amdgpu.vgpr>, %global: reg<amdgpu.sgpr x2>, %acc: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm<amdgpu.rdna3.core> {
