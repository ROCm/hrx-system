// ====
// RUN: emit amdgpu-assembly @global_load_saddr_source_reuse_assembly strategy=source amdgpu.sgpr=4

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @global_load_saddr_source_reuse_assembly(%addr: reg<amdgpu.vgpr>, %load_base: reg<amdgpu.sgpr x2>, %keep: reg<amdgpu.sgpr x2>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b32_saddr %addr, %load_base
  %mask = v_cmp_lt_i32 %lhs, %rhs
  %saved_exec, %active = s_and_saveexec_b64 %mask
  %keep_lo = slice %keep[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %keep_hi = slice %keep[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %kept = s_add_u32 %keep_lo, %keep_hi
  %used = v_add_u32 %loaded, %addr
  return
}

// ----
  global_load_b32 v3, v2, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_cmp_lt_i32 s[0:1], v0, v1
  s_delay_alu instid0(VALU_DEP_1)
  s_and_saveexec_b64 s[0:1], s[0:1]
  s_add_u32 s0, s2, s3
  v_add_u32 v0, v3, v2
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @gfx1170_vcc_dependency_delay strategy=source

amdgpu.target<gfx1170> @target

low.func.def target<amdgpu.rdna4m.core>(@target) @gfx1170_vcc_dependency_delay(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  %mask = v_cmp_lt_i32 %lhs, %rhs
  %saved_exec, %active = s_and_saveexec_b64 %mask
  return
}

// LLVM classifies gfx1170-gfx1172 as GFX11 targets and runs its S_DELAY_ALU
// insertion pass for the family. Loom must preserve the same dependent VCC
// scheduling contract rather than treating RDNA 4m as hazard-free.
// ----
  v_cmp_lt_i32 s[0:1], v0, v1
  s_delay_alu instid0(VALU_DEP_1)
  s_and_saveexec_b64 s[0:1], s[0:1]
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @global_load_saddr_source_reuse_across_branch_assembly strategy=source amdgpu.sgpr=4

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @global_load_saddr_source_reuse_across_branch_assembly(%addr: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  %base_lo = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_hi = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %zero = s_mov_b32 0
  %lo = s_add_u32 %base_lo, %offset
  %hi = s_addc_u32 %base_hi, %zero
  %load_base = concat(%lo, %hi) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %loaded = global_load_b32_saddr %addr, %load_base
  %branch_mask = v_cmp_lt_i32 %lhs, %rhs
  %saved_exec, %active = s_and_saveexec_b64 %branch_mask
  low.cond_br %active, ^then, ^exit : reg<amdgpu.scc>
^then:
  %saved_lo = slice %saved_exec[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %saved_hi = slice %saved_exec[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %saved_use = s_add_u32 %saved_lo, %saved_lo
  %mask = v_cmp_eq_i32 %lhs, %rhs
  %saved_use2 = s_add_u32 %saved_hi, %saved_hi
  %used = v_add_u32 %loaded, %addr
  low.br ^exit
^exit:
  return
}

// ----
  s_mov_b32 s3, 0
  s_add_u32 s0, s0, s2
  s_addc_u32 s1, s1, s3
  global_load_b32 v3, v2, s[0:1] offset:0
  v_cmp_lt_i32 s[2:3], v0, v1
  s_delay_alu instid0(VALU_DEP_1)
  s_and_saveexec_b64 s[2:3], s[2:3]
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_add_u32 s2, s2, s2
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_cmp_eq_i32 s[0:1], v0, v1
  s_add_u32 s0, s3, s3
  v_add_u32 v0, v3, v2
.Lbb2:
  s_endpgm

// ====
// RUN: emit amdgpu-wait-counter-plan-json @branch_load_join_store_common_wait strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @branch_load_join_store_common_wait(%addr: reg<amdgpu.vgpr>, %cond: reg<amdgpu.scc>, %base0: reg<amdgpu.sgpr x2>, %base1: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
  low.cond_br %cond, ^then, ^else : reg<amdgpu.scc>
^then:
  %loaded0 = global_load_b64_saddr %addr, %base0
  low.br ^join(%loaded0: reg<amdgpu.vgpr x2>)
^else:
  %loaded1 = global_load_b64_saddr %addr, %base1
  low.br ^join(%loaded1: reg<amdgpu.vgpr x2>)
^join(%loaded: reg<amdgpu.vgpr x2>):
  global_store_b64_saddr %addr, %loaded, %output
  return
}

// The low.br edges only forward the VMEM payload. The store in the join block
// is the first hardware consumer, so both incoming paths share one wait there.
// ----
{"format":"loom.low.packet_hazard_plan.v1","function":"branch_load_join_store_common_wait","target":"target","descriptor_set":"amdgpu.rdna3.core","progress_count":3,"hazard_count":2,"progress":[{"index":0,"packet":1,"node":1,"block":1,"scheduled_ordinal":0,"class_id":1,"class_name":"amdgpu.vmem_load","action":"advance","units":1},{"index":1,"packet":3,"node":3,"block":2,"scheduled_ordinal":0,"class_id":1,"class_name":"amdgpu.vmem_load","action":"advance","units":1},{"index":2,"packet":5,"node":5,"block":3,"scheduled_ordinal":0,"class_id":2,"class_name":"amdgpu.vmem_store","action":"advance","units":1}],"hazards":[{"index":0,"kind":"action","action_id":1,"action_name":"amdgpu.wait_packet","reason_id":8,"reason_name":"amdgpu.memory_effect","producer_node":null,"producer_packet":null,"producer_scheduled_ordinal":null,"consumer_node":5,"insertion_packet":5,"block":3,"scheduled_ordinal":0,"progress_class_id":1,"progress_class_name":"amdgpu.vmem_load","required":1,"observed":0,"residual":1},{"index":1,"kind":"action","action_id":1,"action_name":"amdgpu.wait_packet","reason_id":9,"reason_name":"amdgpu.program_exit","producer_node":null,"producer_packet":null,"producer_scheduled_ordinal":null,"consumer_node":6,"insertion_packet":6,"block":3,"scheduled_ordinal":1,"progress_class_id":2,"progress_class_name":"amdgpu.vmem_store","required":1,"observed":0,"residual":1}]}

// ====
// RUN: emit amdgpu-wait-counter-plan-json @branch_arg_repair_consumes_load_before_store strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @branch_arg_repair_consumes_load_before_store(%addr: reg<amdgpu.vgpr>, %load_cond: reg<amdgpu.scc>, %mask: reg<amdgpu.sgpr x2>, %base: reg<amdgpu.sgpr x2>) asm {
  low.cond_br %load_cond, ^load, ^zero : reg<amdgpu.scc>
^load:
  %loaded = global_load_b128_saddr %addr, %base
  low.br ^join(%loaded: reg<amdgpu.vgpr x4>)
^zero:
  %zero_lane = v_mov_b32 0
  %zero = concat(%zero_lane, %zero_lane, %zero_lane, %zero_lane) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  low.br ^join(%zero: reg<amdgpu.vgpr x4>)
^join(%value: reg<amdgpu.vgpr x4>):
  low.cond_br %load_cond, ^to_repair, ^keep : reg<amdgpu.scc>
^keep:
  low.br ^store(%value: reg<amdgpu.vgpr x4>)
^store(%stored: reg<amdgpu.vgpr x4>):
  ds_write_b128 %addr, %stored
  return
^to_repair:
  low.br ^repair
^repair:
  %lane0 = slice %value[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %fixed0 = v_cndmask_b32_src0_inline %lane0, %mask {false_value = 0}
  %lane1 = slice %value[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %fixed1 = v_cndmask_b32_src0_inline %lane1, %mask {false_value = 0}
  %lane2 = slice %value[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %fixed2 = v_cndmask_b32_src0_inline %lane2, %mask {false_value = 0}
  %lane3 = slice %value[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %fixed3 = v_cndmask_b32_src0_inline %lane3, %mask {false_value = 0}
  %fixed = concat(%fixed0, %fixed1, %fixed2, %fixed3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  low.br ^store(%fixed: reg<amdgpu.vgpr x4>)
}

// A wait in the store block is not path-dominating for the out-of-line repair
// block, even when the store block is laid out first. The first repair consumer
// must wait for the VMEM load. Its physical destination write is diagnosed as
// result reuse before SSA consumer handling, and the remaining repair lanes can
// reuse that block-local wait.
// ----
