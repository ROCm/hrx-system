amdgpu.target<gfx1100> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@target) @explicit_join_lgkm_wait_satisfies_cross_block_lds_use_assembly(%addr: reg<amdgpu.vgpr>, %cond: reg<amdgpu.scc>, %rhs: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
