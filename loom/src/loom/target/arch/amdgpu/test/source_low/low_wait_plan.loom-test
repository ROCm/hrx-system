amdgpu.target<gfx1100> @target
low.func.def target(@target) @conservative_scratch_stores_do_not_subsume_memory_effects(%addr0: reg<amdgpu.vgpr>, %addr1: reg<amdgpu.vgpr>, %value0: reg<amdgpu.vgpr>, %value1: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm<amdgpu.rdna3.core> {
