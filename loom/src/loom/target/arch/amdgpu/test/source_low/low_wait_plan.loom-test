}

// The explicit wait in the join block drains LDS packets from every incoming
// path while leaving VMEM untouched. A later LDS consumer in the same block
// must reuse that block-local full drain instead of planning another wait.
// ----
{"format":"loom.low.packet_hazard_plan.v1","function":"explicit_join_lgkm_wait_satisfies_cross_block_lds_use","target":"target","descriptor_set":"amdgpu.rdna3.core","progress_count":3,"hazard_count":0,"progress":[{"index":0,"packet":1,"node":1,"block":1,"scheduled_ordinal":0,"class_id":3,"class_name":"amdgpu.lds","action":"advance","units":1},{"index":1,"packet":6,"node":6,"block":3,"scheduled_ordinal":0,"class_id":3,"class_name":"amdgpu.lds","action":"reset","units":0},{"index":2,"packet":6,"node":6,"block":3,"scheduled_ordinal":0,"class_id":4,"class_name":"amdgpu.smem","action":"reset","units":0}],"hazards":[]}

