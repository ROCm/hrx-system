amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @scratch_offset_only_stores_do_not_subsume_memory_effects(%value0: reg<amdgpu.vgpr>, %value1: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  scratch_store_b32_offset_only %value0
  scratch_store_b32_offset_only %value1 {offset = 4}
  %loaded = scratch_load_b32_offset_only
  return %loaded
}

