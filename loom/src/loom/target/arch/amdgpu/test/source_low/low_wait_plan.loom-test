// The zero arm materializes its concat as dependent VALU edge copies. GFX11
// must delay the first copy after producing %zero_lane.
// ----
  s_cbranch_scc0 .Lbb2
.Lbb1:
  ds_read_b128 v[4:7], v1 offset:0
  s_branch .Lbb3
.Lbb2:
  v_mov_b32 v4, 0
  s_delay_alu instid0(VALU_DEP_1)
  v_mov_b32 v5, v4
  v_mov_b32 v6, v4
  v_mov_b32 v7, v4
.Lbb3:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v4, v0
  global_store_b32 v1, v0, s[0:1] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

