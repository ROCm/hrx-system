// RUN: emit amdgpu-wait-counter-plan-json @slice_forwards_lds_wait

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @slice_forwards_lds_wait(%addr: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = ds_read_b128 %addr
  %lane0 = slice %loaded[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %result = v_add_f32 %lane0, %rhs
  return %result
}

