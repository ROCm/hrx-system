amdgpu.target<gfx1100> @target
low.func.def target(@target) @branch_load_join_store_common_wait(%addr: reg<amdgpu.vgpr>, %cond: reg<amdgpu.scc>, %base0: reg<amdgpu.sgpr x2>, %base1: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm<amdgpu.rdna3.core> {
  low.cond_br %cond, ^then, ^else : reg<amdgpu.scc>
^then:
