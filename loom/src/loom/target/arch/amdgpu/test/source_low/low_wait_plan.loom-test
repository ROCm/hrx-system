  s_mov_b32 s3, 0
  s_add_u32 s0, s0, s2
  s_addc_u32 s1, s1, s3
  global_load_b32 v3, v2, s[0:1] offset:0
  v_cmp_lt_i32 s[2:3], v0, v1
  s_delay_alu instid0(VALU_DEP_1)
  s_and_saveexec_b64 s[2:3], s[2:3]
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_add_u32 s2, s2, s2
  s_waitcnt vmcnt(0) lgkmcnt(63)
