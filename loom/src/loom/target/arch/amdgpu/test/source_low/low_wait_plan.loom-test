// ====
// RUN: emit amdgpu-wait-counter-plan-json @scratch_store_load_backedge_memory_effect strategy=source

amdgpu.target<gfx1100> @target
low.func.def target(@target) @scratch_store_load_backedge_memory_effect(%addr: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr>) asm<amdgpu.rdna3.core> {
  low.br ^load
^load:
  %loaded = scratch_load_b32_vaddr %addr
  low.cond_br %again, ^store, ^exit : reg<amdgpu.scc>
^store:
  scratch_store_b32_vaddr %addr, %value
  low.br ^load
^exit:
  return %loaded
}

// The scratch store is in a statically later block, but dynamically reaches the
// next loop-header scratch load on the backedge. The wait plan must preserve
// that visibility hazard instead of requiring producer ordinals to precede
// consumer ordinals.
// ----
