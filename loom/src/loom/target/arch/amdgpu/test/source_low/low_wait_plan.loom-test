// RUN: emit amdgpu-assembly @explicit_lgkm_wait_keeps_vmem_pending_assembly

amdgpu.target<gfx1100> @target {subgroup_size = 64}
low.func.def target(@target) @explicit_lgkm_wait_keeps_vmem_pending_assembly(%addr: reg<amdgpu.vgpr>, %global: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>, %acc: reg<amdgpu.vgpr x4>) asm<amdgpu.rdna3.core> {
  %lhs0 = global_load_b128_saddr %addr, %global
  %lhs1 = global_load_b128_saddr %addr, %global {offset = 16}
  %lhs = concat(%lhs0, %lhs1) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs0 = ds_read_b128 %addr
  %rhs1 = ds_read_b128 %addr {offset = 16}
  %rhs = concat(%rhs0, %rhs1) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %result = v_wmma_f16_16x16x16_f16_w64 %lhs, %rhs, %acc
  s_waitcnt {lgkmcnt = 0, vmcnt = 63}
  global_store_b128_saddr %addr, %result, %output
  return
}

// The explicit wait may be scheduled before the WMMA, but it must stay a
// no-wait for VMEM. A separate VMEM wait is required before the WMMA consumes
// global-load operands.
// ----
  global_load_b128 v[8:11], v4, s[0:1] offset:0
  global_load_b128 v[12:15], v4, s[0:1] offset:16
  ds_read_b128 v[16:19], v4 offset:0
  ds_read_b128 v[20:23], v4 offset:16
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_wmma_f16_16x16x16_f16 v[0:3], v[8:15], v[16:23], v[0:3]
  global_store_b128 v4, v[0:3], s[2:3] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm
