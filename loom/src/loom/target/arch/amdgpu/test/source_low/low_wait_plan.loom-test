low.func.def target(@target) @loop_carried_branch_arg_waits_at_next_iteration_use_assembly(%addr: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr x2>, %base: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>, %limit: reg<amdgpu.sgpr>) asm<amdgpu.rdna3.core> {
