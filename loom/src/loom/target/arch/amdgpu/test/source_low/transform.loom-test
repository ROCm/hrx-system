amdgpu.target<gfx11-generic> @target

func.def target(@target) @hadamard_orthonormal_f32x4(%input: vector<4xf32>) -> (vector<4xf32>) {
  %transform = encoding.define #transform.hadamard<normalization=orthonormal> : encoding<transform>
  %result = vector.transform %input, %transform : vector<4xf32>, encoding<transform> -> vector<4xf32>
  func.return %result : vector<4xf32>
}

