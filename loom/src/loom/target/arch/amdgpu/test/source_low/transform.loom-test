low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @hadamard_orthonormal_f32x4(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %6 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %7 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = v_add_f32 %6, %7
  %11 = v_sub_f32 %6, %7
  %12 = v_add_f32 %8, %9
  %13 = v_sub_f32 %8, %9
  %14 = v_add_f32 %10, %12
  %15 = v_sub_f32 %10, %12
  %16 = v_add_f32 %11, %13
  %17 = v_sub_f32 %11, %13
  %18 = v_mul_f32_lit %14, 1056964608
  %19 = v_mul_f32_lit %16, 1056964608
  %20 = v_mul_f32_lit %15, 1056964608
  %21 = v_mul_f32_lit %17, 1056964608
  %result = concat(%18, %19, %20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @hadamard_wide_f16_load() {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %workitem = kernel.workitem.id<x> : index
  %c8 = index.constant 8 : index
  %base = index.mul %workitem, %c8 : index
  %buffer_base = index.constant 0 : offset
  %transform = encoding.define #transform.hadamard : encoding<transform>
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<256xf16>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<256xf16>
  %packed = vector.load %input_view[%base] : view<256xf16> -> vector<8xf16>
  %wide = vector.extf %packed : vector<8xf16> to vector<8xf32>
  %transformed = vector.transform %wide, %transform : vector<8xf32>, encoding<transform> -> vector<8xf32>
  %result = vector.fptrunc %transformed : vector<8xf32> to vector<8xf16>
  vector.store %result, %output_view[%base] : vector<8xf16>, view<256xf16>
  kernel.return
}

