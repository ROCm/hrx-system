// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @hadamard_f32x4(%input: vector<4xf32>) -> (vector<4xf32>) {
  %transform = encoding.define #transform.hadamard : encoding<transform>
  %result = vector.transform %input, %transform : vector<4xf32>, encoding<transform> -> vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @hadamard_f32x4(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %6 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %7 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %10 = v_add_f32 %6, %7
  %11 = v_sub_f32 %6, %7
  %12 = v_add_f32 %8, %9
  %13 = v_sub_f32 %8, %9
  %14 = v_add_f32 %10, %12
  %15 = v_sub_f32 %10, %12
  %16 = v_add_f32 %11, %13
  %17 = v_sub_f32 %11, %13
  %result = concat(%14, %16, %15, %17) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

