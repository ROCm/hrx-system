kernel.def @packed_masked_consumer() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer, %count: index) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<4xi32>
  %packed = vector.load %input_view[0] : view<4xi8> -> vector<4xi8>
  %indices = vector.extui %packed : vector<4xi8> to vector<4xi32>
  %start = index.constant 0 : index
  %step = index.constant 1 : index
  %mask = vector.mask.range [%start to %count step %step] : index -> vector<4xi1>
  %passthrough = vector.splati -17 : vector<4xi32>
  %values = vector.gather.mask %table_view[0][%indices], %mask, %passthrough : view<256xi32>, vector<4xi32>, vector<4xi1>, vector<4xi32>
  vector.store.mask %values, %output_view[0], %mask : vector<4xi32>, view<4xi32>, vector<4xi1>
  kernel.return
}

