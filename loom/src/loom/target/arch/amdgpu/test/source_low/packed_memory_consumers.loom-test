kernel.def @packed_scatter_alias() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%storage: buffer) {
  %base = index.constant 0 : offset
  %view = buffer.view %storage[%base] : buffer -> view<4xi8>
  %packed = vector.load %view[0] : view<4xi8> -> vector<4xi8>
  %last = scalar.constant 3 : i32
  %step = scalar.constant -1 : i32
  %reverse = vector.iota %last step %step : vector<4xi32>
  vector.scatter %packed, %view[0][%reverse] : vector<4xi8>, view<4xi8>, vector<4xi32>
  kernel.return
}

