kernel.def @packed_halfword_lookup() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<2xi16>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<2xi32>
  %packed = vector.load %input_view[0] : view<2xi16> -> vector<2xi16>
  %wide = vector.extui %packed : vector<2xi16> to vector<2xi32>
  %mask = vector.splati 255 : vector<2xi32>
  %indices = vector.andi %wide, %mask : vector<2xi32>
  %values = vector.gather %table_view[0][%indices] : view<256xi32>, vector<2xi32> -> vector<2xi32>
  vector.store %values, %output_view[0] : vector<2xi32>, view<2xi32>
  kernel.return
}

