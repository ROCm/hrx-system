// Both consumers observe the same captured bytes despite the intervening write.
kernel.def @packed_snapshot_consumers() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %table: buffer, %unsigned_output: buffer, %signed_output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %unsigned_view = buffer.view %unsigned_output[%base] : buffer -> view<4xi32>
  %signed_view = buffer.view %signed_output[%base] : buffer -> view<4xi32>
  %packed = vector.load %input_view[0] : view<4xi8> -> vector<4xi8>
  %unsigned = vector.extui %packed : vector<4xi8> to vector<4xi32>
  %unsigned_values = vector.gather %table_view[0][%unsigned] : view<256xi32>, vector<4xi32> -> vector<4xi32>
  %replacement = vector.splati 0 : vector<4xi8>
  vector.store %replacement, %input_view[0] : vector<4xi8>, view<4xi8>
  %signed = vector.extsi %packed : vector<4xi8> to vector<4xi32>
  %bias = vector.splati 128 : vector<4xi32>
  %signed_indices = vector.addi %signed, %bias : vector<4xi32>
  %signed_values = vector.gather %table_view[0][%signed_indices] : view<256xi32>, vector<4xi32> -> vector<4xi32>
  vector.store %unsigned_values, %unsigned_view[0] : vector<4xi32>, view<4xi32>
  vector.store %signed_values, %signed_view[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

