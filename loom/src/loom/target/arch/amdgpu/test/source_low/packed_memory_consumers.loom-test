// RUN: emit source-low target=amdgpu:gfx1151 output=low

kernel.def @packed_word_lookup() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<4xi32>
  %packed = vector.load %input_view[0] : view<1xi32> -> vector<1xi32>
  %bytes = vector.bitcast %packed : vector<1xi32> to vector<4xi8>
  %indices = vector.extui %bytes : vector<4xi8> to vector<4xi32>
  %values = vector.gather %table_view[0][%indices] : view<256xi32>, vector<4xi32> -> vector<4xi32>
  vector.store %values, %output_view[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

