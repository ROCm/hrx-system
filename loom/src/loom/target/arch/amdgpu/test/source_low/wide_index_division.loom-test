// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

// A wide uniform numerator can produce independently narrow and wide index
// results without changing the retained two-word source carrier.
kernel.def target(@target) @uniform_wide_index_division() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: index, %result_buffer_0: buffer) where [range(%input, 4294967296, 1099511627775)] {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<2x64xi64>
  %value = index.assume %input [range(%input, 4294967296, 1099511627775)] : index
  %quotient_divisor = index.constant 256 : index
  %remainder_divisor = index.constant 4294967297 : index
  %quotient = index.div %value, %quotient_divisor : index
  %remainder = index.rem %value, %remainder_divisor : index
  %result_storage_0 = index.cast %quotient : index to i64
  view.store %result_storage_0, %result_view_0[0, %fixture_lane] : i64, view<2x64xi64>
  %result_storage_1 = index.cast %remainder : index to i64
  view.store %result_storage_1, %result_view_0[1, %fixture_lane] : i64, view<2x64xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "input"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [8], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_wide_index_division(%value: reg<amdgpu.sgpr x2>) where [range(%value, 4294967296, 1099511627775)] asm {
  %fixture_lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %result_view_0 = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = s_mov_b32 8
  %21 = s_lshr_b64 %value, %20
  %quotient = slice %21[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = s_mov_b32 4294967041
  %24 = s_mov_b32 255
  %26 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %30 = s_mov_b32 0
  %31 = s_mul_hi_u32 %26, %23
  %32 = s_mul_i32 %28, %23
  %33 = s_mul_hi_u32 %28, %23
  %40, %41 = s_add_co_u32 %32, %31
  %42, %43 = s_addc_u32 %33, %30, %41
  %47 = s_mul_i32 %26, %24
  %48 = s_mul_hi_u32 %26, %24
  %55, %56 = s_add_co_u32 %47, %40
  %57, %58 = s_addc_u32 %48, %30, %56
  %62 = s_mul_i32 %28, %24
  %63 = s_mul_hi_u32 %28, %24
  %70, %71 = s_add_co_u32 %62, %42
  %72, %73 = s_addc_u32 %63, %30, %71
  %80, %81 = s_add_co_u32 %70, %57
  %82, %83 = s_addc_u32 %72, %30, %81
  %84 = concat(%80, %82) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %86 = s_lshr_b64 %84, %20
  %87 = slice %86[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %88 = s_mov_b32 1
  %93 = s_mul_i32 %87, %88
  %94 = s_mul_hi_u32 %87, %88
  %96 = s_add_u32 %94, %93
  %102, %103 = s_sub_co_u32 %26, %93
  %104, %105 = s_subb_u32 %28, %96, %103
  %110 = v_mov_b32_copy %quotient
  %112 = v_mov_b32_copy %30
  %113 = concat(%110, %112) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %114 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %114, %113, %result_view_0
  %116 = v_mov_b32_copy %102
  %118 = v_mov_b32_copy %104
  %119 = concat(%116, %118) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %114, %119, %result_view_0 {offset = 512}
  return
}

// ====

amdgpu.target<gfx942> @target

// Varying index division uses the same retained word-arithmetic recipe while
// publishing the fact-selected width of each result.
func.def target(@target) @varying_wide_index_division(%inputs: vector<2xi64>) -> (index, index) {
  %input = vector.extract %inputs[0] : vector<2xi64> -> i64
  %bounded = scalar.assume %input [range(%input, 4294967296, 1099511627775)] : i64
  %value = index.cast %bounded : i64 to index
  %quotient_divisor = index.constant 3 : index
  %remainder_divisor = index.constant 7 : index
  %quotient = index.div %value, %quotient_divisor : index
  %remainder = index.rem %value, %remainder_divisor : index
  func.return %quotient, %remainder : index, index
}

