low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @varying_wide_index_division(%inputs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>) asm {
  %14 = v_mov_b32 1431655766
  %15 = v_mov_b32 1431655765
  %160 = slice %inputs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %159 = slice %inputs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = v_mov_b32 0
  %22 = v_mul_hi_u32 %160, %14
  %23 = v_mul_lo_u32 %159, %14
  %24 = v_mul_hi_u32 %159, %14
  %31, %32 = v_add_co_u32 %23, %22
  %33, %34 = v_addc_co_u32 %24, %21, %32
  %38 = v_mul_lo_u32 %160, %15
  %39 = v_mul_hi_u32 %160, %15
  %46, %47 = v_add_co_u32 %38, %31
  %48, %49 = v_addc_co_u32 %39, %21, %47
  %53 = v_mul_lo_u32 %159, %15
  %54 = v_mul_hi_u32 %159, %15
  %61, %62 = v_add_co_u32 %53, %33
  %63, %64 = v_addc_co_u32 %54, %21, %62
  %71, %72 = v_add_co_u32 %61, %48
  %73, %74 = v_addc_co_u32 %63, %21, %72
  %quotient = concat(%71, %73) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %76 = v_mov_b32 2454267027
  %77 = v_mov_b32 613566756
  %84 = v_mul_hi_u32 %160, %76
  %85 = v_mul_lo_u32 %159, %76
  %86 = v_mul_hi_u32 %159, %76
  %93, %94 = v_add_co_u32 %85, %84
  %95, %96 = v_addc_co_u32 %86, %21, %94
  %100 = v_mul_lo_u32 %160, %77
  %101 = v_mul_hi_u32 %160, %77
  %108, %109 = v_add_co_u32 %100, %93
  %110, %111 = v_addc_co_u32 %101, %21, %109
  %115 = v_mul_lo_u32 %159, %77
  %123, %124 = v_add_co_u32 %115, %95
  %133, %134 = v_add_co_u32 %123, %110
  %138 = v_mov_b32 7
  %141 = v_mul_lo_u32 %133, %138
  %150, %151 = v_sub_co_u32 %160, %141
  return %quotient, %150
}
