// RUN: with-checks emit source-low output=low sanitizer=race sanitizer-reporting=trap

amdgpu.target<gfx11-generic> @target {subgroup_size = 32}

kernel.def target(@target) @race_wide_shared_store() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch() {
  %base = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %value = scalar.constant 1 : i64
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<1xi64>
  view.store %value, %view[0] : i64, view<1xi64>
  kernel.return
}

// ----
// The byte-range and bounded-retry loops share one static observation body.
// Widening an access must not duplicate the CAS body in the emitted program.
CHECK: low.kernel.def * @race_wide_shared_store() asm {
CHECK-COUNT-1: * = global_atomic_cmpswap_b64_rtn_saddr *
CHECK-COUNT-1: ds_write_b64 *
CHECK-NOT: *sanitizer.race.access*
