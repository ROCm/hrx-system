low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @varying_index_bits(%inputs: reg<amdgpu.vgpr x2>, %amount: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %input = slice %inputs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %22 = v_mov_b32 0
  %23 = v_sub_nc_u32 %22, %amount
  %left = v_alignbit_b32 %input, %input, %23
  %right = v_alignbit_b32 %input, %input, %amount
  %26 = v_clz_i32_u32 %input
  %27 = v_mov_b32 32
  %leading = v_min_u32 %26, %27
  %29 = v_ctz_i32_b32 %input
  %trailing = v_min_u32 %29, %27
  %population = v_bcnt_u32_b32_src1_zero %input
  return %left, %right, %leading, %trailing, %population
}

