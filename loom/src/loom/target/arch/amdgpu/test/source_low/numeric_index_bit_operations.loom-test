  %leading = s_min_u32 %41, %31
  %44 = s_ctz_i32_b32 %input
  %trailing = s_min_u32 %44, %31
  %population = s_bcnt1_i32_b32 %input
  %48 = s_ashr_i32_rhs_inline %left, 31
  %51 = v_mov_b32_copy %left
  %53 = v_mov_b32_copy %48
  %54 = concat(%51, %53) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %55 = v_lshlrev_b32_src0_inline %fixture_lane, 3
  global_store_b64_saddr %55, %54, %result_view_0
  %56 = s_ashr_i32_rhs_inline %right, 31
  %59 = v_mov_b32_copy %right
  %61 = v_mov_b32_copy %56
  %62 = concat(%59, %61) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %55, %62, %result_view_0 {offset = 512}
  %64 = s_mov_b32 0
  %67 = v_mov_b32_copy %leading
  %69 = v_mov_b32_copy %64
  %70 = concat(%67, %69) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %55, %70, %result_view_0 {offset = 1024}
