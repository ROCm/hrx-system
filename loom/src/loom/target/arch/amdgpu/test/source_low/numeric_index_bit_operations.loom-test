// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @uniform_index_bits(%input: index, %amount: index) -> (index, index, index, index, index) {
  %left = index.rotli %input, %amount : index
  %right = index.rotri %input, %amount : index
  %leading = index.ctlzi %input : index
  %trailing = index.cttzi %input : index
  %population = index.ctpopi %input : index
  func.return %left, %right, %leading, %trailing, %population : index, index, index, index, index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_index_bits(%input: reg<amdgpu.sgpr>, %amount: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %19 = s_mov_b32 32
  %20 = s_sub_u32 %19, %amount
  %21 = s_lshl_b32 %input, %amount
  %22 = s_lshr_b32 %input, %20
  %left = s_or_b32 %21, %22
  %26 = s_lshr_b32 %input, %amount
  %27 = s_lshl_b32 %input, %20
  %right = s_or_b32 %26, %27
  %29 = s_clz_i32_u32 %input
  %leading = s_min_u32 %29, %19
  %32 = s_ctz_i32_b32 %input
  %trailing = s_min_u32 %32, %19
  %population = s_bcnt1_i32_b32 %input
  return %left, %right, %leading, %trailing, %population
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @varying_index_bits(%inputs: vector<2xi32>, %amount: index) -> (index, index, index, index, index) {
  %word = vector.extract %inputs[0] : vector<2xi32> -> i32
  %input = index.cast %word : i32 to index
  %left = index.rotli %input, %amount : index
  %right = index.rotri %input, %amount : index
  %leading = index.ctlzi %input : index
  %trailing = index.cttzi %input : index
  %population = index.ctpopi %input : index
  func.return %left, %right, %leading, %trailing, %population : index, index, index, index, index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @varying_index_bits(%inputs: reg<amdgpu.vgpr x2>, %amount: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %input = slice %inputs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %22 = v_mov_b32 0
  %23 = v_mov_b32_copy %amount
  %24 = v_sub_nc_u32 %22, %23
  %left = v_alignbit_b32 %input, %input, %24
  %right = v_alignbit_b32 %input, %input, %23
  %28 = v_clz_i32_u32 %input
  %29 = v_mov_b32 32
  %leading = v_min_u32 %28, %29
  %31 = v_ctz_i32_b32 %input
  %trailing = v_min_u32 %31, %29
  %population = v_bcnt_u32_b32_src1_zero %input
  return %left, %right, %leading, %trailing, %population
}

// ====

amdgpu.target<gfx942> @target

func.def target(@target) @cdna_index_counts(%input: index, %inputs: vector<2xi32>) -> (index, index, index, index) {
  %word = vector.extract %inputs[0] : vector<2xi32> -> i32
  %varying = index.cast %word : i32 to index
  %leading = index.ctlzi %input : index
  %trailing = index.cttzi %input : index
  %varying_leading = index.ctlzi %varying : index
  %varying_trailing = index.cttzi %varying : index
  func.return %leading, %trailing, %varying_leading, %varying_trailing : index, index, index, index
}

// ----
low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @cdna_index_counts(%input: reg<amdgpu.sgpr>, %inputs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %varying = slice %inputs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = s_flbit_i32_b32 %input
  %20 = s_mov_b32 32
  %leading = s_min_u32 %19, %20
  %22 = s_ff1_i32_b32 %input
  %trailing = s_min_u32 %22, %20
  %25 = v_ffbh_u32 %varying
  %26 = v_mov_b32 32
  %varying_leading = v_min_u32 %25, %26
  %28 = v_ffbl_b32 %varying
  %varying_trailing = v_min_u32 %28, %26
  return %leading, %trailing, %varying_leading, %varying_trailing
}
