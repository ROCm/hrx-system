amdgpu.target<gfx11-generic> @target

kernel.def target(@target) @uniform_index_bits() {
  %launch_unit = index.constant 1 : index
  %launch_width = index.constant 64 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_width, %launch_unit, %launch_unit) : index
} launch(%input: index, %amount: index, %result_buffer_0: buffer, %result_buffer_1: buffer, %result_buffer_2: buffer, %result_buffer_3: buffer, %result_buffer_4: buffer) {
  %fixture_base = index.constant 0 : offset
  %fixture_lane = kernel.workitem.id<x> : index
  %result_view_0 = buffer.view %result_buffer_0[%fixture_base] : buffer -> view<64xi64>
  %result_view_1 = buffer.view %result_buffer_1[%fixture_base] : buffer -> view<64xi64>
  %result_view_2 = buffer.view %result_buffer_2[%fixture_base] : buffer -> view<64xi64>
  %result_view_3 = buffer.view %result_buffer_3[%fixture_base] : buffer -> view<64xi64>
  %result_view_4 = buffer.view %result_buffer_4[%fixture_base] : buffer -> view<64xi64>
  %left = index.rotli %input, %amount : index
  %right = index.rotri %input, %amount : index
  %leading = index.ctlzi %input : index
  %trailing = index.cttzi %input : index
  %population = index.ctpopi %input : index
  %result_storage_0 = index.cast %left : index to i64
  view.store %result_storage_0, %result_view_0[%fixture_lane] : i64, view<64xi64>
  %result_storage_1 = index.cast %right : index to i64
  view.store %result_storage_1, %result_view_1[%fixture_lane] : i64, view<64xi64>
  %result_storage_2 = index.cast %leading : index to i64
  view.store %result_storage_2, %result_view_2[%fixture_lane] : i64, view<64xi64>
  %result_storage_3 = index.cast %trailing : index to i64
  view.store %result_storage_3, %result_view_3[%fixture_lane] : i64, view<64xi64>
  %result_storage_4 = index.cast %population : index to i64
  view.store %result_storage_4, %result_view_4[%fixture_lane] : i64, view<64xi64>
  kernel.return
}

