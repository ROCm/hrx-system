low.func.def target<amdgpu.cdna3.core>(@target) abi(hal_kernel) @cdna_index_counts(%input: reg<amdgpu.vgpr>, %inputs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %varying = slice %inputs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = v_ffbh_u32 %input
  %20 = v_mov_b32 32
  %leading = v_min_u32 %19, %20
  %22 = v_ffbl_b32 %input
  %trailing = v_min_u32 %22, %20
