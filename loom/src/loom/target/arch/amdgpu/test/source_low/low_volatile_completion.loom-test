// ====
// RUN: emit amdgpu-assembly @global_publication_gfx1200 strategy=source

// Publication stays outstanding across the local barrier. The LDS write
// completes before synchronization, and the global store completes at exit.
amdgpu.target<gfx1200> @target

low.func.def target<amdgpu.rdna4.core>(@target) @global_publication_gfx1200(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %base: reg<amdgpu.sgpr x2>) asm {
  global_store_b64_saddr<volatile> %address, %value, %base
  low.br ^exchange
^exchange:
  ds_write_b64 %address, %value
  s_barrier_signal_all
  s_barrier_wait_all
  return
}

