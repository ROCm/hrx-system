low.func.def target<amdgpu.rdna3_5.core>(@target) @generic_publication(%pointer: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) asm {
  flat_store_b32<volatile> %pointer, %value
  low.br ^exchange
^exchange:
  s_barrier
  return
}

// ----
  flat_store_b32 v[0:1], v2 offset:0
.Lbb1:
  s_waitcnt_vscnt vscnt(0)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_barrier
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @private_publication strategy=source

