// RUN: emit amdgpu-assembly @global_publication_gfx942 strategy=source

// Publication stays outstanding across the local barrier. The LDS write
// completes before synchronization, and the global store completes at exit.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @global_publication_gfx942(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %base: reg<amdgpu.sgpr x2>) asm {
  global_store_dwordx2_saddr<volatile> %address, %value, %base
  low.br ^exchange
^exchange:
  ds_write_b64 %address, %value
  s_barrier
  return
}

// ----
  global_store_dwordx2 v0, v[2:3], s[0:1] offset:0
.Lbb1:
  ds_write_b64 v0, v[2:3] offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_barrier
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @global_observation_gfx942 strategy=source

// A local barrier does not consume a global observation. Its result still
// completes before the later use, including when carried across a block.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @global_observation_gfx942(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %observed = global_load_dwordx2_saddr<volatile> %address, %base : reg<amdgpu.vgpr x2>
  low.br ^exchange
^exchange:
  s_barrier
  return %observed
}

// ----
  global_load_dwordx2 v[0:1], v0, s[0:1] offset:0
.Lbb1:
  s_barrier
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

