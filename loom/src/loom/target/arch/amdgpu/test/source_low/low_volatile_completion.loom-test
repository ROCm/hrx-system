low.func.def target<amdgpu.rdna3_5.core>(@target) @workgroup_publication(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  ds_write_b32<volatile> %address, %value
  low.br ^exchange
^exchange:
  s_barrier
  return
}

// ----
  ds_write_b32 v0, v1 offset:0
.Lbb1:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_barrier
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @generic_publication strategy=source

