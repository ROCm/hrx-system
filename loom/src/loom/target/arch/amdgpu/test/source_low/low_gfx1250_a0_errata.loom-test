low.func.def target<amdgpu.rdna4.gfx125x.core>(@b0) @b0_accepts_native_packets(%address: reg<amdgpu.vgpr>, %data0: reg<amdgpu.vgpr>, %data1: reg<amdgpu.vgpr>, %m0: reg<amdgpu.m0>, %lhs: reg<amdgpu.vgpr x16>, %rhs: reg<amdgpu.vgpr x16>, %acc: reg<amdgpu.vgpr x4>) asm {
  %pair = ds_read2_b32 %address {offset1 = 1}
  ds_write2_b32 %address, %data0, %data1 {offset1 = 1}
  %value = ds_read_addtid_b32 %m0
  ds_write_addtid_b32 %value, %m0
  %matrix = v_wmma_f16_16x16x128_bf8_bf8 %lhs, %rhs, %acc
  return
}
