// RUN: verify

amdgpu.target<gfx1250> @a0 {gfx1250_revision = a0}
amdgpu.target<gfx1250> @b0 {gfx1250_revision = b0}

low.func.def target(@a0) @a0_ds_errata(%address: reg<amdgpu.vgpr>, %data0: reg<amdgpu.vgpr>, %data1: reg<amdgpu.vgpr>, %m0: reg<amdgpu.m0>) asm<amdgpu.rdna4.gfx125x.core> {
  // ERROR@+1: AMDGPU/047 {function_name="a0_ds_errata", descriptor_name="amdgpu.ds_read2_b32", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.ds2_alignment", legalization_key="split_ds2_to_single_address"}
  %pair = ds_read2_b32 %address {offset0 = 0, offset1 = 1}
  // ERROR@+1: AMDGPU/047 {function_name="a0_ds_errata", descriptor_name="amdgpu.ds_write2_b32", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.ds2_alignment", legalization_key="split_ds2_to_single_address"}
  ds_write2_b32 %address, %data0, %data1 {offset0 = 0, offset1 = 1}
  // ERROR@+1: AMDGPU/047 {function_name="a0_ds_errata", descriptor_name="amdgpu.ds_read_addtid_b32", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.ds_addtid_address", legalization_key="materialize_addtid_address"}
  %value = ds_read_addtid_b32 %m0
  // ERROR@+1: AMDGPU/047 {function_name="a0_ds_errata", descriptor_name="amdgpu.ds_write_addtid_b32", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.ds_addtid_address", legalization_key="materialize_addtid_address"}
  ds_write_addtid_b32 %value, %m0
  return
}

low.func.def target(@a0) @a0_multicast_errata(%lds: reg<amdgpu.vgpr>, %global_address: reg<amdgpu.vgpr>, %saddr: reg<amdgpu.sgpr x2>, %m0: reg<amdgpu.m0>, %d0: reg<amdgpu.sgpr x4>, %d1: reg<amdgpu.sgpr x8>) asm<amdgpu.rdna4.gfx125x.core> {
  // ERROR@+1: AMDGPU/047 {function_name="a0_multicast_errata", descriptor_name="amdgpu.cluster_load_async_to_lds_b128", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.cluster_multicast", legalization_key="clear_and_restore_cluster_mask"}
  cluster_load_async_to_lds_b128 %lds, %global_address, %saddr, %m0
  // ERROR@+1: AMDGPU/047 {function_name="a0_multicast_errata", descriptor_name="amdgpu.tensor_load_to_lds.d2", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.tensor_multicast", legalization_key="clear_and_restore_tensor_multicast_mask"}
  tensor_load_to_lds_d2 %d0, %d1
  return
}

low.func.def target(@a0) @a0_matrix_errata(%wide_lhs: reg<amdgpu.vgpr x16>, %wide_rhs: reg<amdgpu.vgpr x16>, %half_rhs: reg<amdgpu.vgpr x8>, %acc4: reg<amdgpu.vgpr x4>, %scaled_acc: reg<amdgpu.vgpr x8>, %integer_acc: reg<amdgpu.vgpr x8>, %integer_wmma_acc: reg<amdgpu.vgpr x8>, %wide_acc: reg<amdgpu.vgpr x16>, %scale_a: reg<amdgpu.vgpr>, %scale_b: reg<amdgpu.vgpr>, %sparse_lhs: reg<amdgpu.vgpr x8>, %metadata: reg<amdgpu.vgpr x2>, %integer_lhs: reg<amdgpu.vgpr x8>, %integer_rhs: reg<amdgpu.vgpr x8>) asm<amdgpu.rdna4.gfx125x.core> {
  // ERROR@+1: AMDGPU/047 {function_name="a0_matrix_errata", descriptor_name="amdgpu.v_wmma_f16_16x16x128_bf8_bf8", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.wmma_k128_fp8_bf8", legalization_key="split_wmma_k128_to_regular_scale_k64"}
  %k128 = v_wmma_f16_16x16x128_bf8_bf8 %wide_lhs, %wide_rhs, %acc4
  // ERROR@+1: AMDGPU/047 {function_name="a0_matrix_errata", descriptor_name="amdgpu.v_wmma_scale_f32_16x16x128_f8f6f4_f8_f8", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.wmma_scale_encoding", legalization_key="legalize_scaled_wmma"}
  %scaled = v_wmma_scale_f32_16x16x128_f8f6f4_f8_f8 %wide_lhs, %wide_rhs, %scaled_acc, %scale_a, %scale_b {matrix_a_fmt = 1, matrix_b_fmt = 1, matrix_a_scale = 0, matrix_b_scale = 0, matrix_a_scale_fmt = 2, matrix_b_scale_fmt = 2, matrix_a_reuse = 0, matrix_b_reuse = 0}
  // ERROR@+1: AMDGPU/047 {function_name="a0_matrix_errata", descriptor_name="amdgpu.v_wmma_f32_32x16x128_f4", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.wmma_32x16_f4", legalization_key="split_wmma_32x16_to_16x16"}
  %wide = v_wmma_f32_32x16x128_f4 %wide_lhs, %half_rhs, %wide_acc
  // ERROR@+1: AMDGPU/047 {function_name="a0_matrix_errata", descriptor_name="amdgpu.v_swmmac_i32_16x16x128_iu8", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.integer_matrix_coexecution", legalization_key="enforce_integer_matrix_spacing"}
  %integer = v_swmmac_i32_16x16x128_iu8 %integer_acc, %sparse_lhs, %wide_rhs, %metadata
  // ERROR@+1: AMDGPU/047 {function_name="a0_matrix_errata", descriptor_name="amdgpu.v_wmma_i32_16x16x64_iu8", descriptor_set_name="amdgpu.rdna4.gfx125x.core", revision="a0", erratum_key="gfx1250.a0.integer_matrix_coexecution", legalization_key="enforce_integer_matrix_spacing"}
  %integer_wmma = v_wmma_i32_16x16x64_iu8 %integer_lhs, %integer_rhs, %integer_wmma_acc
  return
}

low.func.def target(@a0) @a0_safe_packets(%input: reg<amdgpu.vgpr>, %lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>) asm<amdgpu.rdna4.gfx125x.core> {
  %converted = v_cvt_f32_fp8 %input
  %matrix = v_wmma_f32_16x16x64_fp8_fp8 %lhs, %rhs, %acc
  return
}

low.func.def target(@b0) @b0_accepts_native_packets(%address: reg<amdgpu.vgpr>, %data0: reg<amdgpu.vgpr>, %data1: reg<amdgpu.vgpr>, %m0: reg<amdgpu.m0>, %lhs: reg<amdgpu.vgpr x16>, %rhs: reg<amdgpu.vgpr x16>, %acc: reg<amdgpu.vgpr x4>) asm<amdgpu.rdna4.gfx125x.core> {
  %pair = ds_read2_b32 %address {offset0 = 0, offset1 = 1}
  ds_write2_b32 %address, %data0, %data1 {offset0 = 0, offset1 = 1}
  %value = ds_read_addtid_b32 %m0
  ds_write_addtid_b32 %value, %m0
  %matrix = v_wmma_f16_16x16x128_bf8_bf8 %lhs, %rhs, %acc
  return
}
