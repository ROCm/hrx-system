  %209 = v_lshlrev_b32_src0_inline %208, 5
  %210 = v_add_u32 %206, %209
  %211 = v_and_b32_src0_inline %210, 31
  %212 = v_mov_b32 0
  %lane = concat(%211, %212) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %row_y = v_lshl_add_u32_shift_imm %173, %166, 4
  %row = v_lshl_add_u32_shift_imm %180, %row_y, 7
  %219 = v_mov_b32 7
