  %260 = s_mov_b32 21
  low.br ^loop(%iterations: reg<amdgpu.sgpr>, %local_x: reg<amdgpu.vgpr x2>, %local_y: reg<amdgpu.vgpr x2>, %local_z: reg<amdgpu.vgpr x2>, %133: reg<amdgpu.sgpr>, %137: reg<amdgpu.sgpr>, %134: reg<amdgpu.sgpr>, %135: reg<amdgpu.sgpr>, %157: reg<amdgpu.sgpr>, %iterations: reg<amdgpu.sgpr>, %global_x: reg<amdgpu.vgpr x2>, %global_y: reg<amdgpu.vgpr x2>, %global_z: reg<amdgpu.vgpr x2>, %183: reg<amdgpu.sgpr>, %186: reg<amdgpu.sgpr>, %subgroup_id: reg<amdgpu.vgpr x2>, %lane: reg<amdgpu.vgpr x2>)
^loop(%slot: reg<amdgpu.sgpr>, %bits_local_x: reg<amdgpu.vgpr x2>, %bits_local_y: reg<amdgpu.vgpr x2>, %bits_local_z: reg<amdgpu.vgpr x2>, %360: reg<amdgpu.sgpr>, %361: reg<amdgpu.sgpr>, %362: reg<amdgpu.sgpr>, %364: reg<amdgpu.sgpr>, %366: reg<amdgpu.sgpr>, %368: reg<amdgpu.sgpr>, %bits_global_x: reg<amdgpu.vgpr x2>, %bits_global_y: reg<amdgpu.vgpr x2>, %bits_global_z: reg<amdgpu.vgpr x2>, %370: reg<amdgpu.sgpr>, %372: reg<amdgpu.sgpr>, %bits_subgroup_id: reg<amdgpu.vgpr x2>, %bits_lane: reg<amdgpu.vgpr x2>):
