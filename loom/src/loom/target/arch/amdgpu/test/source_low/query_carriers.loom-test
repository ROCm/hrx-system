  %133 = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %134 = live_in<amdgpu.workgroup_id.y> : reg<amdgpu.sgpr>
  %135 = live_in<amdgpu.workgroup_id.z> : reg<amdgpu.sgpr>
