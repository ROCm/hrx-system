  %252 = s_mov_b32 18
  %255 = s_mov_b32 19
  %258 = s_mov_b32 20
  %261 = v_mov_b32 21
  %wide_lane = concat(%261, %220) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^loop(%iterations: reg<amdgpu.sgpr>, %local_x: reg<amdgpu.vgpr x2>, %local_y: reg<amdgpu.vgpr x2>, %local_z: reg<amdgpu.vgpr x2>, %133: reg<amdgpu.sgpr>, %137: reg<amdgpu.sgpr>, %134: reg<amdgpu.sgpr>, %135: reg<amdgpu.sgpr>, %157: reg<amdgpu.sgpr>, %iterations: reg<amdgpu.sgpr>, %global_x: reg<amdgpu.vgpr x2>, %global_y: reg<amdgpu.vgpr x2>, %global_z: reg<amdgpu.vgpr x2>, %183: reg<amdgpu.sgpr>, %186: reg<amdgpu.sgpr>, %199: reg<amdgpu.sgpr>, %200: reg<amdgpu.sgpr>, %lane: reg<amdgpu.vgpr x2>)
^loop(%slot: reg<amdgpu.sgpr>, %bits_local_x: reg<amdgpu.vgpr x2>, %bits_local_y: reg<amdgpu.vgpr x2>, %bits_local_z: reg<amdgpu.vgpr x2>, %326: reg<amdgpu.sgpr>, %327: reg<amdgpu.sgpr>, %328: reg<amdgpu.sgpr>, %330: reg<amdgpu.sgpr>, %332: reg<amdgpu.sgpr>, %334: reg<amdgpu.sgpr>, %bits_global_x: reg<amdgpu.vgpr x2>, %bits_global_y: reg<amdgpu.vgpr x2>, %bits_global_z: reg<amdgpu.vgpr x2>, %336: reg<amdgpu.sgpr>, %338: reg<amdgpu.sgpr>, %340: reg<amdgpu.sgpr>, %341: reg<amdgpu.sgpr>, %bits_lane: reg<amdgpu.vgpr x2>):
