// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Hardware coordinates seed loops whose later iterations carry values above
// 32 bits. Hardware imports and arithmetic remain one word; the loop entries
// receive the zero-extended values selected by representation planning.
kernel.def @wide_query_loops() {
  %groups = index.constant 2 : index
  %width = index.constant 8 : index
  %height = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %groups, %groups) workgroup_size(%width, %height, %height) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<1024x3x15xi64>
  %row_width = index.constant 16 : index
  %plane_rows = index.constant 128 : index
  %iterations = scalar.constant 2 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %local_x = kernel.workitem.id<x> : index
  %local_y = kernel.workitem.id<y> : index
  %local_z = kernel.workitem.id<z> : index
  %group_x = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %group_z = kernel.workgroup.id<z> : index
  %group_size = kernel.workgroup.size<x> : index
  %group_count = kernel.workgroup.count<x> : index
  %global_x = kernel.workitem.dispatch.id<x> : index
  %global_y = kernel.workitem.dispatch.id<y> : index
  %global_z = kernel.workitem.dispatch.id<z> : index
  %subgroup_size = kernel.subgroup.size : index
  %subgroup_count = kernel.subgroup.count : index
  %subgroup_id = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %row_y = index.madd %global_y, %row_width, %global_x : index
  %row = index.madd %global_z, %plane_rows, %row_y : index
  // Distinct backedge values keep the query carrier components independent.
  %wide_local_x = index.constant 4294967303 : index
  %wide_local_y = index.constant 4294967304 : index
  %wide_local_z = index.constant 4294967305 : index
  %wide_group_x = index.constant 4294967306 : index
  %wide_group_y = index.constant 4294967307 : index
  %wide_group_z = index.constant 4294967308 : index
  %wide_group_size = index.constant 4294967309 : index
  %wide_group_count = index.constant 4294967310 : index
  %wide_global_x = index.constant 4294967311 : index
  %wide_global_y = index.constant 4294967312 : index
  %wide_global_z = index.constant 4294967313 : index
  %wide_subgroup_size = index.constant 4294967314 : index
  %wide_subgroup_count = index.constant 4294967315 : index
  %wide_subgroup_id = index.constant 4294967316 : index
  %wide_lane = index.constant 4294967317 : index
  cfg.br ^loop(%iterations: i32, %local_x: index, %local_y: index, %local_z: index, %group_x: index, %group_y: index, %group_z: index, %group_size: index, %group_count: index, %global_x: index, %global_y: index, %global_z: index, %subgroup_size: index, %subgroup_count: index, %subgroup_id: index, %lane: index)
^loop(%remaining: i32, %value_local_x: index, %value_local_y: index, %value_local_z: index, %value_group_x: index, %value_group_y: index, %value_group_z: index, %value_group_size: index, %value_group_count: index, %value_global_x: index, %value_global_y: index, %value_global_z: index, %value_subgroup_size: index, %value_subgroup_count: index, %value_subgroup_id: index, %value_lane: index):
  %slot_value = index.cast %remaining : i32 to index
  %slot = index.assume %slot_value [range(%slot_value, 0, 2)] : index
  %bits_local_x = index.cast %value_local_x : index to i64
  view.store %bits_local_x, %view[%row, %slot, 0] : i64, view<1024x3x15xi64>
  %bits_local_y = index.cast %value_local_y : index to i64
  view.store %bits_local_y, %view[%row, %slot, 1] : i64, view<1024x3x15xi64>
  %bits_local_z = index.cast %value_local_z : index to i64
  view.store %bits_local_z, %view[%row, %slot, 2] : i64, view<1024x3x15xi64>
  %bits_group_x = index.cast %value_group_x : index to i64
  view.store %bits_group_x, %view[%row, %slot, 3] : i64, view<1024x3x15xi64>
  %bits_group_y = index.cast %value_group_y : index to i64
  view.store %bits_group_y, %view[%row, %slot, 4] : i64, view<1024x3x15xi64>
  %bits_group_z = index.cast %value_group_z : index to i64
  view.store %bits_group_z, %view[%row, %slot, 5] : i64, view<1024x3x15xi64>
  %bits_group_size = index.cast %value_group_size : index to i64
  view.store %bits_group_size, %view[%row, %slot, 6] : i64, view<1024x3x15xi64>
  %bits_group_count = index.cast %value_group_count : index to i64
  view.store %bits_group_count, %view[%row, %slot, 7] : i64, view<1024x3x15xi64>
  %bits_global_x = index.cast %value_global_x : index to i64
  view.store %bits_global_x, %view[%row, %slot, 8] : i64, view<1024x3x15xi64>
  %bits_global_y = index.cast %value_global_y : index to i64
  view.store %bits_global_y, %view[%row, %slot, 9] : i64, view<1024x3x15xi64>
  %bits_global_z = index.cast %value_global_z : index to i64
  view.store %bits_global_z, %view[%row, %slot, 10] : i64, view<1024x3x15xi64>
  %bits_subgroup_size = index.cast %value_subgroup_size : index to i64
  view.store %bits_subgroup_size, %view[%row, %slot, 11] : i64, view<1024x3x15xi64>
  %bits_subgroup_count = index.cast %value_subgroup_count : index to i64
  view.store %bits_subgroup_count, %view[%row, %slot, 12] : i64, view<1024x3x15xi64>
  %bits_subgroup_id = index.cast %value_subgroup_id : index to i64
  view.store %bits_subgroup_id, %view[%row, %slot, 13] : i64, view<1024x3x15xi64>
  %bits_lane = index.cast %value_lane : index to i64
  view.store %bits_lane, %view[%row, %slot, 14] : i64, view<1024x3x15xi64>
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = scalar.subi %remaining, %c1 : i32
  cfg.br ^loop(%next: i32, %wide_local_x: index, %wide_local_y: index, %wide_local_z: index, %wide_group_x: index, %wide_group_y: index, %wide_group_z: index, %wide_group_size: index, %wide_group_count: index, %wide_global_x: index, %wide_global_y: index, %wide_global_z: index, %wide_subgroup_size: index, %wide_subgroup_count: index, %wide_subgroup_id: index, %wide_lane: index)
^exit:
  kernel.return
}

