// ====

// RUN: emit source-low target=amdgpu:gfx11-generic output=low

// Dynamic dispatch fields are loaded in their native widths even when a
// connected control-flow component requires a wider published carrier.
kernel.def @wide_dispatch_counts(%groups_x: index, %groups_y: index, %groups_z: index) {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups_x, %groups_y, %groups_z) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %group_x = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %group_z = kernel.workgroup.id<z> : index
  %lane = kernel.workitem.id<x> : index
  %c0_index = index.constant 0 : index
  %first_x = index.cmp eq, %group_x, %c0_index : index
  %first_y = index.cmp eq, %group_y, %c0_index : index
  %first_z = index.cmp eq, %group_z, %c0_index : index
  %first_lane = index.cmp eq, %lane, %c0_index : index
  %first_xy = scalar.andi %first_x, %first_y : i1
  %first_xyz = scalar.andi %first_xy, %first_z : i1
  %leader = scalar.andi %first_xyz, %first_lane : i1
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %iterations = scalar.constant 2 : i32
  %count_x = kernel.workgroup.count<x> : index
  %count_y = kernel.workgroup.count<y> : index
  %count_z = kernel.workgroup.count<z> : index
  %plane = index.madd %group_z, %count_y, %group_y : index
  %masked_count = index.andi %count_y, %lane : index
  %mixed_count = index.ori %masked_count, %count_z : index
  %counts_differ = index.cmp ne, %count_y, %count_z : index
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<3x4xi64>
  cfg.cond_br %counts_differ, ^select, ^exit
^select:
  cfg.cond_br %leader, ^enter, ^exit
^enter:
  %wide_count_x = index.constant 4294967303 : index
  %wide_count_y = index.constant 4294967304 : index
  %wide_count_z = index.constant 4294967305 : index
  cfg.br ^loop(%iterations: i32, %count_x: index, %count_y: index, %count_z: index)
^loop(%remaining: i32, %value_count_x: index, %value_count_y: index, %value_count_z: index):
  %slot_value = index.cast %remaining : i32 to index
  %slot = index.assume %slot_value [range(%slot_value, 0, 2)] : index
  %bits_plane = index.cast %plane : index to i64
  view.store %bits_plane, %view[%slot, 0] : i64, view<3x4xi64>
  %bits_mixed_count = index.cast %mixed_count : index to i64
  view.store %bits_mixed_count, %view[%slot, 1] : i64, view<3x4xi64>
  %bits_count_y = index.cast %value_count_y : index to i64
  view.store %bits_count_y, %view[%slot, 2] : i64, view<3x4xi64>
  %bits_count_z = index.cast %value_count_z : index to i64
  view.store %bits_count_z, %view[%slot, 3] : i64, view<3x4xi64>
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = scalar.subi %remaining, %c1 : i32
  cfg.br ^loop(%next: i32, %wide_count_x: index, %wide_count_y: index, %wide_count_z: index)
^exit:
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) @wide_dispatch_counts() asm {
  %group_x = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %group_y = live_in<amdgpu.workgroup_id.y> : reg<amdgpu.sgpr>
  %group_z = live_in<amdgpu.workgroup_id.z> : reg<amdgpu.sgpr>
  %61 = live_in<amdgpu.dispatch_ptr> : reg<amdgpu.sgpr x2>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %view = resource<hal_binding> {extent = 96, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %64 = s_load_dword_offset_only %61 {offset = 16}
  %65 = s_load_dword_offset_only %61 {offset = 20}
  %66 = v_mov_b32_copy %64
  %67 = v_mov_b32 0
  %count_y = concat(%66, %67) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %69 = v_mov_b32_copy %65
  %count_z = concat(%69, %67) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %c0_index = s_mov_b32 0
  %first_x = s_cmp_eq_i32 %group_x, %c0_index
  %first_y = s_cmp_eq_i32 %group_y, %c0_index
  %first_z = s_cmp_eq_i32 %group_z, %c0_index
  %first_lane = v_cmp_eq_i32_src1_inline %lane {rhs = 0}
  %78 = s_mov_b32 1
  %79 = s_cselect_b32 %78, %c0_index, %first_x
