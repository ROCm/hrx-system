  %197 = v_add_u32 %193, %196
  %198 = v_lshrrev_b32_src0_inline %197, 5
  %subgroup_id = concat(%198, %147) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %210 = v_and_b32_src0_inline %197, 31
  %lane = concat(%210, %147) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %row_y = v_lshl_add_u32_shift_imm %173, %166, 4
  %row = v_lshl_add_u32_shift_imm %180, %row_y, 7
  %218 = s_mov_b32 7
