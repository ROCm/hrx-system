  %228 = s_mov_b32 10
  %229 = s_mov_b32 1
  %231 = s_mov_b32 11
  %234 = s_mov_b32 12
  %237 = s_mov_b32 13
  %240 = s_mov_b32 14
  %243 = v_mov_b32 15
