  %281 = concat(%278, %274) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %268, %281, %view {offset = 32}
  %284 = v_mov_b32_copy %330
  %287 = concat(%284, %274) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %268, %287, %view {offset = 40}
  %290 = v_mov_b32_copy %332
  %293 = concat(%290, %274) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %268, %293, %view {offset = 48}
  %296 = v_mov_b32_copy %334
  %299 = concat(%296, %274) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr %268, %299, %view {offset = 56}
  global_store_b64_saddr %268, %bits_global_x, %view {offset = 64}
