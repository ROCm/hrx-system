  %38 = low.op<amdgpu.ds_read_b32>(%29) {offset = 0} memory_access([0, 3, 8, -1, 11, 0, 0, 0, 3, 0, 0, 4, 4]) : (reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr>
