  %53 = low.op<amdgpu.ds_read_b64>(%29) {offset = 16} memory_access([0, 3, 8, -1, 11, 0, 0, 0, 3, 16, 16, 24, 24]) : (reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.op<amdgpu.ds_write_b64>(%29, %51) {offset = 0} memory_access([0, 3, 8, -1, 11, 0, 0, 0, 3, 0, 0, 8, 8]) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>)
  low.op<amdgpu.ds_write_b64>(%29, %53) {offset = 16} memory_access([0, 3, 8, -1, 11, 0, 0, 0, 3, 16, 16, 24, 24]) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>)
