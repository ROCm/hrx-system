// RUN: emit source-low output=low

amdgpu.target<gfx1250-a0> @target

kernel.def target(@target) @a0_legalizes_constrained_lds_packets() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 4096 : offset
  %regular_b32_layout = encoding.layout.strided [8, 2] : encoding<layout>
  %regular_b64_layout = encoding.layout.strided [4, 2] : encoding<layout>
  %stride64_layout = encoding.layout.strided [512, 256] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %regular_b32 = buffer.view %scratch[%scratch_base] : buffer -> view<1x2xi32, %regular_b32_layout>
  %regular_b64 = buffer.view %scratch[%scratch_base] : buffer -> view<1x2xi64, %regular_b64_layout>
  %stride64_b32 = buffer.view %scratch[%scratch_base] : buffer -> view<1x2xi32, %stride64_layout>
  %stride64_b64 = buffer.view %scratch[%scratch_base] : buffer -> view<1x2xi64, %stride64_layout>
  %dense = buffer.view %scratch[%scratch_base] : buffer -> view<4096xi8>
  %pair_b32 = vector.constant 1 : vector<2xi32>
  %pair_b64 = vector.constant 1 : vector<2xi64>
  vector.store %pair_b32, %regular_b32[0, 0] : vector<2xi32>, view<1x2xi32, %regular_b32_layout>
  %loaded_regular_b32 = vector.load %regular_b32[0, 0] : view<1x2xi32, %regular_b32_layout> -> vector<2xi32>
  vector.store %loaded_regular_b32, %regular_b32[0, 0] : vector<2xi32>, view<1x2xi32, %regular_b32_layout>
  vector.store %pair_b64, %regular_b64[0, 0] : vector<2xi64>, view<1x2xi64, %regular_b64_layout>
  %loaded_regular_b64 = vector.load %regular_b64[0, 0] : view<1x2xi64, %regular_b64_layout> -> vector<2xi64>
  vector.store %loaded_regular_b64, %regular_b64[0, 0] : vector<2xi64>, view<1x2xi64, %regular_b64_layout>
  vector.store %pair_b32, %stride64_b32[0, 0] : vector<2xi32>, view<1x2xi32, %stride64_layout>
  %loaded_stride64_b32 = vector.load %stride64_b32[0, 0] : view<1x2xi32, %stride64_layout> -> vector<2xi32>
  vector.store %loaded_stride64_b32, %stride64_b32[0, 0] : vector<2xi32>, view<1x2xi32, %stride64_layout>
  vector.store %pair_b64, %stride64_b64[0, 0] : vector<2xi64>, view<1x2xi64, %stride64_layout>
  %loaded_stride64_b64 = vector.load %stride64_b64[0, 0] : view<1x2xi64, %stride64_layout> -> vector<2xi64>
  vector.store %loaded_stride64_b64, %stride64_b64[0, 0] : vector<2xi64>, view<1x2xi64, %stride64_layout>
  %word = vector.constant 1 : vector<4xi8>
  vector.store %word, %dense[%lane] : vector<4xi8>, view<4096xi8>
  %loaded_word = vector.load %dense[%lane] : view<4096xi8> -> vector<4xi8>
  vector.store %loaded_word, %dense[%lane] : vector<4xi8>, view<4096xi8>
  kernel.return
}

