low.kernel.def target<amdgpu.cdna4.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_divergent_lane_mask_select_i64_wave64() asm {
  %lane_i32 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
