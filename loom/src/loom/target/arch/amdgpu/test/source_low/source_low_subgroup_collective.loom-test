  %active = s_mov_b64_exec_read
  %19 = s_mov_b32 0
  %22 = slice %active[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = v_mov_b32_copy %22
  %25 = v_mov_b32_copy %19
  %26 = v_cndmask_b32 %25, %23, %predicate
  %27 = slice %active[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %28 = v_mov_b32_copy %27
  %31 = v_cndmask_b32 %25, %28, %predicate
  %result = concat(%26, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %33 = v_lshlrev_b32_src0_inline %lane_i32, 3
  %34 = s_mov_b32_m0_imm 0
