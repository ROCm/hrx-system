// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_address_realizations.loom-test
// RUN: emit source-low target=amdgpu:gfx12-generic output=low

kernel.def @address_guarded_rows() {
  %unit = index.constant 1 : index
  %groups = index.constant 4 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %row_limit: index) {
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %rows_per_group = index.constant 2 : index
  %half_wave = index.constant 32 : index
  %row_in_group = index.div %lane, %half_wave : index
  %column = index.rem %lane, %half_wave : index
  %row = index.madd %group, %rows_per_group, %row_in_group : index
  %next_column = index.add %column, %half_wave : index
  %c0_offset = index.constant 0 : offset
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<[%row_limit]x64xi32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%row_limit]x64xi32>
  %inside = index.cmp ult, %row, %row_limit : index
  scf.if %inside {
    %first = view.load %input_view[%row, %column] : view<[%row_limit]x64xi32> -> i32
    %second = view.load %input_view[%row, %next_column] : view<[%row_limit]x64xi32> -> i32
    view.store %first, %output_view[%row, %column] : i32, view<[%row_limit]x64xi32>
    view.store %second, %output_view[%row, %next_column] : i32, view<[%row_limit]x64xi32>
  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx12.generic.core> abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "row_limit"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [8], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(4, 1, 1) @address_guarded_rows(%row_limit: reg<amdgpu.sgpr x2>) asm {
  %group = live_in<amdgpu.cluster_id_x> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %row_in_group = v_lshrrev_b32_src0_inline %lane, 5
  %31 = s_mov_b32 31
  %column = v_and_b32 %31, %lane
  %row = v_lshl_add_u32_shift_imm %group, %row_in_group, 1
  %34 = v_mov_b32 0
  %35 = slice %row_limit[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = v_mov_b32_copy %35
  %37 = slice %row_limit[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = v_mov_b32_copy %37
  %39 = v_cmp_lt_u32 %34, %38
  %40 = v_cmp_lt_u32 %row, %36
  %41 = v_cmp_eq_i32 %34, %38
  %42 = s_and_b64 %41, %40
  %inside = s_or_b64 %39, %42
  %44, %45 = s_and_saveexec_b64 %inside
  low.cond_br %45, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %46 = v_lshl_add_u32_shift_imm %row, %column, 6
  %47 = v_lshlrev_b32_src0_inline %46, 2
  %first = global_load_b32_saddr %47, %input_view
  %second = global_load_b32_saddr %47, %input_view {offset = 128}
  global_store_b32_saddr %47, %first, %output_view
  global_store_b32_saddr %47, %second, %output_view {offset = 128}
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %44
  return
}

