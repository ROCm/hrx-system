  %record = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %21 = v_lshlrev_b32_src0_inline %lane, 2
  %entry = global_load_b32_saddr %21, %record
  %30 = v_lshlrev_b32_src0_inline %entry, 2
  %value = global_load_b32_saddr %30, %record {offset = 64}
  global_store_b32_saddr %21, %value, %destination
  return
}
