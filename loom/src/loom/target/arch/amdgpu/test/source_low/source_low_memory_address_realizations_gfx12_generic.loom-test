  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 1024, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %linear = v_lshl_add_u32_shift_imm %group, %lane, 6
  %24 = v_mov_b32_copy %limit
  %inside = v_cmp_lt_u32 %linear, %24
  %26, %27 = s_and_saveexec_b64 %inside
  low.cond_br %27, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %28 = v_lshlrev_b32_src0_inline %lane, 2
