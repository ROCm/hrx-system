  %30 = concat(%group, %29) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %31 = s_mov_b32 8
  %32 = s_lshl_b64 %30, %31
  %33 = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %35 = slice %32[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %36 = slice %32[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %37, %38 = s_add_co_u32 %33, %35
  %39, %40 = s_addc_u32 %34, %36, %38
  %42 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %43 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46, %47 = s_add_co_u32 %42, %37
  %48, %49 = s_addc_u32 %43, %39, %47
  %50 = concat(%46, %48) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %value = global_load_b32_saddr %28, %50
  %52 = v_lshlrev_b32_src0_inline %linear, 2
  global_store_b32_saddr %52, %value, %output_view
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %26
