low.func.def target<amdgpu.rdna4.core>(@target) abi(hal_kernel) @vector_fptrunc_f32x4_to_bf8(%input: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr>) asm {
  %5 = slice %input[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %6 = slice %input[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %7 = slice %input[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %8 = slice %input[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = v_cvt_pk_bf8_f32_low %5, %6
  %10 = v_cvt_pk_bf8_f32_high %9, %7, %8
  %11 = v_and_b32_lit %10, 2139062143
  %12 = v_add_u32_lit %11, 50529027
  %13 = v_and_b32_lit %12, 2155905152
  %14 = v_lshrrev_b32_src0_inline %13, 7
  %15 = v_or_b32 %11, %14
  %16 = v_perm_b32_src2_lit %5, %6, 775
  %17 = v_bfi_b32_src0_lit %16, %15, 32896
  %18 = v_perm_b32_src2_lit %7, %8, 50790400
  %converted = v_bfi_b32_src0_lit %18, %17, 2155872256
  return %converted
}

