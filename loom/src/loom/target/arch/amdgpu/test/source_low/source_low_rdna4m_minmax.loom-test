amdgpu.target<gfx1170> @target
func.def target(@target) @vector_f32_clamp_semantics(%value: vector<4xf32>, %lower: vector<4xf32>, %upper: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %number = vector.clampf<number, nnan|nsz> %value, %lower, %upper : vector<4xf32>
  %ieee = vector.clampf<ieee> %value, %lower, %upper : vector<4xf32>
