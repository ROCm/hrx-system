// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @scalar_f16_clamp_semantics(%value: reg<amdgpu.vgpr>, %lower: reg<amdgpu.vgpr>, %upper: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %number = v_maxmin_num_f16 %value, %lower, %upper
  %ieee = v_maximumminimum_f16 %value, %lower, %upper
  %14 = v_bfe_u32_offset_0_width_16_low16 %number
  %15 = v_bfe_u32_offset_0_width_16_low16 %ieee
  return %14, %15
}

