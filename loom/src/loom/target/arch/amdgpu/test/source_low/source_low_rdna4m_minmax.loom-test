// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @vector_f32_clamp_semantics(%value: reg<amdgpu.vgpr x4>, %lower: reg<amdgpu.vgpr x4>, %upper: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %12 = slice %value[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %13 = slice %lower[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %14 = slice %upper[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = v_maxmin_num_f32 %12, %13, %14
  %16 = slice %value[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = slice %lower[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = slice %upper[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %19 = v_maxmin_num_f32 %16, %17, %18
  %20 = slice %value[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = slice %lower[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %22 = slice %upper[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %23 = v_maxmin_num_f32 %20, %21, %22
  %24 = slice %value[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %25 = slice %lower[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %26 = slice %upper[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %27 = v_maxmin_num_f32 %24, %25, %26
  %number = concat(%15, %19, %23, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %32 = v_maximumminimum_f32 %12, %13, %14
  %36 = v_maximumminimum_f32 %16, %17, %18
  %40 = v_maximumminimum_f32 %20, %21, %22
  %44 = v_maximumminimum_f32 %24, %25, %26
  %ieee = concat(%32, %36, %40, %44) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %number, %ieee
}

