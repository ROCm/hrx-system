amdgpu.target<gfx1170> @target
func.def target(@target) @scalar_f16_clamp_semantics(%value: f16, %lower: f16, %upper: f16) -> (f16, f16) {
  %number = scalar.clampf<number, nnan|nsz> %value, %lower, %upper : f16
  %ieee = scalar.clampf<ieee> %value, %lower, %upper : f16
  func.return %number, %ieee : f16, f16
