amdgpu.target<gfx1170> @target
func.def target(@target) @scalar_f32_clamp_semantics(%value: f32, %lower: f32, %upper: f32) -> (f32, f32) {
  %number = scalar.clampf<number, nnan|nsz> %value, %lower, %upper : f32
  %ieee = scalar.clampf<ieee> %value, %lower, %upper : f32
  func.return %number, %ieee : f32, f32
}

// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @scalar_f32_clamp_semantics(%value: reg<amdgpu.vgpr>, %lower: reg<amdgpu.vgpr>, %upper: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %number = v_maxmin_num_f32 %value, %lower, %upper
  %ieee = v_maximumminimum_f32 %value, %lower, %upper
  return %number, %ieee
}

