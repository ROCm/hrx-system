// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @scalar_f16_minmax_semantics(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %minnum = v_min_num_f16 %lhs, %rhs
  %maxnum = v_max_num_f16 %lhs, %rhs
  %minimum = v_minimum_f16 %lhs, %rhs
  %maximum = v_maximum_f16 %lhs, %rhs
  %20 = v_bfe_u32_offset_0_width_16_low16 %minnum
  %21 = v_bfe_u32_offset_0_width_16_low16 %maxnum
  %22 = v_bfe_u32_offset_0_width_16_low16 %minimum
