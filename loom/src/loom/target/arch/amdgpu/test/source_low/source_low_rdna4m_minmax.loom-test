amdgpu.target<gfx1170> @target
func.def target(@target) @packed_f16_clamp_semantics(%value: vector<4xf16>, %lower: vector<4xf16>, %upper: vector<4xf16>) -> (vector<4xf16>, vector<4xf16>) {
  %number = vector.clampf<number, nnan|nsz> %value, %lower, %upper : vector<4xf16>
  %ieee = vector.clampf<ieee> %value, %lower, %upper : vector<4xf16>
  func.return %number, %ieee : vector<4xf16>, vector<4xf16>
}

// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @packed_f16_clamp_semantics(%value: reg<amdgpu.vgpr x2>, %lower: reg<amdgpu.vgpr x2>, %upper: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %12 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %13 = slice %lower[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %14 = v_pk_max_num_f16 %12, %13
  %15 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %16 = slice %lower[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %17 = v_pk_max_num_f16 %15, %16
  %20 = slice %upper[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = v_pk_min_num_f16 %14, %20
  %23 = slice %upper[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %24 = v_pk_min_num_f16 %17, %23
  %number = concat(%21, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %28 = v_pk_maximum_f16 %12, %13
  %31 = v_pk_maximum_f16 %15, %16
  %35 = v_pk_minimum_f16 %28, %20
  %38 = v_pk_minimum_f16 %31, %23
  %ieee = concat(%35, %38) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %number, %ieee
}

// ====

amdgpu.target<gfx1170> @target
func.def target(@target) @scalar_f32_clamp_ordered(%value: f32, %lower: f32, %upper: f32) -> (f32) {
  %result = scalar.clampf<ordered> %value, %lower, %upper : f32
  func.return %result : f32
}

// ----
low.func.def target<amdgpu.rdna4m.core>(@target) abi(hal_kernel) @scalar_f32_clamp_ordered(%value: reg<amdgpu.vgpr>, %lower: reg<amdgpu.vgpr>, %upper: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %9 = v_cmp_lt_f32 %value, %lower
  %10 = v_cndmask_b32 %value, %lower, %9
  %11 = v_cmp_gt_f32 %10, %upper
  %result = v_cndmask_b32 %10, %upper, %11
  return %result
}
