s_mov_b32 s1, 0
.Lbb1:
  v_nop
  v_nop
  v_nop
  v_nop
  v_add_f32 v25, v16, v24
  v_wmma_f32_16x16x32_bf16 v[16:23], v[0:7], v[8:15], v[16:23]
  s_mov_b32 s2, 1
  s_add_u32 s1, s1, s2
  s_cmp_lt_i32 s1, s0
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
