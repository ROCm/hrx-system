  v_nop
  v_add_f32 v0, v16, v24
  s_endpgm

// ====

// A source on a loop backedge must protect the header consumer on the next
// dynamic iteration even though the backedge is unresolved when the header is
// planned.
// RUN: emit amdgpu-assembly @gfx1250_matrix_source_reaches_loop_header

amdgpu.target<gfx1250> @gfx1250_target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@gfx1250_target) @gfx1250_matrix_source_reaches_loop_header(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>, %addend: reg<amdgpu.vgpr>, %limit: reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  low.br ^loop(%acc: reg<amdgpu.vgpr x8>, %zero: reg<amdgpu.sgpr>)
^loop(%carried: reg<amdgpu.vgpr x8>, %iteration: reg<amdgpu.sgpr>):
  %lane = slice %carried[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum = v_add_f32 %lane, %addend
  %next = v_wmma_f32_16x16x32_bf16 %lhs, %rhs, %carried
  %one = s_mov_b32 1
  %next_iteration = s_add_u32 %iteration, %one
  %again = s_cmp_lt_i32 %next_iteration, %limit
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next: reg<amdgpu.vgpr x8>, %next_iteration: reg<amdgpu.sgpr>)
^exit:
  return
}

