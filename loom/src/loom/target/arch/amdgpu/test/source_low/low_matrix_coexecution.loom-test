// ====

// A join must preserve a live matrix release frontier when only one incoming
// path issued the source.
// RUN: emit amdgpu-assembly @gfx1250_matrix_source_reaches_join strategy=source fixed=%lhs:physical_register:0:8 fixed=%rhs:physical_register:8:8 fixed=%acc:physical_register:16:8 fixed=%result:physical_register:16:8 fixed=%joined:physical_register:16:8 fixed=%addend:physical_register:24:1 fixed=%sum:physical_register:25:1

amdgpu.target<gfx1250> @gfx1250_target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@gfx1250_target) @gfx1250_matrix_source_reaches_join(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>, %addend: reg<amdgpu.vgpr>, %cond: reg<amdgpu.scc>) asm {
  low.cond_br %cond, ^matrix, ^plain : reg<amdgpu.scc>
^matrix:
  %result = v_wmma_f32_16x16x32_bf16 %lhs, %rhs, %acc
  low.br ^join(%result: reg<amdgpu.vgpr x8>)
^plain:
  low.br ^join(%acc: reg<amdgpu.vgpr x8>)
^join(%joined: reg<amdgpu.vgpr x8>):
  %lane = slice %joined[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum = v_add_f32 %lane, %addend
  return
}

