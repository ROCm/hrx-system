  s_mov_b32 s1, 0
.Lbb1:
  v_nop
  v_nop
  v_nop
  v_mov_b32 v25, v0
  v_wmma_f32_16x16x32_bf16 v[0:7], v[8:15], v[16:23], v[0:7]
  s_delay_alu instid0(VALU_DEP_2)
  v_add_f32 v25, v25, v24
  s_mov_b32 s2, 1
  s_add_u32 s1, s1, s2
  s_cmp_lt_i32 s1, s0
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_branch .Lbb1
.Lbb3:
  s_endpgm

// ====

// Edge-copy moves are real vector issues and must consume a matrix result only
// after its release window.
// RUN: emit amdgpu-assembly @gfx1250_matrix_result_edge_copy

amdgpu.target<gfx1250> @gfx1250_target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@gfx1250_target) @gfx1250_matrix_result_edge_copy(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>, %addend: reg<amdgpu.vgpr>) asm {
  %result = v_wmma_f32_16x16x32_bf16 %lhs, %rhs, %acc
  low.br ^join(%result: reg<amdgpu.vgpr x8>)
^join(%joined: reg<amdgpu.vgpr x8>):
  %lane = slice %joined[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum = v_add_f32 %lane, %addend
  return
}

