// ====

// An incoming gate delay retires the slow result before its later read. The
// fast result is produced after that delay and still needs three issue slots
// on the backedge. Provisional local waits cannot discharge that newer window.
// RUN: emit amdgpu-assembly @gfx1250_backedge_window_survives_moved_wait

amdgpu.target<gfx1250> @target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @gfx1250_backedge_window_survives_moved_wait(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %initial_gate: reg<amdgpu.vgpr x8>, %initial_slow: reg<amdgpu.vgpr x8>, %initial_fast: reg<amdgpu.vgpr x8>, %addend: reg<amdgpu.vgpr>, %limit: reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  low.br ^loop(%initial_gate: reg<amdgpu.vgpr x8>, %initial_slow: reg<amdgpu.vgpr x8>, %initial_fast: reg<amdgpu.vgpr x8>, %zero: reg<amdgpu.sgpr>)
^loop(%gate: reg<amdgpu.vgpr x8>, %slow: reg<amdgpu.vgpr x8>, %fast: reg<amdgpu.vgpr x8>, %iteration: reg<amdgpu.sgpr>):
  %fast_lane = slice %fast[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %header_use = v_add_u32 %fast_lane, %addend
  %next_gate = v_wmma_i32_16x16x64_iu8 %lhs, %rhs, %gate
  low.br ^body
^body:
  %next_slow = v_wmma_i32_16x16x64_iu8 %lhs, %rhs, %slow
  %gate_lane = slice %next_gate[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %gate_use = v_add_u32 %gate_lane, %addend
  %next_fast = v_wmma_f32_16x16x32_bf16 %lhs, %rhs, %fast
  %slow_lane = slice %next_slow[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %slow_use = v_add_u32 %slow_lane, %addend
  %one = s_mov_b32 1
  %next_iteration = s_add_u32 %iteration, %one
  %again = s_cmp_lt_u32 %next_iteration, %limit
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next_gate: reg<amdgpu.vgpr x8>, %next_slow: reg<amdgpu.vgpr x8>, %next_fast: reg<amdgpu.vgpr x8>, %next_iteration: reg<amdgpu.sgpr>)
^exit:
  return
}

