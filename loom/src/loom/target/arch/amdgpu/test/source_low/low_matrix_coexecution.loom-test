// ====

// A same-iteration consumer discharges the release window. The loop summary
// must not carry that consumed window back to an earlier header access.
// RUN: emit amdgpu-assembly @gfx1250_consumed_matrix_window_does_not_escape_loop

amdgpu.target<gfx1250> @gfx1250_target

low.func.def target<amdgpu.rdna4.gfx125x.core>(@gfx1250_target) @gfx1250_consumed_matrix_window_does_not_escape_loop(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>, %header_rhs: reg<amdgpu.vgpr>, %addend: reg<amdgpu.vgpr>, %limit: reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  low.br ^loop(%acc: reg<amdgpu.vgpr x8>, %zero: reg<amdgpu.sgpr>)
^loop(%carried: reg<amdgpu.vgpr x8>, %iteration: reg<amdgpu.sgpr>):
  %header_lane = slice %carried[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %header = v_add_f32 %header_lane, %header_rhs
  %result = v_wmma_f32_16x16x32_bf16 %lhs, %rhs, %carried
  %lane = slice %result[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum = v_add_f32 %lane, %addend
  %one = s_mov_b32 1
  %next_iteration = s_add_u32 %iteration, %one
  %again = s_cmp_lt_i32 %next_iteration, %limit
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%result: reg<amdgpu.vgpr x8>, %next_iteration: reg<amdgpu.sgpr>)
^exit:
  return
}

