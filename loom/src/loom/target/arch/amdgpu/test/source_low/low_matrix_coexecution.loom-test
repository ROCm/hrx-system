// RUN: emit amdgpu-assembly @gfx1250_consumed_matrix_window_does_not_escape_loop strategy=source fixed=%lhs:physical_register:0:8 fixed=%rhs:physical_register:8:8 fixed=%acc:physical_register:32:8 fixed=%carried:physical_register:32:8 fixed=%header_rhs:physical_register:40:1 fixed=%header:physical_register:41:1 fixed=%result:physical_register:32:8 fixed=%addend:physical_register:48:1 fixed=%sum:physical_register:49:1

