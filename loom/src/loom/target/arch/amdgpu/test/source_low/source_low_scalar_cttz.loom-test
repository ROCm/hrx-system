// ====
// RUN: with-checks emit source-low output=low

amdgpu.target<gfx11-generic> @target

// Only the guarded definition excludes zero; the input keeps its global facts.
kernel.def target(@target) @guarded_scalar_cttzi() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%input: i32, %result_buffer_0: buffer) {
  %result_base = index.constant 0 : offset
  %result_view_0 = buffer.view %result_buffer_0[%result_base] : buffer -> view<1xi32>
  %c0 = scalar.constant 0 : i32
  %width = scalar.constant 32 : i32
  %nonzero = scalar.cmpi ne, %input, %c0 : i32
  cfg.cond_br %nonzero, ^count, ^empty
^count:
  %result = scalar.cttzi %input : i32
  view.store %result, %result_view_0[0] : i32, view<1xi32>
  kernel.return
^empty:
  view.store %width, %result_view_0[0] : i32, view<1xi32>
  kernel.return
}

// ----
CHECK: %* = s_ctz_i32_b32 %input
CHECK-NOT: *s_min_u32*

// ====

// RUN: emit source-low output=low control-flow=structured-low

amdgpu.target<gfx11-generic> @target

// A compact MoE router worklist visits only experts selected in the bitmask.
// The loop condition proves every body mask nonzero before cttz chooses the
// next expert, then mask & (mask - 1) removes that expert from the worklist.
kernel.def target(@target) @expert_bitmask_walk() {
  %launch_unit = index.constant 1 : index
  kernel.launch.config workgroups(%launch_unit, %launch_unit, %launch_unit) workgroup_size(%launch_unit, %launch_unit, %launch_unit) : index
} launch(%expert_mask: i32, %result_buffer_0: buffer) {
  %result_base = index.constant 0 : offset
  %result_view_0 = buffer.view %result_buffer_0[%result_base] : buffer -> view<1xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %final_mask, %expert_sum = scf.while(%before_mask = %expert_mask : i32, %before_sum = %c0 : i32) -> (i32, i32) {
    %has_expert = scalar.cmpi ne, %before_mask, %c0 : i32
    scf.condition %has_expert, %before_mask, %before_sum : i1, i32, i32
  } do(%mask: i32, %sum: i32) {
    %expert = scalar.cttzi %mask : i32
    %next_sum = scalar.addi %sum, %expert : i32
    %mask_without_lowest_bit = scalar.subi %mask, %c1 : i32
    %next_mask = scalar.andi %mask, %mask_without_lowest_bit : i32
    scf.yield %next_mask, %next_sum : i32, i32
  }
  view.store %expert_sum, %result_view_0[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "expert_mask"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @expert_bitmask_walk(%expert_mask: reg<amdgpu.sgpr>) asm {
  %result_view_0 = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %c0 = s_mov_b32 0
  %23 = s_mov_b32 4294967295
  %final_mask, %expert_sum = low.scf.while(%before_mask = %expert_mask : reg<amdgpu.sgpr>, %before_sum = %c0 : reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) {
    %has_expert = s_cmp_lg_i32 %before_mask, %c0
    low.scf.condition %has_expert, %before_mask, %before_sum : reg<amdgpu.scc>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>
  } do(%mask: reg<amdgpu.sgpr>, %sum: reg<amdgpu.sgpr>) {
    %expert = s_ctz_i32_b32 %mask
    %next_sum = s_add_u32 %sum, %expert
    %mask_without_lowest_bit = s_add_u32 %mask, %23
    %next_mask = s_and_b32 %mask, %mask_without_lowest_bit
    low.scf.yield %next_mask, %next_sum : reg<amdgpu.sgpr>, reg<amdgpu.sgpr>
  }
  %35 = v_mov_b32_copy %expert_sum
  %36 = v_mov_b32 0
  global_store_b32_saddr %36, %35, %result_view_0
  return
}
