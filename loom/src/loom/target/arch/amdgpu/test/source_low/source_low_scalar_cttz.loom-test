// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @scalar_cttzi_i64_sgpr(%input: i64) -> (i64) {
  %result = scalar.cttzi %input : i64
  func.return %result : i64
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_cttzi_i64_sgpr(%input: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  %5 = s_ctz_i32_b64 %input
  %6 = s_mov_b32 64
  %7 = s_min_u32 %5, %6
  %8 = s_mov_b32 0
  %result = concat(%7, %8) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result
}

