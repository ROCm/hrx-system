// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_cttzi_i64_vgpr(%inputs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  %18 = slice %inputs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = slice %inputs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %9 = v_ctz_i32_b32 %18
  %10 = v_ctz_i32_b32 %17
  %11 = v_mov_b32 32
  %12 = v_min_u32 %10, %11
  %13 = v_add_u32_src0_inline %12, 32
  %14 = v_min_u32 %9, %13
  %15 = v_mov_b32 0
  %result = concat(%14, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

