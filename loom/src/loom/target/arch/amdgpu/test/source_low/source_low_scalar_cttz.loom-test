low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @scalar_cttzi_i32_vgpr(%inputs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %input = slice %inputs[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %7 = v_ctz_i32_b32 %input
  %8 = v_mov_b32 32
  %result = v_min_u32 %7, %8
  return %result
}

