  %302 = v_cmp_u_f32 %274, %65
  %306 = v_cndmask_b32_src1_lit %292, %299, 2143289344
  %309 = v_cndmask_b32_src1_lit %295, %302, 2143289344
  %ieee = concat(%306, %309) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %ordered, %relaxed_number, %number, %ieee
}
