func.def target(@target) @scalar_f32_minmax_semantics(%lhs: f32, %rhs: f32) -> (f32, f32, f32, f32) {
  %minnum = scalar.minnumf %lhs, %rhs : f32
  %maxnum = scalar.maxnumf %lhs, %rhs : f32
  %minimum = scalar.minimumf %lhs, %rhs : f32
  %maximum = scalar.maximumf %lhs, %rhs : f32
  func.return %minnum, %maxnum, %minimum, %maximum : f32, f32, f32, f32
}

