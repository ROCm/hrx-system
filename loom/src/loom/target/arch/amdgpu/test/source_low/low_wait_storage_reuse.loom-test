// RUN: emit amdgpu-assembly @carried_loads_preserve_address_parts strategy=source

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @carried_loads_preserve_address_parts(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %increment = s_mov_b32 16
  %base_lo = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_hi = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %initial = v_mov_b32 0
  %seed0 = global_load_b32_saddr %offset, %base
  %seed1 = global_load_b32_saddr %offset, %base {offset = 4}
  %seed2 = global_load_b32_saddr %offset, %base {offset = 8}
  low.br ^loop(%seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %seed2: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %zero: reg<amdgpu.sgpr>)
^loop(%carried0: reg<amdgpu.vgpr>, %carried1: reg<amdgpu.vgpr>, %carried2: reg<amdgpu.vgpr>, %sum: reg<amdgpu.vgpr>, %index: reg<amdgpu.sgpr>):
  %again = s_cmp_lt_i32 %index, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %used0 = v_add_u32 %carried0, %carried1
  %used1 = v_add_u32 %used0, %carried2
  %updated = v_add_u32 %used1, %sum
  %next0 = global_load_b32_saddr %offset, %base {offset = 12}
  %lo1, %lo1_carry = s_add_co_u32 %base_lo, %increment
  %hi1, %hi1_carry = s_addc_u32 %base_hi, %zero, %lo1_carry
  %address1 = concat(%lo1, %hi1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %next1 = global_load_b32_saddr %offset, %address1
  %lo2, %lo2_carry = s_add_co_u32 %base_lo, %increment
  %hi2, %hi2_carry = s_addc_u32 %base_hi, %increment, %lo2_carry
  %address2 = concat(%lo2, %hi2) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %next2 = global_load_b32_saddr %offset, %address2
  %next_index = s_add_u32 %index, %increment
  low.br ^loop(%next0: reg<amdgpu.vgpr>, %next1: reg<amdgpu.vgpr>, %next2: reg<amdgpu.vgpr>, %updated: reg<amdgpu.vgpr>, %next_index: reg<amdgpu.sgpr>)
^exit:
  %last0 = v_add_u32 %carried0, %carried1
  %last1 = v_add_u32 %last0, %carried2
  %last = v_add_u32 %last1, %sum
  return %last
}

// Available SGPR pairs preserve both assembled addresses until their loads
// complete. Reserving the next concat must not drain earlier global loads.
// The loop consumes carried results with the waits required by their order.
// ----
  s_mov_b32 s3, 0
  s_mov_b32 s4, 16
  v_mov_b32 v1, 0
  global_load_b32 v2, v0, s[0:1] offset:0
  global_load_b32 v3, v0, s[0:1] offset:4
  global_load_b32 v4, v0, s[0:1] offset:8
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_mov_b32 s5, s3
.Lbb1:
  s_cmp_lt_i32 s5, s2
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v2, v2, v3
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_add_u32 v2, v2, v4
  v_add_u32 v1, v2, v1
  global_load_b32 v2, v0, s[0:1] offset:12
  s_add_u32 s6, s0, s4
  s_addc_u32 s7, s1, s3
  global_load_b32 v3, v0, s[6:7] offset:0
  s_add_u32 s8, s0, s4
  s_addc_u32 s9, s1, s4
  global_load_b32 v4, v0, s[8:9] offset:0
  s_add_u32 s5, s5, s4
  s_branch .Lbb1
.Lbb3:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v2, v3
  s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_add_u32 v0, v0, v4
  v_add_u32 v0, v0, v1
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @carried_loads_reuse_address_at_capacity strategy=source amdgpu.sgpr=8

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @carried_loads_reuse_address_at_capacity(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %increment = s_mov_b32 16
  %base_lo = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_hi = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %initial = v_mov_b32 0
  %seed0 = global_load_b32_saddr %offset, %base
  %seed1 = global_load_b32_saddr %offset, %base {offset = 4}
  %seed2 = global_load_b32_saddr %offset, %base {offset = 8}
  low.br ^loop(%seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %seed2: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %zero: reg<amdgpu.sgpr>)
^loop(%carried0: reg<amdgpu.vgpr>, %carried1: reg<amdgpu.vgpr>, %carried2: reg<amdgpu.vgpr>, %sum: reg<amdgpu.vgpr>, %index: reg<amdgpu.sgpr>):
  %again = s_cmp_lt_i32 %index, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %used0 = v_add_u32 %carried0, %carried1
  %used1 = v_add_u32 %used0, %carried2
  %updated = v_add_u32 %used1, %sum
  %next0 = global_load_b32_saddr %offset, %base {offset = 12}
  %lo1, %lo1_carry = s_add_co_u32 %base_lo, %increment
  %hi1, %hi1_carry = s_addc_u32 %base_hi, %zero, %lo1_carry
  %address1 = concat(%lo1, %hi1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %next1 = global_load_b32_saddr %offset, %address1
  %lo2, %lo2_carry = s_add_co_u32 %base_lo, %increment
  %hi2, %hi2_carry = s_addc_u32 %base_hi, %increment, %lo2_carry
  %address2 = concat(%lo2, %hi2) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %next2 = global_load_b32_saddr %offset, %address2
  %next_index = s_add_u32 %index, %increment
  low.br ^loop(%next0: reg<amdgpu.vgpr>, %next1: reg<amdgpu.vgpr>, %next2: reg<amdgpu.vgpr>, %updated: reg<amdgpu.vgpr>, %next_index: reg<amdgpu.sgpr>)
^exit:
  %last0 = v_add_u32 %carried0, %carried1
  %last1 = v_add_u32 %last0, %carried2
  %last = v_add_u32 %last1, %sum
  return %last
}

// Address-part writes reuse the preceding load's SGPR pair before the concat.
// The release belongs before the first such write; only the last load remains
// pending at the backedge. The next iteration can add the first two completed
// results before waiting for the last.
// ----
  s_mov_b32 s3, 0
  s_mov_b32 s4, 16
  v_mov_b32 v1, 0
  global_load_b32 v2, v0, s[0:1] offset:0
  global_load_b32 v3, v0, s[0:1] offset:4
  global_load_b32 v4, v0, s[0:1] offset:8
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_mov_b32 s5, s3
.Lbb1:
  s_cmp_lt_i32 s5, s2
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  v_add_u32 v2, v2, v3
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_add_u32 v2, v2, v4
  v_add_u32 v1, v2, v1
  global_load_b32 v2, v0, s[0:1] offset:12
  s_add_u32 s6, s0, s4
  s_addc_u32 s7, s1, s3
  global_load_b32 v3, v0, s[6:7] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_add_u32 s6, s0, s4
  s_addc_u32 s7, s1, s4
  global_load_b32 v4, v0, s[6:7] offset:0
  s_add_u32 s5, s5, s4
  s_branch .Lbb1
.Lbb3:
  v_add_u32 v0, v2, v3
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_add_u32 v0, v0, v4
  v_add_u32 v0, v0, v1
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @concat_source_at_residency_cliff strategy=source fixed=%pressure:physical_register:0:90 fixed=%base:physical_register:90:2 fixed=%zero:physical_register:92:1 fixed=%increment:physical_register:93:1

// Reserving s96:s97 would lower modeled CDNA occupancy from eight waves
// to seven. Ordinary placement releases the earlier pair instead.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @concat_source_at_residency_cliff(%pressure: reg<amdgpu.sgpr x90>, %base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr x90>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  %increment = s_mov_b32 16
  %base_lo = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_hi = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %lo0, %lo0_carry = s_add_co_u32 %base_lo, %increment
  %hi0, %hi0_carry = s_addc_u32 %base_hi, %zero, %lo0_carry
  %address0 = concat(%lo0, %hi0) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %first = global_load_dword_saddr %offset, %address0
  %lo1, %lo1_carry = s_add_co_u32 %base_lo, %increment
  %hi1, %hi1_carry = s_addc_u32 %base_hi, %increment, %lo1_carry
  %address1 = concat(%lo1, %hi1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %second = global_load_dword_saddr %offset, %address1
  %sum = v_add_u32 %first, %second
  return %sum, %pressure, %base, %zero, %increment
}

// ----
  s_mov_b32 s92, 0
  s_mov_b32 s93, 16
  s_add_u32 s94, s90, s93
  s_addc_u32 s95, s91, s92
  global_load_dword v1, v0, s[94:95] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_add_u32 s94, s90, s93
  s_addc_u32 s95, s91, s93
  global_load_dword v0, v0, s[94:95] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  v_add_u32 v0, v1, v0
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @smem_result_reuse_requires_full_drain strategy=source fixed=%kernarg:physical_register:0:2 fixed=%wide:physical_register:8:8 fixed=%noise0:physical_register:4:1 fixed=%noise1:physical_register:6:2 fixed=%noise2:physical_register:16:4 fixed=%sum:physical_register:10:1

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @smem_result_reuse_requires_full_drain(%kernarg: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x4>) asm {
  %wide = s_load_dwordx8_offset_only %kernarg
  %noise0 = s_load_dword_offset_only %kernarg {offset = 32}
  %noise1 = s_load_dwordx2_offset_only %kernarg {offset = 40}
  %noise2 = s_load_dwordx4_offset_only %kernarg {offset = 48}
  %offset = s_mov_b32 4
  %query = slice %wide[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %query_lo = slice %query[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %sum, %carry = s_add_co_u32 %query_lo, %offset
  return %sum, %noise0, %noise1, %noise2
}

// Scalar-memory requests may complete out of issue order. Reusing the oldest
// wide load's physical result after three younger requests therefore requires
// a full drain, even though a positional remaining-count bound would be three.
// ----
  s_load_dwordx8 s[8:15], s[0:1] offset:0
  s_load_dword s4, s[0:1] offset:32
  s_load_dwordx2 s[6:7], s[0:1] offset:40
  s_load_dwordx4 s[16:19], s[0:1] offset:48
  s_mov_b32 s0, 4
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s10, s10, s0
  s_endpgm
