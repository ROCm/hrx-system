// RUN: emit amdgpu-assembly @carried_loads_reuse_address_parts strategy=source

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @carried_loads_reuse_address_parts(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %increment = s_mov_b32 16
  %base_lo = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_hi = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %initial = v_mov_b32 0
  %seed0 = global_load_b32_saddr %offset, %base
  %seed1 = global_load_b32_saddr %offset, %base {offset = 4}
  %seed2 = global_load_b32_saddr %offset, %base {offset = 8}
  low.br ^loop(%seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %seed2: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %zero: reg<amdgpu.sgpr>)
^loop(%carried0: reg<amdgpu.vgpr>, %carried1: reg<amdgpu.vgpr>, %carried2: reg<amdgpu.vgpr>, %sum: reg<amdgpu.vgpr>, %index: reg<amdgpu.sgpr>):
  %again = s_cmp_lt_i32 %index, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %used0 = v_add_u32 %carried0, %carried1
  %used1 = v_add_u32 %used0, %carried2
  %updated = v_add_u32 %used1, %sum
  %next0 = global_load_b32_saddr %offset, %base {offset = 12}
  %lo1 = s_add_u32 %base_lo, %increment
  %hi1 = s_addc_u32 %base_hi, %zero
  %address1 = concat(%lo1, %hi1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %next1 = global_load_b32_saddr %offset, %address1
  %lo2 = s_add_u32 %base_lo, %increment
  %hi2 = s_addc_u32 %base_hi, %increment
  %address2 = concat(%lo2, %hi2) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %next2 = global_load_b32_saddr %offset, %address2
  %next_index = s_add_u32 %index, %increment
  low.br ^loop(%next0: reg<amdgpu.vgpr>, %next1: reg<amdgpu.vgpr>, %next2: reg<amdgpu.vgpr>, %updated: reg<amdgpu.vgpr>, %next_index: reg<amdgpu.sgpr>)
^exit:
  %last0 = v_add_u32 %carried0, %carried1
  %last1 = v_add_u32 %last0, %carried2
  %last = v_add_u32 %last1, %sum
  return %last
}

// Address-part writes reuse the preceding load's SGPR pair before the concat.
// The release belongs before the first such write; only the last load remains
// pending at the backedge. Loop analysis must agree with that physical lifetime.
// ----
  s_mov_b32 s3, 0
  s_mov_b32 s4, 16
  v_mov_b32 v1, 0
  global_load_b32 v2, v0, s[0:1] offset:0
  global_load_b32 v3, v0, s[0:1] offset:4
  global_load_b32 v4, v0, s[0:1] offset:8
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_mov_b32 s5, s3
.Lbb1:
  s_cmp_lt_i32 s5, s2
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v2, v2, v3
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v2, v2, v4
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v1, v2, v1
  global_load_b32 v2, v0, s[0:1] offset:12
  s_add_u32 s6, s0, s4
  s_addc_u32 s7, s1, s3
  global_load_b32 v3, v0, s[6:7] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_add_u32 s6, s0, s4
  s_addc_u32 s7, s1, s4
  global_load_b32 v4, v0, s[6:7] offset:0
  s_add_u32 s5, s5, s4
  s_branch .Lbb1
.Lbb3:
  v_add_u32 v0, v2, v3
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v4
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v1
  s_endpgm

// ====

// RUN: emit amdgpu-wait-counter-plan-json @carried_loads_release_at_first_address_write strategy=source

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @carried_loads_release_at_first_address_write(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %increment = s_mov_b32 16
  %base_lo = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %base_hi = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %initial = v_mov_b32 0
  %seed0 = global_load_b32_saddr %offset, %base
  %seed1 = global_load_b32_saddr %offset, %base {offset = 4}
  %seed2 = global_load_b32_saddr %offset, %base {offset = 8}
  low.br ^loop(%seed0: reg<amdgpu.vgpr>, %seed1: reg<amdgpu.vgpr>, %seed2: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %zero: reg<amdgpu.sgpr>)
^loop(%carried0: reg<amdgpu.vgpr>, %carried1: reg<amdgpu.vgpr>, %carried2: reg<amdgpu.vgpr>, %sum: reg<amdgpu.vgpr>, %index: reg<amdgpu.sgpr>):
  %again = s_cmp_lt_i32 %index, %limit
  low.cond_br %again, ^body, ^exit : reg<amdgpu.scc>
^body:
  %used0 = v_add_u32 %carried0, %carried1
  %used1 = v_add_u32 %used0, %carried2
  %updated = v_add_u32 %used1, %sum
  %next0 = global_load_b32_saddr %offset, %base {offset = 12}
  %lo1 = s_add_u32 %base_lo, %increment
  %hi1 = s_addc_u32 %base_hi, %zero
  %address1 = concat(%lo1, %hi1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %next1 = global_load_b32_saddr %offset, %address1
  %lo2 = s_add_u32 %base_lo, %increment
  %hi2 = s_addc_u32 %base_hi, %increment
  %address2 = concat(%lo2, %hi2) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %next2 = global_load_b32_saddr %offset, %address2
  %next_index = s_add_u32 %index, %increment
  low.br ^loop(%next0: reg<amdgpu.vgpr>, %next1: reg<amdgpu.vgpr>, %next2: reg<amdgpu.vgpr>, %updated: reg<amdgpu.vgpr>, %next_index: reg<amdgpu.sgpr>)
^exit:
  %last0 = v_add_u32 %carried0, %carried1
  %last1 = v_add_u32 %last0, %carried2
  %last = v_add_u32 %last1, %sum
  return %last
}

// Allocation and target wait actions retain the same physical release point.
