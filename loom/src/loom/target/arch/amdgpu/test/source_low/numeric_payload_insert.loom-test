// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Inserting into a single-lane vector still normalizes the scalar byte carrier.
func.def @single_byte(%value: i8, %previous: vector<1xf8E4M3>) -> (vector<1xf8E4M3>) {
  %payload = scalar.bitcast %value : i8 to f8E4M3
  %result = vector.insert %payload into %previous[0] : f8E4M3, vector<1xf8E4M3>
  func.return %result : vector<1xf8E4M3>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @single_byte(%payload: reg<amdgpu.vgpr>, %previous: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_and_b32_lit %payload, 255
  return %result
}

// ====

// RUN: emit source-low target=amdgpu:gfx1200 output=low

// The byte after a register boundary leaves neighboring payloads unchanged.
func.def @static_byte(%value: i8, %previous: vector<7xf8E5M2>) -> (vector<7xf8E5M2>) {
  %payload = scalar.bitcast %value : i8 to f8E5M2
  %result = vector.insert %payload into %previous[4] : f8E5M2, vector<7xf8E5M2>
  func.return %result : vector<7xf8E5M2>
}

// ----
low.func.def target<amdgpu.rdna4.core> abi(hal_kernel) @static_byte(%payload: reg<amdgpu.vgpr>, %previous: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %8 = v_and_b32_lit %payload, 255
  %9 = slice %previous[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %10 = slice %previous[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %11 = v_and_b32_lit %10, 4294967040
  %12 = v_or_b32 %11, %8
  %result = concat(%9, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ====

// RUN: emit source-low target=amdgpu:gfx942 output=low

// A runtime lane index selects a byte within one packed register.
func.def @dynamic_byte(%value: f8E4M3, %previous: vector<4xf8E4M3>, %index: index) -> (vector<4xf8E4M3>) {
  %result = vector.insert %value into %previous[%index] : f8E4M3, vector<4xf8E4M3>
  func.return %result : vector<4xf8E4M3>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @dynamic_byte(%value: reg<amdgpu.vgpr>, %previous: reg<amdgpu.vgpr>, %index: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %9 = v_and_b32_lit %value, 255
  %10 = v_and_b32_lit %previous, 4294967040
  %11 = v_or_b32 %10, %9
  %12 = v_cmp_eq_i32_src1_inline %index {rhs = 0}
  %13 = v_cndmask_b32 %previous, %11, %12
  %14 = v_and_b32_lit %previous, 4294902015
  %15 = v_lshlrev_b32_src0_inline %9, 8
  %16 = v_or_b32 %14, %15
  %17 = v_cmp_eq_i32_src1_inline %index {rhs = 1}
  %18 = v_cndmask_b32 %13, %16, %17
  %19 = v_and_b32_lit %previous, 4278255615
  %20 = v_lshlrev_b32_src0_inline %9, 16
  %21 = v_or_b32 %19, %20
  %22 = v_cmp_eq_i32_src1_inline %index {rhs = 2}
  %23 = v_cndmask_b32 %18, %21, %22
  %24 = v_and_b32_lit %previous, 16777215
  %25 = v_lshlrev_b32_src0_inline %9, 24
  %26 = v_or_b32 %24, %25
  %27 = v_cmp_eq_i32_src1_inline %index {rhs = 3}
  %result = v_cndmask_b32 %23, %26, %27
  return %result
}
