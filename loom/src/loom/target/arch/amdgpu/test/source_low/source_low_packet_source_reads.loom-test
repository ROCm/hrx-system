  scratch_store_b128_vaddr %61, %126 {offset = 512}
  global_store_b32_saddr %61, %replacement, %source_view
  %162 = s_mov_b32 0
  %163 = s_mov_b32 132
  %164 = s_mov_b32 4
  low.br ^_bb1(%162: reg<amdgpu.sgpr>)
^_bb1(%57: reg<amdgpu.sgpr>):
  %165 = s_cmp_lt_i32 %57, %163
  low.cond_br %165, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %166 = v_mov_b32_copy %57
  %167 = v_lshlrev_b32_src0_inline %166, 2
  %168 = scratch_load_b128_vaddr %167
  %170 = s_lshl_b32_rhs_inline %57, 2
  %171 = slice %destination_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %172 = slice %destination_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %174, %175 = s_add_co_u32 %171, %170
  %176, %177 = s_addc_u32 %172, %162, %175
  %178 = concat(%174, %176) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
