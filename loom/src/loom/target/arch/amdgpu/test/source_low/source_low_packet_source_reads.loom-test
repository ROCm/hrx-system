// RUN: emit source-low target=amdgpu:gfx11-generic output=low

func.def @preserve_large_old_source(%source: buffer, %destination: buffer, %replacement: f32) {
  %base = index.constant 0 : offset
  %source_noalias, %destination_noalias = buffer.assume.noalias %source, %destination : buffer, buffer
  %source_view = buffer.view %source_noalias[%base] : buffer -> view<132xf32>
  %destination_view = buffer.view %destination_noalias[%base] : buffer -> view<132xf32>
  %old = vector.load %source_view[0] : view<132xf32> -> vector<132xf32>
  view.store %replacement, %source_view[0] : f32, view<132xf32>
  vector.store %old, %destination_view[0] : vector<132xf32>, view<132xf32>
  func.return
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @preserve_large_old_source(%replacement: reg<amdgpu.vgpr>) asm {
  %source_view = resource<hal_binding> {extent = 528, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
