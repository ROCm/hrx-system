  scratch_store_b128_vaddr %62, %127 {offset = 512}
  global_store_b32_saddr %62, %replacement, %source_view
  %163 = s_mov_b32 0
  %164 = s_mov_b32 132
  %165 = s_mov_b32 4
  low.br ^_bb1(%163: reg<amdgpu.sgpr>)
^_bb1(%58: reg<amdgpu.sgpr>):
  %166 = s_cmp_lt_i32 %58, %164
  low.cond_br %166, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %167 = v_mov_b32_copy %58
  %168 = v_lshlrev_b32_src0_inline %167, 2
  %169 = scratch_load_b128_vaddr %168
  %171 = s_lshl_b32_rhs_inline %58, 2
  %172 = slice %destination_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %173 = slice %destination_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %175, %176 = s_add_co_u32 %172, %171
  %177, %178 = s_addc_u32 %173, %163, %176
  %179 = concat(%175, %177) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
