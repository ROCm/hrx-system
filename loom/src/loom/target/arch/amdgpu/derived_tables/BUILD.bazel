loom_generated_file_family(
    name = "rdna4_gfx125x_gen",
    args = [
        "--target=rdna4_gfx125x",
        "--isa-xml=rdna4:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_rdna4.xml)",
    ],
    comment = "Generating rdna4_gfx125x runtime target tables",
    generator = _AMDGPU_TARGET_TABLE_GENERATOR,
    inputs = ["@amdgpu_isa_xml//:amdgpu_isa_rdna4.xml"],
    output_flags = [
        "--descriptor-source",
        "--encoding-source",
    ],
    outputs = [
        "rdna4_gfx125x_descriptors.c",
        "rdna4_gfx125x_encoding_tables.c",
    ],
    visibility = _DERIVED_TABLE_VISIBILITY,
)

loom_generated_file_family(
    name = "cdna4_gen",
    args = [
        "--target=cdna4",
        "--isa-xml=cdna4:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_cdna4.xml)",
    ],
    comment = "Generating cdna4 runtime target tables",
    generator = _AMDGPU_TARGET_TABLE_GENERATOR,
    inputs = ["@amdgpu_isa_xml//:amdgpu_isa_cdna4.xml"],
    output_flags = [
        "--descriptor-source",
        "--encoding-source",
    ],
    outputs = [
        "cdna4_descriptors.c",
        "cdna4_encoding_tables.c",
    ],
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_CDNA4),
    visibility = _DERIVED_TABLE_VISIBILITY,
)
