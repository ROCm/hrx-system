load(
    "//loom/build_tools/amdgpu:descriptor_sets.bzl",
    "loom_amdgpu_descriptor_set_compatible_with",
    "loom_amdgpu_encoding_table_deps",
    "loom_amdgpu_selected_descriptor_set_defines",
)
load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY",
)
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_low_descriptor_exclude_from_cmake_all",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_DESCRIPTOR_SET_CDNA4 = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.cdna4.core"]

_DESCRIPTOR_SET_GFX9_4_GENERIC = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx9_4.generic.core"]

_DESCRIPTOR_SET_GFX11_GENERIC = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"]

_DESCRIPTOR_SET_GFX12_GENERIC = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx12.generic.core"]

_DESCRIPTOR_SET_GFX12_5_GENERIC = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx12_5.generic.core"]

_DESCRIPTOR_SET_RDNA3_5 = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.rdna3_5.core"]

_DESCRIPTOR_SET_RDNA4M = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.rdna4m.core"]

_DESCRIPTOR_SET_RDNA4_GFX1250_A0 = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.rdna4.gfx1250_a0.core"]

_DESCRIPTOR_SET_RDNA4_GFX1251 = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.rdna4.gfx1251.core"]

_AMDGPU_ENCODING_VISIBILITY = [
    "//loom/src/loom/target/arch/amdgpu:__pkg__",
    "//loom/src/loom/target/arch/amdgpu/lower:__pkg__",
    "//loom/src/loom/target/arch/amdgpu/planning:__pkg__",
    "//loom/src/loom/target/emit/native/amdgpu:__pkg__",
]

exports_files(
    ["encoding.h"],
    visibility = ["//loom/py/loom/target/arch/amdgpu:__pkg__"],
)

loom_cc_library(
    name = "encoding_defs",
    hdrs = ["encoding.h"],
    textual_hdrs = ["//loom/src/loom/target/arch/amdgpu:encoding_field_ids.inl"],
    visibility = _AMDGPU_ENCODING_VISIBILITY,
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "cdna3_encoding_tables",
    srcs = ["//loom/src/loom/target/arch/amdgpu/derived_tables:cdna3_encoding_tables.c"],
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "gfx9_4_generic_encoding_tables",
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_GFX9_4_GENERIC),
    deps = [
        ":cdna3_encoding_tables",
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "gfx11_generic_encoding_tables",
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_GFX11_GENERIC),
    deps = [
        ":encoding_defs",
        ":rdna3_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "gfx12_generic_encoding_tables",
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_GFX12_GENERIC),
    deps = [
        ":encoding_defs",
        ":rdna4_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "gfx12_5_generic_encoding_tables",
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_GFX12_5_GENERIC),
    deps = [
        ":encoding_defs",
        ":rdna4_gfx125x_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "rdna4_gfx1251_encoding_tables",
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_RDNA4_GFX1251),
    deps = [
        ":encoding_defs",
        ":rdna4_gfx125x_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "rdna3_encoding_tables",
    srcs = ["//loom/src/loom/target/arch/amdgpu/derived_tables:rdna3_encoding_tables.c"],
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "rdna3_5_encoding_tables",
    srcs = ["//loom/src/loom/target/arch/amdgpu/derived_tables:rdna3_5_encoding_tables.c"],
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_RDNA3_5),
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "rdna4m_encoding_tables",
    srcs = ["//loom/src/loom/target/arch/amdgpu/derived_tables:rdna4m_encoding_tables.c"],
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_RDNA4M),
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "rdna4_encoding_tables",
    srcs = ["//loom/src/loom/target/arch/amdgpu/derived_tables:rdna4_encoding_tables.c"],
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "rdna4_gfx125x_encoding_tables",
    srcs = ["//loom/src/loom/target/arch/amdgpu/derived_tables:rdna4_gfx125x_encoding_tables.c"],
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "rdna4_gfx1250_a0_encoding_tables",
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_RDNA4_GFX1250_A0),
    deps = [
        ":encoding_defs",
        ":rdna4_gfx125x_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "cdna4_encoding_tables",
    srcs = ["//loom/src/loom/target/arch/amdgpu/derived_tables:cdna4_encoding_tables.c"],
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_CDNA4),
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "encoding",
    srcs = ["encoding.c"],
    hdrs = ["encoding.h"],
    defines = loom_amdgpu_selected_descriptor_set_defines(),
    textual_hdrs = ["//loom/src/loom/target/arch/amdgpu:encoding_tables.inl"],
    visibility = _AMDGPU_ENCODING_VISIBILITY,
    deps = loom_amdgpu_encoding_table_deps() + [
        ":encoding_defs",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//runtime/src/iree/base",
    ],
)

loom_low_descriptor_exclude_from_cmake_all(
    cc_libraries = [
        "cdna3_encoding_tables",
        "cdna4_encoding_tables",
        "rdna3_5_encoding_tables",
        "rdna3_encoding_tables",
        "rdna4_encoding_tables",
        "rdna4_gfx125x_encoding_tables",
        "rdna4m_encoding_tables",
    ],
)

loom_cc_test(
    name = "encoding_test",
    srcs = ["encoding_test.cc"],
    deps = [
        ":encoding",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
