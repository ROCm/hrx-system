load(
    "//loom/build_tools/amdgpu:descriptor_sets.bzl",
    "loom_amdgpu_descriptor_set_compatible_with",
    "loom_amdgpu_encoding_table_deps",
    "loom_amdgpu_selected_descriptor_set_defines",
)
load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY",
)
load("//loom/build_tools/amdgpu/isa_xml:archive.bzl", "AMDGPU_ISA_XML_ARCHIVE")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_generated_textual_header_family",
    "loom_low_descriptor_data_archive",
    "loom_target_table_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_ENCODING_TABLE_GENERATOR = "//loom/py/loom/gen/target/arch/amdgpu/encoding:encoding_tables"

_AMDGPU_CONFIG_TABLES_GENERATOR = "//loom/py/loom/gen/target/arch/amdgpu:config_tables"

_DESCRIPTOR_SET_CDNA4 = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.cdna4.core"]

_DESCRIPTOR_SET_GFX9_4_GENERIC = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx9_4.generic.core"]

_DESCRIPTOR_SET_GFX11_GENERIC = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"]

_DESCRIPTOR_SET_GFX12_GENERIC = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx12.generic.core"]

_DESCRIPTOR_SET_GFX12_5_GENERIC = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx12_5.generic.core"]

_DESCRIPTOR_SET_RDNA3_5 = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.rdna3_5.core"]

_DESCRIPTOR_SET_RDNA4M = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.rdna4m.core"]

_DESCRIPTOR_SET_RDNA4_GFX1250_A0 = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.rdna4.gfx1250_a0.core"]

_DESCRIPTOR_SET_RDNA4_GFX1251 = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.rdna4.gfx1251.core"]

_AMDGPU_ENCODING_VISIBILITY = [
    "//loom/src/loom/target/arch/amdgpu:__pkg__",
    "//loom/src/loom/target/arch/amdgpu/lower:__pkg__",
    "//loom/src/loom/target/arch/amdgpu/planning:__pkg__",
    "//loom/src/loom/target/emit/native/amdgpu:__pkg__",
]

exports_files(
    ["encoding.h"],
    visibility = ["//loom/py/loom/target/arch/amdgpu:__pkg__"],
)

loom_low_descriptor_data_archive(
    name = "amdgpu_isa_xml",
    repo_name = AMDGPU_ISA_XML_ARCHIVE["repo_name"],
    sha256 = AMDGPU_ISA_XML_ARCHIVE["sha256"],
    urls = AMDGPU_ISA_XML_ARCHIVE["urls"],
)

loom_generated_textual_header_family(
    name = "encoding_config_tables_gen",
    generator = _AMDGPU_CONFIG_TABLES_GENERATOR,
    output_flags = [
        "--encoding-field-ids",
        "--encoding-tables",
    ],
    outputs = [
        "encoding_field_ids.inl",
        "encoding_tables.inl",
    ],
    visibility = _AMDGPU_ENCODING_VISIBILITY,
)

loom_cc_library(
    name = "encoding_defs",
    hdrs = ["encoding.h"],
    textual_hdrs = [":encoding_field_ids.inl"],
    visibility = _AMDGPU_ENCODING_VISIBILITY,
    deps = ["//runtime/src/iree/base"],
)

loom_target_table_cc_library(
    name = "cdna3_encoding_tables",
    args = [
        "--target=cdna3",
        "--descriptor-set-key=amdgpu.cdna3.core",
        "--isa-xml=cdna3:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_cdna3.xml)",
        "--isa-xml=cdna4:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_cdna4.xml)",
        "--public-header=loom/target/arch/amdgpu/encoding/cdna3_encoding_tables.h",
    ],
    exclude_from_cmake_all = True,
    generated_hdr_flags = ["--view-header=gfx9_4_generic"],
    generated_hdrs = ["gfx9_4_generic_encoding_tables.h"],
    generator = _AMDGPU_ENCODING_TABLE_GENERATOR,
    inputs = [
        "@amdgpu_isa_xml//:amdgpu_isa_cdna3.xml",
        "@amdgpu_isa_xml//:amdgpu_isa_cdna4.xml",
    ],
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "gfx9_4_generic_encoding_tables",
    header = "gfx9_4_generic_encoding_tables.h",
    header_only = True,
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_GFX9_4_GENERIC),
    deps = [
        ":cdna3_encoding_tables",
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "gfx11_generic_encoding_tables",
    header = "gfx11_generic_encoding_tables.h",
    header_only = True,
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_GFX11_GENERIC),
    deps = [
        ":encoding_defs",
        ":rdna3_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "gfx12_generic_encoding_tables",
    header = "gfx12_generic_encoding_tables.h",
    header_only = True,
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_GFX12_GENERIC),
    deps = [
        ":encoding_defs",
        ":rdna4_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "gfx12_5_generic_encoding_tables",
    header = "gfx12_5_generic_encoding_tables.h",
    header_only = True,
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_GFX12_5_GENERIC),
    deps = [
        ":encoding_defs",
        ":rdna4_gfx125x_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "rdna4_gfx1251_encoding_tables",
    header = "rdna4_gfx1251_encoding_tables.h",
    header_only = True,
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_RDNA4_GFX1251),
    deps = [
        ":encoding_defs",
        ":rdna4_gfx125x_encoding_tables",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "rdna3_encoding_tables",
    args = [
        "--target=rdna3",
        "--descriptor-set-key=amdgpu.rdna3.core",
        "--isa-xml=rdna3:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_rdna3.xml)",
        "--isa-xml=rdna3_5:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_rdna3_5.xml)",
        "--public-header=loom/target/arch/amdgpu/encoding/rdna3_encoding_tables.h",
    ],
    exclude_from_cmake_all = True,
    generated_hdr_flags = ["--view-header=gfx11_generic"],
    generated_hdrs = ["gfx11_generic_encoding_tables.h"],
    generator = _AMDGPU_ENCODING_TABLE_GENERATOR,
    inputs = [
        "@amdgpu_isa_xml//:amdgpu_isa_rdna3.xml",
        "@amdgpu_isa_xml//:amdgpu_isa_rdna3_5.xml",
    ],
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "rdna3_5_encoding_tables",
    args = [
        "--target=rdna3_5",
        "--descriptor-set-key=amdgpu.rdna3_5.core",
        "--isa-xml=rdna3_5:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_rdna3_5.xml)",
        "--public-header=loom/target/arch/amdgpu/encoding/rdna3_5_encoding_tables.h",
    ],
    exclude_from_cmake_all = True,
    generator = _AMDGPU_ENCODING_TABLE_GENERATOR,
    inputs = ["@amdgpu_isa_xml//:amdgpu_isa_rdna3_5.xml"],
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_RDNA3_5),
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "rdna4m_encoding_tables",
    args = [
        "--target=rdna4m",
        "--descriptor-set-key=amdgpu.rdna4m.core",
        "--isa-xml=rdna3_5:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_rdna3_5.xml)",
        "--public-header=loom/target/arch/amdgpu/encoding/rdna4m_encoding_tables.h",
    ],
    exclude_from_cmake_all = True,
    generator = _AMDGPU_ENCODING_TABLE_GENERATOR,
    inputs = ["@amdgpu_isa_xml//:amdgpu_isa_rdna3_5.xml"],
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(_DESCRIPTOR_SET_RDNA4M),
    deps = [
        ":encoding_defs",
        "//runtime/src/iree/base",
    ],
)

loom_target_table_cc_library(
    name = "rdna4_encoding_tables",
    args = [
        "--target=rdna4",
        "--descriptor-set-key=amdgpu.rdna4.core",
        "--isa-xml=rdna4:$(rootpath @amdgpu_isa_xml//:amdgpu_isa_rdna4.xml)",
        "--public-header=loom/target/arch/amdgpu/encoding/rdna4_encoding_tables.h",
    ],
    exclude_from_cmake_all = True,
    generated_hdr_flags = ["--view-header=gfx12_generic"],
    generated_hdrs = ["gfx12_generic_encoding_tables.h"],
    generator = _AMDGPU_ENCODING_TABLE_GENERATOR,
    inputs = ["@amdgpu_isa_xml//:amdgpu_isa_rdna4.xml"],
    deps = [
        ":encoding_defs",
