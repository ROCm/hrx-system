load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_target_contract_cc_libraries",
    "loom_target_contract_file_family",
    "loom_target_table_cc_library",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_CONTRACT_FRAGMENT_GENERATOR = "//loom/py/loom/gen/target/contracts:amdgpu_contract_fragment"

loom_target_contract_file_family(
    name = "contract_tables_gen",
    comment = "Generating AMDGPU contract table families",
    fragments = {
        "arithmetic": "amdgpu.arithmetic",
        "async": "amdgpu.async",
        "buffer": "amdgpu.buffer",
        "compare": "amdgpu.compare",
        "config": "amdgpu.config",
        "dot": "amdgpu.dot",
        "integer": "amdgpu.integer",
        "reduce": "amdgpu.reduce",
        "sanitizer": "amdgpu.sanitizer",
        "view": "amdgpu.view",
    },
    generator = "//loom/py/loom/gen/target/contracts:amdgpu_contract_table_family",
)

loom_target_contract_cc_libraries(
    name = "arithmetic",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/target/arch/amdgpu/lower:kinds",
        "//loom/src/loom/target/arch/amdgpu/lower:materializers",
    ],
)

loom_target_contract_cc_libraries(
    name = "async",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/kernel",
    ],
)

loom_target_contract_cc_libraries(
    name = "buffer",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/buffer",
    ],
)

loom_target_contract_cc_libraries(
    name = "config",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/config",
    ],
)

loom_target_contract_cc_libraries(
    name = "compare",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/target/arch/amdgpu/lower:materializers",
    ],
)

loom_target_contract_cc_libraries(
    name = "dot",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/target/arch/amdgpu/lower:kinds",
    ],
)

loom_target_contract_cc_libraries(
    name = "integer",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/target/arch/amdgpu/lower:materializers",
    ],
)

loom_target_table_cc_library(
    name = "matrix",
    args = ["--contract-fragment=amdgpu.matrix"],
    generator = _AMDGPU_CONTRACT_FRAGMENT_GENERATOR,
    deps = ["//loom/src/loom/target:contract"],
)

loom_target_contract_cc_libraries(
    name = "reduce",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/target/arch/amdgpu/lower:kinds",
        "//loom/src/loom/target/arch/amdgpu/lower:materializers",
    ],
)

loom_target_contract_cc_libraries(
    name = "sanitizer",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/sanitizer",
    ],
)

loom_target_contract_cc_libraries(
    name = "view",
    contract_deps = ["//loom/src/loom/target:contract"],
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/view",
    ],
)

loom_cc_library(
    name = "contracts",
    hdrs = [
        "arithmetic.h",
        "arithmetic_lower_rules.h",
        "async.h",
        "async_lower_rules.h",
        "buffer.h",
        "buffer_lower_rules.h",
        "compare.h",
        "compare_lower_rules.h",
        "config.h",
        "config_lower_rules.h",
        "dot.h",
        "dot_lower_rules.h",
        "integer.h",
        "integer_lower_rules.h",
        "matrix.h",
        "reduce.h",
        "reduce_lower_rules.h",
        "sanitizer.h",
        "sanitizer_lower_rules.h",
        "view.h",
        "view_lower_rules.h",
    ],
    deps = [
        ":arithmetic",
        ":arithmetic_lower_rules",
        ":async",
        ":async_lower_rules",
        ":buffer",
        ":buffer_lower_rules",
        ":compare",
        ":compare_lower_rules",
        ":config",
        ":config_lower_rules",
        ":dot",
        ":dot_lower_rules",
        ":integer",
        ":integer_lower_rules",
        ":matrix",
        ":reduce",
        ":reduce_lower_rules",
        ":sanitizer",
        ":sanitizer_lower_rules",
        ":view",
        ":view_lower_rules",
    ],
)
