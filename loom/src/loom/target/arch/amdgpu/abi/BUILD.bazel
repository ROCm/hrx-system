load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_LOWER_VISIBILITY = ["//loom/src/loom/target/arch/amdgpu/lower:implementation"]

_AMDGPU_ARCH_VISIBILITY = ["//loom/src/loom/target/arch/amdgpu:__pkg__"]

_AMDGPU_NATIVE_VISIBILITY = ["//loom/src/loom/target/emit/native/amdgpu:__pkg__"]

_AMDGPU_PLANNING_VISIBILITY = ["//loom/src/loom/target/arch/amdgpu/planning:__pkg__"]

_AMDGPU_TOOLING_VISIBILITY = ["//loom/src/loom/tooling/target/amdgpu:__pkg__"]

loom_cc_library(
    name = "call_abi",
    srcs = ["call_abi.c"],
    hdrs = ["call_abi.h"],
    visibility = (
        _AMDGPU_ARCH_VISIBILITY +
        _AMDGPU_NATIVE_VISIBILITY +
        _AMDGPU_PLANNING_VISIBILITY
    ),
    deps = [
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low/allocation:call",
        "//loom/src/loom/ir",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/amdgpu/refs:target_refs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "call_abi_test",
    srcs = ["call_abi_test.cc"],
    deps = [
        ":call_abi",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/amdgpu/refs:target_refs",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "asan",
    hdrs = ["asan.h"],
    visibility = (
        _AMDGPU_ARCH_VISIBILITY +
        _AMDGPU_LOWER_VISIBILITY +
        _AMDGPU_NATIVE_VISIBILITY +
        _AMDGPU_TOOLING_VISIBILITY
    ),
)

loom_cc_library(
    name = "feedback",
    hdrs = ["feedback.h"],
    visibility = (
        _AMDGPU_ARCH_VISIBILITY +
        _AMDGPU_LOWER_VISIBILITY +
        _AMDGPU_NATIVE_VISIBILITY +
        _AMDGPU_TOOLING_VISIBILITY
    ),
)

loom_cc_test(
    name = "feedback_test",
    srcs = ["feedback_test.cc"],
    deps = [
        ":feedback",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "tsan",
    hdrs = ["tsan.h"],
    visibility = (
        _AMDGPU_ARCH_VISIBILITY +
        _AMDGPU_LOWER_VISIBILITY +
        _AMDGPU_NATIVE_VISIBILITY +
        _AMDGPU_TOOLING_VISIBILITY
    ),
)

loom_cc_test(
    name = "tsan_test",
    srcs = ["tsan_test.cc"],
    deps = [
        ":tsan",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "ubsan",
    hdrs = ["ubsan.h"],
    visibility = (
        _AMDGPU_LOWER_VISIBILITY +
        _AMDGPU_NATIVE_VISIBILITY +
        _AMDGPU_TOOLING_VISIBILITY
    ),
)

loom_cc_library(
    name = "signal",
    hdrs = ["signal.h"],
    visibility = (
        _AMDGPU_LOWER_VISIBILITY +
        _AMDGPU_NATIVE_VISIBILITY +
        _AMDGPU_TOOLING_VISIBILITY
    ),
)

loom_cc_test(
    name = "signal_test",
    srcs = ["signal_test.cc"],
    deps = [
        ":signal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

# The native runtime qualifies its wire consumer against compiler-owned layouts.
loom_cc_library(
    name = "test_headers",
    testonly = True,
    hdrs = [
        "asan.h",
        "feedback.h",
        "tsan.h",
        "ubsan.h",
    ],
    visibility = ["//runtime/src/iree/hal/driver/amd/gpu:__pkg__"],
)
