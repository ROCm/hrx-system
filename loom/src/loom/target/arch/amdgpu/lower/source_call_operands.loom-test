// RUN: pass specialize-target-callgraph,source-to-low

// Call planning must reject incompatible storage carriers even when the
// specialization pipeline has not separated callers by memory space.
amdgpu.target<gfx11-generic> @target

func.def noinline @write_value(%destination: buffer, %value: i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %destination[%origin] : buffer -> view<1xi32>
  view.store %value, %view[0] : i32, view<1xi32>
  func.return
}

kernel.def target(@target) @private() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: buffer) {
  %length = index.constant 4 : offset
  %temporary = buffer.alloca<private> align(4) %length : buffer
  %c42 = scalar.constant 42 : i32
  // ERROR@+1: TARGET/074 {callee_name="write_value", value_kind="operand", actual_type="reg<amdgpu.vgpr>", expected_type="reg<amdgpu.vgpr x2>"}
  func.call @write_value(%temporary, %c42) : (buffer, i32)
  %origin = index.constant 0 : offset
  %value_view = buffer.view %temporary[%origin] : buffer -> view<1xi32>
  %value = view.load %value_view[0] : view<1xi32> -> i32
  %output_view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %value, %output_view[0] : i32, view<1xi32>
  kernel.return
}

kernel.def target(@target) @external() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: buffer) {
  %c42 = scalar.constant 42 : i32
  func.call @write_value(%output, %c42) : (buffer, i32)
  kernel.return
}

// ====

// Null has a receiver-specific representation, not an integer extension.
amdgpu.target<gfx11-generic> @target

func.def noinline @is_null(%value: buffer) -> (i32) {
  %missing = buffer.compare.null %value : buffer
  %present = scalar.constant 0 : i32
  %absent = scalar.constant 1 : i32
  %result = scf.select %missing, %absent, %present : i32
  func.return %result : i32
}

kernel.def target(@target) @local_or_null() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %length = index.constant 4 : offset
  %local = buffer.alloca<private> align(4) %length : buffer
  %null = buffer.null : buffer
  %first = func.call @is_null(%local) : (buffer) -> (i32)
  %second = func.call @is_null(%null) : (buffer) -> (i32)
  %result = scalar.addi %first, %second : i32
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  kernel.return
}

// ----
amdgpu.target<gfx11-generic> @target

low.func.def noinline target<amdgpu.gfx11.generic.core> @is_null(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %18 = v_mov_b32 4294967295
  %missing = v_cmp_eq_i32 %18, %value
  %present = s_mov_b32 0
  %absent = s_mov_b32 1
  %result = v_cndmask_b32_src0_lit_src1_inline %missing {imm32 = 0, true_value = 1}
  return %result
}

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @local_or_null() asm {
  %view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %24 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %local = storage_address %24 : low.storage<private> -> reg<amdgpu.vgpr>
  %26 = s_mov_b32 0
  %null = concat(%26, %26) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %first = low.func.call @is_null(%local) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %29 = v_mov_b32 4294967295
  %second = low.func.call @is_null(%29) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %result = v_add_u32 %first, %second
  %32 = v_mov_b32 0
  global_store_b32_saddr %32, %result, %view
  return
}

// ====

// A direct call cannot supply the implicit resource table of an entry ABI.
// RUN: pass source-to-low
amdgpu.target<gfx11-generic> @target

func.def target(@target) @resource_entry(%storage: buffer, %value: i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<1xi32>
  view.store %value, %view[0] : i32, view<1xi32>
  func.return
}

func.def target(@target) @direct_caller(%storage: buffer, %value: i32) {
  // ERROR@+1: TARGET/073 {callee_name="resource_entry", value_kind="operand", actual_count="2", expected_count="1"}
  func.call @resource_entry(%storage, %value) : (buffer, i32)
  func.return
}
