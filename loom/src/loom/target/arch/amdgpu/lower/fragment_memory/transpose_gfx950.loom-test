// RUN: emit source-low output=low

amdgpu.target<gfx950> @target

kernel.def target(@target) @lds_row_major_rhs_transpose_load() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%lhs_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %storage_bytes = index.constant 1024 : offset
  %m = index.constant 16 : index
  %k = index.constant 32 : index
  %n = index.constant 16 : index
  %lhs_view = buffer.view %lhs_input[%base] : buffer -> view<16x32xbf16>
  %storage = buffer.alloca<workgroup> align(16) %storage_bytes : buffer
  %input_view = buffer.view %storage[%base] : buffer -> view<32x16xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<4xf32>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<16x32xbf16> -> vector<8xbf16>
  %rhs = vector.fragment.load<rhs> %input_view[0, 0] shape [%k, %n] : view<32x16xbf16> -> vector<8xbf16>
  %c0_scalar = scalar.constant 0.0 : f32
  %c0 = vector.splat %c0_scalar : vector<4xf32>
  %init = vector.fragment<init> %c0 shape [%m, %n] : vector<4xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<8xbf16>, vector<8xbf16>, vector<4xf32>
  vector.store %result, %output_view[0] : vector<4xf32>, view<4xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna4.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @lds_row_major_rhs_transpose_load() asm {
  %19 = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs_view = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %22 = storage {byte_alignment = 16, byte_length = 1024} : low.storage<workgroup>
  %23 = v_and_b32_src0_inline %19, 15
  %24 = v_lshlrev_b32_src0_inline %23, 6
  %25 = v_lshrrev_b32_src0_inline %19, 4
  %26 = v_lshl_add_u32_shift_imm %25, %24, 4
  %lhs = global_load_dwordx4_saddr %26, %lhs_view : reg<amdgpu.vgpr x4>
  %28 = v_lshlrev_b32_src0_inline %23, 3
  %29 = v_lshl_add_u32_shift_imm %25, %28, 8
  %30 = ds_read_b64_tr_b16 %29
  %31 = ds_read_b64_tr_b16 %29 {offset = 128}
  %rhs = concat(%30, %31) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %c0_scalar = v_mov_b32 0
  %init = concat(%c0_scalar, %c0_scalar, %c0_scalar, %c0_scalar) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %35 = copy %init : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x4>
  %result = v_mfma_f32_16x16x32_bf16 %lhs, %rhs, %35
  global_store_dwordx4_saddr %c0_scalar, %result, %output_view
  return
}
