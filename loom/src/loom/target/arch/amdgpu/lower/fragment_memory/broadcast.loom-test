} launch(%row_stride_input: index, %column_stride_input: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %row_stride = index.assume %row_stride_input [range(%row_stride_input, 0, 16)] : index
  %column_stride = index.assume %column_stride_input [range(%column_stride_input, 0, 16)] : index
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %binding = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %binding[%base] : buffer -> view<16x16xi8, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xi8>
  %value = vector.fragment.load<rhs> %source[0, 0] shape [%extent, %extent] : view<16x16xi8, %layout> -> vector<8xi8>
  vector.fragment.store<rhs> %value, %destination[0, 0] shape [%extent, %extent] : vector<8xi8>, view<16x16xi8>
  kernel.return
}

