load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_generated_file_family",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_LOWER_VISIBILITY = ["//loom/src/loom/target/arch/amdgpu/lower:__pkg__"]

loom_generated_file_family(
    name = "candidate_tables_gen",
    generator = "//loom/py/loom/gen/target/arch/amdgpu/lower/candidates:candidates",
    output_flags = [
        "--arithmetic-source",
        "--async-gather-source",
        "--atomic-source",
        "--compare-source",
        "--memory-candidate-ranges",
        "--memory-candidate-rows",
    ],
    outputs = [
        "arithmetic_candidates.c",
        "async_gather_candidates.c",
        "atomic_candidates.c",
        "compare_candidates.c",
        "memory_descriptor_candidate_ranges.inl",
        "memory_descriptor_candidates.inl",
    ],
    visibility = _AMDGPU_LOWER_VISIBILITY,
)

loom_cc_library(
    name = "candidate_tables",
    srcs = [
        ":arithmetic_candidates.c",
        ":async_gather_candidates.c",
        ":atomic_candidates.c",
        ":compare_candidates.c",
    ],
    hdrs = [
        "arithmetic_candidates.h",
        "async_gather_candidates.h",
        "atomic_candidates.h",
        "compare_candidates.h",
    ],
    visibility = _AMDGPU_LOWER_VISIBILITY,
    deps = [
        "//loom/src/loom/ops:atomic",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/target/arch/amdgpu/lower:kinds",
        "//loom/src/loom/target/arch/amdgpu/refs:target_refs",
        "//loom/src/loom/util:fact_table",
        "//runtime/src/iree/base",
    ],
)
