load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

package_group(
    name = "implementation",
    packages = [
        "//loom/src/loom/target/arch/amdgpu",
        "//loom/src/loom/target/arch/amdgpu/lower",
        "//loom/src/loom/target/arch/amdgpu/lower/candidates",
        "//loom/src/loom/target/arch/amdgpu/lower/encoding",
        "//loom/src/loom/target/arch/amdgpu/lower/fragment_memory",
        "//loom/src/loom/target/arch/amdgpu/lower/value",
    ],
)

_AMDGPU_ROOT_VISIBILITY = ["//loom/src/loom/target/arch/amdgpu:__pkg__"]

_AMDGPU_IMPLEMENTATION_VISIBILITY = ["//loom/src/loom/target/arch/amdgpu/lower:implementation"]

_AMDGPU_CONTRACT_VISIBILITY = [
    "//loom/src/loom/target/arch/amdgpu/contracts:__pkg__",
]

_AMDGPU_LOWER_TABLE_VISIBILITY = (
    _AMDGPU_IMPLEMENTATION_VISIBILITY +
    _AMDGPU_ROOT_VISIBILITY +
    _AMDGPU_CONTRACT_VISIBILITY
)

loom_cc_library(
    name = "kinds",
    hdrs = ["kinds.h"],
    visibility = _AMDGPU_LOWER_TABLE_VISIBILITY,
)

loom_cc_library(
    name = "materializers",
    hdrs = ["materializers.h"],
    visibility = _AMDGPU_CONTRACT_VISIBILITY + _AMDGPU_IMPLEMENTATION_VISIBILITY,
    deps = [
        ":kinds",
        "//loom/src/loom/codegen/low/lower",
    ],
)

exports_files(
    [
        "registry.c",
        "registry_tables.inl",
    ],
    visibility = ["//loom/py/loom/target/arch/amdgpu/contracts:__pkg__"],
)

