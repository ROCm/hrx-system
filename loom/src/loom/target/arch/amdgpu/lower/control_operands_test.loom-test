// A known packed width supplies no distribution proof.
func.def target(@target) @unknown_packed_argument(%value: vector<3xi16>) -> (vector<3xi16>) {
  // ERROR@+1: TARGET/074 {callee_name="scalar_payload", value_kind="operand", actual_type="reg<amdgpu.vgpr x2>", expected_type="reg<amdgpu.sgpr x2>"}
