amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @truth_identity(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  return %value
}

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "input"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @uniform_mask_argument(%input: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %positive = v_cmp_gt_f32_src1_inline %input {rhs = "f32_0_0"}
  %16 = s_mov_b64_exec_read
  %17, %18 = s_and_b64_scc %positive, %16
  %19 = s_mov_b32 0
  %20 = s_mov_b32 1
  %21 = s_cselect_b32 %20, %19, %18
  %word = low.func.call @truth_identity(%21) : (reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>)
  %23 = v_mov_b32_copy %word
  %24 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %24, %23, %view
  return
}

