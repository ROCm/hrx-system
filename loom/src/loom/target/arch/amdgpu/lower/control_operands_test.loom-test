low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "input"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @native_condition_arguments(%input: reg<amdgpu.sgpr>) asm {
  %view = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %positive = v_cmp_gt_f32_src1_inline %input {rhs = "f32_0_0"}
  %18 = s_mov_b64_exec_read
  %19, %20 = s_and_b64_scc %positive, %18
  %truth = low.func.call @condition_word(%20) : (reg<amdgpu.scc>) -> (reg<amdgpu.sgpr>)
  %22 = s_cmp_lg_i32_src1_inline %truth {rhs = 0}
  %word = low.func.call @condition_word(%22) : (reg<amdgpu.scc>) -> (reg<amdgpu.sgpr>)
  %24 = v_mov_b32_copy %word
  %25 = v_mov_b32 0
  global_store_b32_saddr %25, %24, %view
  return
}

