  %8 = slice %bounded[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = low.func.call @native_word(%8) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  return %result
}

