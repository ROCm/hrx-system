amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @truth_identity(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  return %value
}

low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "input"}, direct_arg_offsets = [0], direct_arg_parameter_indices = [0], direct_arg_sizes = [4], parameter_count = 2, resource_count = 1, resource_offsets = [8], resource_parameter_indices = [1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @inactive_mask_bits(%input: reg<amdgpu.sgpr>) asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %view = resource<hal_binding> {extent = 256, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %positive = v_cmp_gt_f32_src1_inline %input {rhs = "f32_0_0"}
  %participates = v_cmp_ne_i32_src1_inline %lane {rhs = 0}
  low.scf.if %participates {
    %21 = s_mov_b32 0
    %true = s_cmp_eq_i32 %21, %21
    %23 = s_mov_b64_exec_read
    %inverted = s_xor_b64 %positive, %23
    %25 = s_mov_b64_exec_read
    %26, %27 = s_and_b64_scc %inverted, %25
    %28 = s_mov_b32 0
    %29 = s_mov_b32 1
    %30 = s_cselect_b32 %29, %28, %27
    %word = low.func.call @truth_identity(%30) : (reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>)
    %32 = v_mov_b32_copy %word
    %33 = v_lshlrev_b32_src0_inline %lane, 2
    global_store_b32_saddr %33, %32, %view
  }
  return
}

// ====

// Both a uniform lane mask and a scalar truth value can feed an SCC receiver.
amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @condition_word(%condition: reg<amdgpu.scc>) -> (reg<amdgpu.sgpr>) asm {
  %false = s_mov_b32 0
  %true = s_mov_b32 1
  %word = s_cselect_b32 %true, %false, %condition
  return %word
}

kernel.def target(@target) @native_condition_arguments() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: f32, %output: buffer) {
  %threshold = scalar.constant 0.0 : f32
  %positive = scalar.cmpf ogt, %input, %threshold : f32
  %truth = low.invoke @condition_word(%positive) : (i1) -> (i1)
  %word = low.invoke @condition_word(%truth) : (i1) -> (i32)
  %origin = index.constant 0 : offset
  %position = index.constant 0 : index
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %word, %view[%position] : i32, view<1xi32>
  kernel.return
}

