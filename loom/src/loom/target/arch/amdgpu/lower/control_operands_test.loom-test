// The source ABI retains two words; a local proof admits the native word.
func.def target(@target) @bounded_native_argument(%input: index) -> (i32) where [range(%input, 0, 4294967296)] {
  %bounded = index.assume %input [range(%input, 0, 31)] : index
  %result = low.invoke @native_word(%bounded) : (index) -> (i32)
  func.return %result : i32
}

