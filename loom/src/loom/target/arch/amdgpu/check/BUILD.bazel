load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "bank_service",
    srcs = ["bank_service.c"],
    hdrs = ["bank_service.h"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
    ],
)

loom_cc_library(
    name = "occupancy",
    testonly = True,
    srcs = ["occupancy.c"],
    hdrs = ["occupancy.h"],
    deps = [
        "//loom/src/loom/target/arch/amdgpu/planning:occupancy",
        "//loom/src/loom/target/arch/amdgpu/planning:storage_lease",
        "//loom/src/loom/tools/loom-check:execute",
        "//loom/src/loom/tools/loom-check/test:native_provider",
        "//loom/src/loom/tools/loom-check/test/low:native_emit",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        ":bank_service",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "test_provider",
    testonly = True,
    srcs = ["test_provider.c"],
    hdrs = ["test_provider.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        ":occupancy",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)
