loom_cc_library(
    name = "compile_report_low",
    srcs = ["compile_report_low.c"],
    hdrs = ["compile_report_low.h"],
    deps = [
        ":compile_report",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low:diagnostics",
        "//loom/src/loom/codegen/low:frame",
        "//loom/src/loom/codegen/low:function",
        "//loom/src/loom/codegen/low:packet",
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/util:cfg_graph",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:math",
        "//runtime/src/iree/base",
    ],
)

