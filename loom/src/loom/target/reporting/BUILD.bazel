load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "artifact_manifest",
    srcs = ["artifact_manifest.c"],
    hdrs = ["artifact_manifest.h"],
    deps = [
        "//loom/src/loom/target:types",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "artifact_manifest_collect",
    srcs = ["artifact_manifest_collect.c"],
    hdrs = ["artifact_manifest_collect.h"],
    deps = [
        ":artifact_manifest",
        "//loom/src/loom/analysis:symbol_dependencies",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:entry_selection",
        "//loom/src/loom/target:types",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "compile_report",
    srcs = ["compile_report.c"],
    hdrs = ["compile_report.h"],
    deps = [
        "//loom/src/loom/codegen/low:planning_statistics",
        "//loom/src/loom/target:types",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "compile_report_format",
