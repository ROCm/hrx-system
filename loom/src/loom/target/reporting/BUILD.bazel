loom_cc_test(
    name = "compile_report_format_test",
    srcs = ["compile_report_format_test.cc"],
    deps = [
        ":compile_report_format",
        "//loom/src/loom/ir",
        "//loom/src/loom/target:math_policy",
        "//runtime/src/iree/testing:gtest",
