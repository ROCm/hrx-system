        "compile_report_format.c",
        "compile_report_format_json.c",
        "compile_report_format_text.c",
        "compile_report_schema.c",
        "compile_report_schema.h",
    ],
    hdrs = ["compile_report_format.h"],
    deps = [
        ":compile_report",
        ":compile_report_planning_format",
        "//loom/src/loom/ir",
        "//loom/src/loom/target:math_policy",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "compile_report_planning_format",
    srcs = ["compile_report_planning_format.c"],
    hdrs = ["compile_report_planning_format.h"],
