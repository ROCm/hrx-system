// Physical hardware-register reads retain the packed HWREG selector and
// native opcode across CDNA and RDNA encoding generations.
// RUN: emit amdgpu-assembly @hardware_register
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @hardware_register() -> (reg<amdgpu.sgpr>) asm {
  %identity = s_getreg_b32 {hwreg = 63492}
  return %identity
}

// ----
  s_getreg_b32 s0, 0xf804
  s_endpgm

// ====

// RUN: emit amdgpu-native-words @hardware_register
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @hardware_register() -> (reg<amdgpu.sgpr>) asm {
  %identity = s_getreg_b32 {hwreg = 63492}
  return %identity
}

// ----
0xB880F804
0xBF810000

// ====

