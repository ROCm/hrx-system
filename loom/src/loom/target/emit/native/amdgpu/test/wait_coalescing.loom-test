// Coalesced slices change virtual ownership without emitting instructions.
// Their result-release waits share one boundary and keep the strictest bound.
// RUN: emit amdgpu-assembly @tuple_slice_waits
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @tuple_slice_waits(%address: reg<amdgpu.vgpr>) asm {
  %first = ds_read_b128 %address
  %second = ds_read_b128 %address {offset = 16}
  %values = concat(%first, %second) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %left = slice %values[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %right = slice %values[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum = v_add_u32 %left, %right
  ds_write_b32 %address, %sum {offset = 32}
  return
}

// ----
  ds_read_b128 v[4:7], v0 offset:0
  ds_read_b128 v[8:11], v0 offset:16
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v1, v4, v8
  ds_write_b32 v0, v1 offset:32
  s_endpgm

// ====

// An intervening ALU instruction separates completion boundaries, preserving
// the partial wait before the first use and the full wait before the second.
// RUN: emit amdgpu-assembly @alu_separates_slice_waits
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @alu_separates_slice_waits(%address: reg<amdgpu.vgpr>) asm {
  %first = ds_read_b128 %address
  %second = ds_read_b128 %address {offset = 16}
  %left = slice %first[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %incremented = v_add_u32 %left, %address
  %right = slice %second[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %sum = v_add_u32 %incremented, %right
  ds_write_b32 %address, %sum {offset = 32}
  return
}

// ----
  ds_read_b128 v[4:7], v0 offset:0
  ds_read_b128 v[8:11], v0 offset:16
  s_waitcnt vmcnt(63) lgkmcnt(1)
  v_add_u32 v1, v4, v0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v1, v1, v8
  ds_write_b32 v0, v1 offset:32
  s_endpgm

// ====

// A fallthrough edge preserves pending reads until the successor's first
// hardware consumer, allowing the two reads to share one completion wait.
// RUN: emit amdgpu-assembly @block_entry_coalesces_reads
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @block_entry_coalesces_reads(%address: reg<amdgpu.vgpr>) asm {
  %first = ds_read_b128 %address
  %second = ds_read_b128 %address {offset = 16}
  %values = concat(%first, %second) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %left = slice %values[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  low.br ^finish
^finish:
  %right = slice %values[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum = v_add_u32 %left, %right
  ds_write_b32 %address, %sum {offset = 32}
  return
}

// ----
  ds_read_b128 v[4:7], v0 offset:0
  ds_read_b128 v[8:11], v0 offset:16
.Lbb1:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v1, v4, v8
  ds_write_b32 v0, v1 offset:32
  s_endpgm

// ====

// Authored waits keep their own insertion points and spelling. This loose
// bound cannot retire the remaining load or be folded into a planned wait.
// RUN: emit amdgpu-assembly @authored_wait_preserves_boundary
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @authored_wait_preserves_boundary(%address: reg<amdgpu.vgpr>) asm {
  %first = ds_read_b128 %address
  %second = ds_read_b128 %address {offset = 16}
  %values = concat(%first, %second) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %left = slice %values[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  s_waitcnt {lgkmcnt = 2}
  %right = slice %values[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum = v_add_u32 %left, %right
  ds_write_b32 %address, %sum {offset = 32}
  return
}

// ----
  ds_read_b128 v[4:7], v0 offset:0
  ds_read_b128 v[8:11], v0 offset:16
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v1, v4, v8
  s_waitcnt vmcnt(63) lgkmcnt(2)
  ds_write_b32 v0, v1 offset:32
  s_endpgm

// ====

// Different counters at a shared zero-work boundary can use one combined
// hardware wait without changing either logical completion requirement.
// RUN: emit amdgpu-assembly @mixed_counter_slices
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @mixed_counter_slices(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %local = ds_read_b128 %address
  %global = global_load_b128_saddr %address, %base
  %values = concat(%local, %global) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %left = slice %values[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %right = slice %values[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %sum = v_add_u32 %left, %right
  ds_write_b32 %address, %sum {offset = 32}
  return
}

// ----
  global_load_b128 v[12:15], v0, s[0:1] offset:0
  ds_read_b128 v[8:11], v0 offset:0
  s_waitcnt vmcnt(0) lgkmcnt(0)
  v_add_u32 v1, v8, v12
  ds_write_b32 v0, v1 offset:32
  s_endpgm

// ====

// Slices transfer pending storage ownership through free coalescing.
// The partial write still waits for the preserved bits from the global load.
// RUN: emit amdgpu-assembly @slice_continuation
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @slice_continuation(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b64_saddr %address, %input
  %sliced = slice %loaded[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %continued = ds_load_u16_d16_hi %sliced, %address
  %result = v_add_u32 %continued, %rhs
  return %result
}

// ----
  global_load_b64 v[2:3], v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_load_u16_d16_hi v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v2, v1
  s_endpgm

// ====

// The low register can stay live while a tied continuation updates the high
// register. Lease handoff follows that subrange, not whole-source deadness.
// RUN: emit amdgpu-assembly @slice_live_sibling
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @slice_live_sibling(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b64_saddr %address, %input
  %sliced = slice %loaded[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %continued = ds_load_u16_d16_hi %sliced, %address
  %sibling = slice %loaded[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_add_u32 %continued, %sibling
  return %result
}

// ----
  global_load_b64 v[2:3], v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_load_u16_d16_hi v3, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v3, v2
  s_endpgm

// ====

// A tied continuation can update one subrange after retiring the pending wide
// load without disturbing the other subrange.
// RUN: emit amdgpu-assembly @shifted_slice
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @shifted_slice(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b64_saddr %address, %input
  %sliced = slice %loaded[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %continued = ds_load_u16_d16_hi %sliced, %address
  %result = v_add_u32 %continued, %rhs
  return %result
}

// ----
  global_load_b64 v[2:3], v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_load_u16_d16_hi v3, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v3, v1
  s_endpgm

// ====

// Each concat input transfers its pending subrange into a wider identity. The
// aggregate neither materializes moves nor retires either load early.
// RUN: emit amdgpu-assembly @pending_concat
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @pending_concat(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>) asm {
  %first = global_load_b64_saddr %address, %input
  %second = global_load_b64_saddr %address, %input {offset = 8}
  %packed = concat(%first, %second) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %assumed = low.assume %packed [range(%packed, 0, 1024)] : reg<amdgpu.vgpr x4>
  ds_write_b128 %address, %assumed
  return
}

// ----
  global_load_b64 v[4:5], v0, s[0:1] offset:0
  global_load_b64 v[6:7], v0, s[0:1] offset:8
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_write_b128 v0, v[4:7] offset:0
  s_endpgm
