// RUN: emit amdgpu-native-words @subtract_gfx942

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @subtract_gfx942(%lhs_low: reg<amdgpu.sgpr>, %lhs_high: reg<amdgpu.sgpr>, %rhs_low: reg<amdgpu.sgpr>, %rhs_high: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %difference_low, %borrow = s_sub_co_u32 %lhs_low, %rhs_low
  %difference_high, %borrow_out = s_subb_u32 %lhs_high, %rhs_high, %borrow
  %negated_low, %negation_borrow = s_sub_co_u32_lhs_inline %lhs_low, 0
  %negated_high, %negation_borrow_out = s_subb_u32_lhs_inline %lhs_high, %negation_borrow, 0
  %decremented_low, %decrement_borrow = s_sub_co_u32_rhs_inline %rhs_low, 1
  %decremented_high, %decrement_borrow_out = s_subb_u32_rhs_inline %rhs_high, %decrement_borrow, 0
  return %difference_low, %difference_high, %negated_low, %negated_high, %decremented_low, %decremented_high
}

