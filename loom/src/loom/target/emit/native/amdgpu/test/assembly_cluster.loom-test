// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx1250> @target

low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) workgroup_size(64, 1, 1) cluster_size(2, 2, 2) @cluster_identity_abi() asm {
  %packed_local = live_in<amdgpu.cluster_workgroup_info> : reg<amdgpu.sgpr>
  %packed_cluster_yz = live_in<amdgpu.cluster_id_yz> : reg<amdgpu.sgpr>
  %cluster_x = live_in<amdgpu.cluster_id_x> : reg<amdgpu.sgpr>
  %local_x = s_and_b32_rhs_inline %packed_local, 15
  %workgroup_x = s_lshl1_add_u32 %cluster_x, %local_x
  %cluster_y = s_and_b32_lit %packed_cluster_yz, 65535
  %local_y = s_bfe_u32_lit %packed_local, 262148
  %workgroup_y = s_lshl1_add_u32 %cluster_y, %local_y
  %cluster_z = s_lshr_b32_rhs_inline %packed_cluster_yz, 16
  %local_z = s_bfe_u32_lit %packed_local, 262152
  %workgroup_z = s_lshl1_add_u32 %cluster_z, %local_z
  %flat_local = s_getreg_b32_cluster_workgroup_flat_id
  %sum0 = s_add_u32 %workgroup_x, %workgroup_y
  %sum1 = s_add_u32 %sum0, %workgroup_z
  %sum = s_add_u32 %sum1, %flat_local
  return
}

