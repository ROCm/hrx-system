// End-to-end replay-clause witnesses use ordinary allocation. Native
// clause-state tests cover exact target mode selection, physical aliasing,
// register-bank separation, and state transitions.

// The third load overwrites an address used before the immediately prior load.
// RUN: emit amdgpu-assembly @scalar_clause_history
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @scalar_clause_history(%left: reg<amdgpu.sgpr x2>, %middle: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %first = s_load_dword_offset_only %left
  %second = s_load_dword_offset_only %middle
  %third = s_load_dword_offset_only %right
  return %first, %second, %third
}

// ----
  s_load_dword s6, s[0:1], 0
  s_nop 0
  s_load_dword s0, s[2:3], 0
  s_load_dword s1, s[4:5], 0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// Only a concrete non-memory instruction separates a replayable clause.
// RUN: emit amdgpu-assembly @vector_alu_separator
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @vector_alu_separator(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  %separator = s_mov_b32 7
  %second = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  global_load_dword v0, v[0:1], off offset:0
  s_mov_b32 s0, 7
  global_load_dword v1, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Only a concrete non-memory instruction separates a replayable clause.
// RUN: emit amdgpu-assembly @vector_completion
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @vector_completion(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  s_waitcnt {vmcnt = 0}
  %second = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  global_load_dword v0, v[0:1], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  global_load_dword v1, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Only a concrete non-memory instruction separates a replayable clause.
// RUN: emit amdgpu-assembly @vector_elided_wait
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @vector_elided_wait(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  s_waitcnt {lgkmcnt = 0}
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  s_waitcnt {lgkmcnt = 0}
  %second = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  s_waitcnt vmcnt(63) lgkmcnt(0)
  global_load_dword v0, v[0:1], off offset:0
  s_nop 0
  global_load_dword v1, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Scalar and vector instructions terminate one another's replay clauses.
// RUN: emit amdgpu-assembly @mixed_memory_classes
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @mixed_memory_classes(%left: reg<amdgpu.vgpr x2>, %scalar: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  %middle = s_load_dword_offset_only %scalar
  %second = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %first, %middle, %second
}

// ----
  global_load_dword v0, v[0:1], off offset:0
  s_load_dword s2, s[0:1], 0
  global_load_dword v1, v[2:3], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(0)
  s_endpgm

// ====

// A store after a load definition starts a fresh replayable clause.
// RUN: emit amdgpu-assembly @load_then_store
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @load_then_store(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  global_store_dword_vaddr %right, %value
  return %loaded
}

// ----
  global_load_dword v0, v[0:1], off offset:0
  s_nop 0
  global_store_dword v[2:3], v4, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// A clause containing only stores has no register definitions to preserve.
// RUN: emit amdgpu-assembly @store_then_load
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @store_then_load(%left: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  global_store_dword_vaddr %left, %value
  %loaded = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  return %loaded
}

// ----
  global_store_dword v[0:1], v2, off offset:0
  global_load_dword v0, v[4:5], off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Descriptor-backed loads protect the vector offset used by an earlier load.
// RUN: emit amdgpu-assembly @buffer_address_overlap
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @buffer_address_overlap(%left: reg<amdgpu.vgpr>, %right: reg<amdgpu.vgpr>, %resource: reg<amdgpu.sgpr x4>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %first = buffer_load_dword_vaddr_offset %resource, %left : reg<amdgpu.vgpr>
  %second = buffer_load_dword_vaddr_offset %resource, %right : reg<amdgpu.vgpr>
  return %first, %second
}

// ----
  buffer_load_dword v0, v0, s[0:3], 0 offen offset:0
  s_nop 0
  buffer_load_dword v1, v1, s[0:3], 0 offen offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Branch instructions end the physical clause on both taken and untaken paths.
// RUN: emit amdgpu-assembly @branch_break
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @branch_break(%choose: reg<amdgpu.scc>, %left: reg<amdgpu.vgpr x2>, %middle: reg<amdgpu.vgpr x2>, %right: reg<amdgpu.vgpr x2>) asm {
  %first = global_load_dword_vaddr %left : reg<amdgpu.vgpr>
  low.cond_br %choose, ^left, ^right : reg<amdgpu.scc>
^left:
  %second = global_load_dword_vaddr %middle : reg<amdgpu.vgpr>
  low.br ^exit
^right:
  %third = global_load_dword_vaddr %right : reg<amdgpu.vgpr>
  low.br ^exit
^exit:
  return
}

// ----
  global_load_dword v0, v[0:1], off offset:0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  global_load_dword v0, v[2:3], off offset:0
  s_branch .Lbb3
.Lbb2:
  global_load_dword v0, v[4:5], off offset:0
.Lbb3:
  s_endpgm

// ====

// A coalesced slice has no instruction to separate the two scalar loads.
// RUN: emit amdgpu-assembly @scalar_slice
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @scalar_slice(%left: reg<amdgpu.sgpr x2>, %right: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) asm {
  %first = s_load_dwordx2_offset_only %left
  %view = slice %first[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %second = s_load_dwordx2_offset_only %right
  return %view, %second
}

// ----
  s_load_dwordx2 s[4:5], s[0:1], 0
  s_nop 0
  s_load_dwordx2 s[0:1], s[2:3], 0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm
