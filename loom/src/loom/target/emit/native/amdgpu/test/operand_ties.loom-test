// A live seed requires a preload into the independent FMAC destination.
// RUN: emit amdgpu-assembly @fmac
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @fmac(%seed: reg<amdgpu.vgpr>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %result = v_fmac_f32 %seed, %lhs, %rhs : reg<amdgpu.vgpr>
  return %seed, %result
}

// ----
  v_mov_b32 v3, v2
  v_fmac_f32 v3, v0, v1
  s_endpgm

// ====

// The copy can coalesce when the original seed has no later observer.
// RUN: emit amdgpu-assembly @fmac
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @fmac(%seed: reg<amdgpu.vgpr>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_fmac_f32 %seed, %lhs, %rhs : reg<amdgpu.vgpr>
  return %result
}

// ----
  v_fmac_f32 v0, v1, v2
  s_endpgm

// ====

// Scalar immediate updates use the same physical tie contract.
// RUN: emit amdgpu-assembly @scalar_update
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @scalar_update(%seed: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %result = s_addk_i32 %seed, 42 : reg<amdgpu.sgpr>
  %product = s_mulk_i32 %seed, -7 : reg<amdgpu.sgpr>
  return %seed, %result, %product
}

// ----
  s_mov_b32 s1, s0
  s_addk_i32 s1, 42
  s_mov_b32 s2, s0
  s_mulk_i32 s2, -7
  s_endpgm

// ====

// Literal selection continues after preserving a partial-write accumulator.
// RUN: pass low-select-operand-forms,low-dce
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @partial_literal_update(%seed: reg<amdgpu.vgpr>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %zero = v_mov_b32 0
  %result = v_fma_mixlo_f16_f32_f32_f32 %seed, %lhs, %rhs, %zero : reg<amdgpu.vgpr>
  return %seed, %result
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @partial_literal_update(%seed: reg<amdgpu.vgpr>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %seed_copy = copy %seed : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %result = v_fma_mixlo_f16_f32_f32_f32_src2_lit %seed_copy, %lhs, %rhs, 0
  return %seed, %result
}

// ====

// Facts survive ownership copies, including constants consumed by a new form.
// RUN: pass low-select-operand-forms,low-dce
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @independent_zero_accumulator(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %zero_lane = v_mov_b32 0
  %zero = concat(%zero_lane, %zero_lane, %zero_lane, %zero_lane, %zero_lane, %zero_lane, %zero_lane, %zero_lane) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %result = v_wmma_f32_16x16x16_f16 %lhs, %rhs, %zero : reg<amdgpu.vgpr x8>
  return %result
}

// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @independent_zero_accumulator(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %result = v_wmma_f32_16x16x16_f16_acc_zero %lhs, %rhs
  return %result
}

// ====

// An independent WMMA result cannot early-clobber its live matrix inputs.
// RUN: emit amdgpu-assembly @independent_wmma
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @independent_wmma(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %seed: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %result = v_wmma_f32_16x16x16_f16 %lhs, %rhs, %seed : reg<amdgpu.vgpr x8>
  return %result
}

// ----
  v_wmma_f32_16x16x16_f16 v[24:31], v[0:7], v[8:15], v[16:23]
  s_endpgm

// ====

// Packed floating dots have independent accumulator and destination fields.
// RUN: emit amdgpu-assembly @independent_dots
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @independent_dots(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %half = v_dot2_f32_f16 %lhs, %rhs, %seed : reg<amdgpu.vgpr>
  %bfloat = v_dot2_f32_bf16 %lhs, %rhs, %seed : reg<amdgpu.vgpr>
  return %seed, %half, %bfloat
}

// ----
  v_dot2_f32_f16 v3, v0, v1, v2
  v_dot2_f32_bf16 v4, v0, v1, v2
  s_endpgm

// ====

// Preferred ALU spellings also admit an explicitly independent result.
// RUN: emit amdgpu-assembly @independent_integer_arithmetic
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @independent_integer_arithmetic(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %sum = v_add_u32_rhs_tied %lhs, %rhs : reg<amdgpu.vgpr>
  %difference = v_sub_nc_u32_lhs_tied %lhs, %rhs : reg<amdgpu.vgpr>
  return %lhs, %rhs, %sum, %difference
}

// ----
  v_add_nc_u32 v2, v0, v1
  v_sub_nc_u32 v3, v0, v1
  s_endpgm
