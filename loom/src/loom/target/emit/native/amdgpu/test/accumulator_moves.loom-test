// The opcode, rather than an ACC selector, identifies each register bank.
// RUN: emit amdgpu-assembly @native_transfers strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @native_transfers(%vector: reg<amdgpu.vgpr>, %scalar: reg<amdgpu.sgpr>, %accumulator: reg<amdgpu.agpr>) -> (reg<amdgpu.agpr>, reg<amdgpu.agpr>, reg<amdgpu.vgpr>) asm {
  %from_vector = v_accvgpr_write_b32 %vector
  %from_scalar = v_accvgpr_write_b32 %scalar
  %from_accumulator = v_accvgpr_mov_b32 %accumulator
  %read = v_accvgpr_read_b32 %from_vector
  return %from_scalar, %from_accumulator, %read
}
// ----
  v_accvgpr_write_b32 acc1, v0
  v_accvgpr_write_b32 acc2, s0
  v_accvgpr_mov_b32 acc0, acc0
  v_accvgpr_read_b32 v0, acc1
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @inline_initialization strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @inline_initialization() -> (reg<amdgpu.agpr>, reg<amdgpu.agpr>, reg<amdgpu.agpr>, reg<amdgpu.agpr>, reg<amdgpu.agpr>) asm {
  %negative = v_accvgpr_write_b32_inline_i32 -16
  %minus_one = v_accvgpr_write_b32_inline_i32 -1
  %zero = v_accvgpr_write_b32_inline_i32 0
  %positive = v_accvgpr_write_b32_inline_i32 64
  %float = v_accvgpr_write_b32_inline_f32 "f32_n0_5"
  return %negative, %minus_one, %zero, %positive, %float
}
// ----
  v_accvgpr_write_b32 acc0, -16
  v_accvgpr_write_b32 acc1, -1
  v_accvgpr_write_b32 acc2, 0
  v_accvgpr_write_b32 acc3, 64
  v_accvgpr_write_b32 acc4, 3204448256
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @vector_to_accumulator strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @vector_to_accumulator(%source: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.agpr x4>) asm {
  %result = copy %source : reg<amdgpu.vgpr x4> -> reg<amdgpu.agpr x4>
  return %result
}
// ----
  v_accvgpr_write_b32 acc0, v0
  v_accvgpr_write_b32 acc1, v1
  v_accvgpr_write_b32 acc2, v2
  v_accvgpr_write_b32 acc3, v3
  s_endpgm

