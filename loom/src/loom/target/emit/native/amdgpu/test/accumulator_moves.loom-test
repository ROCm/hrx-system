// ====

// Backedge cycles use scratch in the same bank and preserve every tuple unit.
// RUN: emit amdgpu-assembly @loop_swap strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @loop_swap(%lhs: reg<amdgpu.agpr x2>, %rhs: reg<amdgpu.agpr x2>) -> (reg<amdgpu.agpr x2>, reg<amdgpu.agpr x2>) asm {
  %count = s_mov_b32 3
  %step = s_mov_b32 1
  %limit = s_mov_b32 0
  low.br ^loop(%lhs: reg<amdgpu.agpr x2>, %rhs: reg<amdgpu.agpr x2>, %count: reg<amdgpu.sgpr>)
^loop(%a: reg<amdgpu.agpr x2>, %b: reg<amdgpu.agpr x2>, %remaining: reg<amdgpu.sgpr>):
  %next = s_sub_u32 %remaining, %step
  %again = s_cmp_gt_u32 %next, %limit
  low.cond_br %again, ^back, ^exit : reg<amdgpu.scc>
^back:
  low.br ^loop(%b: reg<amdgpu.agpr x2>, %a: reg<amdgpu.agpr x2>, %next: reg<amdgpu.sgpr>)
^exit:
  return %a, %b
}
// ----
  s_mov_b32 s0, 3
  s_mov_b32 s1, 1
  s_mov_b32 s2, 0
.Lbb1:
  s_sub_u32 s0, s0, s1
  s_cmp_gt_u32 s0, s2
  s_cbranch_scc0 .Lbb3
.Lbb2:
  v_accvgpr_mov_b32 acc4, acc2
  v_accvgpr_mov_b32 acc2, acc0
  v_accvgpr_mov_b32 acc0, acc4
  v_accvgpr_mov_b32 acc4, acc3
  v_accvgpr_mov_b32 acc3, acc1
  v_accvgpr_mov_b32 acc1, acc4
  s_branch .Lbb1
.Lbb3:
  s_endpgm

// ====

// Physical moves observe the VALU-to-MFMA and MFMA-to-VALU windows.
// RUN: emit amdgpu-assembly @matrix_copy_windows strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @matrix_copy_windows(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr x4>, %offset: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %seed = copy %acc : reg<amdgpu.vgpr x4> -> reg<amdgpu.agpr x4>
  %matrix = v_mfma_f32_16x16x4f32 %lhs, %rhs, %seed
  %read = copy %matrix : reg<amdgpu.agpr x4> -> reg<amdgpu.vgpr x4>
  global_store_dwordx4_saddr %offset, %read, %base
  return
}
// ----
  v_accvgpr_write_b32 acc0, v0
  v_accvgpr_write_b32 acc1, v1
  v_accvgpr_write_b32 acc2, v2
  v_accvgpr_write_b32 acc3, v3
  s_nop 1
  v_mfma_f32_16x16x4f32 acc[0:3], v4, v5, acc[0:3]
  s_nop 10
  v_accvgpr_read_b32 v0, acc0
  v_accvgpr_read_b32 v1, acc1
  v_accvgpr_read_b32 v2, acc2
  v_accvgpr_read_b32 v3, acc3
  global_store_dwordx4 v6, v[0:3], s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// Writing the payload bank observes the store retention window.
// RUN: emit amdgpu-assembly @store_overwrite strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @store_overwrite(%payload: reg<amdgpu.agpr x4>, %source: reg<amdgpu.vgpr x4>, %offset: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.agpr x4>) asm {
  global_store_dwordx4_saddr %offset, %payload, %base
  %replacement = copy %source : reg<amdgpu.vgpr x4> -> reg<amdgpu.agpr x4>
  return %replacement
}
// ----
  global_store_dwordx4 v0, acc[0:3], s[0:1] offset:0
  s_nop 0
  v_accvgpr_write_b32 acc0, v4
  v_accvgpr_write_b32 acc1, v5
  v_accvgpr_write_b32 acc2, v6
  v_accvgpr_write_b32 acc3, v7
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// RUN: emit amdgpu-native-words @native_transfers strategy=source
amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @native_transfers(%vector: reg<amdgpu.vgpr>, %scalar: reg<amdgpu.sgpr>, %accumulator: reg<amdgpu.agpr>) -> (reg<amdgpu.agpr>, reg<amdgpu.agpr>, reg<amdgpu.vgpr>) asm {
  %from_vector = v_accvgpr_write_b32 %vector
  %from_scalar = v_accvgpr_write_b32 %scalar
  %from_accumulator = v_accvgpr_mov_b32 %accumulator
  %read = v_accvgpr_read_b32 %from_vector
  return %from_scalar, %from_accumulator, %read
}
// ----
0xD3D94001
0x18000100
0xD3D94002
0x18000000
0x7E00A500
0xD3D84000
0x18000101
0xBF810000

