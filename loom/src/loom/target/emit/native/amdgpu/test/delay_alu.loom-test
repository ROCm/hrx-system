// One native VOPD producer needs one hint across separate uses of its results.
// RUN: emit amdgpu-assembly @split_vopd_results strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @split_vopd_results(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %d: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %x = v_add_f32 %a, %b
  %y = v_mul_f32 %c, %d
  %s = v_readfirstlane_b32 %x
  %z = v_add_f32 %y, %y
  return %s, %z
}

// ----
  v_dual_add_f32 v0, v0, v1 :: v_dual_mul_f32 v3, v3, v2
  s_delay_alu instid0(VALU_DEP_1)
  v_readfirstlane_b32 s0, v0
  v_add_f32 v0, v3, v3
  s_endpgm

// ====

// Completing a VALU producer leaves the older independent VALU producer outstanding.
// RUN: emit amdgpu-assembly @independent_valu_producer strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @independent_valu_producer(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %d: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %older = v_readfirstlane_b32 %a
  %x = v_add_f32 %a, %b
  %y = v_mul_f32 %c, %d
  %s = v_readfirstlane_b32 %x
  %sum = s_add_u32 %older, %s
  %z = v_add_f32 %y, %y
  return %sum, %z
}

// ----
  v_readfirstlane_b32 s0, v0
  v_dual_add_f32 v0, v0, v1 :: v_dual_mul_f32 v3, v3, v2
  s_delay_alu instid0(VALU_DEP_1)
  v_readfirstlane_b32 s1, v0
  s_delay_alu instid0(VALU_DEP_1) | instid1(VALU_DEP_3)
  s_add_u32 s0, s0, s1
  v_add_f32 v0, v3, v3
  s_endpgm

// ====

// Both encoded selectors complete their producers, including unconsumed results.
// Intervening VALU issues advance the retained completion identities.
// RUN: emit amdgpu-assembly @two_vopd_producers strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @two_vopd_producers(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %d: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %x = v_add_f32 %a, %b
  %y = v_mul_f32 %c, %d
  %u = v_add_f32 %a, %b
  %v = v_mul_f32 %c, %d
  %first = v_add_f32 %x, %u
  %s = v_readfirstlane_b32 %first
  %z = v_add_f32 %y, %v
  return %s, %z
}

// ----
  v_dual_add_f32 v4, v0, v1 :: v_dual_mul_f32 v5, v3, v2
  v_dual_add_f32 v0, v0, v1 :: v_dual_mul_f32 v3, v3, v2
  s_delay_alu instid0(VALU_DEP_1) | instid1(VALU_DEP_2)
  v_add_f32 v0, v4, v0
  s_delay_alu instid0(VALU_DEP_1)
  v_readfirstlane_b32 s0, v0
  v_add_f32 v0, v5, v3
  s_endpgm

// ====

// A new memory-separated epoch must not reuse earlier completion bits.
// RUN: emit amdgpu-assembly @new_producer_epoch strategy=source

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @new_producer_epoch(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %d: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %x = v_add_f32 %a, %b
  %y = v_mul_f32 %c, %d
  %s = v_readfirstlane_b32 %x
  ds_write_b32 %a, %y
  %u = v_add_f32 %a, %b
  %v = v_mul_f32 %c, %d
  %t = v_readfirstlane_b32 %u
  %z = v_add_f32 %v, %v
  return %s, %t, %z
}

// ----
  v_dual_add_f32 v4, v0, v1 :: v_dual_mul_f32 v5, v3, v2
  s_delay_alu instid0(VALU_DEP_1) | instskip(SKIP_2) | instid1(VALU_DEP_1)
  v_readfirstlane_b32 s0, v4
  ds_write_b32 v0, v5 offset:0
  v_dual_add_f32 v0, v0, v1 :: v_dual_mul_f32 v3, v3, v2
  v_readfirstlane_b32 s1, v0
  v_add_f32 v0, v3, v3
  s_endpgm
