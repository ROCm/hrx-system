// ====

// A 64-bit VALU shift must not read its VGPR amount from the last register of
// an eight-VGPR allocation block (MI200 erratum), so the amount is even-aligned.
// RUN: emit amdgpu-assembly @divergent_shift64 strategy=source

amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @divergent_shift64(%value: reg<amdgpu.vgpr x2>, %bias: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>) asm {
  %amount = v_add_u32 %bias, %bias
  %shifted = v_lshlrev_b64 %amount, %value
  return %shifted, %bias
}

// ----
  v_add_u32 v4, v2, v2
  v_lshlrev_b64 v[0:1], v4, v[0:1]
  s_endpgm

// ====

// XNACK replay is not yet qualified for CDNA2 allocation and scheduling, so an
// XNACK-on code object is rejected before native emission.
// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx90a> @target {features = [xnack]}

// ERROR@+1: AMDGPU/052 {function_name="xnack_on", target_key="gfx90a:xnack+", processor="gfx90a", feature="xnack+"}
low.kernel.def target<amdgpu.cdna2.core>(@target) workgroup_size(64, 1, 1) @xnack_on() asm {
  %value = v_mov_b32 7
  return
}
