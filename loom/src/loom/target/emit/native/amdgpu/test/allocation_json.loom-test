// Ordinary VMEM stores consume VGPR address and payload operands at issue, so
// successive payload values can reuse a physical register while stores remain
// outstanding. The scalar resource retains its separately modeled lease.
// RUN: emit amdgpu-allocation-json @gfx11_allocation_json_global_store_vgpr_sources_issue_consumed strategy=source
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_allocation_json_global_store_vgpr_sources_issue_consumed(%addr: reg<amdgpu.vgpr>, %view: reg<amdgpu.sgpr x2>) asm {
  %value0 = v_mov_b32 1
  global_store_b32_saddr %addr, %value0, %view
  %value1 = v_mov_b32 2
  global_store_b32_saddr %addr, %value1, %view {offset = 4}
  return
}

