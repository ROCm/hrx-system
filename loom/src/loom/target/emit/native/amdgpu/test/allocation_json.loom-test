amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_allocation_json_global_store_saddr_source_reuse(%addr: reg<amdgpu.vgpr>, %store_base: reg<amdgpu.sgpr x2>, %keep: reg<amdgpu.sgpr x2>, %value: reg<amdgpu.vgpr>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  global_store_b32_saddr %addr, %value, %store_base
  %mask = v_cmp_lt_i32 %lhs, %rhs
  %saved_exec, %active = s_and_saveexec_b64 %mask
  return %keep
}

