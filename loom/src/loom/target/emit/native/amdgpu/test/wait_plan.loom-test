// RUN: emit amdgpu-wait-counter-plan-json @gfx11_multi_counter_consumer_wait strategy=source fixed=%loaded:physical_register:0:1 fixed=%trans:physical_register:1:1 fixed=%result:physical_register:2:1
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_multi_counter_consumer_wait(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>, %input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %loaded = buffer_load_dword %resource, %address, %offset
  %trans = v_exp_f32 %input
  %result = v_add_f32 %trans, %loaded
  return %result
}

