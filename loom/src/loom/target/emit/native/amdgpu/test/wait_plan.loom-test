// RUN: emit amdgpu-wait-counter-plan-json @gfx11_explicit_smem_wait strategy=source
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_explicit_smem_wait(%kernarg: reg<amdgpu.sgpr x2>, %soffset: reg<amdgpu.sgpr>, %lhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = s_load_dword %kernarg, %soffset
  s_waitcnt {lgkmcnt = 0}
  %sum = s_add_u32 %loaded, %lhs
  return %sum
}

// lgkmcnt drains LDS and SMEM on gfx11; the implicit vmcnt default remains a
// no-wait and must not reset VMEM progress.
