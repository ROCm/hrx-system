// ====

// Locked packets keep separate issue positions even with pair-compatible
// opcodes and physical registers.
// RUN: emit amdgpu-assembly @gfx11_locked_minmax strategy=source fixed=%lhs0:physical_register:0:1 fixed=%rhs0:physical_register:1:1 fixed=%lhs1:physical_register:2:1 fixed=%rhs1:physical_register:3:1 fixed=%min0:physical_register:4:1 fixed=%min1:physical_register:5:1 fixed=%max0:physical_register:6:1 fixed=%max1:physical_register:7:1
amdgpu.target<gfx1100> @target

low.func.def schedule(locked) target<amdgpu.rdna3.core>(@target) @gfx11_locked_minmax(%lhs0: reg<amdgpu.vgpr>, %rhs0: reg<amdgpu.vgpr>, %lhs1: reg<amdgpu.vgpr>, %rhs1: reg<amdgpu.vgpr>) asm {
  %min0 = v_min_f32 %lhs0, %rhs0
  %min1 = v_min_f32 %lhs1, %rhs1
  %max0 = v_max_f32 %lhs0, %rhs0
  %max1 = v_max_f32 %lhs1, %rhs1
  return
}

// ----
  v_min_f32 v4, v0, v1
  v_min_f32 v5, v2, v3
  v_max_f32 v6, v0, v1
  v_max_f32 v7, v2, v3
  s_endpgm

// ====

// A range fence separates the minimum packets. Packets after the fence
// remain eligible to share one issue slot.
// RUN: emit amdgpu-assembly @gfx11_fenced_minmax strategy=source fixed=%lhs0:physical_register:0:1 fixed=%rhs0:physical_register:1:1 fixed=%lhs1:physical_register:2:1 fixed=%rhs1:physical_register:3:1 fixed=%min0:physical_register:4:1 fixed=%min1:physical_register:5:1 fixed=%max0:physical_register:6:1 fixed=%max1:physical_register:7:1
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @gfx11_fenced_minmax(%lhs0: reg<amdgpu.vgpr>, %rhs0: reg<amdgpu.vgpr>, %lhs1: reg<amdgpu.vgpr>, %rhs1: reg<amdgpu.vgpr>) asm {
  %min0 = v_min_f32 %lhs0, %rhs0
  low.schedule.fence
  %min1 = v_min_f32 %lhs1, %rhs1
  %max0 = v_max_f32 %lhs0, %rhs0
  %max1 = v_max_f32 %lhs1, %rhs1
  return
}

// ----
  v_min_f32 v4, v0, v1
  v_dual_min_f32 v5, v2, v3 :: v_dual_max_f32 v6, v0, v1
  v_max_f32 v7, v2, v3
  s_endpgm

// ====

// VOPD packing cannot combine instructions across a scoped phase boundary.
// RUN: emit amdgpu-assembly @gfx11_scoped_minmax strategy=source fixed=%lhs0:physical_register:0:1 fixed=%rhs0:physical_register:1:1 fixed=%lhs1:physical_register:2:1 fixed=%rhs1:physical_register:3:1 fixed=%min0:physical_register:4:1 fixed=%min1:physical_register:5:1 fixed=%max0:physical_register:6:1 fixed=%max1:physical_register:7:1
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @gfx11_scoped_minmax(%lhs0: reg<amdgpu.vgpr>, %rhs0: reg<amdgpu.vgpr>, %lhs1: reg<amdgpu.vgpr>, %rhs1: reg<amdgpu.vgpr>) asm {
  low.schedule.begin
  %min0 = v_min_f32 %lhs0, %rhs0
  low.schedule.phase
  %min1 = v_min_f32 %lhs1, %rhs1
  %max0 = v_max_f32 %lhs0, %rhs0
  %max1 = v_max_f32 %lhs1, %rhs1
  low.schedule.end
  return
}

// ----
  v_min_f32 v4, v0, v1
  v_dual_min_f32 v5, v2, v3 :: v_dual_max_f32 v6, v0, v1
  v_max_f32 v7, v2, v3
  s_endpgm
