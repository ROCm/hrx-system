// The shift count is the last VGPR in an eight-register allocation block.
// CDNA reserves its neighbor without changing operand placement. RDNA needs
// no extra allocation. Each case covers left, logical-right and signed-right.
// RUN: emit amdgpu-kernel-assembly
amdgpu.target<gfx90a> @target

low.kernel.def schedule(locked) target<amdgpu.cdna2.core>(@target) workgroup_size(64, 1, 1) @shift_boundary() asm {
  %a0 = v_mov_b32 1
  %a1 = v_mov_b32 2
  %b0 = v_mov_b32 3
  %b1 = v_mov_b32 4
  %c0 = v_mov_b32 5
  %c1 = v_mov_b32 6
  %extra = v_mov_b32 7
  %count = v_mov_b32 31
  %left = concat(%a0, %a1) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %right = concat(%b0, %b1) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %signed = concat(%c0, %c1) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %shifted_left = v_lshlrev_b64 %count, %left
  %shifted_right = v_lshrrev_b64 %count, %right
  %shifted_signed = v_ashrrev_i64 %count, %signed
  %used = v_xor_b32 %extra, %count
  return
}


