// Required constants and scratch addresses have a sole arithmetic or memory
// consumer, plus a later EXEC writer. Recover their setup ownership before
// cloning the pressure frontier; both partial reloads fit in eight VGPRs.
// RUN: emit amdgpu-assembly @partial_reload_setup amdgpu.vgpr=8
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @partial_reload_setup(%input: reg<amdgpu.vgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
  %saved = s_mov_b64_exec_read
  %storage = storage {byte_alignment = 8, byte_length = 16} : low.storage<private>
  low.spill %input, %storage : reg<amdgpu.vgpr x2>, low.storage<private>
  low.spill %input, %storage {offset = 8} : reg<amdgpu.vgpr x2>, low.storage<private>
  %loaded0 = low.reload %storage : low.storage<private> -> reg<amdgpu.vgpr x2>
  %product0 = v_mul_f64 %loaded0, %input
  %scaled0 = v_mul_f64 %product0, %input
  %low0 = v_mov_b32 305419896
  %high0 = v_mov_b32 1072693248
  %constant0 = concat(%low0, %high0) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %partial0 = slice %loaded0[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %value0 = v_fma_f64 %scaled0, %input, %constant0
  %offset0 = v_mov_b32 0
  global_store_dwordx2_saddr %offset0, %value0, %output
  %partial_offset0 = v_mov_b32 16
  global_store_dword_saddr %partial_offset0, %partial0, %output
  %loaded1 = low.reload %storage {offset = 8} : low.storage<private> -> reg<amdgpu.vgpr x2>
  %product1 = v_mul_f64 %loaded1, %input
  %scaled1 = v_mul_f64 %product1, %input
  %low1 = v_mov_b32 305419897
  %high1 = v_mov_b32 1072693249
  %constant1 = concat(%low1, %high1) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %partial1 = slice %loaded1[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %value1 = v_fma_f64 %scaled1, %input, %constant1
  %offset1 = v_mov_b32 8
  global_store_dwordx2_saddr %offset1, %value1, %output
  %partial_offset1 = v_mov_b32 20
  global_store_dword_saddr %partial_offset1, %partial1, %output
  s_mov_b64_exec %saved
  return
}

