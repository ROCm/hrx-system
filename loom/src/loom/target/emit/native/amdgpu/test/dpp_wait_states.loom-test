// RUN: emit amdgpu-wait-state-plan @dpp_arithmetic_chain

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dpp_arithmetic_chain(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %value = v_add_f32 %lhs, %rhs
  %sum = v_add_f32_dpp %value, %value {dpp_ctrl = 177}
  %product = v_mul_f32_dpp %sum, %sum {dpp_ctrl = 78}
  %minimum = v_min_f32_dpp %product, %product {dpp_ctrl = 321}
  %maximum = v_max_f32_dpp %minimum, %minimum {dpp_ctrl = 320}
  return %maximum
}

