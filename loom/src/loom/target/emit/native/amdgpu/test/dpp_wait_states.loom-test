// RUN: emit amdgpu-assembly @dpp_arithmetic_chain

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dpp_arithmetic_chain(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %value = v_add_f32 %lhs, %rhs
  %sum = v_add_f32_dpp %value, %value {dpp_ctrl = 177}
  %product = v_mul_f32_dpp %sum, %sum {dpp_ctrl = 78}
  %minimum = v_min_f32_dpp %product, %product {dpp_ctrl = 321}
  %maximum = v_max_f32_dpp %minimum, %minimum {dpp_ctrl = 320}
  return %maximum
}

// ----
  v_add_f32 v0, v0, v1
  s_nop 1
  v_add_f32_dpp v0, v0, v0, quad_perm:[1,0,3,2], row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_nop 1
  v_mul_f32_dpp v0, v0, v0, quad_perm:[2,3,0,1], row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_nop 1
  v_min_f32_dpp v0, v0, v0, row_half_mirror, row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_nop 1
  v_max_f32_dpp v0, v0, v0, row_mirror, row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_endpgm

// ====

// RUN: emit amdgpu-wait-state-plan @dpp_observed_progress

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dpp_observed_progress(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %value = v_add_f32 %lhs, %rhs
  %independent = v_add_f32 %rhs, %rhs
  %shifted = v_add_f32_dpp %value, %value {dpp_ctrl = 177}
  %result = v_add_f32 %shifted, %independent
  return %result
}

