// RUN: emit amdgpu-wait-state-plan @dpp_sufficient_progress

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dpp_sufficient_progress(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %value = v_add_f32 %lhs, %rhs
  %first = v_add_f32 %rhs, %rhs
  %second = v_add_f32 %first, %rhs
  %shifted = v_add_f32_dpp %value, %value {dpp_ctrl = 177}
  %result = v_add_f32 %shifted, %second
  return %result
}

