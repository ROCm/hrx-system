// A 64-bit aperture read supplies the high address word. The low word is zero;
// a 32-bit move from the same inline source cannot construct a flat LDS pointer.
// RUN: emit amdgpu-native-words @shared_base_gfx942

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @shared_base_gfx942() -> (reg<amdgpu.sgpr>) asm {
  %aperture = s_mov_b64_shared_base
  %upper = slice %aperture[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  return %upper
}

// ----
0xBE8001EB
0xBF810000

