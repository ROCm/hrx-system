// ====
// RUN: emit amdgpu-assembly @bf16_dot_forwarding strategy=source
amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @bf16_dot_forwarding(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %first = v_dot2_f32_bf16 %lhs, %rhs, %acc
  %second = v_dot2_f32_bf16 %lhs, %rhs, %first
  %value = v_add_f32 %second, %lhs
  return %value
}
// ----
  v_dot2_f32_bf16 v0, v2, v1, v0
  v_dot2_f32_bf16 v0, v2, v1, v0
  s_nop 2
  v_add_f32 v0, v0, v2
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @dot_memory_consumer strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @dot_memory_consumer(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>, %offset: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %value = v_dot4_i32_i8 %lhs, %rhs, %acc
  global_store_dword_saddr %offset, %value, %base
  return
}
// ----
  v_dot4_i32_i8 v0, v0, v1, v2
  s_nop 2
  global_store_dword v3, v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @dot_matrix_interlock strategy=source
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dot_matrix_interlock(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>, %matrix_acc: reg<amdgpu.vgpr x4>) asm {
  %value = v_dot2_f32_f16 %lhs, %rhs, %acc
  %matrix = v_mfma_f32_16x16x4_f32 %value, %rhs, %matrix_acc
  return
}
// ----
  v_dot2_f32_f16 v1, v0, v2, v1
  v_mfma_f32_16x16x4_f32 v[4:7], v1, v2, v[4:7]
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @fallthrough_dot_read strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @fallthrough_dot_read(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %dot = v_dot2_f32_f16 %lhs, %rhs, %acc
  low.br ^empty
^empty:
  low.br ^next
^next:
  %value = v_add_f32 %dot, %lhs
  return %value
}
// ----
  v_dot2_f32_f16 v1, v2, v0, v1
.Lbb1:
.Lbb2:
  s_nop 2
  v_add_f32 v0, v1, v2
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @join_preserves_opcode_identity strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @join_preserves_opcode_identity(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %choice: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %condition = s_cmp_lt_u32 %zero, %choice
  low.cond_br %condition, ^left, ^right : reg<amdgpu.scc>
^left:
  %left = v_dot4_i32_i8 %lhs, %rhs, %initial
  low.br ^join(%left: reg<amdgpu.vgpr>)
^right:
  %right = v_dot8_i32_i4 %lhs, %rhs, %initial
  low.br ^join(%right: reg<amdgpu.vgpr>)
^join(%incoming: reg<amdgpu.vgpr>):
  %result = v_dot4_i32_i8 %lhs, %rhs, %incoming
  return %result
}
// ----
  s_mov_b32 s1, 0
  s_cmp_lt_u32 s1, s0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  v_dot4_i32_i8 v0, v1, v2, v0
  s_branch .Lbb3
.Lbb2:
  v_dot8_i32_i4 v0, v1, v2, v0
.Lbb3:
  s_nop 2
  v_dot4_i32_i8 v0, v1, v2, v0
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @loop_dot_operand_read strategy=source
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @loop_dot_operand_read(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr>, %choice: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %condition = s_cmp_lt_u32 %zero, %choice
  low.br ^loop(%initial: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>):
  %next = v_dot4_i32_i8 %carried, %rhs, %lhs
  low.cond_br %condition, ^again, ^exit : reg<amdgpu.scc>
^again:
  low.br ^loop(%next: reg<amdgpu.vgpr>)
^exit:
  return %next
}
// ----
  s_mov_b32 s1, 0
  s_cmp_lt_u32 s1, s0
.Lbb1:
  s_nop 0
  v_dot4_i32_i8 v0, v0, v2, v1
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_branch .Lbb1
.Lbb3:
  s_endpgm
