amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @matching_native_dot_overwrite(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc0: reg<amdgpu.vgpr>, %acc1: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %first = v_dot4_i32_i8 %lhs, %rhs, %acc0
  %second = v_dot4_i32_i8 %lhs, %rhs, %acc1
  return %second
}
// ----
  v_dot4_i32_i8 v0, v1, v2, v0
  v_dot4_i32_i8 v0, v1, v2, v3
  s_endpgm

