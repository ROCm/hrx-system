low.func.def target<amdgpu.cdna2.core>(@target) @distinct_dot_accumulator(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %first = v_dot4_i32_i8 %lhs, %rhs, %acc
