// RUN: emit amdgpu-assembly @dot_forward_accumulator strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @dot_forward_accumulator(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>, %other_acc: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %dot = v_dot2_f32_f16 %lhs, %rhs, %acc
  %value = v_dot2_f32_f16 %lhs, %rhs, %dot
  return %value
}
// ----
  v_dot2_f32_f16 v0, v1, v2, v0
  v_dot2_f32_f16 v0, v1, v2, v0
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @dot_read_input strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @dot_read_input(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>, %other_acc: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %dot = v_dot2_f32_f16 %lhs, %rhs, %acc
  %value = v_dot2_f32_f16 %dot, %rhs, %other_acc
  return %value
}
// ----
  v_dot2_f32_f16 v1, v0, v2, v1
  s_nop 2
  v_dot2_f32_f16 v3, v1, v2, v3
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @dot_read_other strategy=source
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dot_read_other(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr>, %other_acc: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %dot = v_dot2_f32_f16 %lhs, %rhs, %acc
  %value = v_add_f32 %dot, %lhs
  return %value
}
// ----
  v_dot2_f32_f16 v1, v2, v0, v1
  s_nop 2
  v_add_f32 v0, v1, v2
  s_endpgm

// ====

// A generic write cannot reuse a pending dot destination before its write
// window closes. Keeping the multiplicands live makes ordinary allocation
// place the replacement in the dead accumulator storage.
// RUN: emit amdgpu-assembly @dot_result_reuse strategy=source
amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @dot_result_reuse(%acc: reg<amdgpu.vgpr>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %dot = v_dot2_f32_f16 %lhs, %rhs, %acc
  %value = v_mov_b32 42
  return %value, %lhs, %rhs
}

// ----
  v_dot2_f32_f16 v0, v1, v2, v0
  s_nop 2
  v_mov_b32 v0, 42
  s_endpgm

