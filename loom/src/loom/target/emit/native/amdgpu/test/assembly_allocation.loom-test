// RUN: emit amdgpu-assembly @d16_concat_reserves_past_addresses waits=none

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3_5.core>(@target) @d16_concat_reserves_past_addresses(%base: reg<amdgpu.vgpr>, %stride: reg<amdgpu.vgpr>) asm {
  %address0 = v_add_u32 %base, %stride
  %low0 = ds_load_u16_d16 %address0
  %full0 = ds_load_u16_d16_hi %low0, %address0 {offset = 2}
  %address1 = v_add_u32 %address0, %stride
  %low1 = ds_load_u16_d16 %address1
  %full1 = ds_load_u16_d16_hi %low1, %address1 {offset = 2}
  %address2 = v_add_u32 %address1, %stride
  %low2 = ds_load_u16_d16 %address2
  %full2 = ds_load_u16_d16_hi %low2, %address2 {offset = 2}
  %address3 = v_add_u32 %address2, %stride
  %low3 = ds_load_u16_d16 %address3
  %full3 = ds_load_u16_d16_hi %low3, %address3 {offset = 2}
  %packed = concat(%full0, %full1, %full2, %full3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %packed0 = slice %packed[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %packed1 = slice %packed[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %packed2 = slice %packed[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %packed3 = slice %packed[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  ds_write_b32 %base, %packed0 {offset = 64}
  ds_write_b32 %base, %packed1 {offset = 68}
  ds_write_b32 %base, %packed2 {offset = 72}
  ds_write_b32 %base, %packed3 {offset = 76}
  return
}

// ----
  v_add_u32 v2, v1, v0
  ds_load_u16_d16 v4, v2 offset:0
  v_add_u32 v3, v2, v0
  ds_load_u16_d16 v5, v3 offset:0
  v_add_u32 v8, v3, v0
  ds_load_u16_d16 v6, v8 offset:0
  v_add_u32 v0, v8, v0
  ds_load_u16_d16 v7, v0 offset:0
  ds_load_u16_d16_hi v4, v2 offset:2
  ds_load_u16_d16_hi v5, v3 offset:2
  ds_load_u16_d16_hi v6, v8 offset:2
  ds_load_u16_d16_hi v7, v0 offset:2
  ds_write_b32 v1, v4 offset:64
  ds_write_b32 v1, v5 offset:68
  ds_write_b32 v1, v6 offset:72
  ds_write_b32 v1, v7 offset:76
  s_endpgm

