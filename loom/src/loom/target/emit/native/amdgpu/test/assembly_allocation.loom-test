// RUN: emit amdgpu-assembly @concat_reservation_preserves_residency strategy=source fixed=%pressure:physical_register:0:47 fixed=%address:physical_register:47:1 fixed=%output:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 64}

// The live inputs occupy v0:v47. Reserving v48:v55 for the concat has the
// same gfx1151 residency as placing its first source at v48:v51, so the
// interleaved blocker moves above the reservation and both sources remain
// directly assembled without repair moves.
low.func.def target<amdgpu.rdna3_5.core>(@target) @concat_reservation_preserves_residency(%pressure: reg<amdgpu.vgpr x47>, %address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %first = ds_read_b128 %address
  %blocker = ds_read_b128 %address {offset = 16}
  %second = ds_read_b128 %address {offset = 32}
  %packed = concat(%first, %second) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %packed0 = slice %packed[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %blocker0 = slice %blocker[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %address, %packed0, %output
  global_store_b32_saddr %address, %blocker0, %output {offset = 4}
  %pressure0 = slice %pressure[0] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure1 = slice %pressure[4] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure2 = slice %pressure[8] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure3 = slice %pressure[12] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure4 = slice %pressure[16] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure5 = slice %pressure[20] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure6 = slice %pressure[24] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure7 = slice %pressure[28] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure8 = slice %pressure[32] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure9 = slice %pressure[36] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure10 = slice %pressure[40] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr x4>
  %pressure11 = slice %pressure[44] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr>
  %pressure12 = slice %pressure[45] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr>
  %pressure13 = slice %pressure[46] : reg<amdgpu.vgpr x47> -> reg<amdgpu.vgpr>
  global_store_b128_saddr %address, %pressure0, %output {offset = 16}
  global_store_b128_saddr %address, %pressure1, %output {offset = 32}
  global_store_b128_saddr %address, %pressure2, %output {offset = 48}
  global_store_b128_saddr %address, %pressure3, %output {offset = 64}
  global_store_b128_saddr %address, %pressure4, %output {offset = 80}
  global_store_b128_saddr %address, %pressure5, %output {offset = 96}
  global_store_b128_saddr %address, %pressure6, %output {offset = 112}
  global_store_b128_saddr %address, %pressure7, %output {offset = 128}
  global_store_b128_saddr %address, %pressure8, %output {offset = 144}
  global_store_b128_saddr %address, %pressure9, %output {offset = 160}
  global_store_b128_saddr %address, %pressure10, %output {offset = 176}
  global_store_b32_saddr %address, %pressure11, %output {offset = 192}
  global_store_b32_saddr %address, %pressure12, %output {offset = 196}
  global_store_b32_saddr %address, %pressure13, %output {offset = 200}
  return
}

// ----
  ds_read_b128 v[48:51], v47 offset:0
  ds_read_b128 v[56:59], v47 offset:16
  ds_read_b128 v[52:55], v47 offset:32
  s_waitcnt vmcnt(63) lgkmcnt(2)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  global_store_b32 v47, v48, s[0:1] offset:0
  global_store_b32 v47, v56, s[0:1] offset:4
  global_store_b128 v47, v[0:3], s[0:1] offset:16
  global_store_b128 v47, v[4:7], s[0:1] offset:32
  global_store_b128 v47, v[8:11], s[0:1] offset:48
  global_store_b128 v47, v[12:15], s[0:1] offset:64
  global_store_b128 v47, v[16:19], s[0:1] offset:80
  global_store_b128 v47, v[20:23], s[0:1] offset:96
  global_store_b128 v47, v[24:27], s[0:1] offset:112
  global_store_b128 v47, v[28:31], s[0:1] offset:128
  global_store_b128 v47, v[32:35], s[0:1] offset:144
  global_store_b128 v47, v[36:39], s[0:1] offset:160
  global_store_b128 v47, v[40:43], s[0:1] offset:176
  global_store_b32 v47, v44, s[0:1] offset:192
  global_store_b32 v47, v45, s[0:1] offset:196
  global_store_b32 v47, v46, s[0:1] offset:200
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

