0x04400100
0xBF8903F7
0x4A020101
0xE0680000
0x04400100
0xBC7C0000
0xBFB00000

// ====

// Multiple pending LDS reads meet at one relational fact identity.
// RUN: emit amdgpu-assembly @local_load_assumptions
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @local_load_assumptions(%address: reg<amdgpu.vgpr>) asm {
  %position = ds_read_b32 %address
  %length = ds_read_b32 %address {offset = 4}
  %bounded_position, %bounded_length = low.assume %position, %length [lt(%position, %length)] : reg<amdgpu.vgpr>, reg<amdgpu.vgpr>
  %sum = v_add_u32 %bounded_position, %bounded_length
  ds_write_b32 %address, %sum {offset = 8}
  return
}

// ----
  ds_read_b32 v1, v0 offset:0
  ds_read_b32 v2, v0 offset:4
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v1, v1, v2
  ds_write_b32 v0, v1 offset:8
  s_endpgm

// ====

// RUN: emit amdgpu-native-words @local_load_assumptions
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @local_load_assumptions(%address: reg<amdgpu.vgpr>) asm {
  %position = ds_read_b32 %address
  %length = ds_read_b32 %address {offset = 4}
  %bounded_position, %bounded_length = low.assume %position, %length [lt(%position, %length)] : reg<amdgpu.vgpr>, reg<amdgpu.vgpr>
  %sum = v_add_u32 %bounded_position, %bounded_length
  ds_write_b32 %address, %sum {offset = 8}
  return
}

