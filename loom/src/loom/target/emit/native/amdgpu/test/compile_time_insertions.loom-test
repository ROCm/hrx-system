// Scalar-memory completion remains anchored before a zero-instruction identity.
// RUN: emit amdgpu-assembly @scalar_load_assumption
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @scalar_load_assumption(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>, %addend: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = s_load_dword %base, %offset
  %bounded = low.assume %loaded [range(%loaded, 1, 2048)] : reg<amdgpu.sgpr>
  %sum = s_add_u32 %bounded, %addend
  return %sum
}

// ----
  s_load_dword s4, s[0:1], s2 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s0, s4, s3
  s_endpgm

// ====

// RUN: emit amdgpu-native-words @scalar_load_assumption
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @scalar_load_assumption(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>, %addend: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %loaded = s_load_dword %base, %offset
  %bounded = low.assume %loaded [range(%loaded, 1, 2048)] : reg<amdgpu.sgpr>
  %sum = s_add_u32 %bounded, %addend
  return %sum
}

// ----
0xF4000100
0x04000000
0xBF89FC07
0x80000304
0xBFB00000

// ====

// A chain of identities preserves the load wait and subsequent store drain.
// RUN: emit amdgpu-assembly @global_load_assumptions
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @global_load_assumptions(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>) asm {
  %loaded = buffer_load_dword %resource, %address, %offset
  %positive = low.assume %loaded [range(%loaded, 1, 4096)] : reg<amdgpu.vgpr>
  %bounded = low.assume %positive [range(%positive, 1, 2048)] : reg<amdgpu.vgpr>
  %sum = v_add_u32 %bounded, %address
  buffer_store_dword %sum, %resource, %address, %offset
  return
}

// ----
  buffer_load_dword v1, v0, s[0:3], s4 offen offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v1, v1, v0
  buffer_store_dword v1, v0, s[0:3], s4 offen offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====

// RUN: emit amdgpu-native-words @global_load_assumptions
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @global_load_assumptions(%resource: reg<amdgpu.sgpr x4>, %address: reg<amdgpu.vgpr>, %offset: reg<amdgpu.sgpr>) asm {
  %loaded = buffer_load_dword %resource, %address, %offset
  %positive = low.assume %loaded [range(%loaded, 1, 4096)] : reg<amdgpu.vgpr>
  %bounded = low.assume %positive [range(%positive, 1, 2048)] : reg<amdgpu.vgpr>
  %sum = v_add_u32 %bounded, %address
  buffer_store_dword %sum, %resource, %address, %offset
  return
}

