amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @late_fixed_workgroup_tail() asm {
  %fixed = storage {byte_alignment = 4, byte_length = 20} : low.storage<workgroup>
  %tail = storage_tail_address align(64) : reg<amdgpu.vgpr>
  %late = storage {byte_alignment = 16, byte_length = 80} : low.storage<workgroup>
  return
}

// ----
  v_mov_b32 v0, 128
  s_endpgm

