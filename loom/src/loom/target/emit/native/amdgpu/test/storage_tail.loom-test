// RUN: emit amdgpu-assembly @padded_workgroup_tail waits=none strategy=source

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @padded_workgroup_tail() asm {
  %fixed = storage {byte_alignment = 4, byte_length = 20} : low.storage<workgroup>
  %tail = storage_tail_address align(64) : reg<amdgpu.vgpr>
  return
}

// ----
  v_mov_b32 v0, 64
  s_endpgm

// ====

