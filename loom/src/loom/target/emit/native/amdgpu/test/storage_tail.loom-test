// ====

// Register pressure creates private spill storage and rebuilds the native
// frame. The retained workgroup layout still gives the tail its padded base.
// RUN: with-checks emit amdgpu-assembly @tail_survives_private_spill_repair strategy=source amdgpu.vgpr=5

amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @tail_survives_private_spill_repair(%blocker: reg<amdgpu.vgpr>, %wide: reg<amdgpu.vgpr x4>, %output: reg<amdgpu.sgpr x2>) asm {
  %fixed = storage {byte_alignment = 4, byte_length = 20} : low.storage<workgroup>
  %temporary = v_add_u32 %blocker, %blocker
  %pressure = v_add_u32 %blocker, %temporary
  %head = slice %wide[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x3>
  %first = slice %head[0] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %second = slice %head[1] : reg<amdgpu.vgpr x3> -> reg<amdgpu.vgpr>
  %sum = v_add_u32 %first, %second
  %end = slice %wide[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr x2>
  %third = slice %end[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %fourth = slice %end[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %partial = v_add_u32 %sum, %third
  %result = v_add_u32 %partial, %fourth
  %out = v_add_u32 %result, %pressure
  %address = v_mov_b32 0
  global_store_b32_saddr %address, %out, %output
  %tail = storage_tail_address align(64) : reg<amdgpu.vgpr>
  return
}

// ----
CHECK: scratch_store_b128 *
CHECK: scratch_load_b128 *
CHECK: v_mov_b32 *, 64
CHECK: s_endpgm
