low.func.def target<amdgpu.cdna2.core>(@target) @loop_carried_alu_window(%input: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %choice: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %choose = s_cmp_lt_u32 %zero, %choice
  low.br ^loop(%input: reg<amdgpu.vgpr>)
^loop(%carried: reg<amdgpu.vgpr>):
  %shifted = v_add_f32_dpp %carried, %rhs {dpp_ctrl = 177}
  low.cond_br %choose, ^again, ^exit : reg<amdgpu.scc>
^again:
  %next = v_add_f32 %shifted, %rhs
  low.br ^loop(%next: reg<amdgpu.vgpr>)
^exit:
  return %shifted
}

