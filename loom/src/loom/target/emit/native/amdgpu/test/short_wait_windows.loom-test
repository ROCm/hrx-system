amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @cdna4_m0_fallthrough(%input: reg<amdgpu.vgpr>) asm {
  %address = s_mov_b32_m0_imm 1024
  low.br ^consume
^consume:
  ds_write_addtid_b32 %input, %address
  return
}

// ----
  s_mov_b32 m0, 1024
.Lbb1:
  s_nop 0
  ds_write_addtid_b32 v0 offset:0
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @load_to_dpp_fallthrough strategy=source

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @load_to_dpp_fallthrough(%resource: reg<amdgpu.sgpr x4>, %offset: reg<amdgpu.sgpr>, %address: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %value = buffer_load_dword %resource, %address, %offset : reg<amdgpu.vgpr>
  low.br ^consume
^consume:
  %result = v_add_f32_dpp %value, %rhs {dpp_ctrl = 177}
  return %result
}

// ----
  buffer_load_dword v0, v0, s[0:3], s4 offen offset:0
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_nop 0
  v_add_f32_dpp v0, v0, v1, quad_perm:[1,0,3,2], row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_endpgm
