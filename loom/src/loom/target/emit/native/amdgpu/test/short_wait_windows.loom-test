// RUN: emit amdgpu-assembly @joined_alu_windows strategy=source

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @joined_alu_windows(%input: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %choice: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %choose = s_cmp_lt_u32 %zero, %choice
  low.cond_br %choose, ^left, ^right : reg<amdgpu.scc>
^left:
  %left_value = v_add_f32 %input, %rhs
  low.br ^consume(%left_value: reg<amdgpu.vgpr>)
^right:
  %right_value = v_mul_f32 %input, %rhs
  low.br ^consume(%right_value: reg<amdgpu.vgpr>)
^consume(%carried: reg<amdgpu.vgpr>):
  %result = v_add_f32_dpp %carried, %rhs {dpp_ctrl = 177}
  return %result
}

