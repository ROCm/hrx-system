  s_cmp_lt_u32 s1, s0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  v_add_f32 v0, v0, v1
  s_branch .Lbb3
.Lbb2:
  v_mul_f32 v0, v0, v1
.Lbb3:
  s_nop 1
  v_add_f32_dpp v0, v0, v1, quad_perm:[1,0,3,2], row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_endpgm

