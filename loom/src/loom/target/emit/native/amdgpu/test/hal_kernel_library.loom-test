// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx1250-a0> @a0

low.kernel.def target<amdgpu.rdna4.gfx1250_a0.core>(@a0) workgroup_size(32, 1, 1) @reject_a0_k32_swmmac() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %lhs = concat(%lane, %lane) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %rhs = concat(%lane, %lane, %lane, %lane) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %acc = concat(%rhs, %rhs) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  // ERROR@+1: AMDGPU/047 {function_name="reject_a0_k32_swmmac", descriptor_name="amdgpu.v_swmmac_f32_16x16x32_fp8_bf8", descriptor_set_name="amdgpu.rdna4.gfx1250_a0.core", target="gfx1250-a0", constraint_key="amdgpu.swmmac.low_precision_lowering", legalization_key="lower_low_precision_swmmac"}
  %result = v_swmmac_f32_16x16x32_fp8_bf8 %acc, %lhs, %rhs, %lane
  return
}

// ====

// The kernel ABI assigns dispatch ID and workgroup IDs to fixed SGPRs. The
// identity edge preserves dispatch storage at the join. Other edges must keep
// already-aligned dispatch units, but may reuse a saved workgroup mask when
// every component needs transport. All locations come from the real ABI.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.kernel.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) workgroup_size(64, 1, 1) @fixed_identity_sources() asm {
  %dispatch = live_in<amdgpu.dispatch_id> : reg<amdgpu.sgpr x2>
  %left = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %right = live_in<amdgpu.workgroup_id.y> : reg<amdgpu.sgpr>
  %group_z = live_in<amdgpu.workgroup_id.z> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %storage = storage {byte_alignment = 16, byte_length = 2048} : low.storage<workgroup>
  %base = storage_address %storage : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %offset = v_lshlrev_b32_src0_inline %lane, 5
  %address = v_add_u32 %base, %offset
  %zero = s_mov_b32 0
  %use_dispatch = s_cmp_gt_u32 %group_z, %zero
  low.cond_br %use_dispatch, ^dispatch_path, ^select_path : reg<amdgpu.scc>
^dispatch_path:
  low.br.identity(0, 1) ^join(%dispatch: reg<amdgpu.sgpr x2>)
^select_path:
  %keep_dispatch = s_cmp_gt_u32 %left, %right
  low.cond_br %keep_dispatch, ^aligned_path, ^group_path : reg<amdgpu.scc>
^aligned_path:
  // Materializing a larger mask provides a displaced copy of dispatch ID.
  // Its availability must not replace the already-aligned original.
  %saved_dispatch = concat(%left, %right, %dispatch) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  %dispatch_mask = slice %saved_dispatch[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr x2>
  %dispatch_selected = v_cndmask_b32_src0_inline %lane, %dispatch_mask {false_value = 0}
  ds_write_b32 %address, %dispatch_selected
  %preserved = concat(%dispatch) : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x2>
  low.br ^join(%preserved: reg<amdgpu.sgpr x2>)
^group_path:
  // Both original workgroup units need transport. Reuse the reversed mask's
  // components through their forwarding chains. Updating a separate copy
  // must not invalidate the preserved provider.
  %saved_left = copy %left : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %saved_right = copy %right : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %moved_right = move %saved_right : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %mask = concat(%moved_right, %saved_left) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  // The retained read belongs to the shared storage, not the last SSA alias.
  %first_alias = low.assume %mask [range(%mask, 0, 1024)] : reg<amdgpu.sgpr x2>
  %second_alias = low.assume %first_alias [range(%first_alias, 0, 1024)] : reg<amdgpu.sgpr x2>
  %alias = low.assume %second_alias [range(%second_alias, 0, 1024)] : reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %lane, %alias {false_value = 0}
  ds_write_b32 %address, %selected
  // Keep an independent left copy, but overwrite the newest right copy.
  // The join must select preserved bits rather than either updated value.
  %preserved_left = copy %saved_left : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %mutable_left = copy %preserved_left : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %mutable_right = copy %moved_right : reg<amdgpu.sgpr> -> reg<amdgpu.sgpr>
  %changed_copy = s_addk_i32 %mutable_left, 1
  %changed_source = s_addk_i32 %mutable_right, 1
  %copied_result = copy %changed_copy : reg<amdgpu.sgpr> -> reg<amdgpu.vgpr>
  %overwritten_result = copy %changed_source : reg<amdgpu.sgpr> -> reg<amdgpu.vgpr>
  ds_write_b32 %address, %copied_result {offset = 4}
  ds_write_b32 %address, %overwritten_result {offset = 16}
  %pair = concat(%left, %right) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^join(%pair: reg<amdgpu.sgpr x2>)
^join(%identity: reg<amdgpu.sgpr x2>):
  %stored = copy %identity : reg<amdgpu.sgpr x2> -> reg<amdgpu.vgpr x2>
  ds_write_b64 %address, %stored {offset = 8}
  return
}

