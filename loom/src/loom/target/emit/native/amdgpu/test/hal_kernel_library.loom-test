  v_mov_b32 v1, 0
  v_lshlrev_b32 v2, 5, v0
  s_delay_alu instid0(VALU_DEP_1) | instid1(VALU_DEP_2)
  v_add_u32 v1, v1, v2
  s_mov_b32 s5, 0
  s_cmp_gt_u32 s4, s5
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb2
.Lbb1:
