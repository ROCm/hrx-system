// ====

// A retained predicate read through an alias of a fixed ABI input must follow
// the entry copy's storage. The join selects dispatch or workgroup identity.
amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.kernel.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) workgroup_size(64, 1, 1) @retained_dispatch_alias() asm {
  %dispatch = live_in<amdgpu.dispatch_id> : reg<amdgpu.sgpr x2>
  %left = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %right = live_in<amdgpu.workgroup_id.y> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %storage = storage {byte_alignment = 16, byte_length = 1024} : low.storage<workgroup>
  %base = storage_address %storage : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %offset = v_lshlrev_b32_src0_inline %lane, 4
  %address = v_add_u32 %base, %offset
  %dispatch_alias = low.assume %dispatch [range(%dispatch, 0, 1024)] : reg<amdgpu.sgpr x2>
  %entry_selected = v_cndmask_b32_src0_inline %lane, %dispatch_alias {false_value = 0}
  ds_write_b32 %address, %entry_selected
  %keep_dispatch = s_cmp_gt_u32 %left, %right
  low.cond_br %keep_dispatch, ^dispatch_path, ^group_path : reg<amdgpu.scc>
^dispatch_path:
  low.br.identity(0, 1) ^join(%dispatch: reg<amdgpu.sgpr x2>)
^group_path:
  %mask = concat(%right, %left) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %selected = v_cndmask_b32_src0_inline %lane, %mask {false_value = 0}
  ds_write_b32 %address, %selected {offset = 4}
  %pair = concat(%left, %right) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^join(%pair: reg<amdgpu.sgpr x2>)
^join(%identity: reg<amdgpu.sgpr x2>):
  %stored = copy %identity : reg<amdgpu.sgpr x2> -> reg<amdgpu.vgpr x2>
  ds_write_b64 %address, %stored {offset = 8}
  return
}

