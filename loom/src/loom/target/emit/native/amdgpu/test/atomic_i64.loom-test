// ====

// Untyped GFX12 buffer instructions ignore FORMAT. These goldens clear it;
// LLVM sets it to 1 to accommodate external disassemblers.
// Reductions and returning atomics use independent inputs. The returned values
// form a destructive chain while the reduction input remains live.
// RUN: emit amdgpu-native-words @buffer_gfx1100
amdgpu.target<gfx1100> @target

low.func.def schedule(locked) target<amdgpu.rdna3.core>(@target) @buffer_gfx1100(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %reduction: reg<amdgpu.vgpr x2>, %pair: reg<amdgpu.vgpr x4>, %resource: reg<amdgpu.sgpr x4>, %soffset: reg<amdgpu.sgpr>) asm {
  buffer_atomic_sub_u64 %reduction, %resource, %address, %soffset {offset = 16}
  %sub_u64 = buffer_atomic_sub_u64_rtn %value, %resource, %address, %soffset {offset = 16}
  buffer_atomic_min_i64 %reduction, %resource, %address, %soffset {offset = 16}
  %min_i64 = buffer_atomic_min_i64_rtn %sub_u64, %resource, %address, %soffset {offset = 16}
  buffer_atomic_xor_b64 %reduction, %resource, %address, %soffset {offset = 16}
  %xor_b64 = buffer_atomic_xor_b64_rtn %min_i64, %resource, %address, %soffset {offset = 16}
  %swap_u64 = buffer_atomic_swap_b64_rtn %xor_b64, %resource, %address, %soffset {offset = 16}
  %cmpswap_b64 = buffer_atomic_cmpswap_b64_rtn %pair, %resource, %address, %soffset {offset = 16}
  return
}

