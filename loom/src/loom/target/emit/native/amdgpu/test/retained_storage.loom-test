small_frame:
  v_readfirstlane_b32 s0, v0
  v_mov_b32 v1, v0
  v_mov_b32 v2, v0
  v_mov_b32 v3, v0
  v_mov_b32 v4, v0
  scratch_store_b32 off, v4, off offset:20
  s_mov_b64_exec_read s[2:3]
  scratch_store_b64 off, v[1:2], off offset:24
  scratch_store_b32 off, v3, off offset:32
  s_mov_b64 exec, -1
  v_mov_b32 v1, s0
  scratch_store_b32 off, v1, off offset:44
  s_mov_b64 exec, s[2:3]
  s_waitcnt_vscnt vscnt(0)
  s_getpc_b64 s[32:33]
  s_add_u32 s32, s32, @snapshot@rel32_lo
  s_addc_u32 s33, s33, @snapshot@rel32_hi
  s_swappc_b64 s[30:31], s[32:33]
  s_mov_b64_exec_read s[0:1]
  scratch_load_b32 v0, off, off offset:20
  scratch_load_b32 v3, off, off offset:32
  scratch_load_b64 v[1:2], off, off offset:24
  s_mov_b64 exec, -1
  scratch_load_b32 v0, off, off offset:44
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_readfirstlane_b32 s2, v0
  s_mov_b64 exec, s[0:1]
  s_endpgm


.type snapshot,@function
snapshot:
  scratch_store_b32 off, v0, off offset:0
  scratch_load_b32 v0, off, off offset:0
  s_waitcnt_vscnt vscnt(0)
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_setpc_b64 s[30:31]
.Lfunc_end1:
.size snapshot, .Lfunc_end1-snapshot


.type large_snapshot,@function
large_snapshot:
  v_mov_b32 v1, 4096
  scratch_store_b32 v1, v0, off offset:0
  v_mov_b32 v0, 4096
  scratch_load_b32 v0, v0, off offset:0
  s_waitcnt_vscnt vscnt(0)
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_setpc_b64 s[30:31]
.Lfunc_end2:
.size large_snapshot, .Lfunc_end2-large_snapshot
.Lfunc_end0:
.size small_frame, .Lfunc_end0-small_frame

