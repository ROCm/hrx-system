// RUN: emit amdgpu-kernel-assembly

// Leaf helpers share the low end of scratch. Each entry places its storage
// above its own reachable helpers before selecting spill packet offsets.
// The first entry uses immediate offsets and misaligned vector chunks; the
// second crosses the immediate limit and materializes storage addresses.
amdgpu.target<gfx1100> @target

low.func.def noinline target<amdgpu.rdna3.core>(@target) @snapshot(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %storage = storage {byte_alignment = 8, byte_length = 12} : low.storage<private>
  low.spill %value, %storage : reg<amdgpu.vgpr>, low.storage<private>
  %result = low.reload %storage : low.storage<private> -> reg<amdgpu.vgpr>
  return %result
}

low.func.def noinline target<amdgpu.rdna3.core>(@target) @large_snapshot(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 4108} : low.storage<private>
  low.spill %value, %storage {offset = 4096} : reg<amdgpu.vgpr>, low.storage<private>
  %result = low.reload %storage {offset = 4096} : low.storage<private> -> reg<amdgpu.vgpr>
  return %result
}

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(64, 1, 1) @small_frame() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %uniform = v_readfirstlane_b32 %lane
  %vector = concat(%lane, %lane, %lane, %lane) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %storage = storage {byte_alignment = 16, byte_length = 48} : low.storage<private>
  %view = storage_view %storage {byte_length = 32, offset = 4} : low.storage<private> -> low.storage<private>
  low.spill %vector, %view : reg<amdgpu.vgpr x4>, low.storage<private>
  low.spill %uniform, %view {offset = 24} : reg<amdgpu.sgpr>, low.storage<private>
  %called = low.func.call noinline @snapshot(%lane) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %vector_reload = low.reload %view : low.storage<private> -> reg<amdgpu.vgpr x4>
  %uniform_reload = low.reload %view {offset = 24} : low.storage<private> -> reg<amdgpu.sgpr>
  return
}

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(64, 1, 1) @large_frame() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %storage = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  low.spill %lane, %storage : reg<amdgpu.vgpr>, low.storage<private>
  %first = low.func.call noinline @snapshot(%lane) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %second = low.func.call noinline @large_snapshot(%first) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %reload = low.reload %storage : low.storage<private> -> reg<amdgpu.vgpr>
  return
}

