// RUN: emit amdgpu-assembly @reload_wide_address

// Both the uniform base and varying byte offset retain their high words through
// scratch storage before carry-propagating address formation and a real load.

amdgpu.target<gfx12-5-generic> @target

low.func.def target<amdgpu.gfx12_5.generic.core>(@target) @reload_wide_address(%uniform: reg<amdgpu.sgpr x2>, %varying: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %storage = storage {byte_alignment = 8, byte_length = 16} : low.storage<private>
  low.spill %uniform, %storage : reg<amdgpu.sgpr x2>, low.storage<private>
  low.spill %varying, %storage {offset = 8} : reg<amdgpu.vgpr x2>, low.storage<private>
  %uniform_reload = low.reload %storage : low.storage<private> -> reg<amdgpu.sgpr x2>
  %varying_reload = low.reload %storage {offset = 8} : low.storage<private> -> reg<amdgpu.vgpr x2>
  %uniform_low = slice %uniform_reload[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %uniform_high = slice %uniform_reload[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %varying_low = slice %varying_reload[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %varying_high = slice %varying_reload[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %address_low, %carry = v_add_co_u32 %uniform_low, %varying_low
  %base_high = v_mov_b32_copy %uniform_high
  %address_high, %carry_out = v_add_co_ci_u32 %base_high, %varying_high, %carry
  %address = concat(%address_low, %address_high) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %value = global_load_b32_vaddr %address
  return %value
}

// ----
  s_mov_b64_exec_read s[2:3]
  s_mov_b64 exec, -1
  v_mov_b32 v2, s0
  v_mov_b32 v3, s1
  scratch_store_b32 off, v2, off offset:0
  scratch_store_b32 off, v3, off offset:4
  s_wait_xcnt xcnt(0)
  s_mov_b64 exec, s[2:3]
  s_mov_b64_exec_read s[0:1]
  scratch_store_b64 off, v[0:1], off offset:8
  s_wait_xcnt xcnt(0)
  s_mov_b64 exec, -1
  scratch_load_b32 v0, off, off offset:0
  s_wait_loadcnt loadcnt(0)
  v_readfirstlane_b32 s2, v0
  scratch_load_b32 v0, off, off offset:4
  s_wait_loadcnt loadcnt(0)
  v_readfirstlane_b32 s3, v0
  s_mov_b64 exec, s[0:1]
  scratch_load_b64 v[0:1], off, off offset:8
  v_mov_b32 v2, s3
  s_wait_loadcnt loadcnt(0)
  v_add_co_u32 v0, s[0:1], s2, v0
  s_delay_alu instid0(VALU_DEP_1) | instid1(VALU_DEP_2)
  v_add_co_ci_u32 v1, s[0:1], v2, v1, s[0:1]
  global_load_b32 v2, v[0:1], off offset:0
  s_wait_loadcnt loadcnt(0)
  s_wait_storecnt storecnt(0)
  s_endpgm

