// ====

// Register pressure inserts spill traffic for both words of the address
// arithmetic. Reloaded pairs feed the final global load with completion waits.
// RUN: emit amdgpu-assembly @wide_address_pressure strategy=source amdgpu.sgpr=6

amdgpu.target<gfx11-generic> @target

low.func.def target<amdgpu.gfx11.generic.core>(@target) @wide_address_pressure(%address_seed: reg<amdgpu.sgpr x2>, %scale: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %address_a = s_lshl_b64 %address_seed, %scale
  %address_b = s_lshl_b64 %address_a, %scale
  %address_c = s_lshl_b64 %address_b, %scale
  %address_d = s_lshl_b64 %address_c, %scale
  %address_ab = s_xor_b64 %address_a, %address_b
  %address_cd = s_xor_b64 %address_c, %address_d
  %address_combined = s_xor_b64 %address_ab, %address_cd
  %address_e = s_xor_b64 %address_combined, %address_a
  %address_f = s_xor_b64 %address_e, %address_b
  %address = s_xor_b64 %address_f, %address_c
  %buffer_base = v_mov_b32 0
  %value = global_load_b32_saddr %buffer_base, %address
  return %value
}

