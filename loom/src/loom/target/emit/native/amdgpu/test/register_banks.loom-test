low.func.def schedule(locked) target<amdgpu.cdna4.core>(@target) @scaled_accumulators(%lhs: reg<amdgpu.agpr x4>, %rhs: reg<amdgpu.agpr x4>, %acc: reg<amdgpu.agpr x4>, %scale_a: reg<amdgpu.vgpr>, %scale_b: reg<amdgpu.vgpr>) -> (reg<amdgpu.agpr x4>) asm {
  %result = v_mfma_scale_f32_16x16x128_f8f6f4_f4_f4 %lhs, %rhs, %acc, %scale_a, %scale_b {matrix_a_fmt = "fp4", matrix_b_fmt = "fp4"}
  return %result
}

