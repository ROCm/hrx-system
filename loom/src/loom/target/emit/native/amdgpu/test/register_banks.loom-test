// RUN: verify

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @reject_vector_result(%address: reg<amdgpu.vgpr x2>, %pair: reg<amdgpu.agpr x4>) -> (reg<amdgpu.vgpr x2>) asm {
  // ERROR@+1: TYPE/018 {field_a="dst", type_a="reg<amdgpu.vgpr x2>", field_b="value", type_b="reg<amdgpu.agpr x4>"}
  %result = flat_atomic_cmpswap_x2_rtn %address, %pair : reg<amdgpu.vgpr x2>
  return %result
}

