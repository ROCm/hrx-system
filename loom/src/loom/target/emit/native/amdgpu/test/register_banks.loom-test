// SrcA and SrcB have independent bank bits; SrcC and the result share one.
// RUN: emit amdgpu-native-words @matrix_bank_combinations

amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @matrix_bank_combinations(%vlhs: reg<amdgpu.vgpr>, %vrhs: reg<amdgpu.vgpr>, %alhs: reg<amdgpu.agpr>, %arhs: reg<amdgpu.agpr>, %vacc: reg<amdgpu.vgpr x4>, %aacc: reg<amdgpu.agpr x4>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.agpr x4>) asm {
  %v0 = v_mfma_f32_16x16x4f32 %vlhs, %vrhs, %vacc
  %v1 = v_mfma_f32_16x16x4f32 %alhs, %vrhs, %v0
  %v2 = v_mfma_f32_16x16x4f32 %vlhs, %arhs, %v1
  %v3 = v_mfma_f32_16x16x4f32 %alhs, %arhs, %v2
  %a0 = v_mfma_f32_16x16x4f32 %vlhs, %vrhs, %aacc
  %a1 = v_mfma_f32_16x16x4f32 %alhs, %vrhs, %a0
  %a2 = v_mfma_f32_16x16x4f32 %vlhs, %arhs, %a1
  %a3 = v_mfma_f32_16x16x4f32 %alhs, %arhs, %a2
  return %v3, %a3
}

