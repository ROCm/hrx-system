// ====

// The compare pair and result have different tuple sizes but the same bank.
// RUN: emit amdgpu-native-words @flat_accumulators

amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @flat_accumulators(%address: reg<amdgpu.vgpr x2>, %pair: reg<amdgpu.agpr x4>) -> (reg<amdgpu.agpr x2>) asm {
  %byte = flat_load_ubyte %address {offset = 1} : reg<amdgpu.agpr>
  %short = flat_load_ushort %address {offset = 2} : reg<amdgpu.agpr>
  %wide = flat_load_dwordx4 %address {offset = 16} : reg<amdgpu.agpr x4>
  flat_store_byte %address, %byte {offset = 32}
  flat_store_short %address, %short {offset = 34}
  flat_store_dwordx4 %address, %wide {offset = 48}
  %result = flat_atomic_cmpswap_x2_rtn %address, %pair : reg<amdgpu.agpr x2>
  return %result
}

