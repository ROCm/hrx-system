// RUN: emit amdgpu-kernel-assembly

// Swapping loop-carried words requires a temporary beyond the SSA assignments.
// The kernel descriptor and metadata include that temporary's register.
amdgpu.target<gfx1151> @target

low.kernel.def target<amdgpu.rdna3_5.core>(@target) workgroup_size(32, 1, 1) @swap_words() asm {
  %lhs = v_mov_b32 7
  %rhs = v_mov_b32 11
  %count = s_mov_b32 3
  %step = s_mov_b32 1
  %limit = s_mov_b32 0
  low.br ^loop(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %count: reg<amdgpu.sgpr>)
^loop(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %remaining: reg<amdgpu.sgpr>):
  %next = s_sub_u32 %remaining, %step
  %again = s_cmp_gt_u32 %next, %limit
  low.cond_br %again, ^back, ^exit : reg<amdgpu.scc>
^back:
  low.br ^loop(%b: reg<amdgpu.vgpr>, %a: reg<amdgpu.vgpr>, %next: reg<amdgpu.sgpr>)
^exit:
  return
}

// ----
.text
.amdgcn_target "amdgcn-amd-amdhsa--gfx1151"
.amdhsa_code_object_version 6

.protected swap_words
.globl swap_words
.p2align 8
.type swap_words,@function
swap_words:
  v_dual_mov_b32 v0, 7 :: v_dual_mov_b32 v1, 11
  s_mov_b32 s0, 1
  s_mov_b32 s1, 0
  s_mov_b32 s2, 3
.Lbb1:
  s_sub_u32 s2, s2, s0
  s_cmp_gt_u32 s2, s1
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  v_mov_b32 v2, v0
  v_mov_b32 v0, v1
  v_mov_b32 v1, v2
  s_branch .Lbb1
.Lbb3:
  s_endpgm
.Lfunc_end0:
.size swap_words, .Lfunc_end0-swap_words

.rodata
.p2align 6
.amdhsa_kernel swap_words
  .amdhsa_group_segment_fixed_size 0
  .amdhsa_private_segment_fixed_size 0
  .amdhsa_kernarg_size 0
