// Swapping scalar loop-carried words requires a temporary beyond the SSA assignments.
// The kernel descriptor and metadata include that temporary's register.
amdgpu.target<gfx1151> @target

low.kernel.def target<amdgpu.rdna3_5.core>(@target) workgroup_size(32, 1, 1) @swap_scalar_words() asm {
  %lhs = s_mov_b32 7
  %rhs = s_mov_b32 11
  %count = s_mov_b32 3
  %step = s_mov_b32 1
  %limit = s_mov_b32 0
  low.br ^loop(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %count: reg<amdgpu.sgpr>)
^loop(%a: reg<amdgpu.sgpr>, %b: reg<amdgpu.sgpr>, %remaining: reg<amdgpu.sgpr>):
  %next = s_sub_u32 %remaining, %step
  %again = s_cmp_gt_u32 %next, %limit
  low.cond_br %again, ^back, ^exit : reg<amdgpu.scc>
^back:
  low.br ^loop(%b: reg<amdgpu.sgpr>, %a: reg<amdgpu.sgpr>, %next: reg<amdgpu.sgpr>)
^exit:
  return
}


