// ====

// ABI-fixed workgroup inputs participate in moves without consuming SGPR
// allocation resources. Only the two materialized tuple words count.
amdgpu.target<gfx1200> @target

low.kernel.def target<amdgpu.rdna4.core>(@target) workgroup_size(32, 1, 1) workgroup_count(4, 1, 1) @workgroup_pair() asm {
  %workgroup = live_in<amdgpu.cluster_id_x> : reg<amdgpu.sgpr>
  %pair = concat(%workgroup, %workgroup) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %first = slice %pair[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %last = slice %pair[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %sum = s_add_u32 %first, %last
  return
}

