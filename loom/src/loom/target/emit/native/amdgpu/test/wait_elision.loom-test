  s_wait_loadcnt loadcnt(0)
  global_inv scope(0)
  s_wait_loadcnt loadcnt(0)
  s_endpgm

// ====

// A drain before a timer request does not complete its asynchronous SGPR write.
// Only the repeated wait after that request can be elided.
// RUN: emit amdgpu-assembly @message_completion
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @message_completion(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  s_waitcnt {lgkmcnt = 0}
  %clock = s_sendmsg_rtn_b32 {message = 131}
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {lgkmcnt = 0}
  %sum = s_add_u32 %clock, %input
  return %sum
}

// ----
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_sendmsg_rtn_b32 s1, message(131)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s0, s1, s0
  s_endpgm
