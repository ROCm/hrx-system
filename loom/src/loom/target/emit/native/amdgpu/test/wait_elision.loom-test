amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @cache_control_boundary() asm {
  s_wait_loadcnt {loadcnt = 0}
  global_inv
  s_wait_loadcnt {loadcnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  return
}

