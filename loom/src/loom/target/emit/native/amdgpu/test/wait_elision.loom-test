// ====

// Cache control is an opaque completion boundary. The wait after it cannot be
// removed using a drain that completed before the control instruction issued.
// RUN: emit amdgpu-assembly @cache_control_boundary
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @cache_control_boundary() asm {
  s_waitcnt {lgkmcnt = 0}
  s_dcache_inv
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {lgkmcnt = 0}
  return
}

// ----
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_dcache_inv
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====

// CDNA buffer invalidation advances VMEM even without a memory result.
// RUN: emit amdgpu-assembly @cache_control_boundary
amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @cache_control_boundary() asm {
  s_waitcnt {vmcnt = 0}
  buffer_inv
  s_waitcnt {vmcnt = 0}
  s_waitcnt {vmcnt = 0}
  return
}

// ----
  s_waitcnt vmcnt(0) lgkmcnt(15)
  buffer_inv sc0(0), sc1(0)
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====

// The same proof boundary applies to split counters on RDNA4.
