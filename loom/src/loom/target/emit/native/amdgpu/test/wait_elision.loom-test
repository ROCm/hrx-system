// ====

// Completing the older load does not complete the independent younger load.
// The authored full wait must survive a planned partial wait.
// RUN: emit amdgpu-assembly @partial_then_full
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @partial_then_full(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %older = global_load_b32_saddr %address, %base
  %younger = global_load_b32_saddr %address, %base {offset = 4}
  %first = v_add_u32 %older, %address
  s_waitcnt {vmcnt = 0}
  %sum = v_add_u32 %first, %younger
  ds_write_b32 %address, %sum
  return
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  global_load_b32 v2, v0, s[0:1] offset:4
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v1, v1, v0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v1, v1, v2
  ds_write_b32 v0, v1 offset:0
  s_endpgm

// ====

// A completed VMEM epoch cannot discharge an independent LDS/SMEM counter.
// Once both counters are drained, a repeated combined wait can disappear.
// RUN: emit amdgpu-assembly @mixed_counters
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @mixed_counters(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %local = ds_read_b32 %address
  %global = global_load_b32_saddr %address, %base
  %first = v_add_u32 %global, %address
  s_waitcnt {vmcnt = 0, lgkmcnt = 0}
  s_waitcnt {vmcnt = 0, lgkmcnt = 0}
  %sum = v_add_u32 %first, %local
  ds_write_b32 %address, %sum
  return
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  ds_read_b32 v2, v0 offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v1, v1, v0
  s_waitcnt vmcnt(0) lgkmcnt(0)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v1, v1, v2
  ds_write_b32 v0, v1 offset:0
  s_endpgm

// ====

// A new producer invalidates the empty-counter proof without undoing older
// completion. A repetition after the second full drain is redundant.
// RUN: emit amdgpu-assembly @new_producer
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @new_producer(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  s_waitcnt {vmcnt = 0}
  %loaded = global_load_b32_saddr %address, %base
  s_waitcnt {vmcnt = 0}
  s_waitcnt {vmcnt = 0}
  ds_write_b32 %address, %loaded
  return
}

// ----
  s_waitcnt vmcnt(0) lgkmcnt(63)
  global_load_b32 v1, v0, s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_write_b32 v0, v1 offset:0
  s_endpgm

// ====

// Block-local counts do not include work arriving from a predecessor. One
// drained incoming arm cannot justify removing the first wait at the join.
// RUN: emit amdgpu-assembly @incoming_work
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @incoming_work(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.scc>) asm {
  %loaded = global_load_b32_saddr %address, %base
  low.cond_br %condition, ^drained, ^pending : reg<amdgpu.scc>
^drained:
  s_waitcnt {vmcnt = 0}
  low.br ^join
^pending:
  low.br ^join
^join:
  s_waitcnt {vmcnt = 0}
  s_waitcnt {vmcnt = 0}
  ds_write_b32 %address, %loaded
  return
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_branch .Lbb3
.Lbb2:
.Lbb3:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  ds_write_b32 v0, v1 offset:0
  s_endpgm

// ====

// Authored partial bounds retain their spelling and insertion point, including
// combined packets whose other counter has a redundant full bound.
// RUN: emit amdgpu-assembly @authored_bounds
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @authored_bounds() asm {
  s_waitcnt {vmcnt = 0, lgkmcnt = 0}
  s_waitcnt {vmcnt = 1}
  s_waitcnt {vmcnt = 0, lgkmcnt = 2}
  s_waitcnt {vmcnt = 0, lgkmcnt = 0}
  return
}

// ----
  s_waitcnt vmcnt(0) lgkmcnt(0)
  s_waitcnt vmcnt(1) lgkmcnt(63)
  s_waitcnt vmcnt(0) lgkmcnt(2)
  s_endpgm

// ====

// Packed ALU dependency controls and wait-idle have additional semantics; they
// are not scalar remaining-memory-operation bounds eligible for this elision.
// RUN: emit amdgpu-assembly @other_wait_controls
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @other_wait_controls() asm {
  s_wait_alu {depctr = 0}
  s_wait_alu {depctr = 0}
  s_wait_idle
  s_wait_idle
  return
}

// ----
  s_wait_alu depctr(0)
  s_wait_alu depctr(0)
  s_wait_idle
  s_wait_idle
  s_endpgm

// ====

// Split-counter targets use the same proof without imposing a drain on the
// independent store counter. Only the repeated load wait is redundant.
// RUN: emit amdgpu-assembly @split_counters
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @split_counters(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %loaded = global_load_b32_saddr %address, %base
  %sum = v_add_u32 %loaded, %address
  s_wait_loadcnt {loadcnt = 0}
  global_store_b32_saddr %address, %sum, %base {offset = 4}
  s_wait_storecnt {storecnt = 0}
  return
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  s_wait_loadcnt loadcnt(0)
  v_add_u32 v1, v1, v0
  global_store_b32 v0, v1, s[0:1] offset:4
  s_wait_storecnt storecnt(0)
  s_endpgm

// ====

// CDNA shares the VMEM load/store counter. The planned full wait for the load
// drains both, making the later authored combined wait redundant.
// RUN: emit amdgpu-assembly @shared_load_store_counter
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @shared_load_store_counter(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>, %local: reg<amdgpu.vgpr>) asm {
  flat_store_dword %address, %value
  %loaded = flat_load_dword %address {offset = 4} : reg<amdgpu.vgpr>
  %sum = v_add_u32 %loaded, %value
  s_waitcnt {vmcnt = 0}
  ds_write_b32 %local, %sum
  return
}

// ----
  flat_store_dword v[0:1], v2 offset:0
  s_waitcnt vmcnt(0) lgkmcnt(0)
  flat_load_dword v0, v[0:1] offset:4
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v0, v0, v2
  ds_write_b32 v3, v0 offset:0
  s_endpgm

// ====

// Removed waits cannot provide instruction slots for a fixed DPP hazard. Both
// no-op cycles remain necessary even though two source packets separate the use.
// RUN: emit amdgpu-assembly @fixed_delay
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @fixed_delay(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  s_waitcnt {vmcnt = 0}
  %value = v_add_f32 %lhs, %rhs
  s_waitcnt {vmcnt = 0}
  s_waitcnt {vmcnt = 0}
  %sum = v_add_f32_dpp %value, %value {dpp_ctrl = 177}
  return %sum
}

// ----
  s_waitcnt vmcnt(0) lgkmcnt(15)
  v_add_f32 v0, v0, v1
  s_nop 1
  v_add_f32_dpp v0, v0, v0, quad_perm:[1,0,3,2], row_mask:0xf, bank_mask:0xf, bound_ctrl:1
  s_endpgm

// ====

// An elided wait has no instruction between these independent ALU operations,
// so packetization may pair them while retaining the initial full wait.
// RUN: emit amdgpu-assembly @dual_issue
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @dual_issue(%acc0: reg<amdgpu.vgpr>, %lhs0: reg<amdgpu.vgpr>, %rhs0: reg<amdgpu.vgpr>, %acc1: reg<amdgpu.vgpr>, %lhs1: reg<amdgpu.vgpr>, %rhs1: reg<amdgpu.vgpr>) asm {
  s_waitcnt {vmcnt = 0}
  %next0 = v_fmac_f32 %acc0, %lhs0, %rhs0
  s_waitcnt {vmcnt = 0}
  %next1 = v_fmac_f32 %acc1, %lhs1, %rhs1
  return
}

// ----
  v_dual_fmac_f32 v0, v1, v2 :: v_dual_fmac_f32 v3, v4, v5
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_endpgm

// ====

// A removed authored wait supplies no explicit progress event. The retained
// planned drain explains completion before the arithmetic consumer.
// RUN: emit amdgpu-wait-counter-plan-json @retained_progress
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @retained_progress(%address: reg<amdgpu.vgpr>) asm {
  %loaded = ds_read_b32 %address
  %sum = v_add_u32 %loaded, %address
  s_waitcnt {lgkmcnt = 0}
  ds_write_b32 %address, %sum {offset = 4}
  return
}

