// Scheduling can move the authored wait past its load's arithmetic consumer.
// The necessary planned wait before the comparison makes that full wait redundant
// on every retry. The volatile observation must remain inside the loop.
// RUN: emit amdgpu-assembly @poll
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @poll(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
  %wanted = v_mov_b32 1
  %all_lanes = s_mov_b32 4294967295
  low.br ^poll
^poll:
  %value = global_load_b32_saddr<volatile> %address, %input {glc = 1}
  s_waitcnt {vmcnt = 0}
  %observed = v_cmp_eq_i32 %value, %wanted
  %mask = slice %observed[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %ready = s_cmp_eq_i32 %mask, %all_lanes
  low.cond_br %ready, ^done, ^poll : reg<amdgpu.scc>
^done:
  %incremented = v_add_u32_lit %value, 1
  global_store_b32_saddr %address, %incremented, %output
  return
}

// ----
  v_mov_b32 v1, 1
  s_mov_b32 s4, 4294967295
.Lbb1:
  global_load_b32 v2, v0, s[0:1] offset:0 glc
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_cmp_eq_i32 s[6:7], v2, v1
  s_delay_alu instid0(VALU_DEP_1)
  s_cmp_eq_i32 s6, s4
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb1
.Lbb2:
  v_add_u32 v1, 1, v2
  global_store_b32 v0, v1, s[2:3] offset:0
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====

// Native encoding consumes the same elision decision as assembly, including
// branch offsets and fixed ALU delays after the removed instruction.
// RUN: emit amdgpu-native-words @poll
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @poll(%address: reg<amdgpu.vgpr>, %input: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
  %wanted = v_mov_b32 1
  %all_lanes = s_mov_b32 4294967295
  low.br ^poll
^poll:
  %value = global_load_b32_saddr<volatile> %address, %input {glc = 1}
  s_waitcnt {vmcnt = 0}
  %observed = v_cmp_eq_i32 %value, %wanted
  %mask = slice %observed[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %ready = s_cmp_eq_i32 %mask, %all_lanes
  low.cond_br %ready, ^done, ^poll : reg<amdgpu.scc>
^done:
  %incremented = v_add_u32_lit %value, 1
  global_store_b32_saddr %address, %incremented, %output
  return
}

