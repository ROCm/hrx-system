// Exact gfx1201 coverage keeps the processor binding in the production packet
// planner while exercising gfx12 instruction forms in one compact stream.
// RUN: emit amdgpu-assembly @gfx1201_native_canary strategy=source fixed=%kernarg:physical_register:0:2 fixed=%soffset:physical_register:2:1 fixed=%adjusted:physical_register:3:1 fixed=%base:physical_register:4:2 fixed=%a0:physical_register:0:1 fixed=%b0:physical_register:1:1 fixed=%a1:physical_register:2:1 fixed=%b1:physical_register:3:1 fixed=%product:physical_register:4:1 fixed=%sum:physical_register:5:1 fixed=%addr:physical_register:6:1

amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @gfx1201_native_canary(%kernarg: reg<amdgpu.sgpr x2>, %soffset: reg<amdgpu.sgpr>, %a0: reg<amdgpu.vgpr>, %b0: reg<amdgpu.vgpr>, %a1: reg<amdgpu.vgpr>, %b1: reg<amdgpu.vgpr>, %addr: reg<amdgpu.vgpr>) asm {
  %adjusted = s_add_u32_rhs_inline %soffset, 4
  %base = s_load_dwordx2 %kernarg, %adjusted
  %product = v_mul_f32 %a0, %b0
  %sum = v_add_f32 %a1, %b1
  global_store_b32_saddr %addr, %sum, %base
  return
}

// ----
  s_add_u32 s3, s2, 4
  s_load_dwordx2 s[4:5], s[0:1], s3 offset:0
  v_dual_mul_f32 v4, v0, v1 :: v_dual_add_f32 v5, v2, v3
  s_wait_kmcnt kmcnt(0)
  global_store_b32 v6, v5, s[4:5] offset:0
  s_wait_storecnt storecnt(0)
  s_endpgm

// ====

// The same stream must pass the native encoder, not only assembly formatting.
// RUN: emit amdgpu-native @gfx1201_native_encoding strategy=source fixed=%kernarg:physical_register:0:2 fixed=%soffset:physical_register:2:1 fixed=%adjusted:physical_register:3:1 fixed=%base:physical_register:4:2 fixed=%a0:physical_register:0:1 fixed=%b0:physical_register:1:1 fixed=%a1:physical_register:2:1 fixed=%b1:physical_register:3:1 fixed=%product:physical_register:4:1 fixed=%sum:physical_register:5:1 fixed=%addr:physical_register:6:1

amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @gfx1201_native_encoding(%kernarg: reg<amdgpu.sgpr x2>, %soffset: reg<amdgpu.sgpr>, %a0: reg<amdgpu.vgpr>, %b0: reg<amdgpu.vgpr>, %a1: reg<amdgpu.vgpr>, %b1: reg<amdgpu.vgpr>, %addr: reg<amdgpu.vgpr>) asm {
  %adjusted = s_add_u32_rhs_inline %soffset, 4
  %base = s_load_dwordx2 %kernarg, %adjusted
  %product = v_mul_f32 %a0, %b0
  %sum = v_add_f32 %a1, %b1
  global_store_b32_saddr %addr, %sum, %base
  return
}

// ----
