// ====

// Untyped buffer atomics ignore FORMAT. Loom clears it; LLVM sets it to one.
// Reductions and returning atomics use independent inputs. The returned values
// form a destructive chain while the reduction input remains live.
// RUN: emit amdgpu-native-words @float64_buffer
amdgpu.target<gfx1250> @target

low.func.def schedule(locked) target<amdgpu.rdna4.gfx125x.core>(@target) @float64_buffer(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %reduction: reg<amdgpu.vgpr x2>, %resource: reg<amdgpu.sgpr x4>, %soffset: reg<amdgpu.sgpr>) asm {
  buffer_atomic_add_f64 %reduction, %resource, %address, %soffset {offset = 16}
  %add = buffer_atomic_add_f64_rtn %value, %resource, %address, %soffset {offset = 16}
  buffer_atomic_min_num_f64 %reduction, %resource, %address, %soffset {offset = 16}
  %min_num = buffer_atomic_min_num_f64_rtn %add, %resource, %address, %soffset {offset = 16}
  buffer_atomic_max_num_f64 %reduction, %resource, %address, %soffset {offset = 16}
  %max_num = buffer_atomic_max_num_f64_rtn %min_num, %resource, %address, %soffset {offset = 16}
  return
}

