// ====

// RUN: emit amdgpu-native-words @float64_gfx1250
amdgpu.target<gfx1250> @target

low.func.def schedule(locked) target<amdgpu.rdna4.gfx125x.core>(@target) @float64_gfx1250(%address: reg<amdgpu.vgpr x2>, %offset: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %base: reg<amdgpu.sgpr x2>) asm {
  global_atomic_add_f64_saddr %offset, %value, %base {offset = 16}
  %global_add = global_atomic_add_f64_rtn_saddr %offset, %value, %base {offset = 16}
  flat_atomic_add_f64 %address, %value {offset = 16}
  %flat_add = flat_atomic_add_f64_rtn %address, %value {offset = 16}
  ds_add_f64 %offset, %value {offset = 16}
  %ds_add = ds_add_rtn_f64 %offset, %value {offset = 16}
  global_atomic_min_num_f64_saddr %offset, %value, %base {offset = 16}
  %global_min_num = global_atomic_min_num_f64_rtn_saddr %offset, %value, %base {offset = 16}
  flat_atomic_min_num_f64 %address, %value {offset = 16}
  %flat_min_num = flat_atomic_min_num_f64_rtn %address, %value {offset = 16}
  ds_min_f64 %offset, %value {offset = 16}
  %ds_min = ds_min_rtn_f64 %offset, %value {offset = 16}
  global_atomic_max_num_f64_saddr %offset, %value, %base {offset = 16}
  %global_max_num = global_atomic_max_num_f64_rtn_saddr %offset, %value, %base {offset = 16}
  flat_atomic_max_num_f64 %address, %value {offset = 16}
  %flat_max_num = flat_atomic_max_num_f64_rtn %address, %value {offset = 16}
  ds_max_f64 %offset, %value {offset = 16}
  %ds_max = ds_max_rtn_f64 %offset, %value {offset = 16}
  return
}

