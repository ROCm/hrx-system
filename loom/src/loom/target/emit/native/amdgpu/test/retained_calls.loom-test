// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx1100> @target

low.func.def pure target<amdgpu.rdna3.core>(@target) @increment(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %one = v_mov_b32 1
  %result = v_add_u32 %value, %one
  return %result
}

low.func.def pure target<amdgpu.rdna3.core>(@target) @exponential(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_exp_f32 %value
  return %result
}

low.func.def pure target<amdgpu.rdna3.core>(@target) @matrix_multiply(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %result = v_wmma_f32_16x16x16_f16 %lhs, %rhs, %acc
  return %result
}

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(64, 1, 1) @loom_kernel() asm {
  %value = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %incremented = low.func.call pure noinline @increment(%value) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %integer_sum = v_add_u32 %value, %incremented
  %exponential = low.func.call pure noinline @exponential(%value) : (reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>)
  %float_sum = v_add_f32 %value, %exponential
  %matrix = concat(%value, %value, %value, %value, %value, %value, %value, %value) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %matrix_result = low.func.call pure noinline @matrix_multiply(%matrix, %matrix, %matrix) : (reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>)
  %first = slice %matrix_result[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %partial = v_add_u32 %integer_sum, %float_sum
  %sum = v_add_u32 %partial, %first
  return
}

