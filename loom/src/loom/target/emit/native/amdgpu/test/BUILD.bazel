load(
    "//loom/build_tools/amdgpu:descriptor_sets.bzl",
    "loom_amdgpu_descriptor_set_compatible_with",
    "loom_amdgpu_iree_hal_representation_compatible_with",
)
load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY",
)
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = glob(["*.loom-test"]),
)

[
    loom_test(
        name = name + "_execution_test",
        srcs = [name + ".loom"],
        compile_targets = ["//loom/target/amdgpu:" + target],
        execution_profiles = [
            AMD_GPU_HARDWARE_PROFILE,
        ],
        target_compatible_with = loom_amdgpu_iree_hal_representation_compatible_with(
            LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY[descriptor_set],
        ),
    )
    for name, target, descriptor_set in [
        ("accumulator_atomic", "gfx942", "amdgpu.cdna3.core"),
        ("accumulator_memory", "gfx90a", "amdgpu.cdna2.core"),
        ("accumulator_moves", "gfx90a", "amdgpu.cdna2.core"),
        ("dot_wait_windows", "gfx90a", "amdgpu.cdna2.core"),
        ("invoke_results", "gfx11-generic", "amdgpu.gfx11.generic.core"),
        ("matrix_result_windows", "gfx90a", "amdgpu.cdna2.core"),
        ("operand_ties", "gfx1100", "amdgpu.rdna3.core"),
        ("retained_calls", "gfx11-generic", "amdgpu.gfx11.generic.core"),
        ("shift_allocation", "gfx90a", "amdgpu.cdna2.core"),
    ]
]

loom_test(
    name = "physical_exchange_execution_test",
    srcs = ["physical_exchange.loom"],
    compile_targets = ["//loom/target/amdgpu:gfx11-generic"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    target_compatible_with = loom_amdgpu_descriptor_set_compatible_with(
        LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"],
    ),
)
