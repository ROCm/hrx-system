  ds_read_b32 v2, v0 offset:12
.Lbb1:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v1, v1, v2
  ds_write_b32 v0, v1 offset:16
  s_endpgm

// ====

// Bounds between and after trailing issues shorten the backedge's pending
// suffix without invalidating its producer upper bound. Staged waits remain
// at the two fragment consumers, with no backedge copies forcing completion.
// RUN: emit amdgpu-assembly @authored_partial_loop_suffix
amdgpu.target<gfx1100> @target {subgroup_size = 32}

low.func.def target<amdgpu.rdna3.core>(@target) @authored_partial_loop_suffix(%address: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr x8>, %initial_acc: reg<amdgpu.vgpr x8>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr x8>) asm {
  %initial_first_low = ds_read_b128 %address
  %initial_first_high = ds_read_b128 %address {offset = 16}
  %initial_first = concat(%initial_first_low, %initial_first_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %initial_latest_low = ds_read_b128 %address {offset = 32}
  %initial_latest_high = ds_read_b128 %address {offset = 48}
  %initial_latest = concat(%initial_latest_low, %initial_latest_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  low.br ^loop(%initial_first: reg<amdgpu.vgpr x8>, %initial_latest: reg<amdgpu.vgpr x8>, %initial_acc: reg<amdgpu.vgpr x8>)
^loop(%first: reg<amdgpu.vgpr x8>, %latest: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x8>):
  %first_sum = v_wmma_f32_16x16x16_f16 %first, %rhs, %acc
  %sum = v_wmma_f32_16x16x16_f16 %latest, %rhs, %first_sum
  %next_first_low = ds_read_b128 %address {offset = 64}
  %next_first_high = ds_read_b128 %address {offset = 80}
  %next_first = concat(%next_first_low, %next_first_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  s_waitcnt {lgkmcnt = 1}
  %next_latest_low = ds_read_b128 %address {offset = 96}
  %next_latest_high = ds_read_b128 %address {offset = 112}
  %next_latest = concat(%next_latest_low, %next_latest_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  s_waitcnt {lgkmcnt = 1}
  low.cond_br %again, ^backedge, ^exit : reg<amdgpu.scc>
^backedge:
  low.br ^loop(%next_first: reg<amdgpu.vgpr x8>, %next_latest: reg<amdgpu.vgpr x8>, %sum: reg<amdgpu.vgpr x8>)
^exit:
  return %sum
}

