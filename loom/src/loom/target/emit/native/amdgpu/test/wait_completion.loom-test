// ====

// Counter completion is ordered even when physical result writes are not.
// The authored bound completes the older result without a duplicate wait.
// RUN: emit amdgpu-assembly @authored_partial_ordered_completion
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @authored_partial_ordered_completion(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %oldest = global_load_b32_saddr %address, %base
  %latest = global_load_b32_saddr %address, %base {offset = 4}
  s_wait_loadcnt {loadcnt = 1}
  %first_sum = v_add_u32 %oldest, %address
  %sum = v_add_u32 %first_sum, %latest
  return %sum
}

