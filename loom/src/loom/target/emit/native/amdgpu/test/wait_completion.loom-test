  s_load_dword s3, s[0:1], s2 offset:0
  s_load_dword s4, s[0:1], s2 offset:4
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s0, s3, s2
  s_add_u32 s0, s0, s4
  s_waitcnt vmcnt(63) lgkmcnt(1)
  s_endpgm

// ====

// Same-class VMEM result order is a target fact, not implied by a wait opcode.
// RUN: emit amdgpu-assembly @authored_partial_ordered_vector_results
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @authored_partial_ordered_vector_results(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %oldest = global_load_b32_saddr %address, %base
  %latest = global_load_b32_saddr %address, %base {offset = 4}
  s_waitcnt {vmcnt = 1}
  %first_sum = v_add_u32 %oldest, %address
  %sum = v_add_u32 %first_sum, %latest
  return %sum
}

