  ds_read_b128 v[24:27], v8 offset:0
  ds_read_b128 v[28:31], v8 offset:16
  ds_read_b128 v[32:35], v8 offset:32
  ds_read_b128 v[36:39], v8 offset:48
  s_waitcnt vmcnt(63) lgkmcnt(0)
.Lbb1:
  s_waitcnt vmcnt(63) lgkmcnt(2)
  v_wmma_f32_16x16x16_f16 v[0:7], v[24:31], v[16:23], v[0:7]
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_delay_alu instid0(VALU_DEP_1)
  v_wmma_f32_16x16x16_f16 v[0:7], v[32:39], v[16:23], v[0:7]
  ds_read_b128 v[24:27], v8 offset:64
  ds_read_b128 v[28:31], v8 offset:80
  s_waitcnt vmcnt(63) lgkmcnt(1)
  ds_read_b128 v[32:35], v8 offset:96
  ds_read_b128 v[36:39], v8 offset:112
  s_waitcnt vmcnt(63) lgkmcnt(1)
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_branch .Lbb1
.Lbb3:
  s_endpgm

// ====

// A partial threshold has its own progress action. It is neither elapsed work
// nor a full reset, including for a coupled counter with no local producers.
// RUN: emit amdgpu-wait-counter-plan-json @authored_bound_progress
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @authored_bound_progress(%address: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %oldest = ds_read_b32 %address
  %latest = ds_read_b32 %address {offset = 4}
  s_waitcnt {lgkmcnt = 1}
  %sum = v_add_u32 %oldest, %latest
  return %sum
}

