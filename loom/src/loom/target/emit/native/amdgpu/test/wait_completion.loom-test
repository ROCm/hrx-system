  ds_read_b32 v1, v0 offset:0
  ds_read_b32 v2, v0 offset:4
  s_wait_dscnt dscnt(1)
  v_add_u32 v1, v1, v0
  s_wait_dscnt dscnt(1)
  s_wait_dscnt dscnt(0)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v1, v1, v2
  ds_write_b32 v0, v1 offset:8
  s_endpgm

// ====

// A shared bound proves an ordered LDS prefix, not which scalar load finished.
// RUN: emit amdgpu-assembly @authored_partial_preserves_scalar_result
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @authored_partial_preserves_scalar_result(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>, %address: reg<amdgpu.vgpr>) asm {
  %scalar = s_load_dword %base, %offset
  %oldest = ds_read_b32 %address
  %latest = ds_read_b32 %address {offset = 4}
  s_waitcnt {lgkmcnt = 1}
  %first_sum = v_add_u32 %oldest, %address
  %scalar_sum = s_add_u32 %scalar, %offset
  %pair = v_add_u32 %first_sum, %latest
  %sum = v_add_u32 %scalar_sum, %pair
  ds_write_b32 %address, %sum {offset = 8}
  return
}

// ----
  ds_read_b32 v1, v0 offset:0
  ds_read_b32 v2, v0 offset:4
  s_load_dword s3, s[0:1], s2 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(1)
  v_add_u32 v1, v1, v0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s0, s3, s2
  s_waitcnt vmcnt(63) lgkmcnt(1)
  s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_add_u32 v1, v1, v2
  v_add_u32 v1, s0, v1
  ds_write_b32 v0, v1 offset:8
  s_endpgm

// ====

// Two scalar loads may complete out of order. A partial bound cannot retire
// the oldest scalar identity, even with no other memory classes in flight.
// RUN: emit amdgpu-assembly @authored_partial_scalar_order_is_unknown
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @authored_partial_scalar_order_is_unknown(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %oldest = s_load_dword %base, %offset
  %latest = s_load_dword %base, %offset {offset = 4}
  s_waitcnt {lgkmcnt = 1}
  %first_sum = s_add_u32 %oldest, %offset
  %sum = s_add_u32 %first_sum, %latest
  return %sum
}

