  s_endpgm

// ====

// A block with no local producer still has incoming work. A nonzero hardware
// bound must not be normalized to the local count of zero and become a reset.
// RUN: emit amdgpu-assembly @authored_partial_preserves_incoming_work
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @authored_partial_preserves_incoming_work(%address: reg<amdgpu.vgpr>) asm {
  %loaded = ds_read_b32 %address
  low.br ^bounded
^bounded:
  s_waitcnt {lgkmcnt = 1}
  low.br ^finish
^finish:
  %sum = v_add_u32 %loaded, %address
  ds_write_b32 %address, %sum {offset = 4}
  return
}

// ----
  ds_read_b32 v1, v0 offset:0
.Lbb1:
  s_waitcnt vmcnt(63) lgkmcnt(1)
.Lbb2:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_u32 v1, v1, v0
  ds_write_b32 v0, v1 offset:4
  s_endpgm

// ====

// Bounds greater than the local producer count and all-ones no-wait fields
// cannot claim completion. Repeating them does not change that fact.
// RUN: emit amdgpu-assembly @authored_loose_bounds_preserve_work
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @authored_loose_bounds_preserve_work(%address: reg<amdgpu.vgpr>) asm {
  s_waitcnt {lgkmcnt = 1}
  %loaded = ds_read_b32 %address
  s_waitcnt {lgkmcnt = 2}
  s_waitcnt {lgkmcnt = 2}
  s_waitcnt
  ds_write_b32 %address, %loaded {offset = 4}
  return
}

