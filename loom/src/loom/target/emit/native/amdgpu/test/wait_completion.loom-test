  s_waitcnt vmcnt(63) lgkmcnt(1)
  ds_read_b32 v1, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(2)
  s_waitcnt vmcnt(63) lgkmcnt(2)
  s_waitcnt vmcnt(63) lgkmcnt(63)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  ds_write_b32 v0, v1 offset:4
  s_endpgm

// ====

// Retirement continues across partial bounds and new issues in the same epoch.
// A later full drain starts a new epoch with independent pending work.
// RUN: emit amdgpu-assembly @authored_partial_then_new_work
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @authored_partial_then_new_work(%address: reg<amdgpu.vgpr>) asm {
  %oldest = ds_read_b32 %address
  %middle = ds_read_b32 %address {offset = 4}
  s_waitcnt {lgkmcnt = 1}
  %latest = ds_read_b32 %address {offset = 8}
  %first_sum = v_add_u32 %oldest, %address
  s_waitcnt {lgkmcnt = 1}
  %pair = v_add_u32 %first_sum, %middle
  %sum = v_add_u32 %pair, %latest
  %next = ds_read_b32 %address {offset = 12}
  low.br ^finish
^finish:
  %total = v_add_u32 %sum, %next
  ds_write_b32 %address, %total {offset = 16}
  return
}

// ----
  ds_read_b32 v1, v0 offset:0
  ds_read_b32 v2, v0 offset:4
  s_waitcnt vmcnt(63) lgkmcnt(1)
  v_add_u32 v1, v1, v0
  s_waitcnt vmcnt(63) lgkmcnt(1)
  ds_read_b32 v3, v0 offset:8
  s_waitcnt vmcnt(63) lgkmcnt(1)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v1, v1, v2
  s_waitcnt vmcnt(63) lgkmcnt(1)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_delay_alu instid0(VALU_DEP_1)
