// ====

// A counter instruction orders issue but its partial threshold cannot hide
// the pending memory dependency from a later read.
// RUN: emit amdgpu-assembly @partial_wait_memory_dependency
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @partial_wait_memory_dependency(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  ds_write_b32 %address, %value
  s_waitcnt {lgkmcnt = 1}
  %loaded = ds_read_b32 %address
  return %loaded
}

