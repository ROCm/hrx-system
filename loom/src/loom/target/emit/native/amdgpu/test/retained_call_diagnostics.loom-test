// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx1100> @target

low.func.decl target<amdgpu.rdna3.core>(@target) @declared()

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(64, 1, 1) @calls_declaration() asm {
  // ERROR@+1: AMDGPU/054 {function_name="calls_declaration", callee_name="declared", reason_key="not-low-function-definition"}
  low.func.call noinline @declared() : ()
  return
}

// ====

// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @leaf() asm {
  return
}

low.func.def target<amdgpu.rdna3.core>(@target) @nested() asm {
  // ERROR@+1: AMDGPU/057 {helper_name="nested", callee_name="leaf"}
  low.func.call noinline @leaf() : ()
  return
}

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(64, 1, 1) @calls_nested() asm {
  low.func.call noinline @nested() : ()
  return
}

// ====

// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx1100> @target

// ERROR@+1: AMDGPU/056 {entry_name="target_mismatch", helper_name="other_target"}
low.func.def target<amdgpu.gfx11.generic.core>(@target) @other_target() asm {
  return
}

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(64, 1, 1) @target_mismatch() asm {
  low.func.call noinline @other_target() : ()
  return
}

// ====

// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx90a> @target

// ERROR@+1: AMDGPU/055 {function_name="accumulator_argument", side="argument", index="0", reason_key="unsupported-carrier"}
low.func.def target<amdgpu.cdna2.core>(@target) @accumulator_argument(%value: reg<amdgpu.agpr>) asm {
  return
}

low.kernel.def target<amdgpu.cdna2.core>(@target) workgroup_size(64, 1, 1) @passes_accumulator() asm {
  %vector = v_mov_b32 1
  %accumulator = copy %vector : reg<amdgpu.vgpr> -> reg<amdgpu.agpr>
  low.func.call noinline @accumulator_argument(%accumulator) : (reg<amdgpu.agpr>)
  return
}

// ====

// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @workgroup_storage() asm {
  %storage = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  return
}

low.kernel.def target<amdgpu.rdna3.core>(@target) workgroup_size(64, 1, 1) @calls_workgroup_storage() asm {
  // ERROR@+1: AMDGPU/054 {function_name="calls_workgroup_storage", callee_name="workgroup_storage", reason_key="workgroup-storage"}
  low.func.call noinline @workgroup_storage() : ()
  return
}
