0x000C0000
0x00000000
0xBFC00000
0xEE0B007C
0x000C0000
0x00000000
0xBFC10000
0xBFB00000

// ====

// The corresponding CDNA controls and both completion waits encode with VM_CNT.
// RUN: emit amdgpu-native-words @buffer_cache_native_words
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @buffer_cache_native_words() asm {
  buffer_inv {sc0 = 1, sc1 = 1}
  buffer_wbl2 {sc0 = 1, sc1 = 1}
  return
}

