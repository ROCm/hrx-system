// Returned messages write SGPRs asynchronously. Ordinary SSA use requires a
// completion wait even though the instruction has no memory alias.
// RUN: emit amdgpu-assembly @message_result strategy=source
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @message_result(%mask: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %doorbell = s_sendmsg_rtn_b32 {message = 128}
  %identifier = s_and_b32 %doorbell, %mask
  return %identifier
}

// ----
  s_sendmsg_rtn_b32 s1, message(128)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_and_b32 s0, s1, s0
  s_endpgm

// ====

// RDNA4 splits scalar/message completion from LDS completion.
// RUN: emit amdgpu-assembly @message_result strategy=source
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @message_result(%mask: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %doorbell = s_sendmsg_rtn_b32 {message = 128}
  %identifier = s_and_b32 %doorbell, %mask
  return %identifier
}

// ----
  s_sendmsg_rtn_b32 s1, message(128)
  s_wait_kmcnt kmcnt(0)
  s_and_b32 s0, s1, s0
  s_endpgm

// ====

// Completion before issue cannot release a later message. A partial wait does
// not prove that an out-of-order scalar/message result is ready.
// RUN: emit amdgpu-assembly @partial_message_wait strategy=source
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @partial_message_wait(%mask: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  s_waitcnt {lgkmcnt = 0}
  %clock = s_sendmsg_rtn_b32 {message = 131}
  s_waitcnt {lgkmcnt = 1}
  %bounded = s_and_b32 %clock, %mask
  return %bounded
}

// ----
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_sendmsg_rtn_b32 s1, message(131)
  s_waitcnt vmcnt(63) lgkmcnt(1)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_and_b32 s0, s1, s0
  s_endpgm

// ====

// An unconsumed message result still owns its destination until completion.
// Keeping the input live makes ordinary allocation reuse that destination for
// the replacement in the successor block.
// RUN: emit amdgpu-assembly @message_destination_reuse strategy=source
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @message_destination_reuse(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %clock = s_sendmsg_rtn_b32 {message = 131}
  low.br ^clobber
^clobber:
  %replacement = s_add_u32 %input, %input
  return %replacement, %input
}

// ----
  s_sendmsg_rtn_b32 s1, message(131)
.Lbb1:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s1, s0, s0
  s_endpgm

// ====

// Only one predecessor completed the result. An empty memory alias frontier
// does not prove that the incoming message result is ready at the join.
// RUN: emit amdgpu-assembly @message_join strategy=source
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @message_join(%input: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %clock = s_sendmsg_rtn_b32 {message = 131}
  %condition = s_cmp_lt_i32 %input, %limit
  low.cond_br %condition, ^drain, ^pending : reg<amdgpu.scc>
^drain:
  s_waitcnt {lgkmcnt = 0}
  low.br ^join
^pending:
  low.br ^join
^join:
  %result = s_add_u32 %clock, %input
  return %result
}

// ----
  s_sendmsg_rtn_b32 s2, message(131)
  s_cmp_lt_i32 s1, s0
  s_delay_alu instid0(SALU_CYCLE_1)
  s_cbranch_scc0 .Lbb2
.Lbb1:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_branch .Lbb3
.Lbb2:
.Lbb3:
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s0, s2, s1
  s_endpgm

// ====

// Fire-and-forget messages also advance LGKM/KM. A later control barrier must
// account for them even though they have neither memory aliases nor SSA results.
// RUN: emit amdgpu-assembly @message_send strategy=source
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @message_send(%input: reg<amdgpu.sgpr>) asm {
  %payload = s_mov_b32_m0 %input
  s_sendmsg %payload {message = 1}
  s_dcache_inv
  return
}

// ----
  s_mov_b32 m0, s0
  s_sendmsg message(1)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_dcache_inv
  s_endpgm

// ====

// Reading the clock preserves pending prefetches. Its LGKM completion also
// completes earlier scalar/LDS reads, but the global load waits at its own use.
// RUN: emit amdgpu-assembly @clock_during_prefetch strategy=source
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @clock_during_prefetch(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>, %address: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %global = global_load_b32_saddr %address, %base
  %local = ds_read_b32 %address
  %scalar = s_load_dword %base, %offset
  %clock = s_sendmsg_rtn_b32 {message = 131}
  %tick = s_add_u32 %clock, %offset
  %count = s_add_u32 %scalar, %tick
  %sum = v_add_u32 %global, %local
  return %count, %sum
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  ds_read_b32 v0, v0 offset:0
  s_load_dword s3, s[0:1], s2 offset:0
  s_sendmsg_rtn_b32 s0, message(131)
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s0, s0, s2
  s_add_u32 s0, s3, s0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v1, v0
  s_endpgm

// ====

// On RDNA4, returned messages and scalar reads use KM; LDS and global reads
// retain independent completion. Both halves of the timestamp remain live.
// RUN: emit amdgpu-assembly @wide_clock_during_prefetch strategy=source
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @wide_clock_during_prefetch(%base: reg<amdgpu.sgpr x2>, %mask: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>, %address: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %global = global_load_b32_saddr %address, %base
  %local = ds_read_b32 %address
  %scalar = s_load_dword %base, %offset
  %clock = s_sendmsg_rtn_b64 {message = 131}
  %tick = s_and_b64 %clock, %mask
  %count = s_add_u32 %scalar, %offset
  %sum = v_add_u32 %global, %local
  return %tick, %count, %sum
}

// ----
  global_load_b32 v1, v0, s[0:1] offset:0
  ds_read_b32 v0, v0 offset:0
  s_load_dword s5, s[0:1], s4 offset:0
  s_sendmsg_rtn_b64 s[0:1], message(131)
  s_wait_kmcnt kmcnt(0)
  s_and_b64 s[0:1], s[0:1], s[2:3]
  s_add_u32 s2, s5, s4
  s_wait_loadcnt loadcnt(0)
  s_wait_dscnt dscnt(0)
  v_add_u32 v0, v1, v0
  s_endpgm
