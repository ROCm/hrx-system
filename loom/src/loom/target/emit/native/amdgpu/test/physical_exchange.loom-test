// RUN: emit amdgpu-assembly @saturated_bank strategy=source fixed=%left:physical_register:0:4 fixed=%right:physical_register:4:4 fixed=%pressure:physical_register:8:248 fixed=%result:physical_register:0:8

amdgpu.target<gfx1151> @target {subgroup_size = 32}

// All 256 registers are live. Four disjoint cycles need no scratch register.
low.func.def target<amdgpu.rdna3_5.core>(@target) @saturated_bank(%left: reg<amdgpu.vgpr x4>, %right: reg<amdgpu.vgpr x4>, %pressure: reg<amdgpu.vgpr x248>) -> (reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x248>) asm {
  %result = concat(%right, %left) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  return %result, %pressure
}

// ----
  v_swap_b32 v4, v0
  v_swap_b32 v5, v1
  v_swap_b32 v6, v2
  v_swap_b32 v7, v3
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @exchange_dependencies strategy=source fixed=%fresh:physical_register:0:1 fixed=%other:physical_register:1:1 fixed=%result:physical_register:0:2

amdgpu.target<gfx1151> @target {subgroup_size = 32}

// Each input can carry a pending VALU result, and either output can be read
// immediately. Both results belong to the same native issue.
low.func.def target<amdgpu.rdna3_5.core>(@target) @exchange_dependencies(%input: reg<amdgpu.vgpr>, %other: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>) asm {
  %fresh = v_add_f32 %input, %input
  %result = concat(%other, %fresh) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %selected = slice %result[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %doubled = v_add_f32 %selected, %selected
  return %doubled, %result
}

// ----
  v_add_f32 v0, v0, v0
  s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_swap_b32 v1, v0
  v_add_f32 v3, v0, v0
  s_endpgm

// ====

