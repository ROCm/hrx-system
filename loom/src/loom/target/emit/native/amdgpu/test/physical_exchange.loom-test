// RUN: emit amdgpu-assembly @exchange_load_result strategy=source fixed=%address:physical_register:2:1 fixed=%loaded:physical_register:0:1 fixed=%other:physical_register:1:1 fixed=%result:physical_register:0:2

amdgpu.target<gfx1250> @target {subgroup_size = 32}

// Either exchange read can consume an outstanding asynchronous result.
low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @exchange_load_result(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %other: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %loaded = global_load_b32_saddr %address, %base
  %result = concat(%other, %loaded) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ----
  global_load_b32 v0, v2, s[0:1] offset:0
  s_wait_loadcnt loadcnt(0)
  v_swap_b32 v1, v0
  s_endpgm

