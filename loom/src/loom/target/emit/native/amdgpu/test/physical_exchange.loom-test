// A loop-carried permutation produces a real physical exchange without
// constraining allocation from the test harness.
// RUN: emit amdgpu-assembly @cycle

amdgpu.target<gfx1151> @target {subgroup_size = 32}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @cycle(%left: reg<amdgpu.vgpr>, %right: reg<amdgpu.vgpr>) asm {
  low.br ^header(%left: reg<amdgpu.vgpr>, %right: reg<amdgpu.vgpr>)
^header(%current_left: reg<amdgpu.vgpr>, %current_right: reg<amdgpu.vgpr>):
  low.br ^header(%current_right: reg<amdgpu.vgpr>, %current_left: reg<amdgpu.vgpr>)
}

// ----
.Lbb1:
  v_swap_b32 v1, v0
  s_branch .Lbb1

// ====

// An exchange waits for a pending VALU producer before reading either word.
// RUN: emit amdgpu-assembly @valu_cycle

amdgpu.target<gfx1151> @target {subgroup_size = 32}

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @valu_cycle(%left: reg<amdgpu.vgpr>, %right: reg<amdgpu.vgpr>) asm {
  low.br ^header(%left: reg<amdgpu.vgpr>, %right: reg<amdgpu.vgpr>)
^header(%current_left: reg<amdgpu.vgpr>, %current_right: reg<amdgpu.vgpr>):
  %fresh = v_add_f32 %current_left, %current_left
  low.br ^header(%current_right: reg<amdgpu.vgpr>, %fresh: reg<amdgpu.vgpr>)
}

// ----
.Lbb1:
  v_add_f32 v0, v0, v0
  s_delay_alu instid0(VALU_DEP_1)
  v_swap_b32 v1, v0
  s_branch .Lbb1

// ====

// An exchange waits before consuming either asynchronous load result.
// RUN: emit amdgpu-assembly @load_cycle

amdgpu.target<gfx1250> @target {subgroup_size = 32}

low.func.def schedule(locked) target<amdgpu.rdna4.gfx125x.core>(@target) @load_cycle(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %other: reg<amdgpu.vgpr>) asm {
  %loaded = global_load_b32_saddr %address, %base
  low.br ^header(%loaded: reg<amdgpu.vgpr>, %other: reg<amdgpu.vgpr>)
^header(%current_loaded: reg<amdgpu.vgpr>, %current_other: reg<amdgpu.vgpr>):
  low.br ^header(%current_other: reg<amdgpu.vgpr>, %current_loaded: reg<amdgpu.vgpr>)
}

// ----
  global_load_b32 v2, v0, s[0:1] offset:0
  s_wait_loadcnt loadcnt(0)
.Lbb1:
  v_swap_b32 v1, v2
  s_branch .Lbb1

// ====

// Both exchange writes honor an outstanding store's source lease.
// RUN: emit amdgpu-assembly @store_cycle

amdgpu.target<gfx1250> @target {subgroup_size = 32}

low.func.def schedule(locked) target<amdgpu.rdna4.gfx125x.core>(@target) @store_cycle(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %stored: reg<amdgpu.vgpr>, %other: reg<amdgpu.vgpr>) asm {
  global_store_b32_saddr %address, %stored, %base
  low.br ^header(%stored: reg<amdgpu.vgpr>, %other: reg<amdgpu.vgpr>)
^header(%current_stored: reg<amdgpu.vgpr>, %current_other: reg<amdgpu.vgpr>):
  low.br ^header(%current_other: reg<amdgpu.vgpr>, %current_stored: reg<amdgpu.vgpr>)
}

// ----
  global_store_b32 v0, v1, s[0:1] offset:0
.Lbb1:
  s_wait_xcnt xcnt(0)
  v_swap_b32 v2, v1
  s_branch .Lbb1

// ====

// Every exchange read observes the MFMA result window.
// RUN: emit amdgpu-assembly @mfma_result_cycle

amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @mfma_result_cycle(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr x4>, %other: reg<amdgpu.vgpr x4>) asm {
  %matrix = v_mfma_f32_16x16x4f32 %lhs, %rhs, %seed : reg<amdgpu.vgpr x4>
  low.br ^header(%matrix: reg<amdgpu.vgpr x4>, %other: reg<amdgpu.vgpr x4>)
^header(%current_matrix: reg<amdgpu.vgpr x4>, %current_other: reg<amdgpu.vgpr x4>):
  low.br ^header(%current_other: reg<amdgpu.vgpr x4>, %current_matrix: reg<amdgpu.vgpr x4>)
}

// ----
  v_mfma_f32_16x16x4f32 v[12:15], v0, v1, v[4:7]
.Lbb1:
  s_nop 10
  v_swap_b32 v8, v12
  v_swap_b32 v9, v13
  v_swap_b32 v10, v14
  v_swap_b32 v11, v15
  s_branch .Lbb1

// ====

// Every exchange write observes the MFMA accumulator-source window.
// RUN: emit amdgpu-assembly @mfma_source_cycle

amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @mfma_source_cycle(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr x4>, %other: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %matrix = v_mfma_f32_16x16x4f32 %lhs, %rhs, %seed : reg<amdgpu.vgpr x4>
  low.br ^header(%seed: reg<amdgpu.vgpr x4>, %other: reg<amdgpu.vgpr x4>)
^header(%current_seed: reg<amdgpu.vgpr x4>, %current_other: reg<amdgpu.vgpr x4>):
  low.br ^header(%current_other: reg<amdgpu.vgpr x4>, %current_seed: reg<amdgpu.vgpr x4>)
}

// ----
  v_mfma_f32_16x16x4f32 v[12:15], v0, v1, v[4:7]
.Lbb1:
  s_nop 6
  v_swap_b32 v8, v4
  v_swap_b32 v9, v5
  v_swap_b32 v10, v6
  v_swap_b32 v11, v7
  s_branch .Lbb1

// ====

// WMMA coexecution protects results read by every half of an exchange.
// RUN: emit amdgpu-assembly @wmma_result_cycle

amdgpu.target<gfx1250> @target {subgroup_size = 32}

low.func.def schedule(locked) target<amdgpu.rdna4.gfx125x.core>(@target) @wmma_result_cycle(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %seed: reg<amdgpu.vgpr x8>, %other: reg<amdgpu.vgpr x8>) asm {
  %matrix = v_wmma_f32_16x16x32_bf16 %lhs, %rhs, %seed
  low.br ^header(%matrix: reg<amdgpu.vgpr x8>, %other: reg<amdgpu.vgpr x8>)
^header(%current_matrix: reg<amdgpu.vgpr x8>, %current_other: reg<amdgpu.vgpr x8>):
  low.br ^header(%current_other: reg<amdgpu.vgpr x8>, %current_matrix: reg<amdgpu.vgpr x8>)
}

// ----
  v_wmma_f32_16x16x32_bf16 v[16:23], v[0:7], v[8:15], v[16:23]
.Lbb1:
  v_nop
  v_nop
  v_nop
  v_nop
  v_swap_b32 v24, v16
  v_swap_b32 v25, v17
  v_swap_b32 v26, v18
  v_swap_b32 v27, v19
  v_swap_b32 v28, v20
  v_swap_b32 v29, v21
  v_swap_b32 v30, v22
  v_swap_b32 v31, v23
  s_branch .Lbb1

// ====

// WMMA coexecution also protects source registers overwritten by an exchange.
// RUN: emit amdgpu-assembly @wmma_source_cycle

amdgpu.target<gfx1250> @target {subgroup_size = 32}

low.func.def schedule(locked) target<amdgpu.rdna4.gfx125x.core>(@target) @wmma_source_cycle(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %seed: reg<amdgpu.vgpr x8>, %other: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %matrix = v_wmma_f32_16x16x32_bf16 %lhs, %rhs, %seed
  low.br ^header(%lhs: reg<amdgpu.vgpr x8>, %other: reg<amdgpu.vgpr x8>)
^header(%current_lhs: reg<amdgpu.vgpr x8>, %current_other: reg<amdgpu.vgpr x8>):
  low.br ^header(%current_other: reg<amdgpu.vgpr x8>, %current_lhs: reg<amdgpu.vgpr x8>)
}

// ----
  v_wmma_f32_16x16x32_bf16 v[8:15], v[16:23], v[0:7], v[8:15]
.Lbb1:
  v_nop
  v_nop
  v_nop
  v_nop
  v_swap_b32 v24, v16
  v_swap_b32 v25, v17
  v_swap_b32 v26, v18
  v_swap_b32 v27, v19
  v_swap_b32 v28, v20
  v_swap_b32 v29, v21
  v_swap_b32 v30, v22
  v_swap_b32 v31, v23
  s_branch .Lbb1
