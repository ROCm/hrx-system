// Incoming edges exchange two live words across CDNA and RDNA profiles.
// High-bank exchanges select both MODE slots and restore the incoming MODE.
// RUN: emit amdgpu-assembly @exchange strategy=source fixed=%first:physical_register:0:1 fixed=%second:physical_register:255:1 fixed=%carried_first:physical_register:255:1 fixed=%carried_second:physical_register:0:1

amdgpu.target<gfx90a> @target {subgroup_size = 64}

low.func.def target<amdgpu.cdna2.core>(@target) @exchange(%first: reg<amdgpu.vgpr>, %second: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  low.br ^next(%first: reg<amdgpu.vgpr>, %second: reg<amdgpu.vgpr>)
^next(%carried_first: reg<amdgpu.vgpr>, %carried_second: reg<amdgpu.vgpr>):
  return %carried_first, %carried_second
}

// ----
  v_swap_b32 v0, v255
.Lbb1:
  s_endpgm

// ====

