// RUN: emit amdgpu-assembly @exchange_matrix_result strategy=source fixed=%lhs:physical_register:8:1 fixed=%rhs:physical_register:9:1 fixed=%seed:physical_register:0:4 fixed=%matrix:physical_register:0:4 fixed=%other:physical_register:4:4 fixed=%tuple:physical_register:0:8

amdgpu.target<gfx90a> @target

// Either exchange input can consume a pending MFMA result.
low.func.def target<amdgpu.cdna2.core>(@target) @exchange_matrix_result(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr x4>, %other: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x8>) asm {
  %matrix = v_mfma_f32_16x16x4f32 %lhs, %rhs, %seed
  %tuple = concat(%other, %matrix) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  return %tuple
}

// ----
  v_mfma_f32_16x16x4f32 v[0:3], v8, v9, v[0:3]
  s_nop 10
  v_swap_b32 v4, v0
  v_swap_b32 v5, v1
  v_swap_b32 v6, v2
  v_swap_b32 v7, v3
  s_endpgm

