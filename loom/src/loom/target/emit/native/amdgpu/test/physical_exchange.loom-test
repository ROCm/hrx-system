amdgpu.target<gfx1250> @target {subgroup_size = 32}

// Both exchange writes honor an outstanding store's source lease.
low.func.def target<amdgpu.rdna4.gfx125x.core>(@target) @exchange_store_source(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %stored: reg<amdgpu.vgpr>, %other: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  global_store_b32_saddr %address, %stored, %base
  %result = concat(%other, %stored) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

// ----
  global_store_b32 v2, v0, s[0:1] offset:0
  s_wait_xcnt xcnt(0)
  v_swap_b32 v1, v0
  s_wait_storecnt storecnt(0)
  s_endpgm

