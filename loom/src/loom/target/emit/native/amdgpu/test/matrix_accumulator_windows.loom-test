// Independent C/D storage retains the accumulator input until hardware
// finishes reading it, including across control-flow edges. Accumulator inputs
// precede other live operands so ordinary allocation naturally reuses their
// dead storage for the replacement writes under test.

// RUN: emit amdgpu-assembly @two_pass_input strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @two_pass_input(%seed: reg<amdgpu.vgpr x4>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %result = v_mfma_f32_4x4x1f32 %lhs, %rhs, %seed : reg<amdgpu.vgpr x4>
  %replacement = v_mov_b32 42
  return %result, %replacement, %lhs, %rhs
}

// ----
  v_mfma_f32_4x4x1f32 v[8:11], v4, v5, v[0:3]
  s_nop 0
  v_mov_b32 v0, 42
  s_nop 2
  s_endpgm

