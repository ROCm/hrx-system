// RUN: emit amdgpu-assembly @backedge_retains_input strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @backedge_retains_input(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %again: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr x4>) asm {
  low.br ^header
^header:
  %word = v_mov_b32 42
  %seed = concat(%word, %word, %word, %word) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %seed : reg<amdgpu.vgpr x4>
  low.cond_br %again, ^header, ^done : reg<amdgpu.scc>
^done:
  return %result
}

