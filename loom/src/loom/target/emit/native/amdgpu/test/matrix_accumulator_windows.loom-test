// RUN: emit amdgpu-assembly @join_retains_input strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @join_retains_input(%seed: reg<amdgpu.vgpr x4>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %choice: reg<amdgpu.scc>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  low.cond_br %choice, ^slow, ^fast : reg<amdgpu.scc>
^slow:
  %long = v_mfma_f32_16x16x4f32 %lhs, %rhs, %seed : reg<amdgpu.vgpr x4>
  low.br ^join(%long: reg<amdgpu.vgpr x4>)
^fast:
  %short = v_mfma_f32_4x4x1f32 %lhs, %rhs, %seed : reg<amdgpu.vgpr x4>
  low.br ^join(%short: reg<amdgpu.vgpr x4>)
^join(%carried: reg<amdgpu.vgpr x4>):
  %replacement = v_mov_b32 42
  return %carried, %replacement, %lhs, %rhs
}

