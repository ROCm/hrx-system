// RUN: emit amdgpu-assembly @empty_edges_retain_input strategy=source
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @empty_edges_retain_input(%seed: reg<amdgpu.vgpr x4>, %lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %seed : reg<amdgpu.vgpr x4>
  low.br ^empty
^empty:
  low.br ^next
^next:
  %replacement = v_mov_b32 42
  return %result, %replacement, %lhs, %rhs
}

