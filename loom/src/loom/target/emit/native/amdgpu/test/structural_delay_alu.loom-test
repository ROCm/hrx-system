// RUN: emit amdgpu-wait-state-plan @identity_edge strategy=source
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @identity_edge(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %accumulator: reg<amdgpu.vgpr x8>, %step: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x8>, reg<amdgpu.sgpr>) asm {
  %result = v_wmma_f32_16x16x16_bf16 %lhs, %rhs, %accumulator
  low.br ^next(%result: reg<amdgpu.vgpr x8>, %step: reg<amdgpu.sgpr>)
^next(%carried_accumulator: reg<amdgpu.vgpr x8>, %carried_step: reg<amdgpu.sgpr>):
  return %carried_accumulator, %carried_step
}

