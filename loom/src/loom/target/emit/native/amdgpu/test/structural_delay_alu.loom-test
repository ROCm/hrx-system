// RUN: emit amdgpu-wait-state-plan @identity_edge_retains_matrix_wait strategy=source
amdgpu.target<gfx942> @target

// Coalesced block arguments carry the pending result window to the return.
low.func.def target<amdgpu.cdna3.core>(@target) @identity_edge_retains_matrix_wait(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>, %accumulator: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x4>) asm {
  %result = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %accumulator
  low.br ^next(%result: reg<amdgpu.vgpr x4>)
^next(%carried: reg<amdgpu.vgpr x4>):
  return %carried
}

