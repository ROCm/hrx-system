  %produced = v_add_f32 %input, %input
  %tuple = concat(%produced, %filler) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %first = slice %tuple[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
