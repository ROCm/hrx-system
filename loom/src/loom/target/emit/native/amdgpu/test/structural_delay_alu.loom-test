// RUN: emit amdgpu-wait-state-plan @conditional_branch_reads_scc strategy=source
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @conditional_branch_reads_scc(%index: reg<amdgpu.sgpr>, %limit: reg<amdgpu.sgpr>) asm {
  %more = s_cmp_lt_i32 %index, %limit
  low.cond_br %more, ^again, ^done : reg<amdgpu.scc>
^again:
  return
^done:
  return
}

