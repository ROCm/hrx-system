// RUN: with-checks emit amdgpu-wait-state-plan @cycle_scratch_overwrites_old_producer strategy=source fixed=%stale:physical_register:0:1 fixed=%first:physical_register:1:1 fixed=%second:physical_register:2:1 fixed=%swapped:physical_register:1:2
amdgpu.target<gfx1151> @target

// The cycle saves v1 into v0 before reading v0. Its previous producer is not
// an input to the move group.
low.func.def target<amdgpu.rdna3_5.core>(@target) @cycle_scratch_overwrites_old_producer(%input: reg<amdgpu.vgpr>, %first: reg<amdgpu.vgpr>, %second: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.sgpr>) asm {
  %stale = v_add_f32 %input, %input
  %gap = s_mov_b32 0
  %swapped = concat(%second, %first) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %swapped, %gap
}

// ----
CHECK: amdgpu.wait_state_plan states=0 *

// ====

// RUN: with-checks emit amdgpu-wait-state-plan @cycle_input_and_result_dependencies strategy=source fixed=%produced:physical_register:1:1 fixed=%second:physical_register:2:1 fixed=%scale:physical_register:3:1 fixed=%swapped:physical_register:1:2 fixed=%last:physical_register:2:1
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @cycle_input_and_result_dependencies(%input: reg<amdgpu.vgpr>, %second: reg<amdgpu.vgpr>, %scale: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %produced = v_add_f32 %input, %input
  %swapped = concat(%second, %produced) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %last = slice %swapped[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_mul_f32 %last, %scale
  return %result
}

