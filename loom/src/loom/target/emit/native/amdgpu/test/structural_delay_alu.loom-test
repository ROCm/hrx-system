amdgpu.wait_state_plan states=0 progress=2 hazards=0

// ====

// RUN: emit amdgpu-wait-state-plan @coalesced_input_keeps_producer strategy=source
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @coalesced_input_keeps_producer(%input: reg<amdgpu.vgpr>, %filler: reg<amdgpu.vgpr>, %scale: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %produced = v_add_f32 %input, %input
  %tuple = concat(%produced, %filler) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %first = slice %tuple[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %result = v_mul_f32 %first, %scale
  return %result
}

