// RUN: emit amdgpu-wait-state-plan @result_operand strategy=source
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @result_operand(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>) asm {
  %lane = v_readfirstlane_b32 %input
  %sum = s_add_u32 %lane, %lane
  return %sum
}

