// RUN: emit amdgpu-wait-state-plan @cycle_ignores_unread_producer strategy=source
amdgpu.target<gfx1151> @target

// The exchange reads only v1 and v2; the producer in v0 is not an input.
low.func.def target<amdgpu.rdna3_5.core>(@target) @cycle_ignores_unread_producer(%input: reg<amdgpu.vgpr>, %first: reg<amdgpu.vgpr>, %second: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.sgpr>) asm {
  %stale = v_add_f32 %input, %input
  %gap = s_mov_b32 0
  %swapped = concat(%second, %first) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %swapped, %gap
}

