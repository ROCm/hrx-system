// RUN: emit amdgpu-wait-state-plan @fixed_destination_move strategy=source fixed=%input:physical_register:0:1 fixed=%tuple:physical_register:122:2 fixed=%sum:physical_register:108:1
amdgpu.target<gfx1201> @target

low.func.def target<amdgpu.rdna4.core>(@target) @fixed_destination_move(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %tuple = concat(%input, %input) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %first = slice %tuple[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %last = slice %tuple[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %sum = s_add_u32 %first, %last
  return %sum
}

