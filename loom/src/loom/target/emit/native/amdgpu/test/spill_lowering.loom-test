  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v0, v0, v2
  scratch_load_b32 v1, off, off offset:4
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_add_u32 v0, v0, v1
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====

// Private and scratch declarations share a segment; nested views keep their
// original alignment and byte range when repair extends that segment.
// RUN: emit amdgpu-assembly @storage_views_survive_spill_repair strategy=source amdgpu.sgpr=8
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @storage_views_survive_spill_repair(%lhs0: reg<amdgpu.vgpr>, %rhs0: reg<amdgpu.vgpr>, %lhs1: reg<amdgpu.vgpr>, %rhs1: reg<amdgpu.vgpr>, %lhs2: reg<amdgpu.vgpr>, %rhs2: reg<amdgpu.vgpr>, %lhs3: reg<amdgpu.vgpr>, %rhs3: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %padding = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  low.br ^body
^body:
  %storage = storage {byte_alignment = 16, byte_length = 32} : low.storage<scratch>
  %outer = storage_view %storage {byte_length = 16, offset = 8} : low.storage<scratch> -> low.storage<scratch>
  %manual = storage_view %outer {byte_length = 8, offset = 4} : low.storage<scratch> -> low.storage<scratch>
  %mask0 = v_cmp_lt_u32 %lhs0, %rhs0
  low.spill %mask0, %manual : reg<amdgpu.sgpr x2>, low.storage<scratch>
  %mask1 = v_cmp_lt_u32 %lhs1, %rhs1
  %mask2 = v_cmp_lt_u32 %lhs2, %rhs2
  %mask3 = v_cmp_lt_u32 %lhs3, %rhs3
  %and01 = s_and_b64 %mask0, %mask1
  %and23 = s_and_b64 %mask2, %mask3
  %and0123 = s_and_b64 %and01, %and23
  %and4 = s_and_b64 %and0123, %mask0
  %and5 = s_and_b64 %and4, %mask1
  %result = s_and_b64 %and5, %mask2
  %manual_reload = low.reload %manual : low.storage<scratch> -> reg<amdgpu.sgpr x2>
  %with_manual = s_xor_b64 %result, %manual_reload
  return %with_manual
}

