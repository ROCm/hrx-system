// ====

// Wave-wide SGPR spill traffic must not alias VGPR storage retained in lanes
// retired from a divergent loop. The ordinary sparse lifetime for
// %retired_value has a gap at the spill, but its physical storage still carries
// the loop result for those inactive lanes.
// RUN: emit amdgpu-assembly @sgpr_spill_preserves_retired_lanes

amdgpu.target<gfx11-generic> @gfx11_retired_lane_target {subgroup_size = 64}

low.func.def target<amdgpu.gfx11.generic.core>(@gfx11_retired_lane_target) @sgpr_spill_preserves_retired_lanes(%upper_bound: reg<amdgpu.vgpr>, %uniform: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 8} : low.storage<private>
  %zero = v_mov_b32 0
  %one = v_mov_b32 1
  %saved_exec = s_mov_b64_exec_read
  low.br ^header(%zero: reg<amdgpu.vgpr>, %zero: reg<amdgpu.vgpr>)
^header(%position: reg<amdgpu.vgpr>, %retired_value: reg<amdgpu.vgpr>):
  %active = v_cmp_lt_i32 %position, %upper_bound
  %masked_exec, %any_active = s_and_saveexec_b64 %active
  low.cond_br %any_active, ^body, ^exit : reg<amdgpu.scc>
^body:
  low.spill %uniform, %storage : reg<amdgpu.sgpr x2>, low.storage<private>
  %reload = low.reload %storage : low.storage<private> -> reg<amdgpu.sgpr x2>
  %next_value = v_add_u32 %position, %one
  %next_position = v_add_u32 %one, %position
  low.br ^header(%next_position: reg<amdgpu.vgpr>, %next_value: reg<amdgpu.vgpr>)
^exit:
  s_mov_b64_exec %saved_exec
  return %retired_value
}

// ----
  v_mov_b32 v1, 0
  v_mov_b32 v2, 1
  s_mov_b64_exec_read s[2:3]
  s_delay_alu instid0(VALU_DEP_2)
  v_mov_b32 v3, v1
.Lbb1:
  v_cmp_lt_i32 s[4:5], v1, v0
  s_delay_alu instid0(VALU_DEP_1)
  s_and_saveexec_b64 s[4:5], s[4:5]
  s_cbranch_scc0 .Lbb3
.Lbb2:
  s_mov_b64_exec_read s[4:5]
  s_mov_b64 exec, -1
  v_mov_b32 v4, s0
  v_mov_b32 v5, s1
  scratch_store_b32 off, v4, off offset:0
  scratch_store_b32 off, v5, off offset:4
  s_mov_b64 exec, s[4:5]
  s_mov_b64_exec_read s[4:5]
  s_mov_b64 exec, -1
  s_waitcnt_vscnt vscnt(0)
  scratch_load_b32 v4, off, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_readfirstlane_b32 s6, v4
  scratch_load_b32 v4, off, off offset:4
  s_waitcnt vmcnt(0) lgkmcnt(63)
  v_readfirstlane_b32 s7, v4
  s_mov_b64 exec, s[4:5]
  v_add_u32 v3, v1, v2
  v_add_u32 v1, v2, v1
  s_branch .Lbb1
.Lbb3:
  s_mov_b64 exec, s[2:3]
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

