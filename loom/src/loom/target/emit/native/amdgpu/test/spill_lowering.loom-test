  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====

// An authored scratch store does not make its shared source globally
// unspillable. Its other uses still participate in ordinary spill repair.
// RUN: emit amdgpu-assembly @shared_spill_payloads strategy=source amdgpu.vgpr=4

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @shared_spill_payloads(%offset: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>, %destination: reg<amdgpu.sgpr x2>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 20} : low.storage<private>
  %first = global_load_b32_saddr %offset, %source
  %second = global_load_b32_saddr %offset, %source {offset = 4}
  %third = global_load_b32_saddr %offset, %source {offset = 8}
  %fourth = global_load_b32_saddr %offset, %source {offset = 12}
  %fifth = global_load_b32_saddr %offset, %source {offset = 16}
  s_barrier
  low.spill %first, %storage : reg<amdgpu.vgpr>, low.storage<private>
  low.spill %second, %storage {offset = 4} : reg<amdgpu.vgpr>, low.storage<private>
  low.spill %third, %storage {offset = 8} : reg<amdgpu.vgpr>, low.storage<private>
  low.spill %fourth, %storage {offset = 12} : reg<amdgpu.vgpr>, low.storage<private>
  low.spill %fifth, %storage {offset = 16} : reg<amdgpu.vgpr>, low.storage<private>
  global_store_b32_saddr %offset, %first, %destination
  global_store_b32_saddr %offset, %second, %destination {offset = 4}
  global_store_b32_saddr %offset, %third, %destination {offset = 8}
  global_store_b32_saddr %offset, %fourth, %destination {offset = 12}
  global_store_b32_saddr %offset, %fifth, %destination {offset = 16}
  return
}
