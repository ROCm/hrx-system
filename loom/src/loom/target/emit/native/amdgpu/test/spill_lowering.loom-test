  v_mov_b32 v5, v8
  s_mov_b64_exec_read s[0:1]
  s_mov_b64 exec, -1
  v_mov_b32 v8, 4096
  scratch_load_dword v8, v8, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  v_readfirstlane_b32 s2, v8
  v_mov_b32 v8, 4100
  scratch_load_dword v8, v8, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  v_readfirstlane_b32 s3, v8
  s_mov_b64 exec, s[0:1]
  s_endpgm

