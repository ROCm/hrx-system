// ====

// CDNA2 needs a vector scratch address as well as the scalar payload temporary.
// Both must exclude all words of a value defined inside the retired loop.
// RUN: emit amdgpu-assembly @cdna2_loop_defined_tuple

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_loop_defined_tuple(%upper_bound: reg<amdgpu.vgpr>, %seed: reg<amdgpu.vgpr x2>, %uniform: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 8} : low.storage<private>
  %zero = v_mov_b32 0
  %one = v_mov_b32 1
  %saved_exec = s_mov_b64_exec_read
  low.br ^header(%zero: reg<amdgpu.vgpr>)
^header(%position: reg<amdgpu.vgpr>):
  %retired_pair = v_lshlrev_b64 %position, %seed
  %active = v_cmp_lt_i32 %position, %upper_bound
  %masked_exec, %any_active = s_and_saveexec_b64 %active
  low.cond_br %any_active, ^body, ^exit : reg<amdgpu.scc>
^exit:
  s_mov_b64_exec %saved_exec
  return %retired_pair
^body:
  low.spill %uniform, %storage : reg<amdgpu.sgpr x2>, low.storage<private>
  %reload = low.reload %storage : low.storage<private> -> reg<amdgpu.sgpr x2>
  %next_position = v_add_u32 %one, %position
  low.br ^header(%next_position: reg<amdgpu.vgpr>)
}

