  scratch_store_dwordx4 v8, v[0:3], off offset:0
  s_nop 0
  v_mov_b32 v0, 20
  scratch_store_dword v0, v4, off offset:0
  v_mov_b32 v0, v5
  v_mov_b32 v1, v6
  v_mov_b32 v2, 24
  scratch_store_dwordx2 v2, v[0:1], off offset:0
  v_mov_b32 v0, 32
  scratch_store_dword v0, v7, off offset:0
  s_mov_b64_exec_read s[2:3]
  s_mov_b64 exec, -1
  v_mov_b32 v0, s0
  v_mov_b32 v1, 4096
  scratch_store_dword v1, v0, off offset:0
  v_mov_b32 v0, s1
  v_mov_b32 v1, 4100
  scratch_store_dword v1, v0, off offset:0
  s_mov_b64 exec, s[2:3]
  v_mov_b32 v0, 0
  scratch_load_dwordx4 v[0:3], v0, off offset:0
  v_mov_b32 v4, 20
  scratch_load_dword v4, v4, off offset:0
