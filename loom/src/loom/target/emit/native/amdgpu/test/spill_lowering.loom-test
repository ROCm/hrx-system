// RUN: emit amdgpu-assembly @cdna2_addressed_spills strategy=source

// CDNA2 scratch traffic always has an address operand. Cover all vector
// transfer widths, misaligned chunks, and a scalar spill beyond the immediate.
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_addressed_spills(%aligned: reg<amdgpu.vgpr x4>, %misaligned: reg<amdgpu.vgpr x4>, %uniform: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.sgpr x2>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 4112} : low.storage<private>
  low.spill %aligned, %storage : reg<amdgpu.vgpr x4>, low.storage<private>
  low.spill %misaligned, %storage {offset = 20} : reg<amdgpu.vgpr x4>, low.storage<private>
  low.spill %uniform, %storage {offset = 4096} : reg<amdgpu.sgpr x2>, low.storage<private>
  %first = low.reload %storage : low.storage<private> -> reg<amdgpu.vgpr x4>
  %second = low.reload %storage {offset = 20} : low.storage<private> -> reg<amdgpu.vgpr x4>
  %third = low.reload %storage {offset = 4096} : low.storage<private> -> reg<amdgpu.sgpr x2>
  return %first, %second, %third
}

