// RUN: emit amdgpu-assembly @cdna2_addressed_spills

// CDNA2 scratch traffic always has an address operand. Cover all vector
// transfer widths, misaligned chunks, and a scalar spill beyond the immediate.
amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @cdna2_addressed_spills(%aligned: reg<amdgpu.vgpr x4>, %misaligned: reg<amdgpu.vgpr x4>, %uniform: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.sgpr x2>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 4112} : low.storage<private>
  low.spill %aligned, %storage : reg<amdgpu.vgpr x4>, low.storage<private>
  low.spill %misaligned, %storage {offset = 20} : reg<amdgpu.vgpr x4>, low.storage<private>
  low.spill %uniform, %storage {offset = 4096} : reg<amdgpu.sgpr x2>, low.storage<private>
  %first = low.reload %storage : low.storage<private> -> reg<amdgpu.vgpr x4>
  %second = low.reload %storage {offset = 20} : low.storage<private> -> reg<amdgpu.vgpr x4>
  %third = low.reload %storage {offset = 4096} : low.storage<private> -> reg<amdgpu.sgpr x2>
  return %first, %second, %third
}

// ----
  v_mov_b32 v8, 0
  scratch_store_dwordx4 v8, v[0:3], off offset:0
  s_nop 0
  v_mov_b32 v0, 20
  v_mov_b32 v2, v5
  v_mov_b32 v3, v6
  s_mov_b64_exec_read s[2:3]
  scratch_store_dword v0, v4, off offset:0
  v_mov_b32 v0, 24
  scratch_store_dwordx2 v0, v[2:3], off offset:0
  v_mov_b32 v0, 32
  scratch_store_dword v0, v7, off offset:0
  s_mov_b64 exec, -1
  v_mov_b32 v0, s0
  v_mov_b32 v1, 4096
  v_mov_b32 v2, s1
  scratch_store_dword v1, v0, off offset:0
  v_mov_b32 v0, 4100
  scratch_store_dword v0, v2, off offset:0
  s_mov_b64 exec, s[2:3]
  v_mov_b32 v0, 20
  v_mov_b32 v1, 24
  v_mov_b32 v2, 32
  v_mov_b32 v3, 0
  s_mov_b64_exec_read s[0:1]
  scratch_load_dword v4, v0, off offset:0
  scratch_load_dword v7, v2, off offset:0
  s_nop 0
  scratch_load_dwordx2 v[0:1], v1, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  v_mov_b32 v5, v0
  v_mov_b32 v6, v1
  scratch_load_dwordx4 v[0:3], v3, off offset:0
  s_mov_b64 exec, -1
  v_mov_b32 v8, 4096
  scratch_load_dword v8, v8, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  v_readfirstlane_b32 s2, v8
  v_mov_b32 v8, 4100
  scratch_load_dword v8, v8, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  v_readfirstlane_b32 s3, v8
