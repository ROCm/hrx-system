// ====

// Rematerialize private arithmetic, then spill the captured loads. Retaining
// that arithmetic placement lets each reload start before the private producer
// instead of losing all placement facts when spill traffic is inserted.
// RUN: emit amdgpu-assembly @retained_arithmetic_after_spill strategy=resource-stall amdgpu.vgpr=3

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @retained_arithmetic_after_spill(%offset: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>, %destination: reg<amdgpu.sgpr x2>) asm {
  %bias0 = v_add_u32_lit %offset, 12345
  %bias1 = v_add_u32_lit %offset, 12346
  %bias2 = v_add_u32_lit %offset, 12347
  low.schedule.fence
  %loaded0 = global_load_b32_saddr %offset, %source
  %loaded1 = global_load_b32_saddr %offset, %source {offset = 4}
  %loaded2 = global_load_b32_saddr %offset, %source {offset = 8}
  s_barrier
  %biased0 = v_add_u32 %loaded0, %bias0
  global_store_b32_saddr %offset, %biased0, %destination
  %biased1 = v_add_u32 %loaded1, %bias1
  global_store_b32_saddr %offset, %biased1, %destination {offset = 4}
  %biased2 = v_add_u32 %loaded2, %bias2
  global_store_b32_saddr %offset, %biased2, %destination {offset = 8}
  return
}
