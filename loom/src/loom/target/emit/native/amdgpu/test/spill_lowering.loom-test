// ====

// Spilling asynchronous load results rebuilds their register leases. Exact
// assembly checks the load-to-spill and reload-to-store waits.
// RUN: emit amdgpu-assembly @loaded_snapshot strategy=source amdgpu.vgpr=4

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @loaded_snapshot(%offset: reg<amdgpu.vgpr>, %source: reg<amdgpu.sgpr x2>, %destination: reg<amdgpu.sgpr x2>) asm {
  %first = global_load_b32_saddr %offset, %source
  %second = global_load_b32_saddr %offset, %source {offset = 4}
  %third = global_load_b32_saddr %offset, %source {offset = 8}
  %fourth = global_load_b32_saddr %offset, %source {offset = 12}
  %fifth = global_load_b32_saddr %offset, %source {offset = 16}
  s_barrier
  global_store_b32_saddr %offset, %first, %destination
  global_store_b32_saddr %offset, %second, %destination {offset = 4}
  global_store_b32_saddr %offset, %third, %destination {offset = 8}
  global_store_b32_saddr %offset, %fourth, %destination {offset = 12}
  global_store_b32_saddr %offset, %fifth, %destination {offset = 16}
  return
}
