// RUN: emit amdgpu-vopd-plan-json @gfx11_dependent_rejection

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @gfx11_dependent_rejection(%source0: reg<amdgpu.vgpr>, %source1: reg<amdgpu.vgpr>) asm {
  %difference = v_sub_f32 %source0, %source1
  %result = v_sub_f32 %difference, %source1
  return
}

