// RUN: emit amdgpu-assembly @edge_copy_write strategy=source fixed=%original:physical_register:0:1 fixed=%source:physical_register:4:1 fixed=%joined:physical_register:0:1

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @edge_copy_write(%original: reg<amdgpu.sgpr>, %source: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %original
  low.br ^join(%source: reg<amdgpu.sgpr>)
^join(%joined: reg<amdgpu.sgpr>):
  %consumed = s_add_u32 %joined, %joined
  return
}

