// RUN: emit amdgpu-assembly @scalar_vcc_write strategy=source

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @scalar_vcc_write(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %mask {false_value = 0}
  %replacement = s_mov_b32_vcc_imm 1
  %consumed = v_cndmask_b32_src0_inline_vcc %selected, %replacement {false_value = 0}
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, vcc
  s_mov_b32 vcc_lo, 1
  s_delay_alu instid0(VALU_DEP_1)
  s_wait_alu depctr(65534)
  v_cndmask_b32 v0, 0, v0, vcc
  s_endpgm

