// RUN: emit amdgpu-assembly @memory_progress strategy=source fixed=%original:physical_register:1:1 fixed=%replacement:physical_register:0:1 fixed=%base:physical_register:4:2

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @memory_progress(%original: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr x2>, %address: reg<amdgpu.vgpr>) asm {
  %saved = v_mov_b32_copy %original
  %replacement = s_mov_b32 66
  %loaded = global_load_b32_saddr %address, %base
  %consumed = s_add_u32 %replacement, %replacement
  return
}

