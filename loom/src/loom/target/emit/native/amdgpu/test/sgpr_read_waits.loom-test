// RUN: emit amdgpu-assembly @local_pair

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @local_pair(%original: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %original
  %replacement = s_mov_b32 66
  %consumed = s_add_u32 %replacement, %replacement
  return
}

// ----
  v_mov_b32 v0, s0
  s_mov_b32 s0, 66
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @read_before_fallthrough

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @read_before_fallthrough(%original: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %original
  low.br ^overwrite
^overwrite:
  %replacement = s_mov_b32 66
  %consumed = s_add_u32 %replacement, %replacement
  return
}

// ----
  v_mov_b32 v0, s0
.Lbb1:
  s_mov_b32 s0, 66
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @write_before_fallthrough

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @write_before_fallthrough(%original: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %original
  %replacement = s_mov_b32 66
  low.br ^consume
^consume:
  %consumed = s_add_u32 %replacement, %replacement
  return
}

// ----
  v_mov_b32 v0, s0
  s_mov_b32 s0, 66
.Lbb1:
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @read_from_later_predecessor

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @read_from_later_predecessor(%original: reg<amdgpu.sgpr>, %condition: reg<amdgpu.scc>) asm {
  low.cond_br %condition, ^read, ^skip : reg<amdgpu.scc>
^skip:
  low.br ^join
^join:
  %replacement = s_mov_b32 66
  %consumed = s_add_u32 %replacement, %replacement
  return
^read:
  %saved = v_mov_b32_copy %original
  low.br ^join
}

// ----
  s_cbranch_scc1 .Lbb3
.Lbb1:
.Lbb2:
  s_mov_b32 s0, 66
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_endpgm
.Lbb3:
  v_mov_b32 v0, s0
  s_branch .Lbb2

// ====

// RUN: emit amdgpu-assembly @scalar_vcc_write

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @scalar_vcc_write(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %mask {false_value = 0}
  %replacement = s_mov_b32_vcc_imm 1
  %consumed = v_cndmask_b32_src0_inline_vcc %selected, %replacement {false_value = 0}
  return
}

// ----
  v_cndmask_b32 v0, 0, v0, vcc
  s_mov_b32 vcc_lo, 1
  s_delay_alu instid0(VALU_DEP_1)
  s_wait_alu depctr(65534)
  v_cndmask_b32 v0, 0, v0, vcc
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @vector_vcc_write

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @vector_vcc_write(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %mask {false_value = 0}
  %replacement = v_cmp_eq_i32_src0_inline_vcc %value {lhs = 0}
  %consumed = v_cndmask_b32_src0_inline_vcc %selected, %replacement {false_value = 0}
  return
}

// ----
  v_cndmask_b32 v1, 0, v0, vcc
  v_cmp_eq_i32 vcc, 0, v0
  s_delay_alu instid0(VALU_DEP_2)
  s_wait_alu depctr(65533)
  v_cndmask_b32 v0, 0, v1, vcc
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @backedge_read

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @backedge_read() asm {
  low.br ^header
^header:
  %replacement = s_mov_b32 66
  low.br ^body
^body:
  %consumed = v_mov_b32_copy %replacement
  low.br ^header
}

// ----
.Lbb1:
  s_mov_b32 s0, 66
.Lbb2:
  s_wait_alu depctr(65534)
  v_mov_b32 v0, s0
  s_branch .Lbb1

// ====

// A loop-carried permutation needs a real scalar copy cycle. The earlier
// vector read establishes persistent history for the released scratch pair.
// RUN: emit amdgpu-assembly @cycle_temporary

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @cycle_temporary(%left: reg<amdgpu.sgpr>, %right: reg<amdgpu.sgpr>, %spare: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %spare
  low.br ^header(%left: reg<amdgpu.sgpr>, %right: reg<amdgpu.sgpr>)
^header(%current_left: reg<amdgpu.sgpr>, %current_right: reg<amdgpu.sgpr>):
  low.br ^header(%current_right: reg<amdgpu.sgpr>, %current_left: reg<amdgpu.sgpr>)
}

// ----
  v_mov_b32 v0, s0
.Lbb1:
  s_mov_b32 s0, s2
  s_wait_alu depctr(65534)
  s_mov_b32 s2, s1
  s_mov_b32 s1, s0
  s_branch .Lbb1

// ====

// RUN: emit amdgpu-assembly @memory_progress

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @memory_progress(%original: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr x2>, %address: reg<amdgpu.vgpr>) asm {
  %saved = v_mov_b32_copy %original
  %replacement = s_mov_b32 66
  %loaded = global_load_b32_saddr %address, %base
  %consumed = s_add_u32 %replacement, %replacement
  return
}

// ----
  v_mov_b32 v1, s0
  s_mov_b32 s0, 66
  global_load_b32 v0, v0, s[2:3] offset:0
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_endpgm

// ====

// VALU scalar destinations use va_sdst, independently of scalar writes.
// RUN: emit amdgpu-assembly @vector_scalar_write
amdgpu.target<gfx1201> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @vector_scalar_write(%original: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  %saved = v_mov_b32_copy %original
  %replacement = v_readfirstlane_b32 %value
  %consumed = v_mov_b32_copy %replacement
  return
}

// ----
  v_mov_b32 v1, s0
  v_readfirstlane_b32 s0, v0
  s_delay_alu instid0(VALU_DEP_1)
  s_wait_alu depctr(61951)
  v_mov_b32 v0, s0
  s_endpgm

// ====

// SALU consumption interlocks the same VALU-written destination.
// RUN: emit amdgpu-assembly @scalar_consumption
amdgpu.target<gfx1201> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @scalar_consumption(%original: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  %saved = v_mov_b32_copy %original
  %replacement = v_readfirstlane_b32 %value
  %sum = s_add_u32 %replacement, %replacement
  %consumed = v_mov_b32_copy %replacement
  return
}

// ----
  v_mov_b32 v1, s0
  v_readfirstlane_b32 s0, v0
  s_delay_alu instid0(VALU_DEP_1)
  s_add_u32 s1, s0, s0
  v_mov_b32 v0, s0
  s_endpgm

// ====

// A wait on another destination field cannot retire a scalar write. A matching
// wait completes that write but does not erase pair history for later writes.
// RUN: emit amdgpu-assembly @partial_wait_fields
amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @partial_wait_fields(%original: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %original
  %first = s_mov_b32 65
  s_wait_alu {depctr = 65533}
  %first_use = s_add_u32 %first, %first
  %second = s_mov_b32 66
  s_wait_alu {depctr = 65534}
  %second_use = s_add_u32 %second, %second
  low.br ^next
^next:
  %third = s_mov_b32 67
  %third_use = s_add_u32 %third, %third
  return
}

// ----
  v_mov_b32 v0, s0
  s_mov_b32 s0, 65
  s_wait_alu depctr(65533)
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_mov_b32 s0, 66
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
.Lbb1:
  s_mov_b32 s0, 67
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_endpgm

// ====

// SMEM completes pending scalar destinations, not persistent pair history.
// RUN: emit amdgpu-assembly @scalar_memory_progress
amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @scalar_memory_progress(%original: reg<amdgpu.sgpr>, %base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %original
  %first = s_mov_b32 66
  %loaded = s_load_dword %base, %offset
  %first_use = s_add_u32 %first, %first
  %second = s_mov_b32 67
  %second_use = s_add_u32 %second, %second
  return
}

// ----
  v_mov_b32 v0, s0
  s_mov_b32 s0, 66
  s_load_dword s4, s[2:3], s1 offset:0
  s_add_u32 s0, s0, s0
  s_mov_b32 s0, 67
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_endpgm

// ====

// Buffer memory has the scalar destination interlock that GLOBAL lacks.
// RUN: emit amdgpu-assembly @buffer_memory_progress
amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @buffer_memory_progress(%original: reg<amdgpu.sgpr>, %resource: reg<amdgpu.sgpr x4>, %offset: reg<amdgpu.sgpr>, %address: reg<amdgpu.vgpr>) asm {
  %saved = v_mov_b32_copy %original
  %replacement = s_mov_b32 66
  %loaded = buffer_load_dword %resource, %address, %offset
  %consumed = s_add_u32 %replacement, %replacement
  return
}

// ----
  v_mov_b32 v1, s0
  s_mov_b32 s0, 66
  buffer_load_dword v0, v0, s[4:7], s1 offen offset:0
  s_add_u32 s0, s0, s0
  s_endpgm

// ====

// Both hardware mask DWORDs belong to the VCC destination field in wave64.
// RUN: emit amdgpu-assembly @vector_vcc_wave64
amdgpu.target<gfx1201> @target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @vector_vcc_wave64(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.vcc>) asm {
  %selected = v_cndmask_b32_src0_inline_vcc %value, %mask {false_value = 0}
  %replacement = v_cmp_eq_i32_src0_inline_vcc %value {lhs = 0}
  %consumed = v_cndmask_b32_src0_inline_vcc %selected, %replacement {false_value = 0}
  return
}

// ----
  v_cndmask_b32 v1, 0, v0, vcc
  v_cmp_eq_i32 vcc, 0, v0
  s_delay_alu instid0(VALU_DEP_2)
  s_wait_alu depctr(65533)
  v_cndmask_b32 v0, 0, v1, vcc
  s_endpgm

// ====

// Older processors do not acquire GFX12's persistent scalar-read hazard.
// RUN: emit amdgpu-assembly @older_target
amdgpu.target<gfx1100> @target

low.func.def schedule(locked) target<amdgpu.rdna3.core>(@target) @older_target(%original: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %original
  low.br ^overwrite
^overwrite:
  %replacement = s_mov_b32 66
  %consumed = s_add_u32 %replacement, %replacement
  return
}

// ----
  v_mov_b32 v0, s0
.Lbb1:
  s_mov_b32 s0, 66
  s_add_u32 s0, s0, s0
  s_endpgm

// ====

// RUN: emit amdgpu-wait-state-plan @gfx12_sgpr_read_hazard
amdgpu.target<gfx1200> @gfx12_target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@gfx12_target) @gfx12_sgpr_read_hazard(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %replacement = s_or_b64 %source, %source
  %result = s_and_b64 %replacement, %source
  return
}

// ----
amdgpu.wait_state_plan states=1 progress=4 hazards=1
state[0] reason=sgpr_read_dependency action=amdgpu.s_wait_alu at=b0:n2/o2 producer=n1 consumer=n2 required=1 observed=0 residual=1 depctr=0xfffe

// ====

// RUN: emit amdgpu-wait-state-plan @gfx12_structural_sgpr_read_hazard
amdgpu.target<gfx1200> @gfx12_target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@gfx12_target) @gfx12_structural_sgpr_read_hazard(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %copy = copy %source {detached = true} : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %result = s_and_b64 %copy, %source
  return
}

// ----
amdgpu.wait_state_plan states=1 progress=4 hazards=1
state[0] reason=sgpr_read_dependency action=amdgpu.s_wait_alu at=b0:n2/o2 producer=n1 consumer=n2 required=1 observed=0 residual=1 depctr=0xfffe
