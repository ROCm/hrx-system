// RUN: emit amdgpu-assembly @read_before_fallthrough strategy=source fixed=%original:physical_register:1:1 fixed=%replacement:physical_register:0:1

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @read_before_fallthrough(%original: reg<amdgpu.sgpr>) asm {
  %saved = v_mov_b32_copy %original
  low.br ^overwrite
^overwrite:
  %replacement = s_mov_b32 66
  %consumed = s_add_u32 %replacement, %replacement
  return
}

// ----
  v_mov_b32 v0, s1
.Lbb1:
  s_mov_b32 s0, 66
  s_wait_alu depctr(65534)
  s_add_u32 s0, s0, s0
  s_endpgm

