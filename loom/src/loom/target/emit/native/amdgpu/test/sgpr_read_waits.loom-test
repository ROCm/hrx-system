// RUN: emit amdgpu-assembly @cycle_temporary strategy=source fixed=%left:physical_register:0:1 fixed=%right:physical_register:1:1 fixed=%spare:physical_register:2:1 fixed=%joined:physical_register:0:2

amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @cycle_temporary(%left: reg<amdgpu.sgpr>, %right: reg<amdgpu.sgpr>, %spare: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %saved = v_mov_b32_copy %spare
  %reversed = concat(%right, %left) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^join(%reversed: reg<amdgpu.sgpr x2>)
^join(%joined: reg<amdgpu.sgpr x2>):
  return %joined
}

// ----
  v_mov_b32 v0, s2
  s_mov_b32 s2, s1
  s_mov_b32 s1, s0
  s_wait_alu depctr(65534)
  s_mov_b32 s0, s2
.Lbb1:
  s_endpgm

