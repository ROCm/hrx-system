// RUN: emit amdgpu-wait-state-plan @gfx12_structural_sgpr_read_hazard strategy=source fixed=%mask:physical_register:0:2 fixed=%source:physical_register:2:2 fixed=%copy:physical_register:0:2 fixed=%result:physical_register:0:2
amdgpu.target<gfx1200> @gfx12_target {subgroup_size = 64}

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@gfx12_target) @gfx12_structural_sgpr_read_hazard(%value: reg<amdgpu.vgpr>, %mask: reg<amdgpu.sgpr x2>, %source: reg<amdgpu.sgpr x2>) asm {
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  %copy = copy %source {detached = true} : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %result = s_and_b64 %copy, %source
  return
}

