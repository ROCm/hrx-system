// ====

// VFLAT's GV address mode requires NULL in SADDR for loads, stores and atomics.
// RUN: emit amdgpu-native-words @flat_addresses_gfx1200
amdgpu.target<gfx1200> @target

low.func.def schedule(locked) target<amdgpu.rdna4.core>(@target) @flat_addresses_gfx1200(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>, %wide: reg<amdgpu.vgpr x2>, %pair: reg<amdgpu.vgpr x4>) asm {
  %loaded = flat_load_dword %address
  %loaded_wide = flat_load_dwordx2 %address
  flat_store_b32 %address, %value
  flat_store_b64 %address, %wide
  flat_atomic_add_u32 %address, %value
  %old = flat_atomic_add_u32_rtn %address, %value
  flat_atomic_add_u64 %address, %wide
  %old_wide = flat_atomic_add_u64_rtn %address, %wide
  %compared = flat_atomic_cmpswap_b32_rtn %address, %wide
  %compared_wide = flat_atomic_cmpswap_b64_rtn %address, %pair
  return
}

