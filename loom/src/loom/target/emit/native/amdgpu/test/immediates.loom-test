// ====

// Flat atomics use both address VGPRs and encode SADDR as NULL, not s0.
// RUN: emit amdgpu-native-words @flat_atomic_addresses
amdgpu.target<gfx1151> @target

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @flat_atomic_addresses(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>, %wide: reg<amdgpu.vgpr x2>, %pair: reg<amdgpu.vgpr x4>) asm {
  flat_atomic_add_u32 %address, %value
  %old = flat_atomic_add_u32_rtn %address, %value
  %old_wide = flat_atomic_add_u64_rtn %address, %wide
  %compared = flat_atomic_cmpswap_b32_rtn %address, %wide
  %compared_wide = flat_atomic_cmpswap_b64_rtn %address, %pair
  return
}

