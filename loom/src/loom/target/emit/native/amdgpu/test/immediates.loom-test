low.func.def schedule(locked) target<amdgpu.rdna4.gfx125x.core>(@target) @flat_addresses_gfx1250(%address: reg<amdgpu.vgpr x2>, %value: reg<amdgpu.vgpr>, %wide: reg<amdgpu.vgpr x2>, %pair: reg<amdgpu.vgpr x4>) asm {
