// FMA residuals encode negation and 1.0 in the instruction at both widths,
// including with a scalar multiplicand. No literal word or move is needed.
// RUN: emit amdgpu-native-words @fma_residuals
amdgpu.target<gfx90a> @target

low.func.def schedule(locked) target<amdgpu.cdna2.core>(@target) @fma_residuals(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.sgpr>, %c: reg<amdgpu.vgpr>, %wide_a: reg<amdgpu.vgpr x2>, %wide_b: reg<amdgpu.sgpr x2>, %wide_c: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %residual = v_fma_f32_neg_a %a, %b, %c
  %unit_residual = v_fma_f32_neg_a_one %a, %b
  %wide_residual = v_fma_f64_neg_a %wide_a, %wide_b, %wide_c
  %wide_unit_residual = v_fma_f64_neg_a_one %wide_a, %wide_b
  return %residual, %unit_residual, %wide_residual, %wide_unit_residual
}

