// ====

// Implicit fields and sparse named fields share the same roundtrip contract.
// Explicit zero defaults disappear, and the descriptor order is canonical.
// RUN: roundtrip
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @immediate_order(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  s_delay_alu {delay = 1}
  global_store_b32_saddr %address, %value, %base {slc = 1, offset = 12, glc = 0}
  global_store_b32_saddr %address, %value, %base {dlc = 0, glc = 0, offset = 0, slc = 0}
  return
}
// ----
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @immediate_order(%address: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  s_delay_alu {delay = 1}
  global_store_b32_saddr %address, %value, %base {offset = 12, slc = 1}
  global_store_b32_saddr %address, %value, %base
  return
}

// ====

// A field omitted from the explicit assembly projection can still be required.
// RUN: verify
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @missing_implicit_immediate() asm {
  // ERROR@+1: PARSE/034 "missing named immediate"
  s_delay_alu
  return
}

// ====

// Empty, sparse and fully spelled dictionaries retain the same field identity.
// Omitted fields use descriptor defaults; the final store sets every modifier.
// RUN: emit amdgpu-native-words @sparse_store_fields
amdgpu.target<gfx1100> @target

low.func.def schedule(locked) target<amdgpu.rdna3.core>(@target) @sparse_store_fields(%addr: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  global_store_b32_saddr %addr, %value, %base
  global_store_b32_saddr %addr, %value, %base {offset = 12}
  global_store_b32_saddr %addr, %value, %base {slc = 1}
  global_store_b32_saddr %addr, %value, %base {offset = 12, slc = 1}
  global_store_b32_saddr %addr, %value, %base {offset = 12, glc = 1, slc = 1, dlc = 1}
  return
}
