// gfx1251 shares the gfx125x encoding storage while selecting its own matrix
// schedule view. Exercise supplemental fields from VOP3, VOP3P, and VOP3PX2
// through the native encoder rather than only formatting their assembly.
// RUN: emit amdgpu-native @gfx1251_native_supplemental waits=none
amdgpu.target<gfx1251> @gfx1251_target

low.func.def target<amdgpu.rdna4.gfx1251.core>(@gfx1251_target) @gfx1251_native_supplemental(%a16: reg<amdgpu.vgpr x16>, %b12: reg<amdgpu.vgpr x12>, %packed8: reg<amdgpu.vgpr x2>, %scale0: reg<amdgpu.vgpr>, %scale1: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr x8>) asm {
  %fp8_byte0 = v_cvt_f16_fp8_byte0 %scale0
  %fp8_byte1 = v_cvt_f16_fp8_byte1 %scale0
  %fp8_byte2 = v_cvt_f16_fp8_byte2 %scale0
  %fp8_byte3 = v_cvt_f16_fp8_byte3 %scale0
  %bf8_byte0 = v_cvt_f16_bf8_byte0 %scale1
  %bf8_byte1 = v_cvt_f16_bf8_byte1 %scale1
  %bf8_byte2 = v_cvt_f16_bf8_byte2 %scale1
  %bf8_byte3 = v_cvt_f16_bf8_byte3 %scale1
  %converted = v_cvt_scale_pk8_bf16_fp8 %packed8, %scale0 {scale_sel = 3}
  %wmma = v_wmma_f32_16x16x128_f8f6f4_f8_f6 %a16, %b12, %acc {matrix_a_fmt = 1, matrix_b_fmt = 2}
  %scaled = v_wmma_scale_f32_16x16x128_f8f6f4_f8_f6 %a16, %b12, %wmma, %scale0, %scale1 {matrix_a_fmt = 1, matrix_b_fmt = 2, matrix_a_scale = 1, matrix_b_scale = 1, matrix_a_reuse = 1, matrix_b_reuse = 1}
  return
}

