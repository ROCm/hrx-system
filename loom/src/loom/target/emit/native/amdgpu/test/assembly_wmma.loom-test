  %swmmac = v_swmmac_f32_16x16x64_f16 %scale, %a8, %b16, %index {index_key_16bit = 1, matrix_b_reuse = 1}
  %wmma_i32 = v_wmma_i32_16x16x64_iu8 %a8, %b8, %swmmac {neg_lo = 3, clamp = 1}
  %swmmac_i32 = v_swmmac_i32_16x16x128_iu8 %wmma_i32, %a8, %b16, %index2 {neg_lo = 2, clamp = 1}
  %out0 = slice %swmmac_i32[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  global_store_b32_saddr %addr, %out0, %output_view
  return
