// RUN: emit amdgpu-assembly @gfx11_wmma_half_result_store_tail strategy=source
amdgpu.target<gfx1100> @gfx11_target {subgroup_size = 64}

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_wmma_half_result_store_tail(%lds_addr: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr x8>, %acc: reg<amdgpu.vgpr x4>, %store_addr: reg<amdgpu.vgpr>, %output_view: reg<amdgpu.sgpr x2>) asm {
  %lhs0 = ds_read_b128 %lds_addr
  %lhs1 = ds_read_b128 %lds_addr {offset = 16}
  %lhs = concat(%lhs0, %lhs1) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %half_result = v_wmma_f16_16x16x16_f16_w64 %lhs, %rhs, %acc
  %lane0 = slice %half_result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %lane1 = slice %half_result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %lane2 = slice %half_result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %lane3 = slice %half_result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %f0 = v_cvt_f32_f16 %lane0
  %f1 = v_cvt_f32_f16 %lane1
  %f2 = v_cvt_f32_f16 %lane2
  %f3 = v_cvt_f32_f16 %lane3
  global_store_b32_saddr %store_addr, %f0, %output_view
  global_store_b32_saddr %store_addr, %f1, %output_view {offset = 4}
  global_store_b32_saddr %store_addr, %f2, %output_view {offset = 8}
  global_store_b32_saddr %store_addr, %f3, %output_view {offset = 12}
  return
}

