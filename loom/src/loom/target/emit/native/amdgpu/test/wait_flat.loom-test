// ====

// The atomic write must complete in both domains before a local read aliases it.
// RUN: emit amdgpu-assembly @flat_atomic_no_return_gfx942 strategy=source

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @flat_atomic_no_return_gfx942(%address: reg<amdgpu.vgpr x2>, %local: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  flat_atomic_add %address, %value
  %loaded = ds_read_b32 %local
  return %loaded
}

// ----
  flat_atomic_add v[0:1], v2 offset:0 sc1:0
  s_waitcnt vmcnt(0) lgkmcnt(0)
  ds_read_b32 v0, v3 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

