// RUN: emit amdgpu-assembly @flat_loads_gfx942 strategy=source

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @flat_loads_gfx942(%address: reg<amdgpu.vgpr x2>, %addend: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %older = flat_load_dword %address : reg<amdgpu.vgpr>
  %younger = flat_load_dword %address {offset = 4} : reg<amdgpu.vgpr>
  %used = v_add_u32 %older, %addend
  %result = v_add_u32 %used, %younger
  return %result
}

// ----
  flat_load_dword v3, v[0:1], off offset:0
  flat_load_dword v0, v[0:1], off offset:4
  s_waitcnt vmcnt(0) lgkmcnt(0)
  v_add_u32 v1, v3, v2
  v_add_u32 v0, v1, v0
  s_endpgm

// ====

// RUN: emit amdgpu-assembly @flat_store_then_local_load_gfx942 strategy=source

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @flat_store_then_local_load_gfx942(%address: reg<amdgpu.vgpr x2>, %local: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  flat_store_dword %address, %value
  %loaded = ds_read_b32 %local
  return %loaded
}

// ----
  flat_store_dword v[0:1], v2, off offset:0
  s_waitcnt vmcnt(0) lgkmcnt(0)
  ds_read_b32 v0, v3 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

