// RUN: emit amdgpu-assembly @flat_loads_gfx90a strategy=source

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @flat_loads_gfx90a(%address: reg<amdgpu.vgpr x2>, %addend: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %older = flat_load_dword %address : reg<amdgpu.vgpr>
  %younger = flat_load_dword %address {offset = 4} : reg<amdgpu.vgpr>
  %used = v_add_u32 %older, %addend
  %result = v_add_u32 %used, %younger
  return %result
}

