// RUN: emit amdgpu-assembly @gfx11_rel32_pc_coalesced_copy
amdgpu.target<gfx1100> @gfx11_target

global.rodata.decl @iree_asan_config

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_rel32_pc_coalesced_copy() asm {
  %pc = s_getpc_b64
  %pc_copy = copy %pc : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr x2>
  %pc_lo = slice %pc_copy[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %pc_hi = slice %pc_copy[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %config_lo, %config_carry = s_add_u32_rhs_symbol_rel32_lo %pc_lo {symbol = @iree_asan_config}
  %config_hi, %config_carry_out = s_addc_u32_rhs_symbol_rel32_hi %pc_hi, %config_carry {symbol = @iree_asan_config}
  %config = concat(%config_lo, %config_hi) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %shadow_base = s_load_dwordx2_offset_only %config {offset = 16}
  return
}

// ----
  s_getpc_b64 s[0:1]
  s_add_u32_rhs_symbol_rel32_lo s0, s0, symbol(@iree_asan_config), byte_offset(0)
  s_addc_u32_rhs_symbol_rel32_hi s1, s1, symbol(@iree_asan_config), byte_offset(0)
  s_load_dwordx2 s[2:3], s[0:1], 16
  s_endpgm

