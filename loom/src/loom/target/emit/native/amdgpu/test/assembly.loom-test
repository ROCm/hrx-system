// RUN: emit amdgpu-assembly @gfx11_convergent_exec_state_fence
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_convergent_exec_state_fence(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %addr: reg<amdgpu.vgpr>) asm {
  %early = v_add_f32 %lhs, %rhs
  %also_early = v_add_f32 %early, %rhs
  %permuted = ds_bpermute_b32 %addr, %early
  %sum = v_add_f32 %permuted, %also_early
  return
}

// ----
  v_add_f32 v0, v0, v1
  s_delay_alu instid0(VALU_DEP_1) | instskip(SKIP_2) | instid1(VALU_DEP_1)
  v_add_f32 v1, v0, v1
  ds_bpermute_b32 v0, v2, v0 offset:0
  s_waitcnt vmcnt(63) lgkmcnt(0)
  v_add_f32 v0, v0, v1
  s_endpgm

