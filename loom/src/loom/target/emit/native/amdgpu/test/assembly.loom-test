// RUN: emit amdgpu-assembly @wait_branch_arg_after_prior_wait
amdgpu.target<gfx1100> @gfx_target

low.func.def target<amdgpu.rdna3.core>(@gfx_target) @wait_branch_arg_after_prior_wait(%resource: reg<amdgpu.sgpr x4>, %vaddr: reg<amdgpu.vgpr>, %soffset: reg<amdgpu.sgpr>, %lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr>) asm {
  %first = buffer_load_dword %resource, %vaddr, %soffset
  %sum = v_add_u32 %first, %value
  %loaded = buffer_load_b128 %resource, %vaddr, %soffset {offset = 16}
  %cond = s_cmp_lt_i32 %lhs, %rhs
  low.cond_br %cond, ^pass, ^exit : reg<amdgpu.scc>
^pass:
  low.br ^store(%loaded: reg<amdgpu.vgpr x4>)
^store(%payload: reg<amdgpu.vgpr x4>):
  buffer_store_b128 %payload, %resource, %sum, %soffset {offset = 32}
  return
^exit:
  return
}

