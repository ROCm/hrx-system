// Allocation-authored VGPR moves are vector-ALU consumers and must drain a
// pending transcendental result before reading its physical register.
// RUN: emit amdgpu-assembly @gfx11_trans_result_structural_copy
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_trans_result_structural_copy(%input: reg<amdgpu.vgpr>, %scale: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %trans = v_exp_f32 %input
  %copy = copy %trans {detached = true} : reg<amdgpu.vgpr> -> reg<amdgpu.vgpr>
  %result = v_mul_f32 %copy, %scale
  return %result
}

