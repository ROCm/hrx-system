// RUN: emit amdgpu-assembly @gfx11_guarded_scalar_exec_mask
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_guarded_scalar_exec_mask(%resource: reg<amdgpu.sgpr x4>, %vaddr: reg<amdgpu.vgpr>, %soffset: reg<amdgpu.sgpr>, %x: reg<amdgpu.sgpr>, %y: reg<amdgpu.sgpr>, %payload: reg<amdgpu.vgpr>) asm {
  %zero = s_mov_b32 0
  %one = s_mov_b32 1
  %x_zero = s_cmp_eq_i32 %x, %zero
  %y_zero = s_cmp_eq_i32 %y, %zero
  %x_bit = s_cselect_b32 %one, %zero, %x_zero
  %y_bit = s_cselect_b32 %one, %zero, %y_zero
  %both_bits = s_and_b32 %x_bit, %y_bit
  %both = s_cmp_lg_i32 %both_bits, %zero
  %exec = s_mov_b64_exec_read
  %exec_lo = slice %exec[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %exec_hi = slice %exec[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %mask_lo = s_cselect_b32 %exec_lo, %zero, %both
  %mask_hi = s_cselect_b32 %exec_hi, %zero, %both
  %mask = concat(%mask_lo, %mask_hi) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %saved_exec, %active = s_and_saveexec_b64 %mask
  low.cond_br %active, ^then, ^join : reg<amdgpu.scc>
^then:
  buffer_store_dword %payload, %resource, %vaddr, %soffset
  low.br ^join
^join:
  s_mov_b64_exec %saved_exec
  return
}

