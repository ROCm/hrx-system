// RUN: emit amdgpu-assembly @gfx11_static_storage_precedes_load
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_static_storage_precedes_load(%kernarg: reg<amdgpu.sgpr x2>) asm {
  %loaded = s_load_dwordx8_offset_only %kernarg
  %storage = storage {byte_alignment = 16, byte_length = 64} : low.storage<workgroup>
  return
}

// Static storage moves to the entry prefix before scheduling. Its declaration
// has no runtime action requiring the otherwise unused load to complete.
// ----
