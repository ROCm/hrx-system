// RUN: emit amdgpu-assembly @gfx11_div_scale_vcc_state
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_div_scale_vcc_state(%value: reg<amdgpu.vgpr>) asm {
  %one = v_mov_b32 1065353216
  %scaled, %mask = v_div_scale_f32 %value, %value, %one
  %reciprocal = v_rcp_f32 %scaled
  %quotient = v_div_fmas_f32 %scaled, %reciprocal, %scaled, %mask
  %result = v_div_fixup_f32 %quotient, %value, %one
  return
}

// ----
  v_mov_b32 v1, 1065353216
  s_delay_alu instid0(VALU_DEP_1) | instskip(SKIP_2) | instid1(VALU_DEP_1)
  v_div_scale_f32 v2, v0, v0, v1
  v_rcp_f32 v3, v2
  s_waitcnt_depctr depctr(0)
  v_div_fmas_f32 v2, v2, v3, v2
  s_delay_alu instid0(VALU_DEP_1)
  v_div_fixup_f32 v0, v2, v0, v1
  s_endpgm

