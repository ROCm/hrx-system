// RUN: emit amdgpu-assembly @gfx11_ds_read_dead_result_aliases_address
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_ds_read_dead_result_aliases_address(%addr: reg<amdgpu.vgpr>) asm {
  %loaded = ds_read_b32 %addr
  return
}

// A DS read consumes its address when issued, so a dead address can share the
// result register without an early-clobber restriction.
// ----
  ds_read_b32 v0, v0 offset:0
  s_endpgm

