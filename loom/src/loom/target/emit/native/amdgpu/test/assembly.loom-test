// RUN: emit amdgpu-assembly @gfx11_control_messages
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_control_messages() asm {
  %doorbell = s_sendmsg_rtn_b32 {message = 128}
  %mask = s_mov_b32 1023
  %doorbell_id = s_and_b32 %doorbell, %mask
  %wave_abort = s_mov_b32 1024
  %interrupt_payload = s_or_b32 %doorbell_id, %wave_abort
  %m0_payload = s_mov_b32_m0 %interrupt_payload
  s_sendmsg %m0_payload {message = 1}
  return
}

// ----
  s_sendmsg_rtn_b32 s0, message(128)
  s_mov_b32 s1, 1023
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_and_b32 s0, s0, s1
  s_mov_b32 s1, 1024
  s_or_b32 s0, s0, s1
  s_mov_b32 m0, s0
  s_sendmsg message(1)
  s_endpgm

