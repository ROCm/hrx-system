low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_b96_memory(%resource: reg<amdgpu.sgpr x4>, %vaddr: reg<amdgpu.vgpr>, %soffset: reg<amdgpu.sgpr>, %addr: reg<amdgpu.vgpr>, %saddr: reg<amdgpu.sgpr x2>) asm {
  %buffer = buffer_load_b96 %resource, %vaddr, %soffset {offset = 12}
  buffer_store_b96 %buffer, %resource, %vaddr, %soffset {offset = 16}
  %global = global_load_b96_saddr %addr, %saddr {offset = 4}
  global_store_b96_saddr %addr, %global, %saddr {offset = 8}
  return
}

// ----
  buffer_load_b96 v[2:4], v0, s[0:3], s4 offen offset:12
  s_waitcnt vmcnt(0) lgkmcnt(63)
  buffer_store_b96 v[2:4], v0, s[0:3], s4 offen offset:16
  global_load_b96 v[2:4], v1, s[6:7] offset:4
  s_waitcnt vmcnt(0) lgkmcnt(63)
  global_store_b96 v1, v[2:4], s[6:7] offset:8
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

