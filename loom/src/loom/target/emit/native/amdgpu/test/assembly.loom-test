  buffer_load_dword v2, v0, s[4:7], s2 offen offset:0
  buffer_load_b128 v[4:7], v0, s[4:7], s2 offen offset:16
  s_cmp_lt_i32 s0, s1
  s_waitcnt vmcnt(1) lgkmcnt(63)
  v_add_u32 v0, v2, v1
  s_cbranch_scc0 .Lbb3
.Lbb1:
.Lbb2:
  s_waitcnt vmcnt(0) lgkmcnt(63)
  buffer_store_b128 v[4:7], v0, s[4:7], s2 offen offset:32
  s_waitcnt_vscnt vscnt(0)
  s_endpgm
.Lbb3:
  s_endpgm

