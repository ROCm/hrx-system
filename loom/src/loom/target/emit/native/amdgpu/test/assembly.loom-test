// RUN: emit amdgpu-assembly @gfx11_constants
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_constants(%resource: reg<amdgpu.sgpr x4>, %vaddr: reg<amdgpu.vgpr>) asm {
  %s_c0 = s_mov_b32 7
  %v_c0 = v_mov_b32 9
  %v_sum = v_add_u32_lit %v_c0, 123
  buffer_store_dword %v_sum, %resource, %vaddr, %s_c0 {offset = 12}
  return
}

// ----
  v_mov_b32 v1, 9
  s_mov_b32 s4, 7
  s_delay_alu instid0(VALU_DEP_1)
  v_add_u32 v1, 123, v1
  buffer_store_dword v1, v0, s[0:3], s4 offen offset:12
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====

// A direct body path that source control proves cannot reach its ordinary
// result-bearing return terminates the wave without fabricating a result.
// RUN: emit amdgpu-assembly @gfx11_unreachable_tail
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_unreachable_tail() -> (reg<amdgpu.vgpr>) asm {
  low.unreachable
}

// ----
  s_endpgm

// ====

// Compiler hints partition the low schedule but have no target representation.
// RUN: emit amdgpu-assembly @gfx11_compiler_hint
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_compiler_hint() asm {
  s_delay_alu {delay = 1}
  low.schedule.fence
  s_delay_alu {delay = 1}
  return
}

// ----
  s_delay_alu instid0(VALU_DEP_1)
  s_delay_alu instid0(VALU_DEP_1)
  s_endpgm

// ====

// The native encoder consumes the same trait rather than recognizing an ISA.
// RUN: emit amdgpu-native @gfx11_compiler_hint_native
amdgpu.target<gfx1100> @gfx11_target

low.func.def target<amdgpu.rdna3.core>(@gfx11_target) @gfx11_compiler_hint_native() asm {
  s_delay_alu {delay = 1}
  low.schedule.fence
  s_delay_alu {delay = 1}
  return
}

// ----

