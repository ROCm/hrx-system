// ====
// RUN: emit amdgpu-assembly @taken_branch_has_one_issue_slot

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @taken_branch_has_one_issue_slot(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %choice: reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  %choose = s_cmp_lt_u32 %zero, %choice
  low.cond_br %choose, ^produce, ^other : reg<amdgpu.scc>
^produce:
  %result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %acc
  low.cond_br %choose, ^read, ^done : reg<amdgpu.scc>
^other:
  return
^read:
  global_store_dwordx4_saddr %address, %result, %base
  return
^done:
  return
}

// ----
  s_mov_b32 s1, 0
  s_cmp_lt_u32 s1, s0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  v_mfma_f32_16x16x4f32 v[4:7], v0, v1, v[4:7]
  s_cbranch_scc1 .Lbb3
  s_branch .Lbb4
.Lbb2:
  s_endpgm
.Lbb3:
  s_nop 9
  global_store_dwordx4 v2, v[4:7], s[2:3] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm
.Lbb4:
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @backedge_preserves_window

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @backedge_preserves_window(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %initial: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %limit: reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  %one = s_mov_b32 1
  low.br ^header(%initial: reg<amdgpu.vgpr x4>, %zero: reg<amdgpu.sgpr>)
^header(%carried: reg<amdgpu.vgpr x4>, %iteration: reg<amdgpu.sgpr>):
  global_store_dwordx4_saddr %address, %carried, %base
  low.br ^body
^body:
  %next_iteration = s_add_u32 %iteration, %one
  %again = s_cmp_lt_u32 %next_iteration, %limit
  %next = v_mfma_f32_16x16x4f32 %lhs, %rhs, %carried
  low.cond_br %again, ^backedge, ^done : reg<amdgpu.scc>
^backedge:
  low.br ^header(%next: reg<amdgpu.vgpr x4>, %next_iteration: reg<amdgpu.sgpr>)
^done:
  return
}

// ----
  s_mov_b32 s3, 0
  s_mov_b32 s4, 1
.Lbb1:
  s_nop 6
  global_store_dwordx4 v6, v[0:3], s[0:1] offset:0
.Lbb2:
  s_nop 0
  v_mfma_f32_16x16x4f32 v[0:3], v4, v5, v[0:3]
  s_add_u32 s3, s3, s4
  s_cmp_lt_u32 s3, s2
  s_cbranch_scc0 .Lbb4
.Lbb3:
  s_branch .Lbb1
.Lbb4:
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm
