// RUN: emit amdgpu-assembly @exact_floor_exceeds_partial_overlap

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @exact_floor_exceeds_partial_overlap(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %packed_lhs: reg<amdgpu.vgpr x2>, %packed_rhs: reg<amdgpu.vgpr x2>, %acc: reg<amdgpu.vgpr x4>) asm {
  %first = v_mfma_f32_4x4x1_16b_f32 %lhs, %rhs, %acc
  %second = v_mfma_f32_16x16x16_bf16 %packed_lhs, %packed_rhs, %first
  return
}

// ----
  v_mfma_f32_4x4x1_16b_f32 v[4:7], v0, v1, v[4:7]
  s_nop 1
  v_mfma_f32_16x16x16_bf16 v[4:7], v[2:3], v[8:9], v[4:7]
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @overwrite_preserves_memory_window

amdgpu.target<gfx90a> @target

// Keeping the multiplicands live makes ordinary allocation reuse the dead
// accumulator result for the store payload.
low.func.def target<amdgpu.cdna2.core>(@target) @overwrite_preserves_memory_window(%acc: reg<amdgpu.vgpr x2>, %lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>, %replacement: reg<amdgpu.vgpr>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %result = v_mfma_f64_4x4x4f64 %lhs, %rhs, %acc
  %overwrite = v_mov_b32_copy %replacement
  global_store_dword_saddr %address, %overwrite, %base
  return %lhs, %rhs
}

// ----
  v_mov_b32 v0, v0
  global_store_dword v1, v0, s[0:1] offset:0
  v_mfma_f64_4x4x4f64 v[2:3], v[4:5], v[6:7], v[2:3]
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

