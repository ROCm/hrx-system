// RUN: emit amdgpu-assembly @long_window_survives_forwarding

amdgpu.target<gfx90a> @target

// The second instruction forwards the full accumulator immediately, but its
// shorter window cannot replace the first instruction's pending memory access.
low.func.def target<amdgpu.cdna2.core>(@target) @long_window_survives_forwarding(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %long = v_mfma_f32_16x16x4f32 %lhs, %rhs, %acc
  %short = v_mfma_f32_4x4x1f32 %lhs, %rhs, %long
  global_store_dwordx4_saddr %address, %short, %base
  return
}

// ----
  v_mfma_f32_16x16x4f32 v[0:3], v4, v5, v[0:3]
  v_mfma_f32_4x4x1f32 v[0:3], v4, v5, v[0:3]
  s_nop 9
  global_store_dwordx4 v6, v[0:3], s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @join_retains_strongest_predecessor

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @join_retains_strongest_predecessor(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %choice: reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  %choose = s_cmp_lt_u32 %zero, %choice
  low.cond_br %choose, ^slow, ^fast : reg<amdgpu.scc>
^slow:
  %long = v_mfma_f32_16x16x4f32 %lhs, %rhs, %acc
  low.br ^join(%long: reg<amdgpu.vgpr x4>)
^fast:
  %short = v_mfma_f32_4x4x1f32 %lhs, %rhs, %acc
  low.br ^join(%short: reg<amdgpu.vgpr x4>)
^join(%carried: reg<amdgpu.vgpr x4>):
  global_store_dwordx4_saddr %address, %carried, %base
  return
}

// ----
  s_mov_b32 s1, 0
  s_cmp_lt_u32 s1, s0
  s_cbranch_scc0 .Lbb2
.Lbb1:
  v_mfma_f32_16x16x4f32 v[4:7], v0, v1, v[4:7]
  s_branch .Lbb3
.Lbb2:
  v_mfma_f32_4x4x1f32 v[4:7], v0, v1, v[4:7]
.Lbb3:
  s_nop 9
  global_store_dwordx4 v2, v[4:7], s[2:3] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @coalesced_edge_preserves_window

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @coalesced_edge_preserves_window(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %acc: reg<amdgpu.vgpr x4>, %address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) asm {
  %result = v_mfma_f32_16x16x4f32 %lhs, %rhs, %acc
  low.br ^empty(%result: reg<amdgpu.vgpr x4>)
^empty(%carried: reg<amdgpu.vgpr x4>):
  low.br ^store
^store:
  global_store_dwordx4_saddr %address, %carried, %base
  return
}

// ----
  v_mfma_f32_16x16x4f32 v[4:7], v0, v1, v[4:7]
.Lbb1:
.Lbb2:
  s_nop 10
  global_store_dwordx4 v2, v[4:7], s[0:1] offset:0
  s_waitcnt vmcnt(0) lgkmcnt(15)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @nonmatching_forwarding_identity

amdgpu.target<gfx942> @target

// The last SGEMM exempts the first instruction's full-range forwarding
// identity. The intervening XDL instruction still requires five slots.
low.func.def target<amdgpu.cdna3.core>(@target) @nonmatching_forwarding_identity(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %packed_lhs: reg<amdgpu.vgpr x2>, %packed_rhs: reg<amdgpu.vgpr x2>, %acc: reg<amdgpu.vgpr x4>) asm {
  %first = v_mfma_f32_16x16x4_f32 %lhs, %rhs, %acc
  %second = v_mfma_f32_16x16x16_bf16 %packed_lhs, %packed_rhs, %first
  %third = v_mfma_f32_16x16x4_f32 %lhs, %rhs, %second
  return
}

// ----
  v_mfma_f32_16x16x4_f32 v[0:3], v8, v9, v[0:3]
  v_mfma_f32_16x16x16_bf16 v[0:3], v[4:5], v[6:7], v[0:3]
  s_nop 4
  v_mfma_f32_16x16x4_f32 v[0:3], v8, v9, v[0:3]
  s_endpgm

