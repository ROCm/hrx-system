// RUN: emit amdgpu-wait-state-plan @accumulator_bank_forwarding

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @accumulator_bank_forwarding(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>, %acc: reg<amdgpu.agpr x2>) -> (reg<amdgpu.agpr x2>) asm {
  %first = v_mfma_f64_4x4x4f64 %lhs, %rhs, %acc
  %second = v_mfma_f64_4x4x4f64 %lhs, %rhs, %first
  return %second
}

