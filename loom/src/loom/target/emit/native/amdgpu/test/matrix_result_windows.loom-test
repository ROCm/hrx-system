amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @register_banks_are_disjoint(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>, %acc: reg<amdgpu.agpr x4>, %replacement: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %result = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %acc
  %overwrite = v_mov_b32_copy %replacement
  return %overwrite
}

