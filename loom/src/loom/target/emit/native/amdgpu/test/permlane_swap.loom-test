// ====

// A write immediately consumed through the first destructive input needs the
// full two-cycle gfx950 lane-permute forwarding distance.
// RUN: emit amdgpu-wait-state-plan @permlane16_first_input_hazard strategy=source

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane16_first_input_hazard(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %fresh = v_mov_b32_copy %lhs
  %left, %right = v_permlane16_swap_b32 %fresh, %rhs
  return %left, %right
}

// ----
amdgpu.wait_state_plan states=1 progress=3 hazards=1
state[0] reason=lane_permute_vgpr_read action=amdgpu.s_nop at=b0:n1/o1 producer=n0 consumer=n1 required=2 observed=0 residual=2

// ====

// The final assembly realizes the planner requirement as an s_nop 1.
// RUN: emit amdgpu-assembly @permlane16_first_input_assembly strategy=source

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane16_first_input_assembly(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %fresh = v_mov_b32_copy %lhs
  %left, %right = v_permlane16_swap_b32 %fresh, %rhs
  return %left, %right
}

// ----
  v_mov_b32_copy v0, v0
  s_nop 1
  v_permlane16_swap_b32 v0, v1
  s_endpgm

// ====

// The second destructive input has the same forwarding restriction.
// RUN: emit amdgpu-wait-state-plan @permlane32_second_input_hazard strategy=source

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_second_input_hazard(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %fresh = v_mov_b32_copy %rhs
  %left, %right = v_permlane32_swap_b32 %lhs, %fresh
  return %left, %right
}

// ----
amdgpu.wait_state_plan states=1 progress=3 hazards=1
state[0] reason=lane_permute_vgpr_read action=amdgpu.s_nop at=b0:n1/o1 producer=n0 consumer=n1 required=2 observed=0 residual=2

// ====

// One intervening VALU instruction leaves one cycle of the e64 hazard.
// RUN: emit amdgpu-wait-state-plan @permlane16_partial_progress strategy=source

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane16_partial_progress(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %other: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %fresh = v_mov_b32_copy %lhs
  %gap = v_mov_b32_copy %other
  %left, %right = v_permlane16_swap_b32_e64 %fresh, %rhs {bound_ctrl = 1}
  return %left, %right, %gap
}

// ----
amdgpu.wait_state_plan states=1 progress=4 hazards=1
state[0] reason=lane_permute_vgpr_read action=amdgpu.s_nop at=b0:n2/o2 producer=n0 consumer=n2 required=2 observed=1 residual=1

// ====

// Two intervening instructions satisfy the e64 forwarding distance exactly.
// RUN: emit amdgpu-wait-state-plan @permlane32_sufficient_progress strategy=source

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_sufficient_progress(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>, %other: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %fresh = v_mov_b32_copy %lhs
  %first = v_mov_b32_copy %other
  %second = v_mov_b32_copy %first
  %left, %right = v_permlane32_swap_b32_e64 %fresh, %rhs {fi = 1}
  return %left, %right, %second
}

// ----
amdgpu.wait_state_plan states=0 progress=5 hazards=0

// ====

// Preserve both results and canonicalize the independent e64 controls.
// Explicit zero controls disappear without changing the selected encoding.
// RUN: roundtrip

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_roundtrip(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %compact_left, %compact_right = v_permlane32_swap_b32 %lhs, %rhs
  %default_left, %default_right = v_permlane32_swap_b32_e64 %compact_left, %compact_right {bound_ctrl = 0, fi = 0}
  %left, %right = v_permlane32_swap_b32_e64 %default_left, %default_right {fi = 1, bound_ctrl = 1}
  return %left, %right
}

// ----
amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_roundtrip(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %compact_left, %compact_right = v_permlane32_swap_b32 %lhs, %rhs
  %default_left, %default_right = v_permlane32_swap_b32_e64 %compact_left, %compact_right
  %left, %right = v_permlane32_swap_b32_e64 %default_left, %default_right {bound_ctrl = 1, fi = 1}
  return %left, %right
}

// ====

// Both prior values must be single VGPRs, including the encoded SRC0 result.
// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_scalar_first_input(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: PARSE/034 {detail="tied operand type must be one of: reg<amdgpu.vgpr>"}
  %left, %right = v_permlane32_swap_b32 %lhs, %rhs
  return
}

// ====

// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_scalar_second_input(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.sgpr>) asm {
  // ERROR@+1: PARSE/034 {detail="tied operand type must be one of: reg<amdgpu.vgpr>"}
  %left, %right = v_permlane32_swap_b32_e64 %lhs, %rhs
  return
}

// ====

// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_wide_first_input(%lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: PARSE/034 {detail="tied operand type must be one of: reg<amdgpu.vgpr>"}
  %left, %right = v_permlane32_swap_b32 %lhs, %rhs
  return
}

// ====

// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_wide_second_input(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr x2>) asm {
  // ERROR@+1: PARSE/034 {detail="tied operand type must be one of: reg<amdgpu.vgpr>"}
  %left, %right = v_permlane32_swap_b32_e64 %lhs, %rhs
  return
}

// ====

// Compact VOP1 has no control bits; controls require the explicit e64 form.
// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_compact_bound_ctrl(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: PARSE/034 {detail="unexpected immediate syntax"}
  %left, %right = v_permlane32_swap_b32 %lhs, %rhs {bound_ctrl = 1}
  return
}

// ====

// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_compact_fi(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: PARSE/034 {detail="unexpected immediate syntax"}
  %left, %right = v_permlane32_swap_b32 %lhs, %rhs {fi = 1}
  return
}

// ====

// Each named control is a single bit, not an arbitrary OP_SEL value.
// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_bound_ctrl_overflow(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: STRUCTURE/014 {attr_name="bound_ctrl", actual_value="2", expected_constraint="0..1"}
  %left, %right = v_permlane32_swap_b32_e64 %lhs, %rhs {bound_ctrl = 2}
  return
}

// ====

// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_bound_ctrl_negative(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: STRUCTURE/014 {attr_name="bound_ctrl", actual_value="-1", expected_constraint="0..1"}
  %left, %right = v_permlane32_swap_b32_e64 %lhs, %rhs {bound_ctrl = -1}
  return
}

// ====

// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_fi_overflow(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: STRUCTURE/014 {attr_name="fi", actual_value="2", expected_constraint="0..1"}
  %left, %right = v_permlane32_swap_b32_e64 %lhs, %rhs {fi = 2}
  return
}

// ====

// RUN: verify

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane32_fi_negative(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: STRUCTURE/014 {attr_name="fi", actual_value="-1", expected_constraint="0..1"}
  %left, %right = v_permlane32_swap_b32_e64 %lhs, %rhs {fi = -1}
  return
}

// ====

// The gfx950 instruction cannot be authored through older or generic contracts.
// RUN: verify

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @permlane32_unavailable_cdna3(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: PARSE/034 "unknown low asm mnemonic"
  %left, %right = v_permlane32_swap_b32 %lhs, %rhs
  return
}

// ====

// RUN: verify

amdgpu.target<gfx9-4-generic> @target

low.func.def target<amdgpu.gfx9_4.generic.core>(@target) @permlane32_unavailable_generic(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) asm {
  // ERROR@+1: PARSE/034 "unknown low asm mnemonic"
  %left, %right = v_permlane32_swap_b32_e64 %lhs, %rhs
  return
}
