// The compact and e64 encodings share one destructive two-register contract.
// Named controls remain independent in Low and use LLVM's canonical spelling.
// RUN: emit amdgpu-assembly @permlane_swap_forms strategy=source waits=none fixed=%lhs:physical_register:11:1 fixed=%rhs:physical_register:13:1

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane_swap_forms(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %v16c0, %v16c1 = v_permlane16_swap_b32 %lhs, %rhs
  %v16d0, %v16d1 = v_permlane16_swap_b32_e64 %v16c0, %v16c1
  %v16b0, %v16b1 = v_permlane16_swap_b32_e64 %v16d0, %v16d1 {bound_ctrl = 1}
  %v16f0, %v16f1 = v_permlane16_swap_b32_e64 %v16b0, %v16b1 {fi = 1}
  %v16a0, %v16a1 = v_permlane16_swap_b32_e64 %v16f0, %v16f1 {bound_ctrl = 1, fi = 1}
  %v32c0, %v32c1 = v_permlane32_swap_b32 %v16a0, %v16a1
  %v32d0, %v32d1 = v_permlane32_swap_b32_e64 %v32c0, %v32c1
  %v32b0, %v32b1 = v_permlane32_swap_b32_e64 %v32d0, %v32d1 {bound_ctrl = 1}
  %v32f0, %v32f1 = v_permlane32_swap_b32_e64 %v32b0, %v32b1 {fi = 1}
  %v32a0, %v32a1 = v_permlane32_swap_b32_e64 %v32f0, %v32f1 {bound_ctrl = 1, fi = 1}
  return %v32a0, %v32a1
}

// ----
  v_permlane16_swap_b32 v11, v13
  v_permlane16_swap_b32_e64 v11, v13
  v_permlane16_swap_b32_e64 v11, v13 bound_ctrl:1
  v_permlane16_swap_b32_e64 v11, v13 fi:1
  v_permlane16_swap_b32_e64 v11, v13 bound_ctrl:1 fi:1
  v_permlane32_swap_b32 v11, v13
  v_permlane32_swap_b32_e64 v11, v13
  v_permlane32_swap_b32_e64 v11, v13 bound_ctrl:1
  v_permlane32_swap_b32_e64 v11, v13 fi:1
  v_permlane32_swap_b32_e64 v11, v13 bound_ctrl:1 fi:1
  s_endpgm

// ====

// Native words distinguish both opcodes and every OP_SEL control combination.
// RUN: emit amdgpu-native-words @permlane_swap_words strategy=source waits=none fixed=%lhs:physical_register:11:1 fixed=%rhs:physical_register:13:1

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @permlane_swap_words(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %v16c0, %v16c1 = v_permlane16_swap_b32 %lhs, %rhs
  %v16d0, %v16d1 = v_permlane16_swap_b32_e64 %v16c0, %v16c1
  %v16b0, %v16b1 = v_permlane16_swap_b32_e64 %v16d0, %v16d1 {bound_ctrl = 1}
  %v16f0, %v16f1 = v_permlane16_swap_b32_e64 %v16b0, %v16b1 {fi = 1}
  %v16a0, %v16a1 = v_permlane16_swap_b32_e64 %v16f0, %v16f1 {bound_ctrl = 1, fi = 1}
  %v32c0, %v32c1 = v_permlane32_swap_b32 %v16a0, %v16a1
  %v32d0, %v32d1 = v_permlane32_swap_b32_e64 %v32c0, %v32c1
  %v32b0, %v32b1 = v_permlane32_swap_b32_e64 %v32d0, %v32d1 {bound_ctrl = 1}
  %v32f0, %v32f1 = v_permlane32_swap_b32_e64 %v32b0, %v32b1 {fi = 1}
  %v32a0, %v32a1 = v_permlane32_swap_b32_e64 %v32f0, %v32f1 {bound_ctrl = 1, fi = 1}
  return %v32a0, %v32a1
}

