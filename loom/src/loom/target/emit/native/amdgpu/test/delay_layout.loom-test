// The selectors stay relative to their own consecutive native consumers.
// RUN: emit amdgpu-assembly @adjacent_gfx1100 strategy=source
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @adjacent_gfx1100(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %increment: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %first = v_add_f32 %a, %b
  %scalar = v_readfirstlane_b32 %first
  %sum = s_add_u32 %scalar, %increment
  return %sum
}

// ----
  v_add_f32 v0, v0, v1
  s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_readfirstlane_b32 s1, v0
  s_add_u32 s0, s1, s0
  s_endpgm

