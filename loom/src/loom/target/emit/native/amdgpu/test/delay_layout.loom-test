// ====

// TRANS32 and VALU selectors retain their distinct consumers in a paired hint.
// RUN: emit amdgpu-assembly @trans_consumer strategy=source
amdgpu.target<gfx1200> @target {subgroup_size = 32}

low.func.def target<amdgpu.rdna4.core>(@target) @trans_consumer(%input: reg<amdgpu.vgpr>, %increment: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %first = v_exp_f32 %input
  %scalar = v_readfirstlane_b32 %first
  %sum = s_add_u32 %scalar, %increment
  return %sum
}

// ----
  v_exp_f32 v0, v0
  s_delay_alu instid0(TRANS32_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_readfirstlane_b32 s1, v0
  s_add_u32 s0, s1, s0
  s_endpgm
