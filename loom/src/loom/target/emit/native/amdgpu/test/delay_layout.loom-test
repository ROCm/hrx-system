kernel_layout:
  v_add_f32 v0, v0, v0
  s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
  v_readfirstlane_b32 s1, v0
  s_add_u32 s0, s1, s0
  s_endpgm
.Lfunc_end0:
.size kernel_layout, .Lfunc_end0-kernel_layout

