// ====

// The native immediate carries NEXT and both original selectors.
// RUN: emit amdgpu-native-words @adjacent_words strategy=source
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @adjacent_words(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %increment: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %first = v_add_f32 %a, %b
  %scalar = v_readfirstlane_b32 %first
  %sum = s_add_u32 %scalar, %increment
  return %sum
}

// ----
0x06000300
0xBF870091
0x7E020500
0x80000001
0xBFB00000

// ====

// A literal-bearing move occupies two words but one skipped instruction.
// RUN: emit amdgpu-assembly @literal_gap strategy=source
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @literal_gap(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %increment: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %first = v_add_f32 %a, %b
  %scalar = v_readfirstlane_b32 %first
  %literal = v_mov_b32 305419896
  %sum = s_add_u32 %scalar, %increment
  return %sum, %literal
}

// ----
  v_add_f32 v0, v0, v1
  s_delay_alu instid0(VALU_DEP_1) | instskip(SKIP_1) | instid1(VALU_DEP_2)
  v_readfirstlane_b32 s1, v0
  v_mov_b32 v0, 305419896
  s_add_u32 s0, s1, s0
  s_endpgm

// ====

// A VOPD instruction advances the native skip distance once.
// RUN: emit amdgpu-assembly @vopd_gap strategy=source
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @vopd_gap(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %c: reg<amdgpu.vgpr>, %d: reg<amdgpu.vgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.vgpr>) asm {
  %first = v_add_f32 %a, %b
  %read_first = v_readfirstlane_b32 %first
  %left = v_add_f32 %a, %b
  %right = v_mul_f32 %c, %d
  %read_left = v_readfirstlane_b32 %left
  return %read_first, %read_left, %right
}

// ----
  v_add_f32 v4, v0, v1
  s_delay_alu instid0(VALU_DEP_1) | instskip(SKIP_1) | instid1(VALU_DEP_1)
  v_readfirstlane_b32 s0, v4
  v_dual_add_f32 v0, v0, v1 :: v_dual_mul_f32 v3, v3, v2
  v_readfirstlane_b32 s1, v0
  s_endpgm

// ====

// Authored delay metadata ends the preceding compiler pairing window.
// RUN: emit amdgpu-assembly @authored_hint_boundary strategy=source
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @authored_hint_boundary(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %increment: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %first = v_add_f32 %a, %b
  %scalar = v_readfirstlane_b32 %first
  s_delay_alu {delay = 1}
  %sum = s_add_u32 %scalar, %increment
  return %sum
}

// ----
  v_add_f32 v0, v0, v1
  s_delay_alu instid0(VALU_DEP_1)
  v_readfirstlane_b32 s1, v0
  s_delay_alu instid0(VALU_DEP_1)
  s_delay_alu instid0(VALU_DEP_1)
  s_add_u32 s0, s1, s0
  s_endpgm

// ====

// A block entry does not inherit a pending pairing candidate.
// RUN: emit amdgpu-assembly @block_boundary strategy=source
amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @block_boundary(%a: reg<amdgpu.vgpr>, %b: reg<amdgpu.vgpr>, %increment: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %first = v_add_f32 %a, %b
  %scalar = v_readfirstlane_b32 %first
  low.br ^next
^next:
  %sum = s_add_u32 %scalar, %increment
  return %sum
}

// ----
  v_add_f32 v0, v0, v1
  s_delay_alu instid0(VALU_DEP_1)
  v_readfirstlane_b32 s1, v0
.Lbb1:
  s_add_u32 s0, s1, s0
  s_endpgm

// ====

// The kernel listing consumes the same delay layout as the HSACO encoder.
// RUN: emit amdgpu-kernel-assembly
amdgpu.target<gfx1151> @target

low.kernel.def target<amdgpu.rdna3_5.core>(@target) workgroup_size(32, 1, 1) @kernel_layout() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %group = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %first = v_add_f32 %lane, %lane
  %scalar = v_readfirstlane_b32 %first
  %sum = s_add_u32 %scalar, %group
  return
}

