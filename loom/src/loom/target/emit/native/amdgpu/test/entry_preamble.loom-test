// ====

// Public kernel emission keeps an already-fitting ABI input in place. The
// native instruction reads the original pair without a split copy or spill.
// RUN: emit amdgpu-kernel-assembly

amdgpu.target<gfx1151> @target {subgroup_size = 64}

low.kernel.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) workgroup_size(64, 1, 1) @retained_input() asm {
  %mask = live_in<amdgpu.kernarg_segment_ptr> : reg<amdgpu.sgpr x2>
  %value = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %selected = v_cndmask_b32_src0_inline %value, %mask {false_value = 0}
  return
}

