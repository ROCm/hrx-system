// Replicating a body result keeps its transfer after the defining instruction.
// RUN: emit amdgpu-assembly @replicate_body_result strategy=resource-stall

amdgpu.target<gfx1100> @target

low.func.def target<amdgpu.rdna3.core>(@target) @replicate_body_result(%lhs: reg<amdgpu.vgpr x8>, %seed: reg<amdgpu.vgpr>) asm {
  %pointer = live_in<amdgpu.kernarg_segment_ptr> : reg<amdgpu.sgpr x2>
  %shared = v_rcp_f32 %seed
  %lhs0 = slice %lhs[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product0 = v_mul_f32 %lhs0, %shared
  %lhs1 = slice %lhs[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product1 = v_mul_f32 %lhs1, %shared
  %lhs2 = slice %lhs[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product2 = v_mul_f32 %lhs2, %shared
  %lhs3 = slice %lhs[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product3 = v_mul_f32 %lhs3, %shared
  %lhs4 = slice %lhs[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product4 = v_mul_f32 %lhs4, %shared
  %lhs5 = slice %lhs[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product5 = v_mul_f32 %lhs5, %shared
  %lhs6 = slice %lhs[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product6 = v_mul_f32 %lhs6, %shared
  %lhs7 = slice %lhs[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %product7 = v_mul_f32 %lhs7, %shared
  return
}

