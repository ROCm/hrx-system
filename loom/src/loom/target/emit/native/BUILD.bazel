load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_NATIVE_AMDGPU_VISIBILITY = ["//loom/src/loom/target/emit/native/amdgpu:__pkg__"]

_NATIVE_XDNA_VISIBILITY = ["//loom/src/loom/target/arch/amd/xdna:__subpackages__"]

_NATIVE_AIE2P_VISIBILITY = ["//loom/src/loom/target/arch/amd/xdna/aie2p:implementation"]

_NATIVE_X86_VISIBILITY = ["//loom/src/loom/target/emit/native/x86:__pkg__"]

_NATIVE_ASSEMBLY_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:amdgpu_elf",
])

_NATIVE_ELF_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:native_elf",
])

_NATIVE_OBJECT_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:native_object",
])

_NATIVE_OBJECT_ELF_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:native_object_elf",
])

_X86_ELF_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:x86_elf",
])

#===------------------------------------------------------------------------===#
# Native assembly fragments
#===------------------------------------------------------------------------===#

loom_cc_library(
    name = "assembly",
    srcs = ["assembly.c"],
    hdrs = ["assembly.h"],
    target_compatible_with = _NATIVE_ASSEMBLY_COMPATIBLE_WITH,
    visibility = _NATIVE_AMDGPU_VISIBILITY,
    deps = [
        "//loom/src/loom/codegen/low:packet",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/low",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "elf",
    srcs = [
        "elf.c",
        "elf_symbols.c",
    ],
    hdrs = [
        "elf.h",
        "elf_symbols.h",
    ],
    target_compatible_with = _NATIVE_ELF_COMPATIBLE_WITH,
    visibility = _NATIVE_AMDGPU_VISIBILITY + _NATIVE_XDNA_VISIBILITY,
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
    ],
)

loom_cc_library(
    name = "contribution",
    srcs = ["contribution.c"],
    hdrs = ["contribution.h"],
    target_compatible_with = _NATIVE_OBJECT_COMPATIBLE_WITH,
    visibility = _NATIVE_AIE2P_VISIBILITY,
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "elf_sections",
    srcs = ["elf_sections.c"],
    hdrs = ["elf_sections.h"],
    target_compatible_with = _NATIVE_OBJECT_ELF_COMPATIBLE_WITH,
    visibility = _NATIVE_AIE2P_VISIBILITY,
    deps = [
        ":contribution",
        ":elf",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "object",
    srcs = ["object.c"],
    hdrs = ["object.h"],
    target_compatible_with = _NATIVE_OBJECT_COMPATIBLE_WITH,
    visibility = _NATIVE_AIE2P_VISIBILITY + _NATIVE_X86_VISIBILITY,
    deps = [
        ":contribution",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "object_elf",
    srcs = [
        "image_elf.c",
        "object_elf.c",
    ],
    hdrs = [
        "image_elf.h",
        "object_elf.h",
    ],
    target_compatible_with = _X86_ELF_COMPATIBLE_WITH,
    deps = [
        ":contribution",
        ":elf",
        ":elf_sections",
        ":object",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
    ],
)

# Backend providers contribute function mechanics to the shared module owner.
loom_cc_library(
    name = "module",
    srcs = ["module.c"],
    hdrs = ["module.h"],
    target_compatible_with = _X86_ELF_COMPATIBLE_WITH,
    visibility = _NATIVE_X86_VISIBILITY,
    deps = [
        ":object_elf",
        ":task_library",
        "//loom/src/loom/codegen/low/schedule",
        "//loom/src/loom/ops/global",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:artifact_diagnostics",
        "//loom/src/loom/target:entry_selection",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/abi/task:state_layout",
        "//loom/src/loom/target/reporting:report",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
    ],
)

loom_cc_library(
    name = "task_library",
    srcs = ["task_library.c"],
    hdrs = ["task_library.h"],
    target_compatible_with = _X86_ELF_COMPATIBLE_WITH,
    deps = [
        ":object",
        "//loom/src/loom/target/abi/task:parameter_layout",
        "//loom/src/loom/target/abi/task:state_layout",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "elf_symbols_test",
    srcs = ["elf_symbols_test.cc"],
    target_compatible_with = _NATIVE_ELF_COMPATIBLE_WITH,
    deps = [
        ":elf",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "elf_test",
    srcs = ["elf_test.cc"],
    target_compatible_with = _NATIVE_ELF_COMPATIBLE_WITH,
    deps = [
        ":elf",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "object_test",
    srcs = ["object_test.cc"],
    target_compatible_with = _NATIVE_OBJECT_COMPATIBLE_WITH,
    deps = [
        ":contribution",
        ":object",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "contribution_test",
    srcs = ["contribution_test.cc"],
    target_compatible_with = _NATIVE_OBJECT_COMPATIBLE_WITH,
    deps = [
        ":contribution",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "elf_sections_test",
    srcs = ["elf_sections_test.cc"],
    target_compatible_with = _NATIVE_OBJECT_ELF_COMPATIBLE_WITH,
    deps = [
        ":elf_sections",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "object_elf_test",
    srcs = ["object_elf_test.cc"],
    target_compatible_with = _X86_ELF_COMPATIBLE_WITH,
    deps = [
        ":object_elf",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
