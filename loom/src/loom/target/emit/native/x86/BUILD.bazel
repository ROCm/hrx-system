# The native object is a normal linker input. The caller contains no compiler
# library, loader, runtime trampoline, or generated-code inspection machinery.
loom_generated_file(
    name = "callable_object",
    testonly = True,
    args = [
        "$(location test/callable.loom)",
        "--target=x86:scalar",
    ],
    generator = "//loom/src/loom/tools/loom-compile:loom-compile",
    inputs = ["test/callable.loom"],
    output = "callable.o",
    output_flag = "--output=",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:x86",
    ]) + [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

