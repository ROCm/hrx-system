load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)
load(
    "//loom/build_tools/bazel:loom_check.bzl",
    "loom_check_test_suite",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_X86_CHECK_VISIBILITY = ["//loom/src/loom/target/arch/x86/check:__pkg__"]

#===------------------------------------------------------------------------===#
# x86 native assembly fragments
#===------------------------------------------------------------------------===#

loom_cc_library(
    name = "assembly",
    srcs = ["assembly.c"],
    hdrs = ["assembly.h"],
    deps = [
        "//loom/src/loom/codegen/low:allocation",
        "//loom/src/loom/codegen/low:packet",
        "//loom/src/loom/codegen/low/schedule",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target/arch/x86:register_classes",
        "//loom/src/loom/target/arch/x86/descriptors:avx2_descriptors_ids",
        "//loom/src/loom/target/arch/x86/descriptors:avx512_descriptors_ids",
        "//loom/src/loom/target/arch/x86/descriptors:avx512_packed_dot_descriptors_ids",
        "//loom/src/loom/target/arch/x86/descriptors:packed_dot_descriptors_ids",
        "//loom/src/loom/target/arch/x86/descriptors:scalar_descriptors_ids",
        "//loom/src/loom/target/arch/x86/descriptors:simd128_descriptors_ids",
        "//loom/src/loom/target/emit/native:assembly",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "function",
    srcs = ["function.c"],
    hdrs = [
        "function.h",
        "//loom/src/loom/target/arch/x86/descriptors:encoding_defs.h",
    ],
    deps = [
        "//loom/src/loom/codegen/low:frame",
        "//loom/src/loom/codegen/low:packet",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target/arch/x86:register_classes",
        "//loom/src/loom/target/arch/x86:sysv_frame",
        "//loom/src/loom/target/arch/x86/descriptors:avx512_packed_dot_descriptors",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "function_test",
    srcs = ["function_test.cc"],
    deps = [
        ":function",
        "//loom/src/loom/codegen/low:frame",
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target/arch/x86:sysv_abi",
        "//loom/src/loom/target/arch/x86:sysv_frame",
        "//loom/src/loom/target/arch/x86/descriptors:low_registry",
        "//loom/src/loom/target/arch/x86/ops",
        "//loom/src/loom/testing:context",
        "//loom/src/loom/testing:module_ptr",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "loom_check",
    srcs = ["check/loom_check.c"],
    hdrs = ["check/loom_check.h"],
    visibility = _X86_CHECK_VISIBILITY,
    deps = [
        ":assembly",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
    ],
)

loom_check_test_suite(
    name = "loom_check_file_test",
    srcs = [
        "test/assembly.loom-test",
        "test/copies.loom-test",
        "test/high_product.loom-test",
        "test/lanes.loom-test",
        "test/schedule_scopes.loom-test",
    ],
)
