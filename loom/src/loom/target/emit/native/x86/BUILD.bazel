iree_generated_files(
    name = "direct_call_object",
    srcs = ["test/direct_call.loom"],
    outs = ["direct_call_test.o"],
    args = [
        "$(location test/direct_call.loom)",
        "--product=module",
        "--format=x86-elf-object",
    ],
    output_args = {"direct_call_test.o": "--output={path}"},
    tags = ["skip-bazel_to_cmake"],
    tool = "//loom/src/loom/tools/loom-compile",
)

loom_cc_test(
    name = "direct_call_link_test",
    srcs = [
        "direct_call_link_test.c",
        ":direct_call_object",
    ],
)

loom_cc_library(
    name = "loom_check",
    srcs = ["check/loom_check.c"],
    hdrs = ["check/loom_check.h"],
    visibility = _X86_CHECK_VISIBILITY,
    deps = [
        ":assembly",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
    ],
)

loom_check_test_suite(
    name = "loom_check_file_test",
    srcs = [
        "test/assembly.loom-test",
