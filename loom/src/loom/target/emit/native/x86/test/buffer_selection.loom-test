// The pointer and its byte origin use the same condition. The selected pointer
// remains a 64-bit address for both the load and the aliasing write.
// RUN: emit x86-bytes @exchange_coordinate fixed=%first:physical_register:7:1 fixed=%second:physical_register:6:1 fixed=%first_origin:physical_register:2:1 fixed=%second_origin:physical_register:1:1 fixed=%condition:physical_register:8:1 fixed=%replacement:physical_register:11:1 fixed=%selected:physical_register:9:1 fixed=%origin:physical_register:10:1 fixed=%value:physical_register:0:1

x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @exchange_coordinate(%first: reg<x86.gpr64>, %second: reg<x86.gpr64>, %first_origin: reg<x86.gpr64>, %second_origin: reg<x86.gpr64>, %condition: reg<x86.gpr32>, %replacement: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %selected_seed = copy %second : reg<x86.gpr64> -> reg<x86.gpr64>
  %selected = select.gpr64 %condition, %first, %selected_seed
  %origin_seed = copy %second_origin : reg<x86.gpr64> -> reg<x86.gpr64>
  %origin = select.gpr64 %condition, %first_origin, %origin_seed
  %value = movzx.load.indexed.u8.gpr32 %selected, %origin {disp32 = 0, scale = 1}
  mov.store.indexed.u8.gpr32 %replacement, %selected, %origin {disp32 = 0, scale = 1}
  return %value
}

