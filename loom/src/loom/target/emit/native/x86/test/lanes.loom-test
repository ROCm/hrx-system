// RUN: emit x86-asm @wide_lanes

x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @wide_lanes(%values: reg<x86.xmm>, %replacement: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %first = vpextrq.xmm %values, 0
  %second = vpextrq.xmm %values, 1
  %replace_first = vpinsrq.xmm %values, %replacement, 0
  %replace_second = vpinsrq.xmm %values, %replacement, 1
  return %first, %second, %replace_first, %replace_second
}

// ----
  vpextrq rcx, xmm0, 0
  vpextrq rdx, xmm0, 1
  vpinsrq xmm1, xmm0, rax, 0
  vpinsrq xmm0, xmm0, rax, 1
  ret

// ====

x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @wide_lanes(%values: reg<x86.xmm>, %replacement: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %first = vpermilpd.xmm %values, 0
  %second = vpermilpd.xmm %values, 1
  %replace_first = vshufpd.xmm %replacement, %values, 2
  %replace_second = vshufpd.xmm %values, %replacement, 0
  return %first, %second, %replace_first, %replace_second
}

// ----
  vpermilpd xmm2, xmm0, 0
  vpermilpd xmm3, xmm0, 1
  vshufpd xmm4, xmm1, xmm0, 2
  vshufpd xmm0, xmm0, xmm1, 0
  ret

// ====

x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @wide_lanes(%values: reg<x86.xmm>, %replacement: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %first = vpextrq.xmm %values, 0
  %second = vpextrq.xmm %values, 1
  %replace_first = vpinsrq.xmm %values, %replacement, 0
  %replace_second = vpinsrq.xmm %values, %replacement, 1
  return %first, %second, %replace_first, %replace_second
}

// ----
  vpextrq rcx, xmm0, 0
  vpextrq rdx, xmm0, 1
  vpinsrq xmm1, xmm0, rax, 0
  vpinsrq xmm0, xmm0, rax, 1
  ret

// ====

x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @wide_lanes(%values: reg<x86.xmm>, %replacement: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %first = vpermilpd.xmm %values, 0
  %second = vpermilpd.xmm %values, 1
  %replace_first = vshufpd.xmm %replacement, %values, 2
  %replace_second = vshufpd.xmm %values, %replacement, 0
  return %first, %second, %replace_first, %replace_second
}

// ----
  vpermilpd xmm2, xmm0, 0
  vpermilpd xmm3, xmm0, 1
  vshufpd xmm4, xmm1, xmm0, 2
  vshufpd xmm0, xmm0, xmm1, 0
  ret

// ====

x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @wide_lanes(%values: reg<x86.ymm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %low_half = vextractf128.xmm %values, 0
  %high_half = vextractf128.xmm %values, 1
  return %low_half, %high_half
}

// ----
  vextractf128 xmm1, ymm0, 0
  vextractf128 xmm0, ymm0, 1
  ret
