// RUN: emit x86-bytes @narrow_static fixed=%input:physical_register:7:1 fixed=%output:physical_register:6:1 fixed=%byte:physical_register:8:1 fixed=%word:physical_register:15:1
x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @narrow_static(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %byte = movzx.load.u8.gpr32 %input {disp32 = 3}
  %word = movzx.load.u16.gpr32 %input {disp32 = 5}
  mov.store.u8.gpr32 %byte, %output {disp32 = 3}
  mov.store.u16.gpr32 %word, %output {disp32 = 5}
  return
}

