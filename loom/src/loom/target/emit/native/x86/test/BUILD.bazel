load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//build_tools/bazel:python.bzl", "iree_py_test")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_test",
    "loom_config_compatible_with",
    "loom_generated_file",
)
load(
    "//loom/build_tools/bazel:loom_check.bzl",
    "loom_check_test",
    "loom_check_test_suite",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_TASK_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:x86_task_hal",
]) + ["@platforms//cpu:x86_64"]

loom_check_test_suite(
    name = "loom_check_file_test",
    srcs = [
        "branch_edge_coalescing.loom-test",
        "constant_native_bytes.loom-test",
        "float_integer_native_bytes.loom-test",
        "function.loom-test",
        "integer_unary.loom-test",
        "operand_ties.loom-test",
        "predicate_bitstream.loom-test",
        "root_native_bytes.loom-test",
        "rounding_native_bytes.loom-test",
        "scalar_memory_native_bytes.loom-test",
        "unused_abi_inputs.loom-test",
        "vector_halves.loom-test",
    ],
)

loom_check_test(
    name = "native_diagnostics_test",
    src = "native_diagnostics.loom-test",
    args = ["--target=x86:scalar"],
    runner = "//loom/src/loom/tools/loom-check:loom-check",
)

iree_py_test(
    name = "report_test",
    srcs = ["report_test.py"],
    args = [
        "$(rootpath //loom/src/loom/tools/loom-compile:loom-compile)",
        "$(rootpath callable.loom)",
        "$(rootpath hal_dispatch.loom)",
        "$(rootpath schedule_model_callable.loom)",
    ],
    data = [
        "callable.loom",
        "hal_dispatch.loom",
        "schedule_model_callable.loom",
        "//loom/src/loom/tools/loom-compile",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/emit:x86_elf",
    ]),
    deps = [
        "//loom/py/loom/reporting",
        "//loom/py/loom/tools:compile_report",
    ],
)

# The native object is a normal linker input. The caller contains no compiler
# library, loader, runtime trampoline, or generated-code inspection machinery.
loom_generated_file(
    name = "callable_object",
    testonly = True,
    args = [
        "$(location callable.loom)",
        "--target=x86:scalar",
    ],
    generator = "//loom/src/loom/tools/loom-compile:loom-compile",
    inputs = ["callable.loom"],
    output = "callable.o",
    output_flag = "--output=",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

