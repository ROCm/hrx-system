// RUN: emit x86-bytes @transfer_byte
x86.target<scalar> @x86_target

low.func.def target<x86.scalar.core>(@x86_target) @transfer_byte(%source: reg<x86.gpr64>, %source_offset: reg<x86.gpr64>, %target: reg<x86.gpr64>, %target_offset: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %byte = movzx.load.indexed.u8.gpr32 %source, %source_offset {disp32 = 0, scale = 1}
  mov.store.indexed.u8.gpr32 %byte, %target, %target_offset {disp32 = 0, scale = 1}
  return %byte
}

