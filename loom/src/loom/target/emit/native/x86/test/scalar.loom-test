// RUN: emit x86-bytes @wide_memory_arithmetic

x86.target<scalar> @x86_target

low.func.def target<x86.scalar.core>(@x86_target) @wide_memory_arithmetic(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %index: reg<x86.gpr64>, %lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) asm {
