// RUN: emit x86-bytes @address_modes

x86.target<scalar> @x86_target

low.func.def target<x86.scalar.core>(@x86_target) @address_modes(%base: reg<x86.gpr64>, %index: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) asm {
  %base_disp = lea.disp %base {disp32 = 24}
  %base_neg = lea.disp %base {disp32 = -8}
  %scaled1 = lea.add_scale %base_disp, %index {disp32 = 0, scale = 1}
  %scaled2 = lea.add_scale %base_neg, %index {disp32 = 8, scale = 2}
  %scaled4 = lea.add_scale %base, %index {disp32 = -16, scale = 4}
  %scaled8 = lea.scale %index {disp32 = 32, scale = 8}
  %sum = lea %scaled8, %rhs
  return
}

