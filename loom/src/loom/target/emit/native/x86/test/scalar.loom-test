// RUN: emit x86-bytes @constants fixed=%output:physical_register:7:1 fixed=%unsigned_max:physical_register:8:1
x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @constants(%output: reg<x86.gpr64>) asm {
  %zero = mov.imm64 0
  mov.store.gpr64 %zero, %output {disp32 = 0}
  %signed_max = mov.imm64 2147483647
  mov.store.gpr64 %signed_max, %output {disp32 = 8}
  %high_bit = mov.imm64 2147483648
  mov.store.gpr64 %high_bit, %output {disp32 = 16}
  %unsigned_max = mov.imm64 4294967295
  mov.store.gpr64 %unsigned_max, %output {disp32 = 24}
  %wide = mov.imm64 4294967296
  mov.store.gpr64 %wide, %output {disp32 = 32}
  %negative = mov.imm64 -1
  mov.store.gpr64 %negative, %output {disp32 = 40}
  %signed_min = mov.imm64 -2147483648
  mov.store.gpr64 %signed_min, %output {disp32 = 48}
  %wide_negative = mov.imm64 -2147483649
  mov.store.gpr64 %wide_negative, %output {disp32 = 56}
  %large_negative = mov.imm64 -9223372036854775807
  mov.store.gpr64 %large_negative, %output {disp32 = 64}
  %large_positive = mov.imm64 9223372036854775807
  mov.store.gpr64 %large_positive, %output {disp32 = 72}
  %narrow_negative = mov.imm32 -1
  mov.store.gpr32 %narrow_negative, %output {disp32 = 80}
  %minimum_i64 = mov.imm64 -9223372036854775808
  mov.store.gpr64 %minimum_i64, %output {disp32 = 88}
  return
}

