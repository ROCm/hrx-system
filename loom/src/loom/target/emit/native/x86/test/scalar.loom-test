01 c8 b9 07 00 00 00 01 c8 c3

// ====

// RUN: emit x86-bytes @x86_rematerialize_constant_gpr64 x86.gpr64=2
x86.target<avx512> @x86_target

// Composite descriptor views retain the scalar constant's eligibility.
low.func.def target<x86.avx512.core>(@x86_target) @x86_rematerialize_constant_gpr64(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %constant = mov.imm64 7
  %lhs_copy = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %sum = add.gpr64 %lhs_copy, %rhs
  %sum_copy = copy %sum : reg<x86.gpr64> -> reg<x86.gpr64>
  %result = add.gpr64 %sum_copy, %constant
  return %result
}

