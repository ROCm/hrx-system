// ====
// RUN: emit x86-native-bytes @dword_mask
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @dword_mask(%source: reg<x86.ymm>) -> (reg<x86.gpr32>) asm {
  %bits = vmovmskps.gpr32.ymm %source
  return %bits
}

