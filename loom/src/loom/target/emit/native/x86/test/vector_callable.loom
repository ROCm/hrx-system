// Native SIMD functions use the platform pointer ABI. Vector values stay
// inside the function while loads, arithmetic, and stores use descriptor-owned
// VEX facts.
global.rodata.def @addends = align(16) bytes("01000000fbffffff6400000000000080")

global.rodata.def @reverse_lanes = align(32) bytes("0f0e0d0c0b0a090807060504030201000f0e0d0c0b0a09080706050403020100")

low.func.def public target<x86.avx2.core> abi(object_function) @add_i32x4(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %lhs_vector = vmovdqu32.load.xmm %lhs {disp32 = 0}
  %rhs_vector = vmovdqu32.load.xmm %rhs {disp32 = 0}
  %sum = vpaddd.xmm %lhs_vector, %rhs_vector
  vmovdqu32.store.xmm %sum, %output {disp32 = 0}
  return
}

low.func.def public target<x86.avx2.core> abi(object_function) @add_constant_i32x4(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %input_vector = vmovdqu32.load.xmm %input {disp32 = 0}
  %constant = avx2.vmovdqu.rodata.xmm @addends
  %sum = vpaddd.xmm %input_vector, %constant
  vmovdqu32.store.xmm %sum, %output {disp32 = 0}
  return
}

low.func.def public target<x86.avx2.core> abi(object_function) @reverse_i8x32_lanes(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %input_vector = vmovdqu32.load.ymm %input {disp32 = 0}
  %control = avx2.vmovdqu.rodata.ymm @reverse_lanes
  %result = vpshufb.ymm %input_vector, %control
  vmovdqu32.store.ymm %result, %output {disp32 = 0}
  return
}

// Deliberately unaligned authored storage proves that native stack traffic uses
// the unaligned vector move family rather than relying on frame alignment.
low.func.def public target<x86.avx2.core> abi(object_function) @spill_i8x32(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %slot = storage {byte_alignment = 1, byte_length = 35} : low.storage<stack>
  %value = vmovdqu32.load.ymm %input {disp32 = 0}
  low.spill %value, %slot {offset = 3} : reg<x86.ymm>, low.storage<stack>
  %restored = low.reload %slot {offset = 3} : low.storage<stack> -> reg<x86.ymm>
  vmovdqu32.store.ymm %restored, %output {disp32 = 0}
  return
}

// Integer and vector results advance through independent two-register banks.
// The third value in each bank crosses the same caller-owned overflow block.
low.func.def target<x86.avx2.core> abi(object_function) @private_mixed_results(%v0: reg<x86.ymm>, %g0: reg<x86.gpr64>, %v1: reg<x86.ymm>, %g1: reg<x86.gpr64>, %v2: reg<x86.ymm>, %g2: reg<x86.gpr64>) -> (reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>) asm {
  return %v2, %g2, %v0, %g0, %v1, %g1
}

low.func.def public target<x86.avx2.core> abi(object_function) @write_mixed_results(%input: reg<x86.gpr64>, %vector_output: reg<x86.gpr64>, %scalar_output: reg<x86.gpr64>) asm {
  %v0 = vmovdqu32.load.ymm %input {disp32 = 0}
  %v1 = vmovdqu32.load.ymm %input {disp32 = 32}
  %v2 = vmovdqu32.load.ymm %input {disp32 = 64}
  %g0 = mov.imm64 17
  %g1 = mov.imm64 29
  %g2 = mov.imm64 43
  %rv0, %rg0, %rv1, %rg1, %rv2, %rg2 = low.func.call @private_mixed_results(%v0, %g0, %v1, %g1, %v2, %g2) : (reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>) -> (reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>)
  vmovdqu32.store.ymm %rv0, %vector_output {disp32 = 0}
  vmovdqu32.store.ymm %rv1, %vector_output {disp32 = 32}
  vmovdqu32.store.ymm %rv2, %vector_output {disp32 = 64}
  mov.store.gpr64 %rg0, %scalar_output {disp32 = 0}
  mov.store.gpr64 %rg1, %scalar_output {disp32 = 8}
  mov.store.gpr64 %rg2, %scalar_output {disp32 = 16}
  return
}

// INTEGER and SSE argument banks advance independently. The seventh integer
// and ninth vector values cross onto the stack at different aligned offsets.
low.func.decl import(native, "native_vector_mix") target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, vector<8xi32>) -> ()}) @native_vector_mix(%output: reg<x86.gpr64>, %v0: reg<x86.ymm>, %g0: reg<x86.gpr64>, %v1: reg<x86.ymm>, %g1: reg<x86.gpr64>, %v2: reg<x86.ymm>, %g2: reg<x86.gpr64>, %v3: reg<x86.ymm>, %g3: reg<x86.gpr64>, %v4: reg<x86.ymm>, %g4: reg<x86.gpr64>, %v5: reg<x86.ymm>, %g5: reg<x86.gpr64>, %v6: reg<x86.ymm>, %g6: reg<x86.gpr64>, %v7: reg<x86.ymm>, %v8: reg<x86.ymm>)

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, i64, vector<8xi32>, vector<8xi32>) -> ()}) @call_vector_mix(%output: reg<x86.gpr64>, %v0: reg<x86.ymm>, %g0: reg<x86.gpr64>, %v1: reg<x86.ymm>, %g1: reg<x86.gpr64>, %v2: reg<x86.ymm>, %g2: reg<x86.gpr64>, %v3: reg<x86.ymm>, %g3: reg<x86.gpr64>, %v4: reg<x86.ymm>, %g4: reg<x86.gpr64>, %v5: reg<x86.ymm>, %g5: reg<x86.gpr64>, %v6: reg<x86.ymm>, %g6: reg<x86.gpr64>, %v7: reg<x86.ymm>, %v8: reg<x86.ymm>) asm {
  low.func.call @native_vector_mix(%output, %v0, %g0, %v1, %g1, %v2, %g2, %v3, %g3, %v4, %g4, %v5, %g5, %v6, %g6, %v7, %v8) : (reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.gpr64>, reg<x86.ymm>, reg<x86.ymm>)
  return
}

// Scalar SSE stack arguments use their significant four- and eight-byte forms.
low.func.decl import(native, "native_scalar_stack") target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, f32, f64, f32, f64, f32, f64, f32, f64, f32, f64) -> ()}) @native_scalar_stack(%output: reg<x86.gpr64>, %f0: reg<x86.xmm>, %d0: reg<x86.xmm>, %f1: reg<x86.xmm>, %d1: reg<x86.xmm>, %f2: reg<x86.xmm>, %d2: reg<x86.xmm>, %f3: reg<x86.xmm>, %d3: reg<x86.xmm>, %f4: reg<x86.xmm>, %d4: reg<x86.xmm>)

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, f32, f64, f32, f64, f32, f64, f32, f64, f32, f64) -> ()}) @call_scalar_stack(%output: reg<x86.gpr64>, %f0: reg<x86.xmm>, %d0: reg<x86.xmm>, %f1: reg<x86.xmm>, %d1: reg<x86.xmm>, %f2: reg<x86.xmm>, %d2: reg<x86.xmm>, %f3: reg<x86.xmm>, %d3: reg<x86.xmm>, %f4: reg<x86.xmm>, %d4: reg<x86.xmm>) asm {
  low.func.call @native_scalar_stack(%output, %f0, %d0, %f1, %d1, %f2, %d2, %f3, %d3, %f4, %d4) : (reg<x86.gpr64>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>)
  return
}

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (f32) -> (f32)}) @identity_f32(%value: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  return %value
}

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (f64) -> (f64)}) @identity_f64(%value: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  return %value
}

// Narrow integer values retain only their significant low bits on entry and
// after calls. The wrappers expose the normalized carrier as i32 so linked C++
// can observe the complete Low value rather than only the narrow ABI result.
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i1) -> (i32)}) @widen_i1(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i8) -> (i32)}) @widen_i8(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i16) -> (i32)}) @widen_i16(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

low.func.decl import(native, "native_narrow_i1") target<x86.avx2.core> abi(object_function) abi_layout({signature = (i32) -> (i1)}) @native_narrow_i1(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>)

low.func.decl import(native, "native_narrow_i8") target<x86.avx2.core> abi(object_function) abi_layout({signature = (i32) -> (i8)}) @native_narrow_i8(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>)

low.func.decl import(native, "native_narrow_i16") target<x86.avx2.core> abi(object_function) abi_layout({signature = (i32) -> (i16)}) @native_narrow_i16(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>)

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i32) -> (i32)}) @call_narrow_i1(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %result = low.func.call @native_narrow_i1(%value) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  return %result
}

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i32) -> (i32)}) @call_narrow_i8(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %result = low.func.call @native_narrow_i8(%value) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  return %result
}

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i32) -> (i32)}) @call_narrow_i16(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %result = low.func.call @native_narrow_i16(%value) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  return %result
}

// Half-precision scalars cross the platform boundary in XMM registers while
// Low retains their bits in GPR32 carriers. The ninth value crosses the
// independent SSE exhaustion boundary and occupies one eight-byte stack slot.
low.func.decl import(native, "native_f16_stack") target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, f16, f16, f16, f16, f16, f16, f16, f16, f16) -> ()}) @native_f16_stack(%output: reg<x86.gpr64>, %v0: reg<x86.gpr32>, %v1: reg<x86.gpr32>, %v2: reg<x86.gpr32>, %v3: reg<x86.gpr32>, %v4: reg<x86.gpr32>, %v5: reg<x86.gpr32>, %v6: reg<x86.gpr32>, %v7: reg<x86.gpr32>, %v8: reg<x86.gpr32>)

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, f16, f16, f16, f16, f16, f16, f16, f16, f16) -> ()}) @call_f16_stack(%output: reg<x86.gpr64>, %v0: reg<x86.gpr32>, %v1: reg<x86.gpr32>, %v2: reg<x86.gpr32>, %v3: reg<x86.gpr32>, %v4: reg<x86.gpr32>, %v5: reg<x86.gpr32>, %v6: reg<x86.gpr32>, %v7: reg<x86.gpr32>, %v8: reg<x86.gpr32>) asm {
  low.func.call @native_f16_stack(%output, %v0, %v1, %v2, %v3, %v4, %v5, %v6, %v7, %v8) : (reg<x86.gpr64>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>)
  return
}

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (f16) -> (f16)}) @identity_f16(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  return %value
}

low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<8xi32>) -> (vector<8xi32>)}) @identity_i32x8(%value: reg<x86.ymm>) -> (reg<x86.ymm>) asm {
  return %value
}
