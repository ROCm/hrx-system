func.decl @native_host_fifteen(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64, %g: i64, %h: i64, %i: i64, %j: i64, %k: i64, %l: i64, %m: i64, %n: i64, %o: i64) -> (i64)

// The operands fill all allocatable GPRs. Register-cycle scratch becomes
// available after the call has copied its overflow operands onto the stack.
func.def public @call_fifteen(%seed: i64) -> (i64) {
  %a = scalar.addi %seed, %seed : i64
