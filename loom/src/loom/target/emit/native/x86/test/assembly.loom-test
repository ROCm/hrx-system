// RUN: emit x86-asm @remainder3 fixed=%value:physical_register:7:1 fixed=%result:physical_register:0:1
x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @remainder3(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %wide = movzx.gpr64.gpr32 %value
  %magic = mov.imm64 2863311531
  %multiply = imul.gpr64 %wide, %magic
  %quotient = shr.imm.gpr64 %multiply {shift = 33}
  %product = lea.add_scale.gpr32 %quotient, %quotient {disp32 = 0, scale = 2}
  %input_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %result = sub.gpr32 %input_copy, %product
  return %result
}

// ----
  mov eax, edi
  mov ecx, 2863311531
  imul rax, rcx
  shr rax, 33
  lea ecx, [rax + rax * 2]
  mov eax, edi
  sub eax, ecx
  ret

