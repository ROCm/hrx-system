  %loaded = mov.load.indexed.gpr32 %input, %index {disp32 = 12, scale = 4}
  %sum = add.gpr32 %static, %loaded
  mov.store.gpr32 %sum, %output {disp32 = 16}
  mov.store.indexed.gpr32 %loaded, %output, %index {disp32 = -4, scale = 4}
  return
}

