  add eax, edx
  vpextrd edx, xmm1, 1
  add eax, edx
  vpextrd edx, xmm1, 2
  add eax, edx
  vpextrd edx, xmm1, 3
  add eax, edx
  vpinsrd xmm0, xmm0, eax, 0
  vmovdqu [rcx], xmm0
  ret

