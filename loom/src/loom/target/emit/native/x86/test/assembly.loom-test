// RUN: emit x86-asm @x86_rematerialize_constant_gpr32 x86.gpr32=2
x86.target<scalar> @x86_target

// Both registers hold arguments until the first add. Recreate the constant
// afterward so the function needs no spill storage.
low.func.def target<x86.scalar.core>(@x86_target) @x86_rematerialize_constant_gpr32(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %constant = mov.imm32 7
  %lhs_copy = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %sum = add.gpr32 %lhs_copy, %rhs
  %sum_copy = copy %sum : reg<x86.gpr32> -> reg<x86.gpr32>
  %result = add.gpr32 %sum_copy, %constant
  return %result
}

// ----
  add eax, ecx
  mov ecx, 7
  add eax, ecx
  ret

