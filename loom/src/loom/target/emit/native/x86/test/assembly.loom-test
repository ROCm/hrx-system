low.func.def target<x86.scalar.core>(@x86_target) @x86_fragment(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) asm {
  %mask = mov.imm32 255
  %masked = and.gpr32 %lhs, %mask
  %tag = mov.imm32 240
  %tagged = or.gpr32 %masked, %tag
  %invert = mov.imm32 -1
  %inverted = xor.gpr32 %tagged, %invert
  %mixed = xor.gpr32 %inverted, %rhs
  %left = shl.imm.gpr32 %mixed {shift = 3}
  %arithmetic = sar.imm.gpr32 %left {shift = 1}
  %result = shr.imm.gpr32 %arithmetic {shift = 2}
  return
}

