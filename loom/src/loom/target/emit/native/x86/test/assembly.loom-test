x86.target<avx512> @target

low.func.def schedule(free) target<x86.avx512.core>(@target) @x86_free_load_consumer(%base: reg<x86.gpr64>, %lhs: reg<x86.zmm>, %rhs: reg<x86.zmm>) -> (reg<x86.zmm>, reg<x86.zmm>) asm {
  %loaded = vmovdqu32.load %base {disp32 = 0}
  %used = vpaddd %loaded, %loaded
  %independent = vpaddd %lhs, %rhs
  return %used, %independent
}

