// RUN: emit x86-asm @wide_shift_value_is_count strategy=source fixed=%input:physical_register:7:1 fixed=%result:physical_register:0:1

low.func.def target<x86.scalar.core> @wide_shift_value_is_count(%input: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %masked_input = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %value = and.imm.gpr64 %masked_input {imm32 = 63}
  %shift_input = copy %value : reg<x86.gpr64> -> reg<x86.gpr64>
  %count = copy %value : reg<x86.gpr64> -> reg<x86.rcx>
  %result = shl.cl.gpr64 %shift_input, %count
  return %result
}

