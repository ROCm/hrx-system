// Per-use count copies share RCX with both general register widths.
// Live inputs and multiple counts exercise interference and scheduling.
// RUN: emit x86-asm @word_shifts_reuse_input strategy=source fixed=%value:physical_register:7:1 fixed=%count:physical_register:6:1 fixed=%result:physical_register:0:1

low.func.def target<x86.scalar.core> @word_shifts_reuse_input(%value: reg<x86.gpr32>, %count: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %left_input = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %left_count = copy %count : reg<x86.gpr32> -> reg<x86.ecx>
  %left = shl.cl.gpr32 %left_input, %left_count
  %logical_input = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %logical_count = copy %count : reg<x86.gpr32> -> reg<x86.ecx>
  %logical = shr.cl.gpr32 %logical_input, %logical_count
  %signed_input = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed_count = copy %count : reg<x86.gpr32> -> reg<x86.ecx>
  %signed = sar.cl.gpr32 %signed_input, %signed_count
  %directions_input = copy %left : reg<x86.gpr32> -> reg<x86.gpr32>
  %directions = xor.gpr32 %directions_input, %logical
  %combined_input = copy %directions : reg<x86.gpr32> -> reg<x86.gpr32>
  %combined = xor.gpr32 %combined_input, %signed
  %sum_input = copy %combined : reg<x86.gpr32> -> reg<x86.gpr32>
  %with_count = add.gpr32 %sum_input, %count
  %result_input = copy %with_count : reg<x86.gpr32> -> reg<x86.gpr32>
  %result = xor.gpr32 %result_input, %value
  return %result
}

// ----
  mov eax, edi
  mov ecx, esi
  shl eax, cl
  mov edx, edi
  mov ecx, esi
  shr edx, cl
  mov ebx, edi
  mov ecx, esi
  sar ebx, cl
  xor eax, edx
  xor eax, ebx
  add eax, esi
  xor eax, edi
  ret

// ====

