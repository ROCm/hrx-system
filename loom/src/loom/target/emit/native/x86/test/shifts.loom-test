// RUN: emit x86-asm @wide_shifts_reuse_counts strategy=source fixed=%value:physical_register:7:1 fixed=%left_count:physical_register:6:1 fixed=%right_count:physical_register:2:1 fixed=%result:physical_register:0:1

low.func.def target<x86.scalar.core> @wide_shifts_reuse_counts(%value: reg<x86.gpr64>, %left_count: reg<x86.gpr64>, %right_count: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %left_input = copy %value : reg<x86.gpr64> -> reg<x86.gpr64>
  %left_register = copy %left_count : reg<x86.gpr64> -> reg<x86.rcx>
  %left = shl.cl.gpr64 %left_input, %left_register
  %logical_input = copy %value : reg<x86.gpr64> -> reg<x86.gpr64>
  %right_register = copy %right_count : reg<x86.gpr64> -> reg<x86.rcx>
  %logical = shr.cl.gpr64 %logical_input, %right_register
  %signed_input = copy %left : reg<x86.gpr64> -> reg<x86.gpr64>
  %signed_register = copy %left_count : reg<x86.gpr64> -> reg<x86.rcx>
  %signed = sar.cl.gpr64 %signed_input, %signed_register
  %directions_input = copy %logical : reg<x86.gpr64> -> reg<x86.gpr64>
  %directions = xor.gpr64 %directions_input, %signed
  %left_sum_input = copy %directions : reg<x86.gpr64> -> reg<x86.gpr64>
  %with_left_count = add.gpr64 %left_sum_input, %left_count
  %right_sum_input = copy %with_left_count : reg<x86.gpr64> -> reg<x86.gpr64>
  %with_counts = add.gpr64 %right_sum_input, %right_count
  %result_input = copy %with_counts : reg<x86.gpr64> -> reg<x86.gpr64>
  %result = xor.gpr64 %result_input, %value
  return %result
}

