low.func.def target<x86.scalar.core> @shift_sar_64_immediate(%value: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %input = copy %value : reg<x86.gpr64> -> reg<x86.gpr64>
  %result = sar.imm.gpr64 %input {shift = 63}
  return %result
}

