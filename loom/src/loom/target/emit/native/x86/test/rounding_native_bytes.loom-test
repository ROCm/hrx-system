// RUN: emit x86-native-bytes @avx2_xmm
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @avx2_xmm(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %packed_s = vroundps.xmm %input, 8
  %packed_d = vroundpd.xmm %packed_s, 9
  %scalar_s = vroundss.xmm %packed_d, %packed_d, 10
  %scalar_d = vroundsd.xmm %scalar_s, %scalar_s, 11
  return %scalar_d
}

