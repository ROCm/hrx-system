// RUN: emit x86-native-bytes @avx512_xmm
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @avx512_xmm(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %packed_s = vrndscaleps.xmm %input, 8
  %packed_d = vrndscalepd.xmm %packed_s, 9
  %scalar_s = vrndscaless.xmm %packed_d, %packed_d, 10
  %scalar_d = vrndscalesd.xmm %scalar_s, %scalar_s, 11
  return %scalar_d
}

