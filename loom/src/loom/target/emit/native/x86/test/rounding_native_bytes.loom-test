// RUN: emit x86-native-bytes @avx2_ymm
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @avx2_ymm(%input: reg<x86.ymm>) -> (reg<x86.ymm>) asm {
  %packed_s = vroundps.ymm %input, 8
  %packed_d = vroundpd.ymm %packed_s, 9
  return %packed_d
}

