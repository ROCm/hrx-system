// The numerator remains live across MUL's implicit RAX/RDX writes. A 32-bit
// move still clears the upper half when source and destination alias.
// RUN: emit x86-bytes @high_product_with_live_input fixed=%input:physical_register:0:1 fixed=%multiplier:physical_register:8:1 fixed=%result:physical_register:0:1

low.func.def target<x86.scalar.core> @high_product_with_live_input(%input: reg<x86.gpr32>, %multiplier: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %preserved = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %numerator = movzx.gpr64.gpr32 %preserved
  %accumulator = copy %numerator : reg<x86.gpr64> -> reg<x86.rax>
  %high = mul.high.gpr64 %accumulator, %multiplier
  %wide = copy %high : reg<x86.rdx> -> reg<x86.gpr64>
  %narrow = mov.trunc.gpr32.gpr64 %wide
  %result = add.gpr32 %narrow, %preserved
  return %result
}

// ----
8b c8 8b c1 49 f7 e0 8b c2 01 c8 c3

// ====

// A numerator arriving in RDX must be preserved outside the high-result domain.
// RUN: emit x86-bytes @high_product_with_live_input fixed=%input:physical_register:2:1 fixed=%multiplier:physical_register:8:1 fixed=%result:physical_register:0:1

low.func.def target<x86.scalar.core> @high_product_with_live_input(%input: reg<x86.gpr32>, %multiplier: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %preserved = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %numerator = movzx.gpr64.gpr32 %preserved
  %accumulator = copy %numerator : reg<x86.gpr64> -> reg<x86.rax>
  %high = mul.high.gpr64 %accumulator, %multiplier
  %wide = copy %high : reg<x86.rdx> -> reg<x86.gpr64>
  %narrow = mov.trunc.gpr32.gpr64 %wide
  %result = add.gpr32 %narrow, %preserved
  return %result
}

