type.decl import("native", "object") @Object

func.decl abi(object_function, {calling_convention = "iree_status"}) @object_create(%failure: i32) -> (ref<@Object>)

func.decl abi(object_function, {calling_convention = "iree_status"}) @object_consume(%owner: ref<@Object>, %failure: i32)

func.decl abi(object_function, {calling_convention = "iree_status"}) @object_read(%pointer: ptr<@Object>, %seed: i64, %failure: i32) -> (i64, vector<8xf32>)

// The original owner is consumed before the borrow's last use. Protection
// retires after object_read, while its scalar and vector results remain live.
func.def public noinline abi(object_function, {calling_convention = "iree_status"}) @object_run(%failure: i32, %seed: i64) -> (i64, vector<8xf32>) {
  %owner = func.call @object_create(%failure) : (i32) -> (ref<@Object>)
  %pointer = ref.borrow %owner : ref<@Object> -> ptr<@Object>
  func.call @object_consume(%owner, %failure) : (ref<@Object>, i32)
  %value, %wide = func.call @object_read(%pointer, %seed, %failure) : (ptr<@Object>, i64, i32) -> (i64, vector<8xf32>)
  func.return %value, %wide : i64, vector<8xf32>
}

func.def public abi(object_function, {calling_convention = "iree_status"}) @object_forward(%failure: i32, %seed: i64) -> (i64, vector<8xf32>) {
  %value, %wide = func.call @object_run(%failure, %seed) : (i32, i64) -> (i64, vector<8xf32>)
  func.return %value, %wide : i64, vector<8xf32>
}

// Borrowed-only input must reject before even the scalar result is published.
func.def public abi(object_function, {calling_convention = "iree_status"}) @object_escape(%pointer: ptr<@Object>) -> (i64, ptr<@Object>) {
  %marker = scalar.constant 42 : i64
  func.return %marker, %pointer : i64, ptr<@Object>
}

func.def public abi(object_function, {calling_convention = "iree_status"}) @object_identity(%owner: ref<@Object>, %pointer: ptr<@Object>) -> (ref<@Object>, i1, i1) {
  %copy = ref.duplicate %owner : ref<@Object>
  %same = ref.compare.eq %owner, %pointer : ref<@Object>, ptr<@Object>
  %missing = ref.compare.null %pointer : ptr<@Object>
  ref.release %owner : ref<@Object>
  func.return %copy, %same, %missing : ref<@Object>, i1, i1
}

func.def public abi(object_function, {calling_convention = "iree_status"}) @object_select(%condition: i1, %left: ptr<@Object>, %right: ptr<@Object>) -> (ptr<@Object>) {
  %selected = scf.select %condition, %left, %right : ptr<@Object>
  func.return %selected : ptr<@Object>
}

func.def public abi(object_function, {calling_convention = "iree_status"}) @object_null() -> (ref<@Object>, ptr<@Object>) {
  %owner = ref.null : ref<@Object>
  %pointer = ref.null : ptr<@Object>
  func.return %owner, %pointer : ref<@Object>, ptr<@Object>
}

func.def public abi(object_function, {calling_convention = "iree_status"}) @object_stack(%a: ptr<@Object>, %b: ptr<@Object>, %c: ptr<@Object>, %d: ptr<@Object>, %e: ptr<@Object>, %f: ptr<@Object>, %g: ptr<@Object>) -> (ptr<@Object>) {
  func.return %g : ptr<@Object>
}

func.def public abi(object_function, {calling_convention = "iree_status"}) @object_twice(%pointer: ptr<@Object>) -> (ptr<@Object>, ptr<@Object>) {
  %second = ref.duplicate %pointer : ptr<@Object>
  func.return %pointer, %second : ptr<@Object>, ptr<@Object>
}

// Explicit releases cover resources with no other source use.
func.def public abi(object_function, {calling_convention = "iree_status"}) @object_drop_input(%owner: ref<@Object>) {
  ref.release %owner : ref<@Object>
  func.return
}

func.def public abi(object_function, {calling_convention = "iree_status"}) @object_drop_result() {
  %c0 = scalar.constant 0 : i32
  %owner = func.call @object_create(%c0) : (i32) -> (ref<@Object>)
  ref.release %owner : ref<@Object>
  func.return
}

// Cyclic block-argument transport exchanges two owners without a retain pair.
func.def public abi(object_function, {calling_convention = "iree_status"}) @object_rotate(%first: ref<@Object>, %second: ref<@Object>, %count: i32) -> (ref<@Object>, ref<@Object>) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  cfg.br ^loop(%first: ref<@Object>, %second: ref<@Object>, %count: i32)
^loop(%left: ref<@Object>, %right: ref<@Object>, %remaining: i32):
  %again = scalar.cmpi ne, %remaining, %c0 : i32
  cfg.cond_br %again, ^swap, ^done
^swap:
  %next = scalar.subi %remaining, %c1 : i32
  cfg.br ^loop(%right: ref<@Object>, %left: ref<@Object>, %next: i32)
^done:
  func.return %left, %right : ref<@Object>, ref<@Object>
}
