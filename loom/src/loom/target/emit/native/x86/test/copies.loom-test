// ====

// RUN: emit x86-asm @simd128_xmm_branch_swap
x86.target<simd128> @target

low.func.def target<x86.simd128.core>(@target) @simd128_xmm_branch_swap(%lhs: reg<x86.xmm>, %rhs: reg<x86.xmm>) asm {
  low.br ^loop(%rhs: reg<x86.xmm>, %lhs: reg<x86.xmm>)
^loop(%a: reg<x86.xmm>, %b: reg<x86.xmm>):
  low.br ^loop(%b: reg<x86.xmm>, %a: reg<x86.xmm>)
}

// ----
  jmp .Lbb1
.Lbb1:
  movdqa xmm2, xmm1
  movdqa xmm1, xmm0
  movdqa xmm0, xmm2
  jmp .Lbb1

// ====

// RUN: emit x86-asm @avx2_ymm_branch_swap
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @avx2_ymm_branch_swap(%lhs: reg<x86.ymm>, %rhs: reg<x86.ymm>) asm {
  low.br ^loop(%rhs: reg<x86.ymm>, %lhs: reg<x86.ymm>)
^loop(%a: reg<x86.ymm>, %b: reg<x86.ymm>):
  low.br ^loop(%b: reg<x86.ymm>, %a: reg<x86.ymm>)
}

// ----
  jmp .Lbb1
.Lbb1:
  vmovdqa ymm2, ymm1
  vmovdqa ymm1, ymm0
  vmovdqa ymm0, ymm2
  jmp .Lbb1

// ====

// RUN: emit x86-asm @avx512_ymm_branch_swap fixed=%a:physical_register:17:1 fixed=%b:physical_register:0:1
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @avx512_ymm_branch_swap(%lhs: reg<x86.ymm>, %rhs: reg<x86.ymm>) asm {
  low.br ^loop(%rhs: reg<x86.ymm>, %lhs: reg<x86.ymm>)
^loop(%a: reg<x86.ymm>, %b: reg<x86.ymm>):
  low.br ^loop(%b: reg<x86.ymm>, %a: reg<x86.ymm>)
}

// ----
  vmovdqa32 ymm17, ymm1
  jmp .Lbb1
.Lbb1:
  vmovdqa32 ymm1, ymm17
  vmovdqa32 ymm17, ymm0
  vmovdqa ymm0, ymm1
  jmp .Lbb1

// ====

// RUN: emit x86-asm @simd128_copy_rejects_high_register fixed=%input:physical_register:16:1
// The allocation boundary rejects positions outside this contract before
// copy emission can select an instruction that requires additional features.
// ERROR@+1: BACKEND/022 {function_name="simd128_copy_rejects_high_register", request_kind="fixed_value", register_class="x86.xmm", location_base="16", location_count="1", location_end="17", allocation_capacity="16"}
low.func.def target<x86.simd128.core> @simd128_copy_rejects_high_register(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = copy %input : reg<x86.xmm> -> reg<x86.xmm>
  return %result
}

// ====

// RUN: emit x86-asm @avx_vnni_copy_rejects_high_register fixed=%input:physical_register:16:1
// The allocation boundary rejects positions outside this contract before
// copy emission can select an instruction that requires additional features.
// ERROR@+1: BACKEND/022 {function_name="avx_vnni_copy_rejects_high_register", request_kind="fixed_value", register_class="x86.ymm", location_base="16", location_count="1", location_end="17", allocation_capacity="16"}
low.func.def target<x86.avx_vnni.core> @avx_vnni_copy_rejects_high_register(%input: reg<x86.ymm>) -> (reg<x86.ymm>) asm {
  %result = copy %input : reg<x86.ymm> -> reg<x86.ymm>
  return %result
}

// ====

// The two-address add reads the same fixed register it writes. Its input copy
// materializes there while the original argument remains independently live.
// RUN: emit x86-asm @fixed_two_address_result strategy=source fixed=%source:physical_register:2:1 fixed=%rhs:physical_register:1:1 fixed=%result:physical_register:3:1
x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @fixed_two_address_result(%source: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %copy = copy %source : reg<x86.gpr64> -> reg<x86.gpr64>
  %result = add.gpr64 %copy, %rhs
  return %source, %result
}

// ----
  mov rbx, rdx
  add rbx, rcx
  ret
