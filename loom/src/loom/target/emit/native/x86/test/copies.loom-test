// Explicit bindings keep the copy packets observable. Narrow AVX copies use
// VEX unless either physical operand requires EVEX.

// RUN: emit x86-asm @simd128_xmm_copy_0_to_1 strategy=source fixed=%input:physical_register:0:1 fixed=%result:physical_register:1:1
x86.target<simd128> @target

low.func.def target<x86.simd128.core>(@target) @simd128_xmm_copy_0_to_1(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = copy %input : reg<x86.xmm> -> reg<x86.xmm>
  return %result
}

// ----
  movdqa xmm1, xmm0
  ret

