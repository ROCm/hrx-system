// RUN: emit x86-native-bytes @ones_xmm
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @ones_xmm() -> (reg<x86.xmm>) asm {
  %value = vpcmpeqd.ones.xmm
  return %value
}

