  %single_word = avx512.vcvttss2usi.gpr32.xmm %single
  %single_wide = avx512.vcvttss2usi.gpr64.xmm %single
  %double_word = avx512.vcvttsd2usi.gpr32.xmm %double
  %double_wide = avx512.vcvttsd2usi.gpr64.xmm %double
