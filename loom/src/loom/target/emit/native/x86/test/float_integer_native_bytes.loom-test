low.func.def target<x86.avx2.core>(@target) @signed_packed_word_float_integer(%xmm: reg<x86.xmm>, %ymm: reg<x86.ymm>) -> (reg<x86.xmm>) asm {
  %single_xmm = vcvttps2dq.xmm.xmm %xmm
  %single_ymm = vcvttps2dq.ymm.ymm %ymm
  %double_xmm = vcvttpd2dq.xmm.xmm %xmm
  %double_ymm = vcvttpd2dq.xmm.ymm %ymm
  return %double_ymm
}

