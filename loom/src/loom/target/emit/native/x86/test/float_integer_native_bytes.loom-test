// RUN: emit x86-native-bytes @avx512_packed_word_float_integer
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @avx512_packed_word_float_integer(%xmm: reg<x86.xmm>, %ymm: reg<x86.ymm>, %zmm: reg<x86.zmm>) -> (reg<x86.ymm>) asm {
  %signed_single_zmm = avx512.vcvttps2dq.zmm.zmm %zmm
  %signed_double_zmm = avx512.vcvttpd2dq.ymm.zmm %zmm
  %unsigned_single_xmm = avx512.vcvttps2udq.xmm.xmm %xmm
  %unsigned_single_ymm = avx512.vcvttps2udq.ymm.ymm %ymm
  %unsigned_single_zmm = avx512.vcvttps2udq.zmm.zmm %zmm
  %unsigned_double_xmm = avx512.vcvttpd2udq.xmm.xmm %xmm
  %unsigned_double_ymm = avx512.vcvttpd2udq.xmm.ymm %ymm
  %unsigned_double_zmm = avx512.vcvttpd2udq.ymm.zmm %zmm
  return %unsigned_double_zmm
}

