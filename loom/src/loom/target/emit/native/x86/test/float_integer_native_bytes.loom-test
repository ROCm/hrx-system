// RUN: emit x86-native-bytes @signed_scalar_float_integer
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @signed_scalar_float_integer(%single: reg<x86.xmm>, %double: reg<x86.xmm>) -> (reg<x86.gpr64>) asm {
  %single_word = vcvttss2si.gpr32.xmm %single
  %single_wide = vcvttss2si.gpr64.xmm %single
  %double_word = vcvttsd2si.gpr32.xmm %double
  %double_wide = vcvttsd2si.gpr64.xmm %double
  return %double_wide
}

