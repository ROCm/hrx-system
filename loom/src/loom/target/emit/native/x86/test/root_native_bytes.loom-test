// RUN: emit x86-native-bytes @bmi2_i32
x86.target<scalar> @target {features = [bmi2]}

low.func.def target<x86.scalar.core>(@target) @bmi2_i32(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %left = shlx.gpr32 %lhs, %rhs
  %signed = sarx.gpr32 %lhs, %rhs
  %unsigned = shrx.gpr32 %lhs, %rhs
  return %left, %signed, %unsigned
}

