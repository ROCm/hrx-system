low.func.def target<x86.avx2.core>(@target) @avx2_ymm(%input: reg<x86.ymm>) -> (reg<x86.ymm>) asm {
  %sqrt_f32 = vsqrtps.ymm %input
  %sqrt_f64 = vsqrtpd.ymm %sqrt_f32
  %rsqrt_f32 = vrsqrtps.ymm %sqrt_f64
  return %rsqrt_f32
}

