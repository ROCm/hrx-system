  %r1 = avx_vnni.vpdpbusds.ymm %r0, %byte_lhs, %byte_rhs
  %r2 = avx_vnni.vpdpwssd.ymm %r1, %word_lhs, %word_rhs
  %r3 = avx_vnni.vpdpwssds.ymm %r2, %word_lhs, %word_rhs
  return %r3
}

