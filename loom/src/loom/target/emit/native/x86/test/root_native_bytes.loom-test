// RUN: emit x86-native-bytes @fp16_xmm
x86.target<avx512> @target {features = [avx512fp16]}

low.func.def target<x86.avx512_features.core>(@target) @fp16_xmm(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %sqrt = vsqrtph.xmm %input
  %rsqrt = vrsqrtph.xmm %sqrt
  %sqrt_scalar = vsqrtsh.xmm %rsqrt, %rsqrt
  %rsqrt_scalar = vrsqrtsh.xmm %sqrt_scalar, %sqrt_scalar
  return %rsqrt_scalar
}

