// RUN: emit x86-native-bytes @avx2_xmm
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @avx2_xmm(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %sqrt_f32 = vsqrtps.xmm %input
  %sqrt_f64 = vsqrtpd.xmm %sqrt_f32
  %rsqrt_f32 = vrsqrtps.xmm %sqrt_f64
  %sqrt_scalar_f32 = vsqrtss.xmm %rsqrt_f32, %rsqrt_f32
  %sqrt_scalar_f64 = vsqrtsd.xmm %sqrt_scalar_f32, %sqrt_scalar_f32
  %rsqrt_scalar_f32 = vrsqrtss.xmm %sqrt_scalar_f64, %sqrt_scalar_f64
  return %rsqrt_scalar_f32
}

