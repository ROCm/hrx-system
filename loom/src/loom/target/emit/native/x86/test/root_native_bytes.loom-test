// RUN: emit x86-native-bytes @avx512_xmm
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @avx512_xmm(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %rsqrt_f32 = vrsqrt14ps.xmm %input
  %rsqrt_f64 = vrsqrt14pd.xmm %rsqrt_f32
  %rsqrt_scalar_f32 = vrsqrt14ss.xmm %rsqrt_f64, %rsqrt_f64
  %rsqrt_scalar_f64 = vrsqrt14sd.xmm %rsqrt_scalar_f32, %rsqrt_scalar_f32
  return %rsqrt_scalar_f64
}

