// RUN: emit x86-native-bytes @native_counts_i16 fixed=%input:physical_register:7:1 fixed=%leading:physical_register:9:1 fixed=%trailing:physical_register:10:1 fixed=%population:physical_register:0:1
x86.target<scalar> @target {features = [bmi, popcnt, lzcnt]}

low.func.def target<x86.scalar.core>(@target) @native_counts_i16() -> (reg<x86.gpr32>) asm {
  %input = mov.imm32 65535
  %leading = lzcnt.gpr16 %input
  %trailing = tzcnt.gpr16 %leading
  %population = popcnt.gpr16 %trailing
  return %population
}

