// ====

// Every SysV SIMD register is volatile. The profile-wide ZMM clobber range
// aliases this live YMM value, which needs a spill and reload across the call.
// RUN: emit x86-native-bytes @vector_call_clobbers
x86.target<avx512> @target

low.func.decl target<x86.avx512.core>(@target) @volatile_callee(%output: reg<x86.gpr64>) -> (reg<x86.gpr64>)

low.func.def target<x86.avx512.core>(@target) @vector_call_clobbers(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %vector = vmovdqu32.load.ymm %input {disp32 = 0}
  %returned_output = low.func.call @volatile_callee(%output) : (reg<x86.gpr64>) -> (reg<x86.gpr64>)
  vmovdqu32.store.ymm %vector, %returned_output {disp32 = 0}
  return
}

