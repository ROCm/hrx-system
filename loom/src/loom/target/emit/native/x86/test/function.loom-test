code: c5 7a 10 7f 04 62 42 7d 48 18 ff 62 61 7e 48 7f 3e c3

// ====

// Vector register ordinals never enter the callee-preserved GPR mask.
// RUN: emit x86-frame @vector_load fixed=%value:physical_register:15:1
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @vector_load(%pointer: reg<x86.gpr64>) asm {
  %value = vmovdqu32.load.xmm %pointer {disp32 = 0}
  return
}

