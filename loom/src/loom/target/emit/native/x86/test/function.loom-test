// ====

// RUN: emit x86-frame @zmm_storage fixed=%loaded:physical_register:17:1 fixed=%restored:physical_register:18:1
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @zmm_storage(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %slot = storage {byte_alignment = 1, byte_length = 64} : low.storage<stack>
  %loaded = vmovdqu32.load %input {disp32 = 0}
  low.spill %loaded, %slot : reg<x86.zmm>, low.storage<stack>
  %restored = low.reload %slot : low.storage<stack> -> reg<x86.zmm>
  vmovdqu32.store %restored, %output {disp32 = 0}
