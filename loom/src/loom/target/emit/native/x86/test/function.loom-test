code: 53 55 48 83 ec 68 48 8b df 8b ee c5 fe 6f 03 c5 fc 11 04 24 48 8b fb c5 f8 77 e8 00 00 00 00 c5 fc 10 04 24 c5 fe 7f 00 85 ed 0f 84 3c 00 00 00 c5 fe 6f 40 20 c5 fc 11 44 24 20 c5 fe 6f 40 40 c5 fc 11 44 24 40 48 8b f8 c5 f8 77 e8 00 00 00 00 c5 fc 10 44 24 20 c5 fe 7f 40 20 c5 fc 10 44 24 40 c5 fc 11 04 24 e9 a8 ff ff ff 48 83 c4 68 5d 5b c5 f8 77 c3

// ====

// A spill cell remains reserved across a hole in register liveness. The
// intervening branch's temporary cannot reuse the retained value's cell.
// RUN: emit x86-native-bytes @sparse_spill_cells
x86.target<avx512> @target

low.func.decl target<x86.avx512.core>(@target) @advance(%address: reg<x86.gpr64>) -> (reg<x86.gpr64>)

low.func.def target<x86.avx512.core>(@target) @sparse_spill_cells(%input: reg<x86.gpr64>, %condition: reg<x86.gpr32>) asm {
  %retained = vmovdqu32.load.ymm %input {disp32 = 0}
  %address = low.func.call @advance(%input) : (reg<x86.gpr64>) -> (reg<x86.gpr64>)
  low.cond_br %condition, ^other, ^read : reg<x86.gpr32>
^other:
  %temporary = vmovdqu32.load.ymm %address {disp32 = 32}
  %output = low.func.call @advance(%address) : (reg<x86.gpr64>) -> (reg<x86.gpr64>)
  vmovdqu32.store.ymm %temporary, %output {disp32 = 32}
  return
^read:
  vmovdqu32.store.ymm %retained, %address {disp32 = 0}
  return
}

