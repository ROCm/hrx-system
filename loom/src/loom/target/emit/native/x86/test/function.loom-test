// Explicit storage traffic lowers the complete SIMD width family at
// unaligned offsets through native load/store transport.
// RUN: emit x86-native-bytes @xmm_storage
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @xmm_storage(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %slot = storage {byte_alignment = 1, byte_length = 16} : low.storage<stack>
  %loaded = vmovdqu32.load.xmm %input {disp32 = 0}
  low.spill.move %loaded, %slot : reg<x86.xmm>, low.storage<stack>
  %restored = low.reload.move %slot : low.storage<stack> -> reg<x86.xmm>
  vmovdqu32.store.xmm %restored, %output {disp32 = 0}
  return
}

