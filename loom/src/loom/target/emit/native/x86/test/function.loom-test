// ====

// The highest VEX register feeds the highest EVEX register without truncating
// either operand's encoded register number.
// RUN: emit x86-native-bytes @vex_load_evex_broadcast fixed=%pointer:physical_register:7:1 fixed=%output:physical_register:6:1 fixed=%scalar:physical_register:15:1 fixed=%packet:physical_register:31:1
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @vex_load_evex_broadcast(%pointer: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %scalar = vmovss.load.xmm %pointer {disp32 = 4}
  %packet = vbroadcastss %scalar
  vmovdqu32.store %packet, %output {disp32 = 0}
  return
}

