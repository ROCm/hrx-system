// ====

// A half-precision value crosses the platform boundary in XMM while its Low
// carrier occupies four-byte GPR storage. The explicit spill and reload fold
// into entry and return transport without an intermediate GPR.
// RUN: emit x86-native-bytes @stored_half
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) abi_layout({signature = (f16) -> (f16)}) @stored_half(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  low.spill %value, %slot : reg<x86.gpr32>, low.storage<private>
  %restored = low.reload %slot : low.storage<private> -> reg<x86.gpr32>
  return %restored
}

