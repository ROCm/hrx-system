// ====

// Equal structural-branch successors outside the fallthrough position collapse
// to one unconditional transfer without reading the condition.
// RUN: emit x86-native-bytes @same_structural_successor
x86.target<scalar> @target

low.func.def target<x86.scalar.core>(@target) @same_structural_successor(%condition: reg<x86.gpr32>) asm {
  low.br ^loop
^loop:
  low.br ^condition_block
^condition_block:
  low.cond_br %condition, ^loop, ^loop : reg<x86.gpr32>
}

