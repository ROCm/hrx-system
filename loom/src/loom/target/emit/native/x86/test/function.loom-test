callee-preserved: none

// ====

// Native copies transport vector values without treating their ordinals as
// callee-preserved GPRs.
// RUN: emit x86-frame @vector_move fixed=%input:physical_register:0:1 fixed=%copy:physical_register:1:1
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @vector_move(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %copy = copy %input : reg<x86.xmm> -> reg<x86.xmm>
  return %copy
}

