low.func.def target<x86.avx2.core>(@target) @ymm_storage(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %slot = storage {byte_alignment = 1, byte_length = 32} : low.storage<stack>
  %loaded = vmovdqu32.load.ymm %input {disp32 = 0}
  low.spill %loaded, %slot : reg<x86.ymm>, low.storage<stack>
  %restored = low.reload %slot : low.storage<stack> -> reg<x86.ymm>
  vmovdqu32.store.ymm %restored, %output {disp32 = 0}
  return
}

