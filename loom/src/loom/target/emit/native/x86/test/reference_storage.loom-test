// A large reference plane uses compact initialization and retirement loops.
// Code size depends on the operation, not the number of reserved cells.
// RUN: emit x86-native-bytes @reference_plane
x86.target<scalar> @target

low.func.def public target<x86.scalar.core>(@target) abi(object_function, {calling_convention = "iree_status"}) @reference_plane() asm {
  %cells = storage {byte_alignment = 16, byte_length = 1048576} : low.storage<private>
  return
}

