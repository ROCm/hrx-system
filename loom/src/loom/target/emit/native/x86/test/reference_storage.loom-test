// ====

// An owning argument clears its caller cell after loading both words, then
// publishes them to the fresh invocation cell. Cleanup still retires it.
// RUN: emit x86-native-bytes @consume_input
x86.target<scalar> @target

type.decl import("native", "object") @Object

low.func.def public target<x86.scalar.core>(@target) abi(object_function, {calling_convention = "iree_status"}) @consume_input(%owner: reg<x86.ref : ref<@Object>>) -> (reg<x86.gpr32>) asm {
  %missing = ref.compare.null %owner
  return %missing
}

