// ====

// Invocation inputs initialize fresh cells. A borrowed argument copies its
// payload and marks the state without a replacement-release sequence.
// RUN: emit x86-native-bytes @borrow_input
x86.target<scalar> @target

type.decl import("native", "object") @Object

low.func.def public target<x86.scalar.core>(@target) abi(object_function, {calling_convention = "iree_status"}) @borrow_input(%pointer: reg<x86.ref : ptr<@Object>>) -> (reg<x86.gpr32>) asm {
  %missing = ref.compare.null %pointer
  return %missing
}

