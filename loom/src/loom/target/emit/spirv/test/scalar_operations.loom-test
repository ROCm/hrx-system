               OpName %spirv_i32_arithmetic "spirv_i32_arithmetic"
               OpName %lhs "lhs"
               OpName %rhs "rhs"
               OpName %bias "bias"
               OpName %sum "sum"
               OpName %difference "difference"
               OpName %product "product"
               OpName %scaled "scaled"
