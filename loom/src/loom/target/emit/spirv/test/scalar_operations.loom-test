// RUN: emit spirv-dis validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @hal_target {abi = hal_kernel, contract_feature_bits = 33278}

low.kernel.def target<spirv.logical.core>(@hal_target) workgroup_size(1, 1, 1) @spirv_raw_bda_scalar_conversions(%byte_offset: reg<spirv.offset64>) asm {
  %input_i8 = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_ext_i32 = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_sitofp_f32 = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %input_i64 = resource<hal_binding> {index = 3, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_trunc_i32 = resource<hal_binding> {index = 4, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %input_f16 = resource<hal_binding> {index = 5, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_extf_f32 = resource<hal_binding> {index = 6, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %input_f32 = resource<hal_binding> {index = 7, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_fptrunc_f16 = resource<hal_binding> {index = 8, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_fptosi_i16 = resource<hal_binding> {index = 9, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %input_i32_bits = resource<hal_binding> {index = 10, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_bitcast_f32 = resource<hal_binding> {index = 11, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %input_i8_view = OpPtrAccessChain.storage_buffer.i8.byte_offset %input_i8, %byte_offset
  %loaded_i8 = OpLoad.storage_buffer.i8 %input_i8_view
  %extended_i32 = OpSConvert.i8.i32 %loaded_i8
  %output_ext_i32_view = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_ext_i32, %byte_offset
  OpStore.storage_buffer.i32 %output_ext_i32_view, %extended_i32
  %converted_f32 = OpConvertSToF.i8.f32 %loaded_i8
  %output_sitofp_f32_view = OpPtrAccessChain.storage_buffer.f32.byte_offset %output_sitofp_f32, %byte_offset
  OpStore.storage_buffer.f32 %output_sitofp_f32_view, %converted_f32
  %input_i64_view = OpPtrAccessChain.storage_buffer.i64.byte_offset %input_i64, %byte_offset
  %loaded_i64 = OpLoad.storage_buffer.i64 %input_i64_view
  %truncated_i32 = OpSConvert.i64.i32 %loaded_i64
  %output_trunc_i32_view = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_trunc_i32, %byte_offset
  OpStore.storage_buffer.i32 %output_trunc_i32_view, %truncated_i32
  %input_f16_view = OpPtrAccessChain.storage_buffer.f16.byte_offset %input_f16, %byte_offset
  %loaded_f16 = OpLoad.storage_buffer.f16 %input_f16_view
  %extended_f32 = OpFConvert.f16.f32 %loaded_f16
  %output_extf_f32_view = OpPtrAccessChain.storage_buffer.f32.byte_offset %output_extf_f32, %byte_offset
  OpStore.storage_buffer.f32 %output_extf_f32_view, %extended_f32
  %input_f32_view = OpPtrAccessChain.storage_buffer.f32.byte_offset %input_f32, %byte_offset
  %loaded_f32 = OpLoad.storage_buffer.f32 %input_f32_view
  %truncated_f16 = OpFConvert.f32.f16 %loaded_f32
  %output_fptrunc_f16_view = OpPtrAccessChain.storage_buffer.f16.byte_offset %output_fptrunc_f16, %byte_offset
  OpStore.storage_buffer.f16 %output_fptrunc_f16_view, %truncated_f16
  %converted_i16 = OpConvertFToS.f32.i16 %loaded_f32
  %output_fptosi_i16_view = OpPtrAccessChain.storage_buffer.i16.byte_offset %output_fptosi_i16, %byte_offset
  OpStore.storage_buffer.i16 %output_fptosi_i16_view, %converted_i16
  %input_i32_bits_view = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_i32_bits, %byte_offset
  %loaded_i32_bits = OpLoad.storage_buffer.i32 %input_i32_bits_view
  %bitcast_f32 = OpBitcast.i32.f32 %loaded_i32_bits
  %output_bitcast_f32_view = OpPtrAccessChain.storage_buffer.f32.byte_offset %output_bitcast_f32, %byte_offset
  OpStore.storage_buffer.f32 %output_bitcast_f32_view, %bitcast_f32
  return
}

