  %i16_ashr = scalar.shrsi %i16_input, %i16_shift : i16
  %i16_lshr = scalar.shrui %i16_input, %i16_shift : i16
  %i16_bits0 = scalar.xori %i16_and, %i16_or : i16
  %i16_bits1 = scalar.xori %i16_xor, %i16_shl : i16
  %i16_bits2 = scalar.xori %i16_ashr, %i16_lshr : i16
  %i16_bits3 = scalar.xori %i16_bits0, %i16_bits1 : i16
  %i16_bits = scalar.xori %i16_bits3, %i16_bits2 : i16
  %i16_eq = scalar.cmpi eq, %i16_input, %i16_rhs : i16
  %i16_ne = scalar.cmpi ne, %i16_input, %i16_rhs : i16
  %i16_slt = scalar.cmpi slt, %i16_input, %i16_rhs : i16
  %i16_sle = scalar.cmpi sle, %i16_input, %i16_rhs : i16
  %i16_sgt = scalar.cmpi sgt, %i16_input, %i16_rhs : i16
  %i16_sge = scalar.cmpi sge, %i16_input, %i16_rhs : i16
  %i16_ult = scalar.cmpi ult, %i16_input, %i16_rhs : i16
  %i16_ule = scalar.cmpi ule, %i16_input, %i16_rhs : i16
  %i16_ugt = scalar.cmpi ugt, %i16_input, %i16_rhs : i16
  %i16_uge = scalar.cmpi uge, %i16_input, %i16_rhs : i16
  %i16_cmp0 = scalar.andi %i16_eq, %i16_ne : i1
  %i16_cmp1 = scalar.ori %i16_slt, %i16_sle : i1
  %i16_cmp2 = scalar.xori %i16_sgt, %i16_sge : i1
  %i16_cmp3 = scalar.andi %i16_ult, %i16_ule : i1
  %i16_cmp4 = scalar.ori %i16_ugt, %i16_uge : i1
  %i16_cmp5 = scalar.xori %i16_cmp0, %i16_cmp1 : i1
  %i16_cmp6 = scalar.ori %i16_cmp2, %i16_cmp3 : i1
  %i16_cmp7 = scalar.xori %i16_cmp5, %i16_cmp6 : i1
  %i16_condition = scalar.ori %i16_cmp7, %i16_cmp4 : i1
  %i16_select = scf.select %i16_condition, %i16_bits, %i16_min : i16

  %i32_min = scalar.constant -2147483648 : i32
  %i32_rhs = scalar.constant 3 : i32
  %i32_shift = scalar.constant 1 : i32
  %i32_and = scalar.andi %i32_input, %i32_rhs : i32
  %i32_or = scalar.ori %i32_input, %i32_rhs : i32
  %i32_xor = scalar.xori %i32_input, %i32_min : i32
  %i32_shl = scalar.shli %i32_input, %i32_shift : i32
  %i32_ashr = scalar.shrsi %i32_input, %i32_shift : i32
  %i32_lshr = scalar.shrui %i32_input, %i32_shift : i32
  %i32_bits0 = scalar.xori %i32_and, %i32_or : i32
  %i32_bits1 = scalar.xori %i32_xor, %i32_shl : i32
  %i32_bits2 = scalar.xori %i32_ashr, %i32_lshr : i32
  %i32_bits3 = scalar.xori %i32_bits0, %i32_bits1 : i32
  %i32_bits = scalar.xori %i32_bits3, %i32_bits2 : i32
  %i32_eq = scalar.cmpi eq, %i32_input, %i32_rhs : i32
  %i32_ne = scalar.cmpi ne, %i32_input, %i32_rhs : i32
  %i32_slt = scalar.cmpi slt, %i32_input, %i32_rhs : i32
  %i32_sle = scalar.cmpi sle, %i32_input, %i32_rhs : i32
  %i32_sgt = scalar.cmpi sgt, %i32_input, %i32_rhs : i32
  %i32_sge = scalar.cmpi sge, %i32_input, %i32_rhs : i32
  %i32_ult = scalar.cmpi ult, %i32_input, %i32_rhs : i32
  %i32_ule = scalar.cmpi ule, %i32_input, %i32_rhs : i32
  %i32_ugt = scalar.cmpi ugt, %i32_input, %i32_rhs : i32
  %i32_uge = scalar.cmpi uge, %i32_input, %i32_rhs : i32
  %i32_cmp0 = scalar.andi %i32_eq, %i32_ne : i1
  %i32_cmp1 = scalar.ori %i32_slt, %i32_sle : i1
  %i32_cmp2 = scalar.xori %i32_sgt, %i32_sge : i1
  %i32_cmp3 = scalar.andi %i32_ult, %i32_ule : i1
  %i32_cmp4 = scalar.ori %i32_ugt, %i32_uge : i1
  %i32_cmp5 = scalar.xori %i32_cmp0, %i32_cmp1 : i1
  %i32_cmp6 = scalar.ori %i32_cmp2, %i32_cmp3 : i1
  %i32_cmp7 = scalar.xori %i32_cmp5, %i32_cmp6 : i1
  %i32_condition = scalar.ori %i32_cmp7, %i32_cmp4 : i1
  %i32_select = scf.select %i32_condition, %i32_bits, %i32_min : i32

  %i64_min = scalar.constant -9223372036854775808 : i64
  %i64_rhs = scalar.constant 3 : i64
  %i64_shift = scalar.constant 1 : i64
  %i64_and = scalar.andi %i64_input, %i64_rhs : i64
  %i64_or = scalar.ori %i64_input, %i64_rhs : i64
  %i64_xor = scalar.xori %i64_input, %i64_min : i64
  %i64_shl = scalar.shli %i64_input, %i64_shift : i64
  %i64_ashr = scalar.shrsi %i64_input, %i64_shift : i64
  %i64_lshr = scalar.shrui %i64_input, %i64_shift : i64
  %i64_bits0 = scalar.xori %i64_and, %i64_or : i64
  %i64_bits1 = scalar.xori %i64_xor, %i64_shl : i64
  %i64_bits2 = scalar.xori %i64_ashr, %i64_lshr : i64
  %i64_bits3 = scalar.xori %i64_bits0, %i64_bits1 : i64
  %i64_bits = scalar.xori %i64_bits3, %i64_bits2 : i64
  %i64_eq = scalar.cmpi eq, %i64_input, %i64_rhs : i64
  %i64_ne = scalar.cmpi ne, %i64_input, %i64_rhs : i64
  %i64_slt = scalar.cmpi slt, %i64_input, %i64_rhs : i64
  %i64_sle = scalar.cmpi sle, %i64_input, %i64_rhs : i64
  %i64_sgt = scalar.cmpi sgt, %i64_input, %i64_rhs : i64
