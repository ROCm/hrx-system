// RUN: emit spirv-dis input=source-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target {contract_feature_bits = 33254}

func.def target(@target) @integer_boolean_matrix(%flag: i1, %i8_input: i8, %i16_input: i16, %i32_input: i32, %i64_input: i64) -> (i1, i1, i8, i16, i32, i64) {
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %bool_and = scalar.andi %flag, %true : i1
  %bool_or = scalar.ori %bool_and, %false : i1
  %bool_xor = scalar.xori %true, %false : i1
  %bool_select = scf.select %flag, %bool_xor, %bool_or : i1

  %i8_min = scalar.constant -128 : i8
  %i8_rhs = scalar.constant 3 : i8
  %i8_shift = scalar.constant 1 : i8
  %i8_and = scalar.andi %i8_input, %i8_rhs : i8
  %i8_or = scalar.ori %i8_input, %i8_rhs : i8
  %i8_xor = scalar.xori %i8_input, %i8_min : i8
  %i8_shl = scalar.shli %i8_input, %i8_shift : i8
  %i8_ashr = scalar.shrsi %i8_input, %i8_shift : i8
  %i8_lshr = scalar.shrui %i8_input, %i8_shift : i8
  %i8_bits0 = scalar.xori %i8_and, %i8_or : i8
  %i8_bits1 = scalar.xori %i8_xor, %i8_shl : i8
  %i8_bits2 = scalar.xori %i8_ashr, %i8_lshr : i8
  %i8_bits3 = scalar.xori %i8_bits0, %i8_bits1 : i8
  %i8_bits = scalar.xori %i8_bits3, %i8_bits2 : i8
  %i8_eq = scalar.cmpi eq, %i8_input, %i8_rhs : i8
  %i8_ne = scalar.cmpi ne, %i8_input, %i8_rhs : i8
  %i8_slt = scalar.cmpi slt, %i8_input, %i8_rhs : i8
  %i8_sle = scalar.cmpi sle, %i8_input, %i8_rhs : i8
  %i8_sgt = scalar.cmpi sgt, %i8_input, %i8_rhs : i8
  %i8_sge = scalar.cmpi sge, %i8_input, %i8_rhs : i8
  %i8_ult = scalar.cmpi ult, %i8_input, %i8_rhs : i8
  %i8_ule = scalar.cmpi ule, %i8_input, %i8_rhs : i8
  %i8_ugt = scalar.cmpi ugt, %i8_input, %i8_rhs : i8
  %i8_uge = scalar.cmpi uge, %i8_input, %i8_rhs : i8
  %i8_cmp0 = scalar.andi %i8_eq, %i8_ne : i1
  %i8_cmp1 = scalar.ori %i8_slt, %i8_sle : i1
  %i8_cmp2 = scalar.xori %i8_sgt, %i8_sge : i1
  %i8_cmp3 = scalar.andi %i8_ult, %i8_ule : i1
  %i8_cmp4 = scalar.ori %i8_ugt, %i8_uge : i1
  %i8_cmp5 = scalar.xori %i8_cmp0, %i8_cmp1 : i1
  %i8_cmp6 = scalar.ori %i8_cmp2, %i8_cmp3 : i1
  %i8_cmp7 = scalar.xori %i8_cmp5, %i8_cmp6 : i1
  %i8_condition = scalar.ori %i8_cmp7, %i8_cmp4 : i1
  %i8_select = scf.select %i8_condition, %i8_bits, %i8_min : i8

  %i16_min = scalar.constant -32768 : i16
  %i16_rhs = scalar.constant 3 : i16
  %i16_shift = scalar.constant 1 : i16
  %i16_and = scalar.andi %i16_input, %i16_rhs : i16
  %i16_or = scalar.ori %i16_input, %i16_rhs : i16
