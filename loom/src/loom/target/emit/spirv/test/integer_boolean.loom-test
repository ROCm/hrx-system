  %i64_cmp7 = scalar.xori %i64_cmp5, %i64_cmp6 : i1
  %i64_condition = scalar.ori %i64_cmp7, %i64_cmp4 : i1
  %i64_select = scf.select %i64_condition, %i64_bits, %i64_min : i64
  func.return %false, %bool_select, %i8_select, %i16_select, %i32_select, %i64_select : i1, i1, i8, i16, i32, i64
}

