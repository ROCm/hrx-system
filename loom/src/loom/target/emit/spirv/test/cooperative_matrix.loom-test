// RUN: emit spirv-dis target=spirv:vulkan1.3+bda+hal features=-COOPERATIVE_MATRIX_KHR validate
// REQUIRES: spirv-dis, spirv-val

// A known-unavailable capability must reach Low validation too.
low.kernel.def target<spirv.logical.core> workgroup_size(32, 1, 1) @unavailable_matrix() asm {
  %seed_value = OpConstant.f32 0
  // ERROR@+1: TARGET/046 {function_name="unavailable_matrix", opcode="spirv.op_composite_construct.cooperative.f32.16x16.accumulator"}
  %seed = OpCompositeConstruct.cooperative.f32.16x16.accumulator %seed_value : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  return
}

