
// RUN: emit spirv-dis target=spirv:vulkan1.3+bda+hal features=FLOAT16,STORAGE_BUFFER_16BIT_ACCESS,COOPERATIVE_MATRIX_KHR validate
// REQUIRES: spirv-dis, spirv-val

low.kernel.def target<spirv.logical.core> workgroup_size(32, 1, 1) @spirv_raw_bda_cooperative_matrix_f16(%byte_offset: reg<spirv.offset64>) asm {
  %lhs_buffer = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %rhs_buffer = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %init_buffer = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %out_buffer = resource<hal_binding> {index = 3, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lhs_view = OpPtrAccessChain.storage_buffer.f16.byte_offset %lhs_buffer, %byte_offset
  %rhs_view = OpPtrAccessChain.storage_buffer.f16.byte_offset %rhs_buffer, %byte_offset
  %init_view = OpPtrAccessChain.storage_buffer.f32.byte_offset %init_buffer, %byte_offset
  %out_view = OpPtrAccessChain.storage_buffer.f32.byte_offset %out_buffer, %byte_offset
  %input_stride_offset = OpConstant.offset64 16
  %input_stride = OpUConvert.offset64.u32 %input_stride_offset
  %output_stride_offset = OpConstant.offset64 16
  %output_stride = OpUConvert.offset64.u32 %output_stride_offset
  %lhs = OpCooperativeMatrixLoadKHR.lhs.f16.16x16.subgroup.storage_buffer %lhs_view, %input_stride, 0
  %rhs = OpCooperativeMatrixLoadKHR.rhs.f16.16x16.subgroup.storage_buffer %rhs_view, %output_stride, 0
  %init = OpCooperativeMatrixLoadKHR.init.f32.16x16.subgroup.storage_buffer %init_view, %output_stride, 0
  %result = OpCooperativeMatrixMulAddKHR.f16.16x16x16.f32.subgroup %lhs, %rhs, %init
  OpCooperativeMatrixStoreKHR.result.f32.16x16.subgroup.storage_buffer %out_view, %result, %output_stride, 0
  return
}

