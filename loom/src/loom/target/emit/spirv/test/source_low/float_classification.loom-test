// RUN: emit spirv-dis target=spirv:vulkan1.3+bda+extended-types input=source-low validate
// REQUIRES: spirv-dis, spirv-val

// Orderedness classifies NaNs in either operand using Shader instructions.
kernel.def @classify_f16() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs: f16, %rhs: f16, %output: buffer) {
  %base = index.constant 0 : offset
  %outputs = buffer.view %output[%base] : buffer -> view<4xi32>
  %ordered = scalar.cmpf ord, %lhs, %rhs : f16
  %unordered = scalar.cmpf uno, %lhs, %rhs : f16
  %ordered_word = scalar.extui %ordered : i1 to i32
  %unordered_word = scalar.extui %unordered : i1 to i32
  view.store %ordered_word, %outputs[0] : i32, view<4xi32>
  view.store %unordered_word, %outputs[1] : i32, view<4xi32>
  %left = vector.splat %lhs : vector<2xf16>
  %right = vector.splat %rhs : vector<2xf16>
  %ordered_lanes = vector.cmpf ord, %left, %right : vector<2xf16> -> vector<2xi1>
  %unordered_lanes = vector.cmpf uno, %left, %right : vector<2xf16> -> vector<2xi1>
  %ordered_lane = vector.extract %ordered_lanes[0] : vector<2xi1> -> i1
  %unordered_lane = vector.extract %unordered_lanes[0] : vector<2xi1> -> i1
  %ordered_lane_word = scalar.extui %ordered_lane : i1 to i32
  %unordered_lane_word = scalar.extui %unordered_lane : i1 to i32
  view.store %ordered_lane_word, %outputs[2] : i32, view<4xi32>
  view.store %unordered_lane_word, %outputs[3] : i32, view<4xi32>
  kernel.return
}

kernel.def @classify_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs: f32, %rhs: f32, %output: buffer) {
  %base = index.constant 0 : offset
  %outputs = buffer.view %output[%base] : buffer -> view<4xi32>
  %ordered = scalar.cmpf ord, %lhs, %rhs : f32
  %unordered = scalar.cmpf uno, %lhs, %rhs : f32
  %ordered_word = scalar.extui %ordered : i1 to i32
  %unordered_word = scalar.extui %unordered : i1 to i32
  view.store %ordered_word, %outputs[0] : i32, view<4xi32>
  view.store %unordered_word, %outputs[1] : i32, view<4xi32>
  %left = vector.splat %lhs : vector<3xf32>
  %right = vector.splat %rhs : vector<3xf32>
  %ordered_lanes = vector.cmpf ord, %left, %right : vector<3xf32> -> vector<3xi1>
  %unordered_lanes = vector.cmpf uno, %left, %right : vector<3xf32> -> vector<3xi1>
  %ordered_lane = vector.extract %ordered_lanes[0] : vector<3xi1> -> i1
  %unordered_lane = vector.extract %unordered_lanes[0] : vector<3xi1> -> i1
  %ordered_lane_word = scalar.extui %ordered_lane : i1 to i32
  %unordered_lane_word = scalar.extui %unordered_lane : i1 to i32
  view.store %ordered_lane_word, %outputs[2] : i32, view<4xi32>
  view.store %unordered_lane_word, %outputs[3] : i32, view<4xi32>
  kernel.return
}

kernel.def @classify_f64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs: f64, %rhs: f64, %output: buffer) {
  %base = index.constant 0 : offset
  %outputs = buffer.view %output[%base] : buffer -> view<4xi32>
  %ordered = scalar.cmpf ord, %lhs, %rhs : f64
  %unordered = scalar.cmpf uno, %lhs, %rhs : f64
  %ordered_word = scalar.extui %ordered : i1 to i32
  %unordered_word = scalar.extui %unordered : i1 to i32
  view.store %ordered_word, %outputs[0] : i32, view<4xi32>
  view.store %unordered_word, %outputs[1] : i32, view<4xi32>
  %left = vector.splat %lhs : vector<4xf64>
  %right = vector.splat %rhs : vector<4xf64>
  %ordered_lanes = vector.cmpf ord, %left, %right : vector<4xf64> -> vector<4xi1>
  %unordered_lanes = vector.cmpf uno, %left, %right : vector<4xf64> -> vector<4xi1>
  %ordered_lane = vector.extract %ordered_lanes[0] : vector<4xi1> -> i1
  %unordered_lane = vector.extract %unordered_lanes[0] : vector<4xi1> -> i1
  %ordered_lane_word = scalar.extui %ordered_lane : i1 to i32
  %unordered_lane_word = scalar.extui %unordered_lane : i1 to i32
  view.store %ordered_lane_word, %outputs[2] : i32, view<4xi32>
  view.store %unordered_lane_word, %outputs[3] : i32, view<4xi32>
  kernel.return
}

