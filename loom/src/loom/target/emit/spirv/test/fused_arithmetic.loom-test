// RUN: emit spirv-dis input=source-low target=spirv:vulkan1.3+bda @caller features=FMA_FLOAT32,FLOAT_CONTROLS2,FLOAT32_SIGNED_ZERO_INF_NAN_PRESERVE,FLOAT16_DENORM_PRESERVE,FLOAT32_DENORM_PRESERVE,FLOAT64_DENORM_PRESERVE,FLOAT16_64_DENORM_PRESERVE,FLOAT_ALL_DENORM_PRESERVE,FLOAT16_ROUNDING_RTE,FLOAT32_ROUNDING_RTE,FLOAT64_ROUNDING_RTE,FLOAT16_64_ROUNDING_RTE,FLOAT_ALL_ROUNDING_RTE validate
// REQUIRES: spirv-dis, spirv-val

// The helper's decorations preserve each source policy. Its caller inherits
// the required floating modes, including hardware-coupled companion widths.
func.def noinline @helper(%a: f32, %b: f32, %c: f32) -> (f32) {
  %strict = scalar.fmaf %a, %b, %c : f32
  %finite = scalar.fmaf<nnan|ninf|nsz|afn> %c, %b, %a : f32
  %result = scalar.addf %strict, %finite : f32
  func.return %result : f32
}

func.def public @caller(%value: f32) -> (f32) {
  %c2 = scalar.constant 2.0 : f32
  %c3 = scalar.constant 3.0 : f32
  %result = func.call noinline @helper(%value, %c2, %c3) : (f32, f32, f32) -> (f32)
  func.return %result : f32
}

// ----
               OpCapability Shader
               OpCapability VulkanMemoryModel
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpCapability DenormPreserve
               OpCapability RoundingModeRTE
               OpCapability SignedZeroInfNanPreserve
               OpCapability FMAKHR
               OpCapability FloatControls2
               OpExtension "SPV_KHR_vulkan_memory_model"
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpExtension "SPV_KHR_float_controls"
               OpExtension "SPV_KHR_fma"
               OpExtension "SPV_KHR_float_controls2"
               OpMemoryModel PhysicalStorageBuffer64 Vulkan
               OpEntryPoint GLCompute %caller "caller"
               OpExecutionMode %caller LocalSize 1 1 1
               OpExecutionMode %caller DenormPreserve 32
               OpExecutionMode %caller DenormPreserve 16
               OpExecutionMode %caller DenormPreserve 64
               OpExecutionMode %caller RoundingModeRTE 16
               OpExecutionMode %caller RoundingModeRTE 64
               OpExecutionMode %caller RoundingModeRTE 32
               OpExecutionMode %caller SignedZeroInfNanPreserve 32
               OpName %helper "helper"
               OpName %a "a"
               OpName %strict "strict"
               OpName %finite "finite"
               OpName %result "result"
               OpName %caller "caller"
               OpName %value "value"
               OpName %result_0 "result"
               OpDecorate %8 FPFastMathMode None
               OpDecorate %finite NoContraction
               OpDecorate %result NoContraction
               OpMemberDecorate %_struct_23 0 Offset 0
               OpDecorate %_struct_23 Block
               OpDecorate %22 DescriptorSet 0
               OpDecorate %22 Binding 0
               OpDecorate %26 DescriptorSet 0
               OpDecorate %26 Binding 1
      %float = OpTypeFloat 32
          %3 = OpTypeFunction %float %float
    %float_2 = OpConstant %float 2
    %float_3 = OpConstant %float 3
       %bool = OpTypeBool
%float_0x1_8p_128 = OpConstant %float 0x1.8p+128
       %uint = OpTypeInt 32 0
        %int = OpTypeInt 32 1
      %int_0 = OpConstant %int 0
 %_struct_23 = OpTypeStruct %float
%_ptr_StorageBuffer__struct_23 = OpTypePointer StorageBuffer %_struct_23
%_ptr_StorageBuffer_float = OpTypePointer StorageBuffer %float
         %22 = OpVariable %_ptr_StorageBuffer__struct_23 StorageBuffer
         %26 = OpVariable %_ptr_StorageBuffer__struct_23 StorageBuffer
       %void = OpTypeVoid
         %28 = OpTypeFunction %void
     %helper = OpFunction %float DontInline %3
          %a = OpFunctionParameter %float
          %5 = OpLabel
          %8 = OpFmaKHR %float %a %float_2 %float_3
         %10 = OpFUnordNotEqual %bool %8 %8
         %14 = OpBitcast %uint %float_0x1_8p_128
         %15 = OpBitcast %uint %8
         %16 = OpSelect %uint %10 %14 %15
     %strict = OpBitcast %float %16
     %finite = OpFmaKHR %float %float_3 %float_2 %a
     %result = OpFAdd %float %strict %finite
               OpReturnValue %result
               OpFunctionEnd
     %caller = OpFunction %void None %28
         %29 = OpLabel
         %30 = OpAccessChain %_ptr_StorageBuffer_float %22 %int_0
      %value = OpLoad %float %30 Aligned 4
   %result_0 = OpFunctionCall %float %helper %value
         %33 = OpAccessChain %_ptr_StorageBuffer_float %26 %int_0
               OpStore %33 %result_0 Aligned 4
               OpReturn
               OpFunctionEnd
