// RUN: emit spirv-dis validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target {abi = hal_kernel}

// Function variables precede entry-argument loads and nested executable code.
// Each function owns its declarations; emitting the second cannot move or
// attach its variables to the first function.
low.kernel.def target<spirv.logical.core>(@target) workgroup_size(1, 1, 1) @word_storage(%input: reg<spirv.id : i32>) asm {
  %zero = OpConstant.i32 0
  %positive = OpSGreaterThan %input, %zero
  low.scf.if %positive {
    %storage = storage {byte_alignment = 4, byte_length = 8} : low.storage<private>
    %base = storage_address %storage : low.storage<private> -> reg<spirv.ptr.function.array.i32>
    %ptr = OpAccessChain.function.i32.element_index %base, %zero
    OpStore.function.i32 %ptr, %input
    %loaded = OpLoad.function.i32 %ptr
  }
  return
}

low.kernel.def target<spirv.logical.core>(@target) workgroup_size(1, 1, 1) @float_storage() asm {
  %storage = storage {byte_alignment = 4, byte_length = 8} : low.storage<private>
  %base = storage_address %storage : low.storage<private> -> reg<spirv.ptr.function.array.f32>
  %offset = OpConstant.offset64 4
  %value = OpConstant.f32 1080033280
  %ptr = OpAccessChain.function.f32.byte_offset %base, %offset
  OpStore.function.f32 %ptr, %value
  %loaded = OpLoad.function.f32 %ptr
  return
}

// ----
               OpCapability Shader
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpMemoryModel PhysicalStorageBuffer64 GLSL450
               OpEntryPoint GLCompute %word_storage "word_storage"
               OpEntryPoint GLCompute %float_storage "float_storage"
               OpExecutionMode %word_storage LocalSize 1 1 1
               OpExecutionMode %float_storage LocalSize 1 1 1
               OpName %word_storage "word_storage"
               OpName %input "input"
               OpName %zero "zero"
               OpName %positive "positive"
               OpName %base "base"
               OpName %ptr "ptr"
               OpName %loaded "loaded"
               OpName %float_storage "float_storage"
               OpName %base_0 "base"
               OpName %offset "offset"
               OpName %value "value"
               OpName %ptr_0 "ptr"
               OpName %loaded_0 "loaded"
               OpModuleProcessed "iree.vulkan.bda.v1[word_storage].root=0,32"
               OpModuleProcessed "iree.vulkan.bda.v1[word_storage].constant_offset=32"
               OpModuleProcessed "iree.vulkan.bda.v1[word_storage].constant_length=4"
               OpModuleProcessed "iree.vulkan.bda.v1[word_storage].bindings=0"
               OpModuleProcessed "iree.vulkan.bda.v1[float_storage].root=0,32"
               OpModuleProcessed "iree.vulkan.bda.v1[float_storage].constant_offset=32"
               OpModuleProcessed "iree.vulkan.bda.v1[float_storage].constant_length=0"
               OpModuleProcessed "iree.vulkan.bda.v1[float_storage].bindings=0"
               OpDecorate %_arr_uint_uint_1 ArrayStride 4
               OpDecorate %_struct_42 Block
               OpMemberDecorate %_struct_42 0 Offset 0
               OpMemberDecorate %_struct_42 1 Offset 8
               OpMemberDecorate %_struct_42 2 Offset 16
               OpMemberDecorate %_struct_42 3 Offset 20
               OpMemberDecorate %_struct_42 4 Offset 24
               OpMemberDecorate %_struct_42 5 Offset 28
               OpMemberDecorate %_struct_42 6 Offset 32
       %void = OpTypeVoid
          %4 = OpTypeFunction %void
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
%_ptr_PushConstant_uint = OpTypePointer PushConstant %uint
      %int_6 = OpConstant %int 6
      %int_0 = OpConstant %int 0
       %zero = OpConstant %int 0
       %bool = OpTypeBool
     %uint_2 = OpConstant %uint 2
%_arr_int_uint_2 = OpTypeArray %int %uint_2
%_ptr_Function__arr_int_uint_2 = OpTypePointer Function %_arr_int_uint_2
%_ptr_Function_int = OpTypePointer Function %int
      %float = OpTypeFloat 32
%_arr_float_uint_2 = OpTypeArray %float %uint_2
%_ptr_Function__arr_float_uint_2 = OpTypePointer Function %_arr_float_uint_2
      %ulong = OpTypeInt 64 0
     %offset = OpConstant %ulong 4
      %value = OpConstant %float 3.5
    %ulong_2 = OpConstant %ulong 2
%_ptr_Function_float = OpTypePointer Function %float
     %uint_1 = OpConstant %uint 1
%_arr_uint_uint_1 = OpTypeArray %uint %uint_1
 %_struct_42 = OpTypeStruct %ulong %ulong %uint %uint %uint %uint %_arr_uint_uint_1
%_ptr_PushConstant__struct_42 = OpTypePointer PushConstant %_struct_42
          %2 = OpVariable %_ptr_PushConstant__struct_42 PushConstant
%word_storage = OpFunction %void None %4
          %5 = OpLabel
       %base = OpVariable %_ptr_Function__arr_int_uint_2 Function
         %11 = OpAccessChain %_ptr_PushConstant_uint %2 %int_6 %int_0
         %12 = OpLoad %uint %11 Aligned 4
      %input = OpBitcast %int %12
   %positive = OpSGreaterThan %bool %input %zero
               OpSelectionMerge %18 None
               OpBranchConditional %positive %17 %18
         %17 = OpLabel
        %ptr = OpAccessChain %_ptr_Function_int %base %zero
               OpStore %ptr %input Aligned 4
     %loaded = OpLoad %int %ptr Aligned 4
               OpBranch %18
         %18 = OpLabel
               OpReturn
               OpFunctionEnd
%float_storage = OpFunction %void None %4
         %27 = OpLabel
     %base_0 = OpVariable %_ptr_Function__arr_float_uint_2 Function
         %36 = OpShiftRightLogical %ulong %offset %ulong_2
      %ptr_0 = OpAccessChain %_ptr_Function_float %base_0 %36
               OpStore %ptr_0 %value Aligned 4
   %loaded_0 = OpLoad %float %ptr_0 Aligned 4
               OpReturn
               OpFunctionEnd

