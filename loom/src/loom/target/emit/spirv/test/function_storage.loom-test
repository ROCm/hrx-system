// RUN: emit spirv-dis target=spirv:vulkan1.3+bda+hal features=INT8,INT16,FLOAT16,FLOAT64,BFLOAT16_TYPE_KHR validate
// REQUIRES: spirv-dis, spirv-val

// Storage declarations alone require their scalar capabilities. No arithmetic
// or memory packet can supply those requirements on this path.
low.kernel.def target<spirv.logical.core> workgroup_size(1, 1, 1) @typed_declarations() asm {
  %storage_i8 = storage {byte_alignment = 1, byte_length = 1} : low.storage<private>
  %base_i8 = storage_address %storage_i8 : low.storage<private> -> reg<spirv.ptr.function.array.i8>
  %storage_u8 = storage {byte_alignment = 1, byte_length = 1} : low.storage<private>
  %base_u8 = storage_address %storage_u8 : low.storage<private> -> reg<spirv.ptr.function.array.u8>
  %storage_i16 = storage {byte_alignment = 2, byte_length = 2} : low.storage<private>
  %base_i16 = storage_address %storage_i16 : low.storage<private> -> reg<spirv.ptr.function.array.i16>
  %storage_u16 = storage {byte_alignment = 2, byte_length = 2} : low.storage<private>
  %base_u16 = storage_address %storage_u16 : low.storage<private> -> reg<spirv.ptr.function.array.u16>
  %storage_i32 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %base_i32 = storage_address %storage_i32 : low.storage<private> -> reg<spirv.ptr.function.array.i32>
  %storage_u32 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %base_u32 = storage_address %storage_u32 : low.storage<private> -> reg<spirv.ptr.function.array.u32>
  %storage_i64 = storage {byte_alignment = 8, byte_length = 8} : low.storage<private>
  %base_i64 = storage_address %storage_i64 : low.storage<private> -> reg<spirv.ptr.function.array.i64>
  %storage_u64 = storage {byte_alignment = 8, byte_length = 8} : low.storage<private>
  %base_u64 = storage_address %storage_u64 : low.storage<private> -> reg<spirv.ptr.function.array.u64>
  %storage_f16 = storage {byte_alignment = 2, byte_length = 2} : low.storage<private>
  %base_f16 = storage_address %storage_f16 : low.storage<private> -> reg<spirv.ptr.function.array.f16>
  %storage_bf16 = storage {byte_alignment = 2, byte_length = 2} : low.storage<private>
  %base_bf16 = storage_address %storage_bf16 : low.storage<private> -> reg<spirv.ptr.function.array.bf16>
  %storage_f32 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %base_f32 = storage_address %storage_f32 : low.storage<private> -> reg<spirv.ptr.function.array.f32>
  %storage_f64 = storage {byte_alignment = 8, byte_length = 8} : low.storage<private>
  %base_f64 = storage_address %storage_f64 : low.storage<private> -> reg<spirv.ptr.function.array.f64>
  return
}

