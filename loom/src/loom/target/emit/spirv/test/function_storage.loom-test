               OpCapability Shader
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpCapability Float16
               OpCapability Float64
               OpCapability Int8
               OpCapability Int16
               OpCapability BFloat16TypeKHR
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpExtension "SPV_KHR_bfloat16"
               OpMemoryModel PhysicalStorageBuffer64 GLSL450
               OpEntryPoint GLCompute %typed_declarations "typed_declarations"
               OpExecutionMode %typed_declarations LocalSize 1 1 1
               OpName %typed_declarations "typed_declarations"
               OpName %base_i8 "base_i8"
               OpName %base_u8 "base_u8"
               OpName %base_i16 "base_i16"
               OpName %base_u16 "base_u16"
               OpName %base_i32 "base_i32"
               OpName %base_u32 "base_u32"
               OpName %base_i64 "base_i64"
               OpName %base_u64 "base_u64"
               OpName %base_f16 "base_f16"
               OpName %base_bf16 "base_bf16"
               OpName %base_f32 "base_f32"
               OpName %base_f64 "base_f64"
               OpModuleProcessed "iree.vulkan.bda.v1[typed_declarations].root=0,32"
               OpModuleProcessed "iree.vulkan.bda.v1[typed_declarations].constant_offset=32"
               OpModuleProcessed "iree.vulkan.bda.v1[typed_declarations].constant_length=0"
               OpModuleProcessed "iree.vulkan.bda.v1[typed_declarations].bindings=0"
               OpDecorate %_struct_55 Block
               OpMemberDecorate %_struct_55 0 Offset 0
               OpMemberDecorate %_struct_55 1 Offset 8
               OpMemberDecorate %_struct_55 2 Offset 16
               OpMemberDecorate %_struct_55 3 Offset 20
               OpMemberDecorate %_struct_55 4 Offset 24
               OpMemberDecorate %_struct_55 5 Offset 28
       %void = OpTypeVoid
          %4 = OpTypeFunction %void
       %char = OpTypeInt 8 1
       %uint = OpTypeInt 32 0
     %uint_1 = OpConstant %uint 1
%_arr_char_uint_1 = OpTypeArray %char %uint_1
%_ptr_Function__arr_char_uint_1 = OpTypePointer Function %_arr_char_uint_1
      %uchar = OpTypeInt 8 0
%_arr_uchar_uint_1 = OpTypeArray %uchar %uint_1
%_ptr_Function__arr_uchar_uint_1 = OpTypePointer Function %_arr_uchar_uint_1
      %short = OpTypeInt 16 1
%_arr_short_uint_1 = OpTypeArray %short %uint_1
%_ptr_Function__arr_short_uint_1 = OpTypePointer Function %_arr_short_uint_1
     %ushort = OpTypeInt 16 0
%_arr_ushort_uint_1 = OpTypeArray %ushort %uint_1
%_ptr_Function__arr_ushort_uint_1 = OpTypePointer Function %_arr_ushort_uint_1
        %int = OpTypeInt 32 1
%_arr_int_uint_1 = OpTypeArray %int %uint_1
%_ptr_Function__arr_int_uint_1 = OpTypePointer Function %_arr_int_uint_1
%_arr_uint_uint_1 = OpTypeArray %uint %uint_1
%_ptr_Function__arr_uint_uint_1 = OpTypePointer Function %_arr_uint_uint_1
       %long = OpTypeInt 64 1
%_arr_long_uint_1 = OpTypeArray %long %uint_1
%_ptr_Function__arr_long_uint_1 = OpTypePointer Function %_arr_long_uint_1
      %ulong = OpTypeInt 64 0
%_arr_ulong_uint_1 = OpTypeArray %ulong %uint_1
%_ptr_Function__arr_ulong_uint_1 = OpTypePointer Function %_arr_ulong_uint_1
       %half = OpTypeFloat 16
%_arr_half_uint_1 = OpTypeArray %half %uint_1
%_ptr_Function__arr_half_uint_1 = OpTypePointer Function %_arr_half_uint_1
   %bfloat16 = OpTypeFloat 16 BFloat16KHR
%_arr_bfloat16_uint_1 = OpTypeArray %bfloat16 %uint_1
%_ptr_Function__arr_bfloat16_uint_1 = OpTypePointer Function %_arr_bfloat16_uint_1
      %float = OpTypeFloat 32
%_arr_float_uint_1 = OpTypeArray %float %uint_1
%_ptr_Function__arr_float_uint_1 = OpTypePointer Function %_arr_float_uint_1
     %double = OpTypeFloat 64
%_arr_double_uint_1 = OpTypeArray %double %uint_1
%_ptr_Function__arr_double_uint_1 = OpTypePointer Function %_arr_double_uint_1
 %_struct_55 = OpTypeStruct %ulong %ulong %uint %uint %uint %uint
%_ptr_PushConstant__struct_55 = OpTypePointer PushConstant %_struct_55
          %2 = OpVariable %_ptr_PushConstant__struct_55 PushConstant
%typed_declarations = OpFunction %void None %4
          %5 = OpLabel
    %base_i8 = OpVariable %_ptr_Function__arr_char_uint_1 Function
    %base_u8 = OpVariable %_ptr_Function__arr_uchar_uint_1 Function
   %base_i16 = OpVariable %_ptr_Function__arr_short_uint_1 Function
   %base_u16 = OpVariable %_ptr_Function__arr_ushort_uint_1 Function
   %base_i32 = OpVariable %_ptr_Function__arr_int_uint_1 Function
   %base_u32 = OpVariable %_ptr_Function__arr_uint_uint_1 Function
   %base_i64 = OpVariable %_ptr_Function__arr_long_uint_1 Function
   %base_u64 = OpVariable %_ptr_Function__arr_ulong_uint_1 Function
   %base_f16 = OpVariable %_ptr_Function__arr_half_uint_1 Function
  %base_bf16 = OpVariable %_ptr_Function__arr_bfloat16_uint_1 Function
   %base_f32 = OpVariable %_ptr_Function__arr_float_uint_1 Function
   %base_f64 = OpVariable %_ptr_Function__arr_double_uint_1 Function
               OpReturn
               OpFunctionEnd
