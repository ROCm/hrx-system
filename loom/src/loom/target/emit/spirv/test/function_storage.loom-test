// RUN: emit spirv-dis target=spirv:vulkan1.3+bda+hal features=INT8 validate
// REQUIRES: spirv-dis, spirv-val

// Int8 alone permits Function bytes; StorageBuffer8BitAccess is unnecessary.
low.kernel.def target<spirv.logical.core> workgroup_size(1, 1, 1) @byte_storage() asm {
  %storage = storage {byte_alignment = 1, byte_length = 3} : low.storage<private>
  %base = storage_address %storage : low.storage<private> -> reg<spirv.ptr.function.array.i8>
  %offset = OpConstant.offset64 2
  %value = OpConstant.i8 127
  %ptr = OpAccessChain.function.i8.byte_offset %base, %offset
  OpStore.function.i8 %ptr, %value
  %loaded = OpLoad.function.i8 %ptr
  return
}

// ----
               OpCapability Shader
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpCapability Int8
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpMemoryModel PhysicalStorageBuffer64 GLSL450
               OpEntryPoint GLCompute %byte_storage "byte_storage"
               OpExecutionMode %byte_storage LocalSize 1 1 1
               OpName %byte_storage "byte_storage"
               OpName %base "base"
               OpName %offset "offset"
               OpName %value "value"
               OpName %ptr "ptr"
               OpName %loaded "loaded"
               OpModuleProcessed "iree.vulkan.bda.v1[byte_storage].root=0,32"
               OpModuleProcessed "iree.vulkan.bda.v1[byte_storage].constant_offset=32"
               OpModuleProcessed "iree.vulkan.bda.v1[byte_storage].constant_length=0"
               OpModuleProcessed "iree.vulkan.bda.v1[byte_storage].bindings=0"
               OpDecorate %_struct_18 Block
               OpMemberDecorate %_struct_18 0 Offset 0
               OpMemberDecorate %_struct_18 1 Offset 8
               OpMemberDecorate %_struct_18 2 Offset 16
               OpMemberDecorate %_struct_18 3 Offset 20
               OpMemberDecorate %_struct_18 4 Offset 24
               OpMemberDecorate %_struct_18 5 Offset 28
       %void = OpTypeVoid
          %4 = OpTypeFunction %void
       %char = OpTypeInt 8 1
       %uint = OpTypeInt 32 0
     %uint_3 = OpConstant %uint 3
%_arr_char_uint_3 = OpTypeArray %char %uint_3
%_ptr_Function__arr_char_uint_3 = OpTypePointer Function %_arr_char_uint_3
      %ulong = OpTypeInt 64 0
     %offset = OpConstant %ulong 2
      %value = OpConstant %char 127
%_ptr_Function_char = OpTypePointer Function %char
 %_struct_18 = OpTypeStruct %ulong %ulong %uint %uint %uint %uint
%_ptr_PushConstant__struct_18 = OpTypePointer PushConstant %_struct_18
          %2 = OpVariable %_ptr_PushConstant__struct_18 PushConstant
%byte_storage = OpFunction %void None %4
          %5 = OpLabel
       %base = OpVariable %_ptr_Function__arr_char_uint_3 Function
        %ptr = OpAccessChain %_ptr_Function_char %base %offset
               OpStore %ptr %value Aligned 1
     %loaded = OpLoad %char %ptr Aligned 1
               OpReturn
               OpFunctionEnd


