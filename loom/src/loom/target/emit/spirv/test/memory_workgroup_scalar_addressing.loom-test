spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @workgroup_static_rank2_i32(%value: i32) -> (i32) {
  %byte_length = index.constant 256 : offset
  %base = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<4x8xi32>
  view.store %value, %scratch_view[2, 3] : i32, view<4x8xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[2, 3] : view<4x8xi32> -> i32
  func.return %loaded : i32
}

