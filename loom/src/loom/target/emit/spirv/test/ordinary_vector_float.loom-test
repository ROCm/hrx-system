// RUN: emit spirv-dis input=source-low control-flow=structured-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target {abi = hal_kernel}

// A vector load captures its inputs before an aliasing overwrite. The loop
// preserves separately rounded multiplication and addition: replacing them
// with a fused operation changes the one-iteration result from zero to 2^-46.
kernel.def target(@target) @vector_float_rounding_snapshot() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%count: index, %input: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %bias_aligned = buffer.assume.alignment %bias {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<4xf32>
  %bias_view = buffer.view %bias_aligned[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<4xf32>
  %loaded = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %initial = vector.load %bias_view[0] : view<4xf32> -> vector<4xf32>
  %replacement = scalar.constant 99.0 : f32
  view.store %replacement, %input_view[0] : f32, view<4xf32>
  %total = scf.for %iteration = [%begin to %count step %step](%accumulator = %initial : vector<4xf32>) -> (vector<4xf32>) {
    %product = vector.mulf %loaded, %loaded : vector<4xf32>
    %next = vector.addf %product, %accumulator : vector<4xf32>
    scf.yield %next : vector<4xf32>
  }
  vector.store %total, %output_view[0] : vector<4xf32>, view<4xf32>
  kernel.return
}

// ----
               OpCapability Shader
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpMemoryModel PhysicalStorageBuffer64 GLSL450
               OpEntryPoint GLCompute %vector_float_rounding_snapshot "vector_float_rounding_snapshot"
               OpExecutionMode %vector_float_rounding_snapshot LocalSize 1 1 1
               OpName %vector_float_rounding_snapshot "vector_float_rounding_snapshot"
               OpName %count "count"
               OpName %input_aligned "input_aligned"
               OpName %bias_aligned "bias_aligned"
               OpName %output_aligned "output_aligned"
               OpName %begin "begin"
               OpName %step "step"
               OpName %loaded "loaded"
               OpName %initial "initial"
               OpName %replacement "replacement"
               OpName %product "product"
               OpName %iteration "iteration"
               OpName %accumulator "accumulator"
               OpName %next "next"
               OpName %total "total"
               OpModuleProcessed "iree.vulkan.bda.v1[vector_float_rounding_snapshot].root=0,32"
               OpModuleProcessed "iree.vulkan.bda.v1[vector_float_rounding_snapshot].constant_offset=32"
               OpModuleProcessed "iree.vulkan.bda.v1[vector_float_rounding_snapshot].constant_length=4"
               OpModuleProcessed "iree.vulkan.bda.v1[vector_float_rounding_snapshot].bindings=3"
               OpModuleProcessed "iree.vulkan.bda.parameters.v1[vector_float_rounding_snapshot]=c0,4;b0;b1;b2"
               OpDecorate %_runtimearr_ulong ArrayStride 8
               OpDecorate %_struct_17 Block
               OpMemberDecorate %_struct_17 0 Offset 0
               OpDecorate %_ptr_PhysicalStorageBuffer_float ArrayStride 4
               OpDecorate %product NoContraction
               OpDecorate %next NoContraction
               OpDecorate %_arr_uint_uint_1_0 ArrayStride 4
               OpDecorate %_struct_104 Block
               OpMemberDecorate %_struct_104 0 Offset 0
               OpMemberDecorate %_struct_104 1 Offset 8
               OpMemberDecorate %_struct_104 2 Offset 16
               OpMemberDecorate %_struct_104 3 Offset 20
               OpMemberDecorate %_struct_104 4 Offset 24
               OpMemberDecorate %_struct_104 5 Offset 28
               OpMemberDecorate %_struct_104 6 Offset 32
       %void = OpTypeVoid
          %4 = OpTypeFunction %void
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
%_ptr_PushConstant_uint = OpTypePointer PushConstant %uint
      %int_6 = OpConstant %int 6
      %int_0 = OpConstant %int 0
      %ulong = OpTypeInt 64 0
%_ptr_PushConstant_ulong = OpTypePointer PushConstant %ulong
%_runtimearr_ulong = OpTypeRuntimeArray %ulong
 %_struct_17 = OpTypeStruct %_runtimearr_ulong
%_ptr_PhysicalStorageBuffer__struct_17 = OpTypePointer PhysicalStorageBuffer %_struct_17
      %int_2 = OpConstant %int 2
%_ptr_PhysicalStorageBuffer_ulong = OpTypePointer PhysicalStorageBuffer %ulong
     %uint_1 = OpConstant %uint 1
     %uint_2 = OpConstant %uint 2
      %begin = OpConstant %int 0
       %step = OpConstant %int 1
    %ulong_0 = OpConstant %ulong 0
      %float = OpTypeFloat 32
%_ptr_PhysicalStorageBuffer_float = OpTypePointer PhysicalStorageBuffer %float
    %ulong_4 = OpConstant %ulong 4
    %ulong_8 = OpConstant %ulong 8
   %ulong_12 = OpConstant %ulong 12
    %v4float = OpTypeVector %float 4
%replacement = OpConstant %float 99
       %bool = OpTypeBool
   %uint_1_0 = OpConstant %uint 1
%_arr_uint_uint_1_0 = OpTypeArray %uint %uint_1_0
%_struct_104 = OpTypeStruct %ulong %ulong %uint %uint %uint %uint %_arr_uint_uint_1_0
%_ptr_PushConstant__struct_104 = OpTypePointer PushConstant %_struct_104
          %2 = OpVariable %_ptr_PushConstant__struct_104 PushConstant
%vector_float_rounding_snapshot = OpFunction %void None %4
          %5 = OpLabel
         %11 = OpAccessChain %_ptr_PushConstant_uint %2 %int_6 %int_0
         %12 = OpLoad %uint %11 Aligned 4
      %count = OpBitcast %int %12
         %20 = OpAccessChain %_ptr_PushConstant_ulong %2 %int_0
         %21 = OpLoad %ulong %20 Aligned 8
         %22 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer__struct_17 %21
         %23 = OpAccessChain %_ptr_PushConstant_uint %2 %int_2
         %24 = OpLoad %uint %23 Aligned 4
         %26 = OpAccessChain %_ptr_PhysicalStorageBuffer_ulong %22 %int_0 %24
%input_aligned = OpLoad %ulong %26 Aligned 8
         %29 = OpIAdd %uint %24 %uint_1
         %30 = OpAccessChain %_ptr_PhysicalStorageBuffer_ulong %22 %int_0 %29
%bias_aligned = OpLoad %ulong %30 Aligned 8
         %33 = OpIAdd %uint %24 %uint_2
         %34 = OpAccessChain %_ptr_PhysicalStorageBuffer_ulong %22 %int_0 %33
%output_aligned = OpLoad %ulong %34 Aligned 8
         %39 = OpIAdd %ulong %input_aligned %ulong_0
         %42 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %39
         %43 = OpLoad %float %42 Aligned 4
         %45 = OpIAdd %ulong %input_aligned %ulong_4
         %46 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %45
         %47 = OpLoad %float %46 Aligned 4
         %49 = OpIAdd %ulong %input_aligned %ulong_8
         %50 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %49
         %51 = OpLoad %float %50 Aligned 4
         %53 = OpIAdd %ulong %input_aligned %ulong_12
         %54 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %53
         %55 = OpLoad %float %54 Aligned 4
     %loaded = OpCompositeConstruct %v4float %43 %47 %51 %55
         %58 = OpIAdd %ulong %bias_aligned %ulong_0
         %59 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %58
         %60 = OpLoad %float %59 Aligned 4
         %61 = OpIAdd %ulong %bias_aligned %ulong_4
         %62 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %61
         %63 = OpLoad %float %62 Aligned 4
         %64 = OpIAdd %ulong %bias_aligned %ulong_8
         %65 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %64
         %66 = OpLoad %float %65 Aligned 4
         %67 = OpIAdd %ulong %bias_aligned %ulong_12
         %68 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %67
         %69 = OpLoad %float %68 Aligned 4
    %initial = OpCompositeConstruct %v4float %60 %63 %66 %69
               OpStore %42 %replacement Aligned 4
    %product = OpFMul %v4float %loaded %loaded
         %74 = OpSLessThan %bool %begin %count
         %75 = OpISub %int %count %begin
         %76 = OpULessThan %bool %step %75
         %77 = OpISub %int %count %step
         %78 = OpSelect %int %76 %77 %begin
               OpBranch %79
         %79 = OpLabel
  %iteration = OpPhi %int %begin %5 %83 %82
%accumulator = OpPhi %v4float %initial %5 %next %82
         %88 = OpPhi %bool %74 %5 %84 %82
               OpLoopMerge %81 %82 None
               OpBranchConditional %88 %80 %81
         %80 = OpLabel
       %next = OpFAdd %v4float %product %accumulator
               OpBranch %82
         %82 = OpLabel
         %84 = OpSLessThan %bool %iteration %78
         %83 = OpIAdd %int %iteration %step
               OpBranch %79
         %81 = OpLabel
      %total = OpPhi %v4float %accumulator %79
         %90 = OpCompositeExtract %float %total 0
         %91 = OpCompositeExtract %float %total 1
         %92 = OpCompositeExtract %float %total 2
         %93 = OpCompositeExtract %float %total 3
         %94 = OpIAdd %ulong %output_aligned %ulong_0
         %95 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %94
               OpStore %95 %90 Aligned 4
         %96 = OpIAdd %ulong %output_aligned %ulong_4
         %97 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %96
               OpStore %97 %91 Aligned 4
         %98 = OpIAdd %ulong %output_aligned %ulong_8
         %99 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %98
               OpStore %99 %92 Aligned 4
        %100 = OpIAdd %ulong %output_aligned %ulong_12
        %101 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_float %100
               OpStore %101 %93 Aligned 4
               OpReturn
               OpFunctionEnd
