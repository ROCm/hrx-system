// TEMPLATE: loom/src/loom/test/corpus/source_low/ordinary_vector_structure.loom-test
// RUN: emit spirv-dis input=source-low control-flow=structured-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target {abi = hal_kernel}

kernel.def target(@target) @ordinary_vector_structure_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base_byte_offset = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_byte_offset] : buffer -> view<4xi32>
  %output_view = buffer.view %output_aligned[%base_byte_offset] : buffer -> view<4xi32>
  %a = view.load %input_view[0] : view<4xi32> -> i32
  %b = view.load %input_view[1] : view<4xi32> -> i32
  %c = view.load %input_view[2] : view<4xi32> -> i32
  %d = view.load %input_view[3] : view<4xi32> -> i32
  %condition = scalar.cmpi sgt, %a, %b : i32
  %singleton_from = vector.from_elements %b : vector<1xi32>
  %singleton_splat = vector.splat %a : vector<1xi32>
  %singleton_constant = vector.constant 10 : vector<1xi32>
  %singleton_selected = scf.select %condition, %singleton_splat, %singleton_from : vector<1xi32>
  %singleton_inserted = vector.insert %a into %singleton_selected[0] : i32, vector<1xi32>
  %singleton_value = vector.extract %singleton_inserted[0] : vector<1xi32> -> i32
  %singleton_constant_value = vector.extract %singleton_constant[0] : vector<1xi32> -> i32
  %from = vector.from_elements %a, %b, %c, %d : vector<4xi32>
  %constant = vector.constant 10 : vector<4xi32>
  %splat = vector.splat %singleton_value : vector<4xi32>
  %candidate = scf.select %condition, %from, %constant : vector<4xi32>
  %selected = scf.if %condition -> (vector<4xi32>) {
    view.store %a, %output_view[0] : i32, view<4xi32>
    scf.yield %candidate : vector<4xi32>
  } else {
    view.store %b, %output_view[0] : i32, view<4xi32>
    scf.yield %splat : vector<4xi32>
  }
  %inserted = vector.insert %singleton_constant_value into %selected[2] : i32, vector<4xi32>
  %final = scf.select %condition, %selected, %inserted : vector<4xi32>
  %result0 = vector.extract %final[0] : vector<4xi32> -> i32
  %result1 = vector.extract %final[1] : vector<4xi32> -> i32
  %result2 = vector.extract %final[2] : vector<4xi32> -> i32
  %result3 = vector.extract %final[3] : vector<4xi32> -> i32
  view.store %result0, %output_view[0] : i32, view<4xi32>
  view.store %result1, %output_view[1] : i32, view<4xi32>
  view.store %result2, %output_view[2] : i32, view<4xi32>
  view.store %result3, %output_view[3] : i32, view<4xi32>
  kernel.return
}

// ----
               OpCapability Shader
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpMemoryModel PhysicalStorageBuffer64 GLSL450
               OpEntryPoint GLCompute %ordinary_vector_structure_i32 "ordinary_vector_structure_i32"
               OpExecutionMode %ordinary_vector_structure_i32 LocalSize 1 1 1
               OpName %ordinary_vector_structure_i32 "ordinary_vector_structure_i32"
               OpName %input_aligned "input_aligned"
               OpName %output_aligned "output_aligned"
               OpName %a "a"
               OpName %b "b"
               OpName %c "c"
               OpName %d "d"
               OpName %condition "condition"
               OpName %singleton_constant_value "singleton_constant_value"
               OpName %from "from"
               OpName %constant "constant"
               OpName %splat "splat"
               OpName %candidate "candidate"
               OpName %selected "selected"
               OpName %inserted "inserted"
               OpName %final "final"
               OpName %result0 "result0"
               OpName %result1 "result1"
               OpName %result2 "result2"
               OpName %result3 "result3"
               OpModuleProcessed "iree.vulkan.bda.v1"
               OpModuleProcessed "iree.vulkan.bda.v1.root=0,32"
               OpModuleProcessed "iree.vulkan.bda.v1.constant_offset=32"
               OpModuleProcessed "iree.vulkan.bda.v1.constant_length=0"
               OpModuleProcessed "iree.vulkan.bda.v1.bindings=2"
               OpDecorate %_struct_4 Block
               OpMemberDecorate %_struct_4 0 Offset 0
               OpMemberDecorate %_struct_4 1 Offset 8
               OpMemberDecorate %_struct_4 2 Offset 16
               OpMemberDecorate %_struct_4 3 Offset 20
               OpMemberDecorate %_struct_4 4 Offset 24
               OpMemberDecorate %_struct_4 5 Offset 28
               OpDecorate %_runtimearr_ulong ArrayStride 8
               OpDecorate %_struct_13 Block
               OpMemberDecorate %_struct_13 0 Offset 0
               OpDecorate %_ptr_PhysicalStorageBuffer_int ArrayStride 4
      %ulong = OpTypeInt 64 0
       %uint = OpTypeInt 32 0
  %_struct_4 = OpTypeStruct %ulong %ulong %uint %uint %uint %uint
%_ptr_PushConstant__struct_4 = OpTypePointer PushConstant %_struct_4
          %6 = OpVariable %_ptr_PushConstant__struct_4 PushConstant
       %void = OpTypeVoid
          %8 = OpTypeFunction %void
%_ptr_PushConstant_ulong = OpTypePointer PushConstant %ulong
%_ptr_PushConstant_uint = OpTypePointer PushConstant %uint
%_runtimearr_ulong = OpTypeRuntimeArray %ulong
 %_struct_13 = OpTypeStruct %_runtimearr_ulong
%_ptr_PhysicalStorageBuffer__struct_13 = OpTypePointer PhysicalStorageBuffer %_struct_13
        %int = OpTypeInt 32 1
      %int_0 = OpConstant %int 0
      %int_2 = OpConstant %int 2
%_ptr_PhysicalStorageBuffer_ulong = OpTypePointer PhysicalStorageBuffer %ulong
     %uint_1 = OpConstant %uint 1
    %ulong_0 = OpConstant %ulong 0
%_ptr_PhysicalStorageBuffer_int = OpTypePointer PhysicalStorageBuffer %int
    %ulong_4 = OpConstant %ulong 4
    %ulong_8 = OpConstant %ulong 8
   %ulong_12 = OpConstant %ulong 12
       %bool = OpTypeBool
%singleton_constant_value = OpConstant %int 10
      %v4int = OpTypeVector %int 4
     %v4bool = OpTypeVector %bool 4
%ordinary_vector_structure_i32 = OpFunction %void None %8
          %9 = OpLabel
         %18 = OpAccessChain %_ptr_PushConstant_ulong %6 %int_0
         %19 = OpLoad %ulong %18 Aligned 8
         %20 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer__struct_13 %19
         %21 = OpAccessChain %_ptr_PushConstant_uint %6 %int_2
         %22 = OpLoad %uint %21 Aligned 4
         %24 = OpAccessChain %_ptr_PhysicalStorageBuffer_ulong %20 %int_0 %22
%input_aligned = OpLoad %ulong %24 Aligned 8
         %27 = OpIAdd %uint %22 %uint_1
         %28 = OpAccessChain %_ptr_PhysicalStorageBuffer_ulong %20 %int_0 %27
%output_aligned = OpLoad %ulong %28 Aligned 8
         %31 = OpIAdd %ulong %input_aligned %ulong_0
         %33 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %31
          %a = OpLoad %int %33 Aligned 4
         %36 = OpIAdd %ulong %input_aligned %ulong_4
         %37 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %36
          %b = OpLoad %int %37 Aligned 4
         %40 = OpIAdd %ulong %input_aligned %ulong_8
         %41 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %40
          %c = OpLoad %int %41 Aligned 4
         %44 = OpIAdd %ulong %input_aligned %ulong_12
         %45 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %44
          %d = OpLoad %int %45 Aligned 4
  %condition = OpSGreaterThan %bool %a %b
       %from = OpCompositeConstruct %v4int %a %b %c %d
   %constant = OpCompositeConstruct %v4int %singleton_constant_value %singleton_constant_value %singleton_constant_value %singleton_constant_value
      %splat = OpCompositeConstruct %v4int %a %a %a %a
         %55 = OpCompositeConstruct %v4bool %condition %condition %condition %condition
  %candidate = OpSelect %v4int %55 %from %constant
               OpSelectionMerge %58 None
               OpBranchConditional %condition %57 %59
         %57 = OpLabel
         %60 = OpIAdd %ulong %output_aligned %ulong_0
         %61 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %60
               OpStore %61 %a Aligned 4
               OpBranch %58
         %59 = OpLabel
         %62 = OpIAdd %ulong %output_aligned %ulong_0
         %63 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %62
               OpStore %63 %b Aligned 4
               OpBranch %58
         %58 = OpLabel
   %selected = OpPhi %v4int %candidate %57 %splat %59
   %inserted = OpCompositeInsert %v4int %singleton_constant_value %selected 2
      %final = OpSelect %v4int %55 %selected %inserted
    %result0 = OpCompositeExtract %int %final 0
    %result1 = OpCompositeExtract %int %final 1
    %result2 = OpCompositeExtract %int %final 2
    %result3 = OpCompositeExtract %int %final 3
         %71 = OpIAdd %ulong %output_aligned %ulong_0
         %72 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %71
               OpStore %72 %result0 Aligned 4
         %73 = OpIAdd %ulong %output_aligned %ulong_4
         %74 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %73
               OpStore %74 %result1 Aligned 4
         %75 = OpIAdd %ulong %output_aligned %ulong_8
         %76 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %75
               OpStore %76 %result2 Aligned 4
         %77 = OpIAdd %ulong %output_aligned %ulong_12
         %78 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %77
               OpStore %78 %result3 Aligned 4
               OpReturn
               OpFunctionEnd
