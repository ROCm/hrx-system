%_ptr_StorageBuffer_int = OpTypePointer StorageBuffer %int
          %4 = OpVariable %_ptr_StorageBuffer__struct_5 StorageBuffer
          %8 = OpVariable %_ptr_StorageBuffer__struct_5 StorageBuffer
          %9 = OpVariable %_ptr_StorageBuffer__struct_5 StorageBuffer
         %10 = OpVariable %_ptr_StorageBuffer__struct_5 StorageBuffer
       %void = OpTypeVoid
         %12 = OpTypeFunction %void
         %c0 = OpConstant %int 0
       %bool = OpTypeBool
       %uint = OpTypeInt 32 0
  %source_if = OpFunction %void None %12
         %13 = OpLabel
         %14 = OpAccessChain %_ptr_StorageBuffer_int %4 %int_0
  %numerator = OpLoad %int %14 Aligned 4
         %16 = OpAccessChain %_ptr_StorageBuffer_int %8 %int_0
%denominator = OpLoad %int %16 Aligned 4
