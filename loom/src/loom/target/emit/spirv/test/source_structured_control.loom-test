// RUN: emit spirv-dis input=source-low control-flow=structured-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target

func.def target(@target) @source_while(%limit: index, %step: index, %seed: index) -> (index, index) {
  %result_position, %result_limit = scf.while(%before = %seed : index) -> (index, index) {
    %c0 = index.constant 0 : index
    %step_is_positive = index.cmp sgt, %step, %c0 : index
    %selected_limit = scf.if %step_is_positive -> (index) {
      scf.yield %limit : index
    } else {
      %extended_limit = index.add %limit, %step : index
      scf.yield %extended_limit : index
    }
    %keep_going = index.cmp slt, %before, %selected_limit : index
    scf.condition %keep_going, %before, %selected_limit : i1, index, index
  } do(%body_position: index, %body_limit: index) {
    %next = index.add %body_position, %step : index
    scf.yield %next : index
  }
  func.return %result_position, %result_limit : index, index
}

