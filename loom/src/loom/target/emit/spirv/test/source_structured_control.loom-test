// RUN: emit spirv-dis input=source-low control-flow=structured-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target

func.def target(@target) @source_for_if(%start: index, %limit: index, %step: index, %pivot: index, %seed: index) -> (index) {
  %result = scf.for %i = [%start to %limit step %step](%acc = %seed : index) -> (index) {
    %before = index.cmp slt, %i, %pivot : index
    %next = scf.if %before -> (index) {
      %sum = index.add %acc, %i : index
      scf.yield %sum : index
    } else {
      %difference = index.sub %acc, %i : index
      scf.yield %difference : index
    }
    scf.yield %next : index
  }
  func.return %result : index
}

