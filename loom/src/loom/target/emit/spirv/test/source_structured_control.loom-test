// RUN: emit spirv-dis input=source-low control-flow=structured-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target

func.def target(@target) @source_while(%limit: index, %step: index, %seed: index) -> (index) {
  %result = scf.while(%before = %seed : index) -> (index) {
    %c0 = index.constant 0 : index
    %step_is_positive = index.cmp sgt, %step, %c0 : index
    %selected_limit = scf.if %step_is_positive -> (index) {
      scf.yield %limit : index
    } else {
      %extended_limit = index.add %limit, %step : index
      scf.yield %extended_limit : index
    }
    %keep_going = index.cmp slt, %before, %selected_limit : index
    scf.condition %keep_going, %before : i1, index
  } do(%body: index) {
    %next = index.add %body, %step : index
    scf.yield %next : index
  }
  func.return %result : index
}

