// RUN: pass source-to-low

spirv.target<vulkan1_3> @target {contract_feature_bits = 2147516422}

func.def target(@target) @rejects_i1_atomic(%value: i1, %buffer: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 1} : buffer
  // ERROR@+1: TARGET/002 {field_name="result", actual_type="view<1xi1>"}
  %view = buffer.view %aligned[%base] : buffer -> view<1xi1>
  // ERROR@+1: TARGET/002 {field_name="view", actual_type="view<1xi1>"}
  view.atomic.reduce<andi> %value, %view[0] {ordering = relaxed, scope = workgroup} : i1, view<1xi1>
  func.return
}

