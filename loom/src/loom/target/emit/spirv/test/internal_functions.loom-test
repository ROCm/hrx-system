// ====

// Vulkan SPIR-V forbids recursive call cycles. Exit-bearing helpers retain a
// physical function boundary, so reject recursion before binary emission.
spirv.target<vulkan1_3> @target

// ERROR@+1: SPIRV/032 {function_name="recursive"}
func.def inline target(@target) @recursive(%done: i1, %value: i32) -> (i32) {
  func.exit %done : i1 {
    func.return %value : i32
  }
  %next = func.call @recursive(%done, %value) : (i1, i32) -> (i32)
  func.return %next : i32
}

func.def public target(@target) @recursive_entry(%done: i1, %value: i32) -> (i32) {
  %result = func.call @recursive(%done, %value) : (i1, i32) -> (i32)
  func.return %result : i32
}

// ====

// SPIR-V function types and calls admit signatures wider than the common
// cached arity without imposing an artificial frontend limit.
spirv.target<vulkan1_3> @target

func.def inline target(@target) @sum_nine(%exit_early: i1, %v0: i32, %v1: i32, %v2: i32, %v3: i32, %v4: i32, %v5: i32, %v6: i32, %v7: i32, %v8: i32) -> (i32) {
  func.exit %exit_early : i1 {
    func.return %v8 : i32
  }
  %s01 = scalar.addi %v0, %v1 : i32
  %s23 = scalar.addi %v2, %v3 : i32
  %s45 = scalar.addi %v4, %v5 : i32
  %s67 = scalar.addi %v6, %v7 : i32
  %s0123 = scalar.addi %s01, %s23 : i32
  %s4567 = scalar.addi %s45, %s67 : i32
  %s07 = scalar.addi %s0123, %s4567 : i32
  %sum = scalar.addi %s07, %v8 : i32
  func.return %sum : i32
}

func.def public target(@target) @wide_call(%exit_early: i1, %v0: i32, %v1: i32, %v2: i32, %v3: i32, %v4: i32, %v5: i32, %v6: i32, %v7: i32, %v8: i32) -> (i32) {
  %sum = func.call @sum_nine(%exit_early, %v0, %v1, %v2, %v3, %v4, %v5, %v6, %v7, %v8) : (i1, i32, i32, i32, i32, i32, i32, i32, i32, i32) -> (i32)
  func.return %sum : i32
}

