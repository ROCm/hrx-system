// ====

// Builtin interface variables used only by an internal helper propagate to the
// exported entry through the physical call boundary.
spirv.target<vulkan1_3> @target

func.def inline target(@target) @workitem_helper(%exit_early: i1) -> (index) {
  %lane = kernel.workitem.id<x> : index
  func.exit %exit_early : i1 {
    func.return %lane : index
  }
  func.return %lane : index
}

func.def public target(@target) @call_workitem_helper(%exit_early: i1) -> (index) {
  %lane = func.call @workitem_helper(%exit_early) : (i1) -> (index)
  func.return %lane : index
}

func.def public target(@target) @call_workitem_helper_again(%exit_early: i1) -> (index) {
  %lane = func.call @workitem_helper(%exit_early) : (i1) -> (index)
  func.return %lane : index
}

