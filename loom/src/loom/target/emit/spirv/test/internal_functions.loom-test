// RUN: emit spirv-dis input=source-low control-flow=structured-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target

// The caller deliberately precedes its helper to prove source order does not
// constrain planning. The call returns an aggregate and then continues with
// both selected values.
func.def public target(@target) @call_and_continue(%condition: i1, %lower: index, %upper: index, %step: index, %found: i32, %fallback: i32) -> (i32, index) {
  %selected, %position = func.call @find_pair(%condition, %lower, %upper, %step, %found, %fallback) : (i1, index, index, index, i32, i32) -> (i32, index)
  %c1_i32 = scalar.constant 1 : i32
  %continued_value = scalar.addi %selected, %c1_i32 : i32
  %c1_index = index.constant 1 : index
  %continued_position = index.add %position, %c1_index : index
  func.return %continued_value, %continued_position : i32, index
}

// A return nested in structured loop control terminates only its helper.
func.def inline target(@target) @find_pair(%condition: i1, %lower: index, %upper: index, %step: index, %found: i32, %fallback: i32) -> (i32, index) {
  %selected, %position = scf.for %index = [%lower to %upper step %step](%current = %fallback : i32, %current_position = %upper : index) -> (i32, index) {
    func.exit %condition : i1 {
      func.return %found, %index : i32, index
    }
    scf.yield %current, %current_position : i32, index
  }
  func.return %selected, %position : i32, index
}

