// RUN: emit spirv-dis input=source-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @index_address_conversions(%flag: i1, %i8: i8, %i16: i16, %i32: i32, %i64_raw: i64, %coordinate0: index, %byte_offset0: offset) -> (index, offset, i1, i1, offset, offset, offset, offset, offset, i8, i16, i32, i64, index, index, i32) {
  %i64 = scalar.assume %i64_raw [range(%i64_raw, 0, 2147483647)] : i64
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 2147483647), range(%byte_offset0, 0, 2147483647)] : index, offset
  %flag_index = index.cast %flag : i1 to index
  %flag_offset = index.cast %flag : i1 to offset
  %index_low_bit = index.cast %coordinate : index to i1
  %offset_low_bit = index.cast %byte_offset : offset to i1
  %from_index = index.cast %coordinate : index to offset
  %from_i8 = index.cast %i8 : i8 to offset
  %from_i16 = index.cast %i16 : i16 to offset
  %from_i32 = index.cast %i32 : i32 to offset
  %from_i64 = index.cast %i64 : i64 to offset
  %to_i8 = index.cast %byte_offset : offset to i8
  %to_i16 = index.cast %byte_offset : offset to i16
  %to_i32 = index.cast %byte_offset : offset to i32
  %to_i64 = index.cast %byte_offset : offset to i64
  %to_index = index.cast %byte_offset : offset to index
  %index_from_i32 = index.cast %i32 : i32 to index
  %i32_from_index = index.cast %coordinate : index to i32
  func.return %flag_index, %flag_offset, %index_low_bit, %offset_low_bit, %from_index, %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64, %to_index, %index_from_i32, %i32_from_index : index, offset, i1, i1, offset, offset, offset, offset, offset, i8, i16, i32, i64, index, index, i32
}

