         %23 = OpConvertUToPtr %_ptr_PhysicalStorageBuffer_int %21
   %exchange = OpAtomicExchange %int %23 %uint_4 %uint_0 %value
         %29 = OpAtomicIAdd %int %23 %uint_1 %uint_0 %value
         %32 = OpAtomicISub %int %23 %uint_3 %uint_66 %value
