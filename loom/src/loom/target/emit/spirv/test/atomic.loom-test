// The integer-CAS fallback extends complete float semantics to f64 when the
// target has 64-bit storage atomics but lacks native float atomics.
spirv.target<vulkan1_3> @f64_fallback_target {contract_feature_bits = 2147647510}

func.def target(@f64_fallback_target) @f64_atomic_fallbacks(%buffer: buffer) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %value = scalar.constant 1.0 : f64
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 8} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<1xf64>
  %exchange = view.atomic.rmw<xchgf> %value, %view[%index] {ordering = relaxed, scope = thread} : f64, view<1xf64> -> f64
  %add = view.atomic.rmw<addf> %value, %view[%index] {ordering = acquire, scope = subgroup} : f64, view<1xf64> -> f64
  view.atomic.reduce<minimumf> %value, %view[%index] {ordering = release, scope = workgroup} : f64, view<1xf64>
  %maximum = view.atomic.rmw<maximumf> %value, %view[%index] {ordering = acq_rel, scope = workgroup} : f64, view<1xf64> -> f64
  %minnum = view.atomic.rmw<minnumf> %value, %view[%index] {ordering = relaxed, scope = workgroup} : f64, view<1xf64> -> f64
  %maxnum = view.atomic.rmw<maxnumf> %value, %view[%index] {ordering = acquire, scope = workgroup} : f64, view<1xf64> -> f64
  %prior = view.atomic.cmpxchg %exchange, %value, %view[%index] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : f64, view<1xf64> -> f64
  func.return
}

