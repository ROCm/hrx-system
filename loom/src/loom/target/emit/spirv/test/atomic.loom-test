// ====

// Integer atomics use a same-width Workgroup carrier, including the optional
// i64 path guarded by shaderSharedInt64Atomics.
spirv.target<vulkan1_3> @workgroup_i64_target {contract_feature_bits = 2147778566}
func.def target(@workgroup_i64_target) @workgroup_i64_atomics(%value: i64) {
  %byte_length = index.constant 8 : offset
  %base = index.constant 0 : offset
  %scratch = buffer.alloca<workgroup> align(8) %byte_length : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<1xi64>
  %old = view.atomic.rmw<addi> %value, %view[0] {ordering = acquire, scope = workgroup} : i64, view<1xi64> -> i64
  %prior = view.atomic.cmpxchg %old, %value, %view[0] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : i64, view<1xi64> -> i64
  func.return
}

