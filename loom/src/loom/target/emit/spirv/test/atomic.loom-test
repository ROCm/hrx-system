// ====

// One exact operation forces every alias of a Workgroup allocation onto the
// integer carrier, even when native floating-point atomics are available.
spirv.target<vulkan1_3> @workgroup_mixed_alias_target {contract_feature_bits = 2231402502}

func.def target(@workgroup_mixed_alias_target) @workgroup_mixed_alias_atomics(%value: f32) {
  %byte_length = index.constant 4 : offset
  %base = index.constant 0 : offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %native_view = buffer.view %scratch[%base] : buffer -> view<1xf32>
  %exact_view = buffer.view %scratch[%base] : buffer -> view<1xf32>
  view.store %value, %native_view[0] : f32, view<1xf32>
  %exchange = view.atomic.rmw<xchgf> %value, %native_view[0] {ordering = relaxed, scope = workgroup} : f32, view<1xf32> -> f32
  %add = view.atomic.rmw<addf> %exchange, %native_view[0] {ordering = acquire, scope = workgroup} : f32, view<1xf32> -> f32
  %minimum = view.atomic.rmw<minimumf> %add, %exact_view[0] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  func.return
}

