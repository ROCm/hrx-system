// RUN: emit spirv-dis input=source-low validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target {contract_feature_bits = 2147975174}

func.def target(@target) @integer_atomic_probe(%value: i32, %buffer: buffer) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<1xi32>
  %exchange = view.atomic.rmw<xchgi> %value, %view[%index] {ordering = relaxed, scope = thread} : i32, view<1xi32> -> i32
  view.atomic.reduce<addi> %value, %view[%index] {ordering = relaxed, scope = device} : i32, view<1xi32>
  view.atomic.reduce<subi> %value, %view[%index] {ordering = acquire, scope = subgroup} : i32, view<1xi32>
  view.atomic.reduce<andi> %value, %view[%index] {ordering = release, scope = workgroup} : i32, view<1xi32>
  view.atomic.reduce<ori> %value, %view[%index] {ordering = acq_rel, scope = device} : i32, view<1xi32>
  view.atomic.reduce<xori> %value, %view[%index] {ordering = relaxed, scope = thread} : i32, view<1xi32>
  view.atomic.reduce<minsi> %value, %view[%index] {ordering = acquire, scope = subgroup} : i32, view<1xi32>
  view.atomic.reduce<maxsi> %value, %view[%index] {ordering = release, scope = workgroup} : i32, view<1xi32>
  view.atomic.reduce<minui> %value, %view[%index] {ordering = acq_rel, scope = device} : i32, view<1xi32>
  %old = view.atomic.rmw<maxui> %value, %view[%index] {ordering = acquire, scope = subgroup} : i32, view<1xi32> -> i32
  %prior = view.atomic.cmpxchg %old, %value, %view[%index] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  func.return
}

