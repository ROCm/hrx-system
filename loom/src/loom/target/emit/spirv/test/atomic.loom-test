// ====

// Workgroup-memory CAS uses the same exact float combine while preserving the
// Workgroup storage class and memory-semantics bit.
spirv.target<vulkan1_3> @workgroup_float_target {contract_feature_bits = 2147516422}

func.def target(@workgroup_float_target) @workgroup_float_fallback(%value: f32) {
  %byte_length = index.constant 4 : offset
  %base = index.constant 0 : offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<1xf32>
  view.store %value, %view[0] : f32, view<1xf32>
  %loaded = view.load %view[0] : view<1xf32> -> f32
  %old = view.atomic.rmw<minimumf> %loaded, %view[0] {ordering = acquire, scope = workgroup} : f32, view<1xf32> -> f32
  %prior = view.atomic.cmpxchg %old, %value, %view[0] {failure_ordering = relaxed, scope = workgroup, success_ordering = release} : f32, view<1xf32> -> f32
  func.return
}

