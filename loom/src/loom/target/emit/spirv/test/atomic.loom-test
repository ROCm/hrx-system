// ====

// Vector atomics reach the same scalar contracts after the standard
// vector-to-scalar memory lowering.
spirv.target<vulkan1_3> @vector_atomic_target {contract_feature_bits = 2147516422}
func.def target(@vector_atomic_target) @vector_atomic_forms(%value: i32, %expected: i32, %replacement: i32, %buffer: buffer) {
  %base = index.constant 0 : offset
  %layout = encoding.layout.dense : encoding<layout>
  %offsets = vector.constant 0 : vector<2xindex>
  %values = vector.splat %value : vector<2xi32>
  %expected_values = vector.splat %expected : vector<2xi32>
  %replacement_values = vector.splat %replacement : vector<2xi32>
  %mask = vector.constant true : vector<2xi1>
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<8xi32, %layout>
  vector.atomic.reduce<addi> %values, %view[0][%offsets] {ordering = relaxed, scope = workgroup} : vector<2xi32>, view<8xi32, %layout>, vector<2xindex>
  vector.atomic.reduce.mask<ori> %values, %view[0][%offsets], %mask {ordering = release, scope = workgroup} : vector<2xi32>, view<8xi32, %layout>, vector<2xindex>, vector<2xi1>
  %old = vector.atomic.rmw<xchgi> %values, %view[0][%offsets] {ordering = acquire, scope = workgroup} : vector<2xi32>, view<8xi32, %layout>, vector<2xindex>
  %masked_old = vector.atomic.rmw.mask<xori> %values, %view[0][%offsets], %mask, %old {ordering = acq_rel, scope = workgroup} : vector<2xi32>, view<8xi32, %layout>, vector<2xindex>, vector<2xi1>, vector<2xi32>
  %prior = vector.atomic.cmpxchg %expected_values, %replacement_values, %view[0][%offsets] {success_ordering = acq_rel, failure_ordering = acquire, scope = workgroup} : vector<2xi32>, view<8xi32, %layout>, vector<2xindex> -> vector<2xi32>
  func.return
}

