// ====

// A pure floating-point Workgroup allocation retains its floating-point
// carrier when every atomic operation has a native instruction.
spirv.target<vulkan1_3> @workgroup_native_float_target {contract_feature_bits = 2231402502}
func.def target(@workgroup_native_float_target) @workgroup_native_float_atomics(%value: f32) {
  %byte_length = index.constant 4 : offset
  %base = index.constant 0 : offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<1xf32>
  %exchange = view.atomic.rmw<xchgf> %value, %view[0] {ordering = relaxed, scope = workgroup} : f32, view<1xf32> -> f32
  %add = view.atomic.rmw<addf> %value, %view[0] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  func.return
}

