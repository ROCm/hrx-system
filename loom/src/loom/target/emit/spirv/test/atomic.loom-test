// ====

// Exchange and add select native float atomics for every Vulkan-supported
// width when the corresponding storage-buffer features are available.
spirv.target<vulkan1_3> @native_float_target {contract_feature_bits = 2863169886}
func.def target(@native_float_target) @native_float_atomics(%buffer: buffer) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %value16 = scalar.constant 1.0 : f16
  %value32 = scalar.constant 2.0 : f32
  %value64 = scalar.constant 3.0 : f64
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 8} : buffer
  %view16 = buffer.view %aligned[%base] : buffer -> view<1xf16>
  %view32 = buffer.view %aligned[%base] : buffer -> view<1xf32>
  %view64 = buffer.view %aligned[%base] : buffer -> view<1xf64>
  %exchange16 = view.atomic.rmw<xchgf> %value16, %view16[%index] {ordering = relaxed, scope = workgroup} : f16, view<1xf16> -> f16
  view.atomic.reduce<addf> %value16, %view16[%index] {ordering = release, scope = workgroup} : f16, view<1xf16>
  %add16 = view.atomic.rmw<addf> %value16, %view16[%index] {ordering = acquire, scope = workgroup} : f16, view<1xf16> -> f16
  %exchange32 = view.atomic.rmw<xchgf> %value32, %view32[%index] {ordering = relaxed, scope = workgroup} : f32, view<1xf32> -> f32
  %add32 = view.atomic.rmw<addf> %value32, %view32[%index] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  %exchange64 = view.atomic.rmw<xchgf> %value64, %view64[%index] {ordering = relaxed, scope = workgroup} : f64, view<1xf64> -> f64
  %add64 = view.atomic.rmw<addf> %value64, %view64[%index] {ordering = acq_rel, scope = workgroup} : f64, view<1xf64> -> f64
  func.return
}

