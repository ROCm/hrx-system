// ====

// Native floating-point atomic instructions are optional. Integer CAS gives
// f32 targets complete exchange, add, min/max, and compare-exchange semantics.
spirv.target<vulkan1_3> @f32_fallback_target {contract_feature_bits = 2147516422}

func.def target(@f32_fallback_target) @f32_atomic_fallbacks(%value: f32, %buffer: buffer) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<1xf32>
  view.atomic.reduce<addf> %value, %view[%index] {ordering = relaxed, scope = workgroup} : f32, view<1xf32>
  %exchange = view.atomic.rmw<xchgf> %value, %view[%index] {ordering = relaxed, scope = thread} : f32, view<1xf32> -> f32
  %add = view.atomic.rmw<addf> %value, %view[%index] {ordering = acquire, scope = subgroup} : f32, view<1xf32> -> f32
  %minimum = view.atomic.rmw<minimumf> %value, %view[%index] {ordering = release, scope = workgroup} : f32, view<1xf32> -> f32
  %maximum = view.atomic.rmw<maximumf> %value, %view[%index] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  %minnum = view.atomic.rmw<minnumf> %value, %view[%index] {ordering = relaxed, scope = workgroup} : f32, view<1xf32> -> f32
  %maxnum = view.atomic.rmw<maxnumf> %value, %view[%index] {ordering = acquire, scope = workgroup} : f32, view<1xf32> -> f32
  %prior = view.atomic.cmpxchg %exchange, %value, %view[%index] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : f32, view<1xf32> -> f32
  func.return
}

