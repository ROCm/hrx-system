// RUN: emit spirv-dis @select_f64 input=source-low target=spirv:vulkan1.3+bda+extended-types validate
// REQUIRES: spirv-dis, spirv-val

// Scalar and independent lane conditions preserve the selected payload bits.
func.def @select_f64(%condition: i1, %other_condition: i1, %a: f64, %b: f64, %output: buffer) -> (f64) {
  %selected_scalar = scf.select %condition, %a, %b : f64
  %left = vector.from_elements %a, %b : vector<2xf64>
  %right = vector.from_elements %b, %a : vector<2xf64>
  %mask = vector.from_elements %condition, %other_condition : vector<2xi1>
  %selected_vector = vector.select %mask, %left, %right : vector<2xf64>
  %origin = index.constant 0 : offset
  %result = buffer.view %output[%origin] : buffer -> view<2xf64>
  vector.store %selected_vector, %result[0] : vector<2xf64>, view<2xf64>
  func.return %selected_scalar : f64
}

