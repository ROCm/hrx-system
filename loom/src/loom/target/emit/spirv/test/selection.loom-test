// RUN: emit spirv-dis @select_f16 input=source-low target=spirv:vulkan1.3+bda+extended-types validate
// REQUIRES: spirv-dis, spirv-val

// Scalar and independent lane conditions preserve the selected payload bits.
func.def @select_f16(%condition: i1, %other_condition: i1, %a: f16, %b: f16, %output: buffer) -> (f16) {
  %selected_scalar = scf.select %condition, %a, %b : f16
  %left = vector.from_elements %a, %b, %a : vector<3xf16>
  %right = vector.from_elements %b, %a, %b : vector<3xf16>
  %mask = vector.from_elements %condition, %other_condition, %condition : vector<3xi1>
  %selected_vector = vector.select %mask, %left, %right : vector<3xf16>
  %origin = index.constant 0 : offset
  %result = buffer.view %output[%origin] : buffer -> view<3xf16>
  vector.store %selected_vector, %result[0] : vector<3xf16>, view<3xf16>
  func.return %selected_scalar : f16
}

