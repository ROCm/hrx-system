// RUN: emit spirv-dis @select_bf16 input=source-low target=spirv:vulkan1.3+bda+extended-types validate
// REQUIRES: spirv-dis, spirv-val

// Scalar and independent lane conditions preserve the selected payload bits.
func.def @select_bf16(%condition: i1, %other_condition: i1, %a: bf16, %b: bf16, %output: buffer) -> (bf16) {
  %selected_scalar = scf.select %condition, %a, %b : bf16
  %left = vector.from_elements %a, %b, %a : vector<3xbf16>
  %right = vector.from_elements %b, %a, %b : vector<3xbf16>
  %mask = vector.from_elements %condition, %other_condition, %condition : vector<3xi1>
  %selected_vector = vector.select %mask, %left, %right : vector<3xbf16>
  %origin = index.constant 0 : offset
  %result = buffer.view %output[%origin] : buffer -> view<3xbf16>
  vector.store %selected_vector, %result[0] : vector<3xbf16>, view<3xbf16>
  func.return %selected_scalar : bf16
}

