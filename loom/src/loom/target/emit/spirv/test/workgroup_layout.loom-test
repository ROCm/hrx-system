// RUN: emit spirv-dis target=spirv:vulkan1.3+bda features=WORKGROUP_MEMORY_EXPLICIT_LAYOUT_KHR,FLOAT16 validate
// REQUIRES: spirv-dis, spirv-val

// Optional explicit layout does not narrow ordinary 16-bit Workgroup storage
// when the device has base support but lacks its independent 16-bit feature.
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @implicit_half() asm {
  %half_storage = storage {byte_alignment = 2, byte_length = 6} : low.storage<workgroup>
  %int_storage = storage {byte_alignment = 4, byte_length = 12} : low.storage<workgroup>
  %halves = storage_address %half_storage : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.f16>
  %ints = storage_address %int_storage : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  return
}

// ----
               OpCapability Shader
               OpCapability VulkanMemoryModel
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpCapability Float16
               OpExtension "SPV_KHR_vulkan_memory_model"
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpMemoryModel PhysicalStorageBuffer64 Vulkan
               OpEntryPoint GLCompute %implicit_half "implicit_half"
               OpExecutionMode %implicit_half LocalSize 1 1 1
               OpName %implicit_half "implicit_half"
               OpName %halves "halves"
               OpName %ints "ints"
       %void = OpTypeVoid
          %3 = OpTypeFunction %void
       %half = OpTypeFloat 16
       %uint = OpTypeInt 32 0
     %uint_3 = OpConstant %uint 3
%_arr_half_uint_3 = OpTypeArray %half %uint_3
%_ptr_Workgroup__arr_half_uint_3 = OpTypePointer Workgroup %_arr_half_uint_3
        %int = OpTypeInt 32 1
%_arr_int_uint_3 = OpTypeArray %int %uint_3
%_ptr_Workgroup__arr_int_uint_3 = OpTypePointer Workgroup %_arr_int_uint_3
     %halves = OpVariable %_ptr_Workgroup__arr_half_uint_3 Workgroup
       %ints = OpVariable %_ptr_Workgroup__arr_int_uint_3 Workgroup
%implicit_half = OpFunction %void None %3
          %4 = OpLabel
               OpReturn
               OpFunctionEnd

