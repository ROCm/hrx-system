               OpMemberDecorate %_struct_35 4 Offset 28
               OpDecorate %_arr_long_uint_3 ArrayStride 8
               OpMemberDecorate %_struct_35 5 Offset 40
               OpDecorate %_arr_double_uint_3 ArrayStride 8
               OpMemberDecorate %_struct_35 6 Offset 64
               OpDecorate %_struct_35 Block
       %void = OpTypeVoid
          %3 = OpTypeFunction %void
       %char = OpTypeInt 8 1
       %uint = OpTypeInt 32 0
     %uint_3 = OpConstant %uint 3
%_arr_char_uint_3 = OpTypeArray %char %uint_3
%_ptr_Workgroup__arr_char_uint_3 = OpTypePointer Workgroup %_arr_char_uint_3
      %short = OpTypeInt 16 1
%_arr_short_uint_3 = OpTypeArray %short %uint_3
%_ptr_Workgroup__arr_short_uint_3 = OpTypePointer Workgroup %_arr_short_uint_3
       %half = OpTypeFloat 16
%_arr_half_uint_3 = OpTypeArray %half %uint_3
%_ptr_Workgroup__arr_half_uint_3 = OpTypePointer Workgroup %_arr_half_uint_3
        %int = OpTypeInt 32 1
%_arr_int_uint_3 = OpTypeArray %int %uint_3
%_ptr_Workgroup__arr_int_uint_3 = OpTypePointer Workgroup %_arr_int_uint_3
      %float = OpTypeFloat 32
%_arr_float_uint_3 = OpTypeArray %float %uint_3
%_ptr_Workgroup__arr_float_uint_3 = OpTypePointer Workgroup %_arr_float_uint_3
       %long = OpTypeInt 64 1
%_arr_long_uint_3 = OpTypeArray %long %uint_3
%_ptr_Workgroup__arr_long_uint_3 = OpTypePointer Workgroup %_arr_long_uint_3
     %double = OpTypeFloat 64
%_arr_double_uint_3 = OpTypeArray %double %uint_3
%_ptr_Workgroup__arr_double_uint_3 = OpTypePointer Workgroup %_arr_double_uint_3
 %_struct_35 = OpTypeStruct %_arr_char_uint_3 %_arr_short_uint_3 %_arr_half_uint_3 %_arr_int_uint_3 %_arr_float_uint_3 %_arr_long_uint_3 %_arr_double_uint_3
%_ptr_Workgroup__struct_35 = OpTypePointer Workgroup %_struct_35
         %37 = OpVariable %_ptr_Workgroup__struct_35 Workgroup
     %uint_0 = OpConstant %uint 0
     %uint_1 = OpConstant %uint 1
     %uint_2 = OpConstant %uint 2
     %uint_4 = OpConstant %uint 4
     %uint_5 = OpConstant %uint 5
     %uint_6 = OpConstant %uint 6
%element_widths = OpFunction %void None %3
          %4 = OpLabel
      %bytes = OpAccessChain %_ptr_Workgroup__arr_char_uint_3 %37 %uint_0
     %shorts = OpAccessChain %_ptr_Workgroup__arr_short_uint_3 %37 %uint_1
     %halves = OpAccessChain %_ptr_Workgroup__arr_half_uint_3 %37 %uint_2
       %ints = OpAccessChain %_ptr_Workgroup__arr_int_uint_3 %37 %uint_3
     %floats = OpAccessChain %_ptr_Workgroup__arr_float_uint_3 %37 %uint_4
      %longs = OpAccessChain %_ptr_Workgroup__arr_long_uint_3 %37 %uint_5
    %doubles = OpAccessChain %_ptr_Workgroup__arr_double_uint_3 %37 %uint_6
               OpReturn
               OpFunctionEnd

