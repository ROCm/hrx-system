// RUN: emit spirv-dis target=spirv:vulkan1.3+bda features=WORKGROUP_MEMORY_EXPLICIT_LAYOUT_KHR validate
// REQUIRES: spirv-dis, spirv-val

// Member offsets follow reservation order, including an unaddressed reservation,
// rather than first-use order. A first address in a branch must dominate its
// later reuse; private variables still precede every entry address instruction.
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @conditional_addresses(%value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %first = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %gap = storage {byte_alignment = 32, byte_length = 4} : low.storage<workgroup>
  %last = storage {byte_alignment = 16, byte_length = 4} : low.storage<workgroup>
  %private = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %zero = OpConstant.i32 0
  %positive = OpSGreaterThan %value, %zero
  low.scf.if %positive {
    %conditional = storage_address %last : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
    %ptr = OpAccessChain.workgroup.i32.element_index %conditional, %zero
    OpStore.workgroup.i32 %ptr, %value
  } else {
    %fallback = storage_address %last : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
    %fallback_ptr = OpAccessChain.workgroup.i32.element_index %fallback, %zero
    OpStore.workgroup.i32 %fallback_ptr, %zero
  }
  %reused = storage_address %last : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %first_base = storage_address %first : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %private_base = storage_address %private : low.storage<private> -> reg<spirv.ptr.function.array.i32>
  %loaded_ptr = OpAccessChain.workgroup.i32.element_index %reused, %zero
  %loaded = OpLoad.workgroup.i32 %loaded_ptr
  return %loaded
}

// An independent entry starts from byte zero even with identical member types.
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @independent_frame() asm {
  %storage = storage {byte_alignment = 16, byte_length = 4} : low.storage<workgroup>
  %base = storage_address %storage : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  return
}

// ----
               OpCapability Shader
               OpCapability VulkanMemoryModel
               OpCapability PhysicalStorageBufferAddresses
               OpCapability Int64
               OpCapability WorkgroupMemoryExplicitLayoutKHR
               OpExtension "SPV_KHR_vulkan_memory_model"
               OpExtension "SPV_KHR_physical_storage_buffer"
               OpExtension "SPV_KHR_workgroup_memory_explicit_layout"
               OpMemoryModel PhysicalStorageBuffer64 Vulkan
               OpEntryPoint GLCompute %conditional_addresses "conditional_addresses" %39 %4 %8
               OpEntryPoint GLCompute %independent_frame "independent_frame" %48
               OpExecutionMode %conditional_addresses LocalSize 1 1 1
               OpExecutionMode %independent_frame LocalSize 1 1 1
               OpName %conditional_addresses "conditional_addresses"
               OpName %value "value"
               OpName %zero "zero"
               OpName %positive "positive"
               OpName %conditional "conditional"
               OpName %ptr "ptr"
               OpName %conditional "fallback"
               OpName %fallback_ptr "fallback_ptr"
               OpName %conditional "reused"
               OpName %first_base "first_base"
               OpName %private_base "private_base"
               OpName %loaded_ptr "loaded_ptr"
               OpName %loaded "loaded"
               OpName %independent_frame "independent_frame"
               OpName %base "base"
               OpMemberDecorate %_struct_5 0 Offset 0
               OpDecorate %_struct_5 Block
               OpDecorate %4 DescriptorSet 0
               OpDecorate %4 Binding 0
               OpDecorate %8 DescriptorSet 0
               OpDecorate %8 Binding 1
               OpDecorate %_arr_int_uint_1 ArrayStride 4
               OpMemberDecorate %_struct_37 0 Offset 48
               OpDecorate %_arr_int_uint_1_0 ArrayStride 4
               OpMemberDecorate %_struct_37 1 Offset 0
               OpDecorate %_struct_37 Block
               OpDecorate %_arr_int_uint_1_2 ArrayStride 4
               OpMemberDecorate %_struct_46 0 Offset 0
               OpDecorate %_struct_46 Block
        %int = OpTypeInt 32 1
      %int_0 = OpConstant %int 0
  %_struct_5 = OpTypeStruct %int
%_ptr_StorageBuffer__struct_5 = OpTypePointer StorageBuffer %_struct_5
%_ptr_StorageBuffer_int = OpTypePointer StorageBuffer %int
          %4 = OpVariable %_ptr_StorageBuffer__struct_5 StorageBuffer
          %8 = OpVariable %_ptr_StorageBuffer__struct_5 StorageBuffer
       %void = OpTypeVoid
         %10 = OpTypeFunction %void
       %zero = OpConstant %int 0
       %bool = OpTypeBool
       %uint = OpTypeInt 32 0
     %uint_1 = OpConstant %uint 1
%_arr_int_uint_1 = OpTypeArray %int %uint_1
%_ptr_Workgroup__arr_int_uint_1 = OpTypePointer Workgroup %_arr_int_uint_1
%_ptr_Workgroup_int = OpTypePointer Workgroup %int
%_arr_int_uint_1_0 = OpTypeArray %int %uint_1
%_ptr_Workgroup__arr_int_uint_1_0 = OpTypePointer Workgroup %_arr_int_uint_1_0
%_arr_int_uint_1_1 = OpTypeArray %int %uint_1
%_ptr_Function__arr_int_uint_1_1 = OpTypePointer Function %_arr_int_uint_1_1
 %_struct_37 = OpTypeStruct %_arr_int_uint_1 %_arr_int_uint_1_0
%_ptr_Workgroup__struct_37 = OpTypePointer Workgroup %_struct_37
         %39 = OpVariable %_ptr_Workgroup__struct_37 Workgroup
     %uint_0 = OpConstant %uint 0
%_arr_int_uint_1_2 = OpTypeArray %int %uint_1
%_ptr_Workgroup__arr_int_uint_1_2 = OpTypePointer Workgroup %_arr_int_uint_1_2
 %_struct_46 = OpTypeStruct %_arr_int_uint_1_2
%_ptr_Workgroup__struct_46 = OpTypePointer Workgroup %_struct_46
         %48 = OpVariable %_ptr_Workgroup__struct_46 Workgroup
%conditional_addresses = OpFunction %void None %10
         %11 = OpLabel
%private_base = OpVariable %_ptr_Function__arr_int_uint_1_1 Function
%conditional = OpAccessChain %_ptr_Workgroup__arr_int_uint_1 %39 %uint_0
 %first_base = OpAccessChain %_ptr_Workgroup__arr_int_uint_1_0 %39 %uint_1
         %12 = OpAccessChain %_ptr_StorageBuffer_int %4 %int_0
      %value = OpLoad %int %12 Aligned 4
   %positive = OpSGreaterThan %bool %value %zero
               OpSelectionMerge %18 None
               OpBranchConditional %positive %17 %19
         %17 = OpLabel
        %ptr = OpAccessChain %_ptr_Workgroup_int %conditional %zero
               OpStore %ptr %value Aligned 4
               OpBranch %18
         %19 = OpLabel
%fallback_ptr = OpAccessChain %_ptr_Workgroup_int %conditional %zero
               OpStore %fallback_ptr %zero Aligned 4
               OpBranch %18
         %18 = OpLabel
 %loaded_ptr = OpAccessChain %_ptr_Workgroup_int %conditional %zero
     %loaded = OpLoad %int %loaded_ptr Aligned 4
         %36 = OpAccessChain %_ptr_StorageBuffer_int %8 %int_0
               OpStore %36 %loaded Aligned 4
               OpReturn
               OpFunctionEnd
%independent_frame = OpFunction %void None %10
         %42 = OpLabel
       %base = OpAccessChain %_ptr_Workgroup__arr_int_uint_1_2 %48 %uint_0
               OpReturn
               OpFunctionEnd

