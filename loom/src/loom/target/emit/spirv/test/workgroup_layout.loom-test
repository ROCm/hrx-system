// RUN: emit spirv-dis input=source-low target=spirv:vulkan1.3+bda features=WORKGROUP_MEMORY_EXPLICIT_LAYOUT_KHR validate
// REQUIRES: spirv-dis, spirv-val

// The ordinary pipeline brings helper-owned storage into the entry's frame.
func.def public @calling_entry(%input: i32) -> (i32) {
  %result = func.call @storage_helper(%input) : (i32) -> (i32)
  func.return %result : i32
}

func.def @storage_helper(%input: i32) -> (i32) {
  %size = index.constant 4 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<workgroup> align(16) %size : buffer
  %view = buffer.view %storage[%base] : buffer -> view<1xi32>
  view.store %input, %view[0] : i32, view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

