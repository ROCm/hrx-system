// RUN: emit spirv-dis validate
// REQUIRES: spirv-dis, spirv-val

spirv.target<vulkan1_3> @target

low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @spirv_i32_structured_counted_loop(%start: reg<spirv.id : i32>, %limit: reg<spirv.id : i32>, %step: reg<spirv.id : i32>, %seed: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %result = low.scf.for [%start to %limit step %step] iter_args(%seed: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) unroll do(%i: reg<spirv.id : i32>, %acc: reg<spirv.id : i32>) {
    %next_acc = OpIAdd %acc, %i
    low.scf.yield %next_acc : reg<spirv.id : i32>
  }
  return %result
}

