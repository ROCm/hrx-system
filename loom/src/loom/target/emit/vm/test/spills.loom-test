// RUN: emit vm-dis vm.value=17

vm.target<core> @target

func.def noinline target(@target) @wide_sink(%v0: i32, %v1: i32, %v2: i32, %v3: i32, %v4: i32, %v5: i32, %v6: i32, %v7: i32, %v8: i32, %v9: i32, %v10: i32, %v11: i32, %v12: i32, %v13: i32, %v14: i32, %v15: i32, %v16: i32) {
  func.return
}

func.def public target(@target) @call_with_spill(%keep: i32, %value: i32) -> (i32) {
  func.call @wide_sink(%value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value) : (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32)
  func.return %keep : i32
}

