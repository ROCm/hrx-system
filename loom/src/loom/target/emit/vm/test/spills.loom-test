// RUN: emit vm-dis input=low vm.ref=2 vm.function=2

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i1>, reg<vm.ref : hal.buffer>) -> (reg<vm.value : i1>)>}) @spill_ref_branch(%condition: reg<vm.value : i1>, %input: reg<vm.ref : hal.buffer>) -> (reg<vm.value : i1>) asm {
  %r0 = ref.retain %input : reg<vm.ref : hal.buffer>
  %r1 = ref.retain %input : reg<vm.ref : hal.buffer>
  %r2 = ref.retain %input : reg<vm.ref : hal.buffer>
  low.cond_br %condition, ^left, ^right : reg<vm.value : i1>
^left:
  %left_result = ref.compare.eq %r0, %r1 : reg<vm.value : i1>
  ref.discard %r0
  ref.discard %r1
  ref.discard %r2
  return %left_result
^right:
  %right_result = ref.compare.eq %r1, %r2 : reg<vm.value : i1>
  ref.discard %r0
  ref.discard %r1
  ref.discard %r2
  return %right_result
}

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i1>, reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.value : i1>)>}) @spill_function_branch(%condition: reg<vm.value : i1>, %input: reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.value : i1>) asm {
  %f0 = func.copy %input : reg<vm.function : func.ref<(i32) -> (i32)>>
  %f1 = func.copy %input : reg<vm.function : func.ref<(i32) -> (i32)>>
  %f2 = func.copy %input : reg<vm.function : func.ref<(i32) -> (i32)>>
  low.cond_br %condition, ^left, ^right : reg<vm.value : i1>
^left:
  %left_result = func.compare.null %f0 : reg<vm.value : i1>
  return %left_result
^right:
  %middle_result = func.compare.null %f1 : reg<vm.value : i1>
  low.cond_br %middle_result, ^return_middle, ^compare_last : reg<vm.value : i1>
^return_middle:
  return %middle_result
^compare_last:
  %last_result = func.compare.null %f2 : reg<vm.value : i1>
  return %last_result
}

