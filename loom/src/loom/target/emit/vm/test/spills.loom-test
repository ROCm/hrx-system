// RUN: emit vm-dis input=low vm.value=2

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)>}) @spill_value_branch(%row: reg<vm.value : i32>, %carry: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  low.br ^late
^join(%state: reg<vm.value : i32>):
  %sum = integer.add.i32 %row, %carry : reg<vm.value : i32>
  %out = integer.add.i32 %sum, %state : reg<vm.value : i32>
  return %out
^late:
  %late_state = constant.s16 7 : reg<vm.value : i32>
  low.br ^join(%late_state: reg<vm.value : i32>)
}

