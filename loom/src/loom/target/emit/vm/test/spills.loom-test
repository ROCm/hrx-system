// RUN: emit vm-dis input=low vm.value=4

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)>}) @spill_value_loop(%seed: reg<vm.value : i32>, %iterations: reg<vm.value : i32>, %addend: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %zero = constant.zero : reg<vm.value : i32>
  %one = constant.s16 1 : reg<vm.value : i32>
  low.br ^loop(%seed: reg<vm.value : i32>, %iterations: reg<vm.value : i32>)
^loop(%state: reg<vm.value : i32>, %remaining: reg<vm.value : i32>):
  %done = integer.compare.i32 %remaining, %zero, eq : reg<vm.value : i1>
  low.cond_br %done, ^exit, ^body : reg<vm.value : i1>
^body:
  %twice = integer.add.i32 %state, %addend : reg<vm.value : i32>
  %next = integer.add.i32 %twice, %state : reg<vm.value : i32>
  %rest = integer.sub.i32 %remaining, %one : reg<vm.value : i32>
  low.br ^loop(%next: reg<vm.value : i32>, %rest: reg<vm.value : i32>)
^exit:
  return %state
}

