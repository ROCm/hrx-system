// RUN: emit vm-dis input=low

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<() -> (reg<vm.value : i64>)>}) @read_constant() -> (reg<vm.value : i64>) asm {
  %value = constant.pool.load.i64 0 : reg<vm.value : i64>
  return %value
}

