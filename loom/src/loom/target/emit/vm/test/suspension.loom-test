// RUN: emit vm-dis

vm.target<core> @target

func.decl import("runtime", "wait") target(@target) abi(vm_function, {suspending = true}) @wait()

func.def noinline target(@target) @recursive_a() {
  func.call @recursive_b() : ()
  func.return
}

func.def noinline target(@target) @recursive_b() {
  func.call @recursive_a() : ()
  func.call @wait() : ()
  func.return
}

func.def public target(@target) @recursive_root() {
  func.call @recursive_a() : ()
  func.return
}

