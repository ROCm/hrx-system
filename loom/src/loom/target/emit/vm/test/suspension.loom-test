// RUN: emit vm-dis input=low

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>) -> (reg<vm.value : i32>)>}) @yield_once(%value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  control.yield.s32 ^resume(%value)
^resume(%result: reg<vm.value : i32>):
  return %result
}

