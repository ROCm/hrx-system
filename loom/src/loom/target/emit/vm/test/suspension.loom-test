// RUN: emit vm-dis

vm.target<core> @target

func.decl import("runtime", "wait") target(@target) abi(vm_function, {suspending = true}) @wait()
func.decl import("runtime", "immediate") target(@target) abi(vm_function, {suspending = false}) @immediate()

func.def noinline target(@target) @yield_leaf() {
  func.call @wait() : ()
  func.return
}

func.def noinline target(@target) @yield_middle() {
  func.call @yield_leaf() : ()
  func.return
}

func.def public target(@target) @yield_root() {
  func.call @yield_middle() : ()
  func.return
}

func.def public target(@target) @sync_root() {
  func.call @immediate() : ()
  func.return
}

