// ====

// RUN: emit vm-dis

vm.target<core> @target

func.decl import("runtime", "identity") import_metadata({"declaration.name" = "first"}) target(@target) @first(%value: i32) -> (i32)
func.decl import("runtime", "identity") import_metadata({"declaration.name" = "second"}) target(@target) @second(%value: i32) -> (i32)

func.def public target(@target) @call_both(%value: i32) -> (i32) {
  %first_result = func.call @first(%value) : (i32) -> (i32)
  %second_result = func.call @second(%first_result) : (i32) -> (i32)
  func.return %second_result : i32
}

