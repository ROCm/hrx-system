// RUN: emit vm-dis

vm.target<core> @target

metadata.module "model.summary" = "typed metadata"
metadata.module "model.revision" = u64(18446744073709551615)
metadata.module "model.payload" = bytes("00feff")
metadata.module "model.empty_text" = ""
metadata.module "model.ratio" = 1.5
metadata.module "model.offset" = -7
metadata.module "model.empty_bytes" = bytes("")
metadata.module "model.enabled" = true

func.decl import("runtime", "callback") import_metadata({"runtime.optional" = true, "runtime.revision" = u64(3)}) target(@target) @callback(%value: i32) -> (i32)

func.def public target(@target) export_metadata({"help.summary" = "Identity", "wire.payload" = bytes("01fe")}) @identity(%value: i32) -> (i32) {
  func.return %value : i32
}

