// RUN: emit vm-dis

vm.target<core> @target

func.decl optional import("runtime", "callback") target(@target) @callback(%value: i32) -> (i32)

func.def noinline target(@target) @identity(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def public target(@target) @function_values(%value: i32) -> (i32) {
  %local = func.address @identity : func.ref<(i32) -> (i32)>
  %yieldable = func.ref.cast %local : func.ref<(i32) -> (i32)> to func.ref<yieldable (i32) -> (i32)>
  %yieldable_is_null = func.compare.null %yieldable : func.ref<yieldable (i32) -> (i32)>
  %called = func.call.indirect %local(%value) : (i32) -> (i32)
  %optional = func.address @callback : func.ref<(i32) -> (i32)>
  %optional_is_null = func.compare.null %optional : func.ref<(i32) -> (i32)>
  %available = func.import.resolved @callback
  %null = func.null : func.ref<(i32) -> (i32)>
  %null_is_null = func.compare.null %null : func.ref<(i32) -> (i32)>
  cfg.cond_br %yieldable_is_null, ^return_value, ^check_optional
^check_optional:
  cfg.cond_br %optional_is_null, ^check_available, ^return_called
^check_available:
  cfg.cond_br %available, ^check_null, ^return_value
^check_null:
  cfg.cond_br %null_is_null, ^return_called, ^return_value
^return_called:
  func.return %called : i32
^return_value:
  func.return %value : i32
}

