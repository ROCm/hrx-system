// RUN: emit vm-dis

vm.target<core> @target

func.decl optional import("runtime", "feature") target(@target) @optional_feature(%value: i32) -> (i32)
func.decl import("runtime", "feature") target(@target) @required_feature(%value: i32) -> (i32)

func.def public target(@target) @query_required_alias() -> (i1) {
  %available = func.import.resolved @optional_feature
  func.return %available : i1
}

