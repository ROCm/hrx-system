// RUN: emit vm-dis

vm.target<core> @target

func.decl import("zeta", "compute") target(@target) @compute_zeta(%value: i32) -> (i32)
func.decl optional import("alpha", "try_compute") target(@target) @try_compute(%value: i32) -> (i32)
func.decl import("alpha", "compute") target(@target) @compute_alpha(%value: i32) -> (i32)

func.def public target(@target) @call_imports(%value: i32) -> (i32) {
  %alpha = func.call @compute_alpha(%value) : (i32) -> (i32)
  %optional = func.call @try_compute(%alpha) : (i32) -> (i32)
  %result = func.call @compute_zeta(%optional) : (i32) -> (i32)
  func.return %result : i32
}

