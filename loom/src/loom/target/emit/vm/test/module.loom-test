// RUN: emit vm-dis input=low

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @variable_register_range() asm {
  %lane0 = constant.zero : reg<vm.value>
  %lane1 = constant.s16 1 : reg<vm.value>
  %source = concat(%lane0, %lane1) : (reg<vm.value>, reg<vm.value>) -> reg<vm.value x2>
  %packed = integer.bitstream.pack %source, 8, 2, 1, 16, 16 : reg<vm.value>
  return
}

