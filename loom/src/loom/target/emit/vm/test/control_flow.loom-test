// RUN: emit vm-dis input=low

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @diamond(%condition: reg<vm.value : i1>, %true_value: reg<vm.value : i32>, %false_value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  low.cond_br %condition, ^then, ^else : reg<vm.value : i1>
^join(%result: reg<vm.value : i32>):
  return %result
^then:
  low.br ^join(%true_value: reg<vm.value : i32>)
^else:
  low.br ^join(%false_value: reg<vm.value : i32>)
}

