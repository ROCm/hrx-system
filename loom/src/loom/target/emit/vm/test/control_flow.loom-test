// RUN: emit vm-dis input=low

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @loop_arg_cycle(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) asm {
  low.br ^loop(%rhs: reg<vm.value : i32>, %lhs: reg<vm.value : i32>)
^loop(%a: reg<vm.value : i32>, %b: reg<vm.value : i32>):
  low.br ^loop(%b: reg<vm.value : i32>, %a: reg<vm.value : i32>)
}

