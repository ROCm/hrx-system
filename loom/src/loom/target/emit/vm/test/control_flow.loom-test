// RUN: emit vm-dis

vm.target<core> @target

func.def public target(@target) @conditional_return(%condition: i1, %true_value: i32, %false_value: i32) -> (i32) {
  cfg.cond_br %condition, ^then, ^else
^then:
  func.return %true_value : i32
^else:
  func.return %false_value : i32
}

