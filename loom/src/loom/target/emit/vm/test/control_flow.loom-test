// RUN: emit vm-dis

vm.target<core> @target

func.def public target(@target) @switch_with_hole(%selector: index, %case0: i32, %case1: i32, %case3: i32, %fallback: i32) -> (i32) {
  cfg.switch %selector cases [0, 1, 3] -> [^case0, ^case1, ^case3] default ^default
^case0:
  func.return %case0 : i32
^case1:
  func.return %case1 : i32
^case3:
  func.return %case3 : i32
^default:
  func.return %fallback : i32
}

func.def public target(@target) @switch_negative(%selector: index, %negative2: i32, %negative1: i32, %zero: i32, %fallback: i32) -> (i32) {
  cfg.switch %selector cases [-2, -1, 0] -> [^negative2, ^negative1, ^zero] default ^default
^negative2:
  func.return %negative2 : i32
^negative1:
  func.return %negative1 : i32
^zero:
  func.return %zero : i32
^default:
  func.return %fallback : i32
}

