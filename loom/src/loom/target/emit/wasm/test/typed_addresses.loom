wasm.target<simd128> @target

func.def public target(@target) @exchange_wide_origin(%buffer: buffer, %base_input: i64, %position_input: index, %value: i32) -> (i32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %wide_base = scalar.assume %base_input [range(%base_input, 0, 128), mul(%base_input, 8)] : i64
  %base = index.cast %wide_base : i64 to offset
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  func.return %previous : i32
}

func.def public target(@target) @exchange_prefix_before_cast(%buffer: buffer, %base_input: i64, %position_input: index, %value: i32) -> (i32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %wide_base = scalar.assume %base_input [range(%base_input, 0, 128), mul(%base_input, 8)] : i64
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = scalar.constant 16 : i64
  %wide_origin = scalar.addi %wide_base, %prefix : i64
  %origin = index.cast %wide_origin : i64 to offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  func.return %previous : i32
}

func.def public target(@target) @exchange_cancelled_high_bits(%buffer: buffer, %left_input: i64, %right_input: i64, %position_input: index, %value: i32) -> (i32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %left = scalar.assume %left_input [range(%left_input, 4294967296, 4294967304), mul(%left_input, 8)] : i64
  %right = scalar.assume %right_input [range(%right_input, 4294967288, 4294967296), mul(%right_input, 8)] : i64
  %wide_base = scalar.subi %left, %right : i64
  %base = index.cast %wide_base : i64 to offset
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  func.return %previous : i32
}

func.def public target(@target) @exchange_wide_signed_coordinate(%buffer: buffer, %base_input: offset, %position_input: i64, %value: i32) -> (i32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %base = index.assume %base_input [range(%base_input, 64, 128), mul(%base_input, 8)] : offset
  %signed_position = scalar.assume %position_input [range(%position_input, -8, -1)] : i64
  %coordinate = index.cast %signed_position : i64 to index
  %bias = index.constant 8 : index
  %position = index.add %coordinate, %bias : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  func.return %previous : i32
}

func.def public target(@target) @exchange_wide_stride(%buffer: buffer, %columns_input: i64, %row_input: index, %column_input: index, %value: i32) -> (i32) {
  %aligned = buffer.assume.alignment %buffer {minimum_alignment = 4} : buffer
  %wide_columns = scalar.assume %columns_input [range(%columns_input, 4, 16)] : i64
  %columns = index.cast %wide_columns : i64 to index
  %row = index.assume %row_input [range(%row_input, 0, 3)] : index
  %column = index.assume %column_input [range(%column_input, 0, 3)] : index
  %base = index.constant 24 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<4x[%columns]xi32>
  %previous = view.load %view[%row, %column] : view<4x[%columns]xi32> -> i32
  view.store %value, %view[%row, %column] : i32, view<4x[%columns]xi32>
  func.return %previous : i32
}

func.def public target(@target) @narrow_index(%input: i64) -> (i32) {
  %bounded = scalar.assume %input [range(%input, -2147483648, 2147483647)] : i64
  %position = index.cast %bounded : i64 to index
  %bits = index.cast %position : index to i32
  func.return %bits : i32
}

func.def public target(@target) @narrow_offset(%input: i64) -> (i32) {
  %bounded = scalar.assume %input [range(%input, 0, 4294967295)] : i64
  %offset = index.cast %bounded : i64 to offset
  %bits = index.cast %offset : offset to i32
  func.return %bits : i32
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @read_byte(%address: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %value = i32.load8_u %address
  return %value
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @write_byte(%address: reg<wasm.i32>, %value: reg<wasm.i32>) asm {
  i32.store8 %address, %value
  return
}
