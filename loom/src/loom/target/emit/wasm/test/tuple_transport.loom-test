// RUN: emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

// Parameters of the same register class have nonconsecutive ABI locals. Each
// conditional result carries both units, including the second i64/f32/f64 unit.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @mixed_classes(%condition: reg<wasm.i32>, %a: reg<wasm.i64>, %b: reg<wasm.f32>, %c: reg<wasm.f64>, %d: reg<wasm.i64>, %e: reg<wasm.f32>, %f: reg<wasm.f64>) -> (reg<wasm.i64>, reg<wasm.i64>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f64>, reg<wasm.f64>) asm {
  %integers, %singles, %doubles = low.scf.if %condition -> (reg<wasm.i64 x2>, reg<wasm.f32 x2>, reg<wasm.f64 x2>) {
    %ip = concat(%a, %d) : (reg<wasm.i64>, reg<wasm.i64>) -> reg<wasm.i64 x2>
    %sp = concat(%b, %e) : (reg<wasm.f32>, reg<wasm.f32>) -> reg<wasm.f32 x2>
    %dp = concat(%c, %f) : (reg<wasm.f64>, reg<wasm.f64>) -> reg<wasm.f64 x2>
    low.scf.yield %ip, %sp, %dp : reg<wasm.i64 x2>, reg<wasm.f32 x2>, reg<wasm.f64 x2>
  } else {
    %ip = concat(%d, %a) : (reg<wasm.i64>, reg<wasm.i64>) -> reg<wasm.i64 x2>
    %sp = concat(%e, %b) : (reg<wasm.f32>, reg<wasm.f32>) -> reg<wasm.f32 x2>
    %dp = concat(%f, %c) : (reg<wasm.f64>, reg<wasm.f64>) -> reg<wasm.f64 x2>
    low.scf.yield %ip, %sp, %dp : reg<wasm.i64 x2>, reg<wasm.f32 x2>, reg<wasm.f64 x2>
  }
  %i0 = slice %integers[0] : reg<wasm.i64 x2> -> reg<wasm.i64>
  %i1 = slice %integers[1] : reg<wasm.i64 x2> -> reg<wasm.i64>
  %s0 = slice %singles[0] : reg<wasm.f32 x2> -> reg<wasm.f32>
  %s1 = slice %singles[1] : reg<wasm.f32 x2> -> reg<wasm.f32>
  %d0 = slice %doubles[0] : reg<wasm.f64 x2> -> reg<wasm.f64>
  %d1 = slice %doubles[1] : reg<wasm.f64 x2> -> reg<wasm.f64>
  return %i0, %i1, %s0, %s1, %d0, %d1
}

