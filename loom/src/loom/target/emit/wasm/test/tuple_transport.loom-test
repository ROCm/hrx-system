// RUN: emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

// The before region forwards a reordered packet tuple. The body rotates that
// tuple again and takes one backedge, while the false condition exits directly.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @while_packets(%condition: reg<wasm.i32>, %a: reg<wasm.v128>, %b: reg<wasm.v128>, %c: reg<wasm.v128>) -> (reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>) asm {
  %zero = i32.const 0
  %initial = concat(%a, %b, %c) : (reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>) -> reg<wasm.v128 x3>
  %result = low.scf.while(%again = %condition : reg<wasm.i32>, %state = %initial : reg<wasm.v128 x3>) -> (reg<wasm.v128 x3>) {
    %first = slice %state[0] : reg<wasm.v128 x3> -> reg<wasm.v128>
    %tail = slice %state[1] : reg<wasm.v128 x3> -> reg<wasm.v128 x2>
    %forwarded = concat(%tail, %first) : (reg<wasm.v128 x2>, reg<wasm.v128>) -> reg<wasm.v128 x3>
    low.scf.condition %again, %forwarded : reg<wasm.i32>, reg<wasm.v128 x3>
  } do(%body: reg<wasm.v128 x3>) {
    %first = slice %body[0] : reg<wasm.v128 x3> -> reg<wasm.v128>
    %tail = slice %body[1] : reg<wasm.v128 x3> -> reg<wasm.v128 x2>
    %next = concat(%tail, %first) : (reg<wasm.v128 x2>, reg<wasm.v128>) -> reg<wasm.v128 x3>
    low.scf.yield %zero, %next : reg<wasm.i32>, reg<wasm.v128 x3>
  }
  %r0 = slice %result[0] : reg<wasm.v128 x3> -> reg<wasm.v128>
  %r1 = slice %result[1] : reg<wasm.v128 x3> -> reg<wasm.v128>
  %r2 = slice %result[2] : reg<wasm.v128 x3> -> reg<wasm.v128>
  return %r0, %r1, %r2
}

