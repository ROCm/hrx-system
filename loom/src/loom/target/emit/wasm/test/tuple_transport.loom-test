// RUN: emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

// Two carried pairs exchange storage on the backedge. All four reads must
// precede writes, including when zero trips selects the original pairs.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @for_pairs(%count: reg<wasm.i32>, %a: reg<wasm.i32>, %b: reg<wasm.i32>, %c: reg<wasm.i32>, %d: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>) asm {
  %zero = i32.const 0
  %one = i32.const 1
  %left = concat(%a, %b) : (reg<wasm.i32>, reg<wasm.i32>) -> reg<wasm.i32 x2>
  %right = concat(%c, %d) : (reg<wasm.i32>, reg<wasm.i32>) -> reg<wasm.i32 x2>
  %final_left, %final_right = low.scf.for unsigned [%zero to %count step %one] iter_args(%left: reg<wasm.i32 x2>, %right: reg<wasm.i32 x2>) -> (reg<wasm.i32 x2>, reg<wasm.i32 x2>) do(%iv: reg<wasm.i32>, %x: reg<wasm.i32 x2>, %y: reg<wasm.i32 x2>) {
    low.scf.yield %y, %x : reg<wasm.i32 x2>, reg<wasm.i32 x2>
  }
  %r0 = slice %final_left[0] : reg<wasm.i32 x2> -> reg<wasm.i32>
  %r1 = slice %final_left[1] : reg<wasm.i32 x2> -> reg<wasm.i32>
  %r2 = slice %final_right[0] : reg<wasm.i32 x2> -> reg<wasm.i32>
  %r3 = slice %final_right[1] : reg<wasm.i32 x2> -> reg<wasm.i32>
  return %r0, %r1, %r2, %r3
}

