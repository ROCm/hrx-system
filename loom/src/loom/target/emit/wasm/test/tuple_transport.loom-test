// RUN: emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

// Only the high unit of the conditional result is observed. The original
// inputs remain live across the copy and branch, preventing destructive reuse.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @partial_copy(%condition: reg<wasm.i32>, %a: reg<wasm.f64>, %b: reg<wasm.f64>) -> (reg<wasm.f64>, reg<wasm.f64>) asm {
  %pair = concat(%a, %b) : (reg<wasm.f64>, reg<wasm.f64>) -> reg<wasm.f64 x2>
  %copied = copy %pair : reg<wasm.f64 x2> -> reg<wasm.f64 x2>
  %selected = low.scf.if %condition -> (reg<wasm.f64 x2>) {
    low.scf.yield %copied : reg<wasm.f64 x2>
  } else {
    %reversed = concat(%b, %a) : (reg<wasm.f64>, reg<wasm.f64>) -> reg<wasm.f64 x2>
    low.scf.yield %reversed : reg<wasm.f64 x2>
  }
  %high = slice %selected[1] : reg<wasm.f64 x2> -> reg<wasm.f64>
  %sum = f64.add %a, %b
  return %high, %sum
}

