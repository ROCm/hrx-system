// RUN: emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @offset_forms(%address: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %scalar = i32.load %address
  i32.store %address, %scalar {offset = 16}
  i32.store %address, %scalar
  %vector = v128.load %address {offset = 4294967295}
  v128.store %address, %vector {offset = 32}
  %byte = i32.load8_u %address {offset = 128}
  i32.store8 %address, %byte {offset = 255}
  %word = i32.load16_u %address {offset = 129}
  i32.store16 %address, %word {offset = 257}
  return %scalar
}

// ----
Disassembly of section CODE:

