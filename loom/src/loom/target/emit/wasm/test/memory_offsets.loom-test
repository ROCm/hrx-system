  local.get  1
  i32.store  16
  local.get  0
  local.get  1
  i32.store  0
  local.get  0
  v128.load  4294967295
  local.set  2
  local.get  0
  local.get  2
  v128.store  32
  local.get  0
  i32.load8_u  128
  local.set  3
  local.get  0
  local.get  3
  i32.store8  255
  local.get  0
  i32.load16_u  129
  local.set  3
  local.get  0
  local.get  3
  i32.store16  257
  local.get  1
  return
  end

// ====

// RUN: format bytecode

wasm.target<simd128> @target

// Preserve explicitly stored defaults through bytecode.
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @explicit_zero(%address: reg<wasm.i32>) -> (reg<wasm.i32>) {
  %value = low.op<wasm.i32.load>(%address) {offset = 0} : (reg<wasm.i32>) -> reg<wasm.i32>
  low.op<wasm.i32.store>(%address, %value) {offset = 0} : (reg<wasm.i32>, reg<wasm.i32>)
  low.return %value : reg<wasm.i32>
}

// ----
wasm.target<simd128> @target

low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @explicit_zero(%address: reg<wasm.i32>) -> (reg<wasm.i32>) {
  %value = low.op<wasm.i32.load>(%address) {offset = 0} : (reg<wasm.i32>) -> reg<wasm.i32>
  low.op<wasm.i32.store>(%address, %value) {offset = 0} : (reg<wasm.i32>, reg<wasm.i32>)
  low.return %value : reg<wasm.i32>
}

// ====

// RUN: verify

wasm.target<simd128> @target

low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @negative_offset(%address: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  // ERROR@+1: STRUCTURE/014 {attr_name="offset", actual_value="-1", expected_constraint="0..4294967295"}
  %value = i32.load %address {offset = -1}
  return %value
}

// ====

// RUN: verify

wasm.target<simd128> @target

low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @oversized_offset(%address: reg<wasm.i32>, %value: reg<wasm.i64>) asm {
  // ERROR@+1: STRUCTURE/014 {attr_name="offset", actual_value="4294967296", expected_constraint="0..4294967295"}
  i64.store %address, %value {offset = 4294967296}
  return
}
