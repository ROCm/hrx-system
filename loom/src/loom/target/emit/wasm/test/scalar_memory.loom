wasm.target<simd128> @target

func.def public target(@target) @condition_counter_store(%output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %base = index.constant 0 : offset
  %header_base = index.constant 16 : offset
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %body_view = buffer.view %aligned_output[%base] : buffer -> view<4xi32>
  %header_view = buffer.view %aligned_output[%header_base] : buffer -> view<5xi32>
  %terminal = scf.while(%before = %begin : index) -> (index) {
    %header_value = index.cast %before : index to i32
    view.store %header_value, %header_view[%before] : i32, view<5xi32>
    %more = index.cmp slt, %before, %end : index
    scf.condition %more, %before : i1, index
  } do(%position: index) {
    %body_value = index.cast %position : index to i32
    view.store %body_value, %body_view[%position] : i32, view<4xi32>
    %next = index.add %position, %step : index
    scf.yield %next : index
  }
  %exit_value = index.cast %terminal : index to i32
  view.store %exit_value, %header_view[%terminal] : i32, view<5xi32>
  func.return
}

func.def public target(@target) @exchange_i32(%buffer: buffer, %base_input: offset, %position_input: index, %value: i32) -> (i32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %base = index.assume %base_input [range(%base_input, 0, 128), mul(%base_input, 8)] : offset
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi32>
  %previous = view.load %view[%position] : view<8xi32> -> i32
  view.store %value, %view[%position] : i32, view<8xi32>
  func.return %previous : i32
}

func.def public target(@target) @exchange_i64(%buffer: buffer, %base_input: offset, %position_input: index, %value: i64) -> (i64) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %base = index.assume %base_input [range(%base_input, 0, 128), mul(%base_input, 8)] : offset
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xi64>
  %previous = view.load %view[%position] : view<8xi64> -> i64
  view.store %value, %view[%position] : i64, view<8xi64>
  func.return %previous : i64
}

func.def public target(@target) @exchange_f32(%buffer: buffer, %base_input: offset, %position_input: index, %value: f32) -> (f32) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %base = index.assume %base_input [range(%base_input, 0, 128), mul(%base_input, 8)] : offset
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xf32>
  %previous = view.load %view[%position] : view<8xf32> -> f32
  view.store %value, %view[%position] : f32, view<8xf32>
  func.return %previous : f32
}

func.def public target(@target) @exchange_f64(%buffer: buffer, %base_input: offset, %position_input: index, %value: f64) -> (f64) {
  %aligned_buffer = buffer.assume.alignment %buffer {minimum_alignment = 8} : buffer
  %base = index.assume %base_input [range(%base_input, 0, 128), mul(%base_input, 8)] : offset
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %prefix = index.constant 16 : offset
  %origin = index.add %base, %prefix : offset
  %view = buffer.view %aligned_buffer[%origin] : buffer -> view<8xf64>
  %previous = view.load %view[%position] : view<8xf64> -> f64
  view.store %value, %view[%position] : f64, view<8xf64>
  func.return %previous : f64
}

func.def public target(@target) @compare_index(%lhs_input: i32, %rhs_input: i32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %lhs = index.cast %lhs_input : i32 to index
  %rhs = index.cast %rhs_input : i32 to index
  %eq = index.cmp eq, %lhs, %rhs : index
  %ne = index.cmp ne, %lhs, %rhs : index
  %slt = index.cmp slt, %lhs, %rhs : index
  %sle = index.cmp sle, %lhs, %rhs : index
  %sgt = index.cmp sgt, %lhs, %rhs : index
  %sge = index.cmp sge, %lhs, %rhs : index
  %ult = index.cmp ult, %lhs, %rhs : index
  %ule = index.cmp ule, %lhs, %rhs : index
  %ugt = index.cmp ugt, %lhs, %rhs : index
  %uge = index.cmp uge, %lhs, %rhs : index
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

func.def public target(@target) @compare_offset(%lhs_input: i32, %rhs_input: i32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %lhs = index.cast %lhs_input : i32 to offset
  %rhs = index.cast %rhs_input : i32 to offset
  %eq = index.cmp eq, %lhs, %rhs : offset
  %ne = index.cmp ne, %lhs, %rhs : offset
  %slt = index.cmp slt, %lhs, %rhs : offset
  %sle = index.cmp sle, %lhs, %rhs : offset
  %sgt = index.cmp sgt, %lhs, %rhs : offset
  %sge = index.cmp sge, %lhs, %rhs : offset
  %ult = index.cmp ult, %lhs, %rhs : offset
  %ule = index.cmp ule, %lhs, %rhs : offset
  %ugt = index.cmp ugt, %lhs, %rhs : offset
  %uge = index.cmp uge, %lhs, %rhs : offset
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

func.def public target(@target) @index_bitwise(%lhs: index, %rhs: index) -> (index, index, index) {
  %and = index.andi %lhs, %rhs : index
  %or = index.ori %lhs, %rhs : index
  %xor = index.xori %lhs, %rhs : index
  func.return %and, %or, %xor : index, index, index
}

func.def public target(@target) @index_bitwise_constants(%input: index) -> (index, index, index, index) {
  %mask = index.constant 64 : index
  %tag = index.constant 128 : index
  %negative = index.constant -16 : index
  %high_bit = index.constant -2147483648 : index
  %masked = index.andi %input, %mask : index
  %tagged = index.ori %tag, %input : index
  %toggled = index.xori %input, %negative : index
  %sign = index.andi %high_bit, %input : index
  func.return %masked, %tagged, %toggled, %sign : index, index, index, index
}

func.def public target(@target) @exchange_matrix(%buffer: buffer, %columns_input: index, %row_input: index, %column_input: index, %value: i32) -> (i32) {
  %aligned = buffer.assume.alignment %buffer {minimum_alignment = 4} : buffer
  %columns = index.assume %columns_input [range(%columns_input, 4, 16)] : index
  %row = index.assume %row_input [range(%row_input, 0, 3)] : index
  %column = index.assume %column_input [range(%column_input, 0, 3)] : index
  %base = index.constant 24 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<4x[%columns]xi32>
  %previous = view.load %view[%row, %column] : view<4x[%columns]xi32> -> i32
  view.store %value, %view[%row, %column] : i32, view<4x[%columns]xi32>
  func.return %previous : i32
}

func.def public target(@target) @address_roundtrip(%input: i32) -> (i32, i32, i32) {
  %position = index.cast %input : i32 to index
  %position_bits = index.cast %position : index to i32
  %offset = index.cast %input : i32 to offset
  %offset_bits = index.cast %offset : offset to i32
  %mask = scalar.constant 2147483647 : i32
  %nonnegative = scalar.andi %input, %mask : i32
  %bounded_position = index.cast %nonnegative : i32 to index
  %bounded_offset = index.cast %bounded_position : index to offset
  %restored_position = index.cast %bounded_offset : offset to index
  %bounded_bits = index.cast %restored_position : index to i32
  func.return %position_bits, %offset_bits, %bounded_bits : i32, i32, i32
}

func.def public target(@target) @copy_vector(%input: buffer, %output: buffer, %position_input: index) {
  %position = index.assume %position_input [range(%position_input, 0, 4)] : index
  %source_base = index.constant 16 : offset
  %destination_base = index.constant 32 : offset
  %source = buffer.view %input[%source_base] : buffer -> view<8xi32>
  %destination = buffer.view %output[%destination_base] : buffer -> view<8xi32>
  %value = vector.load %source[%position] : view<8xi32> -> vector<4xi32>
  vector.store %value, %destination[%position] : vector<4xi32>, view<8xi32>
  func.return
}

func.def public target(@target) @load_static(%input: buffer) -> (i32) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %base = index.constant 16 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

func.def public target(@target) @load_address_boundary(%input: buffer, %position_input: index) -> (i32) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %position = index.assume %position_input [range(%position_input, 0, 7)] : index
  %base = index.constant 4294967264 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<8xi32>
  %value = view.load %view[%position] : view<8xi32> -> i32
  func.return %value : i32
}

func.def public target(@target) @store_static(%output: buffer, %value: i32) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %base = index.constant 16 : offset
  %view = buffer.view %aligned[%base] : buffer -> view<1xi32>
  view.store %value, %view[0] : i32, view<1xi32>
  func.return
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @read_byte(%address: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %value = i32.load8_u %address
  return %value
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @write_byte(%address: reg<wasm.i32>, %value: reg<wasm.i32>) asm {
  i32.store8 %address, %value
  return
}
