load("//build_tools/bazel:python.bzl", "iree_py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_test(
    name = "artifact_test",
    srcs = ["artifact_test.py"],
    args = [
        "$(location //loom/src/loom/tools/loom-compile:loom-compile)",
        "$(location sum.loom)",
        "$(location scalar_memory.loom)",
        "$(location typed_addresses.loom)",
        "$(location //loom/src/loom/test/corpus/source_low:numeric_boolean_comparison.loom-test)",
        "$(location boolean.mjs)",
    ],
    data = [
        "boolean.mjs",
        "scalar_memory.loom",
        "scalar_memory.mjs",
        "sum.loom",
        "sum.mjs",
        "typed_addresses.loom",
        "typed_addresses.mjs",
        "//loom/src/loom/test/corpus/source_low:numeric_boolean_comparison.loom-test",
        "//loom/src/loom/tools/loom-compile",
    ],
    env_inherit = [
        "IREE_WASM_NODE",
        "PATH",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target:wasm_artifacts",
    ]),
)

loom_check_test_suite(
    name = "loom_check_file_test",
    srcs = [
        "assembly.loom-test",
        "loop_termination.loom-test",
        "memory_offsets.loom-test",
        "numeric.loom-test",
        "schedule_scopes.loom-test",
    ],
    data = [
        "@wasi_sdk//:llvm-objdump",
    ],
    env = {
        "LOOM_WASM_LLVM_OBJDUMP": "$(rootpath @wasi_sdk//:llvm-objdump)",
    },
)
