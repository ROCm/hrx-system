load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
    "loom_generated_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

#===------------------------------------------------------------------------===#
# Wasm emission
#===------------------------------------------------------------------------===#

loom_generated_cc_library(
    name = "error_defs",
    args = [
        "--catalog-symbol=loom_wasm_error_catalog",
        "--fallback-catalog-symbol=loom_error_catalog_core",
        "--fallback-public-header=loom/error/error_catalog.h",
        "--public-header=loom/target/emit/wasm/error_catalog.h",
        "--shard=wasm",
    ],
    generated_hdr_flags = ["--header"],
    generated_hdrs = ["error_catalog.h"],
    generator = "//loom/py/loom/gen/error:c_errors",
    source = "error_catalog.c",
    visibility = ["//loom/src/loom/target/emit/wasm/lower:__pkg__"],
    deps = ["//loom/src/loom/error:error_defs"],
)

loom_cc_library(
    name = "binary_writer",
    srcs = ["binary_writer.c"],
    hdrs = ["binary_writer.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "types",
    srcs = ["types.c"],
    hdrs = ["types.h"],
    deps = [
        "//loom/src/loom/target/arch/wasm/descriptors:descriptors_ids",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "program",
    hdrs = ["program.h"],
    visibility = ["//loom/src/loom/tooling/target/wasm:__pkg__"],
    deps = [
        ":types",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "function_body",
    srcs = ["function_body.c"],
    hdrs = ["function_body.h"],
    deps = [
        ":binary_writer",
        ":program",
        ":types",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low:representation_binding",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target/arch/wasm/descriptors",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "module_binary",
    srcs = ["module_binary.c"],
    hdrs = ["module_binary.h"],
    visibility = ["//loom/src/loom/tooling/target/wasm:__pkg__"],
    deps = [
        ":binary_writer",
        ":function_body",
        ":program",
        ":types",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "module_compiler",
    srcs = ["module_compiler.c"],
    hdrs = ["module_compiler.h"],
    visibility = [
        "//loom/binding/c/target/wasm:__pkg__",
        "//loom/src/loom/target/configured:__pkg__",
        "//loom/src/loom/tooling/target/wasm:__pkg__",
    ],
    deps = [
        ":module_binary",
        ":program",
        "//loom/src/loom/codegen/low:allocation",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low:diagnostics",
        "//loom/src/loom/codegen/low:function_model",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/wasm:provider",
        "//loom/src/loom/target/arch/wasm/descriptors",
        "//loom/src/loom/target/arch/wasm/ops",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

iree_assert_dependency_boundary(
    name = "module_compiler_has_no_tooling_dependencies",
    forbidden_subtrees = ["//loom/src/loom/tooling/..."],
    message = "Wasm module compilation is target-owned and must not depend on tooling",
    target = ":module_compiler",
)

iree_assert_dependency_boundary(
    name = "module_binary_analysis_boundary",
    allowed_dependencies = [
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low:representation_binding",
    ],
    forbidden_subtrees = ["//loom/src/loom/codegen/low/..."],
    message = "Wasm binary emission may consume verified Low representation bindings but must not run target resolution or program planning",
    target = ":module_binary",
)

loom_cc_test(
    name = "module_compiler_test",
    srcs = ["module_compiler_test.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:wasm",
    ]),
    deps = [
        ":module_compiler",
        "//loom/src/loom/target:selection",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "descriptor_fields_test",
    srcs = ["descriptor_fields_test.cc"],
    deps = [
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/ir",
        "//loom/src/loom/target/arch/wasm/descriptors:descriptors_ids",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
