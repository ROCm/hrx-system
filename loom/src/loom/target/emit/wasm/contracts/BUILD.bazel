load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_target_contract_table_cc_libraries",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_target_contract_table_cc_libraries(
    name = "core_simd128",
    args = ["--contract-fragment=wasm.core.simd128"],
    contract_deps = ["//loom/src/loom/target:contract"],
    generator = "//loom/py/loom/gen/target/contracts:wasm_contract_table_family",
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/buffer",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/target/arch/wasm/descriptors:descriptors_ids",
    ],
)

loom_cc_library(
    name = "contracts",
    hdrs = [
        "core_simd128.h",
        "core_simd128_lower_rules.h",
    ],
    deps = [
        ":core_simd128",
        ":core_simd128_lower_rules",
    ],
)
