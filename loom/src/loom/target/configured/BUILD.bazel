load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_CONFIGURED_TARGET_COPTS = (
    iree_select({
        "//loom/config/target/arch:vm": ["-DLOOM_CONFIG_TARGET_HAVE_VM=1"],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:amdgpu": [
            "-DLOOM_CONFIG_TARGET_HAVE_AMDGPU=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:xdna": [
            "-DLOOM_CONFIG_TARGET_HAVE_XDNA=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:spirv": [
            "-DLOOM_CONFIG_TARGET_HAVE_SPIRV=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:wasm": [
            "-DLOOM_CONFIG_TARGET_HAVE_WASM=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:x86": [
            "-DLOOM_CONFIG_TARGET_HAVE_X86=1",
        ],
        "//conditions:default": [],
    })
)

_CONFIGURED_TARGET_DEPS = (
    iree_select({
        "//loom/config/target/arch:vm": ["//loom/src/loom/target/arch/vm:provider"],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:amdgpu": [
            "//loom/src/loom/target/arch/amdgpu:provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:xdna": [
            "//loom/src/loom/target/arch/amd/xdna/aie2p:provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:spirv": [
            "//loom/src/loom/target/arch/spirv:provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:wasm": [
            "//loom/src/loom/target/arch/wasm:provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:x86": [
            "//loom/src/loom/target/arch/x86:provider",
        ],
        "//conditions:default": [],
    })
)

_CONFIGURED_COMPILER_COPTS = (
    iree_select({
        "//loom/config/target/arch:x86": [
            "-DLOOM_CONFIG_COMPILER_HAVE_X86=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:amdgpu_artifacts": [
            "-DLOOM_CONFIG_COMPILER_HAVE_AMDGPU=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:spirv_artifacts": [
            "-DLOOM_CONFIG_COMPILER_HAVE_SPIRV=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:vm": [
            "-DLOOM_CONFIG_COMPILER_HAVE_VM=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:wasm_artifacts": [
            "-DLOOM_CONFIG_COMPILER_HAVE_WASM=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:xdna_artifacts": [
            "-DLOOM_CONFIG_COMPILER_HAVE_XDNA=1",
        ],
        "//conditions:default": [],
    })
)

_CONFIGURED_COMPILER_DEPS = (
    iree_select({
        "//loom/config/target/arch:x86": [
            "//loom/src/loom/target/arch/x86:compiler_provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:amdgpu_artifacts": [
            "//loom/src/loom/target/emit/native/amdgpu:hal_kernel_library",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:spirv_artifacts": [
            "//loom/src/loom/target/arch/spirv:compiler_provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target/arch:vm": [
            "//loom/src/loom/target/emit/vm:module_compiler",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:wasm_artifacts": [
            "//loom/src/loom/target/emit/wasm:module_compiler",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:xdna_artifacts": [
            "//loom/src/loom/target/arch/amd/xdna/aie2p:artifact",
        ],
        "//conditions:default": [],
    })
)

loom_cc_library(
    name = "provider_set",
    srcs = ["provider_set.c"],
    hdrs = ["provider_set.h"],
    copts = _CONFIGURED_TARGET_COPTS,
    visibility = [
        "//loom/binding/c/target/configured:__pkg__",
        "//loom/src/loom/tools:__subpackages__",
    ],
    deps = [
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/cmd:provider",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ] + _CONFIGURED_TARGET_DEPS,
)

loom_cc_library(
    name = "compiler_provider_set",
    srcs = ["compiler_provider_set.c"],
    hdrs = ["compiler_provider_set.h"],
    copts = _CONFIGURED_COMPILER_COPTS,
    visibility = [
        "//loom/binding/c/target/configured:__pkg__",
        "//loom/src/loom/tools/iree-benchmark-loom:__pkg__",
        "//loom/src/loom/tools/iree-test-loom:__pkg__",
        "//loom/src/loom/tools/loom-check:__pkg__",
    ],
    deps = [
        "//loom/src/loom/target:provider",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ] + _CONFIGURED_COMPILER_DEPS,
)

loom_cc_test(
    name = "compiler_provider_set_test",
    srcs = ["compiler_provider_set_test.cc"],
    copts = _CONFIGURED_COMPILER_COPTS,
    deps = [
        ":compiler_provider_set",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target:selection",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = ["//loom/src/loom/tools:__subpackages__"],
    deps = [
        ":provider_set",
        "//loom/src/loom/target:provider",
        "//runtime/src/iree/base/threading",
    ],
)

loom_cc_library(
    name = "low_registry",
    srcs = ["low_registry.c"],
    hdrs = ["low_registry.h"],
    deps = [
        ":provider",
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/target:legalization",
        "//loom/src/loom/target:low_descriptor_registry",
        "//loom/src/loom/target:low_legality",
        "//runtime/src/iree/base",
    ],
)
