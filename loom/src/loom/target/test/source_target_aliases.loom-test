test.target<low_core> @helper_target {subgroup_size = 32}

low.func.def noinline target<test.low.core>(@helper_target) @double(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = test.add.i32 %value, %value
  return %result
}

low.func.def noinline target<test.low.core>(@helper_target) @increment(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %doubled = low.func.call pure @double(%value) : (reg<test.i32>) -> (reg<test.i32>)
  %step = test.const.i32 1
  %result = test.add.i32 %doubled, %step
  return %result
}

low.func.def public target<test.low.core>(@helper_target) abi(object_function) @entry(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.func.call pure @increment(%value) : (reg<test.i32>) -> (reg<test.i32>)
  return %result
