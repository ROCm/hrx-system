// ====

// Outlined workers have distinct retained contexts even when their target
// facts are equivalent. Retained semantic and Low calls preserve that exact
// context because their eventual register ABI and allocation products belong
// to the worker. A repeated specialization pass reuses both helper versions.
// RUN: pass outline-pipeline-strands,specialize-target-callgraph,specialize-target-callgraph
test.target<low_core> @core

func.def noinline @source_identity(%value: i32) -> (i32) {
  func.return %value : i32
}

low.func.def noinline target<test.low.core>(@core) @identity(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

pipeline.def public target(@core) @run() run(%value: i32) {
  pipeline.strand workers([0], [1], [1]) {
    %source_result = func.call @source_identity(%value) : (i32) -> (i32)
    %result = low.invoke noinline @identity(%source_result) : (i32) -> (i32)
  }
  pipeline.strand workers([1], [1], [1]) {
    %source_result = func.call @source_identity(%value) : (i32) -> (i32)
    %result = low.invoke noinline @identity(%source_result) : (i32) -> (i32)
  }
}

// ----
test.target<low_core> @core

func.def noinline @source_identity(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def noinline @source_identity_spec0(%value: i32) -> (i32) {
  func.return %value : i32
}

low.func.def noinline target<test.low.core>(@core) @identity(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

low.func.def noinline target<test.low.core>(@core) @identity_spec0(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

pipeline.def public target(@core) @run() run(%value: i32) {
  pipeline.strand workers([0], [1], [1]) {
    func.call @__pipeline_strand_1(%value) : (i32)
  }
  pipeline.strand workers([1], [1], [1]) {
    func.call @__pipeline_strand_0(%value) : (i32)
  }
}

func.def inline @__pipeline_strand_0(%value: i32) {
  cfg.br ^_bb1
^_bb1:
  %source_result = func.call @source_identity(%value) : (i32) -> (i32)
  %result = low.invoke noinline @identity(%source_result) : (i32) -> (i32)
  func.return
}

func.def inline @__pipeline_strand_1(%value: i32) {
  cfg.br ^_bb1
^_bb1:
  %source_result = func.call @source_identity_spec0(%value) : (i32) -> (i32)
  %result = low.invoke noinline @identity_spec0(%source_result) : (i32) -> (i32)
  func.return
}
