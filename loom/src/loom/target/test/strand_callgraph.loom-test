// The shared helper chain executes in two target environments. Both calls in
// each cloned helper must retain their selected leaf version.
// RUN: pass specialize-target-callgraph,specialize-target-callgraph,canonicalize
test.target<low_core> @construction {subgroup_size = 64}

test.target<low_core> @worker {subgroup_size = 32}

func.def noinline @width() -> (index) {
  %width = target.subgroup.size : index
  func.return %width : index
}

func.def noinline @paired_width() -> (index) {
  %first = func.call @width() : () -> (index)
  %second = func.call @width() : () -> (index)
  %width = index.add %first, %second : index
  func.return %width : index
}

pipeline.def public target(@construction) @publish_widths(%enabled: i1) run(%output: channel<tile<2xi32>>) {
  %construction_width = func.call @paired_width() : () -> (index)
  %construction_value = index.cast %construction_width : index to i32
  pipeline.strand target(@worker) workers([0], [1], [1]) {
    scf.if %enabled {
      %write, %record = channel.reserve %output : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
      %worker_width = func.call @paired_width() : () -> (index)
      %worker_value = index.cast %worker_width : index to i32
      view.store %construction_value, %record[0] : i32, view<2xi32>
      view.store %worker_value, %record[1] : i32, view<2xi32>
      channel.publish %write : write<tile<2xi32>>
    }
  }
}

