// ====

// Inherited devices project to worker code before specializing ordinary calls.
// One reusable child is composed in two device contexts; its worker retains
// hardware facts without inheriting the device's array ABI or contract.
// RUN: pass specialize-target-callgraph,specialize-target-callgraph,canonicalize
test.target<device> @device32 {subgroup_size = 32}

test.target<device> @device64 {subgroup_size = 64}

test.target<low_core> @core

func.def noinline target(@core) @worker_width() -> (index) {
  %width = target.subgroup.size : index
  func.return %width : index
}

pipeline.def @publish_width() run(%output: channel<tile<1xi32>>) {
  pipeline.strand workers([0], [1], [1]) {
    %write, %record = channel.reserve %output : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %width = func.call @worker_width() : () -> (index)
    %value = index.cast %width : index to i32
    view.store %value, %record[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
}

pipeline.def public target(@device32) @run32() run(%output: channel<tile<1xi32>>) {
  pipeline.compose @publish_width(%output) : (channel<tile<1xi32>>)
}

pipeline.def public target(@device64) @run64() run(%output: channel<tile<1xi32>>) {
  pipeline.compose @publish_width(%output) : (channel<tile<1xi32>>)
}

