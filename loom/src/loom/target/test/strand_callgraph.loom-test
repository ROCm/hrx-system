  }
}

// ====

// Worker roots do not require a bound construction target. Unknown workers
// preserve the generic helper; bound workers use separate concrete versions.
// Repeated specialization must reuse those versions.
// RUN: pass specialize-target-callgraph,specialize-target-callgraph,specialize-target-callgraph,canonicalize
test.target<low_core> @width32 {subgroup_size = 32}

test.target<low_core> @width64 {subgroup_size = 64}

target.decl @unknown

func.def noinline @width() -> (index) {
  %width = target.subgroup.size : index
  func.return %width : index
}

pipeline.def public @publish_widths() run(%first: channel<tile<1xi32>>, %second: channel<tile<1xi32>>, %third: channel<tile<1xi32>>, %fourth: channel<tile<1xi32>>) {
  pipeline.strand target(@width32) workers([0], [1], [1]) {
    %write, %record = channel.reserve %first : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %width = func.call @width() : () -> (index)
    %value = index.cast %width : index to i32
    view.store %value, %record[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
  pipeline.strand target(@width64) workers([1], [1], [1]) {
    %write, %record = channel.reserve %second : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %width = func.call @width() : () -> (index)
    %value = index.cast %width : index to i32
    view.store %value, %record[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
  pipeline.strand target(@unknown) workers([2], [1], [1]) {
    %write, %record = channel.reserve %third : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %width = func.call @width() : () -> (index)
    %value = index.cast %width : index to i32
    view.store %value, %record[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
  pipeline.strand workers([3], [1], [1]) {
    %write, %record = channel.reserve %fourth : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %width = func.call @width() : () -> (index)
    %value = index.cast %width : index to i32
    view.store %value, %record[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
}

