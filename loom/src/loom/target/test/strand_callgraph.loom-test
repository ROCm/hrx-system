// ====

// A reusable child inherits each caller's target through an omitted strand
// target. Explicit unresolved targets remain independent within a bound parent.
// RUN: pass @specialize_targets
test.target<low_core> @width32 {subgroup_size = 32}

test.target<low_core> @width64 {subgroup_size = 64}

target.decl @unresolved

func.def noinline @width() -> (index) {
  %width = target.subgroup.size : index
  func.return %width : index
}

pipeline.def @publish_width() run(%output: channel<tile<1xi32>>) {
  pipeline.strand workers([0], [1], [1]) {
    %write, %record = channel.reserve %output : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %width = func.call @width() : () -> (index)
    %value = index.cast %width : index to i32
    view.store %value, %record[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
}

pipeline.def target(@width64) @publish_fixed_width() run(%output: channel<tile<1xi32>>) {
  pipeline.compose @publish_width(%output) : (channel<tile<1xi32>>)
}

pipeline.def target(@unresolved) @publish_unknown_width() run(%output: channel<tile<1xi32>>) {
  pipeline.compose @publish_width(%output) : (channel<tile<1xi32>>)
}

pipeline.def public target(@width32) @publish_narrow() run(%output: channel<tile<1xi32>>, %fixed: channel<tile<1xi32>>, %other: channel<tile<1xi32>>) {
  pipeline.compose @publish_width(%output) : (channel<tile<1xi32>>)
  pipeline.compose @publish_fixed_width(%fixed) : (channel<tile<1xi32>>)
  pipeline.compose @publish_unknown_width(%other) : (channel<tile<1xi32>>)
}

pipeline.def public target(@width64) @publish_wide() run(%output: channel<tile<1xi32>>) {
  pipeline.compose @publish_width(%output) : (channel<tile<1xi32>>)
}

pass.pipeline<module> @specialize_targets pipeline {
  for func {
    where target {
      canonicalize
    }
  }
  specialize-target-callgraph
  specialize-target-callgraph
  for func {
    canonicalize
  }
}

