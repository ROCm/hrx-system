  %width = index.constant 32 : index
  func.return %width : index
}

func.def noinline target(@core) @worker_width_spec0() -> (index) {
  %width = index.constant 64 : index
  func.return %width : index
}

pipeline.def @publish_width() run(%output: channel<tile<1xi32>>) {
  pipeline.strand workers([0], [1], [1]) {
