        X86_TASK_HARDWARE_PROFILE.name: {
            "function/rodata.loom:@immutable_gather_values": "X86/005",
            "numeric/conversion/f32_narrowing.loom:@f32_narrowing_values": "TARGET/031",
            # Base profiles lack FP16 rules; feature profiles can disable them.
            "numeric/float/fused_arithmetic.loom:@fma_nan_f16_values": "TARGET/002,TARGET/003",
            "numeric/vector/floating.loom:@bfloat_lookup_arithmetic_values": "X86/005",
        },
    },
    catalog = LOOM_CORPUS,
    execution_profiles = [X86_TASK_HARDWARE_PROFILE],
    profile_sources = {
        X86_TASK_HARDWARE_PROFILE.name: [
            "control/branch/convergence.loom",
            "control/loop/scalar_state.loom",
            "control/loop/vector_recurrence.loom",
            "function/call/calls.loom",
