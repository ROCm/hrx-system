func.def noinline @i16_count_carriers(%input: i16) -> (i16, i1, i32, i32) {
  %leading = scalar.ctlzi %input : i16
  %trailing = scalar.cttzi %input : i16
  %population = scalar.ctpopi %input : i16
  %bias = scalar.constant -32768 : i16
  %biased = scalar.addi %leading, %bias : i16
  %ordered = scalar.cmpi ule, %population, %trailing : i16
  %signed = scalar.extsi %biased : i16 to i32
  %unsigned = scalar.extui %biased : i16 to i32
  func.return %biased, %ordered, %signed, %unsigned : i16, i1, i32, i32
}

kernel.def @x86_native_i16_count_carriers() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_word: i32, %output: buffer) {
  %input = scalar.trunci %input_word : i32 to i16
  %value, %ordered, %signed, %unsigned = func.call @i16_count_carriers(%input) : (i16) -> (i16, i1, i32, i32)
  %return_signed = scalar.extsi %value : i16 to i32
  %return_unsigned = scalar.extui %value : i16 to i32
  %ordered_word = scalar.extui %ordered : i1 to i32
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %output : buffer
  %output_view = buffer.view %global[%base] : buffer -> view<5xi32>
  view.store %return_signed, %output_view[0] : i32, view<5xi32>
  view.store %return_unsigned, %output_view[1] : i32, view<5xi32>
  view.store %ordered_word, %output_view[2] : i32, view<5xi32>
  view.store %signed, %output_view[3] : i32, view<5xi32>
  view.store %unsigned, %output_view[4] : i32, view<5xi32>
  kernel.return
}

check.case public @x86_native_i16_count_carrier_values {
  %input = check.literal value(-32768) : i32
  %output = check.generate.fill value(0) : tensor<5xi32>
  kernel.launch @x86_native_i16_count_carriers(%input, %output) : (i32, tensor<5xi32>)
  %returned = check.tensor.view %output offset(0) : tensor<5xi32> -> tensor<2xi32>
  %signed_unsigned = check.generate.iota offset(-32768) step(65536) : tensor<2xi32>
  check.expect.equal actual(%returned) expected(%signed_unsigned) : tensor<2xi32>
  %ordered = check.tensor.view %output offset(8) : tensor<5xi32> -> tensor<1xi32>
  %ordered_expected = check.generate.fill value(1) : tensor<1xi32>
  check.expect.equal actual(%ordered) expected(%ordered_expected) : tensor<1xi32>
  %extended = check.tensor.view %output offset(12) : tensor<5xi32> -> tensor<2xi32>
  check.expect.equal actual(%extended) expected(%signed_unsigned) : tensor<2xi32>
  check.return
}
