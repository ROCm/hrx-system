// The newer load crosses the older result's first use on the issue path.
// The skip path still completes the old result without issuing the new load.

amdgpu.target<gfx11-generic> @incoming_wait_target

low.func.def schedule(locked) target<amdgpu.gfx11.generic.core>(@incoming_wait_target) @incoming_wait_overlap(%address: reg<amdgpu.vgpr>, %old_base: reg<amdgpu.sgpr x2>, %future_base: reg<amdgpu.sgpr x2>, %flag: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %old = global_load_b32_saddr %address, %old_base
  %disabled = s_mov_b32 0
  %enabled = s_cmp_lg_i32 %flag, %disabled
  low.cond_br %enabled, ^issue, ^skip : reg<amdgpu.scc>
^issue:
  %future = global_load_b32_saddr %address, %future_base
  %current = v_add_u32 %old, %address
  low.br ^exit(%current: reg<amdgpu.vgpr>, %future: reg<amdgpu.vgpr>)
^skip:
  %skipped = v_add_u32 %old, %address
  %zero = v_mov_b32 0
  low.br ^exit(%skipped: reg<amdgpu.vgpr>, %zero: reg<amdgpu.vgpr>)
^exit(%result: reg<amdgpu.vgpr>, %pending: reg<amdgpu.vgpr>):
  return %result, %pending
}

kernel.def target(@incoming_wait_target) @incoming_wait_pair() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%old: buffer, %future: buffer, %current_output: buffer, %future_output: buffer, %flag: i32) {
  %lane = kernel.workitem.id<x> : index
  %element_bytes = index.constant 4 : index
  %byte_offset = index.mul %lane, %element_bytes : index
  %byte_i32 = index.cast %byte_offset : index to i32
  %address = vector.splat %byte_i32 : vector<1xi32>
  %current, %pending = low.invoke @incoming_wait_overlap(%address, %old, %future, %flag) : (vector<1xi32>, buffer, buffer, i32) -> (vector<1xi32>, vector<1xi32>)
  %base = index.constant 0 : offset
  %current_view = buffer.view %current_output[%base] : buffer -> view<32xi32>
  %future_view = buffer.view %future_output[%base] : buffer -> view<32xi32>
  vector.store %current, %current_view[%lane] : vector<1xi32>, view<32xi32>
  vector.store %pending, %future_view[%lane] : vector<1xi32>, view<32xi32>
  kernel.return
}

check.case public @incoming_wait_skip {
  %old = check.generate.iota offset(7) step(3) : tensor<32xi32>
  %future = check.generate.iota offset(50) step(5) : tensor<32xi32>
  %current_output = check.generate.fill value(-1) : tensor<32xi32>
  %future_output = check.generate.fill value(-1) : tensor<32xi32>
  %flag = check.literal value(0) : i32
  kernel.launch @incoming_wait_pair(%old, %future, %current_output, %future_output, %flag) : (tensor<32xi32>, tensor<32xi32>, tensor<32xi32>, tensor<32xi32>, i32)
  %expected_current = check.generate.iota offset(7) step(7) : tensor<32xi32>
  %expected_future = check.generate.iota offset(0) step(0) : tensor<32xi32>
  check.expect.equal actual(%current_output) expected(%expected_current) : tensor<32xi32>
  check.expect.equal actual(%future_output) expected(%expected_future) : tensor<32xi32>
  check.return
}

check.case public @incoming_wait_issue {
  %old = check.generate.iota offset(7) step(3) : tensor<32xi32>
  %future = check.generate.iota offset(50) step(5) : tensor<32xi32>
  %current_output = check.generate.fill value(-1) : tensor<32xi32>
  %future_output = check.generate.fill value(-1) : tensor<32xi32>
  %flag = check.literal value(1) : i32
  kernel.launch @incoming_wait_pair(%old, %future, %current_output, %future_output, %flag) : (tensor<32xi32>, tensor<32xi32>, tensor<32xi32>, tensor<32xi32>, i32)
  %expected_current = check.generate.iota offset(7) step(7) : tensor<32xi32>
  %expected_future = check.generate.iota offset(50) step(5) : tensor<32xi32>
  check.expect.equal actual(%current_output) expected(%expected_current) : tensor<32xi32>
  check.expect.equal actual(%future_output) expected(%expected_future) : tensor<32xi32>
  check.return
}
