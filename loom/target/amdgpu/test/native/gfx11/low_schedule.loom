// Two BF16 tiles cross authored Low call boundaries under four schedule policies.
// Every lane uses A=1 and B=1..32, so the two matrix products contribute 136 and
// 392 to each result. Distinct contributions expose stale or duplicated tiles.
// The matching native scheduling fixture checks load placement and partial
// waits; these cases execute the default source compiler and HAL path.

amdgpu.target<gfx11-generic> @schedule_wmma_target {subgroup_size = 32}

low.func.def target<amdgpu.gfx11.generic.core>(@schedule_wmma_target) @schedule_wmma_free(%workitem_id: reg<amdgpu.vgpr>, %lhs_view: reg<amdgpu.sgpr x2>, %rhs_view: reg<amdgpu.sgpr x2>, %out_view: reg<amdgpu.sgpr x2>) asm {
  %lane = v_and_b32_src0_inline %workitem_id, 15
  %byte_offset = v_lshlrev_b32_src0_inline %lane, 6
  %lhs0_low = global_load_b128_saddr %byte_offset, %lhs_view
