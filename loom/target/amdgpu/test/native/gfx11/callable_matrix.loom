// A retained helper returns the complete two-stage WMMA result. The caller
// immediately stores every returned register, exposing result transport and
// completion at the callable boundary independently of repeated calls.

amdgpu.target<gfx11-generic> @callable_matrix_target {subgroup_size = 32}

low.func.def noinline target<amdgpu.gfx11.generic.core>(@callable_matrix_target) @matrix_sum(%workitem: reg<amdgpu.vgpr>, %lhs_view: reg<amdgpu.sgpr x2>, %rhs_view: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x8>) asm {
  %lane = v_and_b32_src0_inline %workitem, 15
  %byte_offset = v_lshlrev_b32_src0_inline %lane, 6
  %lhs0_low = global_load_b128_saddr %byte_offset, %lhs_view
  %lhs0_high = global_load_b128_saddr %byte_offset, %lhs_view {offset = 16}
  %lhs0 = concat(%lhs0_low, %lhs0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs0_low = global_load_b128_saddr %byte_offset, %rhs_view
  %rhs0_high = global_load_b128_saddr %byte_offset, %rhs_view {offset = 16}
  %rhs0 = concat(%rhs0_low, %rhs0_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %zero = v_mov_b32 0
  %zero_acc = concat(%zero, %zero, %zero, %zero, %zero, %zero, %zero, %zero) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  %zero_acc_copy = copy %zero_acc : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  low.schedule.fence
  %partial = v_wmma_f32_16x16x16_bf16 %lhs0, %rhs0, %zero_acc_copy
  low.schedule.fence
  %lhs1_low = global_load_b128_saddr %byte_offset, %lhs_view {offset = 32}
  %lhs1_high = global_load_b128_saddr %byte_offset, %lhs_view {offset = 48}
  %lhs1 = concat(%lhs1_low, %lhs1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %rhs1_low = global_load_b128_saddr %byte_offset, %rhs_view {offset = 32}
  %rhs1_high = global_load_b128_saddr %byte_offset, %rhs_view {offset = 48}
  %rhs1 = concat(%rhs1_low, %rhs1_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %partial_copy = copy %partial : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %result = v_wmma_f32_16x16x16_bf16 %lhs1, %rhs1, %partial_copy
  return %result
}

kernel.def target(@callable_matrix_target) @matrix_return() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %workitem = kernel.workitem.id<x> : index
  %workitem_i32 = index.cast %workitem : index to i32
  %lane = vector.splat %workitem_i32 : vector<1xi32>
  %result = low.invoke @matrix_sum(%lane, %lhs, %rhs) : (vector<1xi32>, buffer, buffer) -> (vector<8xf32>)
  %base_offset = index.constant 0 : offset
  %width = index.constant 8 : index
  %position = index.mul %workitem, %width : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %view = buffer.view %aligned[%base_offset] : buffer -> view<256xf32>
  vector.store %result, %view[%position] : vector<8xf32>, view<256xf32>
  kernel.return
}

check.case public @matrix_return_values {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %lhs = check.generate.fill value(1.0) : tensor<16x32xbf16>
  %rhs = check.generate.iota offset(1.0) step(1.0) period(32) : tensor<16x32xbf16>
  %output = check.generate.fill value(-1.0) : tensor<256xf32>
  %expected = check.generate.fill value(528.0) : tensor<256xf32>
  kernel.launch @matrix_return(%lhs, %rhs, %output) : (tensor<16x32xbf16>, tensor<16x32xbf16>, tensor<256xf32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<256xf32>
  check.return
}

// Each lane carries eight rows of one column. Distinct row/column products
// check the order of every returned word, not just that matrix work completed.
func.def @matrix_return_oracle(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %row_stride = index.constant 2 : index
  %width = index.constant 8 : index
  %columns = index.constant 16 : index
  %end = index.constant 32 : index
  %initial_sum = scalar.constant 0.0 : f32
  %lhs_view = buffer.view %lhs[%base] : buffer -> view<16x32xbf16>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<16x32xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<256xf32>
  scf.for %lane = [%begin to %end step %step] {
    %parity = index.div %lane, %columns : index
    %column = index.rem %lane, %columns : index
    %lane_position = index.mul %lane, %width : index
    scf.for %word = [%begin to %width step %step] {
      %even_row = index.mul %word, %row_stride : index
      %row = index.add %even_row, %parity : index
      %value = scf.for %k = [%begin to %end step %step](%sum = %initial_sum : f32) -> (f32) {
        %left = view.load %lhs_view[%row, %k] : view<16x32xbf16> -> bf16
        %right = view.load %rhs_view[%column, %k] : view<16x32xbf16> -> bf16
        %left_f32 = scalar.extf %left : bf16 to f32
        %right_f32 = scalar.extf %right : bf16 to f32
        %next = scalar.fmaf %left_f32, %right_f32, %sum : f32
        scf.yield %next : f32
      }
      %position = index.add %lane_position, %word : index
      view.store %value, %output_view[%position] : f32, view<256xf32>
    }
  }
  func.return
}

check.scenario public @matrix_return_coordinates {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(1.0) step(1.0) period(17) : tensor<16x32xbf16>
    %rhs = check.generate.iota offset(2.0) step(1.0) period(13) : tensor<16x32xbf16>
    %output = check.generate.fill value(-1.0) : tensor<256xf32>
    check.compare<@matrix_return, @matrix_return_oracle>(%lhs, %rhs, %output) : (tensor<16x32xbf16>, tensor<16x32xbf16>, tensor<256xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<256xf32>
    }
  }
  check.return
}
