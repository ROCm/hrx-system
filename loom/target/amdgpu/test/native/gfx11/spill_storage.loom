  %and39 = s_and_b64 %and38, %mask39
  %and40 = s_and_b64 %and39, %mask40
  %and41 = s_and_b64 %and40, %mask41
  %and42 = s_and_b64 %and41, %mask42
  %and43 = s_and_b64 %and42, %mask43
  %and44 = s_and_b64 %and43, %mask44
  %and45 = s_and_b64 %and44, %mask45
  %and46 = s_and_b64 %and45, %mask46
  %and47 = s_and_b64 %and46, %mask47
  %and48 = s_and_b64 %and47, %mask48
  %and49 = s_and_b64 %and48, %mask49
  %and50 = s_and_b64 %and49, %mask50
  %and51 = s_and_b64 %and50, %mask51
  %and52 = s_and_b64 %and51, %mask52
  %and53 = s_and_b64 %and52, %mask53
