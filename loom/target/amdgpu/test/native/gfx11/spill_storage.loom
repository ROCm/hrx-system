// A live comparison set exceeds the hardware SGPR budget. The locked fragment
// keeps those masks live together so automatic spill repair is exercised.
// A snapshot in a later block must keep its address as repair extends storage.
// One active lane makes a true comparison mask equal to one.

amdgpu.target<gfx11-generic> @spill_target

low.func.def schedule(locked) target<amdgpu.gfx11.generic.core>(@spill_target) @spill_snapshot(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %uniform = v_readfirstlane_b32 %input
  %bound = s_mov_b32 64
  %condition = s_cmp_lt_u32 %uniform, %bound
  low.cond_br %condition, ^body, ^exit : reg<amdgpu.scc>
^body:
  %storage = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  %limit0 = v_mov_b32 60
  %mask0 = v_cmp_lt_u32 %input, %limit0
  low.spill %mask0, %storage : reg<amdgpu.sgpr x2>, low.storage<private>
  %limit1 = v_mov_b32 1
  %mask1 = v_cmp_lt_u32 %input, %limit1
  %limit2 = v_mov_b32 2
  %mask2 = v_cmp_lt_u32 %input, %limit2
  %limit3 = v_mov_b32 3
  %mask3 = v_cmp_lt_u32 %input, %limit3
