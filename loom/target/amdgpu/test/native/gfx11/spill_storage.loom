  %and14 = s_and_b64 %and13, %mask14
  %and15 = s_and_b64 %and14, %mask15
  %and16 = s_and_b64 %and15, %mask16
  %and17 = s_and_b64 %and16, %mask17
  %and18 = s_and_b64 %and17, %mask18
  %and19 = s_and_b64 %and18, %mask19
  %and20 = s_and_b64 %and19, %mask20
  %and21 = s_and_b64 %and20, %mask21
  %and22 = s_and_b64 %and21, %mask22
  %and23 = s_and_b64 %and22, %mask23
  %and24 = s_and_b64 %and23, %mask24
  %and25 = s_and_b64 %and24, %mask25
  %and26 = s_and_b64 %and25, %mask26
  %and27 = s_and_b64 %and26, %mask27
  %and28 = s_and_b64 %and27, %mask28
  %and29 = s_and_b64 %and28, %mask29
