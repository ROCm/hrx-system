  %limit53 = v_mov_b32 53
  %mask53 = v_cmp_lt_u32 %input, %limit53
  %limit54 = v_mov_b32 54
  %mask54 = v_cmp_lt_u32 %input, %limit54
  %limit55 = v_mov_b32 55
  %mask55 = v_cmp_lt_u32 %input, %limit55
  %limit56 = v_mov_b32 56
  %mask56 = v_cmp_lt_u32 %input, %limit56
  %limit57 = v_mov_b32 57
  %mask57 = v_cmp_lt_u32 %input, %limit57
  %limit58 = v_mov_b32 58
  %mask58 = v_cmp_lt_u32 %input, %limit58
  %limit59 = v_mov_b32 59
  %mask59 = v_cmp_lt_u32 %input, %limit59
  %and1 = s_and_b64 %mask0, %mask1
  %and2 = s_and_b64 %and1, %mask2
  %and3 = s_and_b64 %and2, %mask3
  %and4 = s_and_b64 %and3, %mask4
