// GFX11 wave64 target providing the physical WMMA fragment payloads compared
// below.
amdgpu.target<gfx11-generic> @fragment_repack_gfx11_wave64 {subgroup_size = 64}

// Compare the explicit BF16 workgroup round trip used by online attention with
// the direct in-register result-to-LHS fragment repack.
kernel.def target(@fragment_repack_gfx11_wave64) @fragment_repack_roundtrip_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %fragment_origin = index.constant 0 : index
  %tile_extent = index.constant 16 : index
  %scratch_bytes = index.constant 512 : offset
  %rhs_layout = encoding.layout.strided [1, 16] : encoding<layout>
  %input_view = buffer.view %input[%base] : buffer -> view<16x16xf32>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<16x16xbf16, %rhs_layout>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xf32>
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<16x16xbf16>
  %zero_accumulator = vector.splatf 0.0 : vector<4xf32>
  %init = vector.fragment<init> %zero_accumulator shape [%tile_extent, %tile_extent] : vector<4xf32>
  %result = vector.fragment.load<result> %input_view[%fragment_origin, %fragment_origin] shape [%tile_extent, %tile_extent] : view<16x16xf32> -> vector<4xf32>
  vector.fragment.store<result> %result, %scratch_view[%fragment_origin, %fragment_origin] shape [%tile_extent, %tile_extent] : vector<4xf32>, view<16x16xbf16>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  %lhs = vector.fragment.load<lhs> %scratch_view[%fragment_origin, %fragment_origin] shape [%tile_extent, %tile_extent] : view<16x16xbf16> -> vector<16xbf16>
  %rhs_fragment = vector.fragment.load<rhs> %rhs_view[%fragment_origin, %fragment_origin] shape [%tile_extent, %tile_extent] : view<16x16xbf16, %rhs_layout> -> vector<16xbf16>
  %product = vector.mma %lhs, %rhs_fragment, %init : vector<16xbf16>, vector<16xbf16>, vector<4xf32>
  vector.fragment.store<result> %product, %output_view[%fragment_origin, %fragment_origin] shape [%tile_extent, %tile_extent] : vector<4xf32>, view<16x16xf32>
  kernel.return
}

kernel.def target(@fragment_repack_gfx11_wave64) @fragment_repack_direct_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %fragment_origin = index.constant 0 : index
  %tile_extent = index.constant 16 : index
  %rhs_layout = encoding.layout.strided [1, 16] : encoding<layout>
  %input_view = buffer.view %input[%base] : buffer -> view<16x16xf32>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<16x16xbf16, %rhs_layout>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xf32>
  %zero_accumulator = vector.splatf 0.0 : vector<4xf32>
  %init = vector.fragment<init> %zero_accumulator shape [%tile_extent, %tile_extent] : vector<4xf32>
  %result = vector.fragment.load<result> %input_view[%fragment_origin, %fragment_origin] shape [%tile_extent, %tile_extent] : view<16x16xf32> -> vector<4xf32>
  %lhs = vector.fragment.repack<lhs> %result shape [%tile_extent, %tile_extent] : vector<4xf32> -> vector<16xbf16>
  %rhs_fragment = vector.fragment.load<rhs> %rhs_view[%fragment_origin, %fragment_origin] shape [%tile_extent, %tile_extent] : view<16x16xbf16, %rhs_layout> -> vector<16xbf16>
  %product = vector.mma %lhs, %rhs_fragment, %init : vector<16xbf16>, vector<16xbf16>, vector<4xf32>
  vector.fragment.store<result> %product, %output_view[%fragment_origin, %fragment_origin] shape [%tile_extent, %tile_extent] : vector<4xf32>, view<16x16xf32>
  kernel.return
}

// These dyadic inputs make every product and partial sum exact in f32,
// independently of the native matrix instruction's accumulation order.
func.def @fragment_repack_mma_oracle(%input: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %extent = index.constant 16 : index
  %step = index.constant 1 : index
  %initial_accumulator = scalar.constant 0.0 : f32
  %rhs_layout = encoding.layout.strided [1, 16] : encoding<layout>
  %input_view = buffer.view %input[%base] : buffer -> view<16x16xf32>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<16x16xbf16, %rhs_layout>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xf32>
  scf.for %row = [%begin to %extent step %step] {
    scf.for %column = [%begin to %extent step %step] {
      %sum = scf.for %reduction = [%begin to %extent step %step](%accumulator = %initial_accumulator : f32) -> (f32) {
        %a = view.load %input_view[%row, %reduction] : view<16x16xf32> -> f32
        %narrow = scalar.fptrunc %a : f32 to bf16
        %rounded = scalar.extf %narrow : bf16 to f32
        %b = view.load %rhs_view[%reduction, %column] : view<16x16xbf16, %rhs_layout> -> bf16
        %extended = scalar.extf %b : bf16 to f32
        %next = scalar.fmaf %rounded, %extended, %accumulator : f32
        scf.yield %next : f32
      }
      view.store %sum, %output_view[%row, %column] : f32, view<16x16xf32>
    }
  }
  func.return
}

check.scenario public @fragment_repack_bf16_equivalence {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0.0) step(0.00390625) : tensor<16x16xf32>
    %rhs = check.generate.iota offset(0.5) step(0.00390625) : tensor<16x16xbf16>
    %output = check.generate.fill value(0.0) : tensor<16x16xf32>
    check.compare<@fragment_repack_direct_bf16, @fragment_repack_mma_oracle>(%input, %rhs, %output) : (tensor<16x16xf32>, tensor<16x16xbf16>, tensor<16x16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0.0) step(0.00390625) : tensor<16x16xf32>
    %rhs = check.generate.iota offset(0.5) step(0.00390625) : tensor<16x16xbf16>
    %output = check.generate.fill value(0.0) : tensor<16x16xf32>
    check.compare<@fragment_repack_roundtrip_bf16, @fragment_repack_mma_oracle>(%input, %rhs, %output) : (tensor<16x16xf32>, tensor<16x16xbf16>, tensor<16x16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x16xf32>
    }
  }
  check.return
}

// Result-to-LHS ownership is compared against scalar VM conversion.
amdgpu.target<gfx11-generic> @repack_wave32 {subgroup_size = 32}

kernel.def target(@repack_wave32) @repack_coordinates_wave32() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %source = buffer.view %input[%base] : buffer -> view<16x16xf32>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  %value = vector.fragment.load<result> %source[0, 0] shape [%extent, %extent] : view<16x16xf32> -> vector<8xf32>
  %lhs = vector.fragment.repack<lhs> %value shape [%extent, %extent] : vector<8xf32> -> vector<16xbf16>
  vector.fragment.store<lhs> %lhs, %destination[0, 0] shape [%extent, %extent] : vector<16xbf16>, view<16x16xbf16>
  kernel.return
}

kernel.def target(@fragment_repack_gfx11_wave64) @repack_coordinates_wave64() {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %source = buffer.view %input[%base] : buffer -> view<16x16xf32>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  %value = vector.fragment.load<result> %source[0, 0] shape [%extent, %extent] : view<16x16xf32> -> vector<4xf32>
  %lhs = vector.fragment.repack<lhs> %value shape [%extent, %extent] : vector<4xf32> -> vector<16xbf16>
  vector.fragment.store<lhs> %lhs, %destination[0, 0] shape [%extent, %extent] : vector<16xbf16>, view<16x16xbf16>
  kernel.return
}

func.def @repack_coordinates_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %extent = index.constant 16 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<16x16xf32>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  scf.for %row = [%begin to %extent step %step] {
    scf.for %column = [%begin to %extent step %step] {
      %value = view.load %source[%row, %column] : view<16x16xf32> -> f32
      %narrow = scalar.fptrunc %value : f32 to bf16
      view.store %narrow, %destination[%row, %column] : bf16, view<16x16xbf16>
    }
  }
  func.return
}

check.scenario public @repack_coordinates_wave32_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-16.0 to 16.0) : tensor<16x16xf32>
    %output = check.generate.fill value(0.0) : tensor<16x16xbf16>
    check.compare<@repack_coordinates_wave32, @repack_coordinates_oracle>(%input, %output) : (tensor<16x16xf32>, tensor<16x16xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x16xbf16>
    }
  }
  check.return
}

check.scenario public @repack_coordinates_wave64_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-16.0 to 16.0) : tensor<16x16xf32>
    %output = check.generate.fill value(0.0) : tensor<16x16xbf16>
    check.compare<@repack_coordinates_wave64, @repack_coordinates_oracle>(%input, %output) : (tensor<16x16xf32>, tensor<16x16xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x16xbf16>
    }
  }
  check.return
}
