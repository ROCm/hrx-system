kernel.def target(@broadcast_gfx11) @fragment_broadcast_fp8() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%row_stride_input: index, %column_stride_input: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %row_stride = index.assume %row_stride_input [range(%row_stride_input, 0, 16)] : index
  %column_stride = index.assume %column_stride_input [range(%column_stride_input, 0, 16)] : index
