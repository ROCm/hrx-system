func.def @fragment_broadcast_fp8_oracle(%row_stride_input: index, %column_stride_input: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %extent = index.constant 16 : index
  %row_stride = index.assume %row_stride_input [range(%row_stride_input, 0, 16)] : index
  %column_stride = index.assume %column_stride_input [range(%column_stride_input, 0, 16)] : index
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %source = buffer.view %input[%base] : buffer -> view<16x16xf8E4M3, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  scf.for %row = [%begin to %extent step %step] {
    scf.for %column = [%begin to %extent step %step] {
      %stored = view.load %source[%row, %column] : view<16x16xf8E4M3, %layout> -> f8E4M3
      %value = scalar.extf %stored : f8E4M3 to bf16
      view.store %value, %destination[%row, %column] : bf16, view<16x16xbf16>
    }
  }
  func.return
}

check.scenario public @fragment_broadcast_fp8_values configure[4](%row_stride: index, %configuration_entropy: check.entropy) {
  check.trial[4](%column_stride: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%column_stride] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-16.0 to 16.0) : tensor<512xf8E4M3>
    %output = check.generate.fill value(0.0) : tensor<16x16xbf16>
    check.compare<@fragment_broadcast_fp8, @fragment_broadcast_fp8_oracle>(%row_stride, %column_stride, %input, %output) : (index, index, tensor<512xf8E4M3>, tensor<16x16xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x16xbf16>
    }
  }
  check.return
}

// One source byte is sufficient for a scalar broadcast, including conversion.
// A negative BF8 subnormal also distinguishes decoding from integer replication.
kernel.def target(@broadcast_gfx11) @fragment_broadcast_bf8_scalar() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %layout = encoding.layout.strided [0, 0] : encoding<layout>
  %schema = encoding.define #encoding.operand<element_format=f8e5m2, payload_elements=16, payload_registers=4, rounding=finite_only> : encoding<schema>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %source = buffer.view %input[%base] : buffer -> view<16x16xf8E5M2, %storage>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf16>
  %value = vector.fragment.load<rhs> %source[0, 0] shape [%extent, %extent] : view<16x16xf8E5M2, %storage> -> vector<16xf16>
  vector.fragment.store<rhs> %value, %destination[0, 0] shape [%extent, %extent] : vector<16xf16>, view<16x16xf16>
  kernel.return
}

func.def @fragment_broadcast_bf8_scalar_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %extent = index.constant 16 : index
  %source = buffer.view %input[%base] : buffer -> view<1xf8E5M2>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf16>
  %stored = view.load %source[0] : view<1xf8E5M2> -> f8E5M2
  %value = scalar.extf %stored : f8E5M2 to f16
  scf.for %row = [%begin to %extent step %step] {
    scf.for %column = [%begin to %extent step %step] {
      view.store %value, %destination[%row, %column] : f16, view<16x16xf16>
    }
  }
  func.return
}

check.scenario public @fragment_broadcast_bf8_scalar_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-1.52587890625e-05) : tensor<1xf8E5M2>
    %output = check.generate.fill value(0.0) : tensor<16x16xf16>
    check.compare<@fragment_broadcast_bf8_scalar, @fragment_broadcast_bf8_scalar_oracle>(%input, %output) : (tensor<1xf8E5M2>, tensor<16x16xf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x16xf16>
    }
  }
  check.return
}
