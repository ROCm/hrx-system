  %source = buffer.view %input[%base] : buffer -> view<16x16xf8E4M3, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xbf16>
  %value = vector.fragment.load<rhs> %source[0, 0] shape [%extent, %extent] : view<16x16xf8E4M3, %layout> -> vector<16xbf16>
  vector.fragment.store<rhs> %value, %destination[0, 0] shape [%extent, %extent] : vector<16xbf16>, view<16x16xbf16>
  kernel.return
