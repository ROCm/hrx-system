// Native matrix fragments with repeated or independently strided addresses.
// Scalar VM oracles read logical coordinates without lane/register mappings.
// Static sources have exact physical extents, and workgroup cases stage data
// before fragment reads so address and thread instrumentation cover both paths.

amdgpu.target<gfx11-generic> @broadcast_gfx11 {subgroup_size = 32}

kernel.def target(@broadcast_gfx11) @result_column() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %layout = encoding.layout.strided [0, 1] : encoding<layout>
  %output_layout = encoding.layout.strided [16, 1] : encoding<layout>
  %source = buffer.view %input[%base] : buffer -> view<16x16xf32, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf32, %output_layout>
  %value = vector.fragment.load<result> %source[0, 0] shape [%extent, %extent] : view<16x16xf32, %layout> -> vector<8xf32>
  vector.fragment.store<result> %value, %destination[0, 0] shape [%extent, %extent] : vector<8xf32>, view<16x16xf32, %output_layout>
  kernel.return
}

func.def @result_column_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %layout = encoding.layout.strided [0, 1] : encoding<layout>
  %output_layout = encoding.layout.strided [16, 1] : encoding<layout>
  %source = buffer.view %input[%base] : buffer -> view<16x16xf32, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf32, %output_layout>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %row = [%begin to %extent step %step] {
    scf.for %column = [%begin to %extent step %step] {
      %value = view.load %source[%row, %column] : view<16x16xf32, %layout> -> f32
      view.store %value, %destination[%row, %column] : f32, view<16x16xf32, %output_layout>
    }
  }
  func.return
}

check.scenario public @result_column_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1.0) step(1.0) : tensor<16xf32>
    %output = check.generate.fill value(0.0) : tensor<16x16xf32>
    check.compare<@result_column, @result_column_oracle>(%input, %output) : (tensor<16xf32>, tensor<16x16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x16xf32>
    }
  }
  check.return
}

kernel.def target(@broadcast_gfx11) @lhs_f16_row() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %layout = encoding.layout.strided [1, 0] : encoding<layout>
  %output_layout = encoding.layout.strided [16, 1] : encoding<layout>
  %binding = buffer.assume.memory_space<descriptor> %input : buffer
  %source = buffer.view %binding[%base] : buffer -> view<16x16xf16, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf16, %output_layout>
  %value = vector.fragment.load<lhs> %source[0, 0] shape [%extent, %extent] : view<16x16xf16, %layout> -> vector<16xf16>
  vector.fragment.store<lhs> %value, %destination[0, 0] shape [%extent, %extent] : vector<16xf16>, view<16x16xf16, %output_layout>
  kernel.return
}

