kernel.def target(@broadcast_gfx11) @fragment_broadcast_f32() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%row_stride_input: index, %column_stride_input: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %row_stride = index.assume %row_stride_input [range(%row_stride_input, 0, 16)] : index
  %column_stride = index.assume %column_stride_input [range(%column_stride_input, 0, 16)] : index
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %source = buffer.view %input[%base] : buffer -> view<16x16xf32, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf32>
  %value = vector.fragment.load<result> %source[0, 0] shape [%extent, %extent] : view<16x16xf32, %layout> -> vector<8xf32>
  vector.fragment.store<result> %value, %destination[0, 0] shape [%extent, %extent] : vector<8xf32>, view<16x16xf32>
  kernel.return
}

func.def @fragment_broadcast_f32_oracle(%row_stride_input: index, %column_stride_input: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %extent = index.constant 16 : index
  %row_stride = index.assume %row_stride_input [range(%row_stride_input, 0, 16)] : index
  %column_stride = index.assume %column_stride_input [range(%column_stride_input, 0, 16)] : index
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %source = buffer.view %input[%base] : buffer -> view<16x16xf32, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf32>
  scf.for %row = [%begin to %extent step %step] {
    scf.for %column = [%begin to %extent step %step] {
      %value = view.load %source[%row, %column] : view<16x16xf32, %layout> -> f32
      view.store %value, %destination[%row, %column] : f32, view<16x16xf32>
    }
  }
  func.return
}

check.scenario public @fragment_broadcast_f32_values configure[4](%row_stride: index, %configuration_entropy: check.entropy) {
  check.trial[4](%column_stride: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%column_stride] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-16.0 to 16.0) : tensor<512xf32>
    %output = check.generate.fill value(0.0) : tensor<16x16xf32>
    check.compare<@fragment_broadcast_f32, @fragment_broadcast_f32_oracle>(%row_stride, %column_stride, %input, %output) : (index, index, tensor<512xf32>, tensor<16x16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x16xf32>
    }
  }
  check.return
}

kernel.def target(@broadcast_gfx11) @fragment_broadcast_f16() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%row_stride_input: index, %column_stride_input: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %extent = index.constant 16 : index
  %row_stride = index.assume %row_stride_input [range(%row_stride_input, 0, 16)] : index
  %column_stride = index.assume %column_stride_input [range(%column_stride_input, 0, 16)] : index
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf16>
  %count = index.constant 512 : index
  %threads = index.constant 32 : index
  %bytes = index.constant 1024 : offset
  %shared = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dense_input = buffer.view %input[%base] : buffer -> view<512xf16>
  %dense_shared = buffer.view %shared[%base] : buffer -> view<512xf16>
  %lane = kernel.subgroup.lane.id : index
  scf.for %position = [%lane to %count step %threads] {
    %value = view.load %dense_input[%position] : view<512xf16> -> f16
    view.store %value, %dense_shared[%position] : f16, view<512xf16>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %shared_source = buffer.view %shared[%base] : buffer -> view<16x16xf16, %layout>
  %value = vector.fragment.load<lhs> %shared_source[0, 0] shape [%extent, %extent] : view<16x16xf16, %layout> -> vector<16xf16>
  vector.fragment.store<lhs> %value, %destination[0, 0] shape [%extent, %extent] : vector<16xf16>, view<16x16xf16>
  kernel.return
}

func.def @fragment_broadcast_f16_oracle(%row_stride_input: index, %column_stride_input: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %extent = index.constant 16 : index
  %row_stride = index.assume %row_stride_input [range(%row_stride_input, 0, 16)] : index
  %column_stride = index.assume %column_stride_input [range(%column_stride_input, 0, 16)] : index
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %source = buffer.view %input[%base] : buffer -> view<16x16xf16, %layout>
  %destination = buffer.view %output[%base] : buffer -> view<16x16xf16>
  scf.for %row = [%begin to %extent step %step] {
    scf.for %column = [%begin to %extent step %step] {
      %value = view.load %source[%row, %column] : view<16x16xf16, %layout> -> f16
      view.store %value, %destination[%row, %column] : f16, view<16x16xf16>
    }
  }
  func.return
}

check.scenario public @fragment_broadcast_f16_values configure[4](%row_stride: index, %configuration_entropy: check.entropy) {
  check.trial[4](%column_stride: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%column_stride] : check.entropy -> i64
