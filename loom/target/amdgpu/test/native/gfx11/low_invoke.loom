// A target-Low schedule fragment invoked from an otherwise High kernel. The
// helper is authored once against the gfx11 family contract; AMDGPU policy
// flattens its Low call before scheduling and register allocation.

amdgpu.target<gfx11-generic> @low_invoke_target

low.func.def schedule(locked) target<amdgpu.gfx11.generic.core>(@low_invoke_target) @low_invoke_pack_pair(%even: reg<amdgpu.vgpr x2>, %odd: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>) asm {
  %even0 = slice %even[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %even1 = slice %even[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %odd0 = slice %odd[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %odd1 = slice %odd[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %selector0 = s_mov_b32 84148480
  %selector1 = s_mov_b32 117834498
  %packed0 = v_perm_b32 %odd0, %even0, %selector0
  %packed1 = v_perm_b32 %odd1, %even1, %selector0
  %packed2 = v_perm_b32 %odd0, %even0, %selector1
  %packed3 = v_perm_b32 %odd1, %even1, %selector1
  %packed = concat(%packed0, %packed1, %packed2, %packed3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %packed
}

kernel.def target(@low_invoke_target) @low_invoke_pack_pair_kernel() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %input = buffer.view %input_buffer[%base] : buffer -> view<8xf16>
  %output = buffer.view %output_buffer[%base] : buffer -> view<8xf16>
  %even = vector.load %input[%c0] : view<8xf16> -> vector<4xf16>
  %odd = vector.load %input[%c4] : view<8xf16> -> vector<4xf16>
  %packed = low.invoke @low_invoke_pack_pair(%even, %odd) : (vector<4xf16>, vector<4xf16>) -> (vector<8xf16>)
  vector.store %packed, %output[%c0] : vector<8xf16>, view<8xf16>
  kernel.return
}

check.case public @low_invoke_pack_pair_case {
  // The byte selectors interleave [1, 3, 2, 4] with [5, 7, 6, 8].
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<8xf16>
  %output = check.generate.fill value(0.0) : tensor<8xf16>
  kernel.launch @low_invoke_pack_pair_kernel(%input, %output) : (tensor<8xf16>, tensor<8xf16>)
  %pair0 = check.tensor.view %output offset(0) : tensor<8xf16> -> tensor<2xf16>
  %expected0 = check.generate.iota offset(1.0) step(4.0) : tensor<2xf16>
  check.expect.equal actual(%pair0) expected(%expected0) : tensor<2xf16>
  %pair1 = check.tensor.view %output offset(4) : tensor<8xf16> -> tensor<2xf16>
  %expected1 = check.generate.iota offset(3.0) step(4.0) : tensor<2xf16>
  check.expect.equal actual(%pair1) expected(%expected1) : tensor<2xf16>
  %pair2 = check.tensor.view %output offset(8) : tensor<8xf16> -> tensor<2xf16>
  %expected2 = check.generate.iota offset(2.0) step(4.0) : tensor<2xf16>
  check.expect.equal actual(%pair2) expected(%expected2) : tensor<2xf16>
  %pair3 = check.tensor.view %output offset(12) : tensor<8xf16> -> tensor<2xf16>
  %expected3 = check.generate.iota offset(4.0) step(4.0) : tensor<2xf16>
  check.expect.equal actual(%pair3) expected(%expected3) : tensor<2xf16>
  check.return
}

// Schedule-free helpers are the maintained low.invoke path. Their packets
// participate in normal scheduling with the surrounding source operations.
low.func.def target<amdgpu.gfx11.generic.core>(@low_invoke_target) @low_invoke_schedule_free_pack_pair(%even: reg<amdgpu.vgpr x2>, %odd: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>) asm {
  %even0 = slice %even[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %even1 = slice %even[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %odd0 = slice %odd[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %odd1 = slice %odd[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %selector0 = s_mov_b32 84148480
  %selector1 = s_mov_b32 117834498
  %packed0 = v_perm_b32 %odd0, %even0, %selector0
  %packed1 = v_perm_b32 %odd1, %even1, %selector0
  %packed2 = v_perm_b32 %odd0, %even0, %selector1
  %packed3 = v_perm_b32 %odd1, %even1, %selector1
  %packed = concat(%packed0, %packed1, %packed2, %packed3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %packed
}

kernel.def target(@low_invoke_target) @low_invoke_schedule_free_pack_pair_kernel() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %input = buffer.view %input_buffer[%base] : buffer -> view<8xf16>
  %output = buffer.view %output_buffer[%base] : buffer -> view<8xf16>
  %even = vector.load %input[%c0] : view<8xf16> -> vector<4xf16>
  %odd = vector.load %input[%c4] : view<8xf16> -> vector<4xf16>
  %packed = low.invoke @low_invoke_schedule_free_pack_pair(%even, %odd) : (vector<4xf16>, vector<4xf16>) -> (vector<8xf16>)
  vector.store %packed, %output[%c0] : vector<8xf16>, view<8xf16>
  kernel.return
}

check.case public @low_invoke_schedule_free_pack_pair_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<8xf16>
  %output = check.generate.fill value(0.0) : tensor<8xf16>
  kernel.launch @low_invoke_schedule_free_pack_pair_kernel(%input, %output) : (tensor<8xf16>, tensor<8xf16>)
  %pair0 = check.tensor.view %output offset(0) : tensor<8xf16> -> tensor<2xf16>
  %expected0 = check.generate.iota offset(1.0) step(4.0) : tensor<2xf16>
  check.expect.equal actual(%pair0) expected(%expected0) : tensor<2xf16>
  %pair1 = check.tensor.view %output offset(4) : tensor<8xf16> -> tensor<2xf16>
  %expected1 = check.generate.iota offset(3.0) step(4.0) : tensor<2xf16>
  check.expect.equal actual(%pair1) expected(%expected1) : tensor<2xf16>
  %pair2 = check.tensor.view %output offset(8) : tensor<8xf16> -> tensor<2xf16>
  %expected2 = check.generate.iota offset(2.0) step(4.0) : tensor<2xf16>
  check.expect.equal actual(%pair2) expected(%expected2) : tensor<2xf16>
  %pair3 = check.tensor.view %output offset(12) : tensor<8xf16> -> tensor<2xf16>
  %expected3 = check.generate.iota offset(4.0) step(4.0) : tensor<2xf16>
  check.expect.equal actual(%pair3) expected(%expected3) : tensor<2xf16>
  check.return
}

// The AMDGPU target policy flattens this ordinary Low call before emission.
// Its branch and block argument exercise CFG composition through the default
// source-to-Low pipeline without requiring a locked schedule.
low.func.def target<amdgpu.gfx11.generic.core>(@low_invoke_target) @low_invoke_cfg_identity(%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  low.br ^exit(%value: reg<amdgpu.vgpr>)
^exit(%forwarded: reg<amdgpu.vgpr>):
  return %forwarded
}

kernel.def target(@low_invoke_target) @low_invoke_cfg_identity_kernel() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  %source, %destination = buffer.assume.noalias %input_buffer, %output_buffer : buffer, buffer
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %input = buffer.view %source[%base] : buffer -> view<1xi32>
  %output = buffer.view %destination[%base] : buffer -> view<1xi32>
  %value = vector.load %input[%c0] : view<1xi32> -> vector<1xi32>
  %forwarded = low.invoke @low_invoke_cfg_identity(%value) : (vector<1xi32>) -> (vector<1xi32>)
  vector.store %forwarded, %output[%c0] : vector<1xi32>, view<1xi32>
  kernel.return
}

check.case public @low_invoke_cfg_identity_case {
  %input = check.generate.fill value(37) : tensor<1xi32>
  %output = check.generate.fill value(0) : tensor<1xi32>
  %expected = check.generate.fill value(37) : tensor<1xi32>
  kernel.launch @low_invoke_cfg_identity_kernel(%input, %output) : (tensor<1xi32>, tensor<1xi32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<1xi32>
  check.return
}

// Scalar native calls share a vector-carried recurrence. A packed native call
// transports an odd tail, and a scalar predicate call observes active lanes.
low.func.def noinline target<amdgpu.gfx11.generic.core> @low_invoke_scalar_flip(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %sign_bit = s_mov_b32 2147483648
  %result = s_xor_b32 %value, %sign_bit
  return %result
}

low.func.def target<amdgpu.gfx11.generic.core> @low_invoke_scalar_packet(%value: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  return %value
}

low.func.def target<amdgpu.gfx11.generic.core> @low_invoke_scalar_truth(%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  return %value
}

low.func.def target<amdgpu.gfx11.generic.core> @low_invoke_condition_word(%condition: reg<amdgpu.scc>) -> (reg<amdgpu.sgpr>) asm {
  %false = s_mov_b32 0
  %true = s_mov_b32 1
  %word = s_cselect_b32 %true, %false, %condition
  return %word
}

func.def inline @low_invoke_argument_body(%initial: f32, %word: i16, %tail: i16, %count: index, %float_buffer: buffer, %packed_buffer: buffer, %truth_buffer: buffer, %condition_buffer: buffer) {
  %stride = index.constant 8 : index
  %first_active = index.mul %count, %stride : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %count step %step](%value = %initial : f32) -> (f32) {
    %next = low.invoke @low_invoke_scalar_flip(%value) : (f32) -> (f32)
    scf.yield %next : f32
  }
  %splat = vector.splat %word : vector<3xi16>
  %packet = vector.insert %tail into %splat[2] : i16, vector<3xi16>
  %packed = low.invoke @low_invoke_scalar_packet(%packet) : (vector<3xi16>) -> (vector<3xi16>)
  %origin = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %floats = buffer.view %float_buffer[%origin] : buffer -> view<64xf32>
  %packets = buffer.view %packed_buffer[%origin] : buffer -> view<64x4xi16>
  %truth = buffer.view %truth_buffer[%origin] : buffer -> view<64xi32>
  %conditions = buffer.view %condition_buffer[%origin] : buffer -> view<64xi32>
  view.store %result, %floats[%lane] : f32, view<64xf32>
  vector.store %packed, %packets[%lane, 0] : vector<3xi16>, view<64x4xi16>
  %threshold = scalar.constant 0.0 : f32
  %positive = scalar.cmpf ogt, %result, %threshold : f32
  %active = index.cmp sge, %lane, %first_active : index
  scf.if %active {
    %true = scalar.constant true : i1
    %inverted = scalar.xori %positive, %true : i1
    %flag = low.invoke @low_invoke_scalar_truth(%inverted) : (i1) -> (i32)
    %condition_truth = low.invoke @low_invoke_condition_word(%inverted) : (i1) -> (i1)
    %condition = low.invoke @low_invoke_condition_word(%condition_truth) : (i1) -> (i32)
    view.store %condition, %conditions[%lane] : i32, view<64xi32>
    view.store %flag, %truth[%lane] : i32, view<64xi32>
  }
  func.return
}

amdgpu.target<gfx11-generic> @low_invoke_wave32 {subgroup_size = 32}

kernel.def target(@low_invoke_wave32) @low_invoke_argument_wave32() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%initial: f32, %word: i16, %tail: i16, %count: index, %float_buffer: buffer, %packed_buffer: buffer, %truth_buffer: buffer, %condition_buffer: buffer) {
  func.call @low_invoke_argument_body(%initial, %word, %tail, %count, %float_buffer, %packed_buffer, %truth_buffer, %condition_buffer) : (f32, i16, i16, index, buffer, buffer, buffer, buffer)
  kernel.return
}

amdgpu.target<gfx11-generic> @low_invoke_wave64 {subgroup_size = 64}

kernel.def target(@low_invoke_wave64) @low_invoke_argument_wave64() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%initial: f32, %word: i16, %tail: i16, %count: index, %float_buffer: buffer, %packed_buffer: buffer, %truth_buffer: buffer, %condition_buffer: buffer) {
  func.call @low_invoke_argument_body(%initial, %word, %tail, %count, %float_buffer, %packed_buffer, %truth_buffer, %condition_buffer) : (f32, i16, i16, index, buffer, buffer, buffer, buffer)
  kernel.return
}

// Parity is an independent closed form for repeated sign flips. Scalar stores
// independently check packed element order, the untouched tail, and inactive
// output lanes without invoking any native helper in the VM oracle.
func.def @low_invoke_argument_oracle(%initial: f32, %word: i16, %tail: i16, %count: index, %float_buffer: buffer, %packed_buffer: buffer, %truth_buffer: buffer, %condition_buffer: buffer) {
  %stride = index.constant 8 : index
  %first_active = index.mul %count, %stride : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 64 : index
  %parity = index.andi %count, %step : index
  %odd = index.cmp ne, %parity, %begin : index
  %negated = scalar.negf %initial : f32
  %expected = scf.select %odd, %negated, %initial : f32
  %flag = index.cast %parity : index to i32
  %origin = index.constant 0 : offset
  %floats = buffer.view %float_buffer[%origin] : buffer -> view<64xf32>
  %packets = buffer.view %packed_buffer[%origin] : buffer -> view<64x4xi16>
  %truth = buffer.view %truth_buffer[%origin] : buffer -> view<64xi32>
  %conditions = buffer.view %condition_buffer[%origin] : buffer -> view<64xi32>
  scf.for %lane = [%begin to %end step %step] {
    view.store %expected, %floats[%lane] : f32, view<64xf32>
    view.store %word, %packets[%lane, 0] : i16, view<64x4xi16>
    view.store %word, %packets[%lane, 1] : i16, view<64x4xi16>
    view.store %tail, %packets[%lane, 2] : i16, view<64x4xi16>
    %active = index.cmp sge, %lane, %first_active : index
    scf.if %active {
      view.store %flag, %truth[%lane] : i32, view<64xi32>
      view.store %flag, %conditions[%lane] : i32, view<64xi32>
    }
  }
  func.return
}

check.scenario public @low_invoke_argument_wave32_values {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(2.5) : f32
    %word = check.literal value(-129) : i16
    %tail = check.literal value(12345) : i16
    %floats = check.generate.fill value(-99.0) : tensor<64xf32>
    %packets = check.generate.fill value(32765) : tensor<64x4xi16>
    %truth = check.generate.fill value(-1) : tensor<64xi32>
    %conditions = check.generate.fill value(-2) : tensor<64xi32>
    check.compare<@low_invoke_argument_wave32, @low_invoke_argument_oracle>(%initial, %word, %tail, %trial, %floats, %packets, %truth, %conditions) : (f32, i16, i16, index, tensor<64xf32>, tensor<64x4xi16>, tensor<64xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%floats) expected(%floats) : tensor<64xf32>
      check.expect.bitwise actual(%packets) expected(%packets) : tensor<64x4xi16>
      check.expect.bitwise actual(%truth) expected(%truth) : tensor<64xi32>
      check.expect.bitwise actual(%conditions) expected(%conditions) : tensor<64xi32>
    }
  }
  check.return
}

check.scenario public @low_invoke_argument_wave64_values {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(2.5) : f32
    %word = check.literal value(-129) : i16
    %tail = check.literal value(12345) : i16
    %floats = check.generate.fill value(-99.0) : tensor<64xf32>
    %packets = check.generate.fill value(32765) : tensor<64x4xi16>
    %truth = check.generate.fill value(-1) : tensor<64xi32>
    %conditions = check.generate.fill value(-2) : tensor<64xi32>
    check.compare<@low_invoke_argument_wave64, @low_invoke_argument_oracle>(%initial, %word, %tail, %trial, %floats, %packets, %truth, %conditions) : (f32, i16, i16, index, tensor<64xf32>, tensor<64x4xi16>, tensor<64xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%floats) expected(%floats) : tensor<64xf32>
      check.expect.bitwise actual(%packets) expected(%packets) : tensor<64x4xi16>
      check.expect.bitwise actual(%truth) expected(%truth) : tensor<64xi32>
      check.expect.bitwise actual(%conditions) expected(%conditions) : tensor<64xi32>
    }
  }
  check.return
}
