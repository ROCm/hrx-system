check.case public @duplicate_ids {
  %ids = check.generate.fill value(2) : tensor<8xi32>
  %payloads = check.generate.iota offset(1.0) step(1.0) : tensor<8xf32>
  %output = check.generate.fill value(-1.0) : tensor<1xf32>
  %initial = check.literal value(3.0) : f32
