    data = [":gfx11_test_module"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS,
    target_compatible_with = _GFX11_COMPATIBLE_WITH + loom_config_compatible_with([
        "//runtime/config/hal:driver_amd_gpu",
