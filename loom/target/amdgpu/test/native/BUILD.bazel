    "//loom/target/amdgpu:execution_profiles.bzl",
    "AMD_GPU_ACCESS_PROFILE",
    "AMD_GPU_HARDWARE_PROFILE",
    "AMD_GPU_TSAN_PROFILE",
)
load(":workload_catalog.bzl", "AMDGPU_WORKLOAD_CORPUS")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_EXECUTION_TAGS = [
    "iree-run-requirement=libamdf.resource.amd_gpu",
]

_GENERIC_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

_AMDGPU_SOURCE_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/arch:amdgpu",
])

_GFX11_GENERIC_REPRESENTATION = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"]

_GFX11_ARTIFACT_COMPATIBLE_WITH = loom_amdgpu_descriptor_set_compatible_with(
    _GFX11_GENERIC_REPRESENTATION,
)

_GFX11_COMPATIBLE_WITH = (
    _GENERIC_COMPATIBLE_WITH +
    _GFX11_ARTIFACT_COMPATIBLE_WITH +
    loom_amdgpu_iree_hal_representation_compatible_with(
        _GFX11_GENERIC_REPRESENTATION,
    )
)

_CDNA4_REPRESENTATION = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.cdna4.core"]

_CDNA4_ARTIFACT_COMPATIBLE_WITH = (
    _AMDGPU_SOURCE_COMPATIBLE_WITH +
    loom_amdgpu_descriptor_set_compatible_with(
        _CDNA4_REPRESENTATION,
    )
)

_CDNA4_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
    "//loom/config/arch/amdgpu:iree_hal_descriptor_set_cdna4_core",
])

