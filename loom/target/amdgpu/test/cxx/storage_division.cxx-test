// RUN: emit source-low @update target=amdgpu:gfx1151 output=none
// Narrow storage updates widen through signed constant division.
int update(signed char* bytes) { return bytes[0] /= 3; }

// ====
// An explicit load/update/store control uses the same signed quotient.
int update(signed char* bytes) {
  int value = bytes[0];
  value = value / 3;
  bytes[0] = value;
  return value;
}
