// RUN: emit source-low @copy_block target=amdgpu:gfx1151 output=low
// Kernel parameters retain explicit pointer-address contracts at entry.
using Words = unsigned __attribute__((vector_size(64)));
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void copy_block([[loom::assume_aligned(64)]] const unsigned* input,
                [[loom::assume_aligned(64)]] unsigned* output) {
  *reinterpret_cast<Words*>(output) =
      *reinterpret_cast<const Words*>(input + 16);
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @copy_block() asm {
  %input = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 64, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %27 = s_mov_b32 0
  %28 = s_load_dwordx4 %input, %27 {offset = 64}
  %29 = slice %28[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %30 = v_mov_b32_copy %29
  %31 = slice %28[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %32 = v_mov_b32_copy %31
  %33 = slice %28[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %34 = v_mov_b32_copy %33
  %35 = slice %28[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %36 = v_mov_b32_copy %35
  %37 = concat(%30, %32, %34, %36) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %38 = s_load_dwordx4 %input, %27 {offset = 80}
  %39 = slice %38[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %40 = v_mov_b32_copy %39
  %41 = slice %38[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %42 = v_mov_b32_copy %41
  %43 = slice %38[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %44 = v_mov_b32_copy %43
  %45 = slice %38[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %46 = v_mov_b32_copy %45
  %47 = concat(%40, %42, %44, %46) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %48 = s_load_dwordx4 %input, %27 {offset = 96}
  %49 = slice %48[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %50 = v_mov_b32_copy %49
  %51 = slice %48[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %52 = v_mov_b32_copy %51
  %53 = slice %48[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %54 = v_mov_b32_copy %53
  %55 = slice %48[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %56 = v_mov_b32_copy %55
  %57 = concat(%50, %52, %54, %56) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %58 = s_load_dwordx4 %input, %27 {offset = 112}
  %59 = slice %58[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %60 = v_mov_b32_copy %59
  %61 = slice %58[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %62 = v_mov_b32_copy %61
  %63 = slice %58[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %64 = v_mov_b32_copy %63
  %65 = slice %58[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %66 = v_mov_b32_copy %65
  %67 = concat(%60, %62, %64, %66) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %70 = v_mov_b32 0
  global_store_b128_saddr %70, %37, %output
  global_store_b128_saddr %70, %47, %output {offset = 16}
  global_store_b128_saddr %70, %57, %output {offset = 32}
  global_store_b128_saddr %70, %67, %output {offset = 48}
  return
}
