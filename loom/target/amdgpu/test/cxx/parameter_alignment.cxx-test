// RUN: emit source-low @copy_block target=amdgpu:gfx1151 output=low
// Kernel parameters retain explicit pointer-address contracts at entry.
using Words = unsigned __attribute__((vector_size(64)));
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void copy_block([[loom::assume_aligned(64)]] const unsigned* input,
                [[loom::assume_aligned(64)]] unsigned* output) {
  *reinterpret_cast<Words*>(output) =
      *reinterpret_cast<const Words*>(input + 16);
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @copy_block() asm {
  %input = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 64, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %23 = s_mov_b32 0
  %24 = s_load_dwordx4 %input, %23 {offset = 64}
  %25 = slice %24[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %26 = v_mov_b32_copy %25
  %27 = slice %24[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %28 = v_mov_b32_copy %27
  %29 = slice %24[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %30 = v_mov_b32_copy %29
  %31 = slice %24[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %32 = v_mov_b32_copy %31
  %33 = concat(%26, %28, %30, %32) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %34 = s_load_dwordx4 %input, %23 {offset = 80}
  %35 = slice %34[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %36 = v_mov_b32_copy %35
  %37 = slice %34[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %38 = v_mov_b32_copy %37
  %39 = slice %34[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %40 = v_mov_b32_copy %39
  %41 = slice %34[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %42 = v_mov_b32_copy %41
  %43 = concat(%36, %38, %40, %42) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %44 = s_load_dwordx4 %input, %23 {offset = 96}
  %45 = slice %44[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %46 = v_mov_b32_copy %45
  %47 = slice %44[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %48 = v_mov_b32_copy %47
  %49 = slice %44[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %50 = v_mov_b32_copy %49
  %51 = slice %44[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %52 = v_mov_b32_copy %51
  %53 = concat(%46, %48, %50, %52) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %54 = s_load_dwordx4 %input, %23 {offset = 112}
  %55 = slice %54[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %56 = v_mov_b32_copy %55
  %57 = slice %54[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %58 = v_mov_b32_copy %57
  %59 = slice %54[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %60 = v_mov_b32_copy %59
  %61 = slice %54[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %62 = v_mov_b32_copy %61
  %63 = concat(%56, %58, %60, %62) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %66 = v_mov_b32 0
  global_store_b128_saddr %66, %33, %output
  global_store_b128_saddr %66, %43, %output {offset = 16}
  global_store_b128_saddr %66, %53, %output {offset = 32}
  global_store_b128_saddr %66, %63, %output {offset = 48}
  return
}
