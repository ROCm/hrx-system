// RUN: emit source-low @lookup target=amdgpu:gfx1151 output=low

#include <loomcxx/kernel.h>

using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
using Codes4 = signed char __attribute__((ext_vector_type(4)));
using Codebook16 = signed char __attribute__((ext_vector_type(16)));

static Codes4 lookup_indexed(Codebook16 table, Bytes4 indices) {
  return {table[indices[0]], table[indices[1]], table[indices[2]],
          table[indices[3]]};
}

// Source restrict paths keep the uniform codebook stable across loop-carried
// output writes. Facts from the caller then recover packed indices after
// helper inlining, reaching three byte permutes without a target intrinsic.
[[loom::kernel, loom::workgroup_size(32, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void lookup(
    const Bytes4* __restrict__ input,
    [[loom::assume_aligned(64)]] const Codebook16* __restrict__ codebook,
    Codes4* __restrict__ output) {
  unsigned position = loom::kernel::workitem::id.x;
  for (unsigned packet = 0; packet < 2; ++packet) {
    unsigned packet_position = position * 2 + packet;
    Bytes4 indices = input[packet_position] & 15;
    output[packet_position] = lookup_indexed(*codebook, indices);
  }
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @lookup() asm {
  %workitem_id_x = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %codebook = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %107 = v_lshlrev_b32_src0_inline %workitem_id_x, 3
  %108 = s_mov_b32 0
  %109 = s_mov_b32 2
  %110 = s_mov_b32 1
  %111 = v_mov_b32 252645135
  %113 = s_load_dwordx4 %codebook, %108
  low.br ^_bb1(%108: reg<amdgpu.sgpr>, %107: reg<amdgpu.vgpr>)
^_bb1(%packet: reg<amdgpu.sgpr>, %102: reg<amdgpu.vgpr>):
  %114 = s_cmp_lt_u32 %packet, %109
  low.cond_br %114, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %115 = global_load_b32_saddr %102, %input
  %indices = v_and_b32 %115, %111
  %117 = slice %113[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %118 = slice %113[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %119 = slice %113[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %120 = slice %113[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %121 = v_and_b32_lit %indices, 117901063
  %122 = v_perm_b32 %118, %117, %121
  %123 = v_perm_b32 %120, %119, %121
  %124 = v_and_b32_lit %indices, 134744072
  %125 = v_lshrrev_b32_src0_inline %124, 1
  %126 = v_or_b32_lit %125, 50462976
  %127 = v_perm_b32 %123, %122, %126
  global_store_b32_saddr %102, %127, %output
  %128 = v_add_u32_src0_inline %102, 4
  %129 = s_add_u32 %packet, %110
  low.br ^_bb1(%129: reg<amdgpu.sgpr>, %128: reg<amdgpu.vgpr>)
^_bb3:
  return
}

// ====

#include <loomcxx/kernel.h>

using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
using Codes4 = signed char __attribute__((ext_vector_type(4)));
using Codebook16 = signed char __attribute__((ext_vector_type(16)));

// Constant register tables reach the same packed lookup without table loads.
[[loom::kernel, loom::workgroup_size(32, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void lookup(const Bytes4* input, Codes4* output) {
  constexpr Codebook16 table = {-127, -104, -83, -65, -49, -35, -22, -10,
                               1,    13,   25,  38,  53,  69,  89,  113};
  unsigned position = loom::kernel::workitem::id.x;
  Bytes4 indices = input[position] & 15;
  Codes4 result = {table[indices[0]], table[indices[1]], table[indices[2]],
                   table[indices[3]]};
  output[position] = result;
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @lookup() asm {
  %position = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %88 = v_mov_b32 3215825025
  %89 = v_mov_b32 4142587343
  %90 = v_mov_b32 639175937
  %91 = v_mov_b32 1901675829
  %97 = v_mov_b32 252645135
  %98 = v_lshlrev_b32_src0_inline %position, 2
  %99 = global_load_b32_saddr %98, %input
  %indices = v_and_b32 %99, %97
  %105 = v_and_b32_lit %indices, 117901063
  %106 = v_perm_b32 %89, %88, %105
  %107 = v_perm_b32 %91, %90, %105
  %108 = v_and_b32_lit %indices, 134744072
  %109 = v_lshrrev_b32_src0_inline %108, 1
  %110 = v_or_b32_lit %109, 50462976
  %result = v_perm_b32 %107, %106, %110
  global_store_b32_saddr %98, %result, %output
  return
}

// ====

#include <loomcxx/kernel.h>

using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
using Codes4 = signed char __attribute__((ext_vector_type(4)));
using Codebook16 = signed char __attribute__((ext_vector_type(16)));

static Codes4 lookup_indexed(Codebook16 table, Bytes4 indices) {
  return {table[indices[0]], table[indices[1]], table[indices[2]],
          table[indices[3]]};
}

// Logical shifts retain the zero-fill range before target legalization.
// Promotion removal must consume that bound while indices are still packed.
[[loom::kernel, loom::workgroup_size(32, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void lookup(const Bytes4* input, const Codebook16* codebook, Codes4* output) {
  unsigned position = loom::kernel::workitem::id.x;
  Bytes4 indices = input[position] >> 4;
  output[position] = lookup_indexed(*codebook, indices);
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @lookup() asm {
  %position = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %codebook = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %85 = v_lshlrev_b32_src0_inline %position, 2
  %86 = global_load_b32_saddr %85, %input
  %87 = v_lshrrev_b32_src0_inline %86, 4
  %indices = v_and_b32_lit %87, 252645135
  %89 = v_mov_b32 0
  %90 = global_load_b128_saddr %89, %codebook
  %91 = slice %90[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %92 = slice %90[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %93 = slice %90[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %94 = slice %90[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %95 = v_and_b32_lit %indices, 117901063
  %96 = v_perm_b32 %92, %91, %95
  %97 = v_perm_b32 %94, %93, %95
  %98 = v_and_b32_lit %indices, 134744072
  %99 = v_lshrrev_b32_src0_inline %98, 1
  %100 = v_or_b32_lit %99, 50462976
  %101 = v_perm_b32 %97, %96, %100
  global_store_b32_saddr %85, %101, %output
  return
}
