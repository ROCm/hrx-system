// RUN: emit source-low @lookup target=amdgpu:gfx1151 output=low

#include <loomcxx/kernel.h>

using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
using Codes4 = signed char __attribute__((ext_vector_type(4)));
using Codebook16 = signed char __attribute__((ext_vector_type(16)));

static Codes4 lookup_indexed(Codebook16 table, Bytes4 indices) {
  return {table[indices[0]], table[indices[1]], table[indices[2]],
          table[indices[3]]};
}

// Facts from the caller recover packed indices after helper inlining. This
// reaches three byte permutes without a target intrinsic or operation binding.
[[loom::kernel, loom::workgroup_size(32, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void lookup(
    [[loom::noalias]] const Bytes4* input,
    [[loom::noalias, loom::assume_aligned(64)]] const Codebook16* codebook,
    [[loom::noalias]] Codes4* output) {
  unsigned position = loom::kernel::workitem::id.x;
  Bytes4 indices = input[position] & 15;
  output[position] = lookup_indexed(*codebook, indices);
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @lookup() asm {
  %position = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %codebook = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %97 = v_mov_b32 252645135
  %98 = v_lshlrev_b32_src0_inline %position, 2
  %99 = global_load_b32_saddr %98, %input
  %indices = v_and_b32 %99, %97
  %101 = s_mov_b32 0
  %102 = s_load_dwordx4 %codebook, %101
  %103 = slice %102[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %104 = slice %102[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %105 = slice %102[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %106 = slice %102[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %107 = v_and_b32_lit %indices, 117901063
  %108 = v_perm_b32 %104, %103, %107
  %109 = v_perm_b32 %106, %105, %107
  %110 = v_and_b32_lit %indices, 134744072
  %111 = v_lshrrev_b32_src0_inline %110, 1
  %112 = v_or_b32_lit %111, 50462976
  %113 = v_perm_b32 %109, %108, %112
  global_store_b32_saddr %98, %113, %output
  return
}

// ====

#include <loomcxx/kernel.h>

using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
using Codes4 = signed char __attribute__((ext_vector_type(4)));
using Codebook16 = signed char __attribute__((ext_vector_type(16)));

// Constant register tables reach the same packed lookup without table loads.
[[loom::kernel, loom::workgroup_size(32, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void lookup(const Bytes4* input, Codes4* output) {
  constexpr Codebook16 table = {-127, -104, -83, -65, -49, -35, -22, -10,
                               1,    13,   25,  38,  53,  69,  89,  113};
  unsigned position = loom::kernel::workitem::id.x;
  Bytes4 indices = input[position] & 15;
  Codes4 result = {table[indices[0]], table[indices[1]], table[indices[2]],
                   table[indices[3]]};
  output[position] = result;
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @lookup() asm {
  %position = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %98 = v_mov_b32 3215825025
  %99 = v_mov_b32 4142587343
  %100 = v_mov_b32 639175937
  %101 = v_mov_b32 1901675829
  %107 = v_mov_b32 252645135
  %108 = v_lshlrev_b32_src0_inline %position, 2
  %109 = global_load_b32_saddr %108, %input
  %indices = v_and_b32 %109, %107
  %115 = v_and_b32_lit %indices, 117901063
  %116 = v_perm_b32 %99, %98, %115
  %117 = v_perm_b32 %101, %100, %115
  %118 = v_and_b32_lit %indices, 134744072
  %119 = v_lshrrev_b32_src0_inline %118, 1
  %120 = v_or_b32_lit %119, 50462976
  %result = v_perm_b32 %117, %116, %120
  global_store_b32_saddr %108, %result, %output
  return
}

// ====

#include <loomcxx/kernel.h>

using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
using Codes4 = signed char __attribute__((ext_vector_type(4)));
using Codebook16 = signed char __attribute__((ext_vector_type(16)));

static Codes4 lookup_indexed(Codebook16 table, Bytes4 indices) {
  return {table[indices[0]], table[indices[1]], table[indices[2]],
          table[indices[3]]};
}

// Logical shifts retain the zero-fill range before target legalization.
// Promotion removal must consume that bound while indices are still packed.
[[loom::kernel, loom::workgroup_size(32, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void lookup(const Bytes4* input, const Codebook16* codebook, Codes4* output) {
  unsigned position = loom::kernel::workitem::id.x;
  Bytes4 indices = input[position] >> 4;
  output[position] = lookup_indexed(*codebook, indices);
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @lookup() asm {
  %position = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %codebook = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %93 = v_lshlrev_b32_src0_inline %position, 2
  %94 = global_load_b32_saddr %93, %input
  %95 = v_lshrrev_b32_src0_inline %94, 4
  %indices = v_and_b32_lit %95, 252645135
  %97 = v_mov_b32 0
  %98 = global_load_b128_saddr %97, %codebook
  %99 = slice %98[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %100 = slice %98[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %101 = slice %98[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %102 = slice %98[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %103 = v_and_b32_lit %indices, 117901063
  %104 = v_perm_b32 %100, %99, %103
  %105 = v_perm_b32 %102, %101, %103
  %106 = v_and_b32_lit %indices, 134744072
  %107 = v_lshrrev_b32_src0_inline %106, 1
  %108 = v_or_b32_lit %107, 50462976
  %109 = v_perm_b32 %105, %104, %108
  global_store_b32_saddr %93, %109, %output
  return
}
