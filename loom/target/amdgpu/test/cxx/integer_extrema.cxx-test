// RUN: emit source-low @extrema target=amdgpu:gfx1151 output=low

// Ordinary ternaries reach integer min/max without a source intrinsic.
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void extrema(const int* input, int* output) {
  int lhs = input[0];
  int rhs = input[1];
  output[0] = lhs < rhs ? lhs : rhs;
  output[1] = lhs <= rhs ? rhs : lhs;
  unsigned left = static_cast<unsigned>(lhs);
  unsigned right = static_cast<unsigned>(rhs);
  output[2] = static_cast<int>(left > right ? right : left);
  output[3] = static_cast<int>(left >= right ? left : right);
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @extrema() asm {
  %input = resource<hal_binding> {extent = 8, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %94 = s_mov_b32 0
  %lhs = s_load_dword %input, %94
  %rhs = s_load_dword %input, %94 {offset = 4}
  %98 = s_min_i32 %lhs, %rhs
  %99 = v_mov_b32_copy %98
  %100 = v_mov_b32 0
  global_store_b32_saddr %100, %99, %output
  %101 = s_max_i32 %rhs, %lhs
  %102 = v_mov_b32_copy %101
  global_store_b32_saddr %100, %102, %output {offset = 4}
  %104 = s_min_u32 %rhs, %lhs
  %105 = v_mov_b32_copy %104
  global_store_b32_saddr %100, %105, %output {offset = 8}
  %107 = s_max_u32 %lhs, %rhs
  %108 = v_mov_b32_copy %107
  global_store_b32_saddr %100, %108, %output {offset = 12}
  return
}

// ====
#include <loomcxx/kernel.h>

// Workitem-dependent loads retain the vector forms of the same operations.
[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void extrema(const int* input, int* output) {
  unsigned lane = loom::kernel::workitem::id.x;
  int lhs = input[lane * 2];
  int rhs = input[lane * 2 + 1];
  output[lane * 4] = lhs < rhs ? lhs : rhs;
  output[lane * 4 + 1] = lhs <= rhs ? rhs : lhs;
  unsigned left = static_cast<unsigned>(lhs);
  unsigned right = static_cast<unsigned>(rhs);
  output[lane * 4 + 2] = static_cast<int>(left > right ? right : left);
  output[lane * 4 + 3] = static_cast<int>(left >= right ? left : right);
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @extrema() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %162 = v_lshlrev_b32_src0_inline %lane, 3
  %lhs = global_load_b32_saddr %162, %input
  %rhs = global_load_b32_saddr %162, %input {offset = 4}
  %175 = v_min_i32 %lhs, %rhs
  %180 = v_lshlrev_b32_src0_inline %lane, 4
  global_store_b32_saddr %180, %175, %output
  %181 = v_max_i32 %rhs, %lhs
  global_store_b32_saddr %180, %181, %output {offset = 4}
  %190 = v_min_u32 %rhs, %lhs
  global_store_b32_saddr %180, %190, %output {offset = 8}
  %198 = v_max_u32 %lhs, %rhs
  global_store_b32_saddr %180, %198, %output {offset = 12}
  return
}
