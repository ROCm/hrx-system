// RUN: emit source-low @fp4_e4m3_mma target=amdgpu:gfx1250 output=low

#include <loomcxx/encoding.h>
#include <loomcxx/vector.h>

namespace fragment = loom::vector::fragment;

using Words8 = unsigned __attribute__((ext_vector_type(8)));
using Scale2 = unsigned __attribute__((ext_vector_type(2)));
using Float8 = float __attribute__((ext_vector_type(8)));
using Schema = loom::type::encoding<loom::encoding::role::schema>;

struct Parameters {
  Scale2 scale;
  Schema schema;
};

Float8 fp4_e4m3_mma(Words8 lhs_data, Words8 rhs_data, Scale2 lhs_scale,
                    Scale2 rhs_scale, Float8 init_data) {
  auto schema = loom::encoding::define<loom::encoding::f4e2m1{
      .payload_elements = 64,
      .payload_registers = 8,
      .payload_packing = loom::encoding::payload_packing::target_fragment,
      .scale_format = loom::encoding::numeric_format::f8e4m3,
      .scale_group_elements = 16}>();
  auto lhs = fragment::attach<fragment::role::lhs>(
      lhs_data, fragment::shape{16, 128}, Parameters{lhs_scale, schema});
  auto rhs = fragment::attach<fragment::role::rhs>(
      rhs_data, fragment::shape{128, 16}, Parameters{rhs_scale, schema});
  auto init = fragment::attach<fragment::role::init>(
      init_data, fragment::shape{16, 16});
  return loom::vector::mma(lhs, rhs, init);
}

// ----
low.func.def public target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @fp4_e4m3_mma(%lhs: reg<amdgpu.vgpr x8>, %rhs: reg<amdgpu.vgpr x8>, %lhs_scale: reg<amdgpu.vgpr x2>, %rhs_scale: reg<amdgpu.vgpr x2>, %init: reg<amdgpu.vgpr x8>) -> (reg<amdgpu.vgpr x8>) asm {
  %35 = copy %init : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x8>
  %36 = v_wmma_scale16_f32_16x16x128_f8f6f4_f4_f4 %lhs, %rhs, %35, %lhs_scale, %rhs_scale {matrix_a_fmt = "fp4", matrix_b_fmt = "fp4", matrix_a_scale_fmt = "fp8_e4m3", matrix_b_scale_fmt = "fp8_e4m3"}
  return %36
}
