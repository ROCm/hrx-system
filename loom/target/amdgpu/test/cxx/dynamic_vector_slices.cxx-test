// RUN: emit source-low @sum_packets target=amdgpu:gfx1151 output=low

#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>

using Values = unsigned __attribute__((ext_vector_type(16)));
using Packet = unsigned __attribute__((ext_vector_type(4)));

[[loom::config("dynamic_slice.packet_count")]] const unsigned packet_count = 4u;

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]] void sum_packets(const unsigned* input, Packet* output) {
  Values values = {input[0],  input[1],  input[2],  input[3],
                   input[4],  input[5],  input[6],  input[7],
                   input[8],  input[9],  input[10], input[11],
                   input[12], input[13], input[14], input[15]};
  Packet sum = {};
  [[loom::unroll]]
  for (unsigned index = 0; index < packet_count; ++index) {
    sum += loom::vector::slice<Packet>(values, index * 4u);
  }
  output[0] = sum;
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sum_packets() asm {
  %input = resource<hal_binding> {extent = 64, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %314 = v_mov_b32 0
  %315 = global_load_b32_saddr %314, %input
  %317 = global_load_b32_saddr %314, %input {offset = 4}
  %319 = global_load_b32_saddr %314, %input {offset = 8}
  %321 = global_load_b32_saddr %314, %input {offset = 12}
  %323 = global_load_b32_saddr %314, %input {offset = 16}
  %325 = global_load_b32_saddr %314, %input {offset = 20}
  %327 = global_load_b32_saddr %314, %input {offset = 24}
  %329 = global_load_b32_saddr %314, %input {offset = 28}
  %331 = global_load_b32_saddr %314, %input {offset = 32}
  %333 = global_load_b32_saddr %314, %input {offset = 36}
  %335 = global_load_b32_saddr %314, %input {offset = 40}
  %337 = global_load_b32_saddr %314, %input {offset = 44}
  %339 = global_load_b32_saddr %314, %input {offset = 48}
  %341 = global_load_b32_saddr %314, %input {offset = 52}
  %343 = global_load_b32_saddr %314, %input {offset = 56}
  %345 = global_load_b32_saddr %314, %input {offset = 60}
  %350 = v_add_u32 %315, %323
  %353 = v_add_u32 %317, %325
  %356 = v_add_u32 %319, %327
  %359 = v_add_u32 %321, %329
  %364 = v_add_u32 %350, %331
  %367 = v_add_u32 %353, %333
  %370 = v_add_u32 %356, %335
  %373 = v_add_u32 %359, %337
  %378 = v_add_u32 %364, %339
  %381 = v_add_u32 %367, %341
  %384 = v_add_u32 %370, %343
  %387 = v_add_u32 %373, %345
  %sum_3 = concat(%378, %381, %384, %387) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %314, %sum_3, %output
  return
}
