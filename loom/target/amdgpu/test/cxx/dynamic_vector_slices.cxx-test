// RUN: emit source-low @sum_packets target=amdgpu:gfx1151 output=low

#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>

using Values = unsigned __attribute__((ext_vector_type(16)));
using Packet = unsigned __attribute__((ext_vector_type(4)));

[[loom::config("dynamic_slice.packet_count")]] const unsigned packet_count = 4u;

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]] void sum_packets(const unsigned* input, Packet* output) {
  Values values = {input[0],  input[1],  input[2],  input[3],
                   input[4],  input[5],  input[6],  input[7],
                   input[8],  input[9],  input[10], input[11],
                   input[12], input[13], input[14], input[15]};
  Packet sum = {};
  [[loom::unroll]]
  for (unsigned index = 0; index < packet_count; ++index) {
    sum += loom::vector::slice<Packet>(values, index * 4u);
  }
  output[0] = sum;
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sum_packets() asm {
  %input = resource<hal_binding> {extent = 64, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %314 = s_mov_b32 0
  %315 = s_load_dword %input, %314
  %317 = s_load_dword %input, %314 {offset = 4}
  %319 = s_load_dword %input, %314 {offset = 8}
  %321 = s_load_dword %input, %314 {offset = 12}
  %323 = s_load_dword %input, %314 {offset = 16}
  %325 = s_load_dword %input, %314 {offset = 20}
  %327 = s_load_dword %input, %314 {offset = 24}
  %329 = s_load_dword %input, %314 {offset = 28}
  %331 = s_load_dword %input, %314 {offset = 32}
  %333 = s_load_dword %input, %314 {offset = 36}
  %335 = s_load_dword %input, %314 {offset = 40}
  %337 = s_load_dword %input, %314 {offset = 44}
  %339 = s_load_dword %input, %314 {offset = 48}
  %341 = s_load_dword %input, %314 {offset = 52}
  %343 = s_load_dword %input, %314 {offset = 56}
  %345 = s_load_dword %input, %314 {offset = 60}
  %346 = v_mov_b32_copy %315
  %347 = v_mov_b32_copy %317
  %348 = v_mov_b32_copy %319
  %349 = v_mov_b32_copy %321
  %351 = v_mov_b32_copy %323
  %352 = v_mov_b32_copy %325
  %353 = v_mov_b32_copy %327
  %354 = v_mov_b32_copy %329
  %358 = v_add_u32 %346, %351
  %361 = v_add_u32 %347, %352
  %364 = v_add_u32 %348, %353
  %367 = v_add_u32 %349, %354
  %369 = v_mov_b32_copy %331
  %370 = v_mov_b32_copy %333
  %371 = v_mov_b32_copy %335
  %372 = v_mov_b32_copy %337
  %376 = v_add_u32 %358, %369
  %379 = v_add_u32 %361, %370
  %382 = v_add_u32 %364, %371
  %385 = v_add_u32 %367, %372
  %387 = v_mov_b32_copy %339
  %388 = v_mov_b32_copy %341
  %389 = v_mov_b32_copy %343
  %390 = v_mov_b32_copy %345
  %394 = v_add_u32 %376, %387
  %397 = v_add_u32 %379, %388
  %400 = v_add_u32 %382, %389
  %403 = v_add_u32 %385, %390
  %sum_3 = concat(%394, %397, %400, %403) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %405 = v_mov_b32 0
  global_store_b128_saddr %405, %sum_3, %output
  return
}
