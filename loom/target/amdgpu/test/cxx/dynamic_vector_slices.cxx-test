// RUN: emit source-low @sum_packets target=amdgpu:gfx1151 output=low

#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>

using Values = unsigned __attribute__((ext_vector_type(16)));
using Packet = unsigned __attribute__((ext_vector_type(4)));

[[loom::config("dynamic_slice.packet_count")]] const unsigned packet_count = 4u;

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]] void sum_packets(const unsigned* input, Packet* output) {
  Values values = {input[0],  input[1],  input[2],  input[3],
                   input[4],  input[5],  input[6],  input[7],
                   input[8],  input[9],  input[10], input[11],
                   input[12], input[13], input[14], input[15]};
  Packet sum = {};
  [[loom::unroll]]
  for (unsigned index = 0; index < packet_count; ++index) {
    sum += loom::vector::slice<Packet>(values, index * 4u);
  }
  output[0] = sum;
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sum_packets() asm {
  %input = resource<hal_binding> {extent = 64, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %251 = s_mov_b32 0
  %252 = s_load_dword %input, %251
  %254 = s_load_dword %input, %251 {offset = 4}
  %256 = s_load_dword %input, %251 {offset = 8}
  %258 = s_load_dword %input, %251 {offset = 12}
  %260 = s_load_dword %input, %251 {offset = 16}
  %262 = s_load_dword %input, %251 {offset = 20}
  %264 = s_load_dword %input, %251 {offset = 24}
  %266 = s_load_dword %input, %251 {offset = 28}
  %268 = s_load_dword %input, %251 {offset = 32}
  %270 = s_load_dword %input, %251 {offset = 36}
  %272 = s_load_dword %input, %251 {offset = 40}
  %274 = s_load_dword %input, %251 {offset = 44}
  %276 = s_load_dword %input, %251 {offset = 48}
  %278 = s_load_dword %input, %251 {offset = 52}
  %280 = s_load_dword %input, %251 {offset = 56}
  %282 = s_load_dword %input, %251 {offset = 60}
  %283 = v_mov_b32_copy %252
  %284 = v_mov_b32_copy %254
  %285 = v_mov_b32_copy %256
  %286 = v_mov_b32_copy %258
  %288 = v_mov_b32_copy %260
  %289 = v_mov_b32_copy %262
  %290 = v_mov_b32_copy %264
  %291 = v_mov_b32_copy %266
  %295 = v_add_u32 %283, %288
  %298 = v_add_u32 %284, %289
  %301 = v_add_u32 %285, %290
  %304 = v_add_u32 %286, %291
  %306 = v_mov_b32_copy %268
  %307 = v_mov_b32_copy %270
  %308 = v_mov_b32_copy %272
  %309 = v_mov_b32_copy %274
  %313 = v_add_u32 %295, %306
  %316 = v_add_u32 %298, %307
  %319 = v_add_u32 %301, %308
  %322 = v_add_u32 %304, %309
  %324 = v_mov_b32_copy %276
  %325 = v_mov_b32_copy %278
  %326 = v_mov_b32_copy %280
  %327 = v_mov_b32_copy %282
  %331 = v_add_u32 %313, %324
  %334 = v_add_u32 %316, %325
  %337 = v_add_u32 %319, %326
  %340 = v_add_u32 %322, %327
  %sum_3 = concat(%331, %334, %337, %340) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %342 = v_mov_b32 0
  global_store_b128_saddr %342, %sum_3, %output
  return
}
