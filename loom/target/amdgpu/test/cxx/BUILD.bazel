[
    loom_check_test(
        name = name,
        src = name + ".cxx-test",
        runner = "//loom/src/loom/tools/loom-check",
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/import:cxx",
            "//loom/config/arch:amdgpu",
        ]),
    )
    for name in [
        "assembly_lowering",
        "assembly_invalid",
        "barrier_control_invalid",
        "dynamic_vector_slices",
        "integer_extrema",
        "local_addresses",
        "matrix_fragments",
        "opaque_pointers",
        "parameter_alignment",
        "parameter_noalias",
        "targets",
        "vector_lookup",
    ]
]

