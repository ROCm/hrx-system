load(
    "//loom/build_tools/amdgpu:descriptor_sets.bzl",
    "loom_amdgpu_descriptor_set_compatible_with",
    "loom_amdgpu_iree_hal_representation_compatible_with",
)
load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY",
)
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test")
load("//loom/target/amdgpu:execution_profiles.bzl", "amd_gpu_execution_profile")

package(default_visibility = ["//visibility:public"])

_AMDGPU_EXECUTION_PROFILE = amd_gpu_execution_profile(
    name = "amdgpu",
)

# Access-instrumented execution fails automatically when a report is emitted.
_EXECUTION_PROFILES = [
    _AMDGPU_EXECUTION_PROFILE,
    amd_gpu_execution_profile(
        name = "amdgpu_access",
        runner_args = [
            "--sanitizer=access",
            "--sanitizer-reporting=report-only",
        ],
        tags = ["requires-amd-gpu-feedback"],
    ),
]

_GFX11_GENERIC_REPRESENTATION = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"]

_GFX11_ASSEMBLY_COMPATIBLE_WITH = (
    loom_amdgpu_descriptor_set_compatible_with(_GFX11_GENERIC_REPRESENTATION) +
    loom_amdgpu_iree_hal_representation_compatible_with(_GFX11_GENERIC_REPRESENTATION)
)

_CDNA3_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/execute:amdgpu_hal",
    "//loom/config/arch/amdgpu:iree_hal_descriptor_set_cdna3_core",
])

loom_test(
    name = "assembly_test",
    srcs = [
        "assembly.cxx",
        "assembly.loom",
    ],
    execution_profiles = _EXECUTION_PROFILES,
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
    ]) + _GFX11_ASSEMBLY_COMPATIBLE_WITH,
)

loom_test(
    name = "async_gather_test",
