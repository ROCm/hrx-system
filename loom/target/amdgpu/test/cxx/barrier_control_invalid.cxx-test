// RUN: emit source-low target=amdgpu:gfx1151 output=none
#include <loomcxx/kernel.h>

static LOOM_FORCE_INLINE bool is_first_lane() {
  return loom::kernel::workitem::id.x == 0u;
}

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void lane_result_control() {
  bool active = is_first_lane();
  if (active) {
    // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="workgroup", control_kind="cfg_selector", control_value="active", control_op_name="cfg.cond_br", control_distribution="lane_predicate"}
    loom::kernel::workgroup::barrier();
  }
}

// ====

#include <loomcxx/kernel.h>

static LOOM_FORCE_INLINE void synchronize_workgroup() {
  // ERROR@+1: STRUCTURE/038 {op_name="kernel.barrier", required_uniform_scope="workgroup", control_kind="cfg_selector", control_value="active", control_op_name="cfg.cond_br", control_distribution="lane_predicate"}
  loom::kernel::workgroup::barrier();
}

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void lane_controlled_call() {
  unsigned lane = loom::kernel::workitem::id.x;
  bool active = lane < 32u;
  if (active) {
    synchronize_workgroup();
  }
}
