// RUN: emit source-low @async_gather_two_groups target=amdgpu:gfx942 output=low
// INPUT: cxx I=.
#include "async_gather.cxx"

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @async_gather_two_groups() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input = resource<hal_binding> {extent = 65792, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %291 = storage {byte_alignment = 16, byte_length = 512} : low.storage<workgroup>
  %293 = v_mov_b32 63
  %neighbor = v_sub_u32 %293, %lane
  %300 = v_mov_b32 4294967295
  %301 = v_lshlrev_b32_src0_inline %lane, 2
  ds_write_b32 %301, %300
  %303 = v_mov_b32 4294967294
  ds_write_b32 %301, %303 {offset = 256}
  s_waitcnt {lgkmcnt = 0}
  %306 = s_mov_b32_m0_imm 0
  global_load_lds_dword_saddr %301, %input, %306
  %308 = s_mov_b32 256
  %309 = slice %input[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %310 = slice %input[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %311 = s_mov_b32 0
  %312, %313 = s_add_co_u32 %309, %308
  %314, %315 = s_addc_u32 %310, %311, %313
  %316 = concat(%312, %314) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %317 = s_mov_b32_m0_imm 256
  global_load_lds_dword_saddr %301, %316, %317
  s_waitcnt {vmcnt = 1}
  s_waitcnt {lgkmcnt = 0}
  %321 = v_lshlrev_b32_src0_inline %neighbor, 2
  %first = ds_read_b32 %321
  s_waitcnt {vmcnt = 0}
  s_waitcnt {lgkmcnt = 0}
  %second = ds_read_b32 %321 {offset = 256}
  %325 = v_add_u32 %first, %second
  global_store_dword_saddr %301, %325, %output
  return
}
