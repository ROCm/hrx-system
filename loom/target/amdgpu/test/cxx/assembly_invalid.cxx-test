// RUN: emit source-low @entry target=amdgpu:gfx1151 output=none
#include <loomcxx/low.h>
struct [[loom::representation("amdgpu.gfx11.generic.core")]] Contract {};
using Word = unsigned __attribute__((ext_vector_type(1)));
// A varying value cannot implicitly select one lane for a scalar receiver.
Word entry(Word value) {
  // ERROR@+1: TARGET/074 "mapped operand type reg<amdgpu.vgpr> does not match low helper '@__loom_assembly$' register type reg<amdgpu.sgpr>"
  return loom::low::assembly<Contract, Word>(R"(
      (%value: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) {
        %result = v_mov_b32_copy %value
        return %result
      }
  )", value);
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("amdgpu.gfx11.generic.core")]] Contract {};
using WideWord = unsigned long long __attribute__((ext_vector_type(1)));
using Word = unsigned __attribute__((ext_vector_type(1)));
// Width is checked independently of register class.
Word entry(WideWord value) {
  // ERROR@+1: TARGET/074 "mapped operand type reg<amdgpu.vgpr x2> does not match low helper '@__loom_assembly$' register type reg<amdgpu.vgpr>"
  return loom::low::assembly<Contract, Word>(R"(
      (%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) { return %value }
  )", value);
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("amdgpu.gfx11.generic.core")]] Contract {};
using Word = unsigned __attribute__((ext_vector_type(1)));
// Result carriers are checked even when the inputs match.
unsigned long long entry(Word value) {
  // ERROR@+1: TARGET/074 "mapped result type reg<amdgpu.vgpr x2> does not match low helper '@__loom_assembly$' register type reg<amdgpu.vgpr>"
  return loom::low::assembly<Contract, unsigned long long>(R"(
      (%value: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) { return %value }
  )", value);
}
