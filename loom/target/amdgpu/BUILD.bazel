load(
    "//loom/build_tools/amdgpu:descriptor_sets.bzl",
    "loom_amdgpu_selected_descriptor_set_deps",
)
load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_TARGET",
    "LOOM_AMDGPU_SUPPORTED_TARGETS",
)
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_amdgpu_target_profile",
    "loom_target_set",
)

package(default_visibility = ["//visibility:public"])

exports_files(["execution_profiles.bzl"])

[
    loom_amdgpu_target_profile(
        name = target,
        target = target,
        target_compatible_with = loom_config_compatible_with(["//loom/config/emit:amdgpu_elf"]),
    )
    for target in LOOM_AMDGPU_SUPPORTED_TARGETS
]

loom_target_set(
    name = "all",
    allow_empty = True,
    targets = loom_amdgpu_selected_descriptor_set_deps({
        capability: [
            ":" + target
            for target in LOOM_AMDGPU_SUPPORTED_TARGETS
            if LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_TARGET[target] == capability
        ]
        for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
    }),
)

loom_target_set(
    name = "without_bf16_fma",
    allow_empty = True,
    targets = loom_amdgpu_selected_descriptor_set_deps({
        capability: [
            ":" + target
            for target in LOOM_AMDGPU_SUPPORTED_TARGETS
            if LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_TARGET[target] == capability and
               target not in [
                   "gfx1250",
                   "gfx1251",
                   "gfx1250-strict",
                   "gfx12-5-generic",
               ]
        ]
        for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
    }),
    visibility = ["//loom/target/amdgpu/test/corpus:__pkg__"],
)
