aie2p.target<array> @npu

func.def inline @copy_pair(%first_records: channel<tile<1xi32>>, %second_records: channel<tile<1xi32>>, %input: buffer, %output: buffer, %offset: offset, %increment: i32) {
  %word_bytes = index.constant 4 : offset
  %second_offset = index.add %offset, %word_bytes : offset
  %first_input = buffer.view %input[%offset] : buffer -> view<1xi32>
  %second_input = buffer.view %input[%second_offset] : buffer -> view<1xi32>
  %first_output = buffer.view %output[%offset] : buffer -> view<1xi32>
  %second_output = buffer.view %output[%second_offset] : buffer -> view<1xi32>
  %first_write, %first_destination = channel.reserve %first_records : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
  %second_write, %second_destination = channel.reserve %second_records : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
  %first_ingress = kernel.async.copy %first_input to %first_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
  %second_ingress = kernel.async.copy %second_input to %second_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
  %incoming = kernel.async.group %first_ingress, %second_ingress : kernel.async.token, kernel.async.token -> kernel.async.group
  kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
  channel.publish %first_write : write<tile<1xi32>>
  channel.publish %second_write : write<tile<1xi32>>
  %first_read, %first_source = channel.acquire<mutable> %first_records : channel<tile<1xi32>> -> (read<tile<1xi32>, mutable>, view<1xi32>)
  %second_read, %second_source = channel.acquire<mutable> %second_records : channel<tile<1xi32>> -> (read<tile<1xi32>, mutable>, view<1xi32>)
  %first_value = view.load %first_source[0] : view<1xi32> -> i32
  %second_value = view.load %second_source[0] : view<1xi32> -> i32
  %first_result = scalar.addi %first_value, %increment : i32
  %second_result = scalar.addi %second_value, %increment : i32
  view.store %first_result, %first_source[0] : i32, view<1xi32>
  view.store %second_result, %second_source[0] : i32, view<1xi32>
  %first_egress = kernel.async.copy %first_source to %first_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
  %second_egress = kernel.async.copy %second_source to %second_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
  %outgoing = kernel.async.group %first_egress, %second_egress : kernel.async.token, kernel.async.token -> kernel.async.group
  kernel.async.wait %outgoing {newer_groups = 0} : kernel.async.group
  channel.release %first_read : read<tile<1xi32>, mutable>
  channel.release %second_read : read<tile<1xi32>, mutable>
  func.return
}

// Six static pairs of grouped ingress/egress sites exceed the column's sixteen
// descriptors. Retired sites reuse their pairs; the two live copies in each
// group must remain distinct. Fixed and varying offsets address two independent
// inputs while the three-slot local rings finish at partial revolutions.
pipeline.def<kernel> public retain target(@npu) @reuse_dma_descriptors() run(%first_arg: buffer, %second_arg: buffer, %output_arg: buffer) {
  %first_unique, %second_unique, %output_unique = buffer.assume.noalias %first_arg, %second_arg, %output_arg : buffer, buffer, buffer
  %first, %second, %output = buffer.assume.alignment %first_unique, %second_unique, %output_unique {minimum_alignment = 4} : buffer, buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 12 : offset
  %capacity = index.constant 3 : index
  %first_storage = buffer.alloca<workgroup> pool(%memory) align(4) %storage_bytes : buffer
  %second_storage = buffer.alloca<workgroup> pool(%memory) align(4) %storage_bytes : buffer
  %first_slots = buffer.view %first_storage[%origin] : buffer -> view<3x1xi32>
  %second_slots = buffer.view %second_storage[%origin] : buffer -> view<3x1xi32>
  %first_records = channel.bind<fifo> %first_slots, %capacity : view<3x1xi32>, index -> channel<tile<1xi32>>
  %second_records = channel.bind<fifo> %second_slots, %capacity : view<3x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %offset0 = index.constant 0 : offset
    %offset1 = index.constant 8 : offset
    %offset2 = index.constant 16 : offset
    %offset3 = index.constant 24 : offset
    %offset4 = index.constant 32 : offset
    %increment0 = scalar.constant 1 : i32
    %increment1 = scalar.constant 2 : i32
    %increment2 = scalar.constant 3 : i32
    %increment3 = scalar.constant 4 : i32
    %increment4 = scalar.constant 5 : i32
    func.call @copy_pair(%first_records, %second_records, %first, %output, %offset0, %increment0) : (channel<tile<1xi32>>, channel<tile<1xi32>>, buffer, buffer, offset, i32)
    func.call @copy_pair(%first_records, %second_records, %second, %output, %offset1, %increment1) : (channel<tile<1xi32>>, channel<tile<1xi32>>, buffer, buffer, offset, i32)
    func.call @copy_pair(%first_records, %second_records, %first, %output, %offset2, %increment2) : (channel<tile<1xi32>>, channel<tile<1xi32>>, buffer, buffer, offset, i32)
    func.call @copy_pair(%first_records, %second_records, %second, %output, %offset3, %increment3) : (channel<tile<1xi32>>, channel<tile<1xi32>>, buffer, buffer, offset, i32)
    func.call @copy_pair(%first_records, %second_records, %first, %output, %offset4, %increment4) : (channel<tile<1xi32>>, channel<tile<1xi32>>, buffer, buffer, offset, i32)
    %begin = index.constant 5 : index
    %end = index.constant 7 : index
    %step = index.constant 1 : index
    %pair_bytes = index.constant 8 : index
    scf.for %pair = [%begin to %end step %step] {
      %byte_index = index.mul %pair, %pair_bytes : index
      %offset = index.cast %byte_index : index to offset
      %increment = index.cast %pair : index to i32
      func.call @copy_pair(%first_records, %second_records, %first, %output, %offset, %increment) : (channel<tile<1xi32>>, channel<tile<1xi32>>, buffer, buffer, offset, i32)
    }
  }
}

// Distinct arrival geometries reuse consumed completion credits. The second
// one-word arrival matches the first descriptor while its credit is serving
// the two-word arrival, so it must acquire a different completion resource.
// Loop-varying projections and independent input bindings exercise address
// patching without changing those immutable descriptor/completion identities.
pipeline.def<kernel> public retain target(@npu) @reuse_dma_completions() run(%first_arg: buffer, %second_arg: buffer, %output_arg: buffer) {
  %first_unique, %second_unique, %output_unique = buffer.assume.noalias %first_arg, %second_arg, %output_arg : buffer, buffer, buffer
  %first, %second, %output = buffer.assume.alignment %first_unique, %second_unique, %output_unique {minimum_alignment = 4} : buffer, buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 16 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %storage_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x4xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x4xi32>, index -> channel<tile<4xi32>>
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %begin = index.constant 0 : index
    %end = index.constant 3 : index
    %step = index.constant 1 : index
    %word_bytes = index.constant 4 : index
    %record_bytes = index.constant 16 : index
    scf.for %position = [%begin to %end step %step] {
      %input_index = index.mul %position, %word_bytes : index
      %next_index = index.add %input_index, %word_bytes : index
      %input_offset = index.cast %input_index : index to offset
      %next_offset = index.cast %next_index : index to offset
      %initial_input = buffer.view %first[%input_offset] : buffer -> view<1xi32>
      %pair_input = buffer.view %second[%input_offset] : buffer -> view<2xi32>
      %word_input = buffer.view %first[%next_offset] : buffer -> view<1xi32>
      %write, %destination = channel.reserve %records : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
      %first_word = view.subview %destination[0] : view<4xi32> -> view<1xi32>
      %middle_pair = view.subview %destination[1] : view<4xi32> -> view<2xi32>
      %initial = kernel.async.copy %initial_input to %first_word {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
      %initial_group = kernel.async.group %initial : kernel.async.token -> kernel.async.group
      kernel.async.wait %initial_group {newer_groups = 0} : kernel.async.group
      %saved = view.load %first_word[0] : view<1xi32> -> i32
      %strided_input = buffer.view %first[%input_offset] : buffer -> view<2xi32, #encoding.layout.strided<strides=[2]>>
      %strided = kernel.async.copy %strided_input to %middle_pair {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2xi32, #encoding.layout.strided<strides=[2]>> to view<2xi32> -> kernel.async.token
      %strided_group = kernel.async.group %strided : kernel.async.token -> kernel.async.group
      kernel.async.wait %strided_group {newer_groups = 0} : kernel.async.group
      %saved_pair = view.load %middle_pair[1] : view<2xi32> -> i32
      %pair = kernel.async.copy %pair_input to %middle_pair {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2xi32> to view<2xi32> -> kernel.async.token
      %word = kernel.async.copy %word_input to %first_word {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
      %incoming = kernel.async.group %pair, %word : kernel.async.token, kernel.async.token -> kernel.async.group
      kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
      %value = view.load %first_word[0] : view<1xi32> -> i32
      %partial_sum = scalar.addi %saved, %value : i32
      %sum = scalar.addi %partial_sum, %saved_pair : i32
      view.store %sum, %first_word[0] : i32, view<1xi32>
      %position_value = index.cast %position : index to i32
      view.store %position_value, %destination[3] : i32, view<4xi32>
      channel.publish %write : write<tile<4xi32>>
      %read, %source = channel.acquire %records : channel<tile<4xi32>> -> (read<tile<4xi32>>, view<4xi32>)
      %output_index = index.mul %position, %record_bytes : index
      %output_offset = index.cast %output_index : index to offset
      %output_view = buffer.view %output[%output_offset] : buffer -> view<4xi32>
      %outgoing = kernel.async.copy %source to %output_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4xi32> to view<4xi32> -> kernel.async.token
      %outgoing_group = kernel.async.group %outgoing : kernel.async.token -> kernel.async.group
      kernel.async.wait %outgoing_group {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<4xi32>>
    }
  }
}

func.def @descriptor_reuse_reference(%first: buffer, %second: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %first_values = buffer.view %first[%origin] : buffer -> view<16xi32>
  %second_values = buffer.view %second[%origin] : buffer -> view<16xi32>
  %results = buffer.view %output[%origin] : buffer -> view<16xi32>
  %begin = index.constant 0 : index
  %end = index.constant 7 : index
  %step = index.constant 1 : index
  %fields = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  scf.for %pair = [%begin to %end step %step] {
    %is_one = index.cmp eq, %pair, %step : index
    %is_three = index.cmp eq, %pair, %c3 : index
    %use_second = scalar.ori %is_one, %is_three : i1
    %before_loop = index.cmp ult, %pair, %c5 : index
    %next = index.add %pair, %step : index
    %increment_index = scf.select %before_loop, %next, %pair : index
    %increment = index.cast %increment_index : index to i32
    %pair_start = index.mul %pair, %fields : index
    scf.for %field = [%begin to %fields step %step] {
      %position = index.add %pair_start, %field : index
      %first_value = view.load %first_values[%position] : view<16xi32> -> i32
      %second_value = view.load %second_values[%position] : view<16xi32> -> i32
      %value = scf.select %use_second, %second_value, %first_value : i32
      %result = scalar.addi %value, %increment : i32
      view.store %result, %results[%position] : i32, view<16xi32>
    }
  }
  func.return
}

func.def @completion_reuse_reference(%first: buffer, %second: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %first_values = buffer.view %first[%origin] : buffer -> view<16xi32>
  %second_values = buffer.view %second[%origin] : buffer -> view<16xi32>
  %results = buffer.view %output[%origin] : buffer -> view<16xi32>
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %width = index.constant 4 : index
  scf.for %record = [%begin to %end step %step] {
    %next = index.add %record, %step : index
    %last = index.add %next, %step : index
    %a = view.load %first_values[%record] : view<16xi32> -> i32
    %b = view.load %first_values[%next] : view<16xi32> -> i32
    %c = view.load %first_values[%last] : view<16xi32> -> i32
    %partial = scalar.addi %a, %b : i32
    %sum = scalar.addi %partial, %c : i32
    %left = view.load %second_values[%record] : view<16xi32> -> i32
    %right = view.load %second_values[%next] : view<16xi32> -> i32
    %ordinal = index.cast %record : index to i32
    %position = index.mul %record, %width : index
    %p1 = index.add %position, %step : index
    %p2 = index.add %p1, %step : index
    %p3 = index.add %p2, %step : index
    view.store %sum, %results[%position] : i32, view<16xi32>
    view.store %left, %results[%p1] : i32, view<16xi32>
    view.store %right, %results[%p2] : i32, view<16xi32>
    view.store %ordinal, %results[%p3] : i32, view<16xi32>
  }
  func.return
}

check.scenario public @retired_descriptor_reuse {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %first_storage = check.generate.random.uniform seed(%seed) range(-32768 to -1) : tensor<48xi32>
    %second_storage = check.generate.random.uniform seed(%seed) range(1 to 32767) : tensor<48xi32>
    %output_storage = check.generate.random.uniform seed(%seed) range(-200000 to -100000) : tensor<48xi32>
    %first = check.tensor.view %first_storage offset(64) : tensor<48xi32> -> tensor<16xi32>
    %second = check.tensor.view %second_storage offset(64) : tensor<48xi32> -> tensor<16xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<48xi32> -> tensor<16xi32>
    check.compare<@reuse_dma_descriptors, @descriptor_reuse_reference>(%first, %second, %output) : (tensor<16xi32>, tensor<16xi32>, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%first_storage) expected(%first_storage) : tensor<48xi32>
      check.expect.bitwise actual(%second_storage) expected(%second_storage) : tensor<48xi32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<48xi32>
    }
  }
  check.return
}

check.scenario public @consumed_completion_reuse {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %first_storage = check.generate.random.uniform seed(%seed) range(-32768 to -1) : tensor<48xi32>
    %second_storage = check.generate.random.uniform seed(%seed) range(1 to 32767) : tensor<48xi32>
    %output_storage = check.generate.random.uniform seed(%seed) range(-200000 to -100000) : tensor<48xi32>
    %first = check.tensor.view %first_storage offset(64) : tensor<48xi32> -> tensor<16xi32>
    %second = check.tensor.view %second_storage offset(64) : tensor<48xi32> -> tensor<16xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<48xi32> -> tensor<16xi32>
    check.compare<@reuse_dma_completions, @completion_reuse_reference>(%first, %second, %output) : (tensor<16xi32>, tensor<16xi32>, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%first_storage) expected(%first_storage) : tensor<48xi32>
      check.expect.bitwise actual(%second_storage) expected(%second_storage) : tensor<48xi32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<48xi32>
    }
  }
  check.return
}
