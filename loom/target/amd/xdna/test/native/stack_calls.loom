func.def inline @stack_worker(%storage: buffer, %incoming: channel<tile<64xi32>>, %outgoing: channel<tile<64xi32>>) {
  %read, %input = channel.acquire<mutable> %incoming : channel<tile<64xi32>> -> (read<tile<64xi32>, mutable>, view<64xi32>)
  %write, %output = channel.reserve %outgoing : channel<tile<64xi32>> -> (write<tile<64xi32>>, view<64xi32>)
  %saved0 = view.load %input[0] : view<64xi32> -> i32
  %saved1 = view.load %input[1] : view<64xi32> -> i32
  %saved2 = view.load %input[2] : view<64xi32> -> i32
  %saved3 = view.load %input[3] : view<64xi32> -> i32
  %saved4 = view.load %input[4] : view<64xi32> -> i32
  %saved5 = view.load %input[5] : view<64xi32> -> i32
  %saved6 = view.load %input[6] : view<64xi32> -> i32
  %saved7 = view.load %input[7] : view<64xi32> -> i32
  %saved8 = view.load %input[8] : view<64xi32> -> i32
  %saved9 = view.load %input[9] : view<64xi32> -> i32
  %saved10 = view.load %input[10] : view<64xi32> -> i32
  %saved11 = view.load %input[11] : view<64xi32> -> i32
  %saved12 = view.load %input[12] : view<64xi32> -> i32
  %saved13 = view.load %input[13] : view<64xi32> -> i32
  %saved14 = view.load %input[14] : view<64xi32> -> i32
  %saved15 = view.load %input[15] : view<64xi32> -> i32
  %saved16 = view.load %input[16] : view<64xi32> -> i32
  %saved17 = view.load %input[17] : view<64xi32> -> i32
  %saved18 = view.load %input[18] : view<64xi32> -> i32
  %saved19 = view.load %input[19] : view<64xi32> -> i32
  %saved20 = view.load %input[20] : view<64xi32> -> i32
  %saved21 = view.load %input[21] : view<64xi32> -> i32
  %saved22 = view.load %input[22] : view<64xi32> -> i32
  %saved23 = view.load %input[23] : view<64xi32> -> i32
  %key = view.load %input[62] : view<64xi32> -> i32
  %bias = view.load %input[63] : view<64xi32> -> i32
  %begin = index.constant 0 : index
  %repeat = index.constant 2 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  scf.for %iteration = [%begin to %repeat step %step] {
    low.invoke @xor_words(%storage, %key) : (buffer, i32)
    low.invoke @add_words(%storage, %bias) : (buffer, i32)
  }
  scf.for %element = [%begin to %end step %step] {
    %value = view.load %input[%element] : view<64xi32> -> i32
    view.store %value, %output[%element] : i32, view<64xi32>
  }
  view.store %saved0, %output[40] : i32, view<64xi32>
  view.store %saved1, %output[41] : i32, view<64xi32>
  view.store %saved2, %output[42] : i32, view<64xi32>
  view.store %saved3, %output[43] : i32, view<64xi32>
  view.store %saved4, %output[44] : i32, view<64xi32>
  view.store %saved5, %output[45] : i32, view<64xi32>
  view.store %saved6, %output[46] : i32, view<64xi32>
  view.store %saved7, %output[47] : i32, view<64xi32>
  view.store %saved8, %output[48] : i32, view<64xi32>
  view.store %saved9, %output[49] : i32, view<64xi32>
  view.store %saved10, %output[50] : i32, view<64xi32>
  view.store %saved11, %output[51] : i32, view<64xi32>
  view.store %saved12, %output[52] : i32, view<64xi32>
  view.store %saved13, %output[53] : i32, view<64xi32>
  view.store %saved14, %output[54] : i32, view<64xi32>
  view.store %saved15, %output[55] : i32, view<64xi32>
  view.store %saved16, %output[56] : i32, view<64xi32>
  view.store %saved17, %output[57] : i32, view<64xi32>
  view.store %saved18, %output[58] : i32, view<64xi32>
  view.store %saved19, %output[59] : i32, view<64xi32>
  view.store %saved20, %output[60] : i32, view<64xi32>
  view.store %saved21, %output[61] : i32, view<64xi32>
  view.store %saved22, %output[62] : i32, view<64xi32>
  view.store %saved23, %output[63] : i32, view<64xi32>
  channel.publish %write : write<tile<64xi32>>
  channel.release %read : read<tile<64xi32>, mutable>
  func.return
}

pipeline.def<kernel> @stack_tile(%row: index, %bytes: offset) run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 64} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, %row] : pool
  %origin = index.constant 0 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x64xi32>
  %incoming = channel.bind<fifo> %input_slots, %capacity : view<1x64xi32>, index -> channel<tile<64xi32>>
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x64xi32>
  %outgoing = channel.bind<fifo> %output_slots, %capacity : view<1x64xi32>, index -> channel<tile<64xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_input = buffer.view %input[%origin] : buffer -> view<64xi32>
    %write, %destination = channel.reserve %incoming : channel<tile<64xi32>> -> (write<tile<64xi32>>, view<64xi32>)
    %ingress = kernel.async.copy %external_input to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<64xi32> to view<64xi32> -> kernel.async.token
    %incoming_group = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %incoming_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<64xi32>>
    %read, %source = channel.acquire %outgoing : channel<tile<64xi32>> -> (read<tile<64xi32>>, view<64xi32>)
    %external_output = buffer.view %output[%origin] : buffer -> view<64xi32>
    %egress = kernel.async.copy %source to %external_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<64xi32> to view<64xi32> -> kernel.async.token
    %outgoing_group = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<64xi32>>
  }
  pipeline.strand workers([0, %row], [1, 1], [1, 1]) {
    func.call @stack_worker(%input_storage, %incoming, %outgoing) : (buffer, channel<tile<64xi32>>, channel<tile<64xi32>>)
  }
}

// Different worker rows and channel footprints require independent physical
// stack relocations while sharing the same helper definitions.
pipeline.def<kernel> public retain target(@array_target) @stack_calls_row3() run(%input: buffer, %output: buffer) {
  %row = index.constant 3 : index
  %bytes = index.constant 256 : offset
  pipeline.compose @stack_tile[%row, %bytes](%input, %output) : [index, offset](buffer, buffer)
}

pipeline.def<kernel> public retain target(@array_target) @stack_calls_row4() run(%input: buffer, %output: buffer) {
  %row = index.constant 4 : index
  %bytes = index.constant 512 : offset
  pipeline.compose @stack_tile[%row, %bytes](%input, %output) : [index, offset](buffer, buffer)
}

func.def @stack_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<64xi32>
  %outputs = buffer.view %output[%origin] : buffer -> view<64xi32>
  %key = view.load %inputs[62] : view<64xi32> -> i32
  %bias = view.load %inputs[63] : view<64xi32> -> i32
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %changed = index.constant 36 : index
  %saved_begin = index.constant 40 : index
  %saved_end = index.constant 64 : index
  scf.for %element = [%begin to %end step %step] {
    %value = view.load %inputs[%element] : view<64xi32> -> i32
    %is_changed = index.cmp ult, %element, %changed : index
    %value0 = scalar.xori %value, %key : i32
    %value1 = scalar.addi %value0, %bias : i32
    %value2 = scalar.xori %value1, %key : i32
    %value3 = scalar.addi %value2, %bias : i32
    %result = scf.select %is_changed, %value3, %value : i32
    view.store %result, %outputs[%element] : i32, view<64xi32>
  }
  scf.for %element = [%saved_begin to %saved_end step %step] {
    %source = index.sub %element, %saved_begin : index
    %value = view.load %inputs[%source] : view<64xi32> -> i32
    view.store %value, %outputs[%element] : i32, view<64xi32>
  }
  func.return
}

check.scenario public @caller_and_peer_frames {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<64xi32>
    %output_storage = check.generate.fill value(-1515870811) : tensor<96xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    check.compare<@stack_calls_row3, @stack_reference>(%input, %output) : (tensor<64xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<96xi32>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<64xi32>
    %output_storage = check.generate.fill value(-1515870811) : tensor<96xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    check.compare<@stack_calls_row4, @stack_reference>(%input, %output) : (tensor<64xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<96xi32>
    }
  }
  check.return
}
