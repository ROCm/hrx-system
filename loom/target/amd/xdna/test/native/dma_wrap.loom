    kernel.async.wait %gather_ingress_group {newer_groups = 0} : kernel.async.group
    channel.publish %gather_write : write<tile<2046xi32>>
    %gather_read, %gather_payload = channel.acquire %gather_records : channel<tile<2046xi32>> -> (read<tile<2046xi32>>, view<2046xi32>)
    %gather_egress = kernel.async.copy %gather_payload to %gather_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<2046xi32> to view<2046xi32> -> kernel.async.token
    %gather_egress_group = kernel.async.group %gather_egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %gather_egress_group {newer_groups = 0} : kernel.async.group
    channel.release %gather_read : read<tile<2046xi32>>

    %scatter_write, %scatter_destination = channel.reserve %scatter_records : channel<tile<2046xi32>> -> (write<tile<2046xi32>>, view<2046xi32>)
    %scatter_ingress = kernel.async.copy %scatter_input to %scatter_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2046xi32> to view<2046xi32> -> kernel.async.token
    %scatter_ingress_group = kernel.async.group %scatter_ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %scatter_ingress_group {newer_groups = 0} : kernel.async.group
    channel.publish %scatter_write : write<tile<2046xi32>>
    %scatter_read, %scatter_payload = channel.acquire %scatter_records : channel<tile<2046xi32>> -> (read<tile<2046xi32>>, view<2046xi32>)
    %scatter_egress = kernel.async.copy %scatter_payload to %scatter_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<2046xi32> to view<2x1023x1xi32, #encoding.layout.strided<strides=[2064, 2, 1]>> -> kernel.async.token
    %scatter_egress_group = kernel.async.group %scatter_egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %scatter_egress_group {newer_groups = 0} : kernel.async.group
    channel.release %scatter_read : read<tile<2046xi32>>
  }
}

func.def inline @reference(%input: buffer, %gather: buffer, %scatter: buffer, %wrap: index, %stride: index, %initialize: i1) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<4128xi32>
  %gather_output = buffer.view %gather[%origin] : buffer -> view<4128xi32>
  %scatter_output = buffer.view %scatter[%origin] : buffer -> view<4128xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c2064 = index.constant 2064 : index
  %c4128 = index.constant 4128 : index
  scf.if %initialize {
    scf.for %position = [%c0 to %c4128 step %c1] {
      %value = view.load %source[%position] : view<4128xi32> -> i32
      view.store %value, %scatter_output[%position] : i32, view<4128xi32>
    }
  }
  scf.for %row = [%c0 to %c2 step %c1] {
    %dense_base = index.mul %row, %wrap : index
    %strided_base = index.mul %row, %c2064 : index
    scf.for %column = [%c0 to %wrap step %c1] {
      %dense = index.add %dense_base, %column : index
      %scaled = index.mul %column, %stride : index
      %strided = index.add %strided_base, %scaled : index
      %gathered = view.load %source[%strided] : view<4128xi32> -> i32
      view.store %gathered, %gather_output[%dense] : i32, view<4128xi32>
      %scattered = view.load %source[%dense] : view<4128xi32> -> i32
      view.store %scattered, %scatter_output[%strided] : i32, view<4128xi32>
    }
  }
  func.return
}

