}

check.scenario public @compute_dimension0_wrap {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_owner = check.generate.random.uniform seed(%seed) range(-2000000000 to 2000000000) : tensor<4160xi32>
    %gather_owner = check.generate.random.uniform seed(%seed) range(-200000 to -100000) : tensor<4160xi32>
    %scatter_owner = check.generate.random.uniform seed(%seed) range(-400000 to -300000) : tensor<4160xi32>
    %input = check.tensor.view %input_owner offset(64) : tensor<4160xi32> -> tensor<4128xi32>
    %gather = check.tensor.view %gather_owner offset(64) : tensor<4160xi32> -> tensor<4128xi32>
    %scatter = check.tensor.view %scatter_owner offset(64) : tensor<4160xi32> -> tensor<4128xi32>
    check.compare<@compute_dimension0, @compute_dimension0_reference>(%input, %gather, %scatter) : (tensor<4128xi32>, tensor<4128xi32>, tensor<4128xi32>) -> () {
      check.expect.bitwise actual(%input_owner) expected(%input_owner) : tensor<4160xi32>
      check.expect.bitwise actual(%gather_owner) expected(%gather_owner) : tensor<4160xi32>
      check.expect.bitwise actual(%scatter_owner) expected(%scatter_owner) : tensor<4160xi32>
    }
  }
  check.return
}

