// Every physical wrap field is exercised at its largest nonzero value.
// Separate gather and scatter slots keep each transfer's input independent.

aie2p.target<array> @npu

pipeline.def<kernel> @local_wrap_dimension0(%row: index, %wrap: index) run(%input_arg: buffer, %gather_arg: buffer, %scatter_arg: buffer) {
  %input_unique, %gather_unique, %scatter_unique = buffer.assume.noalias %input_arg, %gather_arg, %scatter_arg : buffer, buffer, buffer
  %input, %gather, %scatter = buffer.assume.alignment %input_unique, %gather_unique, %scatter_unique {minimum_alignment = 4} : buffer, buffer, buffer
  %memory = pipeline.memory<workgroup>[0, %row] : pool
  %origin = index.constant 0 : offset
  %bytes = index.constant 16512 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x4128xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x4128xi32>, index -> channel<tile<4128xi32>>
  %scatter_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %scatter_slots = buffer.view %scatter_storage[%origin] : buffer -> view<1x4128xi32>
  %scatter_records = channel.bind<fifo> %scatter_slots, %capacity : view<1x4128xi32>, index -> channel<tile<4128xi32>>
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %initial = buffer.view %input[%origin] : buffer -> view<4128xi32>
    %gather_output = buffer.view %gather[%origin] : buffer -> view<2x[%wrap]xi32>
    %scatter_input = buffer.view %input[%origin] : buffer -> view<2x[%wrap]xi32>
    %scatter_output = buffer.view %scatter[%origin] : buffer -> view<4128xi32>

    %gather_write, %gather_destination = channel.reserve %records : channel<tile<4128xi32>> -> (write<tile<4128xi32>>, view<4128xi32>)
    %initialize_gather = kernel.async.copy %initial to %gather_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4128xi32> to view<4128xi32> -> kernel.async.token
    %initialize_gather_group = kernel.async.group %initialize_gather : kernel.async.token -> kernel.async.group
    kernel.async.wait %initialize_gather_group {newer_groups = 0} : kernel.async.group
    channel.publish %gather_write : write<tile<4128xi32>>
    %gather_read, %gather_payload = channel.acquire %records : channel<tile<4128xi32>> -> (read<tile<4128xi32>>, view<4128xi32>)
    %gather_shaped = view.bitcast %gather_payload : view<4128xi32> -> view<2x2064xi32>
    %gather_strided = view.refine %gather_shaped : view<2x2064xi32> -> view<2x2064xi32, #encoding.layout.strided<strides=[2064, 1]>>
    %gather_selected = view.subview %gather_strided[0, 0] : view<2x2064xi32, #encoding.layout.strided<strides=[2064, 1]>> -> view<2x[%wrap]xi32, #encoding.layout.strided<strides=[2064, 1]>>
    %gather_copy = kernel.async.copy %gather_selected to %gather_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<2x[%wrap]xi32, #encoding.layout.strided<strides=[2064, 1]>> to view<2x[%wrap]xi32> -> kernel.async.token
    %gather_group = kernel.async.group %gather_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %gather_group {newer_groups = 0} : kernel.async.group
    channel.release %gather_read : read<tile<4128xi32>>

    %scatter_write, %scatter_destination = channel.reserve %scatter_records : channel<tile<4128xi32>> -> (write<tile<4128xi32>>, view<4128xi32>)
    %initialize_scatter = kernel.async.copy %initial to %scatter_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4128xi32> to view<4128xi32> -> kernel.async.token
    %initialize_scatter_group = kernel.async.group %initialize_scatter : kernel.async.token -> kernel.async.group
    kernel.async.wait %initialize_scatter_group {newer_groups = 0} : kernel.async.group
    %scatter_shaped = view.bitcast %scatter_destination : view<4128xi32> -> view<2x2064xi32>
    %scatter_strided = view.refine %scatter_shaped : view<2x2064xi32> -> view<2x2064xi32, #encoding.layout.strided<strides=[2064, 1]>>
    %scatter_selected = view.subview %scatter_strided[0, 0] : view<2x2064xi32, #encoding.layout.strided<strides=[2064, 1]>> -> view<2x[%wrap]xi32, #encoding.layout.strided<strides=[2064, 1]>>
    %scatter_copy = kernel.async.copy %scatter_input to %scatter_selected {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2x[%wrap]xi32> to view<2x[%wrap]xi32, #encoding.layout.strided<strides=[2064, 1]>> -> kernel.async.token
    %scatter_group = kernel.async.group %scatter_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %scatter_group {newer_groups = 0} : kernel.async.group
    channel.publish %scatter_write : write<tile<4128xi32>>
    %scatter_read, %scatter_payload = channel.acquire %scatter_records : channel<tile<4128xi32>> -> (read<tile<4128xi32>>, view<4128xi32>)
    %outgoing = kernel.async.copy %scatter_payload to %scatter_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4128xi32> to view<4128xi32> -> kernel.async.token
    %outgoing_group = kernel.async.group %outgoing : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing_group {newer_groups = 0} : kernel.async.group
    channel.release %scatter_read : read<tile<4128xi32>>
  }
}

