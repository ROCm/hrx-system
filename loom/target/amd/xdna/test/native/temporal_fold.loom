// Both paths overwrite and reload the output before returning its final value.
// Integer operations preserve every contribution bit, including negative zero.
// Each packet header carries the branch choice and output byte count.
low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @overwrite_record() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %choice = lda %input, 0
  %branch = nez %choice
  %zero = mov.short 0
  %step = mov.short 4
  %header_bytes = mov.i32 64
  %output_bytes = lda %input, 4
  %first_mask = mov.i32 8388608
  %second_mask = mov.i32 1073741824
  %combined_mask = mov.i32 1082130432
  low.cond_br %branch, ^three_stores, ^two_stores : reg<aie2p.er>
^two_stores:
  low.br ^two_loop(%zero: reg<aie2p.er>)
^two_loop(%two_position: reg<aie2p.er>):
  %two_remaining = lt %two_position, %output_bytes
  low.cond_br %two_remaining, ^two_body, ^two_return : reg<aie2p.er>
^two_body:
  %two_input_offset = add.rr %two_position, %header_bytes
  %two_input_index = mov.address-index %two_input_offset
  %two_output_index = mov.address-index %two_position
  %two_value = lda.i32.index %input, %two_input_index
  %two_temporary = xor %two_value, %first_mask
  st.i32.index %two_temporary, %output, %two_output_index
  %two_reloaded = lda.i32.index %output, %two_output_index
  %two_final = xor %two_reloaded, %first_mask
  st.i32.index %two_final, %output, %two_output_index
  %two_next = add.rr %two_position, %step
  low.br ^two_loop(%two_next: reg<aie2p.er>)
^two_return:
  return
^three_stores:
  low.br ^three_loop(%zero: reg<aie2p.er>)
^three_loop(%three_position: reg<aie2p.er>):
  %three_remaining = lt %three_position, %output_bytes
  low.cond_br %three_remaining, ^three_body, ^three_return : reg<aie2p.er>
^three_body:
  %three_input_offset = add.rr %three_position, %header_bytes
  %three_input_index = mov.address-index %three_input_offset
  %three_output_index = mov.address-index %three_position
  %three_value = lda.i32.index %input, %three_input_index
  %three_temporary = xor %three_value, %first_mask
  st.i32.index %three_temporary, %output, %three_output_index
  %three_reloaded = lda.i32.index %output, %three_output_index
  %three_overwrite = xor %three_reloaded, %second_mask
  st.i32.index %three_overwrite, %output, %three_output_index
  %three_final_load = lda.i32.index %output, %three_output_index
  %three_final = xor %three_final_load, %combined_mask
  st.i32.index %three_final, %output, %three_output_index
  %three_next = add.rr %three_position, %step
  low.br ^three_loop(%three_next: reg<aie2p.er>)
^three_return:
  return
}

// Expand compact input into four distinct lane-permuted blocks. Both 16 KiB
// output ring slots and the 16 KiB private sum fit alongside compact input
// slots in local memory. Every source store remains observable to later loads.
low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @overwrite_large_record() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %choice = lda %input, 0
  %branch = nez %choice
  %zero = mov.short 0
  %step = mov.short 4
  %header_bytes = mov.i32 64
  %output_bytes = lda %input, 4
  %input_mask = mov.i32 4095
  %block_shift = mov.short -10
  %block_mask = mov.short 12
  %first_mask = mov.i32 8388608
  %second_mask = mov.i32 1073741824
  %combined_mask = mov.i32 1082130432
  low.cond_br %branch, ^three_stores, ^two_stores : reg<aie2p.er>
^two_stores:
  low.br ^two_loop(%zero: reg<aie2p.er>)
^two_loop(%two_position: reg<aie2p.er>):
  %two_remaining = lt %two_position, %output_bytes
  low.cond_br %two_remaining, ^two_body, ^two_return : reg<aie2p.er>
^two_body:
  %two_base = and %two_position, %input_mask
  %two_shifted = lshl %two_position, %block_shift
  %two_block = and %two_shifted, %block_mask
  %two_permuted = xor %two_base, %two_block
  %two_input_offset = add.rr %two_permuted, %header_bytes
  %two_input_index = mov.address-index %two_input_offset
  %two_output_index = mov.address-index %two_position
  %two_value = lda.i32.index %input, %two_input_index
  %two_temporary = xor %two_value, %first_mask
  st.i32.index %two_temporary, %output, %two_output_index
  %two_reloaded = lda.i32.index %output, %two_output_index
  %two_final = xor %two_reloaded, %first_mask
  st.i32.index %two_final, %output, %two_output_index
  %two_next = add.rr %two_position, %step
  low.br ^two_loop(%two_next: reg<aie2p.er>)
^two_return:
  return
^three_stores:
  low.br ^three_loop(%zero: reg<aie2p.er>)
^three_loop(%three_position: reg<aie2p.er>):
  %three_remaining = lt %three_position, %output_bytes
  low.cond_br %three_remaining, ^three_body, ^three_return : reg<aie2p.er>
^three_body:
  %three_base = and %three_position, %input_mask
  %three_shifted = lshl %three_position, %block_shift
  %three_block = and %three_shifted, %block_mask
  %three_permuted = xor %three_base, %three_block
  %three_input_offset = add.rr %three_permuted, %header_bytes
  %three_input_index = mov.address-index %three_input_offset
  %three_output_index = mov.address-index %three_position
  %three_value = lda.i32.index %input, %three_input_index
  %three_temporary = xor %three_value, %first_mask
  st.i32.index %three_temporary, %output, %three_output_index
  %three_reloaded = lda.i32.index %output, %three_output_index
  %three_overwrite = xor %three_reloaded, %second_mask
  st.i32.index %three_overwrite, %output, %three_output_index
  %three_final_load = lda.i32.index %output, %three_output_index
  %three_final = xor %three_final_load, %combined_mask
  st.i32.index %three_final, %output, %three_output_index
  %three_next = add.rr %three_position, %step
  low.br ^three_loop(%three_next: reg<aie2p.er>)
^three_return:
