// Source-private storage and output loads both observe their own writes before
// the final scalar and wide values become contributions to the temporal fold.
low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @overwrite_mixed_record() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %scalar = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %allocation = storage {byte_alignment = 64, byte_length = 64} : low.storage<workgroup>
  %scratch = storage_address %allocation : low.storage<workgroup> -> reg<aie2p.ep>
  %zero = mov.short 0
  %step = mov.short 4
  %header_bytes = mov.i32 64
  %output_bytes = lda %input, 4
  %mask = mov.i32 8388608
  %scalar_offset = mov.i32 80
  %scalar_index = mov.address-index %scalar_offset
  %scalar_value = lda.i32.index %input, %scalar_index
  %scalar_temporary = xor %scalar_value, %mask
  st %scalar_temporary, %scratch, 0
  %scalar_reloaded = lda %scratch, 0
  st %scalar_reloaded, %scalar, 0
  %scalar_output_load = lda %scalar, 0
  %scalar_final = xor %scalar_output_load, %mask
  st %scalar_final, %scalar, 0
  low.br ^copy(%zero: reg<aie2p.er>)
^copy(%position: reg<aie2p.er>):
  %remaining = lt %position, %output_bytes
  low.cond_br %remaining, ^body, ^done : reg<aie2p.er>
^body:
  %input_offset = add.rr %position, %header_bytes
  %input_index = mov.address-index %input_offset
  %output_index = mov.address-index %position
  %value = lda.i32.index %input, %input_index
  %temporary = xor %value, %mask
  st.i32.index %temporary, %output, %output_index
  %reloaded = lda.i32.index %output, %output_index
  %final = xor %reloaded, %mask
  st.i32.index %final, %output, %output_index
  %next = add.rr %position, %step
  low.br ^copy(%next: reg<aie2p.er>)
^done:
  return
}
