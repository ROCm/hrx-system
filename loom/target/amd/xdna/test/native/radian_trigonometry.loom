aie2p.target<array> @npu

pipeline.def<kernel> public retain target(@npu) @radian_trigonometry() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 64} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 64 : offset
  %output_bytes = index.constant 128 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %input_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x16xf32>
  %input_records = channel.bind<fifo> %input_slots, %capacity : view<1x16xf32>, index -> channel<tile<16xf32>>
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_bytes : buffer
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x32xf32>
  %output_records = channel.bind<fifo> %output_slots, %capacity : view<1x32xf32>, index -> channel<tile<32xf32>>

  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external = buffer.view %input[%origin] : buffer -> view<16xf32>
    %write, %destination = channel.reserve %input_records : channel<tile<16xf32>> -> (write<tile<16xf32>>, view<16xf32>)
    %copy = kernel.async.copy %external to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xf32> to view<16xf32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<16xf32>>
  }

  pipeline.strand workers([0, 4], [1, 1], [1, 1]) {
    %read, %source = channel.acquire %output_records : channel<tile<32xf32>> -> (read<tile<32xf32>>, view<32xf32>)
    %external = buffer.view %output[%origin] : buffer -> view<32xf32>
    %copy = kernel.async.copy %source to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<32xf32> to view<32xf32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<32xf32>>
  }

  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %source = channel.acquire %input_records : channel<tile<16xf32>> -> (read<tile<16xf32>>, view<16xf32>)
    %write, %destination = channel.reserve %output_records : channel<tile<32xf32>> -> (write<tile<32xf32>>, view<32xf32>)
    %begin = index.constant 0 : index
    %end = index.constant 16 : index
    %step = index.constant 1 : index
    scf.for %position = [%begin to %end step %step] {
      %radians = view.load %source[%position] : view<16xf32> -> f32
      %sine = scalar.sinf<afn> %radians : f32
      view.store %sine, %destination[%position] : f32, view<32xf32>
      %cosine = scalar.cosf<afn> %radians : f32
      %cosine_position = index.add %position, %end : index
      view.store %cosine, %destination[%cosine_position] : f32, view<32xf32>
    }
    channel.publish %write : write<tile<32xf32>>
    channel.release %read : read<tile<16xf32>>
  }
}

func.def @radian_trigonometry_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<16xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<32xf32>
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %end step %step] {
    %radians = view.load %source[%position] : view<16xf32> -> f32
    %sine = scalar.sinf<afn> %radians : f32
    view.store %sine, %destination[%position] : f32, view<32xf32>
    %cosine = scalar.cosf<afn> %radians : f32
    %cosine_position = index.add %position, %end : index
    view.store %cosine, %destination[%cosine_position] : f32, view<32xf32>
  }
  func.return
}

check.scenario public @radian_trigonometry_phase {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(2040.0) step(1.0) : tensor<16xf32>
    %output = check.generate.fill value(-99.0) : tensor<32xf32>
    check.compare<@radian_trigonometry, @radian_trigonometry_reference>(%input, %output) : (tensor<16xf32>, tensor<32xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xf32>
      check.expect.approximate actual(%output) expected(%output) atol(0.025000000000000001) rtol(0.0) nan(same) : tensor<32xf32>, tensor<32xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-2055.0) step(1.0) : tensor<16xf32>
    %output = check.generate.fill value(-99.0) : tensor<32xf32>
    check.compare<@radian_trigonometry, @radian_trigonometry_reference>(%input, %output) : (tensor<16xf32>, tensor<32xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xf32>
      check.expect.approximate actual(%output) expected(%output) atol(0.025000000000000001) rtol(0.0) nan(same) : tensor<32xf32>, tensor<32xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(262128.0) step(1.0) : tensor<16xf32>
    %output = check.generate.fill value(-99.0) : tensor<32xf32>
    check.compare<@radian_trigonometry, @radian_trigonometry_reference>(%input, %output) : (tensor<16xf32>, tensor<32xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xf32>
      check.expect.approximate actual(%output) expected(%output) atol(0.025000000000000001) rtol(0.0) nan(same) : tensor<32xf32>, tensor<32xf32>
    }
  }
  check.return
}
