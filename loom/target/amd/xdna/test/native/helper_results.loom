// Native helpers return scalar and pointer values through separate register
// banks. The first call's complete result set survives a second call before
// its scalar values and returned subview are consumed.
aie2p.target<array> @array_target

func.def noinline @select_values(%input: view<32xi32>, %position: index) -> (i32, f32, view<16xi32>, i32, bf16) where [range(%position, 0, 15)] {
  %value = view.load %input[%position] : view<32xi32> -> i32
  %float = scalar.bitcast %value : i32 to f32
  %selected = view.subview %input[%position] : view<32xi32> -> view<16xi32>
  %short = scalar.trunci %value : i32 to i16
  %narrow = scalar.bitcast %short : i16 to bf16
  func.return %value, %float, %selected, %value, %narrow : i32, f32, view<16xi32>, i32, bf16
}

func.def inline @select_and_store(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<32xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<8x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %end step %step] {
    %later = index.add %position, %end : index
    %value, %float, %selected, %duplicate, %narrow = func.call @select_values(%source, %position) : (view<32xi32>, index) -> (i32, f32, view<16xi32>, i32, bf16)
    %next, %next_float, %next_selected, %unused_duplicate, %unused_narrow = func.call @select_values(%source, %later) : (view<32xi32>, index) -> (i32, f32, view<16xi32>, i32, bf16)
    %bits = scalar.bitcast %float : f32 to i32
    %pointed = view.load %selected[0] : view<16xi32> -> i32
    %short = scalar.bitcast %narrow : bf16 to i16
    %wide = scalar.extui %short : i16 to i32
    %next_bits = scalar.bitcast %next_float : f32 to i32
    %next_pointed = view.load %next_selected[0] : view<16xi32> -> i32
    view.store %value, %destination[%position, 0] : i32, view<8x8xi32>
    view.store %bits, %destination[%position, 1] : i32, view<8x8xi32>
    view.store %pointed, %destination[%position, 2] : i32, view<8x8xi32>
    view.store %duplicate, %destination[%position, 3] : i32, view<8x8xi32>
    view.store %wide, %destination[%position, 4] : i32, view<8x8xi32>
    view.store %next, %destination[%position, 5] : i32, view<8x8xi32>
    view.store %next_bits, %destination[%position, 6] : i32, view<8x8xi32>
    view.store %next_pointed, %destination[%position, 7] : i32, view<8x8xi32>
  }
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @helper_results() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 64} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 128 : offset
  %output_bytes = index.constant 256 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %input_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x32xi32>
  %incoming = channel.bind<fifo> %input_slots, %capacity : view<1x32xi32>, index -> channel<tile<32xi32>>
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_bytes : buffer
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x64xi32>
  %outgoing = channel.bind<fifo> %output_slots, %capacity : view<1x64xi32>, index -> channel<tile<64xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_input = buffer.view %input[%origin] : buffer -> view<32xi32>
    %write, %destination = channel.reserve %incoming : channel<tile<32xi32>> -> (write<tile<32xi32>>, view<32xi32>)
    %ingress = kernel.async.copy %external_input to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<32xi32> to view<32xi32> -> kernel.async.token
    %incoming_group = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %incoming_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<32xi32>>
    %read, %source = channel.acquire %outgoing : channel<tile<64xi32>> -> (read<tile<64xi32>>, view<64xi32>)
    %external_output = buffer.view %output[%origin] : buffer -> view<64xi32>
    %egress = kernel.async.copy %source to %external_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<64xi32> to view<64xi32> -> kernel.async.token
    %outgoing_group = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<64xi32>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %unused_input = channel.acquire %incoming : channel<tile<32xi32>> -> (read<tile<32xi32>>, view<32xi32>)
    %write, %unused_output = channel.reserve %outgoing : channel<tile<64xi32>> -> (write<tile<64xi32>>, view<64xi32>)
    func.call @select_and_store(%input_storage, %output_storage) : (buffer, buffer)
    channel.release %read : read<tile<32xi32>>
    channel.publish %write : write<tile<64xi32>>
  }
}

func.def @helper_results_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<32xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<8x8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %mask = scalar.constant 65535 : i32
  scf.for %position = [%begin to %end step %step] {
    %later = index.add %position, %end : index
    %value = view.load %source[%position] : view<32xi32> -> i32
    %next = view.load %source[%later] : view<32xi32> -> i32
    %short = scalar.andi %value, %mask : i32
    view.store %value, %destination[%position, 0] : i32, view<8x8xi32>
    view.store %value, %destination[%position, 1] : i32, view<8x8xi32>
    view.store %value, %destination[%position, 2] : i32, view<8x8xi32>
    view.store %value, %destination[%position, 3] : i32, view<8x8xi32>
    view.store %short, %destination[%position, 4] : i32, view<8x8xi32>
    view.store %next, %destination[%position, 5] : i32, view<8x8xi32>
    view.store %next, %destination[%position, 6] : i32, view<8x8xi32>
    view.store %next, %destination[%position, 7] : i32, view<8x8xi32>
  }
  func.return
}

check.scenario public @returned_values_survive_peer_call {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %storage = check.generate.fill value(-1515870811) : tensor<96xi32>
    %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    check.compare<@helper_results, @helper_results_reference>(%input, %output) : (tensor<32xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi32>
    }
  }
  check.return
}
