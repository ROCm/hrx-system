load("//loom/build_tools/bazel:defs.bzl", "loom_corpus_test")
load("//loom/src/loom/test/corpus:catalog.bzl", "LOOM_CORPUS")
load("//loom/target/amd/xdna:execution_profiles.bzl", "XDNA_HARDWARE_PROFILE")

package(default_visibility = ["//visibility:public"])

loom_corpus_test(
    name = "execution",
    catalog = LOOM_CORPUS,
    execution_profiles = [XDNA_HARDWARE_PROFILE],
    profile_sources = {
        XDNA_HARDWARE_PROFILE.name: [
            "memory/address/tiled_channel.loom",
            "numeric/vector/bfloat_extrema_reductions.loom",
            "numeric/vector/constants.loom",
            "numeric/vector/f32.loom",
            "numeric/vector/integer_extrema_reductions.loom",
            "numeric/vector/integer_widening.loom",
        ],
    },
    xfails = {
        XDNA_HARDWARE_PROFILE.name: {
            "memory/address/tiled_channel.loom:@tiled_channel_values": "XDNA/051",
            "numeric/vector/constants.loom:@vector_coordinate_constant_values": "XDNA/051",
            "numeric/vector/constants.loom:@vector_f64_constant_selection_values": "XDNA/051",
            "numeric/vector/constants.loom:@vector_predicate_constant_values": "XDNA/051",
            "numeric/vector/f32.loom:@vector_bf16_origin_scale_values": "XDNA/051",
            "numeric/vector/f32.loom:@vector_f32_arithmetic_values": "XDNA/051",
            "numeric/vector/f32.loom:@vector_f32_comparisons_no_nan_values": "XDNA/051",
            "numeric/vector/f32.loom:@vector_f32_division_values": "XDNA/051",
            "numeric/vector/f32.loom:@vector_f32_rounding_values": "XDNA/051",
            "numeric/vector/f32.loom:@vector_f32_sign_values": "XDNA/051",
            "numeric/vector/f32.loom:@vector_f32_square_root_values": "XDNA/051",
        },
    },
)
