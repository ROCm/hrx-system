func.decl @packed_update(%output: buffer, %output_origin: offset)

func.decl @packed_copy(%input: buffer, %input_origin: offset, %output: buffer, %output_origin: offset)

aie2p.target<array> @npu

pipeline.def<kernel> public retain target(@npu) @copy_packed_records() run(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 256 : offset
  %output_bytes = index.constant 256 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %input_bytes : buffer
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x256xi8>
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x256xi8>
  %inputs = channel.bind<fifo> %input_slots, %capacity : view<1x256xi8>, index -> channel<tile<256xi8>>
  %outputs = channel.bind<fifo> %output_slots, %capacity : view<1x256xi8>, index -> channel<tile<256xi8>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_input = buffer.view %source[%origin] : buffer -> view<256xi8>
    %write, %incoming = channel.reserve %inputs : channel<tile<256xi8>> -> (write<tile<256xi8>>, view<256xi8>)
    %ingress = kernel.async.copy %external_input to %incoming {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<256xi8> to view<256xi8> -> kernel.async.token
    %ingress_group = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %ingress_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<256xi8>>
    %read, %outgoing = channel.acquire %outputs : channel<tile<256xi8>> -> (read<tile<256xi8>>, view<256xi8>)
    %external_output = buffer.view %destination[%origin] : buffer -> view<256xi8>
    %egress = kernel.async.copy %outgoing to %external_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<256xi8> to view<256xi8> -> kernel.async.token
    %egress_group = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %egress_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<256xi8>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %incoming = channel.acquire %inputs : channel<tile<256xi8>> -> (read<tile<256xi8>>, view<256xi8>)
    %write, %outgoing = channel.reserve %outputs : channel<tile<256xi8>> -> (write<tile<256xi8>>, view<256xi8>)
    func.call @packed_copy(%input_storage, %origin, %output_storage, %origin) : (buffer, offset, buffer, offset)
    func.call @packed_update(%output_storage, %origin) : (buffer, offset)
    channel.publish %write : write<tile<256xi8>>
    channel.release %read : read<tile<256xi8>>
  }
}

func.def @generate_packed_input(%trial: index, %input: buffer) {
  %origin = index.constant 0 : offset
  %bytes = buffer.view %input[%origin] : buffer -> view<256xi8>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %record = index.cast %trial : index to i32
  %c41 = scalar.constant 41 : i32
  %bias = scalar.muli %record, %c41 : i32
  scf.for %i = [%c0 to %c256 step %c1] {
    %position = index.cast %i : index to i32
    %value = scalar.addi %position, %bias : i32
    %byte = scalar.trunci %value : i32 to i8
    view.store %byte, %bytes[%i] : i8, view<256xi8>
  }
  func.return
}

func.def @packed_memory_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<256xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<256xi8>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c5 = index.constant 5 : index
  %c120 = index.constant 120 : index
  %c256 = index.constant 256 : index
  %guard = scalar.constant 37 : i8
  scf.for %i = [%c0 to %c256 step %c1] {
    view.store %guard, %destination[%i] : i8, view<256xi8>
  }
  scf.for %i = [%c0 to %c120 step %c1] {
    %input_position = index.add %i, %c1 : index
    %output_position = index.add %i, %c5 : index
    %byte = view.load %source[%input_position] : view<256xi8> -> i8
    view.store %byte, %destination[%output_position] : i8, view<256xi8>
  }
  // The nested packed record places its float at 29, byte at 33, and word at 34.
  %c0_i8 = scalar.constant 0 : i8
  %c1_i8 = scalar.constant 1 : i8
  %c32_i8 = scalar.constant 32 : i8
  %c64_i8 = scalar.constant 64 : i8
  view.store %c0_i8, %destination[29] : i8, view<256xi8>
  view.store %c0_i8, %destination[30] : i8, view<256xi8>
  view.store %c32_i8, %destination[31] : i8, view<256xi8>
  view.store %c64_i8, %destination[32] : i8, view<256xi8>
  view.store %c0_i8, %destination[33] : i8, view<256xi8>
  view.store %c1_i8, %destination[34] : i8, view<256xi8>
  view.store %c0_i8, %destination[35] : i8, view<256xi8>
  view.store %c0_i8, %destination[36] : i8, view<256xi8>
  view.store %c64_i8, %destination[37] : i8, view<256xi8>
  func.return
}

check.scenario @packed_record_values {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(90) : tensor<384xi8>
    %input = check.tensor.view %input_storage offset(64) : tensor<384xi8> -> tensor<256xi8>
    check.generate<@generate_packed_input>(%trial, %input) : (index, tensor<256xi8>) -> ()
    %output_storage = check.generate.fill value(-52) : tensor<384xi8>
    %output = check.tensor.view %output_storage offset(64) : tensor<384xi8> -> tensor<256xi8>
    check.compare<@copy_packed_records, @packed_memory_reference>(%input, %output) : (tensor<256xi8>, tensor<256xi8>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<384xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<384xi8>
    }
  }
  check.return
}
