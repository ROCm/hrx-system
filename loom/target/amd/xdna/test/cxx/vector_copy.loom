func.decl @copy_blocks(%input: buffer, %input_origin: offset, %output: buffer, %output_origin: offset)

aie2p.target<array> @npu

pipeline.def<kernel> public retain target(@npu) @copy_strided_blocks() run(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 4096 : offset
  %output_bytes = index.constant 4096 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %input_bytes : buffer
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x4096xi8>
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x4096xi8>
  %inputs = channel.bind<fifo> %input_slots, %capacity : view<1x4096xi8>, index -> channel<tile<4096xi8>>
  %outputs = channel.bind<fifo> %output_slots, %capacity : view<1x4096xi8>, index -> channel<tile<4096xi8>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_input = buffer.view %source[%origin] : buffer -> view<4096xi8>
    %write, %incoming = channel.reserve %inputs : channel<tile<4096xi8>> -> (write<tile<4096xi8>>, view<4096xi8>)
    %ingress = kernel.async.copy %external_input to %incoming {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xi8> to view<4096xi8> -> kernel.async.token
    %ingress_group = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %ingress_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<4096xi8>>
    %read, %outgoing = channel.acquire %outputs : channel<tile<4096xi8>> -> (read<tile<4096xi8>>, view<4096xi8>)
    %external_output = buffer.view %destination[%origin] : buffer -> view<4096xi8>
    %egress = kernel.async.copy %outgoing to %external_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xi8> to view<4096xi8> -> kernel.async.token
    %egress_group = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %egress_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<4096xi8>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %incoming = channel.acquire %inputs : channel<tile<4096xi8>> -> (read<tile<4096xi8>>, view<4096xi8>)
    %write, %outgoing = channel.reserve %outputs : channel<tile<4096xi8>> -> (write<tile<4096xi8>>, view<4096xi8>)
    func.call @copy_blocks(%input_storage, %origin, %output_storage, %origin) : (buffer, offset, buffer, offset)
    channel.publish %write : write<tile<4096xi8>>
    channel.release %read : read<tile<4096xi8>>
  }
}

func.def @generate_copy_input(%trial: index, %input: buffer) {
  %origin = index.constant 0 : offset
  %words = buffer.view %input[%origin] : buffer -> view<1024xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c1024 = index.constant 1024 : index
  %record = index.cast %trial : index to i32
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c3_i32 = scalar.constant 3 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c5_i32 = scalar.constant 5 : i32
  %c19_i32 = scalar.constant 19 : i32
  %c20_i32 = scalar.constant 20 : i32
  %record_scale = scalar.constant 270544961 : i32
  %word_scale = scalar.constant 1114113 : i32
  %ordinal = scalar.addi %record, %c1_i32 : i32
  %bias = scalar.muli %ordinal, %record_scale : i32
  scf.for %i = [%c0 to %c1024 step %c1] {
    %position = index.cast %i : index to i32
    %scaled = scalar.muli %position, %word_scale : i32
    %value = scalar.addi %scaled, %bias : i32
    view.store %value, %words[%i] : i32, view<1024xi32>
  }
  %is0 = scalar.cmpi eq, %record, %c0_i32 : i32
  %is1 = scalar.cmpi eq, %record, %c1_i32 : i32
  %is2 = scalar.cmpi eq, %record, %c2_i32 : i32
  %is3 = scalar.cmpi eq, %record, %c3_i32 : i32
  %is4 = scalar.cmpi eq, %record, %c4_i32 : i32
  %is5 = scalar.cmpi eq, %record, %c5_i32 : i32
  %large_count = scf.select %is5, %c19_i32, %c20_i32 : i32
  %medium_count = scf.select %is2, %c4_i32, %large_count : i32
  %small_count = scf.select %is1, %c1_i32, %medium_count : i32
  %count = scf.select %is0, %c0_i32, %small_count : i32
  %source_unit = scalar.ori %is0, %is3 : i1
  %source_triple = scalar.ori %is1, %is4 : i1
  %source_multiple = scf.select %source_triple, %c3_i32, %c2_i32 : i32
  %source_stride = scf.select %source_unit, %c1_i32, %source_multiple : i32
  %destination_unit = scalar.ori %source_unit, %is2 : i1
  %destination_stride = scf.select %destination_unit, %c1_i32, %c2_i32 : i32
  %shifted = scalar.ori %source_triple, %is2 : i1
  %destination_origin = scf.select %shifted, %c1_i32, %c0_i32 : i32
  view.store %count, %words[0] : i32, view<1024xi32>
  view.store %source_stride, %words[1] : i32, view<1024xi32>
  view.store %destination_stride, %words[2] : i32, view<1024xi32>
  view.store %destination_origin, %words[3] : i32, view<1024xi32>
  func.return
}

func.def @copy_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1024xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<1024xi32>
  %count_value = view.load %source[0] : view<1024xi32> -> i32
  %source_stride_value = view.load %source[1] : view<1024xi32> -> i32
  %destination_stride_value = view.load %source[2] : view<1024xi32> -> i32
  %destination_origin_value = view.load %source[3] : view<1024xi32> -> i32
  %count_input = index.cast %count_value : i32 to index
  %source_stride_input = index.cast %source_stride_value : i32 to index
  %destination_stride_input = index.cast %destination_stride_value : i32 to index
  %destination_origin_input = index.cast %destination_origin_value : i32 to index
  // These are the same header bounds required by the imported copy function.
  %count = index.assume %count_input [range(%count_input, 0, 20)] : index
  %source_stride = index.assume %source_stride_input [range(%source_stride_input, 0, 3)] : index
  %destination_stride = index.assume %destination_stride_input [range(%destination_stride_input, 0, 2)] : index
  %destination_origin = index.assume %destination_origin_input [range(%destination_origin_input, 0, 1)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c1024 = index.constant 1024 : index
  %guard = scalar.constant 1806551806 : i32
  scf.for %i = [%c0 to %c1024 step %c1] {
    view.store %guard, %destination[%i] : i32, view<1024xi32>
  }
  %word_count = index.mul %count, %c16 : index
  scf.for %i = [%c0 to %word_count step %c1] {
    %block = index.div %i, %c16 : index
    %lane = index.rem %i, %c16 : index
    %source_block = index.mul %block, %source_stride : index
    %source_base = index.mul %source_block, %c16 : index
    %source_body = index.add %source_base, %c16 : index
    %source_position = index.add %source_body, %lane : index
    %destination_block = index.mul %block, %destination_stride : index
    %destination_shifted = index.add %destination_block, %destination_origin : index
    %destination_base = index.mul %destination_shifted, %c16 : index
    %destination_position = index.add %destination_base, %lane : index
    %value = view.load %source[%source_position] : view<1024xi32> -> i32
    view.store %value, %destination[%destination_position] : i32, view<1024xi32>
  }
  func.return
}

check.scenario @strided_copy_values {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(90) : tensor<4224xi8>
    %input = check.tensor.view %input_storage offset(64) : tensor<4224xi8> -> tensor<4096xi8>
    check.generate<@generate_copy_input>(%trial, %input) : (index, tensor<4096xi8>) -> ()
    %output_storage = check.generate.fill value(-52) : tensor<4224xi8>
    %output = check.tensor.view %output_storage offset(64) : tensor<4224xi8> -> tensor<4096xi8>
    check.compare<@copy_strided_blocks, @copy_reference>(%input, %output) : (tensor<4096xi8>, tensor<4096xi8>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<4224xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<4224xi8>
    }
  }
  check.return
}
