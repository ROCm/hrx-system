func.decl @bitcast_blocks(%input: buffer, %input_origin: offset, %output: buffer, %output_origin: offset)

aie2p.target<array> @npu

pipeline.def<kernel> public retain target(@npu) @bitcast_payloads() run(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 1024 : offset
  %output_bytes = index.constant 8192 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %input_bytes : buffer
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x1024xi8>
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x8192xi8>
  %inputs = channel.bind<fifo> %input_slots, %capacity : view<1x1024xi8>, index -> channel<tile<1024xi8>>
  %outputs = channel.bind<fifo> %output_slots, %capacity : view<1x8192xi8>, index -> channel<tile<8192xi8>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_input = buffer.view %source[%origin] : buffer -> view<1024xi8>
    %write, %incoming = channel.reserve %inputs : channel<tile<1024xi8>> -> (write<tile<1024xi8>>, view<1024xi8>)
    %ingress = kernel.async.copy %external_input to %incoming {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1024xi8> to view<1024xi8> -> kernel.async.token
    %ingress_group = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %ingress_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1024xi8>>
    %read, %outgoing = channel.acquire %outputs : channel<tile<8192xi8>> -> (read<tile<8192xi8>>, view<8192xi8>)
    %external_output = buffer.view %destination[%origin] : buffer -> view<8192xi8>
    %egress = kernel.async.copy %outgoing to %external_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<8192xi8> to view<8192xi8> -> kernel.async.token
    %egress_group = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %egress_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<8192xi8>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %incoming = channel.acquire %inputs : channel<tile<1024xi8>> -> (read<tile<1024xi8>>, view<1024xi8>)
    %write, %outgoing = channel.reserve %outputs : channel<tile<8192xi8>> -> (write<tile<8192xi8>>, view<8192xi8>)
    func.call @bitcast_blocks(%input_storage, %origin, %output_storage, %origin) : (buffer, offset, buffer, offset)
    channel.publish %write : write<tile<8192xi8>>
    channel.release %read : read<tile<1024xi8>>
  }
}

// Each lane visits all byte payloads with a distinct odd multiplier.
func.def @generate_bitcast_input(%trial: index, %input: buffer) {
  %origin = index.constant 0 : offset
  %bytes = buffer.view %input[%origin] : buffer -> view<1024xi8>
  %begin = index.constant 0 : index
  %end = index.constant 1024 : index
  %step = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c19_i32 = scalar.constant 19 : i32
  %c37_i32 = scalar.constant 37 : i32
  %record = index.cast %trial : index to i32
  %record_bias = scalar.muli %record, %c37_i32 : i32
  scf.for %i = [%begin to %end step %step] {
    %word = index.div %i, %c4 : index
    %lane = index.rem %i, %c4 : index
    %word_i32 = index.cast %word : index to i32
    %lane_i32 = index.cast %lane : index to i32
    %twice_lane = scalar.muli %lane_i32, %c2_i32 : i32
    %multiplier = scalar.addi %twice_lane, %c1_i32 : i32
    %scaled_word = scalar.muli %word_i32, %multiplier : i32
    %lane_bias = scalar.muli %lane_i32, %c19_i32 : i32
    %bias = scalar.addi %lane_bias, %record_bias : i32
    %value = scalar.addi %scaled_word, %bias : i32
    %byte = scalar.trunci %value : i32 to i8
    view.store %byte, %bytes[%i] : i8, view<1024xi8>
  }
  func.return
}

// Observe transport as bytes so no floating conversion can quiet a NaN or
// erase signed zero in the independent oracle.
func.def @bitcast_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1024xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<8192xi8>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %c20 = index.constant 20 : index
  %c28 = index.constant 28 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %c1024 = index.constant 1024 : index
  %snan = scalar.constant 125 : i8
  %c128_i8 = scalar.constant -128 : i8
  scf.for %word = [%c0 to %c256 step %c1] {
    %input_origin = index.mul %word, %c4 : index
    %output_origin = index.mul %word, %c32 : index
    scf.for %lane = [%c0 to %c4 step %c1] {
      %reverse_lane = index.sub %c3, %lane : index
      %reverse_position = index.add %input_origin, %reverse_lane : index
      %reversed = view.load %source[%reverse_position] : view<1024xi8> -> i8
      %bias = index.add %lane, %c1 : index
      %bias_byte = index.cast %bias : index to i8
      %biased = scalar.addi %reversed, %bias_byte : i8
      %position = index.add %output_origin, %lane : index
      view.store %biased, %destination[%position] : i8, view<8192xi8>
      %e5_position = index.add %position, %c16 : index
      view.store %reversed, %destination[%e5_position] : i8, view<8192xi8>
      %rotated = index.add %lane, %c2 : index
      %half_lane = index.rem %rotated, %c4 : index
      %half_position = index.add %input_origin, %half_lane : index
      %half_byte = view.load %source[%half_position] : view<1024xi8> -> i8
      %f16_position = index.add %position, %c4 : index
      %bf16_position = index.add %position, %c8 : index
      view.store %half_byte, %destination[%f16_position] : i8, view<8192xi8>
      view.store %half_byte, %destination[%bf16_position] : i8, view<8192xi8>
      %twice_lane = index.mul %lane, %c2 : index
      %odd_lane = index.add %twice_lane, %c1 : index
      %half = index.div %lane, %c2 : index
      %unwrapped = index.sub %odd_lane, %half : index
      %e4_lane = index.rem %unwrapped, %c4 : index
      %e4_source_position = index.add %input_origin, %e4_lane : index
      %e4_byte = view.load %source[%e4_source_position] : view<1024xi8> -> i8
      %e4_position = index.add %position, %c12 : index
      view.store %e4_byte, %destination[%e4_position] : i8, view<8192xi8>
      %input_position = index.add %input_origin, %lane : index
      %input_byte = view.load %source[%input_position] : view<1024xi8> -> i8
      %is_first = index.cmp eq, %lane, %c0 : index
      %is_third = index.cmp eq, %lane, %c2 : index
      %with_nan = scf.select %is_first, %snan, %input_byte : i8
      %mixed = scf.select %is_third, %c128_i8, %with_nan : i8
      %mixed_position = index.add %position, %c28 : index
      view.store %mixed, %destination[%mixed_position] : i8, view<8192xi8>
    }
    scf.for %lane = [%c0 to %c8 step %c1] {
      %reverse_lane = index.sub %c7, %lane : index
      %unwrapped = index.add %input_origin, %reverse_lane : index
      %source_position = index.rem %unwrapped, %c1024 : index
      %byte = view.load %source[%source_position] : view<1024xi8> -> i8
      %wide_origin = index.add %output_origin, %c20 : index
      %position = index.add %wide_origin, %lane : index
      view.store %byte, %destination[%position] : i8, view<8192xi8>
    }
  }
  func.return
}

check.scenario @bitcast_payload_values {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(90) : tensor<1152xi8>
    %input = check.tensor.view %input_storage offset(64) : tensor<1152xi8> -> tensor<1024xi8>
    check.generate<@generate_bitcast_input>(%trial, %input) : (index, tensor<1024xi8>) -> ()
    %output_storage = check.generate.fill value(-52) : tensor<8320xi8>
    %output = check.tensor.view %output_storage offset(64) : tensor<8320xi8> -> tensor<8192xi8>
    check.compare<@bitcast_payloads, @bitcast_reference>(%input, %output) : (tensor<1024xi8>, tensor<8192xi8>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1152xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<8320xi8>
    }
  }
  check.return
}
