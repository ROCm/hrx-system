load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test")
load("//loom/target/amd/xdna:execution_profiles.bzl", "XDNA_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_CXX_COMPATIBLE_WITH = loom_config_compatible_with(["//loom/config/import:cxx"])

_XDNA_CXX_COMPILE_COMPATIBLE_WITH = _CXX_COMPATIBLE_WITH + loom_config_compatible_with([
    "//loom/config/emit:aie2p_elf",
])

_LOWERING_DATA = {
    "boolean_storage": ["//loom/src/loom/import/cxx/test:boolean_storage.cxx"],
    "vector_lookup": ["//loom/src/loom/import/cxx/test:vector_lookup.cxx"],
}

[
    loom_check_test(
        name = name + "_lowering",
        src = name + ".cxx-test",
        data = _LOWERING_DATA.get(name, []),
        runner = "//loom/src/loom/tools/loom-check",
        target_compatible_with = _XDNA_CXX_COMPILE_COMPATIBLE_WITH,
    )
    for name in [
        "assembly",
        "boolean_storage",
        "ordinary_function",
        "vector_lookup",
    ]
]

[
    loom_test(
        name = name + "_execution_test",
        srcs = [
            name + ".cxx",
            name + ".loom",
        ],
        benchmark_smoke = False,
        execution_profiles = [XDNA_HARDWARE_PROFILE],
        target_compatible_with = _CXX_COMPATIBLE_WITH,
    )
    for name in [
        "assembly_fifo",
        "assembly_pack",
    ]
]

[
    loom_test(
        name = name + "_execution_test",
        srcs = [name + ".loom"],
        benchmark_smoke = False,
        execution_profiles = [XDNA_HARDWARE_PROFILE],
        target_compatible_with = _CXX_COMPATIBLE_WITH,
        deps = ["//loom/src/loom/import/cxx/test:vector_memory_library"],
    )
    for name in [
        "bitcast",
        "buffer_selection",
        "vector_copy",
    ]
]

loom_test(
    name = "packed_memory_execution_test",
    srcs = [
        "packed_memory.loom",
        "//loom/src/loom/import/cxx/test:packed_memory.cxx",
    ],
    benchmark_smoke = False,
    execution_profiles = [XDNA_HARDWARE_PROFILE],
    target_compatible_with = _CXX_COMPATIBLE_WITH,
)

loom_test(
    name = "padded_vectors_execution_test",
    benchmark_smoke = False,
    execution_profiles = [XDNA_HARDWARE_PROFILE],
    module = "//loom/src/loom/import/cxx/test:padded_vectors_module",
    target_compatible_with = _CXX_COMPATIBLE_WITH,
)
