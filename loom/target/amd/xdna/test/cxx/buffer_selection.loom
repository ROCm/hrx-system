func.decl @select_buffers(%input: buffer, %input_origin: offset, %output: buffer, %output_origin: offset)

aie2p.target<array> @npu

pipeline.def<kernel> public retain target(@npu) @select_buffer_roots() run(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 1024 : offset
  %output_bytes = index.constant 1024 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %input_bytes : buffer
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x1024xi8>
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x1024xi8>
  %inputs = channel.bind<fifo> %input_slots, %capacity : view<1x1024xi8>, index -> channel<tile<1024xi8>>
  %outputs = channel.bind<fifo> %output_slots, %capacity : view<1x1024xi8>, index -> channel<tile<1024xi8>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_input = buffer.view %source[%origin] : buffer -> view<1024xi8>
    %write, %incoming = channel.reserve %inputs : channel<tile<1024xi8>> -> (write<tile<1024xi8>>, view<1024xi8>)
    %ingress = kernel.async.copy %external_input to %incoming {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1024xi8> to view<1024xi8> -> kernel.async.token
    %ingress_group = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %ingress_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1024xi8>>
    %read, %outgoing = channel.acquire %outputs : channel<tile<1024xi8>> -> (read<tile<1024xi8>>, view<1024xi8>)
    %external_output = buffer.view %destination[%origin] : buffer -> view<1024xi8>
    %egress = kernel.async.copy %outgoing to %external_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1024xi8> to view<1024xi8> -> kernel.async.token
    %egress_group = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %egress_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1024xi8>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %incoming = channel.acquire<mutable> %inputs : channel<tile<1024xi8>> -> (read<tile<1024xi8>, mutable>, view<1024xi8>)
    %write, %outgoing = channel.reserve %outputs : channel<tile<1024xi8>> -> (write<tile<1024xi8>>, view<1024xi8>)
    func.call @select_buffers(%input_storage, %origin, %output_storage, %origin) : (buffer, offset, buffer, offset)
    channel.publish %write : write<tile<1024xi8>>
    channel.release %read : read<tile<1024xi8>, mutable>
  }
}

func.def @generate_selection_input(%trial: index, %input: buffer) {
  %origin = index.constant 0 : offset
  %words = buffer.view %input[%origin] : buffer -> view<256xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %record = index.cast %trial : index to i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c9_i32 = scalar.constant 9 : i32
  %record_scale = scalar.constant 270544961 : i32
  %word_scale = scalar.constant 1114113 : i32
  %ordinal = scalar.addi %record, %c1_i32 : i32
  %bias = scalar.muli %ordinal, %record_scale : i32
  scf.for %i = [%c0 to %c256 step %c1] {
    %position = index.cast %i : index to i32
    %scaled = scalar.muli %position, %word_scale : i32
    %value = scalar.addi %scaled, %bias : i32
    view.store %value, %words[%i] : i32, view<256xi32>
  }
  %last = scalar.cmpi eq, %record, %c9_i32 : i32
  %count = scf.select %last, %c2_i32, %record : i32
  view.store %count, %words[0] : i32, view<256xi32>
  view.store %record, %words[1] : i32, view<256xi32>
  func.return
}

func.def @selection_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<256xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<256xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c128 = index.constant 128 : index
  %c160 = index.constant 160 : index
  %c192 = index.constant 192 : index
  %c224 = index.constant 224 : index
  %c240 = index.constant 240 : index
  %c256 = index.constant 256 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %guard = scalar.constant 1806499840 : i32
  %mask = scalar.constant 2130771840 : i32
  %count = view.load %source[0] : view<256xi32> -> i32
  %choice = view.load %source[1] : view<256xi32> -> i32
  scf.for %i = [%c0 to %c256 step %c1] {
    %position = index.cast %i : index to i32
    %value = scalar.addi %guard, %position : i32
    view.store %value, %destination[%i] : i32, view<256xi32>
  }
  scf.for %i = [%c0 to %c16 step %c1] {
    %first_position = index.add %i, %c16 : index
    %second_position = index.add %i, %c64 : index
    %first = view.load %source[%first_position] : view<256xi32> -> i32
    %second = view.load %destination[%second_position] : view<256xi32> -> i32
    %word = index.cast %i : index to i32
    %selector = scalar.addi %choice, %word : i32
    %parity = scalar.andi %selector, %c1_i32 : i32
    %choose_input = scalar.cmpi ne, %parity, %c0_i32 : i32
    %selected = scf.select %choose_input, %first, %second : i32
    %updated = scalar.xori %selected, %mask : i32
    %first_after = scf.select %choose_input, %updated, %first : i32
    %second_after = scf.select %choose_input, %second, %updated : i32
    %selected_position = index.add %i, %c128 : index
    %first_after_position = index.add %i, %c160 : index
    %second_after_position = index.add %i, %c192 : index
    view.store %second_after, %destination[%second_position] : i32, view<256xi32>
    view.store %updated, %destination[%selected_position] : i32, view<256xi32>
    view.store %first_after, %destination[%first_after_position] : i32, view<256xi32>
    view.store %second_after, %destination[%second_after_position] : i32, view<256xi32>
    %first_tail_position = index.add %i, %c32 : index
    %second_tail_position = index.add %i, %c96 : index
    %first_tail = view.load %source[%first_tail_position] : view<256xi32> -> i32
    %second_tail = view.load %destination[%second_tail_position] : view<256xi32> -> i32
    %odd = scalar.andi %count, %c1_i32 : i32
    %swapped = scalar.cmpi ne, %odd, %c0_i32 : i32
    %current = scf.select %swapped, %second_tail, %first_tail : i32
    %other = scf.select %swapped, %first_tail, %second_tail : i32
    %current_position = index.add %i, %c224 : index
    %other_position = index.add %i, %c240 : index
    view.store %current, %destination[%current_position] : i32, view<256xi32>
    view.store %other, %destination[%other_position] : i32, view<256xi32>
  }
  func.return
}

check.scenario @selected_buffer_values {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(90) : tensor<1152xi8>
    %input = check.tensor.view %input_storage offset(64) : tensor<1152xi8> -> tensor<1024xi8>
    check.generate<@generate_selection_input>(%trial, %input) : (index, tensor<1024xi8>) -> ()
    %output_storage = check.generate.fill value(-52) : tensor<1152xi8>
    %output = check.tensor.view %output_storage offset(64) : tensor<1152xi8> -> tensor<1024xi8>
    check.compare<@select_buffer_roots, @selection_reference>(%input, %output) : (tensor<1024xi8>, tensor<1024xi8>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1152xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<1152xi8>
    }
  }
  check.return
}
