load("//build_tools/bazel:executable.bzl", "iree_tool_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_kernel_binary",
    "loom_target_profile",
    "loom_target_set",
)

package(default_visibility = ["//visibility:public"])

_SPIRV_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:spirv_binary",
])

loom_target_profile(
    name = "vulkan1.3+bda",
    family = "spirv",
    selector = "vulkan1.3+bda",
    target_compatible_with = _SPIRV_ARTIFACTS_COMPATIBLE_WITH,
)

loom_target_profile(
    name = "vulkan1.3+bda+extended-types",
    family = "spirv",
    selector = "vulkan1.3+bda+extended-types",
    target_compatible_with = _SPIRV_ARTIFACTS_COMPATIBLE_WITH,
)

loom_target_profile(
    name = "vulkan1.3+bda+subgroup32+ballot+hal",
    family = "spirv",
    selector = "vulkan1.3+bda+subgroup32+ballot+hal",
    target_compatible_with = _SPIRV_ARTIFACTS_COMPATIBLE_WITH,
)

loom_target_set(
    name = "all",
    allow_empty = True,
    targets = select({
        "//loom/config/emit:spirv_binary": [
            ":vulkan1.3+bda",
            ":vulkan1.3+bda+extended-types",
            ":vulkan1.3+bda+subgroup32+ballot+hal",
        ],
        "//conditions:default": [],
    }),
)

loom_kernel_binary(
    name = "copy_i32_test_binary",
    testonly = True,
    srcs = ["copy_i32.loom"],
    out = "copy_i32_test.spv",
    tags = ["skip-bazel_to_cmake"],
    target = ":vulkan1.3+bda",
    target_compatible_with = _SPIRV_ARTIFACTS_COMPATIBLE_WITH,
    visibility = ["//visibility:private"],
)

iree_tool_test(
    name = "copy_i32_test",
    src = "//third_party:spirv_val",
    args = [
        "--target-env",
        "vulkan1.3",
        "$(rootpath :copy_i32_test_binary)",
    ],
    data = [":copy_i32_test_binary"],
    tags = [
        "hostonly",
        "skip-bazel_to_cmake",
    ],
    target_compatible_with = _SPIRV_ARTIFACTS_COMPATIBLE_WITH,
    visibility = ["//visibility:private"],
)
