check.case @scalar_payload_f16_case {
  check.requires<hal.vulkan.feature> {feature = "shader_float16"}
  check.requires<hal.vulkan.feature> {feature = "storage_buffer_16bit_access"}
  %value0 = check.literal value(-0.0) : f16
  %output0 = check.generate.fill value(19.0) : tensor<1xf16>
  %expected0 = check.generate.fill value(-0.0) : tensor<1xf16>
  %value1 = check.literal value(5.9604644775390625e-08) : f16
  %output1 = check.generate.fill value(19.0) : tensor<1xf16>
  %expected1 = check.generate.fill value(5.9604644775390625e-08) : tensor<1xf16>
  %value2 = check.literal value(-7.25) : f16
  %output2 = check.generate.fill value(19.0) : tensor<1xf16>
  %expected2 = check.generate.fill value(-7.25) : tensor<1xf16>
  kernel.launch @scalar_payload_f16(%value0, %value1, %value2, %output0, %output1, %output2) : (f16, f16, f16, tensor<1xf16>, tensor<1xf16>, tensor<1xf16>)
  check.expect.bitwise actual(%output0) expected(%expected0) : tensor<1xf16>
  check.expect.bitwise actual(%output1) expected(%expected1) : tensor<1xf16>
  check.expect.bitwise actual(%output2) expected(%expected2) : tensor<1xf16>
  check.return
}

