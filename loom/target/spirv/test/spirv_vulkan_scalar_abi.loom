  %output2 = check.generate.fill value(19.0) : tensor<1xbf16>
  %expected2 = check.generate.fill value(-7.25) : tensor<1xbf16>
  kernel.launch @scalar_payload_bf16(%value0, %value1, %value2, %output0, %output1, %output2) : (bf16, bf16, bf16, tensor<1xbf16>, tensor<1xbf16>, tensor<1xbf16>)
