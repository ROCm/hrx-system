// Runtime-selected byte offsets address two disjoint workgroup slots.
// Static reads of both slots verify the dynamic address conversion.

kernel.def @workgroup_byte_offsets_i8() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %second_slot = index.constant 32 : offset
  %storage_bytes = index.constant 64 : offset
  %lane = kernel.workitem.id<x> : index
  %half = index.constant 16 : index
  %in_first_half = index.cmp slt, %lane, %half : index
  %selected_offset = scf.select %in_first_half, %base, %second_slot : offset
  %other_offset = scf.select %in_first_half, %second_slot, %base : offset
  %scratch = buffer.alloca<workgroup> align(1) %storage_bytes : buffer
  %selected = buffer.view %scratch[%selected_offset] : buffer -> view<32xi8>
  %other = buffer.view %scratch[%other_offset] : buffer -> view<32xi8>
  %value = index.cast %lane : index to i8
  %bias = scalar.constant 32 : i8
  %other_value = scalar.addi %value, %bias : i8
  view.store %value, %selected[%lane] : i8, view<32xi8>
  view.store %other_value, %other[%lane] : i8, view<32xi8>
  %first_view = buffer.view %scratch[%base] : buffer -> view<32xi8>
  %second_view = buffer.view %scratch[%second_slot] : buffer -> view<32xi8>
  %first = view.load %first_view[%lane] : view<32xi8> -> i8
  %second = view.load %second_view[%lane] : view<32xi8> -> i8
  %selected_loaded = view.load %selected[%lane] : view<32xi8> -> i8
  %first_expected = scf.select %in_first_half, %value, %other_value : i8
  %second_expected = scf.select %in_first_half, %other_value, %value : i8
  %first_ok = scalar.cmpi eq, %first, %first_expected : i8
  %second_ok = scalar.cmpi eq, %second, %second_expected : i8
  %dynamic_ok = scalar.cmpi eq, %selected_loaded, %value : i8
  %slots_ok = scalar.andi %first_ok, %second_ok : i1
  %all_ok = scalar.andi %slots_ok, %dynamic_ok : i1
  %success = scalar.constant 1 : i32
  %failure = scalar.constant 0 : i32
  %result = scf.select %all_ok, %success, %failure : i32
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<32xi32>
  view.store %result, %output_view[%lane] : i32, view<32xi32>
  kernel.return
}

check.case public @workgroup_byte_offsets_i8_case {
  %output = check.generate.fill value(-1) : tensor<32xi32>
  %expected = check.generate.fill value(1) : tensor<32xi32>
  kernel.launch @workgroup_byte_offsets_i8(%output) : (tensor<32xi32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<32xi32>
  check.return
}

