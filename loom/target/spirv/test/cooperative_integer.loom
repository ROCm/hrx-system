spirv.target<vulkan1_3> @target {abi = hal_kernel}

kernel.def target(@target) @tiled_integer_k16() {
  %m_tiles = index.constant 2 : index
  %n_tiles = index.constant 3 : index
  %unit = index.constant 1 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%n_tiles, %m_tiles, %unit) workgroup_size(%subgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %init_buffer: buffer, %out_buffer: buffer) {
  %workgroup_n = kernel.workgroup.id<x> : index
  %workgroup_m = kernel.workgroup.id<y> : index
  %k_tiles = index.constant 2 : index
  %n_tiles = index.constant 3 : index
  %unit = index.constant 1 : index
  %loop_begin = index.constant 0 : index
  %lhs_tile_bytes = index.constant 256 : index
  %rhs_tile_bytes = index.constant 256 : index
  %acc_tile_bytes = index.constant 1024 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %lhs_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i8, payload_elements=16, payload_registers=4>> : encoding<storage>
  %rhs_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i8, payload_elements=16, payload_registers=4>> : encoding<storage>
  %acc_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %out_tile_index = index.madd %workgroup_m, %n_tiles, %workgroup_n : index
  %out_byte_index = index.mul %out_tile_index, %acc_tile_bytes : index
  %out_byte_offset = index.cast %out_byte_index : index to offset
  %out_byte_offset_aligned = index.assume %out_byte_offset [multiple_of(%out_byte_offset, 16)] : offset
  %lhs_aligned = buffer.assume.alignment %lhs_buffer {minimum_alignment = 16} : buffer
  %rhs_aligned = buffer.assume.alignment %rhs_buffer {minimum_alignment = 16} : buffer
  %init_aligned = buffer.assume.alignment %init_buffer {minimum_alignment = 16} : buffer
  %out_aligned = buffer.assume.alignment %out_buffer {minimum_alignment = 16} : buffer
  %init_view = buffer.view %init_aligned[%out_byte_offset_aligned] : buffer -> view<16x16xi32, %acc_storage>
  %out_view = buffer.view %out_aligned[%out_byte_offset_aligned] : buffer -> view<16x16xi32, %acc_storage>
  %init = vector.fragment.load<init> %init_view[0, 0] shape [%m, %n] : view<16x16xi32, %acc_storage> -> vector<8xi32>
  %result = scf.for %kt = [%loop_begin to %k_tiles step %unit](%acc = %init : vector<8xi32>) -> (vector<8xi32>) {
    %lhs_tile_index = index.madd %workgroup_m, %k_tiles, %kt : index
    %rhs_tile_index = index.madd %kt, %n_tiles, %workgroup_n : index
    %lhs_byte_index = index.mul %lhs_tile_index, %lhs_tile_bytes : index
    %rhs_byte_index = index.mul %rhs_tile_index, %rhs_tile_bytes : index
    %lhs_byte_offset = index.cast %lhs_byte_index : index to offset
    %rhs_byte_offset = index.cast %rhs_byte_index : index to offset
    %lhs_byte_offset_aligned = index.assume %lhs_byte_offset [multiple_of(%lhs_byte_offset, 16)] : offset
    %rhs_byte_offset_aligned = index.assume %rhs_byte_offset [multiple_of(%rhs_byte_offset, 16)] : offset
    %lhs_view = buffer.view %lhs_aligned[%lhs_byte_offset_aligned] : buffer -> view<16x16xi8, %lhs_storage>
    %rhs_view = buffer.view %rhs_aligned[%rhs_byte_offset_aligned] : buffer -> view<16x16xi8, %rhs_storage>
    %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<16x16xi8, %lhs_storage> -> vector<16xi8>
    %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<16x16xi8, %rhs_storage> -> vector<16xi8>
    %next = vector.mma %lhs, %rhs, %acc : vector<16xi8>, vector<16xi8>, vector<8xi32>
    scf.yield %next : vector<8xi32>
  }
  vector.fragment.store<result> %result, %out_view[0, 0] shape [%m, %n] : vector<8xi32>, view<16x16xi32, %acc_storage>
  kernel.return
}

check.case @tiled_integer_k16_case {
  check.requires<hal.vulkan.feature> {feature = "shader_int8"}
  check.requires<hal.vulkan.feature> {feature = "storage_buffer_8bit_access"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.s8.16x16x16.s32.subgroup"}
  %lhs = check.generate.iota offset(-128) step(7) period(31) : tensor<2x2x16x16xi8>
  %rhs = check.generate.iota offset(-127) step(9) period(29) : tensor<2x3x16x16xi8>
  %init = check.generate.iota offset(-12345) step(17) : tensor<2x3x16x16xi32>
  %output = check.generate.fill value(0) : tensor<2x3x16x16xi32>
  kernel.launch @tiled_integer_k16(%lhs, %rhs, %init, %output) : (tensor<2x2x16x16xi8>, tensor<2x3x16x16xi8>, tensor<2x3x16x16xi32>, tensor<2x3x16x16xi32>)
  %expected = check.oracle.call<reference.tiled_matmul> {accumulator = "i32", lhs = "i8", result = "i32", rhs = "i8"} callee(@tiled_integer_k16) inputs(%lhs, %rhs, %init) : (tensor<2x2x16x16xi8>, tensor<2x3x16x16xi8>, tensor<2x3x16x16xi32>) -> (tensor<2x3x16x16xi32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<2x3x16x16xi32>
  check.return
}

// Signed A and unsigned B retain their interpretations in both wrapping and
// saturating arithmetic. Accumulators near each signed limit distinguish them.
kernel.def target(@target) @mixed_integer_overflow() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%wrap_buffer: buffer, %clamp_buffer: buffer, %a: i8, %b: i8, %c: i32) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %wrap_aligned = buffer.assume.alignment %wrap_buffer {minimum_alignment = 16} : buffer
  %clamp_aligned = buffer.assume.alignment %clamp_buffer {minimum_alignment = 16} : buffer
  %storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %unsigned_input = encoding.define #encoding.operand<element_format=u8, payload_elements=16, payload_registers=4> : encoding<schema>
  %wrap_view = buffer.view %wrap_aligned[%origin] : buffer -> view<16x16xi32, %storage>
  %clamp_view = buffer.view %clamp_aligned[%origin] : buffer -> view<16x16xi32, %storage>
  %a_values = vector.splat %a : vector<1xi8>
  %b_values = vector.splat %b : vector<1xi8>
  %c_values = vector.splat %c : vector<1xi32>
  %lhs = vector.fragment<lhs> %a_values shape [%tile, %tile] : vector<1xi8>
  %rhs = vector.fragment<rhs> %b_values shape [%tile, %tile] using {schema = %unsigned_input : encoding<schema>} : vector<1xi8>
  %initial = vector.fragment<init> %c_values shape [%tile, %tile] : vector<1xi32>
  %wrapped = vector.mma %lhs, %rhs, %initial : vector<1xi8>, vector<1xi8>, vector<1xi32>
  %clamped = vector.mma<saturate> %lhs, %rhs, %initial : vector<1xi8>, vector<1xi8>, vector<1xi32>
  vector.fragment.store<result> %wrapped, %wrap_view[0, 0] shape [%tile, %tile] : vector<1xi32>, view<16x16xi32, %storage>
  vector.fragment.store<result> %clamped, %clamp_view[0, 0] shape [%tile, %tile] : vector<1xi32>, view<16x16xi32, %storage>
  kernel.return
}

check.case @positive_overflow {
  check.requires<hal.vulkan.feature> {feature = "shader_int8"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.s8_u8.16x16x16.s32.subgroup"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.s8_u8.16x16x16.s32.subgroup.saturating"}
  %wrapped = check.generate.fill value(0) : tensor<16x16xi32>
  %clamped = check.generate.fill value(0) : tensor<16x16xi32>
  %expected_wrap = check.generate.fill value(-2146965536) : tensor<16x16xi32>
  %expected_clamp = check.generate.fill value(2147483647) : tensor<16x16xi32>
  %a = check.literal value(127) : i8
  %b = check.literal value(-1) : i8
  %c = check.literal value(2147483600) : i32
  kernel.launch @mixed_integer_overflow(%wrapped, %clamped, %a, %b, %c) : (tensor<16x16xi32>, tensor<16x16xi32>, i8, i8, i32)
  check.expect.bitwise actual(%wrapped) expected(%expected_wrap) : tensor<16x16xi32>
  check.expect.bitwise actual(%clamped) expected(%expected_clamp) : tensor<16x16xi32>
  check.return
}

check.case @negative_overflow {
  check.requires<hal.vulkan.feature> {feature = "shader_int8"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.s8_u8.16x16x16.s32.subgroup"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.s8_u8.16x16x16.s32.subgroup.saturating"}
  %wrapped = check.generate.fill value(0) : tensor<16x16xi32>
  %clamped = check.generate.fill value(0) : tensor<16x16xi32>
  %expected_wrap = check.generate.fill value(2146961456) : tensor<16x16xi32>
  %expected_clamp = check.generate.fill value(-2147483648) : tensor<16x16xi32>
  %a = check.literal value(-128) : i8
  %b = check.literal value(-1) : i8
  %c = check.literal value(-2147483600) : i32
  kernel.launch @mixed_integer_overflow(%wrapped, %clamped, %a, %b, %c) : (tensor<16x16xi32>, tensor<16x16xi32>, i8, i8, i32)
  check.expect.bitwise actual(%wrapped) expected(%expected_wrap) : tensor<16x16xi32>
  check.expect.bitwise actual(%clamped) expected(%expected_clamp) : tensor<16x16xi32>
  check.return
}

check.case @mixed_input_signs {
  check.requires<hal.vulkan.feature> {feature = "shader_int8"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.s8_u8.16x16x16.s32.subgroup"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.s8_u8.16x16x16.s32.subgroup.saturating"}
  %wrapped = check.generate.fill value(0) : tensor<16x16xi32>
  %clamped = check.generate.fill value(0) : tensor<16x16xi32>
  %expected_wrap = check.generate.fill value(-8153) : tensor<16x16xi32>
  %expected_clamp = check.generate.fill value(-8153) : tensor<16x16xi32>
  %a = check.literal value(-2) : i8
  %b = check.literal value(-1) : i8
  %c = check.literal value(7) : i32
  kernel.launch @mixed_integer_overflow(%wrapped, %clamped, %a, %b, %c) : (tensor<16x16xi32>, tensor<16x16xi32>, i8, i8, i32)
  check.expect.bitwise actual(%wrapped) expected(%expected_wrap) : tensor<16x16xi32>
  check.expect.bitwise actual(%clamped) expected(%expected_clamp) : tensor<16x16xi32>
  check.return
}
