load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_target_profile")

package(default_visibility = ["//visibility:public"])

_XDNA_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:xdna_artifacts",
])

loom_target_profile(
    name = "npu4",
    family = "amd.xdna.aie2p",
    selector = "amd.xdna.strix.17f0_10",
    target_compatible_with = _XDNA_ARTIFACTS_COMPATIBLE_WITH,
)

loom_target_profile(
    name = "npu5",
    family = "amd.xdna.aie2p",
    selector = "amd.xdna.strix_halo.17f0_11",
    target_compatible_with = _XDNA_ARTIFACTS_COMPATIBLE_WITH,
)
