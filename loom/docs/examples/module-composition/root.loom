// The declaration states the exact callable contract while the import limits
// its possible definitions to the provider bound as "layer.loom".
module.import "layer.loom" [@project_layer]

func.decl @project_layer(%value: i32) -> (i32)

func.def public @entry(%value: i32) -> (i32) {
  %result = func.call @project_layer(%value) : (i32) -> (i32)
  func.return %result : i32
}
