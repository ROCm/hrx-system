# bazel-to-cmake: skip

load("@hrx//loom/build_tools/bazel:defs.bzl", "loom_kernel_library", "loom_library", "loom_test")
load("@hrx//loom/src/loom/tooling/target/spirv:execution_profiles.bzl", "SPIRV_VULKAN_HARDWARE_PROFILE")
load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

loom_library(
    name = "rotation",
    srcs = ["rotating-views.loom"],
)

loom_test(
    name = "tests",
    srcs = ["tests.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = [":rotation"],
)

loom_kernel_library(
    name = "read_ahead",
    srcs = [
        "read-ahead.loom",
        "read-ahead-tests.loom",
    ],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx1250-a0",
        "@hrx//loom/target/spirv:vulkan1.3+bda",
    ],
)

# --8<-- [start:workload_variants]
loom_test(
    name = "read_ahead_variants_test",
    srcs = ["read-ahead-tests.loom"],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    variants = {
        "serial": {"configs": {
            "read_ahead.depth": "1",
            "read_ahead.unroll": "2",
        }},
        "unroll1": {"configs": {
            "read_ahead.depth": "3",
            "read_ahead.unroll": "1",
        }},
    },
    deps = [":read_ahead"],
)
# --8<-- [end:workload_variants]

loom_kernel_library(
    name = "vector_read_ahead",
    srcs = [
        "vector-read-ahead.loom",
        "vector-read-ahead-tests.loom",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx1250-a0",
        "@hrx//loom/target/spirv:vulkan1.3+bda",
    ],
)

loom_kernel_library(
    name = "guarded_read_ahead",
    srcs = [
        "guarded-read-ahead.loom",
        "guarded-read-ahead-tests.loom",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx1250-a0",
        "@hrx//loom/target/spirv:vulkan1.3+bda",
    ],
)

loom_kernel_library(
    name = "paired_read_ahead",
    srcs = [
        "paired-read-ahead.loom",
        "paired-read-ahead-tests.loom",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx1250-a0",
        "@hrx//loom/target/spirv:vulkan1.3+bda",
    ],
    deps = [":vector_read_ahead"],
)

loom_test(
    name = "paired_read_ahead_access_test",
    srcs = ["paired-read-ahead-tests.loom"],
    configs = {
        "paired_rows.left_unroll": "4",
        "paired_rows.right_unroll": "4",
    },
    execution_profiles = [AMDGPU_ACCESS_PROFILE],
    variants = {
        "both": {"configs": {
            "paired_rows.left_lookahead": "3",
            "paired_rows.right_lookahead": "3",
        }},
        "deep": {"configs": {
            "paired_rows.left_lookahead": "31",
            "paired_rows.right_lookahead": "31",
        }},
        "serial": {"configs": {
            "paired_rows.left_lookahead": "0",
            "paired_rows.left_unroll": "1",
            "paired_rows.right_lookahead": "0",
            "paired_rows.right_unroll": "1",
        }},
        "swapped": {"configs": {
            "paired_rows.left_lookahead": "0",
            "paired_rows.left_unroll": "1",
            "paired_rows.right_lookahead": "3",
        }},
    },
    deps = [":paired_read_ahead"],
)
