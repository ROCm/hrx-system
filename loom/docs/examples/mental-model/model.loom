// The declaration makes the exact dependency explicit in this source module.
kernel.decl @transform_buffer(%workload_element_count: index) launch(%device_element_count: index, %input: buffer, %output: buffer)

// The command program owns the reusable schedule while buffers remain
// replaceable at issue time.
command.program.def public @transform() launch(%input: buffer, %output: buffer) {
  %element_count = index.constant 1009 : index
  kernel.launch @transform_buffer[%element_count](%element_count, %input, %output) : [index](index, buffer, buffer)
  command.return
}
