# bazel-to-cmake: skip

load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_test")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_binary(
    name = "importer",
    srcs = ["importer.py"],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/importers:package",
    ],
)

iree_py_test(
    name = "importer_test",
    size = "small",
    srcs = [
        "importer.py",
        "importer_test.py",
    ],
    data = ["expected.loom"],
    imports = ["."],
    main = "importer_test.py",
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/format/bytecode",
        "//loom/py/loom/importers:package",
    ],
)
