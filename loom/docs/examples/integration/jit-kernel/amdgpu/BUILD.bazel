# bazel-to-cmake: skip

load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

LOOMC_TARGET_AMDGPU_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target/arch:amdgpu",
    "//loom/config/emit:amdgpu",
])

loom_cc_test(
    name = "jit_kernel_test",
    srcs = ["jit_kernel.c"],
    args = ["$(location //loom/docs/examples/integration/jit-kernel:kernel.loom)"],
    data = ["//loom/docs/examples/integration/jit-kernel:kernel.loom"],
    tags = ["hostonly"],
    target_compatible_with = LOOMC_TARGET_AMDGPU_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
    ],
)
