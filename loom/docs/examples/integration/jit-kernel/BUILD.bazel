# bazel-to-cmake: skip

load(
    "@hrx//loom/build_tools/bazel:defs.bzl",
    "loom_library",
    "loom_module",
)

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(["kernel.loom"])

loom_library(
    name = "kernel",
    srcs = ["kernel.loom"],
)

loom_module(
    name = "kernel_bytecode",
    srcs = ["kernel.loom"],
    output_format = "bc",
    visibility = ["//loom/docs/examples/integration/jit-kernel/amdgpu:__pkg__"],
)

test_suite(
    name = "test",
    tests = [
        ":kernel_test",
        "//loom/docs/examples/integration/jit-kernel/amdgpu:jit_kernel_test",
    ],
)
