load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

sh_test(
    name = "trajectory_test",
    srcs = [".doc-generate.sh"],
    data = [
        "gated-projection.cxx",
        "run.sh",
        "//loom/docs/examples:example.shlib",
        "//loom/src/loom/tools/loom-compile",
        "//loom/src/loom/tools/loom-format",
        "//loom/src/loom/tools/loom-import-cxx",
    ],
    env = {
        "LOOM_EXAMPLE_LIBRARY": "$(location //loom/docs/examples:example.shlib)",
    },
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/emit:aie2p_elf",
        "//loom/config/import:cxx",
    ]),
)
