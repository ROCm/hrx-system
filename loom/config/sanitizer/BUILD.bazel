load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

# Instrument Loom programs independently of the native compiler/runtime build.
bool_flag(
    name = "address",
    build_setting_default = False,
)

bool_flag(
    name = "thread",
    build_setting_default = False,
)

bool_flag(
    name = "undefined",
    build_setting_default = False,
)
