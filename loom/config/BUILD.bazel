# CMake options are declared in loom/project.cmake.
# bazel-to-cmake: skip

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "shared_tools",
    build_setting_default = False,
)

config_setting(
    name = "shared_tools_enabled",
    flag_values = {":shared_tools": "true"},
)

selects.config_setting_group(
    name = "shared_tools_linux",
    match_all = [
        ":shared_tools_enabled",
        "@platforms//os:linux",
    ],
)

selects.config_setting_group(
    name = "shared_tools_macos",
    match_all = [
        ":shared_tools_enabled",
        "@platforms//os:macos",
    ],
)
