load("@bazel_skylib//lib:selects.bzl", "selects")
load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")
load("//loom/config/target:targets.bzl", "LOOM_TARGET_ARCHITECTURES")

package(default_visibility = ["//visibility:public"])

# Advanced target-architecture slices. Public //loom/config/target values imply
# these effective settings; this flag is only for source embedders that want
# target metadata/providers without the corresponding production emitters.
DEFAULT_ENABLED = []

iree_string_list_flag(
    name = "enable",
    build_setting_default = DEFAULT_ENABLED,
    values = LOOM_TARGET_ARCHITECTURES,
)

[
    config_setting(
        name = "explicit_" + value,
        flag_values = {
            ":enable": value,
        },
    )
    for value in LOOM_TARGET_ARCHITECTURES
]

[
    selects.config_setting_group(
        name = value,
        match_any = [
            "//loom/config/target:" + value,
            ":explicit_" + value,
        ],
    )
    for value in [
        "amdgpu",
        "spirv",
        "vm",
        "wasm",
        "xdna",
        "x86",
    ]
]
