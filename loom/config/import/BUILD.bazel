load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")

package(default_visibility = ["//visibility:public"])

DEFAULT_ENABLED = []

SUPPORTED_VALUES = [
    "cxx",
    "mlir",
]

iree_string_list_flag(
    name = "enable",
    build_setting_default = DEFAULT_ENABLED,
    values = SUPPORTED_VALUES,
)

[
    config_setting(
        name = value,
        flag_values = {
            ":enable": value,
        },
    )
    for value in SUPPORTED_VALUES
]
