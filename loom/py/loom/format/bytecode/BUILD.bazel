load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "bytecode",
    srcs = [
        "__init__.py",
        "encoding.py",
        "op_decls.py",
        "reader.py",
        "symbol_references.py",
        "writer.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/format:package",
        "//loom/py/loom/target:descriptor_sets",
    ],
)

iree_py_test(
    name = "bytecode_test",
    srcs = [
        "encoding_test.py",
        "mixed_tables_test.py",
        "reader_test.py",
        "symbol_references_test.py",
        "writer_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = [
        "loom.format.bytecode.encoding_test",
        "loom.format.bytecode.mixed_tables_test",
        "loom.format.bytecode.reader_test",
        "loom.format.bytecode.symbol_references_test",
        "loom.format.bytecode.writer_test",
    ],
    main = "pytest_style_runner.py",
    deps = [
        ":bytecode",
        "//loom/py/loom/dialect:package",
        "//loom/py/loom/format/text",
        "//loom/py/loom/target/test:descriptors",
    ],
)

iree_py_test(
    name = "c_interop_test",
    srcs = ["c_interop_test.py"],
    args = [
        "$(location //loom/src/loom/tools/loom-format:loom-format)",
        "$(location //loom/src/loom/tools/loom-link:loom-link)",
        "$(location //loom/src/loom/format/text/test:predicate_attributes.loom-test)",
        "$(location //loom/src/loom/format/bytecode:scoped_type_interop.loom-test)",
        "$(location //loom/src/loom/format/text/test:byte_attributes.loom-test)",
        "$(location //loom/src/loom/format/bytecode:managed_types.loom-test)",
    ],
    data = [
        "//loom/src/loom/format/bytecode:managed_types.loom-test",
        "//loom/src/loom/format/bytecode:scoped_type_interop.loom-test",
        "//loom/src/loom/format/text/test:byte_attributes.loom-test",
        "//loom/src/loom/format/text/test:predicate_attributes.loom-test",
        "//loom/src/loom/tools/loom-format",
        "//loom/src/loom/tools/loom-link",
    ],
    main = "c_interop_test.py",
    deps = [
        ":bytecode",
        "//loom/py/loom/dialect/cfg",
        "//loom/py/loom/dialect/func",
        "//loom/py/loom/dialect/globals",
        "//loom/py/loom/dialect/index",
        "//loom/py/loom/dialect/low",
        "//loom/py/loom/dialect/scf",
        "//loom/py/loom/dialect/test",
        "//loom/py/loom/dialect/type",
        "//loom/py/loom/format/text",
        "//loom/py/loom/target/test:descriptors",
    ],
)
