# The pinned optional SDK test environment is owned by Bazel's dev-only pip hub.
# CLI and transfer processes load build-owned bytecode, as an installed wheel
# does, instead of recompiling the SDK on each interpreter startup.
# bazel-to-cmake: skip

load("@loom_model_test_pip//:requirements.bzl", "requirement")
load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(default_visibility = ["//visibility:private"])

exports_files(["requirements.lock.txt"])

# Every case starts anonymous; individual credential tests own their changes.
# Keeping the parent environment stable also preserves idle transfer workers.
_ENVIRONMENT = {
    "HF_TOKEN": "",
    "HUGGING_FACE_HUB_TOKEN": "",
}

iree_py_test(
    name = "catalog_test",
    srcs = [
        "catalog_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.hf_test.catalog_test"],
    env = _ENVIRONMENT,
    main = "pytest_style_runner.py",
    pyc_collection = "include_pyc",
    deps = [
        ":cli",
        ":fixture",
        "//loom/py/loom/model:catalog",
        "//loom/py/loom/model:fetch",
        "//loom/py/loom/model:fetch_cli",
        "//loom/py/loom/model:fetch_hf",
        "//loom/py/loom/model:fetch_publication",
        "//loom/py/loom/model:fetch_source",
        "//loom/py/loom/model:fetch_storage",
        "//loom/py/loom/model:lock",
        "//loom/py/loom/model:manifest",
    ],
)

iree_py_library(
    name = "cli",
    testonly = True,
    srcs = ["cli.py"],
    deps = [
        "//loom/py/loom/model:fetch_cli",
        "//loom/py/loom/model:fetch_hf",
        "//loom/py/loom/model:fetch_storage",
    ],
)

iree_py_library(
    name = "fixture",
    testonly = True,
    srcs = ["hub.py"],
    tags = ["skip-bazel_to_cmake"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//loom/src/loom/tooling/target/cpu/serve:__pkg__"],
    deps = [
        "//loom/py/loom/model:fetch_hf",
        "//loom/py/loom/model:http_test_server",
        requirement("huggingface_hub"),
    ],
)

iree_py_test(
    name = "provider_test",
    srcs = [
        "provider_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.hf_test.provider_test"],
    env = _ENVIRONMENT,
    main = "pytest_style_runner.py",
    pyc_collection = "include_pyc",
    tags = ["skip-bazel_to_cmake"],
    deps = [
        ":fixture",
        "//loom/py/loom/model:fetch_console",
        "//loom/py/loom/model:fetch_hf",
        "//loom/py/loom/model:fetch_source",
        "//loom/py/loom/model:fetch_transfer",
    ],
)

iree_py_test(
    name = "install_test",
    srcs = [
        "install_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.hf_test.install_test"],
    env = _ENVIRONMENT,
    main = "pytest_style_runner.py",
    pyc_collection = "include_pyc",
    tags = ["skip-bazel_to_cmake"],
    deps = [
        ":fixture",
        "//loom/py/loom/model:fetch",
        "//loom/py/loom/model:fetch_hf",
        "//loom/py/loom/model:fetch_source",
        "//loom/py/loom/model:fetch_storage",
        "//loom/py/loom/model:http_test_server",
        "//loom/py/loom/model:lock",
        "//loom/py/loom/model:manifest",
    ],
)

iree_py_test(
    name = "cli_test",
    srcs = [
        "cli_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.model.hf_test.cli_test"],
    env = _ENVIRONMENT,
    main = "pytest_style_runner.py",
    pyc_collection = "include_pyc",
    deps = [
        ":cli",
        ":fixture",
        "//loom/py/loom/model:fetch_cli",
    ],
)
