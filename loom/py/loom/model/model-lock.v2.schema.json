{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loom model lock, version 2",
  "description": "Explicit asset-only or complete output commitments, independent of destinations and model preset. Asset scope excludes program and auxiliary files unless the same logical source is also used as an asset. For a transformed parameter file, size and SHA-256 identify the resulting archive, not the encoded parent source.",
  "type": "object",
  "required": ["schema_version", "scope", "origins", "files"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "const": 2},
    "scope": {
      "enum": ["assets", "all"],
      "description": "Assets locks parameters, tokenizers, and voice recordings while leaving programs and auxiliary files editable. All locks every selected file, including programs."
    },
    "origins": {
      "type": "object",
      "propertyNames": {"$ref": "model-card.v1.schema.json#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "required": ["requested"],
        "properties": {
          "requested": {"$ref": "model-card.v1.schema.json#/$defs/originRoot"},
          "resolved": {"$ref": "#/$defs/resolved"}
        },
        "if": {"properties": {"requested": {"properties": {"kind": {"const": "hf"}}}}},
        "then": {"required": ["resolved"]},
        "else": {"not": {"required": ["resolved"]}},
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin"],
        "properties": {
          "origin": {"$ref": "model-card.v1.schema.json#/$defs/fileOrigin"},
          "size": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "resolved": {"$ref": "#/$defs/resolved"},
          "transform": {"$ref": "model-card.v2.schema.json#/$defs/transform"},
          "derived": {"$ref": "#/$defs/derived"}
        },
        "allOf": [
          {
            "if": {"properties": {"origin": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "hf"}}}}},
            "then": {"required": ["resolved"]},
            "else": {"not": {"required": ["resolved"]}}
          },
          {
            "if": {"required": ["transform"], "properties": {"transform": {"properties": {"kind": {"const": "i8-panel"}}}}},
            "then": {
              "required": ["transform"],
              "dependentRequired": {"size": ["sha256"], "sha256": ["size"]}
            },
            "else": {"required": ["size", "sha256"], "not": {"required": ["derived"]}}
          }
        ],
        "additionalProperties": false
      },
      "description": "One record per logical origin and optional transform. Aliased roots carry their repository resolution once. Updates replace the exact requested output set. A loader-derived output (transform kind i8-panel) is never acquired: its origin is its installation path, size and SHA-256 are optional publisher observations, and derived names its source origin and the loader's recipe identifiers."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resolved": {
      "type": "object",
      "required": ["revision"],
      "properties": {"revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
      "additionalProperties": false
    },
    "derived": {
      "type": "object",
      "required": ["source", "layout_version", "recipe_version"],
      "properties": {
        "source": {"$ref": "model-card.v1.schema.json#/$defs/fileOrigin"},
        "layout_version": {"type": "string", "minLength": 1},
        "recipe_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
