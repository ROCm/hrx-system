load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "scalar",
    srcs = [
        "__init__.py",
        "analysis.py",
        "arithmetic.py",
        "bitwise.py",
        "comparison.py",
        "conversion.py",
        "defs.py",
        "math.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/error",
    ],
)

iree_py_test(
    name = "scalar_ops_test",
    srcs = [
        "scalar_ops_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.dialect.scalar.scalar_ops_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":scalar",
        "//loom/py/loom/dialect/func",
    ],
)
