load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

iree_py_library(
    name = "ref",
    srcs = [
        "__init__.py",
        "defs.py",
    ],
    deps = ["//loom/py/loom:core"],
)

iree_py_test(
    name = "ref_ops_test",
    srcs = [
        "ref_ops_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.dialect.ref.ref_ops_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":ref",
        "//loom/py/loom:package",
        "//loom/py/loom/format/bytecode",
        "//loom/py/loom/format/text",
    ],
)
