load("//build_tools/bazel:python.bzl", "iree_py_library")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "package_init",
    srcs = ["__init__.py"],
    deps = ["//loom/py/loom/target/arch:package_init"],
)

iree_py_library(
    name = "dialect",
    srcs = ["dialect.py"],
    deps = [
        ":package_init",
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/func",
        "//loom/py/loom/dialect/target",
    ],
)

iree_py_library(
    name = "descriptors",
    srcs = ["descriptors.py"],
    deps = [
        ":package_init",
        "//loom/py/loom/target:low_descriptors",
        "//loom/py/loom/target/arch:package",
    ],
)
