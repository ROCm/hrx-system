load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "contracts",
    srcs = [
        "__init__.py",
        "atomic.py",
        "descriptor_rule.py",
        "index.py",
        "logical_core.py",
        "memory.py",
        "ordinary_vector.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/buffer",
        "//loom/py/loom/dialect/index",
        "//loom/py/loom/dialect/kernel",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/dialect/scf",
        "//loom/py/loom/dialect/vector",
        "//loom/py/loom/dialect/view",
        "//loom/py/loom/error",
        "//loom/py/loom/target/arch/spirv:atomic",
        "//loom/py/loom/target/arch/spirv:builtins",
        "//loom/py/loom/target/arch/spirv:cooperative_matrix",
        "//loom/py/loom/target/arch/spirv:descriptors",
        "//loom/py/loom/target/arch/spirv:ordinary_vector",
        "//loom/py/loom/target/arch/spirv:scalar_alu",
        "//loom/py/loom/target/arch/spirv:scalar_constant",
        "//loom/py/loom/target/arch/spirv:scalar_conversion",
        "//loom/py/loom/target/arch/spirv:scalar_memory",
        "//loom/py/loom/target/contracts",
    ],
)

iree_py_test(
    name = "atomic_test",
    size = "small",
    srcs = [
        "atomic_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.arch.spirv.contracts.atomic_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":contracts",
        "//loom/py/loom/dialect/view",
        "//loom/py/loom/target/arch/spirv:atomic",
        "//loom/py/loom/target/contracts",
    ],
)

iree_py_test(
    name = "ordinary_vector_test",
    srcs = [
        "ordinary_vector_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.arch.spirv.contracts.ordinary_vector_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":contracts",
    ],
)

iree_py_test(
    name = "contracts_test",
    srcs = [
        "index_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.arch.spirv.contracts.index_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":contracts",
    ],
)
