load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

iree_py_library(
    name = "projection",
    srcs = [
        "__init__.py",
        "projection.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/scalar",
        "//runtime/src/iree/vm/bytecode/spec",
    ],
)

iree_py_test(
    name = "projection_test",
    srcs = [
        "projection_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.arch.vm.projection_test"],
    imports = ["../../../../../../runtime/src"],
    main = "pytest_style_runner.py",
    deps = [
        ":projection",
        "//loom/py/loom/dialect/scalar",
    ],
)

test_suite(
    name = "tests",
    tests = [":projection_test"],
)
