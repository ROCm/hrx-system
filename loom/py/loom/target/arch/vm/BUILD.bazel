load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "dialect",
    srcs = [
        "__init__.py",
        "dialect.py",
    ],
    deps = [
        "//loom/py/loom:core",
    ],
)

iree_py_library(
    name = "descriptors",
    srcs = [
        "__init__.py",
        "descriptors.py",
    ],
    deps = [
        "//loom/py/loom/target:low_descriptors",
        "//loom/py/loom/target/arch:package",
        "//runtime/src/iree/vm/bytecode/spec:model",
    ],
)

iree_py_library(
    name = "contracts",
    srcs = ["contracts.py"],
    deps = [
        ":descriptors",
        "//loom/py/loom/dialect:shared",
        "//loom/py/loom/dialect/buffer",
        "//loom/py/loom/dialect/globals",
        "//loom/py/loom/dialect/hal",
        "//loom/py/loom/dialect/index",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/dialect/scf",
        "//loom/py/loom/dialect/view",
        "//loom/py/loom/target/contracts",
        "//runtime/src/iree/vm/bytecode/spec:model",
    ],
)

iree_py_test(
    name = "descriptors_test",
    srcs = [
        "descriptors_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.arch.vm.descriptors_test"],
    imports = ["../../../../../../runtime/src"],
    main = "pytest_style_runner.py",
    deps = [
        ":contracts",
        ":descriptors",
        "//runtime/src/iree/vm/bytecode/spec:model",
    ],
)
