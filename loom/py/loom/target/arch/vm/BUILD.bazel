    name = "projection",
    srcs = ["projection.py"],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/index",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/target:low_descriptors",
        "//runtime/src/iree/vm/bytecode/spec/model/isa:definitions",
        "//runtime/src/iree/vm/bytecode/spec/model/isa/core",
    ],
)
