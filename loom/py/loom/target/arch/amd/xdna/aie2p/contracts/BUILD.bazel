load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "contracts",
    srcs = [
        "__init__.py",
        "conversion.py",
        "core.py",
        "core_contract.py",
        "data_path.py",
        "f32.py",
        "f32_compare.py",
        "floating.py",
        "i64.py",
        "index_conversion.py",
        "memory.py",
        "nonlinear.py",
        "packed_dot.py",
        "packet_conversion.py",
        "packet_memory.py",
        "reduction.py",
        "scalar_program.py",
        "structural.py",
    ],
    visibility = ["//loom/py/loom/gen/target/contracts:__pkg__"],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/buffer",
        "//loom/py/loom/dialect/index",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/dialect/scf",
        "//loom/py/loom/dialect/vector",
        "//loom/py/loom/dialect/view",
        "//loom/py/loom/target/arch/amd/xdna/aie2p:descriptors",
        "//loom/py/loom/target/contracts",
    ],
)

iree_py_test(
    name = "conversion_test",
    size = "small",
    srcs = [
        "conversion_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.arch.amd.xdna.aie2p.contracts.conversion_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":contracts",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/dialect/vector",
        "//loom/py/loom/target/contracts",
    ],
)

