load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "contracts",
    srcs = [
        "__init__.py",
        "avx2.py",
        "avx512.py",
        "avx512_bf16.py",
        "avx512_fp16.py",
        "avx512_predicate.py",
        "avx_ne_convert.py",
        "constants.py",
        "float_narrowing.py",
        "floating_extrema.py",
        "floating_reduction.py",
        "integer_division.py",
        "integer_reduction.py",
        "lane_movement.py",
        "memory.py",
        "packed_dot.py",
        "predicate.py",
        "rule_builders.py",
        "scalar.py",
        "scalar_float.py",
        "shuffle.py",
        "vector_arithmetic.py",
        "vector_construction.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/buffer",
        "//loom/py/loom/dialect/globals",
        "//loom/py/loom/dialect/index",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/dialect/scf",
        "//loom/py/loom/dialect/vector",
        "//loom/py/loom/dialect/view",
        "//loom/py/loom/target/arch/x86:descriptors",
        "//loom/py/loom/target/arch/x86:vector_families",
        "//loom/py/loom/target/contracts",
        "//loom/py/loom/target/emit:float_narrowing",
    ],
)

