load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "package_init",
    srcs = ["__init__.py"],
    deps = ["//loom/py/loom/target/arch:package_init"],
)

iree_py_library(
    name = "target_info",
    srcs = [
        "feature_bits.py",
        "packed_dot_data.py",
        "target_info.py",
    ],
    deps = [
        ":package_init",
        "//loom/py/loom/target:native_contraction_layout",
        "//loom/py/loom/target:native_layout_facts",
    ],
)

iree_py_library(
    name = "vector_families",
    srcs = ["vector_families.py"],
    deps = [":package_init"],
)

iree_py_library(
    name = "native_vector",
    srcs = [
        "native_vector.py",
        "vector_encoding.py",
    ],
    deps = [
        ":package_init",
        "//loom/py/loom/target:low_descriptors",
    ],
)

iree_py_library(
    name = "dialect",
    srcs = ["dialect.py"],
    deps = [
        ":package_init",
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/target",
    ],
)

iree_py_library(
    name = "descriptors",
    srcs = [
        "descriptors/__init__.py",
        "descriptors/avx2.py",
        "descriptors/avx512.py",
        "descriptors/avx512_bf16.py",
        "descriptors/avx512_fp16.py",
        "descriptors/avx_ne_convert.py",
        "descriptors/common.py",
        "descriptors/composite.py",
        "descriptors/encoding.py",
        "descriptors/memory.py",
        "descriptors/packed_dot.py",
        "descriptors/scalar.py",
        "descriptors/simd128.py",
    ],
    deps = [
        ":native_vector",
        ":target_info",
        ":vector_families",
        "//loom/py/loom/target:low_descriptors",
        "//loom/py/loom/target/arch:package",
    ],
)

iree_py_test(
    name = "target_info_test",
    srcs = [
        "target_info_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.arch.x86.target_info_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":target_info",
    ],
)

