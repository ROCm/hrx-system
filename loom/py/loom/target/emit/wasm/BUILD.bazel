load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "contracts",
    srcs = [
        "__init__.py",
        "contracts.py",
        "float_narrowing.py",
        "vector_float_extension.py",
        "vector_integer_arithmetic.py",
        "vector_integer_extension.py",
        "vector_shifts.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/index",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/dialect/vector",
        "//loom/py/loom/dialect/view",
        "//loom/py/loom/target/arch/wasm:descriptors",
        "//loom/py/loom/target/contracts",
        "//loom/py/loom/target/emit:float_narrowing",
        "//loom/py/loom/target/emit:package",
    ],
)

iree_py_test(
    name = "contracts_test",
    srcs = [
        "contracts_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.target.emit.wasm.contracts_test"],
    main = "pytest_style_runner.py",
    deps = [":contracts"],
)

iree_py_test(
