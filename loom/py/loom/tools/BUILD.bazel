load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(["source_inventory.py"])

iree_py_library(
    name = "source_inventory",
    srcs = ["source_inventory.py"],
    imports = ["../.."],
)

iree_py_test(
    name = "source_inventory_test",
    size = "small",
    srcs = [
        "pytest_style_runner.py",
        "source_inventory_test.py",
    ],
    args = ["loom.tools.source_inventory_test"],
    main = "pytest_style_runner.py",
    tags = ["manual"],
    deps = [":source_inventory"],
)

iree_py_library(
    name = "tools",
    srcs = [
        "__init__.py",
        "source_surface.py",
    ],
    deps = ["//loom/py/loom/gen/support"],
)

iree_py_library(
    name = "amdgpu_asm",
    srcs = [
        "__init__.py",
        "amdgpu_asm.py",
    ],
)

iree_py_library(
    name = "compile_report",
    srcs = [
        "__init__.py",
        "compile_report.py",
    ],
    deps = [
        "//loom/py/loom/reporting",
        "//loom/py/loom/target/arch:compile_report_suggestions",
    ],
)

iree_py_library(
    name = "loom_opt",
    srcs = [
        "__init__.py",
        "loom_opt.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/error",
    ],
)

iree_py_library(
    name = "source_lint",
    srcs = [
        "__init__.py",
        "source_lint.py",
    ],
)

iree_py_library(
    name = "export_cxx",
    srcs = ["export_cxx.py"],
    deps = ["//loom/py/loom/format/cxx"],
)

iree_py_binary(
    name = "loom-compile-report",
    srcs = ["compile_report.py"],
    main = "compile_report.py",
    deps = [":compile_report"],
)

iree_py_binary(
    name = "loom-lint",
    srcs = ["source_lint.py"],
    main = "source_lint.py",
    deps = [":source_lint"],
)

iree_py_binary(
    name = "loom-export-cxx",
    srcs = ["export_cxx.py"],
    main = "export_cxx.py",
    deps = [":export_cxx"],
)

iree_py_binary(
    name = "pytest_style_runner",
    srcs = ["pytest_style_runner.py"],
    main = "pytest_style_runner.py",
)

iree_py_test(
    name = "tools_test",
    srcs = [
        "amdgpu_asm_test.py",
        "compile_report_test.py",
        "export_cxx_test.py",
        "loom_opt_test.py",
        "pytest_style_runner.py",
        "pytest_style_runner_test.py",
        "source_lint_test.py",
        "source_surface_test.py",
    ],
    args = [
        "loom.tools.amdgpu_asm_test",
        "loom.tools.compile_report_test",
        "loom.tools.loom_opt_test",
        "loom.tools.export_cxx_test",
        "loom.tools.pytest_style_runner_test",
        "loom.tools.source_surface_test",
        "loom.tools.source_lint_test",
    ],
    main = "pytest_style_runner.py",
    deps = [
        ":amdgpu_asm",
        ":compile_report",
        ":export_cxx",
        ":loom_opt",
        ":source_lint",
        ":tools",
        "//loom/py/loom/format/cxx:test_support",
    ],
)
