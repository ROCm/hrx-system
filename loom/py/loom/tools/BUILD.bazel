load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "tools",
    srcs = [
        "__init__.py",
        "source_surface.py",
    ],
    deps = ["//loom/py/loom/gen/support"],
)

iree_py_library(
    name = "amdgpu_asm",
    srcs = [
        "__init__.py",
        "amdgpu_asm.py",
    ],
)

iree_py_library(
    name = "compile_report",
    srcs = [
        "__init__.py",
        "compile_report.py",
    ],
    deps = [
        "//loom/py/loom/reporting",
        "//loom/py/loom/target/arch:compile_report_suggestions",
    ],
)

iree_py_library(
    name = "loom_opt",
    srcs = [
        "__init__.py",
        "loom_opt.py",
    ],
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/error",
    ],
)

iree_py_library(
    name = "source_lint",
    srcs = [
        "__init__.py",
        "source_lint.py",
    ],
)

iree_py_binary(
    name = "loom-compile-report",
    srcs = ["compile_report.py"],
    main = "compile_report.py",
    deps = [":compile_report"],
)

iree_py_binary(
    name = "loom-lint",
    srcs = ["source_lint.py"],
    main = "source_lint.py",
    deps = [":source_lint"],
)

iree_py_binary(
    name = "pytest_style_runner",
    srcs = ["pytest_style_runner.py"],
    main = "pytest_style_runner.py",
)

iree_py_test(
    name = "tools_test",
    srcs = [
        "amdgpu_asm_test.py",
        "compile_report_test.py",
        "loom_opt_test.py",
        "pytest_style_runner.py",
        "source_lint_test.py",
        "source_surface_test.py",
    ],
    args = [
        "loom.tools.amdgpu_asm_test",
        "loom.tools.compile_report_test",
        "loom.tools.loom_opt_test",
        "loom.tools.source_surface_test",
        "loom.tools.source_lint_test",
    ],
    main = "pytest_style_runner.py",
    deps = [
        ":amdgpu_asm",
        ":compile_report",
        ":loom_opt",
        ":source_lint",
        ":tools",
    ],
)
