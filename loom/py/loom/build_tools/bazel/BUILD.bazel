    name = "configure_test",
    srcs = [
        "configure_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.build_tools.bazel.configure_test"],
    main = "pytest_style_runner.py",
    deps = ["//build_tools/bazel:configure"],
)
