load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(default_visibility = ["//visibility:public"])

iree_py_library(
    name = "configure",
    srcs = ["configure.py"],
    imports = ["../../.."],
    deps = [
        "//build_tools/bazel:configure_api",
        "//loom/py/loom/build_tools:target_presets",
