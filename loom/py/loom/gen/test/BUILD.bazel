load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library")

package(
    default_visibility = ["//loom/py/loom/gen:__subpackages__"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_binary(
    name = "cxx_kernel_cases",
    testonly = True,
    srcs = ["cxx_kernel_cases.py"],
    main = "cxx_kernel_cases.py",
    visibility = [
        "//loom/src/loom/import/cxx/test:__pkg__",
        "//loom/src/loom/tooling/target/amdgpu/test/cxx:__pkg__",
    ],
    deps = [":kernel_fixture"],
)

iree_py_library(
    name = "kernel_fixture",
    testonly = True,
    srcs = ["kernel_fixture.py"],
    deps = ["//loom/py/loom/gen:package"],
)

iree_py_binary(
    name = "narrow_float_subtraction",
    testonly = True,
    srcs = ["narrow_float_subtraction.py"],
    main = "narrow_float_subtraction.py",
    visibility = ["//loom/src/loom/tooling/target/amdgpu/test/cxx:__pkg__"],
    deps = [":kernel_fixture"],
)
