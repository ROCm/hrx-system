load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_test")

package(
    default_visibility = ["//loom/py/loom/gen:__subpackages__"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_binary(
    name = "numeric_conversion_matrix",
    srcs = [
        "__init__.py",
        "numeric_conversion_matrix.py",
    ],
    main = "numeric_conversion_matrix.py",
    deps = [
        "//loom/py/loom:core",
        "//loom/py/loom/dialect/encoding",
        "//loom/py/loom/gen:bootstrap",
        "//loom/py/loom/gen/support",
    ],
)

iree_py_test(
    name = "numeric_conversion_matrix_test",
    srcs = [
        "numeric_conversion_matrix_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.test.numeric_conversion_matrix_test"],
    data = [
        "//loom/src/loom/test/corpus/encoding:fp8_bidirectional_decode_e4m3.loom",
        "//loom/src/loom/test/corpus/encoding:fp8_bidirectional_decode_e5m2.loom",
        "//loom/src/loom/test/corpus/encoding:fp8_bidirectional_encode_e4m3.loom",
        "//loom/src/loom/test/corpus/encoding:fp8_bidirectional_encode_e5m2.loom",
    ],
    main = "pytest_style_runner.py",
    deps = [":numeric_conversion_matrix"],
)
