load("//build_tools/bazel:python.bzl", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//loom/py/loom/gen:__subpackages__"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_library(
    name = "package",
    srcs = ["__init__.py"],
    imports = ["../.."],
)

iree_py_library(
    name = "bootstrap",
    srcs = ["bootstrap.py"],
    deps = [":package"],
)

iree_py_test(
    name = "bootstrap_test",
    srcs = [
        "bootstrap_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.bootstrap_test"],
    main = "pytest_style_runner.py",
    deps = [":bootstrap"],
)
