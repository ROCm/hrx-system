load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//loom/py/loom/gen:__subpackages__"],
    licenses = ["notice"],  # Apache 2.0
)

GENERATOR_VISIBILITY = [
    "//loom/py/loom/gen:__subpackages__",
    "//loom/src/loom/target/arch/amdgpu/contracts:__pkg__",
    "//loom/src/loom/target/arch/amd/xdna/aie2p/contracts:__pkg__",
    "//loom/src/loom/target/arch/llvmir/contracts:__pkg__",
    "//loom/src/loom/target/arch/spirv/contracts:__pkg__",
    "//loom/src/loom/target/arch/x86/contracts:__pkg__",
    "//loom/src/loom/target/emit/wasm/contracts:__pkg__",
    "//loom/src/loom/target/test/contracts:__pkg__",
]

iree_py_library(
    name = "package_init",
    srcs = ["__init__.py"],
)

CONTRACT_FRAGMENT_DEPS = [
    ":package_init",
    "//loom/py/loom:core",
    "//loom/py/loom/gen/support",
    "//loom/py/loom/gen/target:package",
    "//loom/py/loom/target/contracts",
]

iree_py_library(
    name = "contract_fragments",
    srcs = ["contract_fragments.py"],
    deps = CONTRACT_FRAGMENT_DEPS,
)

CONTRACT_FRAGMENT_SHARD_DEPS = [
    ":contract_fragments",
    "//loom/py/loom/target:contract_fragments",
]

iree_py_library(
    name = "contract_fragment",
    srcs = ["contract_fragment.py"],
    deps = CONTRACT_FRAGMENT_SHARD_DEPS,
)

LOWER_RULE_DEPS = [
    ":package_init",
    "//loom/py/loom:core",
    "//loom/py/loom/gen/support",
    "//loom/py/loom/gen/target:package",
    "//loom/py/loom/target:low_descriptors",
    "//loom/py/loom/target/contracts",
]

iree_py_library(
    name = "lower_rules",
    srcs = [
        "lower_rule_rows.py",
        "lower_rule_spelling.py",
        "lower_rules.py",
    ],
    deps = LOWER_RULE_DEPS,
)

iree_py_library(
    name = "contract_table_family",
    srcs = ["contract_table_family.py"],
    deps = [
        ":contract_fragments",
        ":lower_rules",
        "//loom/py/loom/gen/support",
        "//loom/py/loom/target:contract_fragments",
        "//loom/py/loom/target/contracts",
    ],
)

iree_py_binary(
    name = "amdgpu_contract_fragment",
    main_module = "loom.gen.target.contracts.contract_fragment",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":contract_fragment",
        "//loom/py/loom/target/arch/amdgpu/contracts",
    ],
)

iree_py_binary(
    name = "amdgpu_contract_table_family",
    main_module = "loom.gen.target.contracts.contract_table_family",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":contract_table_family",
        "//loom/py/loom/target/arch/amdgpu/contracts",
    ],
)

iree_py_binary(
    name = "aie2p_contract_table_family",
    main_module = "loom.gen.target.contracts.contract_table_family",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":contract_table_family",
        "//loom/py/loom/target/arch/amd/xdna/aie2p/contracts",
    ],
)

iree_py_binary(
    name = "llvmir_contract_table_family",
    main_module = "loom.gen.target.contracts.contract_table_family",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":contract_table_family",
        "//loom/py/loom/target/arch/llvmir:contracts",
    ],
)

iree_py_binary(
    name = "spirv_contract_table_family",
    main_module = "loom.gen.target.contracts.contract_table_family",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":contract_table_family",
        "//loom/py/loom/target/arch/spirv/contracts",
    ],
)

iree_py_binary(
    name = "test_low_contract_table_family",
    main_module = "loom.gen.target.contracts.contract_table_family",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":contract_table_family",
        "//loom/py/loom/target/test:contracts",
    ],
)

iree_py_binary(
    name = "wasm_contract_table_family",
    main_module = "loom.gen.target.contracts.contract_table_family",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":contract_table_family",
        "//loom/py/loom/target/emit/wasm:contracts",
    ],
)

iree_py_binary(
    name = "x86_contract_table_family",
    main_module = "loom.gen.target.contracts.contract_table_family",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":contract_table_family",
        "//loom/py/loom/target/arch/x86/contracts",
    ],
)

iree_py_test(
    name = "lower_rules_test",
    srcs = [
        "lower_rules_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.target.contracts.lower_rules_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":lower_rules",
        "//loom/py/loom/dialect/scalar",
        "//loom/py/loom/dialect/vector",
        "//loom/py/loom/target/contracts",
        "//loom/py/loom/target/test:descriptors",
    ],
)
