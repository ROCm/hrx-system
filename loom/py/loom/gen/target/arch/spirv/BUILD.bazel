load(
    "//build_tools/bazel:python.bzl",
    "iree_py_binary",
    "iree_py_library",
    "iree_py_test",
)
load(
    "//build_tools/spirv:registry_sources.bzl",
    "loom_spirv_registry_sources",
)
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//loom/py/loom/gen:__subpackages__"],
    licenses = ["notice"],  # Apache 2.0
)

GENERATOR_VISIBILITY = [
    "//loom/py/loom/gen:__subpackages__",
    "//loom/src/loom/target/arch/spirv:__pkg__",
]

_SPIRV_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target/arch:spirv",
])

loom_spirv_registry_sources(
    name = "registry_sources",
    target_compatible_with = _SPIRV_COMPATIBLE_WITH,
)

iree_py_binary(
    name = "features",
    srcs = [
        "__init__.py",
        "spirv_features.py",
    ],
    main = "spirv_features.py",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        ":feature_catalog_validation",
        "//loom/py/loom/gen/support",
        "//loom/py/loom/target/arch/spirv:features",
    ],
)

iree_py_library(
    name = "feature_catalog_validation",
    srcs = ["feature_catalog_validation.py"],
    deps = [
        "//build_tools/spirv/registry:registry_source",
        "//build_tools/spirv/registry:spirv_core_grammar",
        "//build_tools/spirv/registry:vulkan_spirv_availability",
        "//loom/py/loom/target/arch/spirv:features",
    ],
)

iree_py_test(
    name = "features_test",
    size = "small",
    srcs = [
        "spirv_features_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.target.arch.spirv.spirv_features_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":features",
        "//loom/py/loom/target/arch/spirv:features",
    ],
)

iree_py_test(
    name = "feature_catalog_validation_test",
    size = "small",
    srcs = ["feature_catalog_validation_test.py"],
    args = [
        "$(location //loom/src/loom/target/arch/spirv:isa.h)",
        "$(location @spirv_headers//:spirv_core_grammar_unified1)",
        "$(location @vulkan_headers//:vulkan_xml_registry)",
    ],
    data = [
        "//loom/src/loom/target/arch/spirv:isa.h",
        "@spirv_headers//:spirv_core_grammar_unified1",
        "@vulkan_headers//:vulkan_xml_registry",
    ],
    target_compatible_with = _SPIRV_COMPATIBLE_WITH,
    deps = [
        ":feature_catalog_validation",
        ":features",
        "//build_tools/spirv/registry:spirv_core_grammar",
        "//build_tools/spirv/registry:vulkan_spirv_availability",
        "//loom/py/loom/target/arch/spirv:features",
    ],
)

iree_py_binary(
    name = "packet_rows",
    srcs = [
        "__init__.py",
        "spirv_packet_rows.py",
    ],
    main = "spirv_packet_rows.py",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        "//loom/py/loom/gen/support",
        "//loom/py/loom/target:low_descriptors",
        "//loom/py/loom/target/arch/spirv:atomic",
        "//loom/py/loom/target/arch/spirv:builtins",
        "//loom/py/loom/target/arch/spirv:cooperative_matrix",
        "//loom/py/loom/target/arch/spirv:descriptors",
        "//loom/py/loom/target/arch/spirv:ordinary_vector",
        "//loom/py/loom/target/arch/spirv:ordinary_vector_bit_layout",
        "//loom/py/loom/target/arch/spirv:ordinary_vector_integer",
        "//loom/py/loom/target/arch/spirv:ordinary_vector_integer_conversion",
        "//loom/py/loom/target/arch/spirv:scalar_alu",
        "//loom/py/loom/target/arch/spirv:scalar_constant",
        "//loom/py/loom/target/arch/spirv:scalar_conversion",
        "//loom/py/loom/target/arch/spirv:scalar_memory",
    ],
)

iree_py_test(
    name = "packet_rows_test",
    srcs = [
        "spirv_packet_rows_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.target.arch.spirv.spirv_packet_rows_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":packet_rows",
    ],
)

iree_py_binary(
    name = "cooperative_properties",
    srcs = [
        "__init__.py",
        "spirv_cooperative_properties.py",
    ],
    main = "spirv_cooperative_properties.py",
    visibility = GENERATOR_VISIBILITY,
    deps = [
        "//loom/py/loom/gen/support",
        "//loom/py/loom/target:low_descriptors",
        "//loom/py/loom/target/arch/spirv:cooperative_matrix",
        "//loom/py/loom/target/arch/spirv:cooperative_vector",
        "//loom/py/loom/target/arch/spirv:descriptors",
    ],
)

iree_py_test(
    name = "cooperative_properties_test",
    srcs = [
        "spirv_cooperative_properties_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.target.arch.spirv.spirv_cooperative_properties_test"],
    main = "pytest_style_runner.py",
    deps = [
        ":cooperative_properties",
    ],
)
