load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

iree_py_library(
    name = "generator",
    srcs = [
        "__init__.py",
        "generate.py",
    ],
    deps = [
        "//loom/py/loom/gen/ops:c_tables",
        "//loom/py/loom/gen/support",
        "//loom/py/loom/target/arch/vm:projection",
        "//runtime/src/iree/vm/bytecode/spec",
    ],
)

iree_py_binary(
    name = "generate",
    main_module = "loom.gen.target.arch.vm.generate",
    deps = [":generator"],
)

iree_py_test(
    name = "generate_test",
    srcs = [
        "generate_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.target.arch.vm.generate_test"],
    imports = ["../../../../../../../runtime/src"],
    main = "pytest_style_runner.py",
    deps = [":generator"],
)

test_suite(
    name = "tests",
    tests = [":generate_test"],
)
