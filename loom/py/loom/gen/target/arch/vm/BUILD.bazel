load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_test")

package(
    default_visibility = ["//loom/py/loom/gen:__subpackages__"],
    licenses = ["notice"],
)

iree_py_binary(
    name = "tables",
    srcs = [
        "__init__.py",
        "vm_tables.py",
    ],
    main = "vm_tables.py",
    visibility = ["//loom/src/loom/target/arch/vm:__pkg__"],
    deps = [
        "//loom/py/loom/gen/ops:c_tables",
        "//loom/py/loom/gen/support",
        "//loom/py/loom/gen/target/low:low_descriptors",
        "//loom/py/loom/target/arch/vm:projection",
        "//loom/py/loom/target/arch/vm:verification",
        "//runtime/src/iree/vm/bytecode/spec/model",
        "//runtime/src/iree/vm/bytecode/spec/model/isa",
    ],
)

iree_py_test(
    name = "tables_test",
    srcs = [
        "vm_tables_test.py",
        "//loom/py/loom/tools:pytest_style_runner.py",
    ],
    args = ["loom.gen.target.arch.vm.vm_tables_test"],
    main = "pytest_style_runner.py",
    deps = [":tables"],
)
