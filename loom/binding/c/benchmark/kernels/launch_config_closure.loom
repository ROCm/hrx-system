// One launch configuration expressed as a retained callable closure. The
// noinline helpers keep the companion's function and call records observable.

amdgpu.target<gfx1100> @gfx1100

func.def pure noinline @add_workgroup_rounding(%element_count: index) -> (index) {
  %rounding = index.constant 255 : index
  %rounded_count = index.add %element_count, %rounding : index
  func.return %rounded_count : index
}

func.def pure noinline @divide_by_workgroup_size(%rounded_count: index) -> (index) {
  %workgroup_size = index.constant 256 : index
  %workgroup_count = index.div %rounded_count, %workgroup_size : index
  func.return %workgroup_count : index
}

kernel.def target(@gfx1100) @callable_1d(%element_count: index) {
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %rounded_count = func.call pure @add_workgroup_rounding(%element_count) : (index) -> (index)
  %workgroup_count = func.call pure @divide_by_workgroup_size(%rounded_count) : (index) -> (index)
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch() {
  kernel.return
}
