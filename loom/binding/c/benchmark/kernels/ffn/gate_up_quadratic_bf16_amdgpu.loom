// One BF16 gate/up output with F32 dot accumulation and quadratic gating.
// Gate and up are rounded to BF16 before gate * (0.5 + 0.25 * gate) * up;
// every epilogue operation rounds to BF16. The F32 output carries that value.

config.decl @ffn_gate_up.input_size : %value: index where [range(%value, 512, 4096), multiple_of(%value, 32)]

func.def inline @bf16_product(%lhs: vector<16xbf16>, %rhs: vector<16xbf16>) -> (vector<16xbf16>) {
  %c0 = vector.splatf 0.0 : vector<16xbf16>
  %initial = vector.splatf 0.0 : vector<16xf32>
  %left = vector.interleave<0> %lhs, %c0 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %right = vector.interleave<0> %rhs, %c0 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %product = vector.dot2f %left, %right, %initial : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %result = vector.fptrunc %product : vector<16xf32> to vector<16xbf16>
  func.return %result : vector<16xbf16>
}

func.def inline @gate_up_tile(%input_arg: buffer, %weights_arg: buffer, %output_arg: buffer) {
  %input, %weights, %output = buffer.assume.alignment %input_arg, %weights_arg, %output_arg {minimum_alignment = 64} : buffer, buffer, buffer
  %input_size = config.get @ffn_gate_up.input_size : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %step = index.constant 32 : index
  %initial = vector.splatf 0.0 : vector<16xf32>
  // Retain one 16-lane partial sum in local storage for the scalar reduction.
  %scratch_bytes = index.constant 64 : offset
  %scratch = buffer.alloca<private> align(64) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<16xf32>
  %lanes = index.constant 16 : index
  %input_view = buffer.view %input[%base] : buffer -> view<[%input_size]xbf16>
  %weights_view = buffer.view %weights[%base] : buffer -> view<2x[%input_size]xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<1xf32>
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %fzero = scalar.constant 0.0 : f32
  %gate_sum, %up_sum = scf.for %row = [%c0 to %c2 step %c1](%gate_iter = %fzero : f32, %up_iter = %fzero : f32) -> (f32, f32) {
    %parts = scf.for %position = [%c0 to %input_size step %step](%accumulator = %initial : vector<16xf32>) -> (vector<16xf32>) {
      %x = vector.load %input_view[%position] : view<[%input_size]xbf16> -> vector<32xbf16>
      %w = vector.load %weights_view[%row, %position] : view<2x[%input_size]xbf16> -> vector<32xbf16>
      %next = vector.dot2f %x, %w, %accumulator : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
      scf.yield %next : vector<16xf32>
    }
    vector.store %parts, %scratch_view[0] : vector<16xf32>, view<16xf32>
    %sum = scf.for %lane = [%c0 to %lanes step %c1](%sum_iter = %fzero : f32) -> (f32) {
      %part = view.load %scratch_view[%lane] : view<16xf32> -> f32
      %next_sum = scalar.addf %sum_iter, %part : f32
      scf.yield %next_sum : f32
    }
    %is_gate = index.cmp eq, %row, %c0 : index
    %gate_next = scf.select %is_gate, %sum, %gate_iter : f32
    %up_next = scf.select %is_gate, %up_iter, %sum : f32
    scf.yield %gate_next, %up_next : f32, f32
  }
  %gate_vector = vector.splat %gate_sum : vector<16xf32>
  %up_vector = vector.splat %up_sum : vector<16xf32>
  %gate = vector.fptrunc %gate_vector : vector<16xf32> to vector<16xbf16>
  %up = vector.fptrunc %up_vector : vector<16xf32> to vector<16xbf16>
  %quarters = vector.splatf 0.25 : vector<16xbf16>
  %halves = vector.splatf 0.5 : vector<16xf32>
  %linear = func.call @bf16_product(%gate, %quarters) : (vector<16xbf16>, vector<16xbf16>) -> (vector<16xbf16>)
  %linear_f32 = vector.extf %linear : vector<16xbf16> to vector<16xf32>
  %scale_f32 = vector.addf %halves, %linear_f32 : vector<16xf32>
  %scale = vector.fptrunc %scale_f32 : vector<16xf32> to vector<16xbf16>
  %activated = func.call @bf16_product(%gate, %scale) : (vector<16xbf16>, vector<16xbf16>) -> (vector<16xbf16>)
  %result_vector = func.call @bf16_product(%activated, %up) : (vector<16xbf16>, vector<16xbf16>) -> (vector<16xbf16>)
  %result = vector.extract %result_vector[0] : vector<16xbf16> -> bf16
  %result_f32 = scalar.extf %result : bf16 to f32
  view.store %result_f32, %output_view[0] : f32, view<1xf32>
  func.return
}

kernel.def retain export("ffn_gate_up_quadratic_bf16") @ffn_gate_up_quadratic_bf16() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %weights: buffer, %output: buffer) {
  func.call @gate_up_tile(%input, %weights, %output) : (buffer, buffer, buffer)
  kernel.return
}
