%t0_c10 = vector.load %t0_cv[%t0_ci10] : view<8192xi32> -> vector<64xi32>
%t0_cij11 = index.madd %t0_m1, %sixteen, %t0_n1 : index
%t0_ci11 = index.mul %t0_cij11, %frag : index
