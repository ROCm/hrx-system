%t0_ackbuf = buffer.alloca<workgroup> pool(%t0_peermem) align(64) %t0_ackbytes : buffer
%t0_ackslots = buffer.view %t0_ackbuf[%origin] : buffer -> view<1x1xi32>
%t0_ackchan = channel.bind<fifo> %t0_ackslots, %one : view<1x1xi32>, index -> channel<tile<1xi32>>
pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
%t0_copya = index.constant 128 : index
%t0_copyb = index.constant 256 : index
%t0_wid = index.constant 0 : index
%t0_init = vector.constant 0 : vector<64xi32>
scf.for %t0_tile = [%zero to %tiles step %one] {
%t0_tileid = index.madd %t0_tile, %workers, %t0_wid : index
%t0_mb = index.div %t0_tileid, %nblocks : index
%t0_nb = index.rem %t0_tileid, %nblocks : index
%t0_cw, %t0_cv = channel.reserve %t0_cchan : channel<tile<8192xi32>> -> (write<tile<8192xi32>>, view<8192xi32>)
scf.for %t0_z = [%zero to %initfrags step %one] {
