%t0_bbytes = index.constant 16384 : offset
%t0_bbuf = buffer.alloca<workgroup> pool(%t0_mem) align(64) %t0_bbytes : buffer
%t0_bslots = buffer.view %t0_bbuf[%origin] : buffer -> view<1x16384xi8>
%t0_bchan = channel.bind<fifo> %t0_bslots, %one : view<1x16384xi8>, index -> channel<tile<16384xi8>>
