%t0_sum00, %t0_sum01, %t0_sum10, %t0_sum11 = scf.for %t0_ki = [%zero to %kfrags step %one](%t0_acc00 = %t0_c00 : vector<64xi32>, %t0_acc01 = %t0_c01 : vector<64xi32>, %t0_acc10 = %t0_c10 : vector<64xi32>, %t0_acc11 = %t0_c11 : vector<64xi32>) -> (vector<64xi32>, vector<64xi32>, vector<64xi32>, vector<64xi32>) unroll(%unroll) schedule(linear) {
%t0_aij0 = index.madd %t0_m0, %kfrags, %t0_ki : index
%t0_ai0 = index.mul %t0_aij0, %frag : index
%t0_avec0 = vector.load %t0_av[%t0_ai0] : view<16384xi8> -> vector<64xi8>
%t0_af0 = vector.fragment<lhs> %t0_avec0 shape [%eight, %eight] : vector<64xi8>
