config.decl @whole_array.steps : %value: index where [range(%value, 1, 1023)]
config.decl @whole_array.tiles : %value: index where [range(%value, 1, 65536)]
config.decl @whole_array.nblocks : %value: index where [range(%value, 1, 2048)]
aie2p.target<array> @npu
pipeline.def<kernel> public retain target(@npu) @prefill_i8() run(%xarg: buffer, %warg: buffer, %yarg: buffer) {
  %x, %w, %y = buffer.assume.alignment %xarg, %warg, %yarg {minimum_alignment = 64} : buffer, buffer, buffer
%zero = index.constant 0 : index
%one = index.constant 1 : index
%two = index.constant 2 : index
%eight = index.constant 8 : index
%four = index.constant 4 : index
%steps = config.get @whole_array.steps : index
%tiles = config.get @whole_array.tiles : index
%nblocks = config.get @whole_array.nblocks : index
%workers = index.constant 16 : index
%initfrags = index.constant 128 : index
%frag = index.constant 64 : index
%origin = index.constant 0 : offset
%kfrags = index.constant 16 : index
%panelbytes = index.constant 16384 : offset
%sixteen = index.constant 16 : index
%half = index.constant 128 : index
%unroll = index.constant 4 : index
