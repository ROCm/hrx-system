%t0_mem = pipeline.memory<workgroup>[0, 2] : pool
%t0_abytes = index.constant 16384 : offset
%t0_abuf = buffer.alloca<workgroup> pool(%t0_mem) align(64) %t0_abytes : buffer
%t0_aslots = buffer.view %t0_abuf[%origin] : buffer -> view<1x16384xi8>
