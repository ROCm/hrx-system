load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//build_tools/sanitizer:suppressions.bzl", "vulkan_suppressions")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_cmake_extra_content",
    "loom_cc_binary",
    "loom_cc_test",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:defs.bzl", "loom_module")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

LOOMC_TARGET_SPIRV_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target/arch:spirv",
    "//loom/config/emit:spirv",
])

LOOMC_TARGET_AMDGPU_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target/arch:amdgpu",
    "//loom/config/emit:amdgpu",
])

LOOMC_TARGET_SPIRV_VULKAN_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:spirv_vulkan_hal",
])

LOOMC_TARGET_SPIRV_IREE_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:spirv_vulkan_artifacts",
])

loom_cc_binary(
    name = "source_info",
    srcs = ["source_info.c"],
    deps = [
        "//loom/binding/c:loomc",
    ],
)

loom_cc_binary(
    name = "compile_text",
    srcs = ["compile_text.c"],
    deps = [
        "//loom/binding/c:loomc",
    ],
)

loom_cc_binary(
    name = "link_modules",
    srcs = ["link_modules.c"],
    deps = [
        "//loom/binding/c:loomc",
    ],
)

iree_executable_test(
    name = "link_modules_test",
    src = ":link_modules",
)

iree_cmake_extra_content(
    content = """
if(IREE_TARGET_HAS_THREADS)
""",
    inline = True,
)

loom_cc_binary(
    name = "product_frontier",
    srcs = ["product_frontier.c"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c:task_pool",
        "//loom/binding/c:task_queue",
        "//loom/binding/c/target/cmd",
    ],
)

iree_executable_test(
    name = "product_frontier_test",
    src = ":product_frontier",
)

loom_cc_binary(
    name = "jit_task_pool",
    srcs = ["jit_task_pool.c"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c:task_pool",
        "//loom/binding/c:task_queue",
    ],
)

iree_executable_test(
    name = "jit_task_pool_test",
    src = ":jit_task_pool",
)

iree_cmake_extra_content(
    content = """
endif()
""",
    inline = True,
)

loom_cc_binary(
    name = "emit_spirv_offline",
    srcs = ["emit_spirv_offline.c"],
    target_compatible_with = LOOMC_TARGET_SPIRV_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/spirv",
    ],
)

loom_module(
    name = "targetless_store_i32_bytecode",
    srcs = ["targetless_store_i32.loom"],
    output_format = "bc",
    visibility = ["//visibility:private"],
)

iree_c_embed_data(
    name = "targetless_store_i32_bytecode_data",
    srcs = [":targetless_store_i32_bytecode"],
    c_file_output = "targetless_store_i32_bytecode.c",
    flatten = True,
    h_file_output = "targetless_store_i32_bytecode.h",
    identifier = "loomc_example_targetless_store_i32_bytecode",
    visibility = ["//visibility:private"],
)

loom_cc_binary(
    name = "emit_amdgpu_offline",
    srcs = ["emit_amdgpu_offline.c"],
    target_compatible_with = LOOMC_TARGET_AMDGPU_COMPATIBLE_WITH,
    deps = [
        ":targetless_store_i32_bytecode_data",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
    ],
)

loom_cc_binary(
    name = "emit_amdgpu_hsa",
    srcs = ["emit_amdgpu_hsa.c"],
    target_compatible_with = LOOMC_TARGET_AMDGPU_COMPATIBLE_WITH,
    deps = [
        "//build_tools/bazel:dl",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
        "//third_party:hsa_runtime_headers",
    ],
)

loom_cc_binary(
    name = "emit_spirv_vulkaninfo",
    srcs = ["emit_spirv_vulkaninfo.c"],
    target_compatible_with = LOOMC_TARGET_SPIRV_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/spirv",
        "//loom/binding/c/target/spirv/vulkaninfo",
    ],
)

loom_cc_binary(
    name = "emit_spirv_vulkan",
    srcs = ["emit_spirv_vulkan.c"],
    target_compatible_with = LOOMC_TARGET_SPIRV_VULKAN_COMPATIBLE_WITH,
    deps = [
        "//build_tools/bazel:dl",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/spirv",
        "//loom/binding/c/target/spirv/vulkan",
    ],
)

loom_cc_binary(
    name = "emit_spirv_iree_hal",
    srcs = ["emit_spirv_iree_hal.c"],
    target_compatible_with = LOOMC_TARGET_SPIRV_IREE_HAL_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/iree_hal",
        "//loom/binding/c/target/spirv",
        "//loom/binding/c/target/spirv/iree_hal",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers",
    ],
)

iree_executable_test(
    name = "emit_amdgpu_offline_test",
    src = ":emit_amdgpu_offline",
    target_compatible_with = LOOMC_TARGET_AMDGPU_COMPATIBLE_WITH,
)

loom_cc_test(
    name = "emit_amdgpu_hsa_test",
    srcs = ["emit_amdgpu_hsa.c"],
    resource_group = "loom-amdgpu-tests",
    tags = [
        "driver=amdgpu",
        "iree-run-requirement=runtime.resource.amd_gpu",
        "nodocker",
        "requires-gpu-amd",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = LOOMC_TARGET_AMDGPU_COMPATIBLE_WITH,
    deps = [
        "//build_tools/bazel:dl",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
        "//third_party:hsa_runtime_headers",
    ],
)

loom_cc_test(
    name = "emit_spirv_vulkan_test",
    srcs = ["emit_spirv_vulkan.c"],
    resource_group = "loom-vulkan-tests",
    sanitizer_suppressions = vulkan_suppressions,
    tags = [
        "driver=vulkan",
        "iree-run-requirement=runtime.resource.vulkan_device",
        "runtime-resource=vulkan-device",
    ],
    target_compatible_with = LOOMC_TARGET_SPIRV_VULKAN_COMPATIBLE_WITH,
    deps = [
        "//build_tools/bazel:dl",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/spirv",
        "//loom/binding/c/target/spirv/vulkan",
    ],
)

loom_cc_test(
    name = "emit_spirv_iree_hal_test",
    srcs = ["emit_spirv_iree_hal.c"],
    resource_group = "loom-vulkan-tests",
    sanitizer_suppressions = vulkan_suppressions,
    tags = [
        "driver=vulkan",
        "iree-run-requirement=runtime.resource.vulkan_device",
        "runtime-resource=vulkan-device",
    ],
    target_compatible_with = LOOMC_TARGET_SPIRV_VULKAN_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/iree_hal",
        "//loom/binding/c/target/spirv",
        "//loom/binding/c/target/spirv/iree_hal",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers",
    ],
)
