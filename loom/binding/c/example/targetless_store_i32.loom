kernel.def export("targetless_store_i32") @targetless_store_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %base_offset = index.constant 0 : offset
  %element_index = index.constant 0 : index
  %value = scalar.constant 42 : i32
  %global = buffer.assume.memory_space<global> %output : buffer
  %view = buffer.view %global[%base_offset] : buffer -> view<1xi32>
  view.store %value, %view[%element_index] : i32, view<1xi32>
  kernel.return
}
