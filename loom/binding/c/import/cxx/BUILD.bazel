load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# The optional importer implementation is compiled into loomc itself.
exports_files(
    ["cxx.c"],
    visibility = ["//loom/binding/c:__pkg__"],
)

alias(
    name = "cxx",
    actual = "//loom/binding/c:loomc",
    tags = ["cmake-library-alias"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_cc_test(
    name = "cxx_test",
    srcs = ["cxx_test.cc"],
    deps = [
        ":cxx",
        "//loom/binding/c:loomc",
        "//loom/binding/c/test:test_util",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
