#ifndef LOOMC_VERSION_H_
#define LOOMC_VERSION_H_

#include "loomc/base.h"

/// @file
/// Loom C API package version.

#ifdef __cplusplus
extern "C" {
#endif

#define LOOMC_VERSION_MAJOR @LOOMC_VERSION_MAJOR@
#define LOOMC_VERSION_MINOR @LOOMC_VERSION_MINOR@
#define LOOMC_VERSION_PATCH @LOOMC_VERSION_PATCH@

/// Returns the Loom C API package version compiled into the library.
LOOMC_API_EXPORT void loomc_version(int* major, int* minor, int* patch);

#ifdef __cplusplus
}  // extern "C"
#endif

#endif  // LOOMC_VERSION_H_
