load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_test(
    name = "iree_hal_test",
    srcs = ["iree_hal_test.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:x86_task_hal",
    ]) + ["@platforms//cpu:x86_64"],
    deps = [
        "//loom/binding/c:interop",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/configured",
        "//loom/binding/c/target/cpu:iree_hal",
        "//loom/binding/c/target/iree_hal",
        "//loom/binding/c/test:test_util",
        "//loom/src/loom/target:profile",
        "//loom/src/loom/target/arch/x86:facts",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:cpu",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/driver/task:device_spec",
        "//runtime/src/iree/hal/driver/task/executable/elf:elf_module",
        "//runtime/src/iree/hal/utils:device_spec_builder",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
