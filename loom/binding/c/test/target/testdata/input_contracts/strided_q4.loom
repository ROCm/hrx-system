template.decl @load(%n: index, %layout: encoding<storage>, %input: view<2x[%n]xi8, %layout>) -> (i32)

func.def public @entry(%buffer: buffer) -> (i32) {
  %n = index.constant 18 : index
  %layout = encoding.define #encoding.storage<layout=#encoding.layout.strided<strides=[18, 1]>, schema=#ggml.q4_0> : encoding<storage>
