load("//build_tools/sanitizer:suppressions.bzl", "rocm_suppressions")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
])

_AMDGPU_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

loom_cc_test(
    name = "amdgpu_test",
    srcs = ["amdgpu_test.cc"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
        "//loom/binding/c/target/cmd",
        "//loom/binding/c/test:test_util",
        "//loom/binding/c/test/target/amdgpu/testdata:launch_config_callable_closure",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "iree_hal_test",
    srcs = ["iree_hal_test.cc"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
        "//loom/binding/c/target/amdgpu:iree_hal",
        "//loom/binding/c/target/iree_hal",
        "//loom/binding/c/test:test_util",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/utils:device_spec_builder",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "iree_hal_execution_test",
    srcs = ["iree_hal_execution_test.cc"],
    sanitizer_suppressions = rocm_suppressions,
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
        "//loom/binding/c/target/amdgpu:iree_hal",
        "//loom/binding/c/target/iree_hal",
        "//loom/binding/c/test/target:iree_hal_execution_test_util",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
