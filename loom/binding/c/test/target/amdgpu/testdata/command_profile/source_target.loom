amdgpu.target<gfx942> @device

kernel.def target(@device) @tiles() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

command.def public @dispatch() launch() {
  kernel.launch @tiles() : ()
  command.return
}
