target.decl @device

config.decl @test.count : index

template.decl @subgroup_body(%size: index)

template.def<@subgroup_body> requires [#target.subgroup.size<32>] @subgroup32(%size: index) where [eq(%size, 32)] {
  template.return
}

template.def<@subgroup_body> requires [#target.subgroup.size<64>] @subgroup64(%size: index) where [eq(%size, 64)] {
  template.return
}

kernel.def target(@device) @tiles() {
  %c1 = index.constant 1 : index
  %size = target.subgroup.size : index
  %count = config.get @test.count : index
  %rounding = index.sub %size, %c1 : index
  %rounded = index.add %count, %rounding : index
  %groups = index.div %rounded, %size : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch() {
  %subgroup = target.subgroup.size : index
  template.apply<@subgroup_body>(%subgroup) : (index)
  kernel.return
}

kernel.def @wide_tiles() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %subgroup = target.subgroup.size : index
  %size = index.mul %subgroup, %c2 : index
  %count = config.get @test.count : index
  %rounding = index.sub %size, %c1 : index
  %rounded = index.add %count, %rounding : index
  %groups = index.div %rounded, %size : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch() {
  %subgroup = target.subgroup.size : index
  template.apply<@subgroup_body>(%subgroup) : (index)
  kernel.return
}

command.def public @dispatch() launch() {
  kernel.launch @tiles() : ()
  kernel.launch @wide_tiles() : ()
  command.return
}
