// Packed argument bytes cross the public C API and native kernarg ABI.
kernel.def @select_vector_arguments() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %values: vector<20xi32>, %left: vector<5xi1>, %scalar_predicate: i1, %right: vector<3xi1>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<20xi32>
  %fallback0 = view.load %input_view[0] : view<4xi32> -> i32
  %fallback1 = view.load %input_view[1] : view<4xi32> -> i32
  %fallback2 = view.load %input_view[2] : view<4xi32> -> i32
  %fallback3 = view.load %input_view[3] : view<4xi32> -> i32
  %value0 = vector.extract %values[0] : vector<20xi32> -> i32
  %value15 = vector.extract %values[15] : vector<20xi32> -> i32
  %value16 = vector.extract %values[16] : vector<20xi32> -> i32
  %value19 = vector.extract %values[19] : vector<20xi32> -> i32
  %identity = vector.shuffle<[0, 1, 2, 3, 4]> %left : vector<5xi1>
  %predicates = vector.concat<0> %identity, %right : vector<5xi1>, vector<3xi1> -> vector<8xi1>
  %predicate0 = vector.extract %predicates[0] : vector<8xi1> -> i1
  %predicate1 = vector.extract %predicates[1] : vector<8xi1> -> i1
  %predicate2 = vector.extract %predicates[2] : vector<8xi1> -> i1
  %predicate3 = vector.extract %predicates[3] : vector<8xi1> -> i1
  %selected0 = scf.select %predicate0, %value0, %fallback0 : i32
  %selected1 = scf.select %predicate1, %value15, %fallback1 : i32
  %selected2 = scf.select %predicate2, %value16, %fallback2 : i32
  %selected3 = scf.select %predicate3, %value19, %fallback3 : i32
  %scalar_selected = scf.select %scalar_predicate, %value19, %fallback3 : i32
  %predicate_word0 = scalar.extui %predicate0 : i1 to i32
  %predicate_word1 = scalar.extui %predicate1 : i1 to i32
  %predicate_word2 = scalar.extui %predicate2 : i1 to i32
  %predicate_word3 = scalar.extui %predicate3 : i1 to i32
  %selected = vector.from_elements %selected0, %selected1, %selected2, %selected3, %predicate_word0, %predicate_word1, %predicate_word2, %predicate_word3 : vector<8xi32>
  vector.store %selected, %output_view[0] : vector<8xi32>, view<20xi32>
  %enabled = vector.splati 1 : vector<8xi32>
  %disabled = vector.splati 0 : vector<8xi32>
  %words = vector.select %predicates, %enabled, %disabled : vector<8xi32>
  vector.store %words, %output_view[8] : vector<8xi32>, view<20xi32>
  view.store %scalar_selected, %output_view[16] : i32, view<20xi32>
  %true = scalar.constant 1 : i1
  %inverse = scalar.xori %scalar_predicate, %true : i1
  %constructed = vector.from_elements %scalar_predicate, %inverse, %scalar_predicate : vector<3xi1>
  %constructed_ones = vector.splati 1 : vector<3xi32>
  %constructed_zeros = vector.splati 0 : vector<3xi32>
  %constructed_words = vector.select %constructed, %constructed_ones, %constructed_zeros : vector<3xi32>
  vector.store %constructed_words, %output_view[17] : vector<3xi32>, view<20xi32>
  kernel.return
}
