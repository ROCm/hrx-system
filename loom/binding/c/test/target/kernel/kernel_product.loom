  %c100 = index.constant 100 : index
  %workgroup_count = index.add %workload, %c100 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch() {
  kernel.return
}

