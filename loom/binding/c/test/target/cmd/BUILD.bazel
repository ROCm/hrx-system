load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_test",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target:execution_profiles.bzl", "GPU_HARDWARE_PROFILES")
load("//loom/target/x86:execution_profiles.bzl", "X86_TASK_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_test(
    name = "program_test",
    srcs = ["program_test.cc"],
    deps = [
        "//loom/binding/c:interop",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/cmd",
        "//loom/binding/c/test:test_util",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "specialization_test",
    srcs = ["specialization_test.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/emit:amdgpu_elf",
    ]),
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
        "//loom/binding/c/target/cmd",
        "//loom/binding/c/test:test_util",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_c_embed_data(
    name = "native_source_testdata",
    testonly = True,
    srcs = [
        "//loom/binding/c/test/target/cmd/testdata/native_sources:class_admission.loom",
        "//loom/binding/c/test/target/cmd/testdata/native_sources:command.loom",
        "//loom/binding/c/test/target/cmd/testdata/native_sources:providers.loom-test",
        "//loom/binding/c/test/target/cmd/testdata/native_sources:residual_shapes.loom",
    ],
    c_file_output = "native_source_testdata.c",
    flatten = True,
    h_file_output = "native_source_testdata.h",
    identifier = "loomc_cmd_native_source_testdata",
    visibility = ["//visibility:private"],
)

loom_cc_test(
    name = "native_source_test",
    srcs = ["native_source_test.cc"],
    deps = [
        ":native_source_testdata",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/cmd",
        "//loom/binding/c/test:test_util",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_test(
    name = "native_source_shapes_test",
    srcs = ["//loom/binding/c/test/target/cmd/testdata/native_sources:structural_specializations.loom"],
    benchmark_smoke = False,
    execution_profiles = GPU_HARDWARE_PROFILES + [X86_TASK_HARDWARE_PROFILE],
)
