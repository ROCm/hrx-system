config.def @mode = 0 : index

template.decl @choose(%mode: index) -> (index)

kernel.def @compute() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %mode = config.get @mode : index
  %value = template.apply<@choose>(%mode) : (index) -> (index)
  %value_i32 = index.cast %value : index to i32
  %offset = index.constant 0 : offset
  %position = index.constant 0 : index
  %data = buffer.view %output[%offset] : buffer -> view<1xi32>
  view.store %value_i32, %data[%position] : i32, view<1xi32>
  kernel.return
}

command.def public @dispatch() launch(%output: buffer) {
  kernel.launch @compute(%output) : (buffer)
  command.return
}
