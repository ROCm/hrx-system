// Literal families exercise cross-module identity and retained plan ownership.
template.decl @staged_choose(%matches: i1, %columns: index, %input: view<32xi32>) -> (i32)

pipeline.def<kernel> @staged_scalar(%value: index) run(%columns: index, %input: view<32xi32>, %output: view<1xi32>) {
  %matching_value = index.constant 4 : index
  %matches = index.cmp eq, %value, %matching_value : index
  %result = template.apply<@staged_choose>(%matches, %columns, %input) : (i1, index, view<32xi32>) -> (i32)
  pipeline.strand<cooperative> workers([0], [1], [1]) {
    view.store %result, %output[0] : i32, view<1xi32>
  }
}

command.def public @staged_scalar_match() launch(%input_storage: buffer, %output16_storage: buffer, %output32_storage: buffer) {
  %value = index.constant 4 : index
  %columns16 = index.constant 16 : index
  %columns32 = index.constant 32 : index
  %base = index.constant 0 : offset
  %input = buffer.view %input_storage[%base] : buffer -> view<32xi32>
  %output16 = buffer.view %output16_storage[%base] : buffer -> view<1xi32>
  %output32 = buffer.view %output32_storage[%base] : buffer -> view<1xi32>
  kernel.launch @staged_scalar[%value](%columns16, %input, %output16) : [index](index, view<32xi32>, view<1xi32>)
  kernel.launch @staged_scalar[%value](%columns32, %input, %output32) : [index](index, view<32xi32>, view<1xi32>)
  command.return
}

