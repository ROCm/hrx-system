load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")

package(
    default_visibility = ["//loom/binding/c/test:__pkg__"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_c_embed_data(
    name = "link_dependency",
    testonly = True,
    srcs = glob(["link_dependency/*.loom"]),
    c_file_output = "link_dependency_testdata.c",
    flatten = True,
    h_file_output = "link_dependency_testdata.h",
    identifier = "loomc_link_dependency_testdata",
)
