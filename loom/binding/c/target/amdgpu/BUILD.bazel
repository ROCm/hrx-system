load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_library",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target/arch:amdgpu",
    "//loom/config/emit:amdgpu",
])

_VM_LAUNCH_CONFIG_COPTS = iree_select({
    "//loom/config/target/arch:vm": [
        "-DLOOMC_TARGET_HAVE_VM_LAUNCH_CONFIG=1",
    ],
    "//conditions:default": [],
})

_VM_LAUNCH_CONFIG_DEPS = iree_select({
    "//loom/config/target/arch:vm": [
        "//loom/src/loom/target/arch/vm:provider",
        "//loom/src/loom/target/emit/vm:launch_config_compiler",
    ],
    "//conditions:default": [],
})

loom_cc_library(
    name = "amdgpu",
    srcs = ["amdgpu.c"],
    hdrs = [
        "//loom/binding/c:include/loomc/target/amdgpu.h",
        "//loom/binding/c:include/loomc/target/amdgpu/base.h",
        "//loom/binding/c:include/loomc/target/amdgpu/emit.h",
        "//loom/binding/c:include/loomc/target/amdgpu/profile.h",
    ],
    copts = _VM_LAUNCH_CONFIG_COPTS,
    linkstatic = True,
    target_compatible_with = _AMDGPU_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/amdgpu:amdhsa_target_id",
        "//loom/src/loom/target/arch/amdgpu:artifact_key",
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:provider",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//loom/src/loom/target/arch/amdgpu/ops",
        "//loom/src/loom/target/arch/amdgpu/records:target_records",
        "//loom/src/loom/target/emit/native/amdgpu:hal_kernel_library",
        "//runtime/src/iree/base",
    ] + _VM_LAUNCH_CONFIG_DEPS,
    alwayslink = True,
)

loom_cc_library(
    name = "iree_hal",
    srcs = ["iree_hal.c"],
    hdrs = ["//loom/binding/c:include/loomc/target/amdgpu/iree_hal.h"],
    linkstatic = True,
    target_compatible_with = _AMDGPU_COMPATIBLE_WITH,
    deps = [
        ":amdgpu",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/iree_hal",
        "//loom/src/loom/target/arch/amdgpu:artifact_key",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//runtime/src/iree/hal",
    ],
    alwayslink = True,
)

iree_assert_dependency_boundary(
    name = "iree_hal_no_runtime_amdgpu_dependencies",
    forbidden_subtrees = [
        "//runtime/src/iree/amdgpu/...",
        "//runtime/src/iree/hal/drivers/amdgpu/...",
        "//runtime/src/iree/hal/executable/amdgpu/...",
    ],
    target = ":iree_hal",
)
