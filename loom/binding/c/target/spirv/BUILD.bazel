load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_SPIRV_ARCH_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/arch:spirv",
])

_SPIRV_COMPATIBLE_WITH = _SPIRV_ARCH_COMPATIBLE_WITH + loom_config_compatible_with([
    "//loom/config/emit:spirv_binary",
])

loom_cc_library(
    name = "profile",
    srcs = [
        "profile.c",
        "profile_rows.c",
    ],
    hdrs = [
        "profile_rows.h",
        "//loom/binding/c:include/loomc/target/spirv/base.h",
        "//loom/binding/c:include/loomc/target/spirv/profile.h",
    ],
    linkstatic = True,
    target_compatible_with = _SPIRV_ARCH_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/spirv:cooperative_properties",
        "//loom/src/loom/target/arch/spirv:error_defs",
        "//loom/src/loom/target/arch/spirv:features",
        "//loom/src/loom/target/arch/spirv:profile",
        "//loom/src/loom/target/arch/spirv/records:target_records",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "spirv",
    srcs = ["spirv.c"],
    hdrs = [
        "//loom/binding/c:include/loomc/target/spirv.h",
        "//loom/binding/c:include/loomc/target/spirv/base.h",
        "//loom/binding/c:include/loomc/target/spirv/emit.h",
        "//loom/binding/c:include/loomc/target/spirv/profile.h",
    ],
    linkstatic = True,
    target_compatible_with = _SPIRV_COMPATIBLE_WITH,
    deps = [
        ":profile",
        "//loom/binding/c:loomc",
        "//loom/src/loom/target/emit/spirv:binary_compiler_provider",
    ],
    alwayslink = True,
)

iree_assert_dependency_boundary(
    name = "spirv_has_no_tooling_target_dependencies",
    forbidden_subtrees = ["//loom/src/loom/tooling/target/..."],
    message = "The LoomC SPIR-V target package must compose compiler-owned target emission without tooling target adapters",
    target = ":spirv",
)

loom_cc_library(
    name = "iree_hal",
    srcs = ["iree_hal.c"],
    hdrs = ["//loom/binding/c:include/loomc/target/spirv/iree_hal.h"],
    linkstatic = True,
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:spirv_vulkan_hal",
    ]),
    deps = [
        ":profile",
        ":spirv",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/iree_hal",
        "//loom/src/loom/target/arch/spirv:cooperative_properties",
        "//loom/src/loom/target/arch/spirv:features",
        "//loom/src/loom/target/arch/spirv:profile",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/driver/vulkan:device_spec",
    ],
    alwayslink = True,
)
