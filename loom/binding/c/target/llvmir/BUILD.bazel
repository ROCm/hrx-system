load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_library",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_LLVMIR_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:llvmir_artifacts",
])

_VM_LAUNCH_CONFIG_COPTS = iree_select({
    "//loom/config/target/arch:vm": [
        "-DLOOMC_TARGET_HAVE_VM_LAUNCH_CONFIG=1",
    ],
    "//conditions:default": [],
})

_VM_LAUNCH_CONFIG_DEPS = iree_select({
    "//loom/config/target/arch:vm": [
        "//loom/src/loom/target/arch/vm:provider",
        "//loom/src/loom/target/emit/vm:launch_config_compiler",
    ],
    "//conditions:default": [],
})

loom_cc_library(
    name = "llvmir",
    srcs = ["llvmir.c"],
    hdrs = [
        "//loom/binding/c:include/loomc/target/llvmir.h",
        "//loom/binding/c:include/loomc/target/llvmir/base.h",
        "//loom/binding/c:include/loomc/target/llvmir/emit.h",
    ],
    copts = _VM_LAUNCH_CONFIG_COPTS,
    linkstatic = True,
    target_compatible_with = _LLVMIR_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/target/arch/llvmir:provider",
        "//loom/src/loom/target/emit/llvmir:artifact_emitter",
    ] + _VM_LAUNCH_CONFIG_DEPS,
    alwayslink = True,
)
