load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

alias(
    name = "cmd",
    actual = "//loom/binding/c:loomc",
    tags = ["cmake-library-alias"],
)

loom_cc_library(
    name = "cmd_impl",
    srcs = ["program.c"],
    hdrs = [
        "//loom/binding/c:include/loomc/target/cmd.h",
        "//loom/binding/c:include/loomc/target/cmd/program.h",
    ],
    linkstatic = True,
    visibility = ["//loom/binding/c:implementation"],
    deps = [
        "//loom/binding/c:loomc_core",
        "//loom/src/loom/ir",
        "//loom/src/loom/link:module_index",
        "//loom/src/loom/pass:builtin_registry",
        "//loom/src/loom/target/arch/cmd:artifact_builder",
        "//loom/src/loom/target/arch/cmd:artifact_set",
        "//loom/src/loom/transforms/cleanup:configured",
        "//loom/src/loom/transforms/kernel:kernel_class_materializer",
        "//loom/src/loom/transforms/kernel:kernel_request_producer",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:arena",
    ],
)
