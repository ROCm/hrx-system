load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "hal",
    srcs = ["hal.c"],
    hdrs = ["//loom/binding/c:include/loomc/target/cmd/hal.h"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/cmd:program",
        "//loom/binding/c/target/cmd:program_internal",
        "//loom/src/loom/target/arch/cmd/hal:recording",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/hal",
    ],
)
