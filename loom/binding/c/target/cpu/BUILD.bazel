load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "iree_hal",
    srcs = ["iree_hal.c"],
    hdrs = ["//loom/binding/c:include/loomc/target/cpu/iree_hal.h"],
    linkstatic = True,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/iree_hal",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/task:device_spec",
    ],
    alwayslink = True,
)

iree_assert_dependency_boundary(
    name = "iree_hal_has_no_tooling_target_dependencies",
    forbidden_subtrees = ["//loom/src/loom/tooling/target/..."],
    message = "The LoomC CPU HAL target package must select compiler-owned native profiles without tooling target adapters",
    target = ":iree_hal",
)
