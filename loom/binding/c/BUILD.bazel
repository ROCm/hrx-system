load("//build_tools/bazel:package_boundary.bzl", "iree_package_boundary")
load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_cmake_extra_content",
    "loom_cc_library",
    "loom_cc_library_group",
    "loom_config_compatible_with",
)
load(":public_headers.bzl", "LOOMC_PUBLIC_HDRS")
load(":shared.bzl", "loomc_interop_headers", "loomc_shared_libraries")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Private compiler contracts grant access to the implementation owner instead
# of coupling their visibility to the public SDK facade package.
package_group(
    name = "implementation",
    packages = ["//loom/binding/c/src"],
)

iree_package_boundary(
    allowed_descendant_paths = [
        "exports/iree_exports.lds",
        "exports/iree_exports.macos",
        "exports/loomc_exports.lds",
        "exports/loomc_exports.macos",
        "include/**",
    ],
    reason = "The installed LoomC SDK preserves its public include tree and platform export-map paths.",
)

iree_cmake_extra_content(
    content = """
set(IREE_PACKAGE_ROOT_DIR "${_IREE_PACKAGE_SOURCE_DIR}")
set(IREE_PACKAGE_ROOT_PREFIX "loom/binding/c")
""",
)

LOOMC_TARGET_SPIRV_PUBLIC_HDRS = [
    "include/loomc/target/spirv.h",
    "include/loomc/target/spirv/base.h",
    "include/loomc/target/spirv/emit.h",
    "include/loomc/target/spirv/profile.h",
]

LOOMC_TARGET_AMDGPU_PUBLIC_HDRS = [
    "include/loomc/target/amdgpu.h",
    "include/loomc/target/amdgpu/base.h",
    "include/loomc/target/amdgpu/profile.h",
]

LOOMC_TARGET_AMDGPU_IREE_HAL_PUBLIC_HDRS = [
    "include/loomc/target/amdgpu/iree_hal.h",
]

LOOMC_TARGET_CPU_IREE_HAL_PUBLIC_HDRS = [
    "include/loomc/target/cpu/iree_hal.h",
]

LOOMC_TARGET_XDNA_PUBLIC_HDRS = [
    "include/loomc/target/amd/xdna.h",
    "include/loomc/target/amd/xdna/base.h",
    "include/loomc/target/amd/xdna/iree_hal.h",
    "include/loomc/target/amd/xdna/profile.h",
]

LOOMC_TARGET_VM_PUBLIC_HDRS = [
    "include/loomc/target/vm.h",
]

LOOMC_TARGET_WASM_PUBLIC_HDRS = [
    "include/loomc/target/wasm.h",
]

LOOMC_TARGET_X86_PUBLIC_HDRS = [
    "include/loomc/target/x86.h",
]

LOOMC_TARGET_CONFIGURED_PUBLIC_HDRS = [
    "include/loomc/target/configured.h",
    "include/loomc/target/configured_ir.h",
    "include/loomc/target/configured_target.h",
]

LOOMC_TARGET_CMD_PUBLIC_HDRS = [
    "include/loomc/target/cmd.h",
    "include/loomc/target/cmd/program.h",
]

LOOMC_TARGET_SPIRV_VULKANINFO_PUBLIC_HDRS = [
    "include/loomc/target/spirv/vulkaninfo.h",
]

LOOMC_TARGET_SPIRV_VULKAN_PUBLIC_HDRS = [
    "include/loomc/target/spirv/vulkan.h",
]

LOOMC_TARGET_SPIRV_IREE_HAL_PUBLIC_HDRS = [
    "include/loomc/target/spirv/iree_hal.h",
]

LOOMC_TARGET_IREE_HAL_PUBLIC_HDRS = [
    "include/loomc/target/iree_hal.h",
]

_TARGET_EXTENSION_VISIBILITY = [
    "//loom/binding/c/target:__subpackages__",
]

exports_files(
    LOOMC_PUBLIC_HDRS + [
        "include/loomc/interop.h",
        "include/loomc/iree/task_pool.h",
        "include/loomc/task_pool.h",
        "include/loomc/task_queue.h",
    ],
    visibility = ["//loom/binding/c/src:__pkg__"],
)

exports_files(
    ["include/loomc/import/cxx.h"],
    visibility = ["//loom/binding/c/import/cxx:__pkg__"],
)

_LOOMC_FULL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:spirv_vulkan_hal",
])

exports_files(
    LOOMC_TARGET_AMDGPU_IREE_HAL_PUBLIC_HDRS +
    LOOMC_TARGET_AMDGPU_PUBLIC_HDRS +
    LOOMC_TARGET_CMD_PUBLIC_HDRS +
    LOOMC_TARGET_CONFIGURED_PUBLIC_HDRS +
    LOOMC_TARGET_CPU_IREE_HAL_PUBLIC_HDRS +
    LOOMC_TARGET_IREE_HAL_PUBLIC_HDRS +
    LOOMC_TARGET_SPIRV_PUBLIC_HDRS +
    LOOMC_TARGET_SPIRV_IREE_HAL_PUBLIC_HDRS +
    LOOMC_TARGET_SPIRV_VULKANINFO_PUBLIC_HDRS +
    LOOMC_TARGET_SPIRV_VULKAN_PUBLIC_HDRS +
    LOOMC_TARGET_VM_PUBLIC_HDRS +
    LOOMC_TARGET_WASM_PUBLIC_HDRS +
    LOOMC_TARGET_X86_PUBLIC_HDRS +
    LOOMC_TARGET_XDNA_PUBLIC_HDRS,
    visibility = _TARGET_EXTENSION_VISIBILITY,
)

loom_cc_library_group(
    name = "base",
    deps = ["//loom/binding/c/src:base"],
)

iree_assert_dependency_boundary(
    name = "base_has_no_compiler_dependencies",
    forbidden_dependencies = ["//loom/binding/c:loomc"],
    forbidden_subtrees = [
        "//loom/binding/c/target/...",
        "//loom/src/loom/...",
    ],
    message = "LoomC base allocation, status, and byte storage must remain independent of the compiler",
    target = ":base",
)

loom_cc_library_group(
    name = "loomc",
    deps = ["//loom/binding/c/src:loomc"],
)

loom_cc_library(
    name = "interop",
    hdrs = ["include/loomc/interop.h"],
    includes = ["include"],
    deps = [
        ":interop_headers",
        ":loomc",
    ],
)

loomc_interop_headers(
    name = "interop_headers",
    deps = [
        "//loom/src/loom/error:renderer",
        "//loom/src/loom/error:source",
        "//loom/src/loom/ir",
        "//loom/src/loom/pass:registry",
        "//loom/src/loom/pass:report",
        "//loom/src/loom/target:pipeline",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/reporting:report",
    ],
)

iree_assert_dependency_boundary(
    name = "loomc_has_no_tooling_or_concrete_target_dependencies",
    forbidden_subtrees = [
        "//loom/binding/c/target/...",
        "//loom/src/loom/target/arch/...",
        "//loom/src/loom/target/emit/...",
        "//loom/src/loom/tooling/...",
        "//loom/src/loom/tools/...",
    ],
    message = "The LoomC compiler must remain target-agnostic and independent of ejectable tooling adapters",
    target = ":loomc",
)

loom_cc_library(
    name = "loomc_full",
    hdrs = (
        LOOMC_PUBLIC_HDRS +
        LOOMC_TARGET_IREE_HAL_PUBLIC_HDRS +
        LOOMC_TARGET_SPIRV_PUBLIC_HDRS +
        LOOMC_TARGET_SPIRV_IREE_HAL_PUBLIC_HDRS +
        LOOMC_TARGET_SPIRV_VULKANINFO_PUBLIC_HDRS +
        LOOMC_TARGET_SPIRV_VULKAN_PUBLIC_HDRS
    ),
    includes = [
        ".",
        "include",
    ],
    target_compatible_with = _LOOMC_FULL_COMPATIBLE_WITH,
    deps = [
        ":loomc",
        "//loom/binding/c/target/iree_hal",
        "//loom/binding/c/target/spirv",
        "//loom/binding/c/target/spirv:iree_hal",
        "//loom/binding/c/target/spirv/vulkan",
        "//loom/binding/c/target/spirv/vulkaninfo",
    ],
)

iree_cmake_extra_content(
    content = """
if(IREE_TARGET_HAS_THREADS)
""",
    inline = True,
)

loom_cc_library_group(
    name = "task_pool",
    deps = ["//loom/binding/c/src:task_pool"],
)

loom_cc_library_group(
    name = "task_queue",
    deps = ["//loom/binding/c/src:task_queue"],
)

iree_cmake_extra_content(
    content = """
endif()
""",
    inline = True,
)

# One configured binding inventory serves the installed SDK and shared tools.
# Static callers continue selecting the individual component targets above.
loomc_shared_libraries(
    name = "loomc_shared",
    components = [
        "//loom/binding/c/src:base",
        "//loom/binding/c/src:loomc",
        "//loom/binding/c/src:task_pool",
        "//loom/binding/c/src:task_queue",
        "//loom/binding/c/target/configured:ir",
        "//loom/binding/c/target/configured:target",
        "//loom/binding/c/target/configured",
        "//loom/binding/c/target/cmd",
        "//loom/binding/c/target/cpu:iree_hal",
        "//loom/binding/c/target/iree_hal",
    ] + select({
        "//loom/config/import:cxx": [
            "//loom/binding/c/import/cxx",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/emit:amdgpu_elf": [
            "//loom/binding/c/target/amdgpu",
            "//loom/binding/c/target/amdgpu:iree_hal",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/emit:aie2p_elf": [
            "//loom/binding/c/target/amd/xdna",
            "//loom/binding/c/target/amd/xdna:iree_hal",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/arch:spirv": [
            "//loom/binding/c/target/spirv:profile",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/emit:spirv_binary": [
            "//loom/binding/c/target/spirv",
            "//loom/binding/c/target/spirv/vulkaninfo",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/execute:spirv_vulkan_hal": [
            "//loom/binding/c/target/spirv:iree_hal",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/execute:spirv_vulkan_hal": [
            "//loom/binding/c/target/spirv/vulkan",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/emit:vm_binary": [
            "//loom/binding/c/target/vm",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/emit:wasm_binary": [
            "//loom/binding/c/target/wasm",
        ],
        "//conditions:default": [],
    }) + select({
        "//loom/config/emit:x86_elf": [
            "//loom/binding/c/target/x86",
        ],
        "//conditions:default": [],
    }),
    tool_components = ["//loom/src/loom/testing:target_environment"],
    runtime_deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/async/util:proactor_thread",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base:cpu_data",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/base/internal:fpu_state",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/internal:unicode",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/threading:thread",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/driver/task:device_spec",
        "//runtime/src/iree/hal/driver/task/executable:loader",
        "//runtime/src/iree/hal/driver/task/executable/library:abi",
        "//runtime/src/iree/hal/memory:slab_cache",
        "//runtime/src/iree/hal/memory:tlsf_pool",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/io:parameter_index",
        "//runtime/src/iree/io:parameter_index_provider",
        "//runtime/src/iree/io:parameter_provider",
        "//runtime/src/iree/io:stream",
        "//runtime/src/iree/math",
        "//runtime/src/iree/module/hal:types",
        "//runtime/src/iree/net:carrier",
        "//runtime/src/iree/net/carrier/stream",
        "//runtime/src/iree/schemas:xdna_executable",
        "//runtime/src/iree/task",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
        "//runtime/src/iree/tokenizer/vocab",
        "//runtime/src/iree/tooling:device_flags",
        "//runtime/src/iree/tooling:device_profiling",
        "//runtime/src/iree/tooling:device_util",
        "//runtime/src/iree/tooling:parameter_util",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm/bytecode:module",
        "//runtime/src/iree/vm/bytecode:wire",
    ],
)

iree_cmake_extra_content(
    content = """
include("${IREE_SOURCE_DIR}/loom/build_tools/cmake/loomc_package.cmake")
""",
    inline = True,
)
