)

[
    iree_runtime_cc_test(
        name = "parameter_util_%s_test" % mode,
        srcs = ["parameter_util_test.cc"],
        args = [
            "--parameter_mode=" + mode,
            "--expected_parameter_mode=" + mode,
        ],
        tags = ["requires-filesystem"],
        deps = _PARAMETER_UTIL_TEST_DEPS,
    )
    for mode in [
        "direct",
        "preload",
        "invalid",
    ]
]
