load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

# Networking stack for IREE's remote HAL and distributed execution.
#
# Layering:
#   Layer 4: Sessions and channels - application semantics
#   Layer 3: Connections and message endpoints - stream multiplexing
#   Layer 2: Carriers (loopback, TCP, shared memory, RDMA) - raw transport
#   Layer 1: Proactor (iree/async/) - completion-based I/O

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

#===------------------------------------------------------------------------===#
# Public API
#===------------------------------------------------------------------------===#

iree_runtime_cc_library(
    name = "net",
    hdrs = ["api.h"],
    deps = [
        ":carrier",
        ":message_endpoint",
    ],
)

