load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_fuzz.bzl", "iree_runtime_cc_fuzz")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_LINUX_ONLY = select({
    "@platforms//os:linux": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_RDMA_TRANSPORT_ENABLED = select({
    "//runtime/config/net:transport_rdma": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_RDMA_COMPATIBLE = _LINUX_ONLY + _RDMA_TRANSPORT_ENABLED

iree_runtime_cc_library(
    name = "backends",
    testonly = True,
    srcs = ["backends.cc"],
    target_compatible_with = _RDMA_COMPATIBLE,
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/async:platform",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net:carrier",
        "//runtime/src/iree/net:connection",
        "//runtime/src/iree/net:transport_factory",
        "//runtime/src/iree/net/carrier/cts/util:registry",
        "//runtime/src/iree/net/carrier/rdma:context",
        "//runtime/src/iree/net/carrier/rdma:factory",
        "//runtime/src/iree/net/carrier/rdma:region",
    ],
    alwayslink = True,
)

iree_runtime_cc_test(
    name = "rdma_tests",
    srcs = [
        "direct_test.cc",
        "error_test.cc",
    ],
    tags = [
        "nodocker",
    ],
    target_compatible_with = _RDMA_COMPATIBLE,
    deps = [
        ":backends",
        "//runtime/src/iree/async",
        "//runtime/src/iree/net/carrier/cts:all_tests",
        "//runtime/src/iree/net/carrier/cts/util:registry",
        "//runtime/src/iree/net/carrier/cts/util:test_base",
        "//runtime/src/iree/net/carrier/cts/util:test_main",
        "//runtime/src/iree/testing:gtest",
    ],
)

iree_runtime_cc_benchmark(
    name = "rdma_benchmarks",
    tags = [
        "nodocker",
    ],
    target_compatible_with = _RDMA_COMPATIBLE,
    deps = [
        ":backends",
        "//runtime/src/iree/net/carrier/cts:all_benchmarks",
        "//runtime/src/iree/net/carrier/cts/util:benchmark_main",
        "//runtime/src/iree/net/carrier/cts/util:registry",
    ],
)

iree_runtime_cc_fuzz(
    name = "rdma_carrier_fuzz",
    srcs = [],
    tags = [
        "nodocker",
    ],
    target_compatible_with = _RDMA_COMPATIBLE,
    deps = [
        ":backends",
        "//runtime/src/iree/net/carrier/cts:carrier_fuzz_lib",
    ],
)
