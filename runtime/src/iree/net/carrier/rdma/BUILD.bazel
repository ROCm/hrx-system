load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")

# RDMA carrier using libibverbs and librdmacm — Linux-only.

load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "libverbs",
    srcs = [
        "libverbs.c",
    ],
    hdrs = [
        "libverbs.h",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    textual_hdrs = [
        "libverbs_tables.h",
    ],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:dynamic_library",
        "//runtime/src/iree/base/internal:path",
        "@rdma_core_headers",
    ],
)

iree_runtime_cc_library(
    name = "librdmacm",
    srcs = [
        "librdmacm.c",
    ],
    hdrs = [
        "librdmacm.h",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    textual_hdrs = [
        "librdmacm_tables.h",
    ],
    deps = [
        ":libverbs",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:dynamic_library",
        "//runtime/src/iree/base/internal:path",
        "@rdma_core_headers",
    ],
)

iree_runtime_cc_library(
    name = "carrier",
    hdrs = ["carrier.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":librdmacm",
        ":libverbs",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net:carrier",
    ],
)

iree_runtime_cc_library(
    name = "context",
    srcs = [
        "context.c",
    ],
    hdrs = [
        "context.h",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":librdmacm",
        ":libverbs",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "@rdma_core_headers",
    ],
)

iree_runtime_cc_test(
    name = "context_test",
    srcs = ["context_test.cc"],
    tags = [
        "nodocker",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":context",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "@rdma_core_headers",
    ],
)

iree_runtime_cc_test(
    name = "dmabuf_registration_test",
    srcs = ["dmabuf_registration_test.cc"],
    tags = [
        "driver=amdgpu",
        "nodocker",
        "requires-gpu-amd",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":libverbs",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/drivers/amdgpu/util:libhsa",
        "//runtime/src/iree/hal/drivers/amdgpu/util:topology",
        "//runtime/src/iree/hal/drivers/amdgpu/util:vmem",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
