load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "connection",
    srcs = ["connection.c"],
    hdrs = ["connection.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/net:connection",
        "//runtime/src/iree/net:endpoint_lifecycle",
        "//runtime/src/iree/net:framing_adapter",
        "//runtime/src/iree/net:message_endpoint",
        "//runtime/src/iree/net/carrier/stream",
    ],
)

iree_runtime_cc_library(
    name = "factory",
    srcs = ["factory.c"],
    hdrs = ["factory.h"],
    deps = [
        ":connection",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/net:transport_factory",
    ],
)

iree_runtime_cc_test(
    name = "connection_test",
    srcs = ["connection_test.cc"],
    deps = [
        ":connection",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async:platform",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net:connection",
        "//runtime/src/iree/net:message_endpoint",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_test(
    name = "factory_test",
    srcs = ["factory_test.cc"],
    deps = [
        ":factory",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async:platform",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net:connection",
        "//runtime/src/iree/net:session",
        "//runtime/src/iree/net:transport_factory",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ] + select({
        "@platforms//os:android": ["//runtime/src/iree/async/platform/posix"],
        "@platforms//os:linux": ["//runtime/src/iree/async/platform/posix"],
        "@platforms//os:macos": ["//runtime/src/iree/async/platform/posix"],
        "//conditions:default": [],
    }),
)
