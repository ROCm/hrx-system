load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "hal",
    srcs = [
        "module.c",
        "queue.c",
    ],
    hdrs = [
        "module.h",
        "queue.h",
    ],
    deps = [
        ":native_abi",
        ":native_schema",
        ":types",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/vm",
    ],
)

iree_runtime_cc_library(
    name = "native_schema",
    hdrs = [
        "native_abi.h",
        "native_schema.h",
    ],
    deps = ["//runtime/src/iree/vm"],
)

iree_runtime_cc_library(
    name = "native_abi",
    srcs = ["native_abi.c"],
    deps = [
        ":native_schema",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "types",
    srcs = ["types.c"],
    hdrs = ["types.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/vm",
    ],
)

iree_runtime_cc_test(
    name = "module_test",
    srcs = ["module_test.cc"],
    deps = [
        ":hal",
        ":native_schema",
        ":types",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)

iree_runtime_cc_test(
    name = "ownership_test",
    srcs = ["ownership_test.cc"],
    deps = [
        ":types",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/task:device",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)

iree_runtime_cc_test(
    name = "types_test",
    srcs = ["types_test.cc"],
    deps = [
        ":types",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)
