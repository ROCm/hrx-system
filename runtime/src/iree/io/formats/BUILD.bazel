load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "parser_registry",
    srcs = [
        "parser_registry.c",
    ],
    hdrs = [
        "parser_registry.h",
    ],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/io:parameter_index",
        "//runtime/src/iree/io/formats/gguf",
        "//runtime/src/iree/io/formats/irpa",
        "//runtime/src/iree/io/formats/safetensors",
    ],
)

iree_runtime_cc_library(
    name = "parameter_index_fuzz_util",
    testonly = True,
    srcs = ["parameter_index_fuzz_util.cc"],
    hdrs = ["parameter_index_fuzz_util.h"],
    visibility = ["//runtime/src/iree/io/formats:__subpackages__"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/io:parameter_index",
    ],
