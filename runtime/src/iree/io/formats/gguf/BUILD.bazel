load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_fuzz.bzl", "iree_runtime_cc_fuzz")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "gguf",
    srcs = [
        "gguf_parser.c",
    ],
    hdrs = [
        "gguf_parser.h",
    ],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/io:parameter_index",
    ],
)

GGUF_FUZZ_SEEDS = [
    "//runtime/src/iree/io/formats/gguf/testdata:empty.gguf",
    "//runtime/src/iree/io/formats/gguf/testdata:multiple.gguf",
    "//runtime/src/iree/io/formats/gguf/testdata:single.gguf",
    "//runtime/src/iree/io/formats/gguf/testdata:single_v2.gguf",
]

iree_runtime_cc_fuzz(
    name = "gguf_parser_fuzz",
    srcs = ["gguf_parser_fuzz.cc"],
    args = [
        "-seed_inputs=" + ",".join([
            "$(rootpath %s)" % seed
            for seed in GGUF_FUZZ_SEEDS
        ]),
    ],
    data = GGUF_FUZZ_SEEDS,
    deps = [
        ":gguf",
        "//runtime/src/iree/io/formats:parameter_index_fuzz_util",
    ],
)

iree_runtime_cc_test(
    name = "gguf_parser_test",
    srcs = ["gguf_parser_test.cc"],
    deps = [
        ":gguf",
        "//runtime/src/iree/io/formats/gguf/testdata:gguf_files",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
