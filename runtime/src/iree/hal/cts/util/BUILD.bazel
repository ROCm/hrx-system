# CTS utility infrastructure: registry, test base.
#
# This directory contains the shared infrastructure for the HAL Conformance
# Test Suite. Test logic lives in separate category directories (core/,
# buffer/, command_buffer/, etc.) while this directory provides the foundation.

load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# Testdata generation template.
exports_files([
    "testdata_target.cc.tpl",
])

# Shared main entry point for composed CTS test binaries.
iree_runtime_cc_library(
    name = "test_main",
    testonly = True,
    srcs = ["test_main.cc"],
    deps = [
        ":registry",
        ":test_base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:gtest",
    ],
)

# CTS registry for link-time test composition.
# Test suites and backends register at static init time; main() calls
# InstantiateAll() to create gtest parameterized test instances.
iree_runtime_cc_library(
    name = "registry",
    testonly = True,
    srcs = ["registry.cc"],
    hdrs = ["registry.h"],
    deps = [
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
    ],
)

# Finite native-backed arenas for allocation and queue CTS.
iree_runtime_cc_library(
    name = "pool_test_util",
    testonly = True,
    srcs = ["pool_test_util.cc"],
    hdrs = ["pool_test_util.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/memory:fixed_block_pool",
        "//runtime/src/iree/hal/memory:passthrough_pool",
    ],
)

# Reusable profile sink helpers for CTS coverage of HAL profiling behavior.
iree_runtime_cc_library(
    name = "profile_test_util",
    testonly = True,
    srcs = ["profile_test_util.cc"],
    hdrs = ["profile_test_util.h"],
    deps = [
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
    ],
)

# Device-spec-driven atomic operation test selection helpers.
iree_runtime_cc_library(
    name = "atomic_test_util",
    testonly = True,
    srcs = ["atomic_test_util.cc"],
    hdrs = ["atomic_test_util.h"],
    deps = [
        "//runtime/src/iree/hal",
    ],
)

# CtsTestBase fixture and helper utilities.
iree_runtime_cc_library(
    name = "test_base",
    testonly = True,
    srcs = ["test_base.cc"],
    hdrs = ["test_base.h"],
    deps = [
        ":registry",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
    ],
)
