;
; Copies an arbitrary byte range between storage buffers. Each invocation
; assembles one target dword from one or two atomically loaded source dwords
; and atomically patches only the requested target bytes. Source loads are
; atomic because byte-disjoint ranges within the same buffer may still share
; a dword with a target patch.
               OpCapability Shader
          %glsl = OpExtInstImport "GLSL.std.450"
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %global_invocation_id
               OpExecutionMode %main LocalSize 64 1 1
               OpSource GLSL 450
               OpName %main "main"
               OpName %PushConstants "PushConstants"
               OpMemberName %PushConstants 0 "source_word_index"
               OpMemberName %PushConstants 1 "source_word_byte_offset"
               OpMemberName %PushConstants 2 "target_word_index"
               OpMemberName %PushConstants 3 "target_word_byte_offset"
               OpMemberName %PushConstants 4 "length_bytes"
               OpMemberName %PushConstants 5 "target_word_count"
               OpName %push_constants "push_constants"
               OpName %Source "Source"
               OpMemberName %Source 0 "words"
               OpName %source "source"
               OpName %Target "Target"
               OpMemberName %Target 0 "words"
               OpName %target "target"
               OpName %global_invocation_id "gl_GlobalInvocationID"
               OpDecorate %PushConstants Block
               OpMemberDecorate %PushConstants 0 Offset 0
               OpMemberDecorate %PushConstants 1 Offset 4
               OpMemberDecorate %PushConstants 2 Offset 8
               OpMemberDecorate %PushConstants 3 Offset 12
               OpMemberDecorate %PushConstants 4 Offset 16
               OpMemberDecorate %PushConstants 5 Offset 20
               OpDecorate %runtime_array_uint ArrayStride 4
               OpDecorate %Source BufferBlock
               OpMemberDecorate %Source 0 Offset 0
               OpMemberDecorate %Source 0 NonWritable
               OpDecorate %source DescriptorSet 0
               OpDecorate %source Binding 0
               OpDecorate %Target BufferBlock
               OpMemberDecorate %Target 0 Offset 0
               OpDecorate %target DescriptorSet 0
               OpDecorate %target Binding 1
               OpDecorate %global_invocation_id BuiltIn GlobalInvocationId
       %void = OpTypeVoid
    %function = OpTypeFunction %void
       %uint = OpTypeInt 32 0
       %bool = OpTypeBool
     %uint_0 = OpConstant %uint 0
     %uint_1 = OpConstant %uint 1
     %uint_2 = OpConstant %uint 2
     %uint_3 = OpConstant %uint 3
     %uint_4 = OpConstant %uint 4
     %uint_5 = OpConstant %uint 5
     %uint_8 = OpConstant %uint 8
    %uint_64 = OpConstant %uint 64
    %uint_66 = OpConstant %uint 66
%uint_all_ones = OpConstant %uint 4294967295
     %v3uint = OpTypeVector %uint 3
%PushConstants = OpTypeStruct %uint %uint %uint %uint %uint %uint
%ptr_push_constants = OpTypePointer PushConstant %PushConstants
%ptr_push_uint = OpTypePointer PushConstant %uint
%push_constants = OpVariable %ptr_push_constants PushConstant
%runtime_array_uint = OpTypeRuntimeArray %uint
     %Source = OpTypeStruct %runtime_array_uint
     %Target = OpTypeStruct %runtime_array_uint
%ptr_uniform_source = OpTypePointer Uniform %Source
%ptr_uniform_target = OpTypePointer Uniform %Target
%ptr_uniform_uint = OpTypePointer Uniform %uint
     %source = OpVariable %ptr_uniform_source Uniform
     %target = OpVariable %ptr_uniform_target Uniform
%ptr_input_v3uint = OpTypePointer Input %v3uint
%ptr_input_uint = OpTypePointer Input %uint
%global_invocation_id = OpVariable %ptr_input_v3uint Input
%workgroup_size = OpConstantComposite %v3uint %uint_64 %uint_1 %uint_1
       %main = OpFunction %void None %function
      %entry = OpLabel
     %gid_ptr = OpAccessChain %ptr_input_uint %global_invocation_id %uint_0
         %gid = OpLoad %uint %gid_ptr
%word_count_ptr = OpAccessChain %ptr_push_uint %push_constants %uint_5
  %word_count = OpLoad %uint %word_count_ptr
    %in_range = OpULessThan %bool %gid %word_count
               OpSelectionMerge %return None
               OpBranchConditional %in_range %copy_word %return
  %copy_word = OpLabel
%target_byte_offset_ptr = OpAccessChain %ptr_push_uint %push_constants %uint_3
%target_byte_offset = OpLoad %uint %target_byte_offset_ptr
%length_bytes_ptr = OpAccessChain %ptr_push_uint %push_constants %uint_4
%length_bytes = OpLoad %uint %length_bytes_ptr
%target_word_begin = OpIMul %uint %gid %uint_4
%target_word_end = OpIAdd %uint %target_word_begin %uint_4
%copy_byte_end = OpIAdd %uint %target_byte_offset %length_bytes
%target_byte_begin = OpExtInst %uint %glsl UMax %target_byte_offset %target_word_begin
%target_byte_end = OpExtInst %uint %glsl UMin %copy_byte_end %target_word_end
%target_word_byte_offset = OpISub %uint %target_byte_begin %target_word_begin
%copy_byte_count = OpISub %uint %target_byte_end %target_byte_begin
%copy_relative_offset = OpISub %uint %target_byte_begin %target_byte_offset
%source_word_byte_offset_ptr = OpAccessChain %ptr_push_uint %push_constants %uint_1
%source_word_byte_offset = OpLoad %uint %source_word_byte_offset_ptr
%source_byte_offset = OpIAdd %uint %source_word_byte_offset %copy_relative_offset
%source_word_delta = OpUDiv %uint %source_byte_offset %uint_4
%source_word_offset = OpUMod %uint %source_byte_offset %uint_4
%source_word_index_ptr = OpAccessChain %ptr_push_uint %push_constants %uint_0
%source_word_index_base = OpLoad %uint %source_word_index_ptr
%source_word_index = OpIAdd %uint %source_word_index_base %source_word_delta
%source_word_ptr = OpAccessChain %ptr_uniform_uint %source %uint_0 %source_word_index
 %source_low = OpAtomicLoad %uint %source_word_ptr %uint_1 %uint_66
%source_shift_bits = OpIMul %uint %source_word_offset %uint_8
%source_low_bits = OpShiftRightLogical %uint %source_low %source_shift_bits
%source_end_offset = OpIAdd %uint %source_word_offset %copy_byte_count
%crosses_source_word = OpUGreaterThan %bool %source_end_offset %uint_4
               OpSelectionMerge %source_merge None
               OpBranchConditional %crosses_source_word %load_source_high %source_low_only
%load_source_high = OpLabel
%source_high_index = OpIAdd %uint %source_word_index %uint_1
%source_high_ptr = OpAccessChain %ptr_uniform_uint %source %uint_0 %source_high_index
%source_high = OpAtomicLoad %uint %source_high_ptr %uint_1 %uint_66
%source_high_shift_bytes = OpISub %uint %uint_4 %source_word_offset
%source_high_shift_bits = OpIMul %uint %source_high_shift_bytes %uint_8
%source_high_bits = OpShiftLeftLogical %uint %source_high %source_high_shift_bits
%source_cross_word_bits = OpBitwiseOr %uint %source_low_bits %source_high_bits
               OpBranch %source_merge
%source_low_only = OpLabel
               OpBranch %source_merge
%source_merge = OpLabel
%source_bits = OpPhi %uint %source_cross_word_bits %load_source_high %source_low_bits %source_low_only
%copies_full_word = OpIEqual %bool %copy_byte_count %uint_4
               OpSelectionMerge %mask_merge None
               OpBranchConditional %copies_full_word %full_mask %partial_mask
  %full_mask = OpLabel
               OpBranch %mask_merge
%partial_mask = OpLabel
%mask_bit_count = OpIMul %uint %copy_byte_count %uint_8
%mask_high_bit = OpShiftLeftLogical %uint %uint_1 %mask_bit_count
%partial_mask_value = OpISub %uint %mask_high_bit %uint_1
               OpBranch %mask_merge
  %mask_merge = OpLabel
  %byte_mask = OpPhi %uint %uint_all_ones %full_mask %partial_mask_value %partial_mask
%source_value = OpBitwiseAnd %uint %source_bits %byte_mask
%target_shift_bits = OpIMul %uint %target_word_byte_offset %uint_8
%target_mask = OpShiftLeftLogical %uint %byte_mask %target_shift_bits
%target_value = OpShiftLeftLogical %uint %source_value %target_shift_bits
%target_word_index_ptr = OpAccessChain %ptr_push_uint %push_constants %uint_2
%target_word_index_base = OpLoad %uint %target_word_index_ptr
%target_word_index = OpIAdd %uint %target_word_index_base %gid
%target_word_ptr = OpAccessChain %ptr_uniform_uint %target %uint_0 %target_word_index
%initial_target = OpAtomicIAdd %uint %target_word_ptr %uint_1 %uint_0 %uint_0
               OpBranch %compare_exchange
%compare_exchange = OpLabel
%old_target = OpPhi %uint %initial_target %mask_merge %observed_target %retry
               OpLoopMerge %copy_complete %retry None
               OpBranch %exchange_body
%exchange_body = OpLabel
%inverse_target_mask = OpNot %uint %target_mask
%preserved_target = OpBitwiseAnd %uint %old_target %inverse_target_mask
%new_target = OpBitwiseOr %uint %preserved_target %target_value
%observed_target = OpAtomicCompareExchange %uint %target_word_ptr %uint_1 %uint_0 %uint_0 %new_target %old_target
%exchange_succeeded = OpIEqual %bool %observed_target %old_target
               OpBranchConditional %exchange_succeeded %copy_complete %retry
      %retry = OpLabel
               OpBranch %compare_exchange
%copy_complete = OpLabel
               OpBranch %return
     %return = OpLabel
               OpReturn
               OpFunctionEnd
