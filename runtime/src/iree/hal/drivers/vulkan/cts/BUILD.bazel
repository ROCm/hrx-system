_BDA_SPIRV_TEST_FIXTURES = [
    "bda_descriptor_storage_variable",
    "bda_i32_add7",
    "bda_i32_add7_binding_1_length_4_17",
    "bda_i32_add7_bindings_2",
    "bda_i32_add7_constant_length_4",
    "bda_i32_add7_descriptor_decorated",
    "bda_i32_add7_no_metadata",
    "bda_missing_physical_storage_buffer_addresses",
    "bda_missing_push_constant_root",
    "bda_noop_binding_requirements",
    "bda_noop_bindings_2_constant_length_8",
    "bda_noop_without_push_constant_root",
    "bda_subgroup_sizes",
    "bda_subgroup_unsupported",
]

[
    iree_spirv_asm_module(
        name = fixture,
        testonly = True,
        src = "testdata/%s.spvasm" % fixture,
        target_env = "vulkan1.3",
    )
    for fixture in _BDA_SPIRV_TEST_FIXTURES
]

iree_c_embed_data(
    name = "bda_spirv_test_spv",
    testonly = True,
    srcs = [":%s" % fixture for fixture in _BDA_SPIRV_TEST_FIXTURES],
    c_file_output = "bda_spirv_test_spv.c",
    flatten = True,
    h_file_output = "bda_spirv_test_spv.h",
    identifier = "iree_hal_vulkan_cts_bda_spirv_test_spv",
    target_compatible_with = select({
        "//runtime/config/hal:driver_vulkan": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

