load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "shim_xdna",
    srcs = [
        "bo.cpp",
        "device.cpp",
        "fence.cpp",
        "hwctx.cpp",
        "hwq.cpp",
        "kernel.cpp",
        "shim_debug.cpp",
    ],
    hdrs = [
        "amdxdna_accel.h",
        "bo.h",
        "bo_flags.h",
        "device.h",
        "fence.h",
        "hwctx.h",
        "hwq.h",
        "kernel.h",
        "shim_debug.h",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//runtime/src/iree/hal/drivers/amdxdna/shim",
    ],
)
