load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")
load("//runtime/build_tools/bazel:hal_cts.bzl", "iree_runtime_hal_cts_test_suite")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "backends",
    testonly = True,
    srcs = ["backends.cc"],
    deps = [
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/drivers/task/registration",
    ],
    alwayslink = True,
)

iree_runtime_cc_library(
    name = "executable_testdata",
    testonly = True,
    srcs = ["executable_testdata.cc"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/drivers/task/executable/elf/testdata:compat_data",
    ],
    alwayslink = True,
)

iree_runtime_cc_test(
    name = "queue_dispatch_concurrency_tests",
    deps = [
        ":backends",
        ":executable_testdata",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal/cts/queue:queue_dispatch_concurrency_test",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/cts/util:test_main",
        "//runtime/src/iree/testing:gtest",
    ],
)

iree_runtime_cc_test(
    name = "buffer_access_tests",
    srcs = ["buffer_access_test.cc"],
    deps = [
        ":backends",
        ":executable_testdata",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/cts/util:test_main",
        "//runtime/src/iree/hal/memory:passthrough_pool",
        "//runtime/src/iree/testing:gtest",
    ],
)

iree_runtime_cc_test(
    name = "slab_pool_tests",
    srcs = ["slab_pool_test.cc"],
    deps = [
        ":backends",
        ":executable_testdata",
        "//runtime/src/iree/async",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:pool_test_util",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/cts/util:test_main",
        "//runtime/src/iree/hal/memory:fixed_block_pool",
        "//runtime/src/iree/hal/memory:slab_cache",
        "//runtime/src/iree/hal/memory:tlsf_pool",
        "//runtime/src/iree/testing:gtest",
    ],
)

iree_runtime_hal_cts_test_suite(
    backends = ":backends",
)
