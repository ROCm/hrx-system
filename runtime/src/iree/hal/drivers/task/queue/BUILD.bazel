load("//build_tools/bazel:select.bzl", "iree_select")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "queue",
    srcs = [
        "memory_allocation.c",
        "memory_barrier.c",
        "memory_mapping.c",
        "queue.c",
    ],
    hdrs = [
        "memory_barrier.h",
        "queue.h",
    ],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:atomic_slist",
        "//runtime/src/iree/base/internal:cpu",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/threading:thread",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/task:atomic",
        "//runtime/src/iree/hal/drivers/task:profile",
        "//runtime/src/iree/hal/drivers/task:transient_buffer",
        "//runtime/src/iree/hal/drivers/task/command:block_builder",
        "//runtime/src/iree/hal/drivers/task/command:block_command_buffer",
        "//runtime/src/iree/hal/drivers/task/command:block_command_ops",
        "//runtime/src/iree/hal/drivers/task/command:block_processor",
        "//runtime/src/iree/hal/drivers/task/executable",
        "//runtime/src/iree/hal/utils:files",
        "//runtime/src/iree/hal/utils:resource_set",
        "//runtime/src/iree/task",
    ],
)

iree_runtime_cc_test(
    name = "queue_test",
    srcs = ["queue_test.cc"],
    deps = [
        ":queue",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/task:device",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)

iree_runtime_cc_test(
    name = "queue_alloca_test",
    srcs = ["queue_alloca_test.cc"],
    target_compatible_with = select({
        "@platforms//os:android": [],
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":queue",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:pool_test_util",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/drivers/task:allocation_queue",
        "//runtime/src/iree/hal/drivers/task:device",
        "//runtime/src/iree/hal/memory:cpu_slab_provider",
        "//runtime/src/iree/hal/memory:fixed_block_pool",
        "//runtime/src/iree/hal/memory:passthrough_pool",
        "//runtime/src/iree/hal/memory:slab_cache",
        "//runtime/src/iree/hal/memory:tlsf_pool",
        "//runtime/src/iree/hal/testing:deferred_pool",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ] + iree_select({
        "@platforms//os:windows": ["//runtime/src/iree/async/platform/iocp"],
        "//conditions:default": ["//runtime/src/iree/async/platform/posix"],
    }),
)
