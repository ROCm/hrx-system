load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "abi",
    hdrs = ["abi.h"],
)

iree_runtime_cc_library(
    name = "util",
    srcs = ["util.c"],
    hdrs = ["util.h"],
    deps = [
        ":abi",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_test(
    name = "util_test",
    srcs = ["util_test.cc"],
    deps = [
        ":util",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_test(
    name = "library_test",
    srcs = [
        "demo.c",
        "demo.h",
        "test.c",
    ],
    deps = [
        ":abi",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:cpu",
        "//runtime/src/iree/hal/drivers/task/executable:environment",
    ],
)

iree_runtime_cc_benchmark(
    name = "library_benchmark",
    srcs = ["benchmark.c"],
    deps = [
        ":abi",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/task:device_spec_builder",
        "//runtime/src/iree/hal/drivers/task/executable",
        "//runtime/src/iree/hal/drivers/task/executable:environment",
        "//runtime/src/iree/hal/drivers/task/executable:loader",
        "//runtime/src/iree/hal/drivers/task/executable/loaders/registration",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/testing:benchmark",
    ],
)
