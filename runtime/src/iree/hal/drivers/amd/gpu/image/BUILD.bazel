load("//build_tools/amdgpu:binary.bzl", "iree_amdgpu_binary_variants_embed_data")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_fuzz.bzl", "iree_runtime_cc_fuzz")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "image",
    srcs = ["image.c"],
    hdrs = ["image.h"],
    deps = [
        ":metadata",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal/drivers/amd/gpu/target:identity",
    ],
)

iree_runtime_cc_library(
    name = "hsaco",
    srcs = ["hsaco.c"],
    hdrs = ["hsaco.h"],
    deps = [
        ":hsaco_metadata",
        ":image",
        ":metadata",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal/drivers/amd/gpu/target:code_object",
        "//runtime/src/iree/hal/drivers/amd/gpu/target:identity",
    ],
)

iree_runtime_cc_library(
    name = "metadata",
    srcs = ["metadata.c"],
    hdrs = ["metadata.h"],
    deps = ["//runtime/src/iree/base"],
)

iree_runtime_cc_library(
    name = "hsaco_metadata",
    srcs = ["hsaco_metadata.c"],
    hdrs = ["hsaco_metadata.h"],
    deps = [
        ":metadata",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_test(
    name = "hsaco_test",
    srcs = ["hsaco_test.cc"],
    deps = [
        ":hip_images",
        ":hsaco",
        ":image",
        ":metadata",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_amdgpu_binary_variants_embed_data(
    name = "hip_images",
    testonly = True,
    srcs = ["testdata/image.hip"],
    copts = ["-fno-offload-uniform-block"],
    identifier = "iree_hal_amd_gpu_hip_images",
    source_format = "hip",
    tags = ["manual"],
    target = "amdgcn-amd-amdhsa",
    target_selectors_flag = "//runtime/src/iree/hal/drivers/amd/gpu:targets",
)

iree_runtime_cc_test(
    name = "hsaco_metadata_test",
    srcs = ["hsaco_metadata_test.cc"],
    deps = [
        ":hsaco_metadata",
        ":metadata",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "hsaco_test_util",
    testonly = True,
    hdrs = ["hsaco_test_util.h"],
    deps = [
        ":hip_images",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
    ],
)

iree_runtime_cc_fuzz(
    name = "hsaco_fuzz",
    srcs = ["hsaco_fuzz.cc"],
    deps = [
        ":hsaco",
        ":hsaco_test_util",
        ":image",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_fuzz(
    name = "hsaco_metadata_fuzz",
    srcs = ["hsaco_metadata_fuzz.cc"],
    data = ["hsaco_metadata_fuzz.dict"],
    deps = [
        ":hsaco_metadata",
        ":hsaco_test_util",
        ":metadata",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/gpu:kernarg",
    ],
)

iree_runtime_cc_benchmark(
    name = "hsaco_benchmark",
    srcs = ["hsaco_benchmark.cc"],
    deps = [
        ":hsaco",
        ":hsaco_test_util",
        ":image",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

iree_runtime_cc_benchmark(
    name = "hsaco_metadata_benchmark",
    srcs = ["hsaco_metadata_benchmark.cc"],
    deps = [
        ":hsaco_metadata",
        ":hsaco_test_util",
        ":metadata",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
