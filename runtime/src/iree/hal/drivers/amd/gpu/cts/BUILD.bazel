# Each collection owns logical program names and backend views; target products
# are derived from the compiler's configured descriptor sets. Non-executable
# tests do not depend on these compiler inputs.
_EXECUTABLE_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
]) + select(dict([
    (
        "//loom/config/target/amdgpu:" + capability,
        [],
    )
    for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
] + [(
    "//conditions:default",
    ["@platforms//:incompatible"],
)]))

