package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# Each collection owns logical program names and backend views; target products
# are derived from the compiler's configured descriptor sets. Non-executable
# tests do not depend on these compiler inputs.
_EXECUTABLE_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
]) + select(dict([
    (
        "//loom/config/target/amdgpu:" + capability,
        [],
    )
    for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
] + [(
    "//conditions:default",
    ["@platforms//:incompatible"],
)]))

_CORPORA = {
    "asan_report": {
        "backends": ["amd_gpu_asan_report"],
        "programs": {"asan_report": "asan_report.loom"},
    },
    "code": {
        "backends": ["amd_gpu_code"],
        "programs": {
            "transform": "//libamdf/cts/gpu/kernels:transform.loom",
            "transform_alternate": "//libamdf/cts/gpu/kernels:transform_alternate.loom",
        },
    },
    "dispatch": {
        "backends": [
            "rdna",
            "cdna",
        ],
        "programs": {
            "command_buffer_dispatch_constants_bindings_test": "command_buffer_dispatch_constants_bindings_test.loom",
            "command_buffer_dispatch_multi_workgroup_test": "command_buffer_dispatch_multi_workgroup_test.loom",
            "command_buffer_dispatch_test": "command_buffer_dispatch_test.loom",
        },
    },
    "feedback": {
        "backends": ["amd_gpu_feedback"],
        "programs": {"feedback": "feedback.loom"},
    },
    "scratch": {
        "backends": ["amd_gpu_scratch"],
        "programs": {"scratch": "scratch.loom"},
    },
    "tsan": {
        "backends": ["amd_gpu_tsan"],
        "programs": {"tsan": "tsan.loom"},
    },
}

_TARGET_COMPATIBLE_WITH = {
    target: loom_config_compatible_with([
        "//loom/config/target:amdgpu_artifacts",
        "//loom/config/target/amdgpu:" + LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_TARGET[target],
    ])
    for target in LOOM_AMDGPU_SUPPORTED_TARGETS
}

[
    loom_target_profile(
        name = "cts_profile_" + target,
        family = "amdgpu",
        selector = target,
        target_compatible_with = _TARGET_COMPATIBLE_WITH[target],
    )
    for target in LOOM_AMDGPU_SUPPORTED_TARGETS
]

[
    loom_library(
        name = collection + "_source_" + program,
        srcs = [source],
        tags = ["manual"],
        target_compatible_with = _EXECUTABLE_COMPATIBLE_WITH,
    )
    for collection, corpus in _CORPORA.items()
    for program, source in corpus["programs"].items()
]

[
    loom_kernel_binary(
        name = collection + "_" + target + "_" + program,
        testonly = True,
        out = collection + "_" + target + "/" + program + ".bin",
        target = ":cts_profile_" + target,
        target_compatible_with = _TARGET_COMPATIBLE_WITH[target],
        deps = [":" + collection + "_source_" + program],
    )
    for collection, corpus in _CORPORA.items()
    for program in corpus["programs"]
    for target in LOOM_AMDGPU_SUPPORTED_TARGETS
]

[
    iree_runtime_hal_cts_testdata(
        name = collection + "_data_" + target,
        srcs = [":" + collection + "_" + target + "_" + program for program in corpus["programs"]],
        backend_names = corpus["backends"],
        target_compatible_with = _TARGET_COMPATIBLE_WITH[target],
        target_family = "amdgpu",
        target_key = target,
        target_name = target.replace("-", "_"),
    )
    for collection, corpus in _CORPORA.items()
    for target in LOOM_AMDGPU_SUPPORTED_TARGETS
]

[
    iree_runtime_cc_library(
        name = collection + "_testdata",
        testonly = True,
        target_compatible_with = _EXECUTABLE_COMPATIBLE_WITH,
        deps = loom_amdgpu_selected_descriptor_set_values({
            capability: [
                ":" + collection + "_data_" + target
                for target in LOOM_AMDGPU_SUPPORTED_TARGETS
                if LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_TARGET[target] == capability
            ]
            for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
        }),
        alwayslink = True,
    )
    for collection in _CORPORA
]

