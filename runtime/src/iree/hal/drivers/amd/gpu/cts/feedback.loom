kernel.def export("report_assertion") @report_assertion() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%value: i32) {
  %zero = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %value, %zero : i32
  kernel.assert %condition "feedback survives replay and executable release" : i1
  kernel.return
}
