load("//build_tools/amdgpu:selectors.bzl", "iree_amdgpu_target_selectors_flag")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_amdgpu_target_selectors_flag(
    name = "targets",
)

# Native device integration requires libamdf; pure image/packet/queue utilities
# remain available in CPU-only builds.
_NATIVE_DEVICE_COMPATIBLE_WITH = select({
    "//libamdf/config:enabled_setting": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

iree_runtime_cc_library(
    name = "device",
    srcs = ["device.c"],
    hdrs = ["device.h"],
    target_compatible_with = _NATIVE_DEVICE_COMPATIBLE_WITH,
    visibility = ["//runtime/src/iree/hal/drivers/amd:__subpackages__"],
    deps = [
        ":completion",
        ":context",
        ":executable",
        "//libamdf:headers",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/threading:thread",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd:status",
        "//runtime/src/iree/hal/drivers/amd/fabric:memory",
        "//runtime/src/iree/hal/drivers/amd/fabric:memory_backend",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue:allocation",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:barrier",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:command_buffer",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:semaphore",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4/umq:queue",
        "//runtime/src/iree/hal/drivers/amd/gpu/target:identity",
        "//runtime/src/iree/hal/memory:maintenance",
        "//runtime/src/iree/hal/memory:maintenance_thread",
        "//runtime/src/iree/hal/utils:device_spec_builder",
        "//runtime/src/iree/hal/utils:files",
    ],
)

iree_runtime_cc_library(
    name = "executable",
    srcs = ["executable.c"],
    hdrs = ["executable.h"],
    target_compatible_with = _NATIVE_DEVICE_COMPATIBLE_WITH,
    visibility = ["//runtime/src/iree/hal/drivers/amd/gpu:__subpackages__"],
    deps = [
        ":context",
        ":kernarg",
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd:status",
        "//runtime/src/iree/hal/drivers/amd/fabric:buffer",
        "//runtime/src/iree/hal/drivers/amd/fabric:memory",
        "//runtime/src/iree/hal/drivers/amd/fabric:memory_transition",
        "//runtime/src/iree/hal/drivers/amd/gpu/image",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:hsaco",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:metadata",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:launch",
        "//runtime/src/iree/hal/drivers/amd/gpu/target:identity",
        "//runtime/src/iree/hal/memory:maintenance",
    ],
)

iree_runtime_cc_test(
    name = "executable_test",
    srcs = ["executable_test.cc"],
    target_compatible_with = _NATIVE_DEVICE_COMPATIBLE_WITH,
    deps = [
        ":context",
        ":executable",
        ":kernarg",
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/fabric:memory",
        "//runtime/src/iree/hal/drivers/amd/gpu/image",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:hsaco",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:hsaco_test_util",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:metadata",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:launch",
        "//runtime/src/iree/hal/drivers/amd/gpu/target:identity",
        "//runtime/src/iree/hal/memory:maintenance",
        "//runtime/src/iree/hal/memory:maintenance_thread",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "kernarg",
    srcs = ["kernarg.c"],
    hdrs = ["kernarg.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:metadata",
    ],
)

iree_runtime_cc_test(
    name = "kernarg_test",
    srcs = ["kernarg_test.cc"],
    deps = [
        ":kernarg",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/gpu/image",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:hsaco",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:hsaco_test_util",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:metadata",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_benchmark(
    name = "kernarg_benchmark",
    srcs = ["kernarg_benchmark.cc"],
    deps = [
        ":kernarg",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/drivers/amd/gpu/image:metadata",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

iree_runtime_cc_library(
    name = "context",
    srcs = ["context.c"],
    hdrs = ["context.h"],
    target_compatible_with = _NATIVE_DEVICE_COMPATIBLE_WITH,
    visibility = ["//runtime/src/iree/hal/drivers/amd:__subpackages__"],
    deps = [
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd:status",
        "//runtime/src/iree/hal/drivers/amd/fabric",
    ],
)

iree_runtime_cc_test(
    name = "context_test",
    srcs = ["context_test.cc"],
    target_compatible_with = _NATIVE_DEVICE_COMPATIBLE_WITH,
    deps = [
        ":context",
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/fabric",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "completion",
    srcs = ["completion.c"],
    hdrs = ["completion.h"],
    target_compatible_with = _NATIVE_DEVICE_COMPATIBLE_WITH,
    visibility = ["//runtime/src/iree/hal/drivers/amd/gpu:__subpackages__"],
    deps = [
        ":context",
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/threading:thread",
        "//runtime/src/iree/hal/drivers/amd:status",
    ],
)

iree_runtime_cc_test(
    name = "completion_test",
    srcs = ["completion_test.cc"],
    target_compatible_with = _NATIVE_DEVICE_COMPATIBLE_WITH,
    deps = [
        ":completion",
        ":context",
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading:thread",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
