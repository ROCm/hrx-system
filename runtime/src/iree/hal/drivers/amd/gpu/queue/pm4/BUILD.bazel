package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# Native device integration requires libamdf; pure image/packet/queue utilities
# remain available in CPU-only builds.
_NATIVE_DEVICE_COMPATIBLE_WITH = select({
    "//libamdf/config:enabled_setting": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

iree_runtime_cc_library(
    name = "barrier",
    srcs = ["barrier.c"],
    hdrs = ["barrier.h"],
    deps = [
        ":commands",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/gpu/target:identity",
    ],
)

