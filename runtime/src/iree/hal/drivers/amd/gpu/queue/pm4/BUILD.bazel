# The runtime ships relocation-free instruction words. These test-only products
# check the source and complete descriptor contract for every supported family.
# This comparison embeds all instruction families in one test executable.
_PROGRAM_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
    "//loom/config/target/amdgpu:descriptor_set_gfx11_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_rdna3_5_core",
    "//loom/config/target/amdgpu:descriptor_set_rdna4m_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_5_generic_core",
])

_PROGRAM_TARGETS = [
    "gfx11-generic",
    "gfx1151",
    "gfx1170",
    "gfx12-generic",
    "gfx12-5-generic",
]

[
    loom_target_profile(
        name = "dispatch_program_profile_" + target,
        family = "amdgpu",
        selector = target,
        target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
        visibility = ["//visibility:private"],
    )
    for target in _PROGRAM_TARGETS
]

[
    loom_kernel_binary(
        name = "dispatch_program_" + target,
        testonly = True,
        srcs = ["dispatch_info.loom"],
        out = "dispatch_program_" + target + ".hsaco",
        target = ":dispatch_program_profile_" + target,
        target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
    )
    for target in _PROGRAM_TARGETS
]

iree_c_embed_data(
    name = "dispatch_programs",
    testonly = True,
    srcs = [":dispatch_program_" + target for target in _PROGRAM_TARGETS],
    c_file_output = "dispatch_programs.c",
    h_file_output = "dispatch_programs.h",
    identifier = "iree_hal_amd_gpu_pm4_dispatch_programs",
    target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
)

[
    loom_kernel_binary(
        name = "fixup_program_" + target,
        testonly = True,
        srcs = ["fixup.loom"],
        out = "fixup_program_" + target + ".hsaco",
        target = ":dispatch_program_profile_" + target,
        target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
    )
    for target in _PROGRAM_TARGETS
]

[
