load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_test(
    name = "queue_test",
    srcs = ["queue_test.cc"],
    target_compatible_with = select({
        "//libamdf/config:enabled_setting": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":queue",
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/fabric",
        "//runtime/src/iree/hal/drivers/amd/gpu:context",
        "//runtime/src/iree/hal/drivers/amd/gpu:publication",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "queue",
    srcs = ["queue.c"],
    hdrs = ["queue.h"],
    target_compatible_with = select({
        "//libamdf/config:enabled_setting": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd:status",
        "//runtime/src/iree/hal/drivers/amd/fabric:memory",
        "//runtime/src/iree/hal/drivers/amd/gpu:completion",
        "//runtime/src/iree/hal/drivers/amd/gpu:context",
        "//runtime/src/iree/hal/drivers/amd/gpu:publication",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue:publisher",
    ],
)
