        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:barrier",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:command_buffer",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:commands",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:dispatch",
