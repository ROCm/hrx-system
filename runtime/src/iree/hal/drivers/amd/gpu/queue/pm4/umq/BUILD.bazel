load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "ring",
    srcs = ["ring.c"],
    hdrs = ["ring.h"],
    deps = [
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/drivers/amd:status",
        "//runtime/src/iree/hal/drivers/amd/gpu:context",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue/pm4:commands",
    ],
)

iree_runtime_cc_library(
    name = "queue",
    srcs = ["queue.c"],
    hdrs = ["queue.h"],
    deps = [
        ":ring",
        "//libamdf:headers",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:semaphore_wait",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:cpu_data",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd:status",
        "//runtime/src/iree/hal/drivers/amd/fabric:memory",
        "//runtime/src/iree/hal/drivers/amd/gpu:completion",
        "//runtime/src/iree/hal/drivers/amd/gpu:context",
        "//runtime/src/iree/hal/drivers/amd/gpu:executable",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue:allocation",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue:capture_pool",
