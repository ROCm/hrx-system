// One wave copies a resident packet block into exclusively reserved ring slots.
// The first header stays INVALID until every body and successor header is
// visible. An INVALID template is an indirect target whose preceding dispatch
// publishes its counts; the pair always belongs to the same block.
kernel.def export("materialize") @materialize() {
  %one = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%width, %one, %one) : index
} launch(%ring: buffer, %packets: buffer, %ring_address: i64, %packet_address: i64, %ring_mask: i32, %first: i32, %packet_count: i32) {
  %profiled = scalar.constant false : i1
  %zero64 = scalar.constant 0 : i64
  func.call @materialize_block(%ring, %packets, %ring_address, %packet_address, %ring_mask, %first, %packet_count, %profiled, %ring, %zero64) : (buffer, buffer, i64, i64, i32, i32, i32, i1, buffer, i64) -> ()
  kernel.return
}

kernel.def export("materialize_profile") @materialize_profile() {
  %one = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%width, %one, %one) : index
} launch(%ring: buffer, %packets: buffer, %ring_address: i64, %packet_address: i64, %ring_mask: i32, %first: i32, %packet_count: i32, %signals: buffer, %signal_address: i64) {
  %profiled = scalar.constant true : i1
  func.call @materialize_block(%ring, %packets, %ring_address, %packet_address, %ring_mask, %first, %packet_count, %profiled, %signals, %signal_address) : (buffer, buffer, i64, i64, i32, i32, i32, i1, buffer, i64) -> ()
  kernel.return
}

// Constant specialization removes all profiling work from ordinary kernels.
func.def inline @materialize_block(%ring: buffer, %packets: buffer, %ring_address: i64, %packet_address: i64, %ring_mask: i32, %first: i32, %packet_count: i32, %profiled: i1, %signals: buffer, %signal_address: i64) {
  %disabled = scalar.constant false : i1
  %lane = kernel.workitem.id<x> : index
  %zero = index.constant 0 : index
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %four32 = scalar.constant 4 : i32
  %six32 = scalar.constant 6 : i32
  %mask32 = scalar.constant 15 : i32
  %width = index.constant 32 : index
  %word_size = index.constant 4 : offset
  %count32 = scalar.shli %packet_count, %four32 : i32
  %word_count = index.cast %count32 : i32 to index
  %ring_global = buffer.assume.memory_space<global> %ring : buffer
  %origin = index.constant 0 : offset
  scf.for %word = [%lane to %word_count step %width] {
    %word32 = index.cast %word : index to i32
    %packet = scalar.shrui %word32, %four32 : i32
    %within = scalar.andi %word32, %mask32 : i32
    %position = scalar.addi %first, %packet : i32
    %slot = scalar.andi %position, %ring_mask : i32
    %slot_word = scalar.shli %slot, %four32 : i32
    %destination_word = scalar.addi %slot_word, %within : i32
    %destination_index = index.cast %destination_word : i32 to index
    %destination_offset = index.scale %destination_index, %word_size : index, offset -> offset
    %source_offset = index.scale %word, %word_size : index, offset -> offset
    %source = buffer.view %packets[%source_offset] : buffer -> view<1xi32>
    %value = view.load %source[0] : view<1xi32> -> i32
    %not_first = scalar.cmpi ne, %word32, %zero32 : i32
    scf.if %profiled {
      // Only private templates carry ordinals. Every native completion field
      // receives a complete pointer, or zero when capture is disabled.
      %completion_word = scalar.constant 14 : i32
      %completion_high_word = scalar.constant 15 : i32
      %is_completion = scalar.cmpi eq, %within, %completion_word : i32
      %is_completion_high = scalar.cmpi eq, %within, %completion_high_word : i32
      scf.if %is_completion {
        %zero64 = scalar.constant 0 : i64
        %one64 = scalar.constant 1 : i64
        %tagged = scalar.cmpi ne, %value, %zero32 : i32
        %enabled = scalar.cmpi ne, %signal_address, %zero64 : i64
        %capture = scalar.andi %tagged, %enabled : i1
        %completion_address = scf.if %capture -> (i64) {
          %ordinal = scalar.subi %value, %one32 : i32
          %sample_bytes = scalar.shli %ordinal, %six32 : i32
          %sample_offset = index.cast %sample_bytes : i32 to offset
          %sample = buffer.view %signals[%sample_offset] : buffer -> view<8xi64>
          view.store %one64, %sample[0] : i64, view<8xi64>
          view.store %one64, %sample[1] : i64, view<8xi64>
          view.store %zero64, %sample[2] : i64, view<8xi64>
          view.store %zero64, %sample[3] : i64, view<8xi64>
          view.store %zero64, %sample[4] : i64, view<8xi64>
          view.store %zero64, %sample[5] : i64, view<8xi64>
          view.store %zero64, %sample[6] : i64, view<8xi64>
          view.store %zero64, %sample[7] : i64, view<8xi64>
          %sample_bytes64 = scalar.extui %sample_bytes : i32 to i64
          %address = scalar.addi %signal_address, %sample_bytes64 : i64
          scf.yield %address : i64
        } else {
          scf.yield %zero64 : i64
        }
        %completion_target = buffer.view %ring_global[%destination_offset] : buffer -> view<1xi64>
        view.store %completion_address, %completion_target[0] : i64, view<1xi64>
      } else {
        %not_completion_high = scalar.cmpi eq, %is_completion_high, %disabled : i1
        %copy = scalar.andi %not_first, %not_completion_high : i1
        scf.if %copy {
          %destination = buffer.view %ring_global[%destination_offset] : buffer -> view<1xi32>
          view.store %value, %destination[0] : i32, view<1xi32>
        }
      }
    } else {
      scf.if %not_first {
        %destination = buffer.view %ring_global[%destination_offset] : buffer -> view<1xi32>
        view.store %value, %destination[0] : i32, view<1xi32>
      }
    }
    %is_header = scalar.cmpi eq, %within, %zero32 : i32
    %is_indirect = scalar.cmpi eq, %value, %one32 : i32
    %patch = scalar.andi %is_header, %is_indirect : i1
    scf.if %patch {
      // The preceding packet names the argument record owned by the resident
      // instance. Only its ring target is invocation/chunk dependent.
      %argument_delta = index.constant 24 : offset
      %argument_offset = index.sub %source_offset, %argument_delta : offset
      %argument_word = buffer.view %packets[%argument_offset] : buffer -> view<1xi64>
      %argument_address = view.load %argument_word[0] : view<1xi64> -> i64
      %relative = scalar.subi %argument_address, %packet_address : i64
      %private_offset = scalar.assume %relative [range(%relative, 0, 4294967295)] : i64
      %relative_offset = index.cast %private_offset : i64 to offset
      %target = buffer.view %packets[%relative_offset] : buffer -> view<1xi64>
      %slot_bytes = scalar.shli %slot, %six32 : i32
      %slot_bytes64 = scalar.extui %slot_bytes : i32 to i64
      %target_address = scalar.addi %ring_address, %slot_bytes64 : i64
      view.store %target_address, %target[0] : i64, view<1xi64>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %leader = index.cmp eq, %lane, %zero : index
  scf.if %leader {
    %first_source = buffer.view %packets[%origin] : buffer -> view<1xi32>
    %header = view.load %first_source[0] : view<1xi32> -> i32
    %first_slot = scalar.andi %first, %ring_mask : i32
    %first_bytes = scalar.shli %first_slot, %six32 : i32
    %first_offset = index.cast %first_bytes : i32 to offset
    %first_target = buffer.view %ring_global[%first_offset] : buffer -> view<1xi32>
    view.atomic.store %header, %first_target[0] {ordering = release, scope = system} : i32, view<1xi32>
  }
  func.return
}
