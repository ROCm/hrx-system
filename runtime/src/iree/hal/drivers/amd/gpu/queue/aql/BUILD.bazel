load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "packet",
    srcs = ["packet.c"],
    hdrs = ["packet.h"],
    deps = ["//runtime/src/iree/base"],
)

iree_runtime_cc_library(
    name = "ring",
    srcs = ["ring.c"],
    hdrs = ["ring.h"],
    deps = [
        ":packet",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_test(
    name = "packet_test",
    srcs = ["packet_test.cc"],
    deps = [
        ":packet",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_test(
    name = "ring_test",
    srcs = ["ring_test.cc"],
    deps = [
        ":packet",
        ":ring",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_benchmark(
    name = "ring_benchmark",
    srcs = ["ring_benchmark.cc"],
    deps = [
        ":packet",
        ":ring",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

iree_runtime_cc_library(
    name = "signal",
    srcs = ["signal.c"],
    hdrs = ["signal.h"],
    deps = [
        ":packet",
        "//libamdf:headers",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue:signal",
    ],
)

iree_runtime_cc_test(
    name = "signal_test",
    srcs = ["signal_test.cc"],
    deps = [
        ":packet",
        ":signal",
        "//libamdf:headers",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async:platform",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue:semaphore",
        "//runtime/src/iree/hal/drivers/amd/gpu/queue:signal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
