package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_PROGRAM_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
    "//loom/config/target/amdgpu:descriptor_set_cdna2_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx9_4_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx11_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_rdna3_5_core",
    "//loom/config/target/amdgpu:descriptor_set_rdna4m_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_5_generic_core",
])

_PROGRAM_TARGETS = [
    "gfx90a",
    "gfx9-4-generic",
    "gfx11-generic",
    "gfx1151",
    "gfx1170",
    "gfx12-generic",
    "gfx12-5-generic",
]

[
    loom_target_profile(
        name = "program_profile_" + target,
        family = "amdgpu",
        selector = target,
        target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
        visibility = ["//visibility:private"],
    )
    for target in _PROGRAM_TARGETS
]

[
    loom_kernel_binary(
        name = "indirect_program_" + target,
        testonly = True,
        srcs = ["indirect.loom"],
        out = "indirect_program_" + target + ".hsaco",
        target = ":program_profile_" + target,
        target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
    )
    for target in _PROGRAM_TARGETS
]

iree_c_embed_data(
    name = "indirect_programs",
    testonly = True,
    srcs = [":indirect_program_" + target for target in _PROGRAM_TARGETS],
    c_file_output = "indirect_programs.c",
    h_file_output = "indirect_programs.h",
    identifier = "iree_hal_amd_gpu_aql_indirect_programs",
    target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
)

[
    loom_kernel_binary(
        name = "materialize_program_" + target,
        testonly = True,
        srcs = ["materialize.loom"],
        out = "materialize_program_" + target + ".hsaco",
        target = ":program_profile_" + target,
        target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
    )
    for target in _PROGRAM_TARGETS
]

iree_c_embed_data(
    name = "materialize_programs",
    testonly = True,
    srcs = [":materialize_program_" + target for target in _PROGRAM_TARGETS],
    c_file_output = "materialize_programs.c",
    h_file_output = "materialize_programs.h",
    identifier = "iree_hal_amd_gpu_aql_materialize_programs",
    target_compatible_with = _PROGRAM_COMPATIBLE_WITH,
)

