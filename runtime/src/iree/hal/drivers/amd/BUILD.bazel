load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "status",
    srcs = ["status.c"],
    hdrs = ["status.h"],
    deps = [
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_test(
    name = "status_test",
    srcs = ["status_test.cc"],
    deps = [
        ":status",
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "driver",
    srcs = ["driver.c"],
    hdrs = ["driver.h"],
    defines = select({
        "//runtime/config/hal:driver_amd_gpu": ["IREE_HAL_AMD_GPU_ENABLED=1"],
        "//conditions:default": ["IREE_HAL_AMD_GPU_ENABLED=0"],
    }) + select({
        "//runtime/config/hal:driver_amd_xdna": ["IREE_HAL_AMD_XDNA_ENABLED=1"],
        "//conditions:default": ["IREE_HAL_AMD_XDNA_ENABLED=0"],
    }),
    target_compatible_with = select({
        "//runtime/config/hal:driver_amd": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":status",
        "//libamdf:amdf_static",
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/fabric",
    ] + select({
        "//runtime/config/hal:driver_amd_gpu": [
            "//runtime/src/iree/hal/drivers/amd/gpu:context",
            "//runtime/src/iree/hal/drivers/amd/gpu:device",
        ],
        "//conditions:default": [],
    }) + select({
        "//runtime/config/hal:driver_amd_xdna": [
            "//runtime/src/iree/hal/drivers/amd/xdna:context",
            "//runtime/src/iree/hal/drivers/amd/xdna:device",
        ],
        "//conditions:default": [],
    }),
)

iree_runtime_cc_test(
    name = "driver_test",
    srcs = ["driver_test.cc"],
    target_compatible_with = select({
        "//runtime/config/hal:driver_amd": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":driver",
        "//libamdf:headers",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/registration",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
