load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")
load("//runtime/build_tools/bazel:hal_cts.bzl", "iree_runtime_hal_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "backends",
    testonly = True,
    srcs = ["backends.cc"],
    deps = [
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/drivers/amd/xdna:driver",
    ],
    alwayslink = True,
)

iree_runtime_hal_cts_test_suite(
    backends = ":backends",
    resource_group = "gpu-device",
)

iree_runtime_cc_test(
    name = "native_test",
    srcs = ["native_test.cc"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/xdna:driver",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32_npu4",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_benchmark(
    name = "queue_benchmark",
    srcs = ["queue_benchmark.cc"],
    tags = ["benchmark"],
    deps = [
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/xdna:driver",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32_npu4",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
    ],
)
