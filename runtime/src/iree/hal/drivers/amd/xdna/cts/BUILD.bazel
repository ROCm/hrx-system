load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")
load("//runtime/build_tools/bazel:hal_cts.bzl", "iree_runtime_hal_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "backends",
    testonly = True,
    srcs = ["backends.cc"],
    deps = [
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/drivers/amd:driver",
    ],
    alwayslink = True,
)

iree_runtime_hal_cts_test_suite(
    backends = ":backends",
    resource_group = "gpu-device",
)

iree_runtime_cc_test(
    name = "native_test",
    srcs = ["native_test.cc"],
    target_compatible_with = select({
        "//runtime/config/hal:driver_task": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//runtime/config/hal:driver_amd": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:shm",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/drivers/amd/registration",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32_npu4",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
        "//runtime/src/iree/hal/drivers/task:device",
        "//runtime/src/iree/hal/drivers/task/executable",
        "//runtime/src/iree/hal/drivers/task/executable/library:util",
        "//runtime/src/iree/hal/utils:files",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)

iree_runtime_cc_test(
    name = "native_replay_stress",
    srcs = ["native_replay_stress.cc"],
    tags = [
        "manual",
        "stress",
    ],
    target_compatible_with = select({
        "//runtime/config/hal:driver_xdna": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/cts/util:test_main",
        "//runtime/src/iree/hal/drivers/amd:driver",
        "//runtime/src/iree/hal/drivers/amd/xdna:allocation_tracker",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32_npu4",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
        "//runtime/src/iree/testing:gtest",
    ],
)

iree_runtime_cc_benchmark(
    name = "queue_benchmark",
    srcs = ["queue_benchmark.cc"],
    # Exercise each harness path without running the full depth/timing matrix.
    args = ["--benchmark_filter=XdnaQueueBenchmark/(ReadyEndToEnd/|UnresolvedSubmitOnly/|RecordedSwitchingEndToEnd/6/|MeasuredRecordedStreamingEndToEnd/1/)"],
    tags = ["benchmark"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd:driver",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:add_i32_npu4",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
        "//runtime/src/iree/hal/memory:fixed_block_pool",
        "//runtime/src/iree/hal/memory:slab_cache",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
