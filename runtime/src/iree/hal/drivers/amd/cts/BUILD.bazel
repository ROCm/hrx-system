load("//loom/build_tools/amdgpu:target_config.bzl", "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")
load("//runtime/src/iree/hal/drivers/amd/gpu/cts:testdata.bzl", "iree_hal_amd_gpu_cts_testdata")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "cpu_executable",
    testonly = True,
    srcs = ["cpu_executable.cc"],
    hdrs = ["cpu_executable.h"],
    target_compatible_with = select({
        "//runtime/config/hal:driver_task": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/task/executable",
        "//runtime/src/iree/hal/drivers/task/executable/library:util",
    ],
)

# Each composition declares its participants: CPU/XDNA coverage also runs on
# machines without a GPU, while shared address replacement needs both engines.
iree_runtime_cc_test(
    name = "cpu_xdna_test",
    srcs = ["cpu_xdna_test.cc"],
    tags = [
        "iree-build-requirement=libamdf.xdna",
        "iree-run-requirement=libamdf.resource.xdna",
        "runtime-resource=amd-xdna",
    ],
    target_compatible_with = select({
        "//runtime/config/hal:driver_task": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//runtime/config/hal:driver_amd_xdna": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//libamdf/config/family:xdna": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":cpu_executable",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:shm",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/registration",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
        "//runtime/src/iree/hal/drivers/task:device",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

_EXECUTION_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
]) + select(dict([
    (
        "//loom/config/target/amdgpu:" + capability,
        [],
    )
    for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
] + [(
    "//conditions:default",
    ["@platforms//:incompatible"],
)])) + select({
    "//runtime/config/hal:driver_task": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) + select({
    "//runtime/config/hal:driver_amd_gpu": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) + select({
    "//runtime/config/hal:driver_amd_xdna": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) + select({
    "//libamdf/config/family:gpu": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) + select({
    "//libamdf/config/family:xdna": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

iree_hal_amd_gpu_cts_testdata(
    name = "affine_testdata",
    srcs = ["affine_i32.loom"],
    backend_names = ["amd_cts_affine"],
    target_compatible_with = _EXECUTION_COMPATIBLE_WITH,
)

iree_runtime_cc_test(
    name = "execution_test",
    srcs = ["execution_test.cc"],
    tags = [
        "iree-build-requirement=libamdf.gpu",
        "iree-build-requirement=libamdf.xdna",
        "iree-run-requirement=libamdf.resource.amd_gpu",
        "iree-run-requirement=libamdf.resource.xdna",
        "runtime-resource=amd-gpu",
        "runtime-resource=amd-xdna",
    ],
    target_compatible_with = _EXECUTION_COMPATIBLE_WITH,
    deps = [
        ":affine_testdata",
        ":cpu_executable",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/drivers/amd/gpu/cts:testdata",
        "//runtime/src/iree/hal/drivers/amd/gpu/target:identity",
        "//runtime/src/iree/hal/drivers/amd/registration",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
        "//runtime/src/iree/hal/drivers/task:device",
        "//runtime/src/iree/hal/memory:fixed_block_pool",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_test(
    name = "virtual_buffer_test",
    srcs = ["virtual_buffer_test.cc"],
    tags = [
        "iree-build-requirement=libamdf.gpu",
        "iree-build-requirement=libamdf.xdna",
        "iree-run-requirement=libamdf.resource.amd_gpu",
        "iree-run-requirement=libamdf.resource.xdna",
        "runtime-resource=amd-gpu",
        "runtime-resource=amd-xdna",
    ],
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "//runtime/config/hal:driver_amd_xdna": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//runtime/config/hal:driver_task": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//libamdf/config/family:gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//libamdf/config/family:xdna": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//runtime/src/iree/hal/drivers/amd/fabric/cts:virtual_buffer_test_base",
        "//runtime/src/iree/hal/drivers/amd/xdna:context",
        "//runtime/src/iree/hal/drivers/amd/xdna:device",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
