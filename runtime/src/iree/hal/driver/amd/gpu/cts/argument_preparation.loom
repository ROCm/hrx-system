// Repeated dispatches bind distinct invocation slots to the same kernel. All
// eight input addresses and the output address contribute to the result.
kernel.def export("many_bindings") @many_bindings() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer, %output: buffer, %increment: i32) {
  %base = index.constant 0 : offset
  %a_view = buffer.view %a[%base] : buffer -> view<1xi32>
  %a_value = view.load %a_view[0] : view<1xi32> -> i32
  %b_view = buffer.view %b[%base] : buffer -> view<1xi32>
  %b_value = view.load %b_view[0] : view<1xi32> -> i32
  %c_view = buffer.view %c[%base] : buffer -> view<1xi32>
  %c_value = view.load %c_view[0] : view<1xi32> -> i32
  %d_view = buffer.view %d[%base] : buffer -> view<1xi32>
  %d_value = view.load %d_view[0] : view<1xi32> -> i32
  %e_view = buffer.view %e[%base] : buffer -> view<1xi32>
  %e_value = view.load %e_view[0] : view<1xi32> -> i32
  %f_view = buffer.view %f[%base] : buffer -> view<1xi32>
  %f_value = view.load %f_view[0] : view<1xi32> -> i32
  %g_view = buffer.view %g[%base] : buffer -> view<1xi32>
  %g_value = view.load %g_view[0] : view<1xi32> -> i32
  %h_view = buffer.view %h[%base] : buffer -> view<1xi32>
  %h_value = view.load %h_view[0] : view<1xi32> -> i32
  %a_sum = scalar.addi %increment, %a_value : i32
  %b_sum = scalar.addi %a_sum, %b_value : i32
  %c_sum = scalar.addi %b_sum, %c_value : i32
  %d_sum = scalar.addi %c_sum, %d_value : i32
  %e_sum = scalar.addi %d_sum, %e_value : i32
  %f_sum = scalar.addi %e_sum, %f_value : i32
  %g_sum = scalar.addi %f_sum, %g_value : i32
  %h_sum = scalar.addi %g_sum, %h_value : i32
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %h_sum, %output_view[0] : i32, view<1xi32>
  kernel.return
}
