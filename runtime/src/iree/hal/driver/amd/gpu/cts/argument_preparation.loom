// Pointer-first ABIs straddle small and large preparation extents. Each lane
// writes a distinct output from the first and last scalar in the full ABI.
// Multiple ordinary vector arguments keep large payloads within target carrier
// limits while preserving the complete kernel argument byte range.

kernel.def export("k64") @k64() {
  %one = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%width, %one, %one) : index
} launch(%output: buffer, %values0: vector<7xf64>) {
  %first = vector.extract %values0[0] : vector<7xf64> -> f64
  %last = vector.extract %values0[6] : vector<7xf64> -> f64
  %value = scalar.addf %first, %last : f64
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<64xf64>
  view.store %value, %view[%lane] : f64, view<64xf64>
  kernel.return
}

