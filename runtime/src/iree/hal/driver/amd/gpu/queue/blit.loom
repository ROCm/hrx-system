// Each group visits rows and slices independently, then uses dense sixteen-byte
// lane vectors within each row. A linear transfer is one row and one slice.
// The X loop strides across at most 256 groups; Y/Z steps are supplied directly
// so the same body works without a dispatch-packet pointer. Exact-width tails
// never access padding or bytes outside the admitted region.
kernel.def export("blit") @blit(%groups_x: index, %groups_y: index, %groups_z: index) {
  %one = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%groups_x, %groups_y, %groups_z) workgroup_size(%width, %one, %one) : index
} launch(%source: buffer, %target: buffer, %length: offset, %pattern: i32, %fill: i32, %source_row_stride: offset, %source_slice_stride: offset, %target_row_stride: offset, %target_slice_stride: offset, %row_count: index, %slice_count: index, %groups_y: index, %groups_z: index) {
  %group = kernel.workgroup.id<x> : index
  %row_begin = kernel.workgroup.id<y> : index
  %slice_begin = kernel.workgroup.id<z> : index
  %lane = kernel.workitem.id<x> : index
  %width = index.constant 64 : offset
  %group_offset = index.scale %group, %width : index, offset -> offset
  %group_index = index.cast %group_offset : offset to index
  %position = index.add %group_index, %lane : index
  %vector_size = index.constant 16 : offset
  %begin_offset = index.scale %position, %vector_size : index, offset -> offset
  %zero = scalar.constant 0 : i32
  %copy = scalar.cmpi eq, %fill, %zero : i32
  %stride = index.constant 262144 : offset
  %sixteen = index.constant 16 : offset
  %terminal_z = scf.while(%z = %slice_begin : index) -> (index) {
    %active_z = index.cmp ult, %z, %slice_count : index
    scf.condition %active_z, %z : i1, index
  } do(%z: index) {
    %source_slice_offset = index.scale %z, %source_slice_stride : index, offset -> offset
    %target_slice_offset = index.scale %z, %target_slice_stride : index, offset -> offset
    %terminal_y = scf.while(%y = %row_begin : index) -> (index) {
      %active_y = index.cmp ult, %y, %row_count : index
      scf.condition %active_y, %y : i1, index
    } do(%y: index) {
      %source_row_offset = index.scale %y, %source_row_stride : index, offset -> offset
      %target_row_offset = index.scale %y, %target_row_stride : index, offset -> offset
      %source_offset = index.add %source_slice_offset, %source_row_offset : offset
      %target_offset = index.add %target_slice_offset, %target_row_offset : offset
      %terminal = scf.while(%offset = %begin_offset : offset) -> (offset) {
        %active = index.cmp slt, %offset, %length : offset
        scf.condition %active, %offset : i1, offset
      } do(%offset: offset) {
        %remaining = index.sub %length, %offset : offset
        %full = index.cmp sge, %remaining, %sixteen : offset
        scf.if %full {
          %destination_offset = index.add %target_offset, %offset : offset
          %destination = buffer.view %target[%destination_offset] : buffer -> view<4xi32, align(1)>
          scf.if %copy {
            %input_offset = index.add %source_offset, %offset : offset
            %input = buffer.view %source[%input_offset] : buffer -> view<4xi32, align(1)>
            %words = vector.load %input[0] : view<4xi32, align(1)> -> vector<4xi32>
            vector.store %words, %destination[0] : vector<4xi32>, view<4xi32, align(1)>
          } else {
            %words = vector.splat %pattern : vector<4xi32>
            vector.store %words, %destination[0] : vector<4xi32>, view<4xi32, align(1)>
          }
        } else {
          %tail = index.cast %remaining : offset to i32
          %eight = scalar.constant 8 : i32
          %four = scalar.constant 4 : i32
          %two = scalar.constant 2 : i32
          %one = scalar.constant 1 : i32
          %eight_bytes = scalar.andi %tail, %eight : i32
          %has_eight = scalar.cmpi ne, %eight_bytes, %zero : i32
          scf.if %has_eight {
            %destination_pair_offset = index.add %target_offset, %offset : offset
            %destination_pair = buffer.view %target[%destination_pair_offset] : buffer -> view<2xi32, align(1)>
            scf.if %copy {
              %input_pair_offset = index.add %source_offset, %offset : offset
              %input_pair = buffer.view %source[%input_pair_offset] : buffer -> view<2xi32, align(1)>
              %pair = vector.load %input_pair[0] : view<2xi32, align(1)> -> vector<2xi32>
              vector.store %pair, %destination_pair[0] : vector<2xi32>, view<2xi32, align(1)>
            } else {
              %pair = vector.splat %pattern : vector<2xi32>
              vector.store %pair, %destination_pair[0] : vector<2xi32>, view<2xi32, align(1)>
            }
          }
          %four_bytes = scalar.andi %tail, %four : i32
          %has_four = scalar.cmpi ne, %four_bytes, %zero : i32
          scf.if %has_four {
            %prefix = index.cast %eight_bytes : i32 to offset
            %absolute = index.add %offset, %prefix : offset
            %destination_word_offset = index.add %target_offset, %absolute : offset
            %destination_word = buffer.view %target[%destination_word_offset] : buffer -> view<1xi32, align(1)>
            scf.if %copy {
              %input_word_offset = index.add %source_offset, %absolute : offset
              %input_word = buffer.view %source[%input_word_offset] : buffer -> view<1xi32, align(1)>
              %word = view.load %input_word[0] : view<1xi32, align(1)> -> i32
              view.store %word, %destination_word[0] : i32, view<1xi32, align(1)>
            } else {
              view.store %pattern, %destination_word[0] : i32, view<1xi32, align(1)>
            }
          }
          %two_bytes = scalar.andi %tail, %two : i32
          %has_two = scalar.cmpi ne, %two_bytes, %zero : i32
          scf.if %has_two {
            %mask = scalar.constant 12 : i32
            %prefix32 = scalar.andi %tail, %mask : i32
            %prefix = index.cast %prefix32 : i32 to offset
            %absolute = index.add %offset, %prefix : offset
            %destination_half_offset = index.add %target_offset, %absolute : offset
            %destination_half = buffer.view %target[%destination_half_offset] : buffer -> view<1xi16, align(1)>
            scf.if %copy {
              %input_half_offset = index.add %source_offset, %absolute : offset
              %input_half = buffer.view %source[%input_half_offset] : buffer -> view<1xi16, align(1)>
              %half = view.load %input_half[0] : view<1xi16, align(1)> -> i16
              view.store %half, %destination_half[0] : i16, view<1xi16, align(1)>
            } else {
              %half = scalar.trunci %pattern : i32 to i16
              view.store %half, %destination_half[0] : i16, view<1xi16, align(1)>
            }
          }
          %one_byte = scalar.andi %tail, %one : i32
          %has_one = scalar.cmpi ne, %one_byte, %zero : i32
          scf.if %has_one {
            %mask = scalar.constant 14 : i32
            %prefix32 = scalar.andi %tail, %mask : i32
            %prefix = index.cast %prefix32 : i32 to offset
            %absolute = index.add %offset, %prefix : offset
            %destination_byte_offset = index.add %target_offset, %absolute : offset
            %destination_byte = buffer.view %target[%destination_byte_offset] : buffer -> view<1xi8>
            scf.if %copy {
              %input_byte_offset = index.add %source_offset, %absolute : offset
              %input_byte = buffer.view %source[%input_byte_offset] : buffer -> view<1xi8>
              %value = view.load %input_byte[0] : view<1xi8> -> i8
              view.store %value, %destination_byte[0] : i8, view<1xi8>
            } else {
              %three = scalar.constant 3 : i32
              %shift = scalar.shli %two_bytes, %three : i32
              %shifted = scalar.shrui %pattern, %shift : i32
              %value = scalar.trunci %shifted : i32 to i8
              view.store %value, %destination_byte[0] : i8, view<1xi8>
            }
          }
        }
        %next = index.add %offset, %stride : offset
        scf.yield %next : offset
      }
      %next_y = index.add %y, %groups_y : index
      scf.yield %next_y : index
    }
    %next_z = index.add %z, %groups_z : index
    scf.yield %next_z : index
  }
  kernel.return
}
