        %masked = scalar.andi %observed, %mask_bits : i64
        %equal = scalar.cmpi eq, %masked, %operand : i64
        %not_equal = scalar.cmpi ne, %masked, %operand : i64
        %greater_equal = scalar.cmpi uge, %masked, %operand : i64
        %other = scf.select %wait_not_equal, %not_equal, %greater_equal : i1
        %complete = scf.select %wait_equal, %equal, %other : i1
        %again = scalar.xori %complete, %true : i1
        scf.yield %again : i1
      }
    } else {
      %add = scalar.cmpi eq, %opcode, %four : i32
      %subtract = scalar.cmpi eq, %opcode, %five : i32
      %and = scalar.cmpi eq, %opcode, %six : i32
      %or = scalar.cmpi eq, %opcode, %seven : i32
      %initial = view.atomic.load %cell[0] {ordering = relaxed, scope = device} : view<1xi64> -> i64
      %final, %complete = scf.while(%expected = %initial : i64, %done = %false : i1) -> (i64, i1) {
        %again = scalar.xori %done, %true : i1
        scf.condition %again, %expected, %done : i1, i64, i1
      } do(%expected: i64, %done: i1) {
        %sum = scalar.addi %expected, %operand : i64
        %difference = scalar.subi %expected, %operand : i64
        %both = scalar.andi %expected, %operand : i64
        %either = scalar.ori %expected, %operand : i64
        %exclusive = scalar.xori %expected, %operand : i64
        %or_xor = scf.select %or, %either, %exclusive : i64
        %bitwise = scf.select %and, %both, %or_xor : i64
        %other = scf.select %subtract, %difference, %bitwise : i64
        %desired = scf.select %add, %sum, %other : i64
        %observed = view.atomic.cmpxchg %expected, %desired, %cell[0] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<1xi64> -> i64
        %success = scalar.cmpi eq, %observed, %expected : i64
        scf.yield %observed, %success : i64, i1
