load("//build_tools/testing:build_defs.bzl", "iree_cli_test")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "registration",
    srcs = ["driver_module.c"],
    hdrs = ["driver_module.h"],
    defines = ["IREE_HAVE_HAL_AMD_DRIVER_MODULE=1"],
    deps = [
        "//libamdf:headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/driver/amd:driver",
        "//runtime/src/iree/io:file_handle",
    ],
)

iree_cli_test(
    name = "flags_test",
    data = ["embedded_nul.bin"],
    manifests = ["driver_module.test.json"],
    target_compatible_with = select({
        "//runtime/config/hal:driver_amd": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tools = {"iree-run-replay": "//tools:iree-run-replay"},
)
