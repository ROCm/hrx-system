aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 3}) @sparse_copy_i32() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_rank, @copy_record
  %input = binding 0, "read"
  %output = binding 2, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<16xi32>>
  %worker_receiver_0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %input_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_channel_records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_channel = channel %input_sender, %worker_receiver_0, %input_channel_capacity, %input_channel_records : reg<aie2p.array.channel : tile<16xi32>>
  %worker_sender_1 = sender %worker, 1 : reg<aie2p.array.sender : tile<16xi32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %worker_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_1_channel_records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %worker_1_channel = channel %worker_sender_1, %output_receiver, %worker_1_channel_capacity, %worker_1_channel_records : reg<aie2p.array.channel : tile<16xi32>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @copy_record(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %count = index.constant 16 : index
  scf.for %i = [%zero to %count step %one] {
    %value = view.load %input_view[%i] : view<16xi32> -> i32
    view.store %value, %output_view[%i] : i32, view<16xi32>
  }
  func.return
}
