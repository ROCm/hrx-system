;
; One body handles linear edge patches and rectangular fills. Y/Z select a
; row/slice; X strides over its dwords. Partial dwords use compare/exchange so
; disjoint rows sharing a dword preserve each other's useful bytes.
OpCapability Shader
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %global_id %num_groups
OpExecutionMode %main LocalSize 64 1 1
OpDecorate %global_id BuiltIn GlobalInvocationId
OpDecorate %num_groups BuiltIn NumWorkgroups
OpDecorate %PushConstants Block
OpMemberDecorate %PushConstants 0 Offset 0
OpMemberDecorate %PushConstants 1 Offset 4
OpMemberDecorate %PushConstants 2 Offset 8
OpMemberDecorate %PushConstants 3 Offset 12
OpMemberDecorate %PushConstants 4 Offset 16
OpMemberDecorate %PushConstants 5 Offset 20
OpMemberDecorate %PushConstants 6 Offset 24
OpMemberDecorate %PushConstants 7 Offset 28
OpDecorate %words ArrayStride 4
OpDecorate %Target BufferBlock
OpMemberDecorate %Target 0 Offset 0
OpDecorate %target DescriptorSet 0
OpDecorate %target Binding 0
%void = OpTypeVoid
%fn = OpTypeFunction %void
%uint = OpTypeInt 32 0
%bool = OpTypeBool
%v3uint = OpTypeVector %uint 3
%ptr_input = OpTypePointer Input %v3uint
%global_id = OpVariable %ptr_input Input
%num_groups = OpVariable %ptr_input Input
%u0 = OpConstant %uint 0
%u1 = OpConstant %uint 1
%u2 = OpConstant %uint 2
%u3 = OpConstant %uint 3
%u4 = OpConstant %uint 4
%u6 = OpConstant %uint 6
%u7 = OpConstant %uint 7
%u8 = OpConstant %uint 8
%u31 = OpConstant %uint 31
%u32 = OpConstant %uint 32
%u256 = OpConstant %uint 256
%all = OpConstant %uint 4294967295
%PushConstants = OpTypeStruct %uint %uint %uint %uint %uint %uint %uint %uint
%ptr_pc = OpTypePointer PushConstant %PushConstants
%pc = OpVariable %ptr_pc PushConstant
%ptr_pc_uint = OpTypePointer PushConstant %uint
%words = OpTypeRuntimeArray %uint
%Target = OpTypeStruct %words
%ptr_target = OpTypePointer Uniform %Target
%ptr_word = OpTypePointer Uniform %uint
%target = OpVariable %ptr_target Uniform
%main = OpFunction %void None %fn
%entry = OpLabel
%gid = OpLoad %v3uint %global_id
%groups = OpLoad %v3uint %num_groups
%x = OpCompositeExtract %uint %gid 0
%y = OpCompositeExtract %uint %gid 1
%z = OpCompositeExtract %uint %gid 2
%groups_x = OpCompositeExtract %uint %groups 0
%step = OpIMul %uint %groups_x %u256
%pattern_ptr = OpAccessChain %ptr_pc_uint %pc %u0
%pattern = OpLoad %uint %pattern_ptr
%offset_ptr = OpAccessChain %ptr_pc_uint %pc %u1
%offset = OpLoad %uint %offset_ptr
%phase_ptr = OpAccessChain %ptr_pc_uint %pc %u2
%phase = OpLoad %uint %phase_ptr
%length_ptr = OpAccessChain %ptr_pc_uint %pc %u3
%length = OpLoad %uint %length_ptr
%row_stride_ptr = OpAccessChain %ptr_pc_uint %pc %u6
%row_stride = OpLoad %uint %row_stride_ptr
%slice_stride_ptr = OpAccessChain %ptr_pc_uint %pc %u7
%slice_stride = OpLoad %uint %slice_stride_ptr
%row_offset = OpIMul %uint %y %row_stride
%slice_offset = OpIMul %uint %z %slice_stride
%row_base = OpIAdd %uint %offset %row_offset
%start = OpIAdd %uint %row_base %slice_offset
%end = OpIAdd %uint %start %length
%start_byte = OpBitwiseAnd %uint %start %u3
%word_extent = OpIAdd %uint %length %start_byte
%word_extent_rounded = OpIAdd %uint %word_extent %u3
%word_count = OpShiftRightLogical %uint %word_extent_rounded %u2
%active = OpULessThan %bool %x %word_count
OpSelectionMerge %exit None
OpBranchConditional %active %active_entry %exit
%active_entry = OpLabel
%start_word = OpShiftRightLogical %uint %start %u2
%thread_word = OpIAdd %uint %start_word %x
%first = OpShiftLeftLogical %uint %thread_word %u2
OpBranch %word_loop
%word_loop = OpLabel
%position = OpPhi %uint %first %active_entry %next_position %word_continue
%in_range = OpULessThan %bool %position %end
OpLoopMerge %done %word_continue None
OpBranchConditional %in_range %body %done
%body = OpLabel
%word_end = OpIAdd %uint %position %u4
%lo = OpExtInst %uint %glsl UMax %position %start
%hi = OpExtInst %uint %glsl UMin %word_end %end
%relative = OpISub %uint %position %start
%pattern_byte = OpIAdd %uint %relative %phase
%pattern_low = OpBitwiseAnd %uint %pattern_byte %u3
%shift = OpIMul %uint %pattern_low %u8
%inverse = OpISub %uint %u32 %shift
%inverse_masked = OpBitwiseAnd %uint %inverse %u31
%right = OpShiftRightLogical %uint %pattern %shift
%left = OpShiftLeftLogical %uint %pattern %inverse_masked
%value = OpBitwiseOr %uint %right %left
%word_index = OpShiftRightLogical %uint %position %u2
%word = OpAccessChain %ptr_word %target %u0 %word_index
%first_full = OpIEqual %bool %lo %position
%last_full = OpIEqual %bool %hi %word_end
%full = OpLogicalAnd %bool %first_full %last_full
OpSelectionMerge %word_merge None
OpBranchConditional %full %store %patch
%store = OpLabel
OpStore %word %value
OpBranch %word_merge
%patch = OpLabel
%leading = OpISub %uint %lo %position
%trailing = OpISub %uint %word_end %hi
%leading_bits = OpIMul %uint %leading %u8
%trailing_bits = OpIMul %uint %trailing %u8
%low_mask = OpShiftLeftLogical %uint %all %leading_bits
%high_mask = OpShiftRightLogical %uint %all %trailing_bits
%mask = OpBitwiseAnd %uint %low_mask %high_mask
%keep = OpNot %uint %mask
%replacement = OpBitwiseAnd %uint %value %mask
%initial = OpAtomicLoad %uint %word %u1 %u0
OpBranch %patch_loop
%patch_loop = OpLabel
%previous = OpPhi %uint %initial %patch %observed %patch_continue
OpLoopMerge %patch_done %patch_continue None
OpBranch %patch_body
%patch_body = OpLabel
%preserved = OpBitwiseAnd %uint %previous %keep
%desired = OpBitwiseOr %uint %preserved %replacement
%observed = OpAtomicCompareExchange %uint %word %u1 %u0 %u0 %desired %previous
%success = OpIEqual %bool %previous %observed
OpBranchConditional %success %patch_done %patch_continue
%patch_continue = OpLabel
OpBranch %patch_loop
%patch_done = OpLabel
OpBranch %word_merge
%word_merge = OpLabel
OpBranch %word_continue
%word_continue = OpLabel
%remaining = OpISub %uint %end %position
%has_next = OpUGreaterThan %bool %remaining %step
%next_candidate = OpIAdd %uint %position %step
%next_position = OpSelect %uint %has_next %next_candidate %end
OpBranch %word_loop
%done = OpLabel
OpBranch %exit
%exit = OpLabel
OpReturn
OpFunctionEnd
