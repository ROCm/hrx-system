load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_binary", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "abi",
    hdrs = ["abi.h"],
)

iree_runtime_cc_library(
    name = "util",
    srcs = ["util.c"],
    hdrs = ["util.h"],
    deps = [
        ":abi",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_test(
    name = "util_test",
    srcs = ["util_test.cc"],
    deps = [
        ":util",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_test(
    name = "library_test",
    srcs = [
        "demo.c",
        "demo.h",
        "test.c",
    ],
    deps = [
        ":abi",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:cpu",
        "//runtime/src/iree/hal/driver/task/executable:environment",
    ],
)

iree_cmake_extra_content(
    content = "if(IREE_TARGET_HAS_THREADS AND IREE_BUILD_BENCHMARKS)",
    inline = True,
)

iree_runtime_cc_binary(
    name = "library_benchmark",
    testonly = True,
    srcs = ["benchmark.c"],
    deps = [
        ":abi",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/driver/task:device",
        "//runtime/src/iree/hal/driver/task/executable",
        "//runtime/src/iree/hal/driver/task/executable:environment",
        "//runtime/src/iree/hal/driver/task/executable:loader",
        "//runtime/src/iree/hal/driver/task/executable/loaders/registration",
        "//runtime/src/iree/hal/memory:heap_pool",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:benchmark",
    ],
)

iree_execution_test_suite(
    name = "library_benchmark_test",
    manifests = ["benchmark.test.json"],
    tools = {"benchmark": ":library_benchmark"},
)

iree_cmake_extra_content(
    content = "endif()",
    inline = True,
)
