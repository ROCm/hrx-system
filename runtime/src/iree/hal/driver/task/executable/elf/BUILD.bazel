load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load(
    "//runtime/build_tools/bazel:cc.bzl",
    "iree_runtime_cc_binary",
    "iree_runtime_cc_library",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_cmake_extra_content(
    content = """
# Disable on platforms/architectures where ELF is not supported.
if(EMSCRIPTEN)
  return()
endif()
""",
)

#===------------------------------------------------------------------------===#
# Runtime ELF module loader/linker
#===------------------------------------------------------------------------===#

iree_runtime_cc_library(
    name = "headers",
    hdrs = [
        "arch.h",
        "elf_types.h",
        "platform.h",
    ],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:memory",
    ],
)

iree_runtime_cc_library(
    name = "elf_module",
    srcs = [
        "elf_module.c",
    ],
    hdrs = [
        "elf_module.h",
    ],
    deps = [
        ":headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/driver/task/executable/elf/arch",
        "//runtime/src/iree/hal/driver/task/executable/elf/platform",
    ],
)

iree_runtime_cc_binary(
    name = "elf_module_test_binary",
    testonly = True,
    srcs = ["elf_module_test_main.c"],
    deps = [
        ":elf_module",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:cpu",
        "//runtime/src/iree/hal/driver/task/executable:environment",
        "//runtime/src/iree/hal/driver/task/executable/elf/testdata:compat_data",
        "//runtime/src/iree/hal/driver/task/executable/library:abi",
        "//runtime/src/iree/hal/driver/task/executable/library:util",
    ],
)

iree_executable_test(
    name = "elf_module_test",
    src = ":elf_module_test_binary",
)

iree_runtime_cc_binary(
    name = "elf_module_native_test_binary",
    testonly = True,
    srcs = ["elf_module_test_main.c"],
    defines = ["IREE_HAL_TASK_ELF_TEST_NATIVE_FIXTURE=1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":elf_module",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:cpu",
        "//runtime/src/iree/hal/driver/task/executable:environment",
        "//runtime/src/iree/hal/driver/task/executable/elf/testdata:elementwise_mul_native",
        "//runtime/src/iree/hal/driver/task/executable/elf/testdata:initializers_native",
        "//runtime/src/iree/hal/driver/task/executable/library:abi",
        "//runtime/src/iree/hal/driver/task/executable/library:util",
    ],
)

iree_executable_test(
    name = "elf_module_native_test",
    src = ":elf_module_native_test_binary",
    target_compatible_with = ["@platforms//os:linux"],
)
