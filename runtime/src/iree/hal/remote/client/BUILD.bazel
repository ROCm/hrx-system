iree_runtime_cc_library(
    name = "transport_factory",
    srcs = ["transport_factory.c"],
    hdrs = ["transport_factory.h"],
    defines = iree_select({
        "//runtime/config/net:transport_tcp": ["IREE_HAVE_NET_TCP_TRANSPORT=1"],
        "//conditions:default": [],
    }) + iree_select({
        "//runtime/config/net:transport_shm": ["IREE_HAVE_NET_SHM_TRANSPORT=1"],
        "//conditions:default": [],
    }) + iree_select({
        "//runtime/config/net:transport_rdma": ["IREE_HAVE_NET_RDMA_TRANSPORT=1"],
        "//conditions:default": [],
    }),
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/remote/protocol:common",
        "//runtime/src/iree/net:transport_factory",
    ] + iree_select({
        "//runtime/config/net:transport_tcp": ["//runtime/src/iree/net/carrier/tcp:factory"],
        "//conditions:default": [],
    }) + iree_select({
        "//runtime/config/net:transport_shm": ["//runtime/src/iree/net/carrier/shm:factory"],
        "//conditions:default": [],
    }) + iree_select({
        "//runtime/config/net:transport_rdma": ["//runtime/src/iree/net/carrier/rdma:factory"],
        "//conditions:default": [],
    }),
)

