# HAL remote protocol definitions: wire format types, enums, and payload
# structs for control messages, queue operations, and command buffer commands.

load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_fuzz.bzl", "iree_runtime_cc_fuzz")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "bootstrap",
    srcs = ["bootstrap.c"],
    hdrs = ["bootstrap.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_library(
    name = "commands",
    srcs = ["commands.c"],
    hdrs = ["commands.h"],
    deps = [
        ":common",
    ],
)

iree_runtime_cc_test(
    name = "commands_test",
    srcs = ["commands_test.cc"],
    deps = [
        ":commands",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_fuzz(
    name = "commands_fuzz",
    srcs = ["commands_fuzz.cc"],
    deps = [
        ":commands",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_fuzz(
    name = "bootstrap_fuzz",
    srcs = ["bootstrap_fuzz.cc"],
    deps = [
        ":bootstrap",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_library(
    name = "common",
    hdrs = ["common.h"],
    deps = [
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "control",
    hdrs = ["control.h"],
    deps = [
        ":common",
    ],
)

iree_runtime_cc_library(
    name = "profile",
    hdrs = ["profile.h"],
    deps = [
        ":common",
    ],
)

iree_runtime_cc_library(
    name = "queue",
    hdrs = ["queue.h"],
    deps = [
        ":common",
    ],
)
