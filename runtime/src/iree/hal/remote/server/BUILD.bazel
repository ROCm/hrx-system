        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/net:bootstrap",
        "//runtime/src/iree/net:session",
        "//runtime/src/iree/net:status_wire",
        "//runtime/src/iree/net:transport_factory",
        "//runtime/src/iree/net/channel/bulk:bulk_channel",
