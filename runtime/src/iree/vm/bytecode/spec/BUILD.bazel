load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

iree_py_library(
    name = "generator",
    srcs = ["generate.py"],
    imports = ["."],
    deps = [
        "//runtime/src/iree/vm/bytecode/spec/model",
        "//runtime/src/iree/vm/bytecode/spec/model/isa",
        "//runtime/src/iree/vm/bytecode/spec/model/isa:specification",
        "//runtime/src/iree/vm/bytecode/spec/model/module/v0",
        "//runtime/src/iree/vm/bytecode/spec/render",
    ],
)

iree_py_binary(
    name = "generate",
    srcs = ["generate_main.py"],
    main = "generate_main.py",
    deps = [":generator"],
)

iree_py_test(
    name = "spec_test",
    size = "small",
    srcs = ["spec_test.py"],
    deps = [
        "//runtime/src/iree/vm/bytecode/spec/model",
        "//runtime/src/iree/vm/bytecode/spec/model/isa",
    ],
)

iree_py_test(
    name = "projection_test",
    size = "small",
    srcs = ["projection_test.py"],
    deps = [
        ":generator",
        "//runtime/src/iree/vm/bytecode/spec/model",
        "//runtime/src/iree/vm/bytecode/spec/model/isa",
        "//runtime/src/iree/vm/bytecode/spec/model/isa:specification",
        "//runtime/src/iree/vm/bytecode/spec/model/module",
        "//runtime/src/iree/vm/bytecode/spec/model/module/v0",
        "//runtime/src/iree/vm/bytecode/spec/render",
    ],
)

iree_py_test(
    name = "generation_test",
    size = "small",
    srcs = ["generation_test.py"],
    data = ["//runtime/src/iree/vm/bytecode/wire:generated_files"],
    deps = [":generator"],
)

test_suite(
    name = "tests",
    tests = [
        ":generation_test",
        ":projection_test",
        ":spec_test",
    ],
)
