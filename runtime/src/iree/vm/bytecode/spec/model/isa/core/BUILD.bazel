load("//build_tools/bazel:python.bzl", "iree_py_library")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

iree_py_library(
    name = "core",
    srcs = [
        "__init__.py",
        "abi.py",
        "buffer.py",
        "constant.py",
        "control.py",
        "conversion.py",
        "float.py",
        "function.py",
        "globals.py",
        "integer.py",
        "ref.py",
        "stack.py",
        "value.py",
    ],
    deps = [
        "//runtime/src/iree/vm/bytecode/spec/model",
        "//runtime/src/iree/vm/bytecode/spec/model/isa",
        "//runtime/src/iree/vm/bytecode/spec/model/isa:definitions",
    ],
)
