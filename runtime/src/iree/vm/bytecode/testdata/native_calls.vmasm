vm.module core(0.0) {
  section strings alignment(8) {
    string @run = "run"
    string @failure = "failure"
    string @native = "native.test"
    string @replace = "replace"
    string @fail = "fail"
    string @vm = "vm"
    string @buffer = "buffer"
  }
  section ref_types alignment(8) {
    namespace @refs name(@vm) {
      ref_type @buffer_type name(@buffer)
    }
  }
  section signatures alignment(8) {
    signature @signature (i64, ref(@buffer_type)) -> (i64, ref(@buffer_type))
  }
  section callable_types alignment(8) {
    callable @callable flags([]) depth(0) : @signature
  }
  section exports alignment(8) {
    export @failure_export name(@failure) : @callable = @failure_function
    export @run_export name(@run) : @callable = @run_function
  }
  section functions alignment(8) {
    func @run_function : @callable flags([has_native_call]) frame(local_bytes = 8, value_registers = 2, ref_registers = 1, function_registers = 0, local_refs = 1, local_functions = 0) {
    ^bb0:
      control.block
      stack.store.i64 #v0, %v0.x1
      %v1 = constant.s16 11
      ref.stack.store.move %r0, #r0
      control.call.native {callsite_ordinal = 0}
      %r0 = ref.stack.load.move #r0
      control.return
    }
    func @failure_function : @callable flags([has_native_call]) frame(local_bytes = 8, value_registers = 2, ref_registers = 1, function_registers = 0, local_refs = 1, local_functions = 0) {
    ^bb0:
      control.block
      stack.store.i64 #v0, %v0.x1
      %v1 = constant.s16 11
      ref.stack.store.move %r0, #r0
      control.call.native {callsite_ordinal = 1}
      control.call.native {callsite_ordinal = 2}
      %r0 = ref.stack.load.move #r0
      control.return
    }
  }
  section native_calls alignment(8) {
    native_layout @scalar (i64)
    native_layout @replace_layout (i64, ref(@buffer_type), out i64, out ref(@buffer_type), [@scalar])
    native_layout @empty ()
    native_import @replace_import module(@native) export(@replace) version(0) : @replace_layout
    native_import @fail_import module(@native) export(@fail) version(0) : @empty
    native_callsite @run_call function(@run_function) callee(@replace_import) {
      word 0x80000000
      word 0x00000001
      word 0x00000000
      word 0x00000001
      word 0x00000002
      word 0x00000006
      word 0x00000000
      word 0x00000001
    }
    native_callsite @failure_call function(@failure_function) callee(@replace_import) {
      word 0x80000000
      word 0x00000001
      word 0x00000000
      word 0x00000001
      word 0x00000002
      word 0x00000006
      word 0x00000000
      word 0x00000001
    }
    native_callsite @fail_call function(@failure_function) callee(@fail_import) {
    }
  }
}
