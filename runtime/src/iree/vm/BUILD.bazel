load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "vm",
    srcs = [
        "buffer.c",
        "environment.c",
        "execution.c",
        "module.c",
        "ref.c",
        "reflection.c",
        "variant.c",
    ],
    hdrs = [
        "buffer.h",
        "environment.h",
        "execution.h",
        "function.h",
        "module.h",
        "ref.h",
        "reflection.h",
        "scalar.h",
        "variant.h",
    ],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:unicode",
        "//runtime/src/iree/base/threading",
    ],
)

iree_runtime_cc_library(
    name = "module_test_provider",
    testonly = True,
    srcs = ["module_test_provider.c"],
    hdrs = ["module_test_provider.h"],
    deps = [":vm"],
)

