load("//build_tools/bazel:select.bzl", "iree_select")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_binary", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "transport",
    srcs = ["transport.c"],
    hdrs = ["transport.h"],
    defines = iree_select({
        "//runtime/config/net:transport_rdma": ["IREE_HAVE_NET_RDMA_TRANSPORT=1"],
        "//conditions:default": [],
    }),
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/remote/protocol:common",
        "//runtime/src/iree/net:transport_factory",
        "//runtime/src/iree/net/carrier/shm:factory",
        "//runtime/src/iree/net/carrier/tcp:factory",
    ] + iree_select({
        "//runtime/config/net:transport_rdma": ["//runtime/src/iree/net/carrier/rdma:factory"],
        "//conditions:default": [],
    }),
)

iree_runtime_cc_test(
    name = "transport_test",
    srcs = ["transport_test.cc"],
    deps = [
        ":transport",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net:transport_factory",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_binary(
    name = "iree-serve-device",
    srcs = ["iree-serve-device-main.c"],
    visibility = ["//tools:__pkg__"],
    deps = [
        ":transport",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async:platform",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/async/util:proactor_thread",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/remote/server",
        "//runtime/src/iree/hal/remote/util:recv_pool",
        "//runtime/src/iree/net:session",
        "//runtime/src/iree/net:transport_factory",
        "//runtime/src/iree/tooling:device_util",
    ],
)
