{
  "version": 1,
  "cases": [
    {
      "name": "dump host cpu features",
      "run": {
        "tool": "iree-dump-cpuinfo"
      },
      "stdout": {
        "contains": [
          {
            "regex": "(?m)^[a-z0-9_.-]+ +[01]$"
          }
        ]
      },
      "stderr": {
        "empty": true
      }
    },
    {
      "name": "dump task topology",
      "run": {
        "tool": "iree-dump-cpuinfo",
        "args": [
          "--dump_task_topologies",
          "--task_topology_group_count=1"
        ]
      },
      "stdout": {
        "contains": [
          {
            "regex": "(?m)^# topology\\[0\\]: 1 worker groups$"
          }
        ]
      },
      "stderr": {
        "empty": true
      }
    }
  ]
}
