load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_binary")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_binary(
    name = "dynamic_library_test_library.so",
    testonly = True,
    srcs = ["dynamic_library_test_library.cc"],
    copts = select({
        "@platforms//os:windows": ["/Z7"],
        "//conditions:default": [],
    }),
    features = select({
        "@platforms//os:windows": ["generate_pdb_file"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:windows": [
            "/DEBUG",
            "/INCREMENTAL:NO",
            # Only explicit attachment can locate the matching embedded PDB.
            "/PDBALTPATH:dynamic_library_test_library.embedded.pdb",
        ],
        "//conditions:default": [],
    }),
    linkshared = True,
)

filegroup(
    name = "dynamic_library_test_library_pdb",
    testonly = True,
    srcs = [":dynamic_library_test_library.so"],
    output_group = "pdb_file",
)

iree_c_embed_data(
    name = "dynamic_library_test_library",
    testonly = True,
    srcs = [":dynamic_library_test_library.so"] + select({
        "@platforms//os:windows": [":dynamic_library_test_library_pdb"],
        "//conditions:default": [],
    }),
    c_file_output = "dynamic_library_test_library_embed.c",
    flatten = True,
    h_file_output = "dynamic_library_test_library_embed.h",
    visibility = ["//visibility:public"],
)

iree_runtime_cc_test(
    name = "dynamic_library_test",
    srcs = ["dynamic_library_test.cc"],
    tags = [
        # This test fails with Bazel under Docker.
        # See https://github.com/iree-org/iree/pull/13131 for more information.
        "nodocker",
    ],
    deps = [
        ":dynamic_library_test_library",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:dynamic_library",
        "//runtime/src/iree/base/internal:symbol_resolver_win32",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)
