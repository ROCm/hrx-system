{
  "version": 1,
  "cases": [
    {
      "name": "locked test_bool",
      "run": {
        "tool": "flags_demo",
        "args": [
          "--test_bool=true",
          "--flag-lock=test_bool",
          "--test_bool=true"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": [
          "flag 'test_bool' is locked by the invocation"
        ]
      }
    },
    {
      "name": "locked test_int32",
      "run": {
        "tool": "flags_demo",
        "args": [
          "--test_int32=27",
          "--flag-lock=test_int32",
          "--test_int32=27"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": [
          "flag 'test_int32' is locked by the invocation"
        ]
      }
    },
    {
      "name": "locked test_int64",
      "run": {
        "tool": "flags_demo",
        "args": [
          "--test_int64=9876543210",
          "--flag-lock=test_int64",
          "--test_int64=9876543210"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": [
          "flag 'test_int64' is locked by the invocation"
        ]
      }
    },
    {
      "name": "locked test_float",
      "run": {
