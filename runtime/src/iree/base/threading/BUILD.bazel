load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_binary", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

#===------------------------------------------------------------------------===#
# Libraries
#===------------------------------------------------------------------------===#

iree_runtime_cc_library(
    name = "threading",
    srcs = [
        "affinity.c",
        "mutex.c",
        "notification.c",
        "numa_fallback.c",
        "numa_impl.h",
        "numa_linux.c",
        "numa_win32.c",
        "wait_address.c",
    ],
    hdrs = [
        "affinity.h",
        "api.h",
        "call_once.h",
        "futex.h",
        "mutex.h",
        "notification.h",
        "numa.h",
        "processor.h",
        "wait_address.h",
    ],
    deps = [
        "//build_tools/bazel:pthreads",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:memory",
    ],
)

iree_runtime_cc_library(
    name = "latency",
    srcs = [
        "latency.c",
        "latency_win32.c",
    ],
    hdrs = ["latency.h"],
    tags = ["skip-bazel_to_cmake"],
    deps = [
        "//runtime/src/iree/base",
    ] + select({
        "@platforms//os:macos": [":latency_darwin"],
        "//conditions:default": [],
    }),
)

objc_library(
    name = "latency_darwin",
    hdrs = ["latency.h"],
    non_arc_srcs = ["latency_darwin.m"],
    tags = ["skip-bazel_to_cmake"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:private"],
    deps = [
        "//runtime/src/iree/base",
        "@iree_macos_toolchain//:Foundation",
    ],
)

iree_runtime_cc_library(
    name = "thread",
    srcs = [
        "thread.c",
        "thread_darwin.c",
        "thread_pthreads.c",
        "thread_win32.c",
    ],
    hdrs = [
        "thread.h",
        "thread_impl.h",
    ],
    deps = [
        ":threading",
        "//build_tools/bazel:dl",
        "//build_tools/bazel:pthreads",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:sysfs",
    ],
)

#===------------------------------------------------------------------------===#
# Tests
#===------------------------------------------------------------------------===#

iree_runtime_cc_test(
    name = "call_once_test",
    srcs = ["call_once_test.cc"],
    deps = [
        ":threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_test(
    name = "latency_test",
    srcs = ["latency_test.cc"],
    deps = [
        ":latency",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_binary(
    name = "latency_test_library.dll",
    testonly = True,
    srcs = ["latency_test_library.c"],
    linkshared = True,
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:private"],
    deps = [
        ":latency",
        "//runtime/src/iree/base",
    ],
)

iree_c_embed_data(
    name = "latency_test_library",
    testonly = True,
    srcs = [":latency_test_library.dll"],
    c_file_output = "latency_test_library_embed.c",
    flatten = True,
    h_file_output = "latency_test_library_embed.h",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:private"],
)

iree_runtime_cc_test(
    name = "latency_win32_test",
    srcs = ["latency_win32_test.cc"],
    target_compatible_with = ["@platforms//os:windows"],
