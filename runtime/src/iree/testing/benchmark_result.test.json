{
  "version": 1,
  "cases": [
    {
      "name": "successful benchmark",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_Success", "--benchmark_min_time=1x"]
      },
      "stdout": {"contains": ["BM_Success"], "not_contains": ["ERROR OCCURRED"]}
    },
    {
      "name": "invalid CPU latency policy fails before running benchmarks",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_Success", "--benchmark_min_time=1x", "--benchmark_cpu_latency_us=-2"]
      },
      "exit": 1,
      "stderr": {"contains": ["--benchmark_cpu_latency_us must be -1 or nonnegative"]},
      "stdout": {"not_contains": ["BM_Success"]}
    },
    {
      "name": "requested and applied CPU latency policy are recorded",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_Success", "--benchmark_min_time=1x", "--benchmark_cpu_latency_us=-1", "--benchmark_format=json"]
      },
      "stdout": {"contains": ["\"cpu_latency_us\": \"default\"", {"regex": "\"low_latency_applied\": \"(true|false)\""}, "\"low_latency_requested\": \"true\"", "BM_Success"]},
      "stderr": {"not_contains": ["PERMISSION_DENIED", "UNIMPLEMENTED"]}
    },
    {
      "name": "explicit opt-out leaves power policy unchanged",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_low_latency=false", "--benchmark_filter=BM_Success", "--benchmark_min_time=1x", "--benchmark_format=json"]
      },
      "stdout": {"contains": ["\"low_latency_applied\": \"false\"", "\"low_latency_requested\": \"false\"", "BM_Success"]},
      "stderr": {"not_contains": ["latency-sensitive power policy is unavailable"]}
    },
    {
      "name": "explicit zero overrides opt-out and is recorded",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_low_latency=false", "--benchmark_cpu_latency_us=0", "--benchmark_filter=BM_Success", "--benchmark_min_time=1x", "--benchmark_format=json"]
      },
      "stdout": {"contains": ["\"cpu_latency_us\": \"0\"", {"regex": "\"low_latency_applied\": \"(true|false)\""}, "\"low_latency_requested\": \"true\"", "BM_Success"]}
    },
    {
      "name": "reported C++ error",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_Error", "--benchmark_min_time=1x"]
      },
      "exit": 1,
      "stdout": {"contains": ["C++ benchmark failed"]}
    },
    {
      "name": "reported C callback error",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_CError", "--benchmark_min_time=1x"]
      },
      "exit": 1,
      "stdout": {"contains": ["C benchmark failed"]}
    },
    {
      "name": "successful rows cannot mask a failure",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_(Success|Error)", "--benchmark_min_time=1x"]
      },
      "exit": 1,
      "stdout": {"contains": ["BM_Success", "C++ benchmark failed"]}
    },
    {
      "name": "ordinary skip is successful",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_Skip", "--benchmark_min_time=1x"]
      },
      "stdout": {"contains": ["benchmark intentionally skipped"]}
    },
    {
      "name": "empty selection fails",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=NoSuchBenchmark"]
      },
      "exit": 1,
      "stderr": {"contains": ["Failed to match any benchmarks"]}
    },
    {
      "name": "listing remains successful",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_Error", "--benchmark_list_tests=true"]
      },
      "stdout": {"contains": ["BM_Error"], "not_contains": ["C++ benchmark failed"]},
      "stderr": {"not_contains": ["latency-sensitive power policy is unavailable"]}
    },
    {
      "name": "JSON and file reports preserve failures",
      "run": {
        "tool": "benchmark",
        "args": ["--benchmark_filter=BM_Error", "--benchmark_min_time=1x", "--benchmark_format=json", "--benchmark_out={tmp}/report.json", "--benchmark_out_format=json"]
      },
      "exit": 1,
      "stdout": {"contains": ["\"error_occurred\": true", "C++ benchmark failed"]},
      "files": [{"path": "{tmp}/report.json", "contains": ["\"error_occurred\": true", "C++ benchmark failed"]}]
    }
  ]
}
