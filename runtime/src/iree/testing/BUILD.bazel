# Testing utilities for IREE.

load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_binary", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "benchmark",
    srcs = [
        "benchmark_full.cc",
    ],
    hdrs = [
        "benchmark.h",
    ],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/threading:latency",
        "//runtime/src/iree/base/tooling:flags",
        "//third_party:google_benchmark",
    ],
)

iree_runtime_cc_library(
    name = "benchmark_main",
    testonly = True,
    srcs = ["benchmark_main.c"],
    deps = [
        ":benchmark",
    ],
)

iree_runtime_cc_library(
    name = "gtest",
    testonly = True,
    hdrs = [
        "gtest.h",
        "status_matchers.h",
    ],
    deps = [
        "//runtime/src/iree/base",
        "//third_party:google_test",
    ],
)

iree_runtime_cc_binary(
    name = "benchmark_result_fixture",
    testonly = True,
    srcs = ["benchmark_result_fixture.cc"],
    deps = [
        ":benchmark",
        ":benchmark_main",
        "//runtime/src/iree/base",
        "//third_party:google_benchmark",
    ],
)

iree_execution_test_suite(
    name = "benchmark_result_test",
    manifests = ["benchmark_result.test.json"],
    tools = {"benchmark": ":benchmark_result_fixture"},
)

iree_runtime_cc_library(
    name = "gtest_main",
    testonly = True,
    srcs = ["gtest_main.cc"],
    tags = ["keep_dep"],
    deps = [
        ":gtest",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//third_party:google_test",
    ],
)

iree_runtime_cc_library(
    name = "gtest_harness",
    testonly = True,
    hdrs = ["gtest_harness.h"],
    deps = [
        ":gtest",
        ":gtest_main",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "gbenchmark_harness",
    testonly = True,
    hdrs = ["gbenchmark_harness.h"],
    deps = [
        "//runtime/src/iree/base",
        "//third_party:google_benchmark",
        "//third_party:google_benchmark_main",
    ],
)

iree_runtime_cc_library(
    name = "temp_file",
    testonly = True,
    srcs = ["temp_file.cc"],
    hdrs = ["temp_file.h"],
    deps = [
        ":gtest",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_test(
    name = "gtest_harness_demo",
    srcs = ["gtest_harness_demo.cc"],
    deps = [
        ":gtest_harness",
    ],
)

iree_runtime_cc_test(
    name = "gbenchmark_harness_demo",
    srcs = ["gbenchmark_harness_demo.cc"],
    deps = [
        ":gbenchmark_harness",
    ],
)

iree_runtime_cc_library(
    name = "coordinated_test",
    srcs = ["coordinated_test.c"],
    hdrs = ["coordinated_test.h"],
    deps = [
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "coordinated_test_main",
    testonly = True,
    srcs = ["coordinated_test_main.cc"],
    tags = ["keep_dep"],
    deps = [
        ":coordinated_test",
        ":gtest",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//third_party:google_test",
    ],
)

iree_runtime_cc_test(
    name = "coordinated_test_test",
    srcs = ["coordinated_test_test.cc"],
    args = [
        "--gtest_color=no",
        "'--coordinated_test_payload=two words'",
    ],
    tags = ["noriscv"],
    deps = [
        ":coordinated_test",
        ":coordinated_test_main",
        ":gtest",
    ],
)
