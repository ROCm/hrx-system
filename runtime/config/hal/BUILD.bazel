load("@bazel_skylib//lib:selects.bzl", "selects")
load("//build_tools/bazel:settings.bzl", "iree_string_list_flag")

package(default_visibility = ["//visibility:public"])

# Driver registration defaults to the dependency-light host driver. GPU drivers
# remain opt-in so embedders do not fetch SDK packages by depending on the
# runtime's default driver registry.
DEFAULT_DRIVERS = [
    "task",
]

SUPPORTED_DRIVERS = [
    "amd",
    "amd-gpu",
    "amd-xdna",
    "amdgpu",
    "task",
    "vulkan",
    "webgpu",
]

# Executable loader registration defaults to both supported native library
# containers.
DEFAULT_EXECUTABLE_LOADERS = [
    "embedded-elf",
    "system-library",
]

SUPPORTED_EXECUTABLE_LOADERS = [
    "embedded-elf",
    "system-library",
]

iree_string_list_flag(
    name = "drivers",
    build_setting_default = DEFAULT_DRIVERS,
    values = SUPPORTED_DRIVERS,
)

# External applications replace this empty registry with a generated aggregate
# containing the driver modules they explicitly compose into their binary.
label_flag(
    name = "external_driver_registry",
    build_setting_default = "//runtime/src/iree/hal/drivers:empty_external_driver_registry",
)

[
    config_setting(
        name = "driver_{}".format(driver.replace("-", "_")),
        flag_values = {
            ":drivers": driver,
        },
    )
    for driver in SUPPORTED_DRIVERS
    if not driver.startswith("amd-") and driver != "amd"
]

# The shared driver is present for either engine. `amd` selects both; individual
# selections never depend on the other engine's implementation or registration.
[
    config_setting(
        name = "selected_" + driver.replace("-", "_"),
        flag_values = {":drivers": driver},
    )
    for driver in [
        "amd",
        "amd-gpu",
        "amd-xdna",
    ]
]

[
    selects.config_setting_group(
        name = "driver_amd_" + engine,
        match_any = [
            ":selected_amd",
            ":selected_amd_" + engine,
        ],
    )
    for engine in [
        "gpu",
        "xdna",
    ]
]

selects.config_setting_group(
    name = "driver_amd",
    match_any = [
        ":driver_amd_gpu",
        ":driver_amd_xdna",
    ],
)

iree_string_list_flag(
    name = "executable_loaders",
    build_setting_default = DEFAULT_EXECUTABLE_LOADERS,
    values = SUPPORTED_EXECUTABLE_LOADERS,
)

[
    config_setting(
        name = "executable_loader_{}".format(loader.replace("-", "_")),
        flag_values = {
            ":executable_loaders": loader,
        },
    )
    for loader in SUPPORTED_EXECUTABLE_LOADERS
]
